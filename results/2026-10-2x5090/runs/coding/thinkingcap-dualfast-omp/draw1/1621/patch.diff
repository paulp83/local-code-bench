+# the qwen3.8 default (32768, #1617) is above the 16384 default cap → raised
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-default.json" BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8 36864
+assert_contains 8 "$OUT" "server budget 32768 reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from llama-cpp-mock's boot command — thinking cap raised to 36864 (= 32768 + 4096 answer headroom"
+assert_contains 8 "$OUT" "thinking-max-tokens=server-budget+4096"
+[[ "$(arg_after --server-thinking-budget)" == "32768" ]] || fail_case 8 "--server-thinking-budget was '$(arg_after --server-thinking-budget)'"
+assert_contains 8 "$QLINE" ", sampling=server, budget=server 32768, packs "
+# ${REASONING_BUDGET:-…} is resolved through the container's env, as the shell would
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-16384.json" BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-env 20480
+assert_contains 8-env "$OUT" "server budget 16384 reasoning tokens"
+[[ "$(arg_after --server-thinking-budget)" == "16384" ]] || fail_case 8-env "--server-thinking-budget was '$(arg_after --server-thinking-budget)'"
+# -1 or no flag: unrestricted → off, nothing recorded as a number
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-neg1.json" BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-neg1 16384
+assert_contains 8-neg1 "$OUT" "server budget: off (llama-cpp-mock boots llama.cpp with --reasoning-budget -1 or none: unrestricted)"
+[[ "$(count_arg --server-thinking-budget)" == "0" ]] || fail_case 8-neg1 "--server-thinking-budget takes a number only"
+assert_contains 8-neg1 "$QLINE" ", sampling=server, budget=server off, packs "
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-noflag.json" -- --quick --enable-thinking
+expect_cap 8-noflag 16384
+assert_contains 8-noflag "$OUT" "server budget: off (llama-cpp-mock boots llama.cpp with --reasoning-budget -1 or none: unrestricted)"
+assert_contains 8-noflag "$QLINE" "budget=server off"
+# an unresolvable value: unknown, no stamp, no record
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-unresolvable.json" BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-unres 16384
+assert_contains 8-unres "$OUT" "server budget: unknown (llama.cpp --reasoning-budget unresolvable"
+[[ "$(count_arg --server-thinking-budget)" == "0" ]] || fail_case 8-unres "--server-thinking-budget sent for an unresolvable budget"
+assert_not_contains 8-unres "$QLINE" "budget="
+# --thinking-budget: verified against the boot value, its own cap wins, nothing recorded
+run_wrapper CONTAINER=llama-cpp-mock "DOCKER_MOCK_INSPECT=${tmp_work}/lcpp-default.json" BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking --thinking-budget 32768
+expect_cap 8-tb 36864
+assert_contains 8-tb "$OUT" "the --thinking-budget 32768 this run verified; cap from --thinking-budget"
+[[ "$(count_arg --server-thinking-budget)" == "0" ]] || fail_case 8-tb "--server-thinking-budget must not be sent when --thinking-budget overrides the server"
+assert_not_contains 8-tb "$QLINE" "budget=server"
+
