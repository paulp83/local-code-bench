+def container_for_url(url):
+    """Name of the running container that publishes the port of ``url`` (any engine),
+    or ``""`` when none does.
+
+    Matches on the PUBLISHED PORT from ``docker ps``, not on the container name: the old
+    ``vllm-(qwen|gemma)`` name heuristic never found an SGLang / llama.cpp container, so the
+    card fell back to rig-wide GPUs and ``spec ?`` (#1537)."""
+    if not url:
+        return ""
+    try:
+        from urllib.parse import urlparse
+        parts = urlparse(url)
+        port = parts.port or {"http": 80, "https": 443}.get(parts.scheme or "")
+    except Exception:
+        return ""
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", timeout=10,
+        ).stdout
+    except Exception:
+        return ""
+    needle = f":{port}->"
+    for line in out.splitlines():
+        fields = line.split("\t")
+        if len(fields) >= 2 and needle in fields[1]:
+            return fields[0]
+    return ""
+
+
+def _vllm_spec_label(container):
+    """Drafter label read from the vLLM container's boot log, or None when unreadable.
+
+    The ``Initializing a V1 LLM engine ... with config: ... speculative_config=...`` line sits
+    at the HEAD of ``docker logs`` (read from the top, not the tail): the Qwen3.8 composes build
+    ``--speculative-config`` inside their entrypoint from ``SPEC_N``, so it never appears in the
+    container's ``Cmd`` (#1537)."""
+    if not container:
+        return None
+    try:
+        out = subprocess.run(["docker", "logs", container],
+                             capture_output=True, text=True, encoding="utf-8", timeout=30).stdout
+    except Exception:
+        return None
+    for line in out.splitlines():
+        if "Initializing a V1 LLM engine" not in line or "speculative_config=" not in line:
+            continue
+        if "speculative_config=None" in line:
+            return "spec off"
+        m = re.search(r"method='([^']+)'", line)
+        method = m.group(1) if m else ""
+        ns = re.search(r"num_spec_tokens=(\d+)", line)
+        n = ns.group(1) if ns else None
+        if "mtp" in method.lower():
+            return f"MTP n={n}" if n else "MTP"
+        if not method:
+            return f"draft n={n}" if n else "draft"
+        name = "ngram" if method.lower() == "ngram" else method.upper()
+        return f"{name} n={n}" if n else name
+    return None
+
+
+def _sglang_spec_label(url):
+    """Drafter label read from SGLang's ``GET /get_server_info``, or None when unreadable.
+
+    EAGLE over the target's own checkpoint is the SGLang spelling of MTP — the Qwen3.8 SGLang
+    composes boot ``--speculative-algorithm EAGLE --speculative-draft-model-path <the model>``."""
+    if not url:
+        return None
+    try:
+        req = urllib.request.Request(f"{url.rstrip('/')}/get_server_info")
+        with urllib.request.urlopen(req, timeout=3) as resp:
+            info = json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+    algo = info.get("speculative_algorithm")
+    if not algo:
+        return "spec off"
+    n = info.get("speculative_num_steps") or info.get("speculative_num_draft_tokens")
+    if str(algo).upper() in ("EAGLE", "EAGLE3", "NEXTN"):
+        draft = info.get("speculative_draft_model_path")
+        model = info.get("model_path")
+        if not draft or (model and draft == model):
+            return f"MTP n={n}" if n else "MTP"
+        return f"EAGLE n={n}" if n else "EAGLE"
+    return f"{algo} n={n}" if n else str(algo)
+
+
+def spec_label(container, url):
+    """The drafter the probed server actually runs, or None when neither source is readable:
+    the vLLM boot log first (container ``$CONTAINER``), then SGLang's ``/get_server_info``
+    (``$URL``)."""
+    label = _vllm_spec_label(container)
+    if label is not None:
+        return label
+    return _sglang_spec_label(url)
+
