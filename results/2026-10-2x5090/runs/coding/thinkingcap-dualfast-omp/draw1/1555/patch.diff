diff --git a/scripts/tests/test-concurrency-probe.sh b/scripts/tests/test-concurrency-probe.sh
index ba69a32..a70172b 100755
--- a/scripts/tests/test-concurrency-probe.sh
+++ b/scripts/tests/test-concurrency-probe.sh
@@ -263,4 +263,105 @@ got="$(PATH="$GPU_STUB:$PATH" CONTAINER=pinned-ids python3 "$LIB" --gpu-label)"
 rm -rf "$GPU_STUB"
 echo "  ✓ VRAM + GPU label scoped to the container's GPUs (ids, UUIDs, NVIDIA_VISIBLE_DEVICES; rig-wide fallback)"
 
+# #1537 (1): Compose emits ONE comma-joined DeviceIDs entry for device_ids:
+# ["${ESTATE_GPUS}"] (["2,3"]) — container_gpus must scope it to GPUs 2 AND 3,
+# like ["2","3"], not treat "2,3" as a single (unresolvable) selector.
+COMMA_STUB="$(mktemp -d)"
+cat > "$COMMA_STUB/nvidia-smi" <<'SMI'
+#!/usr/bin/env bash
+cat <<'ROWS'
+0, GPU-cccc0000-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 10000
+1, GPU-cccc1111-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 10000
+2, GPU-cccc2222-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 12000
+3, GPU-cccc3333-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3060, 11000
+ROWS
+SMI
+cat > "$COMMA_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = inspect ] || exit 0
+echo '[{"HostConfig":{"DeviceRequests":[{"Count":0,"DeviceIDs":["2,3"]}]},"Config":{"Env":[]}}]'
+DOCK
+chmod +x "$COMMA_STUB/nvidia-smi" "$COMMA_STUB/docker"
+got="$(PATH="$COMMA_STUB:$PATH" python3 - "$ROOT_DIR/scripts/lib" <<'PY'
+import sys
+sys.path.insert(0, sys.argv[1])
+import concurrency_probe as c
+sel, _ = c.container_gpus("x")
+print(f"{c.gpu_label(sel)}|{c.vram_used_mb(sel)}|{sel}")
+PY
+)"
+[[ "$got" == "1× GeForce RTX 3090 + 1× GeForce RTX 3060|23000|['2', '3']" ]] \
+  || fail "comma-joined DeviceIDs [\"2,3\"] should scope to GPUs 2 AND 3: got '$got'"
+rm -rf "$COMMA_STUB"
+echo "  ✓ comma-joined DeviceIDs scope to both GPUs (Compose device_ids: [\"\${ESTATE_GPUS}\"])"
+
+# #1537 (2): --container-for-url resolves the container from its PUBLISHED PORT (any
+# engine), not a vllm-(qwen|gemma) name heuristic. Stub docker ps with two running
+# containers on different ports.
+CURL_STUB="$(mktemp -d)"
+cat > "$CURL_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = ps ] || exit 0
+printf 'sgl-qwen38\t0.0.0.0:8099->30000/tcp, [::]:8099->30000/tcp\n'
+printf 'vllm-qwen38\t0.0.0.0:8020->8000/tcp\n'
+DOCK
+chmod +x "$CURL_STUB/docker"
+got="$(PATH="$CURL_STUB:$PATH" URL=http://localhost:8099 python3 "$LIB" --container-for-url)"
+[[ "$got" == "sgl-qwen38" ]] || fail "--container-for-url should find the SGLang container by port 8099: got '$got'"
+got="$(PATH="$CURL_STUB:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+[[ "$got" == "vllm-qwen38" ]] || fail "--container-for-url should find the vLLM container by port 8020: got '$got'"
+got="$(PATH="$CURL_STUB:$PATH" URL=http://localhost:9999 python3 "$LIB" --container-for-url)"
+[[ -z "$got" ]] || fail "--container-for-url with no matching port should print nothing: got '$got'"
+rm -rf "$CURL_STUB"
+echo "  ✓ --container-for-url resolves the container from its published port (any engine)"
+
+# #1537 (3): --spec-label reads the drafter from the ENGINE. vLLM: the 'Initializing a
+# V1 LLM engine ... speculative_config=...' line at the HEAD of docker logs (the
+# --speculative-config flag is built by the entrypoint from SPEC_N, so it is NOT in
+# Cmd). SGLang: GET $URL/get_server_info (EAGLE over the target's own checkpoint = MTP).
+SPEC_STUB="$(mktemp -d)"
+cat > "$SPEC_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  logs)
+    case "$2" in
+      vllm-mtp)    echo "INFO 09-15 12:00:00 core.py:200] Initializing a V1 LLM engine (v0.24.0) with config: model=/m, speculative_config=SpeculativeConfig(method='mtp', model=None, num_spec_tokens=4), cache_config=CacheConfig(block_size=16)" ;;
+      vllm-off)    echo "INFO 09-15 12:00:00 core.py:200] Initializing a V1 LLM engine (v0.24.0) with config: model=/m, speculative_config=None, cache_config=CacheConfig(block_size=16)" ;;
+      sgl-*)       echo "SGLang booting" ;;
+      *)           echo "no spec line" ;;
+    esac ;;
+  *) exit 0 ;;
+esac
+DOCK
+chmod +x "$SPEC_STUB/docker"
+got="$(PATH="$SPEC_STUB:$PATH" CONTAINER=vllm-mtp URL=http://127.0.0.1:1 python3 "$LIB" --spec-label)"
+[[ "$got" == "MTP n=4" ]] || fail "--spec-label (vLLM MTP in the boot log, not Cmd): got '$got'"
+got="$(PATH="$SPEC_STUB:$PATH" CONTAINER=vllm-off URL=http://127.0.0.1:1 python3 "$LIB" --spec-label)"
+[[ "$got" == "spec off" ]] || fail "--spec-label (vLLM speculative_config=None): got '$got'"
+# SGLang: a live /get_server_info on a free port. EAGLE over the target's own
+# checkpoint (draft path == model path) must read as MTP n=4.
+SP="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
+cat > "$SPEC_STUB/srv.py" <<'EOF'
+import http.server, json, os
+class H(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        if self.path == "/get_server_info":
+            body = json.dumps({"model_path": "/m", "speculative_algorithm": "EAGLE",
+                "speculative_draft_model_path": "/m", "speculative_num_steps": 4}).encode()
+            self.send_response(200); self.send_header("Content-Type", "application/json")
+            self.end_headers(); self.wfile.write(body)
+        else:
+            self.send_response(404); self.end_headers()
+    def log_message(self, *a): pass
+http.server.HTTPServer(("127.0.0.1", int(os.environ["PORT"])), H).serve_forever()
+EOF
+PORT="$SP" python3 "$SPEC_STUB/srv.py" & SRV=$!
+sleep 0.4
+got="$(PATH="$SPEC_STUB:$PATH" CONTAINER=sgl-qwen38 URL=http://127.0.0.1:"$SP" python3 "$LIB" --spec-label)"
+kill "$SRV" 2>/dev/null || true
+[[ "$got" == "MTP n=4" ]] || fail "--spec-label (SGLang EAGLE over own checkpoint = MTP n=4): got '$got'"
+rm -rf "$SPEC_STUB"
+echo "  ✓ --spec-label reads the drafter from the engine (vLLM boot log, SGLang /get_server_info)"
+
+
 echo "test-concurrency-probe: ok"
