diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..5410d11 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1022,12 +1022,28 @@ down_running() {
     [[ -n "${managed[$c]:-}" ]] || continue   # not ours — leave it alone
     brought_down=1
     echo "[switch] bringing down: ${c}"
-    # derive the compose dir/file from the container's labels — stop fallback
+    # derive the compose dir/files from the container's labels — stop fallback
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
-    if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+    # #1498: config_files is a comma-joined list (the slug's compose + the
+    # slug-label override in <data dir>/compose-labels/). One -f per entry;
+    # entries that no longer exist (e.g. after the data dir moved) are dropped
+    # — the override only adds labels, so `down` doesn't need it. If nothing
+    # is left (or no labels at all), the container can only be stopped.
+    local -a cfg_args=() _cfgs=()
+    local f
+    IFS=',' read -ra _cfgs <<< "$lbl_file"
+    for f in "${_cfgs[@]}"; do
+      [[ -n "$f" ]] || continue
+      if [[ "$f" == /* ]]; then
+        [[ -e "$f" ]] && cfg_args+=(-f "$f")
+      else
+        [[ -e "$lbl_dir/$f" ]] && cfg_args+=(-f "$f")
+      fi
+    done
+    if [[ -n "$lbl_dir" && "${#cfg_args[@]}" -gt 0 ]]; then
+      (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..b72cc80 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -16,6 +16,11 @@
 #   5. Teardown passes --remove-orphans.
 #   6. When only unmanaged containers run, nothing is torn down and the
 #      "no club-3090 container running" path is taken.
+#   7. A #1498-style comma-joined config_files label (slug compose + slug-label
+#      override) reaches compose as one -f per file — the pre-fix single -f
+#      made every teardown fail and silently fall back to docker stop.
+#   8. When the label's files no longer exist (e.g. the data dir moved), the
+#      container is stopped instead and compose is never called.
 #
 # Harness: extract down_running() via sed, source it, inject a VARIANT_CONTAINER
 # managed set + a mock `docker` on PATH that records compose-down / stop calls.
@@ -61,7 +66,8 @@ trap cleanup EXIT
 # --- Mock `docker`: records compose-down / stop to $DOCKER_MOCK_LOG -----------
 # Labels are returned non-empty so the compose-down branch is taken; the
 # config_files label embeds the container name so the log identifies which
-# container was brought down.
+# container was brought down. vllm-dual-2f carries a #1498-style comma-joined
+# label (relative slug compose + absolute override in <workdir>/compose-labels/).
 cat > "${tmp_dir}/docker" <<'EOF'
 #!/usr/bin/env bash
 sub="$1"; shift || true
@@ -80,7 +86,11 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      if [[ "$cname" == "vllm-dual-2f" ]]; then
+        printf 'compose-%s.yml,%s/compose-labels/%s.yml\n' "$cname" "$DOCKER_MOCK_WORKDIR" "$cname"
+      else
+        printf 'compose-%s.yml\n' "$cname"
+      fi
     fi
     ;;
   stop)
@@ -100,6 +110,14 @@ export DOCKER_MOCK_WORKDIR="${tmp_dir}"   # real dir so (cd "$lbl_dir") succeeds
 export PATH="${tmp_dir}:$PATH"
 export COMPOSE_BIN="docker compose"
 
+# The compose files the containers' labels point at (relative entries resolve
+# against the working dir). vllm-qwen36-27b-gone's is deliberately absent.
+mkdir -p "${tmp_dir}/compose-labels"
+for n in vllm-qwen36-27b ik-llama-qwen36-27b vllm-dual-2f; do
+  : > "${tmp_dir}/compose-${n}.yml"
+done
+: > "${tmp_dir}/compose-labels/vllm-dual-2f.yml"
+
 # Managed set, as derive_switch_variant_tables would populate it (default
 # container names, ESTATE_CONTAINER unwrapped). Spans all engine prefixes.
 declare -A VARIANT_CONTAINER=(
@@ -108,6 +126,8 @@ declare -A VARIANT_CONTAINER=(
   ["ik-llama/iq4ks-mtp"]="ik-llama-qwen36-27b"
   ["beellama/dflash"]="beellama-qwen36-27b"
   ["llamacpp/default"]="llama-cpp-qwen36-27b"
+  ["vllm/dual-2f"]="vllm-dual-2f"
+  ["vllm/gone"]="vllm-qwen36-27b-gone"
 )
 
 # shellcheck source=/dev/null
@@ -135,6 +155,25 @@ assert_not_contains "$log" "COMPOSE"                          "nothing torn down
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
 
+# --- Scenario 3: #1498's comma-joined label (two files) -> two -f args -------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-dual-2f"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_contains "$log" "COMPOSE -f compose-vllm-dual-2f.yml -f ${tmp_dir}/compose-labels/vllm-dual-2f.yml down --remove-orphans" \
+  "comma-joined label: compose gets each file as its own -f"
+assert_not_contains "$log" "STOP" "a two-file teardown does not fall back to stop"
+
+# --- Scenario 4: the label's files are gone (data dir moved) -> stop ---------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b-gone"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_not_contains "$log" "COMPOSE" "no listed file remains: compose is not called"
+assert_contains    "$log" "STOP vllm-qwen36-27b-gone" "nothing left to down with: the container is stopped"
+
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
 echo "PASS: $PASS   FAIL: $FAIL"
