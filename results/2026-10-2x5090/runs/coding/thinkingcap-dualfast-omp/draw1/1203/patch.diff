 def compute_promote_scaffold(
@@ -3282,3 +3149,18 @@ def attribute_gpu_apps(
         if not name and app.used_mib > 0:
             degraded = True
     return apps, degraded
+
+
+def __getattr__(name: str):
+    """Re-export ``ComposeFacts`` from the shared profiles module (#1202 P1).
+
+    PEP 562: the profiles import happens only when the attribute is actually
+    requested, so data.py stays importable on the launcher's no-PyYAML path,
+    where the repo root (hence ``scripts.lib.profiles``) may not be on
+    sys.path yet.  ``derive_compose_facts`` is a real module attribute above
+    (a delegating wrapper), so it never reaches here."""
+    if name == "ComposeFacts":
+        from scripts.lib.profiles.compose_facts import ComposeFacts
+
+        return ComposeFacts
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
