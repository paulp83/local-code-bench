+        _tdp = Path(_td)
+        for _i, _ip in enumerate(_install_patches):
+            _target = (
+                (_ip.get("delivery_spec") or {}).get("mounted_at") or ""
+            )
+            _src = pa._patch_source_markers(_ip) or ["unidentifiable-patch"]
