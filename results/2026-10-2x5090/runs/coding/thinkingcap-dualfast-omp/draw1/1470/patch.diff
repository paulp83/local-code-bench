diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..cb98331 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,42 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ SGLang V1 CustomAllreduce — the PCIe path. V2 is NVLink-only
+# (can_use_custom_all_reduce_v2), so every PCIe rig runs V1, which logs nothing
+# at init: its only success line is the CUDA-graph-buffer registration, emitted
+# on rank 0 after graph capture (the vLLM-derived wording, lmsysorg/sglang:v0.5.20).
+# A P2P-rig boot that registered its buffers (4352) passed verify-full + a
+# continuous soak, but report.sh and the bench card still scored it unknown —
+# the classifier knew only V2's "All Reduce config" success line (follow-up to #1462).
+_sgl_v1=$(cat <<'EOF'
+[2026-10-12 09:14:03] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-12 09:14:19 TP0] sglang is using nccl==2.30.7
+[2026-10-12 09:15:41 TP0] Registering 4352 cuda graph addresses. This can take up to several minutes for large models.
+EOF
+)
+_ev1="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev1" "cuda graph addresses"
+r="$(printf '%s\n' "$_ev1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph registration -> custom AR on (got $r)"
+# Same through the unfiltered stream — the docker-logs shape bench.sh feeds it.
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 registration -> on (got $r)"
+# A request to enable stays unknown without the registration line (parity with V2).
+r="$(printf '%s' "[sglang] BOOT disable_custom_all_reduce=False" "sglang is using nccl==2.30.7" | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "SGLang V1 requested-on without registration -> unknown (got $r)"
+# Restart epochs: a failed boot must not taint a later V1 success, and vice versa.
+_v1_fail_boot="$(printf '%s\n' "[sglang] BOOT disable_custom_all_reduce=False" "Setup Custom allreduce failed with invalid literal for int() with base 10: 'GPU-0e72'. To silence this warning, specify --disable-custom-all-reduce explicitly.")"
+r="$(printf '%s\n%s' "$_v1_fail_boot" "$_ev1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "V1 success after a failed boot -> on (got $r)"
+r="$(printf '%s\n%s' "$_ev1" "$_v1_fail_boot" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_failed" ]] || fail "failed restart after a V1 success boot -> nccl_only_failed (got $r)"
+# An operator-disabled boot is classified as such even if a stray registration
+# line were present: the operator case precedes the on case in the cascade.
+r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=True' 'Registering 4352 cuda graph addresses.' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator-disabled boot beats a stray registration line (got $r)"
+unset _sgl_v1 _ev1 _v1_fail_boot
+echo "  ✓ SGLang V1 (PCIe) custom-AR: graph-buffer registration scores on; epochs and operator precedence preserved"
+
