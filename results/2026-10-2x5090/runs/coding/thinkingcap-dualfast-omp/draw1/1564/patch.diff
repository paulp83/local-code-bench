+def _local_engine_profile_path(root: Path, spec: dict) -> Optional[Path]:
+    """The engines.d file a spec would write (LOCAL layer), or None.
+
+    The engine id comes from the registry kwargs (fallback: the slug prefix —
+    local slugs are '<engine>/<name>')."""
+    if not spec.get("local_engine_profile"):
+        return None
+    entry = spec["registry_entry"]
+    engine = entry["kwargs"].get("engine") or entry["slug"].split("/", 1)[0]
+    return root / _LOCAL_ENGINES_REL / f"{engine}.yml"
+
