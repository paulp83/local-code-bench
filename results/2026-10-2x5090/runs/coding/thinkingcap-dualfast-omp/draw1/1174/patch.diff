       "hf_fetch exposes a standalone fetch() + a CLI entry point")
 
+# ---------------------------------------------------------------------------
+# 14. tool-unavailable rung 1 (no `hf` on PATH, rc=127) is FALLBACK-ELIGIBLE:
+#     the ladder escalates to rung 3 (which needs no `hf` at all) instead of
+#     dying with a bare failure.
+# ---------------------------------------------------------------------------
+with tempfile.TemporaryDirectory() as td:
+    log = Log()
+    _orig_dl, _orig_tree, _orig_raw = (HF._hf_download, HF.repo_tree,
+                                       HF.raw_resolve_fetch)
+    HF._hf_download = lambda *a, **kw: (
+        127, "neither `hf` nor `huggingface-cli` is on PATH")
+    HF.repo_tree = lambda *a, **kw: TREE
+    def _fake_raw(repo_id, filename, local_dir, **kw):
+        p = Path(local_dir) / filename
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(BODY)
+        return p
+    HF.raw_resolve_fetch = _fake_raw
+    try:
+        res = HF.fetch("org/Big", Path(td), [BIG], allow_xet=False, log=log)
+    finally:
+        HF._hf_download, HF.repo_tree, HF.raw_resolve_fetch = (
+            _orig_dl, _orig_tree, _orig_raw)
+    check(res.ok and res.rung == "raw-resolve",
+          f"no `hf` on PATH (rc=127) ESCALATES to rung 3 instead of dying "
+          f"(ok={res.ok} rung={res.rung!r} failure={res.failure!r})")
+    check(res.verified == [BIG],
+          "the rung-3 artifact is still sha256-verified against the hub")
+    check("could not RUN" in log.text() and "127" in log.text(),
+          "the announcement says the tool was MISSING, not that the hub "
+          "refused (a missing tool is a local gap, not a policy wall)")
+
+# ---------------------------------------------------------------------------
+# 15. the same repro end to end through the CLI: a rig with no `hf` gets a
+#     successful rung-3 pull, exit 0.
+# ---------------------------------------------------------------------------
+with tempfile.TemporaryDirectory() as td:
+    _orig_dl, _orig_tree, _orig_raw = (HF._hf_download, HF.repo_tree,
+                                       HF.raw_resolve_fetch)
+    HF._hf_download = lambda *a, **kw: (
+        127, "neither `hf` nor `huggingface-cli` is on PATH")
+    HF.repo_tree = lambda *a, **kw: TREE
+    HF.raw_resolve_fetch = _fake_raw
