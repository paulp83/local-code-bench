+    if [ "$$x" = 1 ]; then :
+    elif [ "$$x" = 2 ]; then :; else :; fi ;;
+  b) A_ARGS=(--b) ;;
+esac
+exec run "$${A_ARGS[@]}"
+""", True),
+    ("non-exhaustive case: one arm assigns, no catch-all", """
+case "$$V" in
+  on) A_ARGS=(--on) ;;
+esac
+exec run "$${A_ARGS[@]}"
+""", True),
+    ("catch-all present but one arm neither assigns nor exits", """
+case "$$V" in
+  on) A_ARGS=(--on) ;;
+  *) : ;;
+esac
+exec run "$${A_ARGS[@]}"
+""", True),
+    ("one-branch if assignment (the original #MAMBA catch)", """
+if [ "$$X" = 1 ]; then
+  A_ARGS=(--x)
+else
+  :
+fi
+exec run "$${A_ARGS[@]}"
+""", True),
+    ("top-level assignment before a one-arm case rescues it", """
