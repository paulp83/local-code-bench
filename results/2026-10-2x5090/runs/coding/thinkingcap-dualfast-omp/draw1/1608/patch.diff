+FIXTURES = [
+    ("exhaustive case: every arm assigns or exits", """
+case "$$V" in
+  on) A_ARGS=() ;;
+  off) A_ARGS=(--off) ;;
+  *) echo "bad VISION" >&2; exit 1 ;;
+esac
+exec run "$${A_ARGS[@]}"
+""", False),
+    ("one-line if inside a case arm still closes the case", """
+case "$$t" in
+  a) A_ARGS=()
+    if [ "$$x" = 1 ]; then :
+    elif [ "$$x" = 2 ]; then :; else :; fi ;;
+  b) A_ARGS=(--b) ;;
+  *) A_ARGS=() ;;
+esac
+exec run "$${A_ARGS[@]}"
+""", False),
+    # The old parser leaked the case here (the one-line `elif ...; fi` left the
+    # `if` frame open, the `esac` popped the `if`), so the assignment in arm `a`
