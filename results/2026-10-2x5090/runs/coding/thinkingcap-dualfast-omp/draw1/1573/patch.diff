@@ -229,6 +243,52 @@ _thinking_budget_container_facts() {
   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# vLLM's argv is not always the whole story. An image that starts vLLM through
+# its own launcher (bucko's official image ships a `qwen38-serve` wrapper that
+# execs vllm serve) adds --reasoning-parser inside that script, so `docker
+# inspect` shows no flag while the running server has one. The resolved boot
+# dump is in the container's log: vLLM logs `non-default args: {...}` once per
+# boot, and reasoning_parser appears there only when set (None is the default,
+# so an absent parser is a true absence). `restart: unless-stopped` means one
+# `docker logs` can hold several boots; the LAST `non-default args` line is the
+# current boot, so read that, never the first (the boot-epoch rule detect_nvlink.sh
+# establishes).
+#
+# stdin: `docker logs <container>`. stdout, one line:
+#   PARSER <value>   the current boot resolves a reasoning parser
+#   PARSER none      no parser resolved — no boot line in the log (empty,
+#                    unreadable, or rotated out) OR a boot line that carries no
+#                    reasoning_parser. Either way the parser is NOT confirmed,
+#                    which is a refusal, not a verification (fail closed).
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import re, sys
+key = re.compile(r'["\']?reasoning_parser["\']?\s*:\s*["\']([^"\']*)["\']')
+last_boot = ""
+for line in sys.stdin:
+    if "non-default args" in line:
+        last_boot = line
+if last_boot:
+    m = key.findall(last_boot)
+    v = m[-1] if m else ""
+    if v and v != "None":
+        print("PARSER %s" % v)
+        sys.exit(0)
+print("PARSER none")
+PY
+)"
+_thinking_budget_vllm_log_facts() {
+  if ! command -v docker >/dev/null 2>&1; then
+    echo "PARSER none"
+    return 0
+  fi
+  # docker logs <c> streams the whole log; the parser reads line by line and
+  # keeps only the last boot line, so a long-lived container's multi-GB log is
+  # scanned once without being held in memory. A failed docker (no container)
+  # yields empty input, which the parser reports as "PARSER none" (not
+  # confirmed -> the caller refuses; it never falsely verifies).
+  docker logs "$1" 2>/dev/null | python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY"
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,8 +391,31 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv carries no --reasoning-parser. That is no longer positive
+          # evidence of absence: an image that starts vLLM through its own
+          # launcher adds the flag inside that script, so it is absent from the
+          # argv while the running server has it. The resolved boot dump in the
+          # container's log is the truth.
+          logfacts="$(_thinking_budget_vllm_log_facts "$c")"
+          case "$logfacts" in
+            "PARSER none")
+              # No parser confirmed: the boot dump carries none (or no boot
+              # line is readable). Fail closed — a budget that would run
+              # unbounded or 400 is worse than none, so a hard refusal (no
+              # bypass), with the same evidence line as before the log
+              # fallback existed.
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+            "PARSER "*)
+              # The argv carries no flag but the resolved boot dump names a
+              # parser: the image's own launcher added it in-script. Verified.
+              THINKING_BUDGET_EVIDENCE="container ${c} carries no --reasoning-parser in its argv, but its boot log resolves reasoning_parser=${logfacts#PARSER } (the image's own launcher adds the flag) — vLLM will honour the per-request budget"
+              return 0 ;;
+            *)
+              # Unparseable / empty output: also not confirmed, so fail closed.
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+          esac ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
