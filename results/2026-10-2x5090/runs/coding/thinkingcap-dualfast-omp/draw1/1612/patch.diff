+# what tells one template's mount line from another's (#1611; the
+# install-script analogue is `_GENERIC_SCRIPT_NAMES`, #1597).
+_GENERIC_TEMPLATE_NAMES = frozenset({
+    "chat_template.jinja", "chat_template.jinja2", "chat_template.j2", "patches",
+})
+
+
+def chat_template_sources(patch: dict) -> list[str]:
+    """Host-side tokens that identify a ``chat_template`` patch's vendored
+    template on its mount line: the ``jinja`` file's own directory name and/or
+    its distinctive file name, minus the names shared by every template
+    (``_GENERIC_TEMPLATE_NAMES``) — the same idea as :func:`_install_sources`
+    (#1597). The container-side ``mounted_at`` target alone cannot identify
+    the patch: several templates share a target shape (every model-dir
+    override lands on ``<model dir>/chat_template.jinja``), and a bare
+    ``--chat-template`` flag occurs in composes that mount entirely
+    different templates (#1611)."""
+    spec = patch.get("delivery_spec") or {}
+    jinja = spec.get("jinja")
+    if not jinja:
+        return []
+    path = Path(jinja)
+    names = {path.name}
+    if path.parent.name:
+        names.add(path.parent.name)
+    out = sorted(n for n in names if n and n not in _GENERIC_TEMPLATE_NAMES)
+    return out or [path.as_posix()]
+
+
+# --chat-template / --chat-template-file as WHOLE flag tokens: preceded by a
+# non-word/non-hyphen char and NOT followed by a word char or a further
+# hyphen — so `--chat-template` never matches as a prefix of
+# `--chat-template-file` or `--chat-template-kwargs`, and
+# `--default-chat-template-kwargs` (one hyphen before chat-template) never
+# matches at all (#1611).
+_CHAT_TEMPLATE_FLAG_RE = re.compile(r"(?<![\w-])--chat-template(?:-file)?(?![\w-])")
+_CHAT_TEMPLATE_FLAG_VALUES = ("--chat-template", "--chat-template-file")
