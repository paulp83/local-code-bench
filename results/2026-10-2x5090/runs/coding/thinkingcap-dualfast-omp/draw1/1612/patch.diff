+def _chat_template_wired(svc: dict, wired_at: set, patch: dict) -> bool:
+    """Does ONE merged service genuinely wire the patch's vendored template
+    (#1611)?
+
+    * the service mounts THIS patch's template — its mount line carries the
+      patch's own source token (:func:`chat_template_sources`) alongside the
+      container-side ``mounted_at`` target; the target alone does not
+      identify the patch (shared targets, other patches' templates);
+    * and, when the spec wires the launch-command point (``entrypoint`` or
+      ``command``), a ``--chat-template`` / ``--chat-template-file`` flag
+      naming the mounted path is present. A patch wired ``[volumes]`` only
+      (mounted over the model dir's own template, engine auto-loads it — the
+      carnice / qwen38 style) needs no flag: the mount is the delivery.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    sources = chat_template_sources(patch)
+    if not sources:
+        return False
+    mounted = False
+    for vol in svc.get("volumes") or []:
