+def _path_names_mounted(value: str, mounted_at: str) -> bool:
+    """Does a flag value name the mounted path (exactly, or as a longer
+    path ending in it — the model-dir style mounts at
+    ``<model dir>/chat_template.jinja`` while the spec's ``mounted_at`` is
+    the shared suffix ``/chat_template.jinja``)?"""
+    v = value.strip().strip("'\"")
+    return bool(v) and (v == mounted_at or v.endswith(mounted_at))
+
+
+def _command_invokes_template(svc: dict, mounted_at: str) -> bool:
+    """True iff the service's launch command (``command`` or ``entrypoint``,
+    a list or a string) passes ``--chat-template`` / ``--chat-template-file``
+    naming the mounted path: the value is the next whitespace token (string /
+    folded / flow command) or the next list item (block-sequence command).
+    A bare flag with no matching value does not count, a flag naming
+    ANOTHER file does not count, and ``--chat-template`` never counts as a
+    prefix of ``--chat-template-file`` / ``--chat-template-kwargs`` (#1611)."""
+    for key in ("command", "entrypoint"):
+        cmd = svc.get(key)
+        if isinstance(cmd, str):
+            for m in _CHAT_TEMPLATE_FLAG_RE.finditer(cmd):
+                tail = cmd[m.end():]
+                if tail.strip() and _path_names_mounted(tail.split()[0], mounted_at):
+                    return True
+            continue
