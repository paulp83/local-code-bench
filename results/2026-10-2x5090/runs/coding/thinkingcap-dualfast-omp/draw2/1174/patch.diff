+
+# ---------------------------------------------------------------------------
+# 14. missing CLI (command-not-found, rc=127) is FALLBACK-ELIGIBLE: the
+#     ladder escalates to a rung that does not need the `hf` CLI instead of
+#     dying before a byte moves — and the module CLI prints the failure
+#     token + detail to stderr before its exit code (no bare 1 after the
+#     starting announcement).
+# ---------------------------------------------------------------------------
+import contextlib
+
+# (a) the CLI never exits with a bare 1: a failed fetch announces token +
+#     detail on stderr before the exit code.
+orig_fetch = HF.fetch
+try:
+    HF.fetch = lambda *a, **k: HF.LadderResult(
+        ok=False, failure="no-etag", detail="the hub publishes no sha256")
+    buf = io.StringIO()
+    with contextlib.redirect_stderr(buf):
+        rc = HF._main(["org/Big", "--local-dir", "/tmp/never"])
+    err = buf.getvalue()
+finally:
+    HF.fetch = orig_fetch
+check(rc == 1, f"a failed CLI run still exits non-zero (rc={rc})")
+check("no-etag" in err,
+      f"the failure TOKEN is printed to stderr before the exit code "
+      f"(got: {err!r})")
+check("the hub publishes no sha256" in err,
+      f"the failure DETAIL is printed to stderr before the exit code "
+      f"(got: {err!r})")
+
+# (b) missing `hf` -> rung 3 delivers: command-not-found does not kill the
+#     ladder. The CLI is probed via `shutil.which` (monkeypatched to None for
+#     both names); rung 3's transport is injected, so no network.
+with tempfile.TemporaryDirectory() as td:
+    log, curl = Log(), curl_runner_ok()
+    _orig_which = HF.shutil.which
+    _orig_tree = HF.repo_tree
+    HF.shutil.which = lambda n: None if n in ("hf", "huggingface-cli") \
+        else "/usr/bin/curl"
+    HF.repo_tree = lambda *a, **k: TREE
+    try:
+        res = HF.fetch("org/Big", Path(td), [BIG], allow_xet=False, log=log,
+                       curl_runner=curl, xet_available=lambda: False)
+    finally:
+        HF.shutil.which, HF.repo_tree = _orig_which, _orig_tree
+    check(res.ok and res.rung == "raw-resolve",
+          f"missing CLI (rc=127 class) is fallback-eligible: rung 3 delivers "
+          f"(ok={res.ok} rung={res.rung!r} failure={res.failure!r})")
+    check(res.verified == [BIG],
+          "the rung-3 artifact is sha256-verified even when rung 1 was "
+          "skipped for a missing CLI")
+    check("command not found" in log.text() and "rung 1" in log.text(),
+          "the missing-CLI rung-1 skip is ANNOUNCED with its reason, not "
+          "silent")
+    check("DONE via rung 3" in log.text(),
