+# --------------------------------------------------------------------------
+# chat_template delivery — source-aware reachability (#1613 class).
+# --------------------------------------------------------------------------
+# Names that occur on EVERY vendored template's mount line and therefore
+# identify no patch in particular: the shared ``patches/`` dir and the
+# conventional ``chat_template.jinja`` basename (qwen38's declared
+# mounted_at is the suffix ``/chat_template.jinja`` — its target alone
+# matched any compose mounting ANY template into a model dir).
+_GENERIC_TEMPLATE_SOURCE_NAMES = frozenset({"patches", "chat_template.jinja"})
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line
+    (the source-aware check #1610 gave install-script patches): the vendored
+    template's own filename (``apex-qwen-chat-template.jinja``) or its owning
+    patch directory (``qwen38-reasoning-effort-template/``,
+    ``glm53-minja-numeric-index/``). Derived from ``delivery_spec.jinja``
+    (the schema-required repo-relative artifact), falling back to ``files``.
+    The generic names in ``_GENERIC_TEMPLATE_SOURCE_NAMES`` are excluded —
+    they appear on every template's mount line and would re-introduce the
+    cross-template false positive."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    spec = patch.get("delivery_spec") or {}
+    if spec.get("jinja"):
+        candidates = [spec["jinja"]]
+    else:
+        candidates = list(patch.get("files") or [])
+    names: set[str] = set()
+    for rel in candidates:
+        if not rel:
+            continue
+        path = Path(rel)
+        if path.suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES or not path.suffix:
+            # a `.jinja` file (its own name, when not the generic basename)
+            # or a patch directory entry (its name is the identifier).
+            for name in (path.name, path.parent.name):
+                if name and name not in _GENERIC_TEMPLATE_SOURCE_NAMES:
+                    names.add(name)
+    return sorted(names)
+
+
+def _chat_template_mount_ok(patch: dict, body: str) -> bool:
+    """True iff the merged service body carries THIS patch's mount: one line
+    holding both the declared container target (``mounted_at`` — a suffix is
+    fine, e.g. qwen38's ``/chat_template.jinja`` mounted into each served
+    model dir) AND the patch's own vendored source name. The target substring
+    alone matches any compose mounting ANY template (the over-report this
+    replaces); a source name on a line without the target is not this
+    patch's mount either."""
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    sources = _chat_template_sources(patch)
+    if not sources:
+        return any(mounted_at in ln for ln in body.splitlines())
+    return any(
+        mounted_at in ln and any(src in ln for src in sources)
+        for ln in body.splitlines()
+    )
+
+
+# The two engine flags that select an external chat template. The bare
+# ``--chat-template`` must never match as a prefix of ``--chat-template-file``
+# (or ``--chat-template-kwargs``), so occurrences are matched by token
+# equality, not substring.
+_CHAT_TEMPLATE_FLAGS = ("--chat-template", "--chat-template-file")
+
+
+def _chat_template_flag_values(body: str) -> list[str]:
+    """The value token of every ``--chat-template`` / ``--chat-template-file``
+    occurrence in rendered compose text. Tokens are whitespace-split over the
+    whole (comment-free) body with quotes/brackets/commas stripped, so a
+    flag's value is the next token whether the flag sits in a folded scalar
+    (``--chat-template-file /etc/x.jinja`` inside ``command: >-``), a flow
+    sequence (``[--model, m, --chat-template, /x]``) or a block list
+    (``- --chat-template`` / ``- /x`` on consecutive lines)."""
+    tokens: list[str] = []
+    for raw in body.splitlines():
+        # drop the block-list item marker (`- `) so it is not mistaken for
+        # the flag's value token on the following line
+        line = re.sub(r"^\s*-(\s+|$)", "", raw)
+        for tok in line.split():
+            t = tok.strip("\"'[],")
+            if t:
+                tokens.append(t)
+    values: list[str] = []
+    for i, tok in enumerate(tokens):
+        if tok in _CHAT_TEMPLATE_FLAGS and i + 1 < len(tokens):
+            values.append(tokens[i + 1])
+    return values
+
+
+def _chat_template_flag_status(patch: dict, body: str) -> str:
+    """``'none' | 'names' | 'conflicts'`` for the engine flags in ``body``:
+    ``'none'`` = no ``--chat-template[-file]`` anywhere (fine for a template
+    mounted over the model dir — the engine auto-loads it); ``'names'`` = at
+    least one occurrence names THIS patch's mounted path (the value equals
+    it or ends with it — ``mounted_at`` is a suffix for model-dir mounts);
+    ``'conflicts'`` = a flag is passed but names ANOTHER file — the engine
+    renders that template, not this patch's, so the patch is not live. A bare
+    flag whose next token is not the mounted path (another flag, a key,
+    …) conflicts, never silently counts as wiring."""
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at") or ""
+    values = _chat_template_flag_values(body)
+    if not values:
+        return "none"
+    for v in values:
+        if v == mounted_at or (mounted_at and v.endswith(mounted_at)):
+            return "names"
+    return "conflicts"
+
+
+def _chat_template_reaches(patch: dict, body: str) -> bool:
+    """chat_template reachability against a merged, comment-free service
+    body. The load-bearing artifact is the mount of this patch's OWN
+    template (source-aware); the engine flag then constrains — never
+    substitutes — for it: a flag naming another file means the engine
+    renders that file (False); a standalone-path template (e.g.
+    ``/etc/…``) is only ever used when the engine is told to via the flag,
+    so a missing flag is False there; a template mounted over the model
+    dir's own ``chat_template.jinja`` is auto-loaded by vLLM/SGLang, so a
+    missing flag is fine (qwen38's SGLang composes are load-bearing
+    without one; its vLLM composes pass it for the Anthropic router)."""
+    if not _chat_template_mount_ok(patch, body):
+        return False
+    status = _chat_template_flag_status(patch, body)
+    if status == "conflicts":
+        return False
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at") or ""
+    if Path(mounted_at).name != "chat_template.jinja" and status == "none":
+        return False
+    return True
+
