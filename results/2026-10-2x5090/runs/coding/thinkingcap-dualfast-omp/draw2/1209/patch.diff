index 0000000..bee15e3
--- /dev/null
+++ b/scripts/lib/profiles/amend.py
@@ -0,0 +1,381 @@
+#!/usr/bin/env python3
+"""Local-layer AMEND — rename or update an existing local entry (#1202 P7).
+
+The local layer was create-and-delete only: promote.py refuses every
+"already exists" case, and demote.py only removes. Changing one field meant
+demoting and re-promoting. #1204 decided a local slug colliding with a
+newly-shipped curated one is kept and *marked* (shadowed) "so the user can
+rename it" — and no rename existed. This is the remedy:
+
+    amend.py rename --slug OLD --to NEW [--root DIR] [--dry-run]
+    amend.py update --slug SLUG --set KEY=VALUE [--root DIR] [--dry-run]
+
+Both touch ONLY scripts/lib/profiles-local/registry.local.json under <root> —
+never a file under scripts/lib/profiles/ (the curated catalog). Provenance
+stays the loader's job: a local entry's kwargs never carry `origin` (the
+loader stamps origin="local", and refuses a row that self-declares one), so
+it is not editable here either.
+
+Ground rules, mirroring demote.py:
+  * a slug absent from registry.local.json is refused BEFORE anything is
+    written; if it is a curated slug the refusal says so explicitly (core is
+    git-tracked; git is its amendment tool);
+  * renaming ONTO a curated slug is refused — core wins the lookup, so the
+    renamed entry would just be re-shadowed, the exact state this exists to
+    escape;
+  * a rename's NEW namespace (the part before the `/`) must be a KNOWN
+    engine — an engine profile id in the root's profiles tree (core engines
+    + local engines.d). An unknown namespace would leave the entry's engine
+    field pointing at nothing;
+  * the amended entry is dry-wrapped through _entry() EXACTLY like the
+    loader, so a bad key/value refuses BEFORE the write (a broken layer is
+    worse than a refusal);
+  * the layer must already load before it is amended, and is re-loaded after
+    the write: origin=local stamped, engine == the slug's namespace, the
+    amended row present.
+
+Exit codes: 0 success (a --dry-run writes nothing and exits 0); 3 refused
+(nothing written); 2 internal failure after the write (the write is a single
+gitignored JSON file — delete it to roll back).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import sys
+from pathlib import Path
+from typing import Any, Optional
+
+_HERE = Path(__file__).resolve()
+_DEFAULT_ROOT = _HERE.parents[3]
+
+_LOCAL_REGISTRY_REL = "scripts/lib/profiles-local/registry.local.json"
+
+EXIT_REFUSED = 3
+EXIT_INTERNAL = 2
+
+
+class Refusal(Exception):
+    """Bad input / collision — nothing was written."""
+
+
+class InternalError(Exception):
+    """The write happened but the re-check failed — the layer may be partial."""
+
+
+def _info(msg: str) -> None:
+    print(f"[amend] {msg}", file=sys.stderr)
+
+
+def _load_local_raw(root: Path) -> dict:
+    """The RAW registry.local.json dict ({} when absent)."""
+    path = root / _LOCAL_REGISTRY_REL
+    if not path.is_file():
+        return {}
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise Refusal(f"{path} is unreadable — fix or remove it first: {exc}")
+    if not isinstance(data, dict) or not all(isinstance(v, dict) for v in data.values()):
+        raise Refusal(f"{path} is not a JSON object of {{slug: kwargs}}")
+    return data
+
+
+def _registry_module(root: Path):
+    """The root tree's compose_registry module (its catalog + its loader).
+
+    Imported per-root so a --root throwaway tree validates against ITS OWN
+    curated catalog — demote.py's same ground rule."""
+    sys.path.insert(0, str(root))
+    try:
+        from scripts.lib.profiles import compose_registry as cr
+    except Exception as exc:
+        raise Refusal(
+            f"cannot import compose_registry from {root} — is --root a "
+            f"club-3090 checkout? ({exc})"
+        ) from exc
+    return cr
+
+
+def _is_core_slug(root: Path, slug: str) -> bool:
+    """True when `slug` is a curated (core) entry — never amendable here."""
+    return slug in _registry_module(root).COMPOSE_REGISTRY
+
+
+def _load_layer(root: Path) -> dict:
+    """The local layer as the LOADER reads it (fail closed on a broken layer)."""
+    cr = _registry_module(root)
+    try:
+        return cr.load_local_registry(root)
+    except cr.LocalRegistryError as exc:
+        raise Refusal(
+            f"the local layer does not currently load — fix it before amending: {exc}"
+        ) from exc
+
+
+def _known_engines(root: Path) -> set:
+    """The engine profile ids the root tree knows (core engines + local
+    engines.d) — the namespaces a local slug may live under."""
+    sys.path.insert(0, str(root))
+    try:
+        from scripts.lib.profiles.compat import load_profiles
+
+        engines = set(
+            load_profiles(root / "scripts" / "lib" / "profiles").engines
+        )
+    except Exception as exc:
+        raise Refusal(
+            f"cannot determine the known engines from {root} ({exc}) — "
+            f"refusing before writing"
+        ) from exc
+    if not engines:
+        raise Refusal(
+            f"no engine profiles found under {root}/scripts/lib/profiles/ — "
+            f"cannot verify a slug's namespace; refusing before writing"
+        )
+    return engines
+
+
+def _write_registry(root: Path, raw: dict) -> None:
+    """Rewrite registry.local.json atomically (temp sibling + os.replace)."""
+    path = root / _LOCAL_REGISTRY_REL
+    path.parent.mkdir(parents=True, exist_ok=True)
+    text = json.dumps(raw, indent=2, ensure_ascii=False) + "\n"
+    tmp = path.with_name(path.name + ".tmp")
+    try:
+        tmp.write_text(text, encoding="utf-8")
+        os.replace(tmp, path)
+    except OSError as exc:
+        raise InternalError(f"could not rewrite {path}: {exc}") from exc
+
+
+def _slug_namespace(slug: str) -> str:
+    return slug.split("/", 1)[0]
+
+
+def _refuse_unknown_slug(root: Path, slug: str, registered: dict) -> Refusal:
+    """Refuse a slug that is not in the local layer, naming the case."""
+    if _is_core_slug(root, slug):
+        return Refusal(
+            f"{slug!r} is a CURATED catalog entry, not a local one. This tool "
+            f"only amends the local layer; a curated entry is git-tracked and "
+            f"git is its amendment tool."
+        )
+    known = ", ".join(sorted(registered)) or "(none registered)"
+    return Refusal(f"{slug} is not in {_LOCAL_REGISTRY_REL}. Registered: {known}")
+
+
+def rename(root: Path, old: str, new: str, *, dry_run: bool = False) -> dict:
+    """Rename a local slug. Returns {"slug": <new>}."""
+    raw = _load_local_raw(root)
+    _load_layer(root)  # fail closed: the layer must already load
+
+    if old not in raw:
+        raise _refuse_unknown_slug(root, old, raw)
+    if new == old:
+        _info(f"{old} is already named {new} — nothing to do")
+        return {"slug": new}
+
+    # Target shape — the same rules the loader enforces.
+    if new.startswith("local/"):
+        raise Refusal(
+            "the 'local/' namespace was removed — use '<engine>/<name>'"
+        )
+    if new.count("/") != 1 or new.startswith("/") or new.endswith("/"):
+        raise Refusal(f"target slug {new!r} must be '<engine>/<name>'")
+
+    # Refuse renaming ONTO a curated slug: the renamed entry would just be
+    # re-shadowed (core wins the lookup) — the state this exists to escape.
+    if _is_core_slug(root, new):
+        raise Refusal(
+            f"{new!r} is a CURATED catalog entry. Renaming onto it would leave "
+            f"the entry shadowed (core wins the lookup) — pick another name."
+        )
+    if new in raw:
+        raise Refusal(f"{new!r} is already registered in the local layer")
+
+    ns = _slug_namespace(new)
+    known = _known_engines(root)
+    if ns not in known:
+        raise Refusal(
+            f"{ns!r} is not a known engine (known: {', '.join(sorted(known))}). "
+            f"The slug's namespace must be an engine profile id — pick a known "
+            f"one, or register the engine first (catalog.sh register writes "
+            f"profiles-local/engines.d/ for unknown engines)."
+        )
+
+    # The amended entry: everything carried over, engine := the new namespace
+    # (the invariant every local row must keep). The loader stamps origin.
+    entry = dict(raw[old])
+    entry["engine"] = ns
+
+    # Dry-wrap EXACTLY like the loader: a bad value refuses before the write.
+    cr = _registry_module(root)
+    try:
+        cr._entry(origin="local", **entry)
+    except (TypeError, ValueError) as exc:
+        raise Refusal(f"amended entry for {new!r} is invalid: {exc}") from exc
+
+    if dry_run:
+        _info(f"plan: rename {old} -> {new} (engine={ns}) in {_LOCAL_REGISTRY_REL}")
+        _info("--dry-run — nothing written")
+        return {"slug": new}
+
+    new_raw = {}
+    for k, v in raw.items():
+        new_raw[new if k == old else k] = entry if k == old else v
+    _write_registry(root, new_raw)
+
+    local = _load_layer(root)  # re-load: loud, never a silent broken layer
+    got = local.get(new)
+    if got is None or got.get("origin") != "local" or got.get("engine") != ns:
+        raise InternalError(
+            f"registry rewritten but the re-load does not confirm {new!r} "
+            f"(origin=local, engine={ns}) — inspect {_LOCAL_REGISTRY_REL}"
+        )
+    if old in local:
+        raise InternalError(f"{old} still loads after the rename")
+    _info(f"renamed {old} -> {new}")
+    return {"slug": new}
+
+
+def _parse_value(raw: str) -> Any:
+    """KEY=VALUE → the value, typed like JSON (int / float / bool / null) when
+    the literal says so, a plain string otherwise (kv_format=fp8_e5m2)."""
+    try:
+        value = json.loads(raw)
+    except (ValueError, TypeError):
+        return raw
+    if isinstance(value, float) and not math.isfinite(value):
+        return raw  # NaN/Infinity would poison the JSON file
+    return value
+
+
+def update(root: Path, slug: str, key: str, value: str, *, dry_run: bool = False) -> dict:
+    """Set one field of a local entry. Returns {"slug": slug}."""
+    raw = _load_local_raw(root)
+    _load_layer(root)  # fail closed: the layer must already load
+
+    if slug not in raw:
+        raise _refuse_unknown_slug(root, slug, raw)
+
+    if key == "origin":
+        raise Refusal(
+            "origin is not editable: it is stamped by the loader (a local entry "
+            "loads with origin=local) and a local row that self-declares origin "
+            "refuses to load. To change provenance, publish the model upstream."
+        )
+
+    ns = _slug_namespace(slug)
+    if key == "engine":
+        if value != ns:
+            raise Refusal(
+                f"the engine field must equal the slug's namespace ({ns!r}). "
+                f"To move the entry to engine {value!r}: "
+                f"catalog.sh rename --slug {slug} --to {value}/<name>"
+            )
+    elif raw[slug].get("engine") != ns:
+        raise Refusal(
+            f"{slug!r}'s engine field ({raw[slug].get('engine')!r}) does not "
+            f"match its slug's namespace ({ns!r}) — repair it first: "
+            f"catalog.sh update --slug {slug} --set engine={ns}"
+        )
+
+    entry = dict(raw[slug])
+    entry[key] = _parse_value(value)
+
+    # Dry-wrap EXACTLY like the loader: an unknown kwarg or a bad value
+    # refuses before the write (the loader would otherwise take the whole
+    # layer down on the next import).
+    cr = _registry_module(root)
+    try:
+        cr._entry(origin="local", **entry)
+    except (TypeError, ValueError) as exc:
+        raise Refusal(f"cannot set {key}={value!r} on {slug!r}: {exc}") from exc
+
+    if dry_run:
+        _info(f"plan: set {key}={value!r} on {slug} in {_LOCAL_REGISTRY_REL}")
+        _info("--dry-run — nothing written")
+        return {"slug": slug}
+
+    raw[slug] = entry
+    _write_registry(root, raw)
+
+    local = _load_layer(root)  # re-load: loud, never a silent broken layer
+    got = local.get(slug)
+    if got is None or got.get("origin") != "local" or got.get("engine") != ns:
+        raise InternalError(
+            f"registry rewritten but the re-load does not confirm {slug!r} "
+            f"(origin=local, engine={ns}) — inspect {_LOCAL_REGISTRY_REL}"
+        )
+    _info(f"updated {slug}: {key}={value!r}")
+    return {"slug": slug}
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    ap = argparse.ArgumentParser(
+        prog="amend.py",
+        description=(
+            "Rename / update an entry in the LOCAL layer "
+            "(scripts/lib/profiles-local/registry.local.json — never the "
+            "curated catalog)."
+        ),
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    p = sub.add_parser("rename", help="rename a local slug to a new <engine>/<name>")
+    p.add_argument("--slug", required=True, help="the current local slug <engine>/<name>")
+    p.add_argument("--to", required=True, dest="new", help="the new <engine>/<name> slug")
+    p.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root (default: this checkout)")
+    p.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
+    p.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
+
+    p = sub.add_parser("update", help="set one field of a local entry")
+    p.add_argument("--slug", required=True, help="the local slug <engine>/<name>")
+    p.add_argument("--set", required=True, metavar="KEY=VALUE",
+                   help="the field to set (origin is not editable; engine must stay the slug's namespace)")
+    p.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root (default: this checkout)")
+    p.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
+    p.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
+
+    args = ap.parse_args(argv)
+    root = Path(args.root).resolve()
+
+    if args.cmd == "rename":
+        what = f"rename {args.slug} -> {args.new}"
+        run = lambda dry: rename(root, args.slug, args.new, dry_run=dry)
+    else:
+        if "=" not in args.set or not args.set.split("=", 1)[0]:
+            _info(f"--set needs KEY=VALUE, got {args.set!r}")
+            return EXIT_REFUSED
+        key, _, value = args.set.partition("=")
+        what = f"set {key}={value} on {args.slug}"
+        run = lambda dry: update(root, args.slug, key, value, dry_run=dry)
+
+    try:
+        if not args.yes and not args.dry_run and sys.stdin.isatty():
+            _info(f"amend plan (local layer only): {what}")
+            try:
+                reply = input(f"[amend] {what}? [y/N] ").strip().lower()
+            except EOFError:
+                reply = ""
+            if reply not in ("y", "yes"):
+                _info("aborted — nothing written")
+                return EXIT_REFUSED
+        run(args.dry_run)
+        if not args.dry_run:
+            print(f"{'RENAME_OK' if args.cmd == 'rename' else 'UPDATE_OK'} {what}")
+    except Refusal as exc:
+        print(f"[amend] refused: {exc}", file=sys.stderr)
+        return EXIT_REFUSED
+    except InternalError as exc:
+        print(f"[amend] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover - thin CLI shim
+    raise SystemExit(main())
