+++ b/scripts/tests/test-catalog-amend.sh
@@ -0,0 +1,186 @@
+#!/usr/bin/env bash
+# Guard: scripts/catalog.sh rename / update are the #1204 shadow remedy (#1202 P7).
+#
+# The local layer used to be create-and-delete only, and a local slug a
+# newly-shipped curated one now occupies is kept and MARKED "so the user can
+# rename it" — which was unreachable. These pins keep the remedy honest:
+#   1. rename moves the slug AND keeps the engine field == the slug's
+#      namespace (the loader never checks that; only the writer can);
+#   2. renaming a curated slug, renaming ONTO a curated slug, an unknown
+#      engine namespace, and `--set origin=...` are all refused — the curated
+#      catalog is never reachable and origin stays the loader's stamp;
+#   3. update changes exactly one field, typed (a port stays a number), and
+#      the layer still loads with origin=local after the write;
+#   4. --dry-run exits 0 and leaves the registry byte-identical.
+set -uo pipefail
+# Non-UTF-8 locales break python3 reads/writes on this rig (#599/#584).
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/" 2>/dev/null
+
+# Arch dims come from the weights — a fabricated config.json, no multi-GB
+# GGUF dependency (same fixture as test-catalog-cli.sh).
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+C="$TMP/byo.yml"
+cat > "$C" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a byo-probe -c 65536 -ctk q8_0 -ts 1,1
+YML
+
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+CORE_NS="${CORE%%/*}"
+CORE_SUM() { find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum; }
+
+# Fixture: one registered local entry.
+if ! scripts/catalog.sh register --compose "$C" --engine their-engine \
+     --engine-type llama.cpp --weights "$TMP/config.json" --root "$TMP" -y >/dev/null 2>&1; then
+  echo "  FAIL could not register the fixture entry in a throwaway root"; exit 1
+fi
+
+# 1. rename within the same (locally-known) engine: slug moves, engine field
+#    stays equal to the namespace, origin stays the loader's stamp.
+if scripts/catalog.sh rename --slug their-engine/byo-probe --to their-engine/byo-renamed -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  ok   rename within one engine"
+else
+  echo "  FAIL rename within one engine refused"; rc=1
+fi
+python3 - "$TMP" <<'PY' || rc=1
+import sys
+from pathlib import Path
+root = Path(sys.argv[1])
+sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+local = load_local_registry(root)
+assert "their-engine/byo-renamed" in local, "renamed slug missing"
+assert "their-engine/byo-probe" not in local, "old slug still present"
+e = local["their-engine/byo-renamed"]
+assert e["origin"] == "local", f"origin not stamped local: {e['origin']}"
+assert e["engine"] == "their-engine", f"engine field drifted: {e['engine']}"
+PY
+[[ $rc -eq 0 ]] && echo "  ok   engine == slug namespace, origin=local after rename"
+
+# 2. rename to a DIFFERENT known (curated) engine: the engine field must
+#    follow the namespace — the loader never checks that, only the writer.
+if scripts/catalog.sh rename --slug their-engine/byo-renamed --to llama-cpp-local/byo-renamed -y --root "$TMP" >/dev/null 2>&1; then
+  python3 - "$TMP" <<'PY' || rc=1
+import sys
+from pathlib import Path
+root = Path(sys.argv[1])
+sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+local = load_local_registry(root)
+e = local["llama-cpp-local/byo-renamed"]
+assert e["engine"] == "llama-cpp-local", f"engine did not follow the namespace: {e['engine']}"
+assert e["origin"] == "local"
+PY
+  [[ $rc -eq 0 ]] && echo "  ok   engine field followed the namespace across engines"
+else
+  echo "  FAIL rename across engines refused (llama-cpp-local is a known engine)"; rc=1
+fi
+
+# 3. refusals: curated source, curated target, unknown engine namespace.
+if scripts/catalog.sh rename --slug "$CORE" --to their-engine/whatever -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL rename ACCEPTED a curated slug as source"; rc=1
+else
+  echo "  ok   curated slug refused as rename source"
+fi
+if scripts/catalog.sh rename --slug llama-cpp-local/byo-renamed --to "$CORE" -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL rename ONTO a curated slug was accepted (would re-shadow it)"; rc=1
+else
+  echo "  ok   rename onto a curated slug refused"
+fi
+if scripts/catalog.sh rename --slug llama-cpp-local/byo-renamed --to nosuch-engine/x -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL rename to an unknown engine namespace was accepted"; rc=1
+else
+  echo "  ok   unknown engine namespace refused"
+fi
+if scripts/catalog.sh rename --slug their-engine/ghost --to their-engine/ghost2 -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL rename of an unregistered local slug was accepted"; rc=1
+else
+  echo "  ok   unregistered slug refused"
+fi
+
+# 4. update: one field, typed, origin and engine guarded.
+before_port="$(python3 -c "
+import json,sys
+print(json.load(open(sys.argv[1]))['llama-cpp-local/byo-renamed']['default_port'])" "$REG")"
+if scripts/catalog.sh update --slug llama-cpp-local/byo-renamed --set "default_port=$((before_port + 1))" -y --root "$TMP" >/dev/null 2>&1; then
+  python3 - "$TMP" <<'PY' || rc=1
+import json, sys
+from pathlib import Path
+root = Path(sys.argv[1])
+sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+local = load_local_registry(root)
+e = local["llama-cpp-local/byo-renamed"]
+assert isinstance(e["default_port"], int), f"port not typed as int: {e['default_port']!r}"
+assert e["engine"] == "llama-cpp-local" and e["origin"] == "local"
+PY
+  [[ $rc -eq 0 ]] && echo "  ok   update set one field, typed, layer still loads"
+else
+  echo "  FAIL update of a simple field refused"; rc=1
+fi
+if scripts/catalog.sh update --slug llama-cpp-local/byo-renamed --set origin=local -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL --set origin=... was accepted (origin is the loader's stamp)"; rc=1
+else
+  echo "  ok   --set origin refused"
+fi
+if scripts/catalog.sh update --slug llama-cpp-local/byo-renamed --set engine=their-engine -y --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL --set engine to a non-namespace value was accepted (invariant broken)"; rc=1
+else
+  echo "  ok   --set engine != namespace refused"
+fi
+
+# 5. --dry-run: exit 0, registry byte-identical, for both subcommands.
+snap1="$(md5sum "$REG" | cut -d' ' -f1)"
+if scripts/catalog.sh rename --slug llama-cpp-local/byo-renamed --to vllm-stable/byo-renamed -y --root "$TMP" --dry-run >/dev/null 2>&1; then
+  snap2="$(md5sum "$REG" | cut -d' ' -f1)"
+  if [[ "$snap1" == "$snap2" ]]; then
+    echo "  ok   rename --dry-run left the registry byte-identical"
+  else
+    echo "  FAIL rename --dry-run WROTE the registry"; rc=1
+  fi
+else
+  echo "  FAIL rename --dry-run did not exit 0"; rc=1
+fi
+if scripts/catalog.sh update --slug llama-cpp-local/byo-renamed --set mem_util=0.85 -y --root "$TMP" --dry-run >/dev/null 2>&1; then
+  snap2="$(md5sum "$REG" | cut -d' ' -f1)"
+  if [[ "$snap1" == "$snap2" ]]; then
+    echo "  ok   update --dry-run left the registry byte-identical"
+  else
+    echo "  FAIL update --dry-run WROTE the registry"; rc=1
+  fi
+else
+  echo "  FAIL update --dry-run did not exit 0"; rc=1
+fi
+
+# 6. the curated catalog is unreachable through either subcommand.
+before="$(CORE_SUM)"
+scripts/catalog.sh rename --slug "$CORE" --to their-engine/never -y --root "$TMP" >/dev/null 2>&1 || true
+scripts/catalog.sh update --slug "$CORE" --set default_port=1 -y --root "$TMP" >/dev/null 2>&1 || true
+after="$(CORE_SUM)"
+if [[ "$before" == "$after" ]]; then
+  echo "  ok   the curated catalog is unchanged"
+else
+  echo "  FAIL the curated catalog changed"; rc=1
+fi
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh rename/update amend the local layer only" \
+                   || echo "FAIL: catalog.sh amend regression"
+exit "$rc"
