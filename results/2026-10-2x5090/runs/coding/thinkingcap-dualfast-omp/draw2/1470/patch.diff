diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..318a817 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,35 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ SGLang V1 (CustomAllreduce) on a PCIe rig. V2 is NVLink-only, so every
+# PCIe rig runs V1 — and V1 logs nothing when it initializes. Its ONLY success
+# signal is "Registering N cuda graph addresses" after CUDA-graph capture (rank
+# 0). Before this fix a healthy V1 boot scored unknown ("no P2P engagement
+# signal"), never on. Real wording, sglang custom_all_reduce.py (v0.5.20).
+_sgl_v1=$(cat <<'EOF'
+[2026-09-25 02:38:00] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-09-25 02:38:05 TP0] sglang is using nccl==2.30.7
+[2026-09-25 02:38:20 TP0] Registering 4352 cuda graph addresses
+[2026-09-25 02:38:21 TP0] Registering 258 cuda graph addresses
+[2026-09-25 02:38:21 TP0] Registering 68 cuda graph addresses
+EOF
+)
+_v1_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_v1_ev" "[sglang] BOOT disable_custom_all_reduce=False"
+assert_contains "$_v1_ev" "Registering 4352 cuda graph addresses"
+r="$(printf '%s\n' "$_v1_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 'Registering N cuda graph addresses' -> custom AR on (got $r)"
+# The unfiltered raw stream classifies the same (a single-boot log has no marker
+# to slice at, so the whole stream is used).
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 success line -> on (got $r)"
+# A V1 success line from an EARLIER boot must not leak into a later
+# operator-disabled restart (epoch slice at the last BOOT marker).
+r="$(printf '%s\n%s' "$_v1_ev" '[sglang] BOOT disable_custom_all_reduce=True' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "V1 success before an operator-disabled restart must not read as on (got $r)"
+unset _sgl_v1 _v1_ev
+echo "  ✓ SGLang V1 (PCIe) 'Registering N cuda graph addresses' classifies on; no cross-restart leak"
+
