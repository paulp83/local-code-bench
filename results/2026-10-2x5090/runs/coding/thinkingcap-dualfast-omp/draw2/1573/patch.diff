   return 0
 }
 
+# vLLM's own readback: the boot log. vLLM prints exactly one
+# `non-default args: {…}` line per boot (api_server.py) carrying every arg
+# that differs from its default — `reasoning_parser` is in it only if the
+# server was started with one. This is the only readback for an image that
+# starts vLLM through its own launcher: the container's argv shows no flag
+# at all, but the log is what the running server actually booted with
+# (seen on bucko's official image, whose qwen38-serve adds
+# --reasoning-parser inside its script). The whole log is streamed (O(1)
+# memory — for a long-lived container the line sits at the START of the
+# history, so --tail cannot find it), and the LAST `non-default args` line
+# answers — the most recent boot is the one serving now. The Python is held
+# in a variable and run with -c, for the same stdin reason as the inspect
+# facts above. stdout:
+#   PARSER <value>                              a parser is in effect
+#   LOG no reasoning parser in non-default args the line is there, no parser
+#   LOG no non-default args line                nothing usable (rotated / unreadable)
+_TB_VLLM_BOOT_LOG_PY="$(cat <<'PY'
+import re, sys
+
+last = None
+for raw in sys.stdin:
+    if "non-default args:" in raw:
+        last = raw
+if last is None:
+    print("LOG no non-default args line")
+    sys.exit(0)
+# The dict is a Python repr (single-quoted); tolerate double quotes too.
+m = re.search(r"""['"]reasoning_parser['"]\s*:\s*['"]([^'"]*)['"]""", last)
+if not m:
+    # newer spellings: reasoning_config as a bare name, or as a config
+    # object whose parser key names one
+    m = re.search(r"""['"]reasoning_config['"]\s*:\s*['"]([^'"]*)['"]""", last)
+if not m:
+    m = re.search(r"""['"]reasoning_config['"]\s*:\s*\{[^{}]*['"]parser['"]\s*:\s*['"]([^'"]*)['"]""", last)
+if m:
+    print("PARSER %s" % m.group(1))
+    sys.exit(0)
+print("LOG no reasoning parser in non-default args")
+PY
+)"
+_thinking_budget_vllm_boot_log_facts() {
+  # `|| true` keeps the pipeline alive when docker logs itself fails
+  # (daemon hiccup, permissions): python then sees no input and answers
+  # "no non-default args line", which the caller treats as "no evidence".
+  { docker logs "$1" 2>/dev/null || true; } | python3 -c "$_TB_VLLM_BOOT_LOG_PY"
+}
+
 # SGLang ships model-specific ThinkingBudgetLogitProcessor subclasses
 # (python/sglang/srt/sampling/custom_logit_processor.py, v0.5.20). Only the
 # parsers whose think-token ids are known to match are mapped; anything else
@@ -331,8 +384,25 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv carries no --reasoning-parser. That is positive
+          # evidence only when the argv IS the vLLM command (the shipped
+          # composes); an image that starts vLLM through its own launcher
+          # adds the flag inside its script, so the argv shows none while
+          # the server runs with a parser. The boot log is what the
+          # running server actually booted with.
+          logfacts="$(_thinking_budget_vllm_boot_log_facts "$c")"
+          case "$logfacts" in
+            "PARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c} argv carries no --reasoning-parser, but its boot log's non-default args show reasoning_parser='${logfacts#PARSER }' — the image's own launcher adds it, and the running server has a parser, so the per-request budget takes effect"
+              return 0 ;;
+            "LOG no reasoning parser in non-default args")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — its boot log's non-default args confirm it — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+            *)
+              THINKING_BUDGET_EVIDENCE="container ${c} argv carries no --reasoning-parser and its boot log has no 'non-default args' line to settle it (unreadable or rotated away) — no positive evidence either way"
+              return 2 ;;
+          esac
+          ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
