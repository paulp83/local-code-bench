+# 2d. --dry-run must write NOTHING — including the local ENGINE profile, which
+# catalog.sh used to write in its own Python before the spec reached promote.py.
+# The dry runs above would LEAK it, and the round trip's "engine profile
+# written" check below would then pass on the leaked file — so assert both that
+# the plan names the write AND that the file is absent.
+[[ "$out" == *"engines.d/their-engine.yml (new local ENGINE profile)"* ]] \
+  || { echo "  FAIL the dry-run plan does not list the engine profile write"; rc=1; }
+if [[ -f "$TMP/scripts/lib/profiles-local/engines.d/their-engine.yml" ]]; then
+  echo "  FAIL --dry-run leaked the local ENGINE profile file"; rc=1
+else
+  echo "  ok   --dry-run lists the engine profile in the plan and wrote nothing"
+fi
 
