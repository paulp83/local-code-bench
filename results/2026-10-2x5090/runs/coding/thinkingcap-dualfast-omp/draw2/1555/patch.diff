+# ── which drafter the engine actually booted (#1537) ─────────────────────────
+# The old card grepped the container `Cmd`, which misses both engines we ship:
+# the Qwen3.8 vLLM composes build --speculative-config inside their entrypoint
+# from SPEC_N (so the flag never appears in Cmd, and MTP-on read as "spec off"),
+# and SGLang containers were never resolved at all (the vllm-(qwen|gemma) name
+# heuristic), so the card fell through to "spec ?". Read from the engine instead.
+# The drafter line on the card is what the engine booted, not what the compose
+# asked for.
+_VLLM_LOG_HEAD = 20000   # the boot line lands in the first ~200 lines of a vLLM log
+
+
+def vllm_spec_label(container: str | None) -> str | None:
+    """vLLM's drafter, read from the boot line at the HEAD of `docker logs` (NOT
+    the tail — a long-running container's recent tail never contains it):
+    ``Initializing a V1 LLM engine ... with config: ... speculative_config=...``.
+    ``SpeculativeConfig(method='mtp', ..., num_spec_tokens=4)`` -> ``MTP n=4``;
+    ``speculative_config=None`` -> ``spec off``. None when the container or the
+    line is unreadable."""
+    if not container:
+        return None
+    try:
+        p = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+            text=True, encoding="utf-8",
+        )
+    except Exception:
+        return None
+    try:
+        for line in itertools.islice(p.stdout, _VLLM_LOG_HEAD):
+            if "Initializing a V1 LLM engine" in line and "speculative_config=" in line:
+                return _parse_vllm_spec_line(line)
+    except Exception:
+        return None
+    finally:
+        p.stdout.close()
+        if p.poll() is None:
+            p.kill()
+    return None
+
+
+def _parse_vllm_spec_line(line: str) -> str | None:
+    if "speculative_config=None" in line:
+        return "spec off"
+    m = re.search(r"SpeculativeConfig\(([^)]*)\)", line)
+    if not m:
+        return "spec off"
+    fields = m.group(1)
+    method = re.search(r"method=['\"]([^'\"]+)['\"]", fields)
+    if not method:
+        return "spec off"
+    n = re.search(r"num_spec(?:ulative)?_tokens=(\d+)", fields)
+    label = method.group(1).upper()
+    return f"{label} n={n.group(1)}" if n else label
+
+
+def sglang_spec_label(url: str | None) -> str | None:
+    """SGLang's drafter, read from ``GET /get_server_info``
+    (``speculative_algorithm`` + ``speculative_num_steps``). EAGLE over the
+    target's OWN checkpoint — no separate draft, or one that IS the target: the
+    in-checkpoint MTP head the sgl/ MTP composes boot — prints ``MTP n=4``, not
+    EAGLE. None when the endpoint is unreachable."""
+    if not url:
+        return None
+    try:
+        # A local engine endpoint is never proxied: an http_proxy in the
+        # environment would turn /get_server_info into a proxy round-trip.
+        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+        with opener.open(f"{url.rstrip('/')}/get_server_info", timeout=5) as r:
+            info = json.load(r)
+    except Exception:
+        return None
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    if not algo:
+        return "spec off"
+    draft = info.get("speculative_draft_model_path") or info.get("speculative_draft")
+    model = info.get("model_path")
+    self_draft = str(algo).upper() == "EAGLE" and (not draft or (model and str(draft) == str(model)))
+    name = "MTP" if self_draft else str(algo).upper()
+    n = info.get("speculative_num_steps")
+    if isinstance(n, int) and n > 0:
+        return f"{name} n={n}"
+    return name
+
+
+def spec_label(container: str | None, url: str | None) -> str | None:
+    """The drafter line for the card (#1537): the vLLM boot-log label when
+    $CONTAINER resolves, else SGLang's /get_server_info against $URL. None —
+    print nothing — when neither source is readable."""
+    label = vllm_spec_label(container)
+    if label is not None:
+        return label
+    return sglang_spec_label(url)
+
+
