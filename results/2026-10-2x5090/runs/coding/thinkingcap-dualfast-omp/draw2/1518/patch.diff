diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..9352858 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1022,12 +1022,35 @@ down_running() {
     [[ -n "${managed[$c]:-}" ]] || continue   # not ours — leave it alone
     brought_down=1
     echo "[switch] bringing down: ${c}"
-    # derive the compose dir/file from the container's labels — stop fallback
+    # derive the compose dir/files from the container's labels — stop fallback
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      # Since #1498 every launch carries a second compose file (the slug-label
+      # override in the data dir), so config_files is a comma-joined list — one
+      # -f per entry. The override only adds labels, so down doesn't need it:
+      # drop entries that no longer exist (moved/purged data dir); with none
+      # left, just stop the container. Relative entries resolve against the
+      # project working dir (lbl_dir); the override's absolute path as-is.
+      local -a _cfgs=()
+      local f
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      (
+        cd "$lbl_dir" || { docker stop "$c" >/dev/null; exit 0; }
+        fargs=()
+        for f in "${_cfgs[@]}"; do
+          if [[ -n "$f" && -f "$f" ]]; then
+            fargs+=(-f "$f")
+          fi
+        done
+        if (( ${#fargs[@]} > 0 )); then
+          ${COMPOSE_BIN} "${fargs[@]}" down --remove-orphans || docker stop "$c" >/dev/null
+        else
+          docker stop "$c" >/dev/null
+        fi
+        exit 0
+      )
     else
       docker stop "$c" >/dev/null
     fi
