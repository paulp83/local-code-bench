diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..7bdc343 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -16,6 +16,10 @@
 #   5. Teardown passes --remove-orphans.
 #   6. When only unmanaged containers run, nothing is torn down and the
 #      "no club-3090 container running" path is taken.
+#   7. #1498: the config_files label is comma-joined (slug compose + slug-label
+#      override) — each entry is passed to compose as its own -f.
+#   8. The label override is gone (data dir moved): compose still runs, with the
+#      slug's compose only; with no listed file left, docker stop is the fallback.
 #
 # Harness: extract down_running() via sed, source it, inject a VARIANT_CONTAINER
 # managed set + a mock `docker` on PATH that records compose-down / stop calls.
@@ -59,9 +63,10 @@ cleanup() { rm -rf "$tmp_dir" "$HELPERS_FILE"; }
 trap cleanup EXIT
 
 # --- Mock `docker`: records compose-down / stop to $DOCKER_MOCK_LOG -----------
-# Labels are returned non-empty so the compose-down branch is taken; the
-# config_files label embeds the container name so the log identifies which
-# container was brought down.
+# Since #1498 the config_files label is comma-joined: the slug's compose
+# (relative, in the project working dir) + the slug-label override (absolute,
+# in the data dir — modeled under $DOCKER_MOCK_WORKDIR/labels/). The names
+# embed the container so the log identifies which container was brought down.
 cat > "${tmp_dir}/docker" <<'EOF'
 #!/usr/bin/env bash
 sub="$1"; shift || true
@@ -80,7 +85,7 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      printf 'compose-%s.yml,%s/labels/%s.yml\n' "$cname" "$DOCKER_MOCK_WORKDIR" "$cname"
     fi
     ;;
   stop)
@@ -94,6 +99,13 @@ esac
 exit 0
 EOF
 chmod +x "${tmp_dir}/docker"
+# The label entries must exist for down_running to pass them to compose — the
+# slug's compose in the working dir, the overrides under labels/ (the data dir).
+mkdir -p "${tmp_dir}/labels"
+for n in vllm-qwen36-27b ik-llama-qwen36-27b vllm-qwen36-27b-dual; do
+  : > "${tmp_dir}/compose-${n}.yml"
+  : > "${tmp_dir}/labels/${n}.yml"
+done
 
 export DOCKER_MOCK_LOG="${tmp_dir}/calls.log"
 export DOCKER_MOCK_WORKDIR="${tmp_dir}"   # real dir so (cd "$lbl_dir") succeeds
@@ -124,6 +136,8 @@ assert_contains     "$log" "compose-ik-llama-qwen36-27b.yml" "managed ik-llama c
 assert_not_contains "$log" "unrelated-db"                    "unrelated container left alone"
 assert_not_contains "$log" "litellm"                         "services-stack container left alone"
 assert_contains     "$log" "--remove-orphans"                "teardown passes --remove-orphans"
+assert_contains     "$log" "-f ${tmp_dir}/labels/vllm-qwen36-27b.yml"     "slug compose AND its label override each passed as -f (#1498)"
+assert_contains     "$log" "-f ${tmp_dir}/labels/ik-llama-qwen36-27b.yml" "comma-joined label split into one -f per file"
 
 # --- Scenario 2: only unmanaged containers running ----------------------------
 : > "$DOCKER_MOCK_LOG"
@@ -134,6 +148,27 @@ log="$(cat "$DOCKER_MOCK_LOG")"
 assert_not_contains "$log" "COMPOSE"                          "nothing torn down when only unmanaged running"
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
+# --- Scenario 3: the label override is gone (data dir moved) -------------------
+# down must still run, with the slug's compose only — the override adds labels
+# and nothing else, so compose doesn't need it.
+: > "$DOCKER_MOCK_LOG"
+rm -f "${tmp_dir}/labels/vllm-qwen36-27b-dual.yml"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b-dual"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_contains     "$log" "-f compose-vllm-qwen36-27b-dual.yml"          "slug compose still passed when the override is gone"
+assert_not_contains "$log" "labels/vllm-qwen36-27b-dual.yml"              "missing override dropped, not passed to compose"
+
+# --- Scenario 4: none of the listed files exist anymore -------------------------
+# No compose call at all — fall back to docker stop.
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="llama-cpp-qwen36-27b"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_contains     "$log" "STOP llama-cpp-qwen36-27b"                    "all-missing label: docker stop fallback"
+assert_not_contains "$log" "COMPOSE"                                      "all-missing label: compose not called"
 
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
