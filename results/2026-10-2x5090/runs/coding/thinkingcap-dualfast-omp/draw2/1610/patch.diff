+# (6) install-script negative controls. The legacy `delivery:` fallback
+#     used to derive its markers from the patch's `files` as: the entry's
+#     own name PLUS, for a directory entry, its PARENT's name — always
+#     `patches`, present in every compose that mounts ANY patch — and for
+#     a file entry the bare filename — `install.sh`, present in every
+#     compose that runs ANY install script. So a compose whose mount +
+#     invoke for the patch had been removed still reported reached (the
+#     sound delivery_spec check said False; the fallback overrode it).
+#     Two controls per install-script patch:
+#       * "unwired": the patch's mount + invoke are gone; the compose
+#         still carries the generic patch machinery (another patch dir
+#         under .../patches/ + its install.sh). Must report NOT reached.
+#       * "other-patch-same-target": a DIFFERENT patch is mounted at the
+#         same in-container target (the vLLM and SGLang w4a8 dirs are both
+#         wired at /etc/club3090/w4a8). The target string is present but
+#         the mount's source is the other patch's dir. Must report NOT
+#         reached (the sound check binds the mount line to THIS patch's
+#         source, not just the target).
+#     Plus a "wired" positive control (own dir at the declared target,
+#     invoked) that must keep reporting reached.
+for patch in patches:
+    if patch.get("delivery_mechanism") != "install_script":
+        continue
+    spec = patch.get("delivery_spec") or {}
+    script_rel = spec.get("script")
+    if not script_rel:
+        continue
+    dir_name = Path(script_rel).parent.name
+    mounted = spec.get("mounted_at")
+    invoke = spec.get("invoke") or ""
+    literal = (
+        invoke
+        if (invoke and "/" in invoke and not invoke.endswith((".", "serving", "import")))
+        else ""
+    )
+    if mounted:
+        wired = (
+            "services:\n"
+            "  s:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ../../patches/{dir_name}:{mounted}:ro\n"
+            f"    command: {literal or f'bash {mounted}/install.sh'}\n"
+        )
+    else:
+        # No declared target: the identifying artifact is the patch dir's
+        # own name in a mount line (the improved fallback path).
+        wired = (
+            "services:\n"
+            "  s:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ../../patches/{dir_name}:/opt/patch-000:ro\n"
+        )
+    unwired = (
+        "services:\n"
+        "  s:\n"
+        "    image: scratch\n"
+        "    volumes:\n"
+        "      - ../../patches/other-patch-000:/etc/club3090/other-patch-000:ro\n"
+        "    command: bash /etc/club3090/other-patch-000/install.sh\n"
+    )
+    other_same_target = None
+    if mounted:
+        other_same_target = (
+            "services:\n"
+            "  s:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ../../patches/other-patch-000:{mounted}:ro\n"
+            f"    command: bash {mounted}/install.sh\n"
+        )
+    with tempfile.TemporaryDirectory() as _ctl:
+        _ctlp = Path(_ctl)
+        controls = [("wired", wired, True), ("unwired", unwired, False)]
+        if other_same_target is not None:
+            controls.append(("other-patch-same-target", other_same_target, False))
+        for label, text, expect in controls:
+            _f = _ctlp / f"installctl-{patch['id']}-{label}.yml"
+            _f.write_text(text, encoding="utf-8")
+            got = pa.reaches(root, patch, str(_f))
+            if got != expect:
+                errors.append(
+                    f"install-script control {patch['id']} ({label}): "
+                    f"reaches()={got}, expected {expect} — an unwired "
+                    f"install-script patch must not report reached (the "
+                    f"legacy fallback's generic `patches`/`install.sh` "
+                    f"markers / a foreign mount at the same target must "
+                    f"not count)"
+                )
+
