+# Recurrent state, both line shapes the llama.cpp family emits (see the
+# module docstring). Line-scoped on purpose: one value per line, so a line
+# that carries both anchors cannot be counted twice.
+_STATE_PAT = re.compile(
+    r"(?:_comp_state|llama_memory_recurrent):\s+(CUDA\d)\s"
+    r".*?\b(?:state|RS) buffer size =\s+([\d.]+) MiB"
+)
+
+
+def _state_per_dev(text):
+    out = {}
+    for line in text.splitlines():
+        m = _STATE_PAT.search(line)
+        if m:
+            dev, val = m.group(1), float(m.group(2))
+            out[dev] = out.get(dev, 0.0) + val
+    return out
+
