+def _is_ambiguous_template_target(mounted_at: str | None) -> bool:
+    """True if a chat-template ``mounted_at`` is a bare suffix (a single path
+    component, e.g. ``/chat_template.jinja``).
+
+    Such a target is AMBIGUOUS: the template is mounted over each model dir's
+    own ``chat_template.jinja``, so on the container target alone ANY compose
+    that mounts ANY template over a model dir matches it. It must be
+    disambiguated by the vendored template's own source on the same line.
+    A distinctive container path (``/etc/apex-qwen-chat-template.jinja``) is
+    self-identifying and needs no such disambiguation."""
+    if not mounted_at:
+        return False
+    return len([part for part in mounted_at.split("/") if part]) == 1
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line: the
+    vendored template's own directory or (unique) filename, minus generic names.
+
+    The generic basename ``chat_template.jinja`` sits on EVERY template mount, so
+    it is dropped and the identifying directory is used instead (e.g.
+    ``qwen38-reasoning-effort-template``); a distinctive filename (e.g.
+    ``apex-qwen-chat-template.jinja``) identifies the patch on its own."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    names: set[str] = set()
+    generic_dirs = {"patches", "models", ""}
+    for rel in patch.get("files") or []:
+        path = Path(rel)
+        if path.suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES:
+            # a .jinja file: its directory identifies it; the filename too,
+            # unless it is the generic chat_template.* (on every template mount).
+            if path.stem != "chat_template":
+                names.add(path.name)
+            names.add(path.parent.name)
+        elif not path.suffix:
+            # a directory entry (e.g. glm53-minja-numeric-index)
+            names.add(path.name)
+    return sorted(n for n in names if n and n not in generic_dirs)
+
+
+def _wiring_sources(patch: dict) -> list[str]:
+    """Host-side source names that pin a mounted-artifact patch to its own mount
+    line (the source-aware check of #1597/#1610): install scripts and
+    chat templates alike."""
+    return _install_sources(patch) or _chat_template_sources(patch)
+
