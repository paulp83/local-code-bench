+        our_pids="$(docker inspect "$our_container" --format '{{.State.Pid}}' 2>/dev/null || true)"
+      fi
+    fi
+
+    # Attribute each card to the process nvidia-smi actually reports on it.
+    gpu_holders_build
+
     nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits 2>/dev/null \
       | while IFS=, read -r idx used; do
           idx="${idx# }"; used="${used# }"
