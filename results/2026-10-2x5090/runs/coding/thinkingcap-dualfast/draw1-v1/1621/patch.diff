 import importlib.util, sys
@@ -1245,12 +1286,16 @@ info = m.parse_readback(sys.stdin.read()) or {}
 print(info.get("default_effort") or "")' "${ROOT_DIR}/scripts/lib/effort_budget.py" 2>/dev/null || true)"
