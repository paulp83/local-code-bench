+    _sb_out=""; _sb_rc=2
+    if [[ -n "${_tb_kind:-}" ]]; then
+      _sb_kind="$_tb_kind"
+    else
+      # engine family of the serving container (name, then image)
+      # shellcheck source=lib/engine-kind.sh
+      source "${ROOT_DIR}/scripts/lib/engine-kind.sh"
+      _sb_kind="$(engine_kind_from_container "$CONTAINER" 2>/dev/null || true)"
+      if [[ "$_sb_kind" == "unknown" ]]; then
+        _sb_kind="$(engine_kind_from_image "$(docker inspect "$CONTAINER" --format '{{.Config.Image}}' 2>/dev/null || true)" 2>/dev/null || true)"
+      fi
+    fi
+    if [[ "$_sb_kind" == "llamacpp" ]]; then
+      _sb_src="read from ${CONTAINER}'s boot config (llama.cpp --reasoning-budget, server-wide)"
+      # shellcheck source=lib/thinking-budget.sh
+      source "${ROOT_DIR}/scripts/lib/thinking-budget.sh"
+      _sb_facts="$(docker inspect "$CONTAINER" 2>/dev/null | _thinking_budget_container_facts llamacpp)"
+      case "$_sb_facts" in
+        "BUDGET "*)
+          _sb_n="${_sb_facts#BUDGET }"
+          if [[ "$_sb_n" =~ ^[1-9][0-9]*$ ]]; then
+            _sb_out="$_sb_n"; _sb_rc=0
+          else
+            # -1: the flag is present but unbounded (REASONING_BUDGET unset at
+            # boot), so nothing bounds the run — the cap is left alone.
+            _sb_out="unknown"; _sb_rc=2
+          fi ;;
+        *)
+          # no --reasoning-budget, or the value could not be resolved
+          _sb_out="unknown"; _sb_rc=2 ;;
+      esac
+    else
+      _sb_src="read from ${CONTAINER}'s boot log"
+      _sb_lines="$(docker logs "$CONTAINER" 2>&1 | command grep -F '[effort-budget]' || true)"
+      _sb_args=(readback-budget --line -)
+      if [[ -n "$_sb_effort" ]]; then _sb_args+=(--effort "$_sb_effort"); fi
+      _sb_rc=0
+      _sb_out="$(printf '%s\n' "$_sb_lines" | python3 "${ROOT_DIR}/scripts/lib/effort_budget.py" "${_sb_args[@]}" 2>&1)" || _sb_rc=$?
+    fi
     if [[ "$_sb_rc" == "0" && "$_sb_out" =~ ^[0-9]+$ ]]; then
       SERVER_THINKING_BUDGET="$_sb_out"
       SERVER_THINKING_EFFORT="$_sb_effort"
-      if [[ -z "$SERVER_THINKING_EFFORT" ]]; then
