+def _spec_wired_at_dimensions(patch: dict) -> set:
+    """The insertion-point dimensions a ``delivery_spec`` declares (from
+    ``wired_at``), normalized to a set (e.g. ``{"volumes", "entrypoint"}``)."""
+    spec = patch.get("delivery_spec") or {}
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    return set(wired_at or [])
+
+
+def _spec_is_decisive(patch: dict) -> bool:
+    """True iff the ``delivery_spec`` can actually verify its declared wiring.
+
+    A spec is *decisive* when it declares a non-empty ``wired_at`` AND carries
+    at least one concrete marker (a mount target / an invoke string) for
+    EVERY dimension it declares. For such a spec, :func:`_spec_wiring_present`
+    returning False means the patch is genuinely unwired, so that result is
+    the final word and the legacy ``delivery:`` fallback must NOT override it.
+
+    A spec that declares e.g. ``wired_at: [volumes, ...]`` but carries no
+    ``mounted_at`` (hence no volume marker) is *incomplete*: it cannot confirm
+    or deny the volume dimension on its own, so the identifying-marker fallback
+    below still has the last look for it.
+    """
+    if not patch.get("delivery_spec"):
+        return False
+    dims = _spec_wired_at_dimensions(patch)
+    if not dims:
+        return False
+    vol_markers, inv_markers = _spec_wiring_markers(patch)
+    if "volumes" in dims and not vol_markers:
+        return False
+    if "entrypoint" in dims and not inv_markers:
+        return False
+    return True
+
