+def _fallback_markers(patch: dict, root: Path) -> list[str]:
+    """Identifying text markers for the legacy ``delivery:`` fallback.
+
+    The legacy code keyed on the *bare artifact filename* (e.g. ``install.sh``,
+    present in every compose that runs any install script) and, for a directory
+    entry, its *parent dir name* (always ``patches``, present in every compose
+    that mounts any patch dir). Both are non-identifying, so the fallback
+    reported a patch as reached in a compose whose own mount + invoke for it
+    had been removed (#147).
+
+    Instead we match strings that appear only where THIS patch is actually
+    wired: the patch's own directory name (the repo dir holding its artifacts)
+    and its declared mount target (the container path basename from
+    ``delivery_spec.mounted_at`` / ``overlay_files[].dest`` — present in both
+    the volume line and, for install scripts, the invoke line). The patch id
+    (often == the dir name) is included for parity. Non-identifying basenames
+    are dropped defensively.
+    """
+    markers: list[str] = []
+    for rel in patch.get("files") or []:
+        p = Path(rel)
+        # A dir entry: its own name. A file entry: its containing dir's name —
+        # but a file that sits directly in the shared ``patches/`` container
+        # has no patch-specific dir, so its parent name (``patches``) is
+        # non-identifying and is dropped (the patch id / mount target below
+        # remain identifying).
+        dir_name = p.name if (root / rel).is_dir() else p.parent.name
+        if dir_name and dir_name not in GENERIC_CONTAINER_DIR_NAMES:
+            markers.append(dir_name)
+    spec = patch.get("delivery_spec") or {}
+    if spec.get("mounted_at"):
+        markers.append(Path(spec["mounted_at"]).name)
+    for of in spec.get("overlay_files") or []:
+        if of.get("dest"):
+            markers.append(Path(of["dest"]).name)
+    if patch.get("id"):
+        markers.append(patch["id"])
+    seen: set[str] = set()
+    out: list[str] = []
+    for m in markers:
+        if not m or m in seen or m in GENERIC_ARTIFACT_BASENAMES:
+            continue
+        seen.add(m)
+        out.append(m)
+    return out
+
