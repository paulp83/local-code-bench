+def _source_markers(patch: dict, root: Path | None = None) -> list[str]:
+    """Identifying markers for the patch's own mount SOURCE, from ``files``.
+
+    A patch's mount is identified by its OWN directory name: a directory entry
+    by the directory itself, a file entry by the directory that contains it
+    (the patch dir). This is what distinguishes one patch's mount from a
+    DIFFERENT patch mounted at the same in-container target, and it replaces
+    the legacy fallback's non-identifying markers (the generic ``patches``
+    parent dir and bare filenames like ``install.sh``).
+
+    ``root`` is required to tell a directory entry from a file entry; when it
+    is unknown (``None``) we cannot, so we return nothing and the caller falls
+    back to the declared targets alone (the previous behaviour).
+    """
+    if root is None:
+        return []
+    markers: list[str] = []
+    for rel in patch.get("files") or []:
+        target = root / rel
+        name = target.name if target.is_dir() else target.parent.name
+        if name in _NON_IDENTIFYING_DIR_NAMES:
+            continue
+        if name not in markers:
+            markers.append(name)
+    return markers
+
