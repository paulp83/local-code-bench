+# The model-dir default chat-template filename. When a `chat_template` patch's
+# declared mount target is JUST this bare name (e.g. `/chat_template.jinja`,
+# mounted OVER each model dir's own template, as qwen38 does), the target alone
+# cannot identify the patch — every model dir ships a `chat_template.jinja` — so
+# the vendored SOURCE (this patch's own directory or filename) must appear on the
+# same mount line to attribute the mount to the patch (#1610 follow-up).
+_GENERIC_TEMPLATE_BASENAMES = {
+    "chat_template.jinja",
+    "chat_template.jinja2",
+    "chat_template.j2",
+    "chat_template",
+}
+
+
+def _template_source_identity(patch: dict) -> list[str]:
+    """Distinctive token(s) that identify this patch's VENDORED template on its
+    mount line: the vendored jinja's own directory name (e.g.
+    ``qwen38-reasoning-effort-template``, ``glm53-minja-numeric-index``,
+    ``google-canonical-chat-template``), or its filename when the file lives
+    directly under a generic ``patches/`` dir (e.g. ``apex-qwen-chat-template.jinja``).
+
+    A compose mounts the whole vendored path (``.../patches/<id>/chat_template.jinja``),
+    so this token appears on the mount line for this patch's template and on no
+    other patch's mount line.
+    """
+    spec = patch.get("delivery_spec") or {}
+    jinja = spec.get("jinja")
+    if not jinja:
+        for rel in patch.get("files") or []:
+            if Path(rel).suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES:
+                jinja = rel
+                break
+    if not jinja:
+        return []
+    p = Path(jinja)
+    parent = p.parent.name
+    if parent and parent != "patches":
+        return [parent]
+    if p.name:
+        return [p.name]
+    return []
+
