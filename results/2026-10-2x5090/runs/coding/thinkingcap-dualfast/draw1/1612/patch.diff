+# --------------------------------------------------------------------------
+# chat_template wiring — source-aware (the #1610 install-script rule, extended
+# to vendored templates).
+# --------------------------------------------------------------------------
+def _chat_template_wired(patch: dict, body: str) -> bool:
+    """True iff the compose wires in THIS ``chat_template`` patch's vendored
+    template (``body`` is the comment-stripped, REAL-merged service body).
+
+    The load-bearing artifact for a ``chat_template`` patch is the bind mount of
+    its vendored ``.jinja``, and attribution must be SOURCE-AWARE so one patch's
+    template never counts for another's (the #1610 install-script rule, extended
+    here). The declared mount target (``mounted_at``) must appear on a line, and
+    when that target is the bare model-dir default (``chat_template.jinja`` — a
+    suffix shared by every model dir's own template, e.g. qwen38's
+    ``/chat_template.jinja`` mounted over each checkpoint's) the line must ALSO
+    carry the patch's own vendored source (its directory or filename). A
+    distinctive container path (e.g. ``/etc/apex-qwen-chat-template.jinja``) is
+    unique to the patch, so its mere presence — on the mount line or the
+    ``--chat-template[-file]`` line that names it — is enough.
+
+    This is what stops a compose that mounts *some* other template (whose path
+    merely ends in ``/chat_template.jinja``) from "reaching" the patch, and stops
+    a bare ``--chat-template`` flag (or one matched as a prefix of
+    ``--chat-template-file``) from counting on its own: the flag only matters
+    when it names *this* patch's mounted path, which the source-aware target
+    match already enforces.
+    """
+    spec = patch.get("delivery_spec") or {}
+    target = spec.get("mounted_at")
+    if not target:
+        return False
+    lines = body.splitlines()
+    if Path(target).name in _GENERIC_TEMPLATE_BASENAMES:
+        sources = _template_source_identity(patch)
+        if not sources:
+            return any(target in ln for ln in lines)
+        return any(target in ln and any(src in ln for src in sources) for ln in lines)
+    return any(target in ln for ln in lines)
+
+
