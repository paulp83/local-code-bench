+def _url_host_port(url):
+    """The host PORT a URL points at (as str), or None if it can't be parsed."""
+    from urllib.parse import urlsplit
+
+    try:
+        parts = urlsplit(url)
+    except (ValueError, TypeError):
+        return None
+    if parts.port is not None:
+        return str(parts.port)
+    if parts.scheme == "https":
+        return "443"
+    if parts.scheme == "http":
+        return "80"
+    return None
+
+
+def container_for_url(url):
+    """Name of the RUNNING container that publishes the port of ``url`` (from
+    ``docker ps``, any engine), or None when nothing does.
+
+    Replaces the old ``vllm-(qwen|gemma)`` name heuristic: a container is found by
+    the port it actually serves, so an SGLang (or any other engine) container is
+    found too — the heuristic never matched anything but vLLM-named containers, so
+    those probes ran rig-wide (#1537).
+    """
+    target = _url_host_port(url)
+    if not target:
+        return None
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            timeout=10,
+        )
+    except Exception:
+        return None
+    for line in out.stdout.splitlines():
+        if not line.strip():
+            continue
+        name, _, ports = line.partition("\t")
+        name = name.strip()
+        if not name:
+            continue
+        for entry in ports.split(","):
+            host = entry.strip().split("->", 1)[0]  # host side of the mapping
+            hport = host.rsplit(":", 1)[-1]         # ... its port
+            if hport == target:
+                return name
+    return None
+
+
+def _head_logs(container, max_bytes=8 * 1024 * 1024):
+    """Up to ``max_bytes`` from the HEAD of the container's docker logs (stdout+stderr).
+
+    The engine-init dump is printed once at startup, near the top, but a long-lived
+    engine's log can be hundreds of MB and ``docker logs`` has no ``--head`` — so
+    read a bounded prefix and stop, rather than slurping the whole thing (the same
+    approach as run_context / resolved_config's _boot_log_prefix).
+    """
+    if not container:
+        return ""
+    try:
+        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+        from resolved_config import _boot_log_prefix
+
+        text, _truncated, _err = _boot_log_prefix(container)
+        if text:
+            return text
+    except Exception:
+        pass
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+        )
+        chunks, total = [], 0
+        while total < max_bytes:
+            chunk = proc.stdout.read(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            total += len(chunk)
+        try:
+            proc.stdout.close()
+        except OSError:
+            pass
+        if proc.poll() is None:
+            proc.kill()
+        proc.wait()
+        return b"".join(chunks).decode("utf-8", "replace")
+    except Exception:
+        return ""
+
+
+def _spec_label_from_vllm(container):
+    """The vLLM speculative-decoding label from the engine-init line at the HEAD of
+    the container log, or None. ``speculative_config=None`` reads ``spec off``;
+    ``SpeculativeConfig(method='mtp', ..., num_spec_tokens=4)`` reads ``MTP n=4``.
+
+    Read from the HEAD (not ``--tail``): the init line is printed once at startup,
+    so by the time a probe runs a ``--tail`` window has long since scrolled past it.
+    """
+    text = _head_logs(container)
+    if not text:
+        return None
+    i = text.find("speculative_config=")
+    if i < 0:
+        return None
+    rest = text[i + len("speculative_config="):]
+    if re.match(r"\s*None\b", rest):
+        return "spec off"
+    start = rest.find("(")
+    if start < 0:
+        return None
+    depth, quote, esc, end = 0, "", False, -1
+    for j in range(start, len(rest)):
+        ch = rest[j]
+        if quote:
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == quote:
+                quote = ""
+            continue
+        if ch in "'\"'":
+            quote = ch
+        elif ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+            if depth == 0:
+                end = j
+                break
+    if end < 0:
+        return None
+    block = rest[start:end + 1]
+    mm = re.search(r"method=['\"]([^'\"]+)['\"]", block)
+    nt = re.search(r"num_spec_tokens=([0-9]+)", block)
+    method = mm.group(1).upper() if mm else "?"
+    if nt:
+        return f"{method} n={nt.group(1)}"
+    return method
+
+
+def _spec_label_from_sglang(url):
+    """The SGLang speculative-decoding label from GET /get_server_info, or None.
+
+    EAGLE over the target's own checkpoint is functionally MTP, so it reads
+    ``MTP n=<speculative_num_steps>``; any other algorithm prints its own name.
+    """
+    if not url:
+        return None
+    try:
+        req = urllib.request.Request(url + "/get_server_info")
+        with urllib.request.urlopen(req, timeout=10) as resp:
+            data = json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+    if not isinstance(data, dict):
+        return None
+    algo = data.get("speculative_algorithm")
+    if not algo:
+        return None
+    label = "MTP" if str(algo).lower() == "eagle" else str(algo)
+    n = data.get("speculative_num_steps")
+    if n not in (None, ""):
+        return f"{label} n={n}"
+    return label
+
+
+def spec_label(container, url):
+    """The speculative-decoding label read from the engine, or None when NEITHER
+    source is readable (never a guess). vLLM: the container's boot log; SGLang:
+    GET /get_server_info.
+    """
+    label = _spec_label_from_vllm(container)
+    if label is not None:
+        return label
+    return _spec_label_from_sglang(url)
+
