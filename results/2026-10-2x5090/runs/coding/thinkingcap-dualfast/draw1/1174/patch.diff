+def is_tool_unavailable(rc: int, blob: str) -> bool:
+    """True iff a failed rung-1 ``hf download`` died because the ``hf`` CLI is
+    not on PATH — NOT because of the repo, the files, or the network.
+
+    Either signal suffices:
+
+    * ``rc == 127``, the shell's canonical "command not found" status (what a
+      bare ``hf …`` returns when the binary is absent);
+    * this module's own sentinel from ``_hf_download`` ("neither ``hf`` nor
+      ``huggingface-cli`` is on PATH"), which pre-empts the spawn so the answer
+      never even depends on the shell's rc.
+
+    A missing-tool failure says nothing about the files, so rung 3 (raw resolve
+    + curl — no ``hf`` dependency at all) is still able to serve the pull.
+    Treating it as *fallback-eligible* instead of a hard stop is the point: a
+    rig that has ``curl`` but not ``hf`` can still fetch. Contrast
+    :func:`is_xet_refusal`, which is a hard policy wall the fallback rungs also
+    have to respect — here the wall is simply "no downloader on PATH"."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return ("neither `hf` nor `huggingface-cli` is on path" in low
+            or "command not found" in low)
+
+
