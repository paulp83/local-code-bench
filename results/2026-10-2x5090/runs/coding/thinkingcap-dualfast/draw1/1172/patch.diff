+def _compute_per_dev(text):
+    """Per-device compute MiB from ``sched_reserve`` lines, without double-counting.
+
+    A device can log several ``compute buffer size`` reservations in one boot:
+    the target reserves, the drafter reserves, then the target RE-reserves a
+    larger buffer once the drafter is in. The target's own (re)reservations are
+    one buffer and must NOT be summed; the drafter's reservation is a distinct
+    context and IS additive. The log does not label which context a line
+    belongs to, so we infer it: a reservation that drops strictly below a size
+    already established (and is followed by a larger one) is the interleaved
+    drafter buffer; the largest value is the target's final reservation.
+    """
+    vals = {}
+    for m in re.finditer(
+        r"sched_reserve:\s+(CUDA\d) compute buffer size =\s+([\d.]+) MiB", text
+    ):
+        vals.setdefault(m.group(1), []).append(float(m.group(2)))
+    out = {}
+    for dev, v in vals.items():
+        if not v:
+            continue
+        extra, running = 0.0, v[0]
+        for i, x in enumerate(v[1:], start=1):
+            if x >= running:
+                running = x            # target growing / re-reserving its own buffer
+            elif max(v[i + 1:], default=x) > x:
+                extra += x             # strict dip below an established size, then a
+                #                      larger one follows -> interleaved drafter
+        out[dev] = max(v) + extra
+    return out
+
+
