+def container_for_url(url):
+    """The running container that publishes the port in ``url`` (docker ps, any engine), or
+    None. The old CONTAINER resolver grepped for a ``vllm-(qwen|gemma)`` name, so an SGLang
+    container was never found and the card fell back to rig-wide GPUs; the published host
+    port identifies the serving container regardless of engine."""
+    if not url:
+        return None
+    try:
+        port = urlparse(url).port
+    except (ValueError, TypeError):
+        port = None
+    if not port:
+        return None
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", timeout=10,
+        ).stdout
+    except Exception:
+        return None
+    port_s = str(port)
+    for line in (out or "").splitlines():
+        name, _, ports = line.partition("\t")
+        name = name.strip()
+        if not name:
+            continue
+        for spec in ports.split(","):
+            host = spec.split("->")[0].strip()
+            m = re.search(r":(\d+)$", host)
+            if m and m.group(1) == port_s:
+                return name
+    return None
+
+
+def _spec_label_vllm(container):
+    """Speculative-decoding label for a vLLM container, read from the
+    ``Initializing a V1 LLM engine ... with config: ... speculative_config=...`` line at the
+    HEAD of ``docker logs`` (the boot-time config, not a later sample). Qwen3.8 vLLM composes
+    build ``--speculative-config`` inside their entrypoint from SPEC_N, so the flag never
+    appears in the container ``Cmd`` — the boot log is the only source of truth.
+    ``speculative_config=None`` -> "spec off";
+    ``SpeculativeConfig(method='mtp', ..., num_spec_tokens=4)`` -> "MTP n=4"."""
+    if not container:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "logs", container],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+            timeout=20,
+        )
+        txt = (out.stdout or "") + (out.stderr or "")
+    except Exception:
+        return ""
+    # The engine-init line with the config is at the head; take the FIRST match, not the tail.
+    m = re.search(r"speculative_config\s*=\s*(None|SpeculativeConfig\()", txt)
+    if not m:
+        return ""
+    if m.group(1) == "None":
+        return "spec off"
+    # The config repr can run long; parse the fields within a window after the match.
+    window = txt[m.start(): m.start() + 2000]
+    method_m = re.search(r"method\s*=\s*['\"]?([A-Za-z0-9_\-]+)", window)
+    tok_m = re.search(r"num_spec(?:ulative)?_tokens\s*=\s*(\d+)", window)
+    if not method_m:
+        return ""
+    method = method_m.group(1).upper()
+    if tok_m:
+        return f"{method} n={tok_m.group(1)}"
+    return method
+
+
+def _spec_label_sglang(url):
+    """Speculative-decoding label for an SGLang server, read from
+    ``GET <url>/get_server_info``. EAGLE run over the target's own checkpoint is the model's
+    MTP head, so it reads ``MTP n=<speculative_num_steps>``; any other algorithm prints its
+    own name. An empty ``speculative_algorithm`` is ``spec off``; an unreachable endpoint
+    yields nothing."""
+    if not url:
+        return ""
+    try:
+        req = urllib.request.Request(url.rstrip("/") + "/get_server_info")
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            info = json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return ""
+    if not isinstance(info, dict):
+        return ""
+    algo = str(info.get("speculative_algorithm") or "").strip()
+    if not algo:
+        return "spec off"
+    steps = info.get("speculative_num_steps")
+    steps_s = str(steps) if steps not in (None, "") else ""
+    name = "MTP" if algo.lower() in ("eagle", "eagle3", "eagle-3") else algo.upper()
+    return f"{name} n={steps_s}" if steps_s else name
+
+
+def spec_label(url, container):
+    """The card's speculative-decoding label. vLLM reads the container's boot log; SGLang
+    reads /get_server_info. Empty string when neither source is readable, so the caller can
+    fall back (the shell maps that to "spec ?")."""
+    if container:
+        label = _spec_label_vllm(container)
+        if label:
+            return label
+    if url:
+        return _spec_label_sglang(url)
+    return ""
+
+
