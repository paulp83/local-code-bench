+def _split_selectors(selectors):
+    """Normalise GPU selectors. Compose emits ``device_ids: ["${ESTATE_GPUS}"]`` as a
+    SINGLE DeviceIDs entry with a comma (``["2,3"]``) rather than ``["2", "3"]``; treat the
+    two the same. ``None`` (the container sees every GPU) passes through unchanged."""
+    if not selectors:
+        return selectors
+    out = []
+    for s in selectors:
+        for part in str(s).split(","):
+            part = part.strip()
+            if part:
+                out.append(part)
+    return out
