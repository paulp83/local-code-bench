+SERVER_THINKING_EFFORT=""          # the effort that budget was read for (vLLM / SGLang only)
+SERVER_BUDGET_SOURCE=""            # effort ([effort-budget] line) | llama (--reasoning-budget boot flag)
 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+
+# One resolved llama.cpp --reasoning-budget value, from `docker inspect`, through the
+# same container-facts reader --thinking-budget uses. stdout, one line:
+#   none               the flag (or its env spelling) is absent
+#   <int>              the resolved value (-1 = unrestricted)
+#   unresolvable <why> present but not a token count
+_llama_server_budget() {
+  local c="$1" facts
+  # shellcheck source=lib/thinking-budget.sh
+  source "${ROOT_DIR}/scripts/lib/thinking-budget.sh"
+  facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts llamacpp)"
+  case "$facts" in
+    "BUDGET none") echo "none" ;;
+    "BUDGET "*)    echo "${facts#BUDGET }" ;;
+    *)             echo "unresolvable ${facts:-no output}" ;;
+  esac
+}
+
+# A positive budget was read — from either the [effort-budget] boot line (vLLM / SGLang,
+# SERVER_BUDGET_SOURCE=effort) or a llama.cpp --reasoning-budget boot flag (llama). Record
+# it, and — unless a choice (a per-request --thinking-budget, an explicit cap, or
+# --pack-budgets) already sets the cap — grow the DEFAULT cap so the answer after the
+# server's forced close has room. The number is kept unless --thinking-budget overrides it:
+# that verified / per-request budget is the one in effect, not the server's default.
+_sb_apply_found() {
+  local budget="$1" what="$2" headroom cap
+  SERVER_THINKING_BUDGET="$budget"
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    if [[ "$SERVER_BUDGET_SOURCE" == "llama" ]]; then
+      echo "[quality-test] ${what} — the --thinking-budget ${THINKING_BUDGET} this run verified; cap from --thinking-budget"
+    else
+      echo "[quality-test] ${what} — --thinking-budget ${THINKING_BUDGET} is sent per request and wins over it; cap from --thinking-budget"
+    fi
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+    return 0
+  fi
+  if [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$budget" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${budget}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+    return 0
+  fi
+  if [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+    return 0
+  fi
+  headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+  if ! [[ "$headroom" =~ ^[1-9][0-9]*$ ]]; then
+    echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${headroom}'" >&2
+    exit 2
+  fi
+  cap=$(( budget + headroom ))
+  if [[ "$cap" -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+    THINKING_MAX_TOKENS="$cap"
+    THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${headroom}"
+    echo "[quality-test] ${what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${budget} + ${headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+  else
+    echo "[quality-test] ${what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${headroom} tokens for the answer"
+  fi
+}
