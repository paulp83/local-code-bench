+def resolve_container_gpus(container):
+    """Host GPU indices pinned behind a container, or ``[]`` when unresolvable.
+
+    ``[]`` means the probe should measure the whole rig and label it as such.
+    Reads the container's env (``NVIDIA_VISIBLE_DEVICES`` /
+    ``CUDA_VISIBLE_DEVICES`` — what the nvidia-container-toolkit sets) first, then
+    docker's ``HostConfig.DeviceRequests`` (the explicit ``device_ids`` form). An
+    env var that IS present but set to ``all``/``void`` is an explicit
+    rig-wide pin, so it short-circuits to ``[]`` rather than falling through."""
+    if not container:
+        return []
+    try:
+        env = subprocess.run(
+            ["docker", "inspect", container, "--format", "{{json .Config.Env}}"],
+            capture_output=True,
+            text=True,
+            timeout=10,
+        ).stdout.strip()
+        env_list = json.loads(env) if env and env != "null" else []
+        idx_map = None
+        for e in env_list:
+            for name in ("NVIDIA_VISIBLE_DEVICES", "CUDA_VISIBLE_DEVICES"):
+                if isinstance(e, str) and e.startswith(name + "="):
+                    if idx_map is None:
