+# The verbatim message `_hf_download` returns when neither `hf` nor
+# `huggingface-cli` is resolvable (rc=127). Matched lowercased so a rig whose
+# shell wraps the CLI differently still reads as "tool unavailable" — and
+_TOOL_UNAVAILABLE_MARKERS = ("is on path",)
+
 # The wall's real trigger, for the honest announcement (NOT a Xet property per
 # se: any file over this size is refused on the classic HTTP path, Xet-backed
 # repo or not). huggingface_hub constants.MAX_HTTP_DOWNLOAD_SIZE.
@@ -144,6 +149,20 @@ def is_xet_refusal(blob: str) -> bool:
     return all(m in low for m in _XET_REFUSAL_MARKERS)
 
 
+def is_tool_unavailable(blob: str = "", rc: int = 0) -> bool:
+    """True iff a rung-1 failure means the `hf` CLI is simply not on PATH
+    (command-not-found, rc=127) — NOT a download error. Such a failure is
+    fallback-eligible: rung 3 (raw resolve + curl) has no dependency on the `hf`
+    binary and would have served the pull fine, so the ladder must not die here
+    the way it dies on an ordinary rung-1 error (a bare exit 1 with no
+    diagnostics). `rc==127` is the shell's canonical command-not-found code;
+    the marker is the belt-and-suspenders for a wrapper that masks it."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return all(m in low for m in _TOOL_UNAVAILABLE_MARKERS)
+
