+def _own_addrs():
+    """This host's own (non-loopback) addresses, from `hostname -I`; a set. A URL naming one of
+    these counts as this machine, so a container published on the wildcard IS reachable by it."""
+    addrs = set()
+    try:
+        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True,
+                             encoding="utf-8", timeout=5)
+        for a in (out.stdout or "").split():
+            a = a.strip()
+            if a:
+                addrs.add(a)
+    except Exception:
+        pass
+    return addrs
+
+
+def _url_host_port(url):
+    """(host, port) from a URL; the port defaults from the scheme (80 / 443). Mirrors
+    listen-scope.sh's url_host_port, incl. bracketed IPv6 and userinfo."""
+    url = url or ""
+    rest = url.split("://", 1)[1] if "://" in url else url
+    hostport = rest.split("/", 1)[0].split("@", 1)[-1]
+    if hostport.startswith("["):
+        close = hostport.find("]")
+        host = hostport[1:close]
+        port = hostport[close + 1:].lstrip(":")
+    elif ":" in hostport:
+        host, port = hostport.rsplit(":", 1)
+    else:
+        host, port = hostport, ""
+    if not port:
+        port = "443" if url.startswith("https://") else "80"
+    return host, port
+
+
+def _url_host_addrs(host):
+    """The addresses a URL host names, mirroring listen-scope.sh's _host_addrs: a list (empty
+    when a hostname resolves nowhere). A literal is itself; a name is what it resolves to;
+    localhost/0.0.0.0 count as loopback."""
+    h = (host or "").strip()
+    if h in ("", "localhost", "0.0.0.0"):
+        return ["127.0.0.1", "::1"]
+    if h.startswith("["):
+        h = h[1:h.find("]") if h.find("]") >= 0 else len(h)]
+    if ":" in h:
+        return [h]                      # an IPv6 literal
+    if any(c not in "0123456789." for c in h):
+        try:                            # a hostname: what it resolves to (or nothing)
+            seen, out = set(), []
+            for info in socket.getaddrinfo(h, None):
+                a = info[4][0].split("%")[0]
+                if a not in seen:
+                    seen.add(a)
+                    out.append(a)
+            return out
+        except Exception:
+            return []
+    return [h]                          # an IPv4 literal
+
+
+def _port_range(s):
+    """(lo, hi) from a docker host port or a range ("8020" / "6333-6334"); None if non-numeric."""
+    s = (s or "").strip()
+    if "-" in s:
+        lo_s, _, hi_s = s.partition("-")
+    else:
+        lo_s, hi_s = s, s
+    if not (lo_s.isdigit() and hi_s.isdigit()):
+        return None
+    return int(lo_s), int(hi_s)
+
+
+def _mapping_serves(bind, hostport, port, addrs, own):
+    """Does one published mapping (bind address + host port/range) serve the URL's host on a
+    port the host reaches? Mirrors listen-scope.sh's ports_serve_url bind rules: a wildcard /
+    this-host publish is reachable by loopback and the host's own addresses, a loopback-only
+    publish only by loopback, and a single-address publish only by that exact address."""
+    rng = _port_range(hostport)
+    if rng is None:
+        return False
+    lo, hi = rng
+    if not (lo <= int(port) <= hi):
+        return False
+    for a in addrs:
+        if bind in ("0.0.0.0", "::", ""):
+            if a.startswith("127.") or a == "::1" or a in own:
+                return True
+        elif bind.startswith("127.") or bind == "::1":
+            if a.startswith("127.") or a == "::1":
+                return True
+        elif a == bind:
+            return True
+    return False
+
