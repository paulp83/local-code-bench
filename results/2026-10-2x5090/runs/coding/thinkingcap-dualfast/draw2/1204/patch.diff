--- a/scripts/lib/profiles/compose_registry.py
+++ b/scripts/lib/profiles/compose_registry.py
@@ -190,13 +190,24 @@ def _entry(
     spec_method=None,
     category=None,
     weights_companions=None,
+    # Catalog PROVENANCE — a first-class field, not encoded in the slug
+    # (#1202 P2). "core" = a curated-catalog row (registry.yaml); "local" =
+    # the gitignored local layer. The local loader FORCES "local" on its rows;
+    # a core row defaults to "core". Publishing flips THIS value and leaves
+    # the slug alone (see export_pr.py).
+    origin="core",
 ):
     if status not in STATUS_VALUES:
         raise ValueError(
             f"{compose_path}: status={status!r} not in {STATUS_VALUES}"
         )
+    if origin not in ("core", "local"):
+        raise ValueError(
+            f"{compose_path}: origin={origin!r} must be 'core' or 'local'"
+        )
     entry = {
         "model": model,
+        "origin": origin,
         "weights_variant": weights_variant,
         "workload": workload,
         "engine": engine,
@@ -814,9 +825,11 @@ def load_local_registry(root=None):
     Plain-dict entries (the JSON form of _entry kwargs) are wrapped through
     _entry(**kwargs) so a local row carries EXACTLY the same shape + defaults
     as a core row. ANY problem — unreadable JSON, a non-object, an unknown
-    kwarg, a bad status, a slug outside the `local/` namespace, or a slug /
-    model-id colliding with a core row (or another local row) — raises
-    LocalRegistryError. Loud, never a silent partial catalog."""
+    kwarg, a bad status, a slug outside the `local/` namespace, a model-id
+    colliding with a core row, or a duplicate local slug — raises
+    LocalRegistryError. A local row that shadows a CORE slug is NOT an error:
+    provenance is a field now (#1202 P2) and get_registry() resolves the
+    shadow with the core entry winning. Loud, never a silent partial catalog."""
     root = Path(root) if root is not None else local_layer_root()
     path = root / LOCAL_REGISTRY_REL
     if not path.exists():
@@ -831,7 +844,6 @@ def load_local_registry(root=None):
         raise LocalRegistryError(
             f"{path}: expected a JSON object of {{slug: {{_entry kwargs}}}}"
         )
-    core_slugs = set(COMPOSE_REGISTRY)
     core_models = {e.get("model") for e in COMPOSE_REGISTRY.values()}
     local: dict = {}
     local_models: set = set()
@@ -841,8 +853,11 @@ def load_local_registry(root=None):
                 f"{path}: local slug {slug!r} must live under the "
                 f"{LOCAL_SLUG_PREFIX!r} namespace"
             )
-        if slug in core_slugs or slug in local:
-            raise LocalRegistryError(f"{path}: local slug collides: {slug!r}")
+        if slug in local:
+            # A shadow of a CORE slug is NOT an error now that provenance is a
+            # field (#1202 P2): get_registry() resolves the collision with the
+            # CORE entry winning. Only a duplicate among LOCAL rows is fatal.
+            raise LocalRegistryError(f"{path}: duplicate local slug: {slug!r}")
         model = kwargs.get("model")
         if model in core_models:
             raise LocalRegistryError(
@@ -850,8 +865,14 @@ def load_local_registry(root=None):
             )
         if model in local_models:
             raise LocalRegistryError(f"{path}: duplicate local model id {model!r}")
+        # Provenance is AUTHORITATIVE by layer, not by user input (#1202 P2):
+        # a local row is "local" regardless of what its JSON claims, so a
+        # spoofed "origin: core" in the gitignored layer can never masquerade
+        # as a curated entry.
+        local_kwargs = dict(kwargs)
+        local_kwargs["origin"] = "local"
         try:
-            entry = _entry(**kwargs)
+            entry = _entry(**local_kwargs)
         except TypeError as exc:
             raise LocalRegistryError(
                 f"{path}: local entry {slug!r} has bad _entry kwargs: {exc}"
@@ -874,8 +895,11 @@ def get_registry(root=None):
     local = load_local_registry(root)
     if not local:
         return COMPOSE_REGISTRY
-    merged = dict(COMPOSE_REGISTRY)
-    merged.update(local)
+    # CORE WINS on a slug shadow (#1202 P2): provenance is a field now, so a
+    # local row that collides with a curated slug never shadows the curated
+    # one — every runtime consumer sees the core entry's data.
+    merged = dict(local)
+    merged.update(COMPOSE_REGISTRY)
     return merged
 
 
diff --git a/scripts/lib/profiles/export_pr.py b/scripts/lib/profiles/export_pr.py
index 4369d89..0f8d763 100755
--- a/scripts/lib/profiles/export_pr.py
+++ b/scripts/lib/profiles/export_pr.py
@@ -280,6 +280,11 @@ def translated_entry(state: dict, entry: dict) -> dict:
     if not kw.get("kvcalc_key"):
         kw["kvcalc_key"] = "SKIP"  # llama.cpp family default; vLLM was gated above
     core_slug = f"{ns}/{str(entry['slug'])[len(_LOCAL_SLUG_PREFIX):]}"
+    # Provenance is a first-class field now (#1202 P2): publishing flips the
+    # entry's `origin` from the local layer to "core". It does NOT re-encode
+    # provenance into the slug — after the P3 hard-cut the rename above
+    # collapses to the identity and THIS line is the whole of publishing.
+    kw["origin"] = "core"
     return {"slug": core_slug, "kwargs": kw}
 
 
