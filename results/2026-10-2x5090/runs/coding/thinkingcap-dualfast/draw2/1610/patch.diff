+# --------------------------------------------------------------------------
+# install-script source matching - the mount's SOURCE, not just its target.
+# --------------------------------------------------------------------------
+# The legacy ``entrypoint_invoke`` fallback identified a patch by a directory
+# entry's PARENT (always ``patches``) or a file entry's bare name (e.g.
+# ``install.sh``) - both of which match *any* compose that mounts *any* patch
+# dir or runs *any* install script, so it answered True for a patch whose
+# mount + invoke had been removed (the #359 false-positive class). The sound
+# check matches the mount's SOURCE against the patch's own on-disk directory
+# name, so (a) a compose that no longer mounts/invokes the patch is not
+# reached, and (b) a DIFFERENT patch mounted at the same in-container target
+# does not count.
+_VOL_MOUNT_RE = re.compile(r"(:)(/[^:\s]+)(?::(ro|rw))?\s*$")
+
+
+def _source_names(patch: dict, root: Path | None = None) -> set[str]:
+    """The patch's identifying on-disk directory name(s).
+
+    A directory entry contributes its own name; a file or ``script`` entry
+    contributes its containing directory's name. The shared ``patches``
+    parent and a bare generic filename (``install.sh`` ...) never identify a
+    specific patch, so they are excluded (a vendored file sitting directly
+    under ``patches/`` falls back to its own, non-generic name).
+    """
+    names: set[str] = set()
+
+    def consider(rel: str) -> None:
+        p = Path(rel)
+        t = (root / rel) if root is not None else None
+        is_dir = t.is_dir() if t is not None else (p.suffix not in _FILE_SUFFIXES)
+        if is_dir:
+            if p.name != "patches":
+                names.add(p.name)
+        else:
+            parent = p.parent.name
+            if parent != "patches":
+                names.add(parent)
+            elif p.name not in _GENERIC_FILENAMES:
+                names.add(p.name)
+
+    for rel in patch.get("files") or []:
+        consider(rel)
+    script = (patch.get("delivery_spec") or {}).get("script")
+    if script:
+        consider(script)
+    return names
+
+
+def _mounts_source(body: str, source_names: set[str]) -> bool:
+    """True iff the service body volume-mounts a source naming one of
+    ``source_names``.
+
+    Only real volume-mount lines (``- <source>:<target>[:ro|rw]``) are
+    considered, and the SOURCE side of the mount is matched - not the
+    in-container target - so a different patch mounted at the same target
+    does not register as this patch.
+    """
+    for line in body.splitlines():
+        s = line.strip().strip('"').strip("'")
+        if not s.startswith("- "):
+            continue
+        m = _VOL_MOUNT_RE.search(s)
+        if not m:
+            continue
+        src = s[: m.start(1)]
+        if any(name in src for name in source_names):
+            return True
+    return False
+
+
+def _install_script_wired(patch: dict, root: Path, body: str) -> bool:
+    """Sound reachability for an install-script patch (a ``delivery_spec``
+    with a ``script``).
+
+    The compose must mount THIS patch's on-disk directory (matched on the
+    mount's source, not just the shared in-container target) and, per the
+    patch's declared ``wired_at``, run its entrypoint invoke. A compose that
+    stops mounting or invoking the patch - or that mounts a *different* patch
+    at the same target - is not reached.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    source_names = _source_names(patch, root)
+
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = set(wired_at or [])
+
+    # Volume: the patch's own source dir is mounted (source-matched). When
+    # the source cannot be resolved, fall back to the declared target.
+    if source_names:
+        vol_ok = _mounts_source(body, source_names)
+    else:
+        vol_ok = bool(mounted_at) and mounted_at in body
+
+    _vol_markers, inv_markers = _spec_wiring_markers(patch)
+    inv_ok = (not inv_markers) or any(m in body for m in inv_markers)
+
+    if wired_at == {"volumes"}:
+        return vol_ok
+    if wired_at == {"entrypoint"}:
+        return inv_ok
+    if "volumes" in wired_at and "entrypoint" in wired_at:
+        return vol_ok and inv_ok
+    # Unknown / empty wired_at: any declared artifact present.
+    return vol_ok or inv_ok
+
