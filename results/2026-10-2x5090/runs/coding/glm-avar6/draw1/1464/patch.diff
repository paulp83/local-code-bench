diff --git a/scripts/tests/test-switch-gate-before-teardown.sh b/scripts/tests/test-switch-gate-before-teardown.sh
new file mode 100644
index 0000000..5c7aeb8
--- /dev/null
+++ b/scripts/tests/test-switch-gate-before-teardown.sh
@@ -0,0 +1,114 @@
+#!/usr/bin/env bash
+# Ordering contract: switch.sh must REFUSE a launch BEFORE tearing down the
+# running slug. A refused launch used to leave the rig serving nothing because
+# down_running() ran first and the refusing checks (status_gate's (NA) gate,
+# preflight_compose_deps' missing-model-dir check, an unknown slug) ran after it.
+#
+# Validates:
+#   1. An unknown slug is refused with NO docker call (no teardown).
+#   2. An (NA) slug without --force is refused with NO docker call.
+#   3. A compose whose model dir is missing on the host is refused with NO docker call.
+#   4. A launchable slug still tears down BEFORE it brings up (down < up order).
+#
+# Harness: mock `docker` on PATH records every invocation; switch.sh's
+# repo-drift / compose-deps / GPU checks are neutralised for the happy path
+# (no nvidia-smi on the test host anyway).
+#
+# UTF-8 mode, like every script that runs python3 against repo sources (#779).
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+set -uo pipefail
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0
+FAIL=0
+note() { echo "  $1" >&2; }
+ok()   { PASS=$((PASS + 1)); }
+bad()  { FAIL=$((FAIL + 1)); echo "FAIL: $1" >&2; }
+
+MOCKBIN="$(mktemp -d)"
+export DOCKER_LOG="$MOCKBIN/docker.log"
+cleanup() { rm -rf "$MOCKBIN"; }
+trap cleanup EXIT
+
+cat > "$MOCKBIN/docker" <<'MOCKEOF'
+#!/usr/bin/env bash
+printf 'docker %s\n' "$*" >> "${DOCKER_LOG:?}"
+for a in "$@"; do [[ "$a" == *"{{.Names}}"* ]] && { printf '%s\n' "$DOCKER_MOCK_RUNNING"; exit 0; }; done
+exit 0
+MOCKEOF
+chmod +x "$MOCKBIN/docker"
+
+# Managed container the mock `docker ps` reports, so the happy-path case
+# exercises a real teardown (down_running() only acts on names it manages).
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b-minimal"
+
+run_switch() {
+  : > "$DOCKER_LOG"
+  PATH="$MOCKBIN:$PATH" PREFLIGHT_NO_FETCH=1 bash scripts/switch.sh --no-wait "$@" 2>&1
+}
+
+assert_no_docker() {
+  local label="$1"
+  if [[ -s "$DOCKER_LOG" ]]; then
+    bad "$label: docker was invoked -- the running slug was torn down before the refusal"
+    sed 's/^/    /' "$DOCKER_LOG" >&2
+  else
+    note "ok   refused before any docker call ($label)"
+    ok
+  fi
+}
+
+# 1. mistyped slug
+out="$(run_switch totally-bogus-slug)"
+if [[ "$out" == *"unknown variant 'totally-bogus-slug'"* ]]; then
+  note "ok   unknown slug refused"; ok
+else bad "unknown slug not refused as expected: $out"; fi
+assert_no_docker "unknown slug"
+
+# 2. (NA) slug without --force
+na_slug="$(python3 -c "
+import sys; sys.path.insert(0, '$ROOT_DIR')
+from scripts.lib.profiles.compose_registry import get_registry
+for s, e in get_registry().items():
+    if (e.get('status') or 'production') not in ('production', 'caveats'):
+        print(s); break
+")"
+[[ -n "$na_slug" ]] || { echo "SKIP: no (NA) slug in registry"; exit 0; }
+out="$(run_switch "$na_slug")"
+if [[ "$out" == *"not a reliable config"* && "$out" == *"--force"* ]]; then
+  note "ok   (NA) slug '$na_slug' refused without --force"; ok
+else bad "(NA) slug not refused as expected: $out"; fi
+assert_no_docker "(NA) slug"
+
+# 3. missing model dir on host (preflight_compose_deps)
+slug="vllm/minimal"
+MODEL_DIR="$ROOT_DIR/.nonexistent-model-dir" out="$(run_switch "$slug")"
+if [[ "$out" == *"aren't on host"* || "$out" == *"expects model files"* ]]; then
+  note "ok   missing MODEL_DIR refused"; ok
+else bad "missing model dir not refused as expected: $out"; fi
+assert_no_docker "missing model dir"
+
+# 4. launchable slug: down comes before up
+: > "$DOCKER_LOG"
+PATH="$MOCKBIN:$PATH" PREFLIGHT_NO_FETCH=1 PREFLIGHT_NO_COMPOSE_DEPS=1 FORCE=1 \
+  bash scripts/switch.sh --no-wait "$slug" >/dev/null 2>&1
+if grep -q -- 'up -d --remove-orphans' "$DOCKER_LOG" 2>/dev/null; then
+  first_down="$(grep -nE -- '(down --remove-orphans|stop )' "$DOCKER_LOG" | head -1 | cut -d: -f1)"
+  first_up="$(grep -n -- 'up -d --remove-orphans' "$DOCKER_LOG" | head -1 | cut -d: -f1)"
+  if [[ -n "$first_down" && -n "$first_up" && "$first_down" -lt "$first_up" ]]; then
+    note "ok   teardown (line $first_down) precedes bring-up (line $first_up)"; ok
+  else
+    bad "expected a teardown line before the bring-up line in: $(cat "$DOCKER_LOG")"
+  fi
+else
+  bad "happy path never issued compose up -- got: $(cat "$DOCKER_LOG")"
+fi
+
+echo "----------------------------------------"
+echo "PASS: $PASS   FAIL: $FAIL"
+[[ $FAIL -eq 0 ]] && echo "OK: switch.sh refuses before tearing down the running slug" \
+                  || echo "test-switch-gate-before-teardown: FAIL"
+exit $FAIL
