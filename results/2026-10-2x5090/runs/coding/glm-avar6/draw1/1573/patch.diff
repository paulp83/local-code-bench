+# vLLM's boot-log readback. An image that starts vLLM through its own launcher
+# (e.g. a `qwen38-serve` wrapper script) adds --reasoning-parser inside that
+# script, so the container argv shows no flag and
+# _thinking_budget_container_facts reports PARSER none. The boot log is the
+# next-best evidence: vLLM logs its resolved engine args at boot —
+# `non-default args: ... 'reasoning_parser': 'qwen3'` — which is exactly what
+# the launcher's flag resolved to. Only the boot portion is read (byte-capped:
+# a long-lived server logs a lot) and the FIRST non-None value wins; a bare
+# `reasoning_parser: None` is NOT evidence of absence, the launcher may have
+# logged the resolved parser elsewhere. stdout: `PARSER <value>`, or nothing
+# when the log says nothing usable.
+_THINKING_BUDGET_VLLM_LOG_FACTS_PY="$(cat <<'PY'
+import re, sys
+
+CAP = 4 * 1024 * 1024  # the boot args line is near the start; cap the read
+text, seen = "", 0
+while seen < CAP:
+    chunk = sys.stdin.read(65536)
+    if not chunk:
+        break
+    text += chunk
+    seen += len(chunk)
+
+val = None
+# `reasoning_parser': 'qwen3'` / reasoning_parser=qwen3 / "reasoning_parser": "qwen3"
+pat = re.compile(r"reasoning_parser['\"]{0,2}\s*[:=]\s*['\"]?([\w.-]+)")
+for m in pat.finditer(text):
+    v = m.group(1).strip("' \"")
+    if v and v.lower() != "none":
+        val = v
+        break
+# a launcher's own flag line, should the args dump be absent
+if val is None:
+    m = re.search(r"--reasoning-parser(?:=|\s+)([\w.-]+)", text)
+    if m:
+        val = m.group(1)
+if val:
+    print("PARSER %s" % val)
+PY
+)"
+_thinking_budget_vllm_log_facts() {
+  local c="$1"
+  docker logs "$c" 2>&1 | python3 -c "${_THINKING_BUDGET_VLLM_LOG_FACTS_PY}"
+}
+
 # SGLang ships model-specific ThinkingBudgetLogitProcessor subclasses
 # (python/sglang/srt/sampling/custom_logit_processor.py, v0.5.20). Only the
 # parsers whose think-token ids are known to match are mapped; anything else
@@ -329,12 +382,25 @@ thinking_budget_verify() {
         return 2
       fi
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
+      if [[ "$facts" == "PARSER none" ]]; then
+        # The argv is not the whole story: an image that starts vLLM through its
+        # own launcher (bucko's `qwen38-serve`, official images generally) adds
+        # --reasoning-parser INSIDE that script, so the container argv shows
+        # none. The boot log carries what the launcher's flag resolved to.
+        local log_facts
+        log_facts="$(_thinking_budget_vllm_log_facts "$c")"
+        if [[ -n "$log_facts" ]]; then
+          facts="$log_facts"
+          THINKING_BUDGET_EVIDENCE="container ${c}'s boot log reports reasoning_parser=${log_facts#PARSER } (the launcher sets --reasoning-parser; it is not in the container argv)"
+          return 0
+        fi
+      fi
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser (no flag in the container argv and no reasoning_parser in its boot log) — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
           return 1 ;;
         "PARSER "*)
-          THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
+          [[ -n "${THINKING_BUDGET_EVIDENCE:-}" ]] || THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
         *)
           THINKING_BUDGET_EVIDENCE="could not read container ${c}: ${facts:-no output}"
@@ -390,6 +456,9 @@ EOF
