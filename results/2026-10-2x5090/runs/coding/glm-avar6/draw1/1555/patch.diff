+def container_for_url(url):
+    """Name of the RUNNING container that publishes $URL's port, '' when none does.
+
+    Reads `docker ps` (any engine), not a name heuristic: an SGLang container is
+    `sgl-…`, so grepping for `vllm-` found nothing and the probe labelled the card
+    with every GPU on the host (#1537).
+    """
+    port = url_port(url)
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=15,
+        ).stdout
+    except Exception:
+        return ""
+    for line in out.splitlines():
+        parts = line.split("\t", 1)
+        if len(parts) != 2:
+            continue
+        name, ports = parts[0].strip(), parts[1]
+        for m in re.finditer(r"(-?\d+(?:\.\d+){0,3}):([\d,>-]+)(?:/(?:tcp|udp))?", ports):
+            for piece in m.group(2).split(","):
+                lo, _, hi = piece.partition(">")
+                lo = lo.strip("-")
+                if not lo.isdigit():
+                    continue
+                hi = hi.lstrip("-").strip()
+                lo_n, hi_n = int(lo), int(hi) if hi.isdigit() else int(lo)
+                if lo_n <= port <= hi_n:
+                    return name
+    return ""
+
