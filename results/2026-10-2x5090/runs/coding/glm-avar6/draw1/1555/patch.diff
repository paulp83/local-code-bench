+def url_port(url):
+    """'http://localhost:8020/v1' -> 8020; 80 for no port, None when unparseable."""
+    try:
+        from urllib.parse import urlsplit
+    except Exception:  # pragma: no cover
+        return None
+    netloc = urlsplit(str(url or "")).netloc
+    if not netloc:
+        return None
+    m = re.match(r"^(?:\[([^\]]+)\]|[^:@]*)(?::(\d+))?(?::[^/]*)?$", netloc)
+    if not m:
+        return None
+    return int(m.group(2)) if m.group(2) else 80
+
