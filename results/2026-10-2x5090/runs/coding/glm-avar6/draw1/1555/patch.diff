+_SPEC_INIT_RE = re.compile(r"Initializing a [Vv]1 LLM engine.*?with config:")
+
+
+def _docker_logs_head(container, nbytes=20000, timeout=20):
+    """First `nbytes` of `docker logs <c>` (stdout+stderr), or None.
+
+    `docker logs` streams the WHOLE history and there is no --head flag, so the
+    reader must stop on its own: a long-serving container never EOFs, and
+    `capture_output` would block until the timeout while buffering gigabytes.
+    """
+    if not container:
+        return None
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+            start_new_session=True,
+        )
+    except Exception:
+        return None
+    buf = b""
+    deadline = time.time() + timeout
+    fd = proc.stdout.fileno()
+    try:
+        while len(buf) < nbytes:
+            left = deadline - time.time()
+            if left <= 0:
+                break
+            ready, _, _ = select.select([fd], [], [], left)
+            if not ready:
+                break
+            chunk = os.read(fd, 4096)
+            if not chunk:
+                break
+            buf += chunk
+    except Exception:
+        pass
+    finally:
+        try:
+            proc.stdout.close()
+        except Exception:
+            pass
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except Exception:
+            try:
+                proc.kill()
+            except Exception:
+                pass
+        try:
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+    return buf.decode("utf-8", errors="replace")
+
+
+def _spec_from_vllm_logs(container):
+    """Spec label from the HEAD of `docker logs` (the boot-time engine config line).
+
+    The tail is full of later, config-free lines, and a vLLM compose that builds
+    --speculative-config inside its entrypoint never shows the flag in Cmd, so the
+    only readable source is that `Initializing a V1 LLM engine … speculative_config=…`
+    line (#1537). None when the container or that line is missing.
+    """
+    head = _docker_logs_head(container)
+    if head is None:
+        return None
+    saw_init = False
+    for line in head.splitlines():
+        m = _SPEC_INIT_RE.search(line)
+        if not m:
+            continue
+        saw_init = True
+        spec = re.search(r"speculative_config=([A-Za-z_][A-Za-z_0-9]*(?:\([^)]*\))?)", line)
+        if not spec:
+            continue
+        raw = spec.group(1)
+        if raw in ("None", "none", ""):
+            return "spec off"
+        method = re.search(r"method=['\"]?([A-Za-z0-9_-]+)", raw)
+        name = method.group(1) if method else ""
+        n = re.search(r"num_spec_tokens=['\"]?([0-9]+)", raw)
+        if not n:
+            n = re.search(r"num_speculative_tokens=['\"]?([0-9]+)", raw)
+        label = _spec_algo_name(name) or "spec"
+        return f"{label} n={n.group(1)}" if n else label
+    # The boot line was found but names no speculative_config: that IS spec off
+    # (vLLM prints every engine field on that line, including speculative_config).
+    if saw_init:
+        return "spec off"
+    return None
+
+
+def _spec_algo_name(algo):
+    """Engine-reported spec algorithm -> card label ('mtp'/'eagle'/'nextn' -> MTP)."""
+    a = str(algo or "").strip().lower().replace("-", "_")
+    if not a:
+        return ""
+    if "ngram" in a:
+        return "ngram"
+    if "dflash" in a:
+        return "DFlash"
+    if "eagle" in a or "mtp" in a or "nextn" in a:
+        return "MTP"
+    return a.upper()
+
+
+def _spec_from_sglang(url):
+    """Spec label from SGLang's GET /get_server_info. None when unreadable."""
+    if not url:
+        return None
+    try:
+        req = urllib.request.Request(
+            str(url).rstrip("/") + "/get_server_info", method="GET",
+            headers={"Accept": "application/json"},
+        )
+        with urllib.request.urlopen(req, timeout=5) as resp:
+            info = json.loads(resp.read().decode("utf-8", errors="replace"))
+    except Exception:
+        return None
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    if algo in (None, "", "NONE"):
+        return "spec off"
+    label = _spec_algo_name(algo)
+    n = info.get("speculative_num_steps")
+    if not isinstance(n, int):
+        n = info.get("speculative_num_draft_tokens")
+    return f"{label} n={n}" if isinstance(n, int) else label
+
+
+def spec_label(container=None, url=None):
+    """'MTP n=4' / 'ngram' / 'spec off' from the engine, or None when neither source reads.
+
+    vLLM is read from the boot-time logs of $CONTAINER, SGLang from its
+    /get_server_info — the two places each engine actually reports spec decoding
+    (a vLLM entrypoint-composed flag never reaches Cmd, so the old Cmd grep said
+    "spec off" while MTP n=4 ran, and a vllm- name heuristic meant an SGLang
+    container was never even found to read logs from, #1537).
+    """
+    from_vllm = _spec_from_vllm_logs(container if container is not None else _env("CONTAINER"))
+    if from_vllm:
+        return from_vllm
+    return _spec_from_sglang(url if url is not None else _env("URL"))
+
