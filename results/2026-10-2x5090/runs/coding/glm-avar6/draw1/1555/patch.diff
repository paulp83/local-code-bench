+# #1537: the card must name the right container, the right GPUs and the right
+# drafter. (1) Compose turns `device_ids: ["${ESTATE_GPUS}"]` into ONE DeviceIDs
+# entry ("2,3"), which used to read as rig-wide. (2) An SGLang container is
+# `sgl-...`, so the old `grep vllm-(qwen|gemma)` name heuristic never found it -
+# CONTAINER is now resolved from which container publishes $URL's port. (3) A
+# vLLM compose that builds --speculative-config inside its entrypoint never shows
+# the flag in Cmd, so spec is read from the engine (boot-time logs / get_server_info).
+G1537="$(mktemp -d)"
+trap 'rm -rf "$G1537"' EXIT
+cat > "$G1537/nvidia-smi" <<'SMI'
+#!/usr/bin/env bash
+cat <<'ROWS'
+0, GPU-aaaa0000-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 15000
+1, GPU-aaaa1111-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 14938
+2, GPU-aaaa2222-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 15000
+3, GPU-bbbb3333-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3060, 10381
+ROWS
+SMI
+cat > "$G1537/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = inspect ] || exit 0
+case "$2" in
+  compose-joined) echo '[{"HostConfig":{"DeviceRequests":[{"Count":0,"DeviceIDs":["2,3"]}]},"Config":{"Env":[]}}]' ;;
+esac
+DOCK
+chmod +x "$G1537/nvidia-smi" "$G1537/docker"
+got="$(PATH="$G1537:$PATH" python3 - "$ROOT_DIR/scripts/lib" <<'PYP'
+import sys
+sys.path.insert(0, sys.argv[1])
+import concurrency_probe as c
+sel, scope = c.container_gpus("compose-joined")
+print(f"{c.gpu_label(sel)}|{sel}|{scope}")
+PYP
+)"
+[[ "$got" == "1× GeForce RTX 3090 + 1× GeForce RTX 3060|['2', '3']|GPU 2, 3 (container compose-joined)" ]] \
+  || fail "a Compose-style joined DeviceIDs entry (\"2,3\") must scope to GPUs 2 and 3: got '$got'"
+echo "  ✓ a Compose-style joined DeviceIDs entry (\"2,3\") scopes like [\"2\",\"3\"]"
+
+cat > "$G1537/docker" <<'DOCK2'
+#!/usr/bin/env bash
+if [ "$1" = ps ]; then
+  printf 'sgl-qwen3.8\t0.0.0.0:8020->8020/tcp\tunrelated\t0.0.0.0:9000->9000/tcp\n'
+  exit 0
+fi
+if [ "$1" = logs ]; then
+  printf 'Initializing a V1 LLM engine (v0.11.0) with config: model="q", speculative_config=SpeculativeConfig(method="mtp", num_spec_tokens=4)\n'
+  exit 0
+fi
+exit 0
+DOCK2
+chmod +x "$G1537/docker"
+got="$(PATH="$G1537:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+[[ "$got" == "sgl-qwen3.8" ]] || fail "--container-for-url must find the container that publishes the URL port (not a vllm- name): got '$got'"
+got="$(PATH="$G1537:$PATH" URL=http://localhost:9999 python3 "$LIB" --container-for-url)"
+[[ -z "$got" ]] || fail "--container-for-url must print nothing when nothing publishes that port: got '$got'"
+got="$(PATH="$G1537:$PATH" CONTAINER=vllm-qwen3.8 python3 "$LIB" --spec-label)"
+[[ "$got" == "MTP n=4" ]] || fail "--spec-label must read the boot-time vLLM engine config, not Cmd: got '$got'"
+got="$(URL="${URL:-}" CONTAINER="${CONTAINER:-}" python3 "$LIB" --spec-label)"
+[[ -z "$got" ]] || fail "--spec-label must print nothing when neither engine source reads: got '$got'"
