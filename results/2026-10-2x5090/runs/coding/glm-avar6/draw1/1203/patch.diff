+def __getattr__(name: str):
+    """Re-export the shared compose-facts layer (#1202 P1).
+
+    `ComposeFacts`, `_ENGINE_BY_IMAGE` and `derive_compose_facts` live in
+    `scripts/lib/profiles/compose_facts.py` now. Resolved lazily via the module
+    `__getattr__` so this file keeps importing without the repo root on
+    sys.path (and stays stdlib-only on the launcher's no-PyYAML path): only the
+    callers that actually ask for these names pay the import."""
+    shared = ("ComposeFacts", "_ENGINE_BY_IMAGE", "derive_compose_facts")
+    if name in shared:
+        try:
+            from scripts.lib.profiles import compose_facts as _compose_facts
+        except Exception:  # pragma: no cover - unresolvable scripts tree
+            raise AttributeError(
+                f"module {__name__!r} has no attribute {name!r}"
+            ) from None
+        return getattr(_compose_facts, name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
