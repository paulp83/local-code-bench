+for n in vllm-qwen36-27b vllm-qwen36-27b-dual ik-llama-qwen36-27b beellama-qwen36-27b llama-cpp-qwen36-27b; do
+  : > "${tmp_dir}/compose-${n}.yml"
+done
+
 export DOCKER_MOCK_LOG="${tmp_dir}/calls.log"
 export DOCKER_MOCK_WORKDIR="${tmp_dir}"   # real dir so (cd "$lbl_dir") succeeds
 export PATH="${tmp_dir}:$PATH"
@@ -135,6 +145,30 @@ assert_not_contains "$log" "COMPOSE"                          "nothing torn down
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
 
+# --- Scenario 3: comma-joined config_files label (#1498) -----------------------
+# Docker Compose records every -f in com.docker.compose.project.config_files as
+# a comma-joined string. down_running() must pass each path as its own -f, drop
+# files that no longer exist, and still run `down --remove-orphans` with what
+# remains. The mock's label already yields <dir>/compose-<name>.yml (exists) +
+# compose-labels/<name>.yml (missing) — so a managed container must come down
+# with BOTH -f entries, not fall back to `docker stop`.
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_contains "$log" "-f ${DOCKER_MOCK_WORKDIR}/compose-vllm-qwen36-27b.yml" "multi-file label: existing compose file passed as -f"
+assert_not_contains "$log" "compose-labels/vllm-qwen36-27b.yml"                "multi-file label: missing override file dropped"
+assert_not_contains "$log" "STOP vllm-qwen36-27b"                              "multi-file label: no stop fallback when one file remains"
+
+# --- Scenario 4: every listed file gone -> docker stop, no compose call -------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="ik-llama-qwen36-27b"
+export DOCKER_MOCK_MISSING_ONLY=1
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_not_contains "$log" "COMPOSE"              "all files gone: compose not called"
+assert_contains     "$log" "STOP ik-llama-qwen36-27b" "all files gone: falls back to docker stop"
+
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
 echo "PASS: $PASS   FAIL: $FAIL"
