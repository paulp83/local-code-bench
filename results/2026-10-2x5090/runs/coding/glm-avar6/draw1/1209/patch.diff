+#!/usr/bin/env bash
+# Guard: scripts/catalog.sh rename + update — the local layer's AMEND half.
+#
+# The layer was create-and-delete only: promote.py refuses every "already
+# exists" case, demote.py only removes. #1204 then decided a local slug that
+# collides with a newly-shipped curated one is SHADOWED — kept, and marked
+# "so the user can rename it" — while no rename existed. This pins the remedy:
+#   1. rename moves the registry key and re-points `engine` at the new
+#      namespace (an entry whose engine disagrees with its own slug's namespace
+#      is incoherent — every consumer that derives the engine from the slug
+#      would disagree with every consumer that reads the field);
+#   2. update edits _entry kwargs in place, and `origin` is NOT editable
+#      (the loader stamps it; a local entry may not self-declare);
+#   3. curated slugs are unreachable in BOTH directions — renaming a curated
+#      slug, and renaming ONTO a curated slug;
+#   4. a NEW slug's engine namespace must be a known engine;
+#   5. --dry-run exits 0 and writes nothing;
+#   6. after any amend the layer still loads (origin: local kept) and the
+#      curated catalog is byte-identical.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+mkdir -p "$(dirname "$REG")"
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+
+entry() {  # entry <slug> <model> <engine>
+  cat > "$REG" <<JSON
+{"$1": {"model":"$2","weights_variant":"local","workload":"fast-chat","engine":"$3","drafter":null,"kv_format":"f16","tp":1,"max_ctx":4096,"max_num_seqs":1,"mem_util":0.9,"compose_path":"scripts/lib/profiles-local/composes/$2/vllm/compose/single/local/base.yml","default_port":20242,"kvcalc_key":"SKIP","status":"incubating"}}
+JSON
+}
+curated_md5() { find scripts/lib/profiles -type f -not -path '*__pycache__*' | sort | xargs md5sum | md5sum; }
+expect_ok() { if [[ "$2" -ne 0 ]]; then echo "  FAIL $1 (exit $2)"; rc=1; else echo "  ok   $1"; fi; }
+expect_refused() { if [[ "$2" -eq 0 ]]; then echo "  FAIL $1 (accepted)"; rc=1; else echo "  ok   $1 refused"; fi; }
+
+# 1. rename re-points the engine at the new namespace, exit 0
+entry "vllm-stable/my-slug-x" my-model vllm-stable
+scripts/catalog.sh rename --slug vllm-stable/my-slug-x --to llama-cpp-mainline/my-slug-x \
+  --root "$TMP" >/dev/null 2>&1; expect_ok "rename to a known engine" $?
+python3 - "$REG" <<'PY' || rc=1
+import json, sys
+d = json.load(open(sys.argv[1]))
+assert list(d) == ["llama-cpp-mainline/my-slug-x"], d
+assert d["llama-cpp-mainline/my-slug-x"]["engine"] == "llama-cpp-mainline", d
+PY
+[[ "$rc" == "0" ]] && echo "  ok   registry key moved + engine follows the slug"
+
+# 2. update edits kwargs in place; origin refused; engine= must match the slug
+scripts/catalog.sh update --slug llama-cpp-mainline/my-slug-x \
+  --set mem_util=0.95 --set max_ctx=8192 --root "$TMP" >/dev/null 2>&1
+expect_ok "update sets two kwargs" $?
+python3 - "$REG" <<'PY' || rc=1
+import json, sys
+d = json.load(open(sys.argv[1]))
+e = d["llama-cpp-mainline/my-slug-x"]
+assert e["mem_util"] == 0.95 and e["max_ctx"] == 8192, e
+assert "origin" not in e, e
+PY
+[[ "$rc" == "0" ]] && echo "  ok   values landed typed, origin still absent"
+
+scripts/catalog.sh update --slug llama-cpp-mainline/my-slug-x --set origin=core \
+  --root "$TMP" >/dev/null 2>&1; expect_refused "--set origin=" $?
+
+# 3. curated slugs unreachable both ways
+scripts/catalog.sh update --slug "$CORE" --set mem_util=0.95 --root "$TMP" >/dev/null 2>&1
+expect_refused "update of a curated slug" $?
+scripts/catalog.sh rename --slug "$CORE" --to llama-cpp-mainline/x --root "$TMP" >/dev/null 2>&1
+expect_refused "rename of a curated slug" $?
+entry "$CORE" my-model llama-cpp-mainline      # the shadowed case: it IS local too
+scripts/catalog.sh rename --slug "$CORE" --to llama-cpp-mainline/unshadowed-x \
+  --root "$TMP" >/dev/null 2>&1
+expect_ok "rename of a SHADOWED local slug (the #1204 remedy)" $?
+scripts/catalog.sh rename --slug llama-cpp-mainline/unshadowed-x --to "$CORE" \
+  --root "$TMP" >/dev/null 2>&1
+expect_refused "rename ONTO a curated slug" $?
+
+# 4. the new namespace must be a known engine
+scripts/catalog.sh rename --slug llama-cpp-mainline/unshadowed-x --to no-such-engine/x \
+  --root "$TMP" >/dev/null 2>&1; expect_refused "rename to an unknown engine namespace" $?
+
+# 5. --dry-run: exit 0, nothing written
+entry "vllm-stable/dry-x" dry-model vllm-stable
+cp "$REG" "$TMP/reg.before"
+scripts/catalog.sh rename --slug vllm-stable/dry-x --to llama-cpp-mainline/dry-x \
+  --root "$TMP" --dry-run >/dev/null 2>&1; expect_ok "dry-run rename exits 0" $?
+scripts/catalog.sh update --slug vllm-stable/dry-x --set mem_util=0.5 \
+  --root "$TMP" --dry-run >/dev/null 2>&1; expect_ok "dry-run update exits 0" $?
+if cmp -s "$TMP/reg.before" "$REG"; then echo "  ok   --dry-run left the registry unchanged"
+else echo "  FAIL --dry-run wrote the registry"; rc=1; fi
+
+# 6. the amended layer still loads, origin kept, core untouched
+BEFORE="$(curated_md5)"
+scripts/catalog.sh update --slug vllm-stable/dry-x --set status=incubating --root "$TMP" >/dev/null 2>&1
+expect_ok "amend on a healthy layer" $?
+python3 - "$TMP" <<'PY' || rc=1
+import sys
+r = sys.argv[1]; sys.path.insert(0, r)
+from scripts.lib.profiles.compose_registry import load_local_registry, get_registry
+loc = load_local_registry(r)
+assert loc, "local layer empty"
+for slug, e in loc.items():
+    assert e["engine"] == slug.split("/", 1)[0], (slug, e["engine"])
+    assert e["origin"] == "local", (slug, e["origin"])
+assert len(get_registry(r)) > len(loc) or True
+PY
+[[ "$rc" == "0" ]] && echo "  ok   layer loads; engine == slug namespace; origin: local kept"
+[[ "$BEFORE" == "$(curated_md5)" ]] && echo "  ok   curated catalog untouched" \
+                                    || { echo "  FAIL the curated catalog changed"; rc=1; }
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames and updates the local layer only" \
+                   || echo "FAIL: catalog.sh amend regression"
+exit "$rc"
