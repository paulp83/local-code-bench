+_CLI_MISSING_MARKERS = (
+    "neither `hf` nor `huggingface-cli` is on path",
+    "command not found",
+    "no such file or directory",
+    "is not recognized as",
+    "not installed",
+    "executable file not found",
+    "no such command",
+)
+
+
+def is_cli_missing(blob: str) -> bool:
+    """True iff `blob` (a merged stdout+stderr of a failed rung-1 `hf download`)
+    reports the *tool itself* is unavailable (`hf` missing, rc=127, shell
+    "command not found"), NOT ordinary network flakiness. Such a failure has
+    nothing to do with the transport: rung 3 (raw resolve + curl) has no
+    dependency on the `hf` CLI at all, so it is FALLBACK-ELIGIBLE — it must
+    never kill the ladder (issue: a rig without the CLI exited 1 silently).
+    Deliberately narrow: an unrelated "not found" in a 404 body or a missing
+    *file* must not send a recoverable error down the slow path, so the
+    markers all name the tool/its absence rather than a generic "not found"."""
+    low = (blob or "").strip().lower()
+    if not low:
+        return False
+    return any(m in low for m in _CLI_MISSING_MARKERS)
+
+
+def is_fallback_eligible(blob: str, rc: Optional[int] = None) -> bool:
+    """Should rung-1's failure be escalated instead of ending the ladder?
+
+    True for the hard client-side too-large refusal (`is_xet_refusal`) AND for
+    a missing/unusable `hf` CLI (`is_cli_missing`, which the shell reports as
+    rc=127). A bare rc=127 with no recognisable text is treated the same way —
+    127 is the shell's own "command not found" status, so it cannot be a
+    download failure worth retrying."""
+    if is_xet_refusal(blob):
+        return True
+    if rc is not None and int(rc) == 127:
+        return True
+    return is_cli_missing(blob)
+
+
