+def assigns(lines, i, arr):
+    r"""Does line i assign `arr=(...)`?  Matches the plain form AND a case-arm
+    header form -- `on) NAME=(...) ;;` puts the pattern in front of the
+    assignment on the same line, so a leading `^\s*NAME=` match misses it entirely and
+    the case reads as "never assigned".  The lookbehind is a non-word char so
+    `NAME=` cannot match inside `OTHER_NAME=`."""
+    return re.search(r'(?:^|[^\w])' + re.escape(arr) + r'=\(', lines[i]) is not None
+
+ARM_END = re.compile(r'(;;|;&|;;&)\s*$')
+
+def case_blocks(lines):
+    """Every multi-line `case` -> (open line index, arms, `esac` line index), where
+    each arm is the list of line indices it spans.  A case whose EVERY arm either
+    assigns NAME or exits is equivalent to a straight-line assignment: no path
+    reaches past it without NAME being set (its default arm is the escape hatch).
+    """
+    blocks, stack = {}, []
+    for i, ln in enumerate(lines):
+        if re.match(r'^\s*case\b', ln) and not ONELINE.search(ln):
+            stack.append([i, [], []]); continue
+        if not stack: continue
+        if re.match(r'^\s*esac\b', ln):
+            start, done, cur = stack.pop()
+            if cur: done.append(cur)
+            blocks[start] = (done, i); continue
+        start, done, cur = stack[-1]
+        cur = cur + [i]
+        if ARM_END.search(ln):
+            done, cur = done + [cur], []
+        stack[-1] = [start, done, cur]
+    return blocks
+
+def case_is_exhaustive(lines, arms, arr):
+    """True iff every arm of a `case` either assigns `arr` or exits.  An `exit`
+    found inside a further nested block still counts, matching the gate's overall
+    line-level coarseness: the arms under review here are flat `pattern) ...;;`."""
+    return all(
+        any(assigns(lines, j, arr) for j in arm)
+        or any(re.search(r'\bexit\b', lines[j]) for j in arm)
+        for arm in arms
+    )
+
