+# 11. skip-path emit_row regression (#bug: --sweep died at the first skipped cell).
+#     emit_row used `python3 - <<PY` — the heredoc IS stdin, so the JSON row the
+#     caller piped in was replaced by the heredoc and json.loads("") raised, which
+#     with `set -e` killed the whole sweep before the card / recommend / results
+#     files were written. The row is now passed as an argument. GPU-free: run_probe
+#     is stubbed (a python3 on PATH that answers the probe's one-cell invocation),
+#     docker and nvidia-smi are stubbed so the estate and the rig are untouched.
+SHIM2="$SHIMDIR/sweep"
+mkdir -p "$SHIM2"
+cat > "$SHIM2/python3" <<'PYPY'
+#!/usr/bin/env bash
+# Only the probe's one-cell invocation (no subcommand) is stubbed; everything
+# else (planner, card, KV detect, ...) runs for real.
+if [[ "$#" -eq 1 && "$1" == "$PROBEPY_STUB" ]]; then
+  echo "round  done  silent  errors  vram_MB  agg_t/s  per-strm   ttft_ms"
+  echo "    1   8/8        0       0    10381    241.0      38.0      400"
+  echo "RESULT N=8 ctx=1024 clean=1 pass=1 mps_tps=38.0 agg_tps=241.0 running=8 waiting=0 vram_peak=10381"
+  exit 0
+fi
+exec "$(type -ap python3 | tail -1)" "$@"
+PYPY
+cat > "$SHIM2/docker" <<'SHIMD'
+#!/usr/bin/env bash
+for a in "$@"; do [ "$a" = "--format" ] && { echo "vllm serve --max-num-seqs 8 --max-model-len 32768"; exit 0; }; done
+if [ "$1" = "inspect" ]; then
+  # only the probed container resolves; anything else is "no such container"
+  if [ "$2" = "vllm-probe-test" ]; then
+    echo '[{"Config":{"Cmd":["vllm","serve"],"Env":["NVIDIA_VISIBLE_DEVICES=GPU-aaaa1111-2222-3333-4444-555566667777"]},"HostConfig":{"DeviceRequests":[{"DeviceIds":["GPU-aaaa1111-2222-3333-4444-555566667777"],"Count":-1}]}}]'
+  else
+    echo '[]'
+  fi
+  exit 0
+fi
+exit 0
+SHIMD
+cat > "$SHIM2/nvidia-smi" <<'SHIMN'
+#!/usr/bin/env bash
+q="$(printf '%s ' "$@")"
+case "$q" in
+  *index,uuid*) printf '0, GPU-00000000-1111-2222-3333-444444444444\n1, GPU-aaaa1111-2222-3333-4444-555566667777\n';;
+  *index,memory.used*) printf '0, 55000\n1, 10381\n';;
+  *index,name*) printf '0, NVIDIA GeForce RTX 3090\n1, NVIDIA GeForce RTX 3060\n';;
+esac
+exit 0
+SHIMN
+chmod +x "$SHIM2/python3" "$SHIM2/docker" "$SHIM2/nvidia-smi"
+sed -i "s#PROBEPY_STUB#PLACEHOLDER_STUB#" "$SHIM2/python3"
+sed -i "s#PLACEHOLDER_STUB#$LIB#" "$SHIM2/python3"
+# KV_TOKENS=262144 clips 32K×8 (8*(32768+256) > pool) → the FIRST cell of the
+# 32K rung is a skip: the exact path that used to kill the sweep.
+out2="$(PATH="$SHIM2:$PATH" CLUB3090_CONFIG_DIR=/nonexistent CONTAINER=vllm-probe-test \
+  URL=http://127.0.0.1:1 MODEL=x KV_TOKENS=262144 \
+  bash "$PROBE" --sweep --n 8 --ctx 1k,32k --budget 15m 2>&1)"; rc2=$?
+[[ "$rc2" == "0" ]] || fail "--sweep with a skipped cell should exit 0, got $rc2"
+command grep -q 'JSONDecodeError' <<<"$out2" \
+  && fail "--sweep crashed at the skipped cell (emit_row read the row from stdin)"
+command grep -q '=== recommend ===' <<<"$out2" || fail "--sweep with a skipped cell must still print the recommend block"
+command grep -q 'concurrency card' <<<"$out2" || fail "--sweep with a skipped cell must still render the card"
+ls "$ROOT_DIR"/results/concurrency-*.md >/dev/null 2>&1 \
+  || fail "--sweep with a skipped cell must write results/concurrency-*.md"
+rm -f "$ROOT_DIR"/results/concurrency-*.md "$ROOT_DIR"/results/concurrency-*.json
+echo "  ✓ --sweep survives the first skipped cell (budget / KV-clip / early-stop)"
+
+# 12. VRAM + GPU label are the CONTAINER's card(s), not the rig's. The container is
+#     pinned to GPU 1 (a 3060) by UUID; GPU 0 is an unrelated 3090 with 55 GB in
+#     use. The scoped reading must be 10381 MB / "1× GeForce RTX 3060".
+idx="$(PATH="$SHIM2:$PATH" CONTAINER=vllm-probe-test python3 -c '
+import sys; sys.path.insert(0, "'"$ROOT_DIR"'/scripts/lib")
+from concurrency_probe import container_gpu_indices; print(",".join(map(str, container_gpu_indices())))')"
+[[ "$idx" == "1" ]] || fail "container GPU resolution should return index 1, got '$idx'"
+mb="$(PATH="$SHIM2:$PATH" CONTAINER=vllm-probe-test python3 -c '
+import sys; sys.path.insert(0, "'"$ROOT_DIR"'/scripts/lib")
+from concurrency_probe import vram_used_mb; print(vram_used_mb())')"
+[[ "$mb" == "10381" ]] || fail "scoped vram_used_mb should be 10381 (the container card), got $mb"
+gpus="$(PATH="$SHIM2:$PATH" CONTAINER=vllm-probe-test python3 -c '
+import sys; sys.path.insert(0, "'"$ROOT_DIR"'/scripts/lib")
+from concurrency_probe import gpu_fingerprint; print(gpu_fingerprint())')"
+[[ "$gpus" == "1× GeForce RTX 3060" ]] || fail "GPU label should be scoped to the container card, got '$gpus'"
+# No container resolvable → rig-wide fallback, but LABELLED as such so a rig total
+# is never read as the service's own figure.
+gpus2="$(PATH="$SHIM2:$PATH" python3 -c '
+import sys; sys.path.insert(0, "'"$ROOT_DIR"'/scripts/lib")
+from concurrency_probe import gpu_fingerprint; print(gpu_fingerprint("nonexistent"))')"
+command grep -q 'rig-wide' <<<"$gpus2" || fail "unscoped GPU label must say rig-wide, got '$gpus2'"
+echo "  ✓ VRAM + GPU label scoped to CONTAINER's card(s); rig-wide fallback labelled"
+
+
 echo "test-concurrency-probe: ok"
