diff --git a/scripts/tests/test-patch-attribution.sh b/scripts/tests/test-patch-attribution.sh
index 6f4aabf..6016dd4 100755
--- a/scripts/tests/test-patch-attribution.sh
+++ b/scripts/tests/test-patch-attribution.sh
@@ -319,6 +319,83 @@ for patch in chat_template_patches:
                     f"../../patches/... mount form)"
                 )
 
+# ---------------------------------------------------------------------------
+# Install-script negative control: the legacy `delivery:` fallback used to
+# answer True for ANY compose that ran ANY installer, because a directory
+# entry added its parent's name (`patches`) as a marker and a file entry
+# added a bare `install.sh`. So a patch that had been unwired from a compose
+# (mount + invoke deleted) still reported "reached". Sound rule: the
+# delivery_spec decides, and a stripped compose (no line left carrying the
+# patch) must report NOT reached.
+import tempfile  # noqa: E402
+
+install_script_patches = [
+    p for p in patches if p.get("delivery_mechanism") == "install_script"
+]
+with tempfile.TemporaryDirectory() as _td2:
+    _tdp2 = Path(_td2)
+    _by_target: dict[str, list[dict]] = {}
+    for _patch in install_script_patches:
+        _spec = _patch.get("delivery_spec") or {}
+        _t = _spec.get("mounted_at")
+        if _t:
+            _by_target.setdefault(_t, []).append(_patch)
+    for _patch in install_script_patches:
+        _spec = _patch.get("delivery_spec") or {}
+        _src = pa._patch_source_marker(_patch)
+        _target = _spec.get("mounted_at")
+        _needles = [n for n in (_src, _target) if n]
+        _lb = [
+            c
+            for lb in _patch.get("load_bearing_when") or []
+            for c in (lb.get("composes") or [])
+            if c in COMPOSE_REGISTRY
+        ]
+        if not (_needles and _lb):
+            continue
+        _cpath = root / COMPOSE_REGISTRY[_lb[0]]["compose_path"]
+        _kept = [
+            ln
+            for ln in _cpath.read_text(encoding="utf-8").splitlines(keepends=True)
+            if not any(n in ln for n in _needles)
+        ]
+        _stripped = _tdp2 / (_lb[0].replace("/", "-") + ".yml")
+        _stripped.write_text("".join(_kept), encoding="utf-8")
+        if not pa.reaches(root, _patch, _cpath.as_posix()):
+            errors.append(
+                f"{_patch['id']} false-negative: its own load-bearing compose "
+                f"{_lb[0]} stopped being reported as reached"
+            )
+        if pa.reaches(root, _patch, str(_stripped)):
+            errors.append(
+                f"{_patch['id']} FALSE-POSITIVE: a compose with its mount and "
+                f"invoke deleted (no line left carrying {_src or _target}) still "
+                f"reports reached - the legacy delivery: fallback is overriding "
+                f"the sound delivery_spec check with non-identifying markers "
+                f"(patches/..., install.sh)"
+            )
+        # Two patches may share ONE in-container target (.../w4a8 ...): the
+        # mount must be matched on its SOURCE, not just the target. Strip
+        # this patch's mount + invoke from a compose that carries a sibling
+        # patch at the same target and assert the sibling is NOT reported
+        # as reached there.
+        for _sib in _by_target.get(_target, []):
+            if _sib is _patch or not _src:
+                continue
+            _swapped = "\n".join(
+                ln
+                for ln in _cpath.read_text(encoding="utf-8").splitlines()
+                if _src not in ln
+            )
+            _swap_path = _tdp2 / ("swap-" + _lb[0].replace("/", "-") + ".yml")
+            _swap_path.write_text(_swapped + "\n", encoding="utf-8")
+            if pa.reaches(root, _sib, str(_swap_path)):
+                errors.append(
+                    f"{_sib['id']} FALSE-POSITIVE: a compose mounting a DIFFERENT "
+                    f"patch at the same in-container target {_target} still reports "
+                    f"reached - the mount source must match, not just the target"
+                )
+
 arch_allowed_keys = pa.ARCH_ALLOWED_KEYS
 arch_required = pa.ARCH_REQUIRED_KEYS
 valid_trc = pa.VALID_TRC
