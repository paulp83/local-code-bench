diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..9dbe010 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,31 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ #1500: SGLang admits CustomAllReduceV2 only on a FULL NVLink mesh, so every
+# PCIe rig runs the V1 `CustomAllreduce` — which logs nothing at init. Its ONLY
+# success signal is the post-CUDA-graph-capture `Registering N cuda graph
+# addresses` line on rank 0, so a live V1 kernel used to score `unknown`.
+_sgl_v1=$(cat <<'EOF'
+[2026-10-05 12:00:02] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-05 12:00:20 TP0] sglang is using nccl==2.30.7
+[2026-10-05 12:00:41 TP0] Registering 4352 cuda graph addresses (segment 0, rank 0)
+EOF
+)
+_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev" "Registering 4352 cuda graph addresses"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "normalized SGLang V1 registration -> on (got $r)"
+# Without the registration line the boot still says nothing it can prove.
+r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' 'sglang is using nccl==2.30.7' | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "SGLang V1 without registration proof -> unknown (got $r)"
+# A registration line must not outrank an engine veto in the same stream.
+r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' 'Registering 4352 cuda graph addresses (rank 0)' 'CustomAllReduceV2 is disabled because your platform lacks GPU P2P capability or P2P test failed. To silence this warning, specify disable_custom_all_reduce=True explicitly.' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_degraded" ]] || fail "SGLang V1 line vs veto -> veto wins (got $r)"
+unset _sgl_v1 _ev
+echo "  ✓ SGLang V1 custom-AR graph-buffer registration scored as ON (#1500)"
+
