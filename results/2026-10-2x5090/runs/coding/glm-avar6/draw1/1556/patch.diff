+# Each engine names its KV pool once at boot. The line scrolls away: a container
+# that has been serving for a while has pushed it out of a short --tail read, so
+# detect_kv_tokens reads deep (see KV_LOG_TAIL) and parse_kv_tokens_text accepts
+# every spelling. Matches are collected across ALL patterns and the LATEST one in
+# the log wins — the newest line is the pool the running server actually sized.
+#   vLLM   : "GPU KV cache size: 210,000 tokens" (optional leading ~)
+#   SGLang : "KV Cache is allocated. dtype: torch.float8_e4m3fn, #tokens: 409552"
+#            "max_total_num_tokens=409552 chunked_prefill_size=… max_running_requests=N"
+_KV_TOKEN_PATTERNS = (
+    r"GPU\s+KV\s+cache\s+size:\s*~?([\d,]+)\s*tokens",
+    r"KV\s+Cache\s+is\s+allocated\.[^#]*#\s*tokens:\s*([\d,]+)",
+    r"\bmax_total_num_tokens\s*=\s*([\d,]+)",
+)
+
