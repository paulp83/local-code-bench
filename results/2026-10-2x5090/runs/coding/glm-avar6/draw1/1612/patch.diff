+def _chat_template_flag_tokens(invoke: str | None) -> list[str]:
+    """The `--chat-template`/`--chat-template-file` tokens a chat_template patch's invoke
+    declares, most-specific first. `--chat-template` alone must never be matched as a
+    PREFIX of `--chat-template-file`, so callers test with a negative lookahead."""
+    invoke = invoke or ""
+    toks: list[str] = []
+    if "--chat-template-file" in invoke:
+        toks.append("--chat-template-file")
+    if re.search(r"--chat-template(?!-)", invoke):
+        toks.append("--chat-template")
+    return toks
