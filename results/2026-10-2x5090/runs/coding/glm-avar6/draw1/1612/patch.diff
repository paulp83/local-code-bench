+def _chat_template_invoke_is_literal(invoke: str | None) -> bool:
+    """True iff the invoke is a literal `--chat-template[-file] <path>` command pair.
+
+    A human-readable description (the qwen38 patch's
+    "--chat-template <model dir>/chat_template.jinja (vLLM composes only, directly after
+    --model)" — the `<model dir>` placeholder is not a path, and the flag is
+    engine-conditional: SGLang composes need no flag) is NOT literal, so no flag token is
+    demanded of the merged body.
+    """
+    invoke = invoke or ""
+    for tok in _chat_template_flag_tokens(invoke):
+        for m in re.finditer(re.escape(tok) + r"\s+(\S+)", invoke):
+            if m.group(1).startswith(("/", "../", "./")):
+                return True
+    return False
