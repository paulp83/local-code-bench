+def _chat_template_flag_args(body: str) -> list[str]:
+    """Every argument a `--chat-template`/`--chat-template-file` flag names in ``body``.
+
+    Used as a GUARD for the mount-over-model-dir style (e.g. the qwen38 patch, whose flag is
+    engine-conditional and whose invoke is a description rather than a literal pair): if the
+    body carries such a flag at all, its argument must name the mounted target — a flag that
+    names some OTHER template file means the engine is not rendering this patch's template.
+    """
+    args: list[str] = []
+    # The merged body renders the flag and its argument as ADJACENT LIST ITEMS
+    # (`- --chat-template` / `- /root/…/chat_template.jinja`), so the scan must span the
+    # newline and the `- ` bullet between them.
+    for m in re.finditer(r"--chat-template(?:-file)?[ \t\r\n]*(?:-[ \t\r\n]+)?(\S+)", body):
+        args.append(m.group(1).strip('"'))
+    return args
+
+
+def _flag_token_present(token: str, body: str) -> bool:
+    """True iff ``token`` appears as a real flag in ``body``.
+
+    A ``--chat-template`` token must NOT be matched as a PREFIX of ``--chat-template-file``
+    (which would make every llama.cpp `--chat-template-file` compose "pass" the vLLM-style
+    check and vice versa), so the scan carries a negative lookahead over ``-``.
+    """
+    return bool(re.search(re.escape(token) + r"(?!-)", body))
+
+
+def _marker_in_body(marker: str, body: str) -> bool:
+    """Is a delivery_spec invoke marker genuinely present in ``body``?
+
+    For the chat_template explicit-flag style the marker is the pair
+    ``"<flag> <mounted path>"``: require BOTH tokens in the merged body — the merged
+    command renders them as adjacent list items, so the joined string never appears; match
+    them separately, as the delivery_spec comment says. A bare flag anywhere else in the
+    body (another patch's own template, or `--chat-template` matched as a prefix of
+    `--chat-template-file`) must not satisfy it.
+    """
+    if not marker:
+        return False
+    parts = marker.split(" ")
+    if len(parts) == 2 and parts[0].startswith("--chat-template"):
+        flag, mounted = parts
+        return _flag_token_present(flag, body) and mounted in body
+    return marker in body
+
