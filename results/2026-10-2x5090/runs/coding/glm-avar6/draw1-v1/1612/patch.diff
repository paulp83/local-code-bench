+def _flag_lines(flag_token: str, body_lines: list[str]) -> list[str]:
+    """Lines that pass ``flag_token`` as a flag (word-bounded, so ``--chat-template`` is
+    not read out of ``--chat-template-file``), TOGETHER with the line that carries its
+    argument.
+
+    The merged render may split a command list across lines (``- --chat-template`` with the
+    path on the following line), so each flag line is returned joined with its successor —
+    a caller matching a target substring sees either shape.
+    """
+    pat = re.compile(re.escape(flag_token) + r"\b(?!-)")
+    out: list[str] = []
