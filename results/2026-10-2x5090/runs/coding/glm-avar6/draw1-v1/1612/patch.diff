+def _mount_targets_on(line: str, vol_markers: list[str]) -> list[str]:
+    """The declared mount targets this ``line`` realises.
+
+    A mount line reads ``<source>:<target>[:mode]`` (or the flag argument form
+    ``--chat-template <target>``); every declared marker that appears on the line is a
+    target candidate. Splitting on ``:`` recovers the *other* path(s) on the line, so the
+    caller can pair a flag line with the mount that realises it.
+    """
+    if not any(m in line for m in vol_markers):
+        return []
+    parts = [seg.strip() for seg in line.strip().lstrip("-").strip().split(":")]
+    return [seg for seg in parts if seg and seg not in ("ro", "rw") and "/" in seg]
+
