new file mode 100755
index 0000000..4710502
--- /dev/null
+++ b/scripts/lib/profiles/rename.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Local-layer RENAME — re-key a slug ``promote.py`` wrote (thin shim).
+
+The real executor is ``update.py`` (P7): it carries BOTH the rename and the
+field edit, because a rename is just the degenerate case of an update that
+changes the slug and nothing else. This shim exists so the remedy #1204
+promised for a shadowed slug has a name people will type::
+
+    python3 scripts/lib/profiles/rename.py --slug my-llamacpp/mine --to vllm/mine
+
+and it prints ``RENAME_OK <old> -> <new>`` on success (exit codes 0/3/2, same
+conventions as promote.py / demote.py). CORE IS NEVER TOUCHED: the slug must
+already live in registry.local.json, and the destination must be free."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+_HERE = Path(__file__).resolve()
+_DEFAULT_ROOT = _HERE.parents[3]
+
+
+def main(argv=None) -> int:
+    """Delegate to update.py with a rename-shaped argument list."""
+    argv = list(sys.argv[1:] if argv is None else argv)
+    from update import main as update_main  # same-directory import
+
+    # Accept the shorter `--to` spelling in addition to update.py's --rename-to.
+    if "--to" in argv:
+        i = argv.index("--to")
+        if len(argv) <= i + 1:
+            print("[rename] --to needs a <engine>/<name> slug", file=sys.stderr)
+            return 3
+        argv[i:i + 2] = ["--rename-to", argv[i + 1]]
+    if not any(a.startswith("--rename-to") or a == "--to" for a in argv):
+        print(
+            "[rename] nothing to do: pass --to <engine>/<name> "
+            "(use update.py for a field edit)",
+            file=sys.stderr,
+        )
+        return 3
+    return update_main(argv)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
