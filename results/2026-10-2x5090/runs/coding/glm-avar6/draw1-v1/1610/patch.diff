+def _legacy_reaches(
+    root: Path,
+    patch: dict,
+    delivery: dict,
+    body: str,
+) -> bool:
+    """The deprecated ``delivery:`` fallback, tightened.
+
+    The declared artifacts are probed only by **identifying** names: the
+    generic installer basenames above and the parent-dir marker (always
+    ``patches``, so it matches every other mount) are dropped, and the
+    patch's own directory name is used instead. An entry whose only
+    declared artifact is a generic installer with no identifying
+    directory therefore never matches on the files probe alone (the
+    ``patch["id"]`` probe below is the remaining fallback).
+    """
+    if delivery.get("entrypoint_invoke"):
+        for rel in patch.get("files") or []:
+            base = Path(rel).name
+            if base in GENERIC_ARTIFACT_BASENAMES:
+                # The bare installer name matches every compose that runs
+                # *any* install script — identify the patch by its own
+                # directory instead.
+                parent = Path(rel).parent
+                base = parent.name if parent.name not in {"patches", ""} else ""
+                if not base or base in GENERIC_ARTIFACT_BASENAMES:
+                    continue
+            if base in body:
+                return True
+        if patch["id"] in body:
+            return True
+    if (
+        delivery.get("genesis")
+        and patch.get("genesis_env")
+        and patch["genesis_env"] in body
+    ):
+        return True
+    if delivery.get("dockerfile_bake") and "ghcr.io/noonghunna/vllm-club3090" in body:
+        return True
+    return False
+
