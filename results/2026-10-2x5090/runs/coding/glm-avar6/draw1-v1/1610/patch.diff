+# (4b) NEGATIVE CONTROL — install_script patches: a compose whose mount +
+#     invoke lines were REMOVED must report not-reached. The legacy
+#     `delivery:` fallback used to match on generic markers (the blanket
+#     `patches` parent-dir marker, or the bare `install.sh` basename) that
+#     EVERY wired compose contains — so an unwired patch still reported
+#     reached and the drift went undetected.
+import copy as _copy  # noqa: E402
+
+_script_patches = [
+    p for p in patches
+    if (p.get("delivery_spec") or {}).get("script") and p.get("files")
+]
+if _script_patches:
+    sp = _script_patches[0]
+    spec = sp["delivery_spec"]
+    mounted = spec.get("mounted_at")
+    invoke = spec.get("invoke")
+    with tempfile.TemporaryDirectory() as _td:
+        _tdp = Path(_td)
+        wired = _tdp / "wired.yml"
+        stripped = _tdp / "stripped.yml"
+        wired.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ./patches/{sp['id']}/install.sh:{mounted}/install.sh:ro\n"
+            "    entrypoint:\n"
+            f"      - bash\n"
+            f"      - {invoke}\n",
+            encoding="utf-8",
+        )
+        # Same compose with the patch's mount + invoke lines removed — but
+        # ANOTHER patch's install.sh still mounted/invoked (the realistic
+        # half-unwired estate). Only the identifying markers may be gone.
+        other_mount = "./patches/other-patch/install.sh:/etc/club3090/other/install.sh:ro"
+        other_invoke = "bash /etc/club3090/other/install.sh"
+        stripped.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - {other_mount}\n"
+            "    entrypoint:\n"
+            "      - bash\n"
+            f"      - {other_invoke}\n",
+            encoding="utf-8",
+        )
+        if not pa.reaches(root, sp, str(wired)):
+            errors.append(
+                "install_script reaches(): a compose that DOES mount + invoke "
+                "the patch's declared delivery_spec wiring was not detected "
+                "as reached (false negative on a wired compose)"
+            )
+        if pa.reaches(root, sp, str(stripped)):
+            errors.append(
+                "install_script reaches() FALSE-POSITIVE: a compose whose "
+                "mount + invoke lines were removed was still reported reached "
+                "via generic markers (patches / install.sh) that every wired "
+                "compose contains — the unwired-patch drift is undetectable"
+            )
+
