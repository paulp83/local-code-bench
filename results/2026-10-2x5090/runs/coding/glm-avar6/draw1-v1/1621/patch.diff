+# Engine-neutral by design: the vLLM/SGLang readback line is the same on every
+# engine, and effort_budget.py owns its parsing (the LAST line wins: `docker logs`
+# spans restarts). The llama.cpp readback is `docker inspect` + the resolved flag
+# value (scripts/lib/thinking-budget.sh), so its evidence rules stay in one place.
 SERVER_THINKING_BUDGET=""          # N | off | empty = unknown / not in effect
 SERVER_THINKING_EFFORT=""          # the effort that budget was read for
 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+
+# Apply a budget the wrapper has read back: raise the DEFAULT thinking cap to
+# budget + THINKING_BUDGET_HEADROOM when that is larger, keep an explicit choice,
+# and stamp/record. Shared by BOTH readbacks (the `[effort-budget] v1` boot line
+# and llama.cpp's boot flag), so the two can never drift apart.
+#   $1 budget   the reasoning-token budget in effect
+#   $2 effort   the effort it was read for ("" when the budget is server-wide)
+#   $3 clause   the ", read from …" evidence clause (""-prefixed caller composes it)
+_sb_apply_budget() {
+  SERVER_THINKING_BUDGET="$1"
+  SERVER_THINKING_EFFORT="$2"
+  local _sb_what="server budget ${SERVER_THINKING_BUDGET} reasoning tokens$3"
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    # A per-request budget (vLLM / SGLang) overrides the server's, so the server's
+    # is not the one in effect. On llama.cpp the budget IS the boot flag --thinking-budget
+    # verified against — same number, one source of truth, so nothing more to say.
+    local _sb_wins="is sent per request and wins over it"
+    [[ -n "$2" ]] || _sb_wins="matches the boot flag the server was verified to carry"
+    echo "[quality-test] ${_sb_what} — --thinking-budget ${THINKING_BUDGET} ${_sb_wins}; cap from --thinking-budget"
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+  elif [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$SERVER_THINKING_BUDGET" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${SERVER_THINKING_BUDGET}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+  elif [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+  else
+    local _sb_headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+    if ! [[ "$_sb_headroom" =~ ^[1-9][0-9]*$ ]]; then
+      echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${_sb_headroom}'" >&2
+      exit 2
+    fi
+    local _sb_cap=$(( SERVER_THINKING_BUDGET + _sb_headroom ))
+    if [[ "$_sb_cap" -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+      THINKING_MAX_TOKENS="$_sb_cap"
+      THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${_sb_headroom}"
+      echo "[quality-test] ${_sb_what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${SERVER_THINKING_BUDGET} + ${_sb_headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+    else
+      echo "[quality-test] ${_sb_what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${_sb_headroom} tokens for the answer"
+    fi
+  fi
+}
