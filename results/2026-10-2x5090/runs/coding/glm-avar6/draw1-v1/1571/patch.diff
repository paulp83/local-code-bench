+#!/usr/bin/env bash
+# test-report-vram-attribution — every card's VRAM is attributed to the process
+# that actually holds it (#1537).
+#
+# Why this test exists. "Display / desktop state" found ONE running club
+# container and credited it with EVERY card that had more than 100 MiB in use.
+# On the rig that opened #1537, the report said GPUs 0 and 2 were "held by
+# running `sglang-cmp170hx`" — while that container could only see GPU 1 and
+# `nvidia-smi` showed another container's `VLLM::Worker_TP0/1` on GPUs 0 and 2.
+#
+# Contract asserted here:
+#   - per-process attribution: each GPU names the container/process that
+#     `nvidia-smi --query-compute-apps` shows on ITS uuid, with the MiB;
+#   - a container that cannot see a card is never credited with that card;
+#   - a driver that does not expose compute apps does NOT invent a holder —
+#     it says attribution was unavailable instead of blaming a container.
+
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0; FAIL=0
+DUMP_DIR="$(mktemp -d)"; DUMP_IDX=0; CURRENT_DUMP="(none)"
+ok() { PASS=$((PASS+1)); }
+no() { echo "FAIL: $1" >&2; FAIL=$((FAIL+1)); }
+eq() { if [[ "$2" == "$3" ]]; then ok; else no "$1: expected '$3', got '$2'"; fi; }
+has()   { if [[ "$2" == *"$3"* ]]; then ok; else no "$1: missing '$3' — report: $CURRENT_DUMP"; fi; }
+hasnt() { if [[ "$2" != *"$3"* ]]; then ok; else no "$1: must NOT contain '$3' — report: $CURRENT_DUMP"; fi; }
+
+# ===========================================================================
+# Layer 1 — lib unit tests (scripts/lib/vram-holders.sh)
+# ===========================================================================
+# shellcheck source=/dev/null
+source "${ROOT_DIR}/scripts/lib/vram-holders.sh"
+
+export CLUB3090_FAKE_GPU_UUIDS="GPU-aaaa 0
+GPU-bbbb 1
+GPU-cccc 2"
+export CLUB3090_FAKE_COMPUTE_APPS="GPU-aaaa,5001,VLLM::Worker_TP0/1,1200
+GPU-bbbb,5002,sglang::Sched,800
+GPU-cccc,5003,VLLM::Worker_TP1/1,1200"
+export CLUB3090_FAKE_PID_HOLDERS="5001:vllm-cmp170hx,5003:vllm-cmp170hx"
+
+eq "GPU 0 attributes to the container actually on it" \
+   "$(vram_gpu_holders 0)" "$(printf 'vllm-cmp170hx\t1200\tVLLM::Worker_TP0/1')"
+eq "GPU 1 attributes to its own holder" \
+   "$(vram_gpu_holders 1)" "$(printf 'sglang-cmp170hx\t800\tsglang::Sched')"
+eq "GPU 2 attributes to the container actually on it" \
+   "$(vram_gpu_holders 2)" "$(printf 'vllm-cmp170hx\t1200\tVLLM::Worker_TP1/1')"
+
+# A card nobody is on yields nothing (never a guessed holder).
+eq "unmapped index: no holders" "$(vram_gpu_holders 9)" ""
+
+# Multiple holders on ONE card: both listed, dominant first, memory summed.
+export CLUB3090_FAKE_COMPUTE_APPS="${CLUB3090_FAKE_COMPUTE_APPS}
+GPU-aaaa,5004,python,300"
+export CLUB3090_FAKE_PID_HOLDERS="5001:vllm-cmp170hx,5003:vllm-cmp170hx,5004:"
+out="$(vram_gpu_holders 0)"
+has "two holders on one card: dominant first" "$out" "$(printf 'vllm-cmp170hx\t1200')"
+has "two holders on one card: the second is present" "$out" "python"
+
+# An unmappable PID degrades to the process name, never disappears.
+unset CLUB3090_FAKE_PID_HOLDERS
+out="$(vram_gpu_holders 0)"
+has "unmappable PID falls back to the process name" "$out" "VLLM::Worker_TP0/1"
+
+# No compute-app data at all (driver does not expose it) → no holders.
+unset CLUB3090_FAKE_COMPUTE_APPS
+eq "no compute apps: no holders" "$(vram_gpu_holders 0)" ""
+unset CLUB3090_FAKE_GPU_UUIDS
+
+# ===========================================================================
+# Layer 2 — the REAL report.sh end to end under scripted nvidia-smi + docker.
+# ===========================================================================
+# shellcheck source=fixtures/report-harness/report-env.sh
+source "${ROOT_DIR}/scripts/tests/fixtures/report-harness/report-env.sh"
+report_env_init "$ROOT_DIR"
+cleanup_all() { report_env_cleanup; }
+trap cleanup_all EXIT
+
+run_report() {
+  report_run "$@"
+  set +e
+  DUMP_IDX=$((DUMP_IDX+1))
+  CURRENT_DUMP="${DUMP_DIR}/report-${DUMP_IDX}.md"
+  printf '%s\n' "$REPORT_OUT" > "$CURRENT_DUMP"
+}
+
+# nvidia-smi stub: three cards, two of them held by a vLLM container the club
+# container cannot see, one held by the club container itself.
+report_nvsmi_stub <<'NVSMI'
+#!/usr/bin/env bash
+args="$*"
+case "$args" in
+  *index,uuid*)          echo "0, GPU-aaaa"; echo "1, GPU-bbbb"; echo "2, GPU-cccc"; exit 0 ;;
+  *gpu_uuid,pid,process_name,used_memory*)
+                          [[ "${MOCK_NO_COMPUTE_APPS:-0}" == "1" ]] && exit 0
+                          echo "GPU-aaaa, 5001, VLLM::Worker_TP0/1, 1200"
+                          echo "GPU-bbbb, 5002, sglang::Sched, 800"
+                          echo "GPU-cccc, 5003, VLLM::Worker_TP1/1, 1200"
+                          exit 0 ;;
+  *index,memory.used*)   echo "0, 1200"; echo "1, 800"; echo "2, 1200"; exit 0 ;;
+  *ecc.mode.current*)    echo "[N/A]"; exit 0 ;;
+  *enforced.power.limit*) echo "0, MockForce RTX 3090, 24576 MiB, 610.57.04, 94.02, Enabled, 370.00 W, 370.00 W, 390.00 W, 41.00 W, 0000:01:00.0, 1, 4, 16, 16, 370.00 W"
+                          echo "1, MockForce RTX 3090, 24576 MiB, 610.57.04, 94.02, Enabled, 420.00 W, 420.00 W, 450.00 W, 28.00 W, 0000:02:00.0, 1, 4, 8, 16, 420.00 W"
+                          echo "2, MockForce RTX 3090, 24576 MiB, 610.57.04, 94.02, Enabled, 370.00 W, 370.00 W, 390.00 W, 41.00 W, 0000:03:00.0, 1, 4, 16, 16, 370.00 W"
+                          exit 0 ;;
+  *index,power.limit*)   echo "0, 370.00, 370.00"; echo "1, 420.00, 420.00"; echo "2, 370.00, 370.00"; exit 0 ;;
+  -L)                    echo "GPU 0: MockForce RTX 3090 (UUID: GPU-aaaa)"
+                         echo "GPU 1: MockForce RTX 3090 (UUID: GPU-bbbb)"
+                         echo "GPU 2: MockForce RTX 3090 (UUID: GPU-cccc)"; exit 0 ;;
+  *topo*-p2p*)           exit 1 ;;
+  *nvlink*)              exit 1 ;;
+  "")                    echo "CUDA Version: 13.2"; exit 0 ;;
+  *)                     exit 0 ;;
+esac
+NVSMI
+
+# docker stub: exactly one running club container, listed FIRST — the very
+# shape that used to be credited with every card.
+report_docker_stub <<'DOCKER'
+#!/usr/bin/env bash
+case "$*" in
+  info)                  exit 0 ;;
+  *compose*)             exit 0 ;;
+  *--format*{{.Names}}*) echo "sglang-cmp170hx"; exit 0 ;;
+  *)                     exit 0 ;;
+esac
+DOCKER
+
+export CLUB3090_FAKE_GPU_UUIDS="GPU-aaaa 0
+GPU-bbbb 1
+GPU-cccc 2"
+export CLUB3090_FAKE_COMPUTE_APPS="GPU-aaaa,5001,VLLM::Worker_TP0/1,1200
+GPU-bbbb,5002,sglang::Sched,800
+GPU-cccc,5003,VLLM::Worker_TP1/1,1200"
+export CLUB3090_FAKE_PID_HOLDERS="5001:vllm-cmp170hx,5002:sglang-cmp170hx,5003:vllm-cmp170hx"
+
+run_report --no-redact
+OUT="$REPORT_OUT"
+eq "report exits 0" "$REPORT_RC" "0"
+
+# THE incident: GPUs 0 and 2 belong to the vLLM container, NOT to the first
+# running club container.
+has "GPU 0 attributed to its real holder"  "$OUT" "GPU 0 idle VRAM:** 1200 MiB (held by \`vllm-cmp170hx\`"
+has "GPU 2 attributed to its real holder"  "$OUT" "GPU 2 idle VRAM:** 1200 MiB (held by \`vllm-cmp170hx\`"
+has "GPU 1 attributed to the club container" "$OUT" "GPU 1 idle VRAM:** 800 MiB (held by \`sglang-cmp170hx\`"
+has "GPU 0 line names the holding process" "$OUT" "VLLM::Worker_TP0/1"
+hasnt "GPU 0 is not credited to the invisible container" "$OUT" \
+      "GPU 0 idle VRAM:** 1200 MiB (held by \`sglang-cmp170hx\`"
+hasnt "GPU 2 is not credited to the invisible container" "$OUT" \
+      "GPU 2 idle VRAM:** 1200 MiB (held by \`sglang-cmp170hx\`"
+
+# Negative control: a driver that does not expose compute apps must not invent
+# a holder.
+export MOCK_NO_COMPUTE_APPS=1
+run_report --no-redact
+OUT="$REPORT_OUT"
+has "no compute apps: attribution is declared unavailable" "$OUT" \
+    "no per-process attribution was available"
+hasnt "no compute apps: no invented holder" "$OUT" "held by \`sglang-cmp170hx\`"
+
+echo
+echo "vram-attribution: ${PASS} passed, ${FAIL} failed"
+[[ "$FAIL" -eq 0 ]] || exit 1
+exit 0
