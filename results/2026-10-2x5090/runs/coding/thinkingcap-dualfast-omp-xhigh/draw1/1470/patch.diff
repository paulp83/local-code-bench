diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..b96fd94 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,38 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# SGLang V1 CustomAllreduce — the class every PCIe rig runs (V2 is admitted only
+# on full NVLink, can_use_custom_all_reduce_v2 → full_nvlink is True). It logs
+# NOTHING when it initializes; its only success signal is rank 0's
+# graph-buffer registration after CUDA-graph capture. Before this fix a healthy
+# PCIe boot scored "unknown" ("no P2P engagement signal") — the maintainer's P2P
+# opt-in boot registered its graph buffers, passed verify-full + a continuous
+# soak, and every report still said unknown (follow-up to #1462). Real wording,
+# sglang/srt/distributed/device_communicators/custom_all_reduce.py (the
+# vLLM-forked CustomAllreduce).
+_sgl_v1=$(cat <<'EOF'
+[2026-10-12 10:00:00] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-12 10:00:12 TP0] sglang is using nccl==2.30.7
+[2026-10-12 10:02:04 TP0] Registering 4352 cuda graph addresses. This can take up to several minutes for large models
+EOF
+)
+_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev" "cuda graph addresses"
+r="$(printf '%s\n' "$_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 registration -> on (got $r)"
+# Restart epochs both ways: a failed restart must not inherit an earlier clean
+# V1 boot's registration line; a clean V1 boot after a failed one must not
+# inherit the failure.
+_fail_boot="$(printf '%s\n' "[sglang] BOOT disable_custom_all_reduce=False" 'sglang is using nccl==2.30.7' 'Setup Custom allreduce failed with invalid literal for int() with base 10: GPU-0e72. To silence this warning, specify --disable-custom-all-reduce explicitly.')"
+r="$(printf '%s\n%s' "$_ev" "$_fail_boot" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_failed" ]] || fail "failed restart after a clean V1 boot -> nccl_only_failed (got $r)"
+r="$(printf '%s\n%s' "$_fail_boot" "$_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "clean V1 restart after a failed setup -> on (got $r)"
+unset _sgl_v1 _ev _fail_boot
+echo "  ✓ SGLang V1 (PCIe rigs): graph-buffer registration scores custom-AR on; restart epochs preserved"
+
