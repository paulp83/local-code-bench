diff --git a/scripts/tests/test-concurrency-probe-sweep.sh b/scripts/tests/test-concurrency-probe-sweep.sh
new file mode 100755
index 0000000..d464402
--- /dev/null
+++ b/scripts/tests/test-concurrency-probe-sweep.sh
@@ -0,0 +1,300 @@
+#!/usr/bin/env bash
+# test-concurrency-probe-sweep — GPU-free regression guards for the two
+# 2026-10-13 probe bugs:
+#
+#   1. --sweep died at the FIRST skipped cell. emit_row piped the JSON row
+#      into `python3 - <<'PY'` — but `python3 -` reads its program FROM
+#      stdin, so the heredoc IS stdin: the pipe was dropped,
+#      sys.stdin.read() returned "", and json.loads("") raised, which
+#      set -e turned into rc=1. No card, no === recommend === block, no
+#      results/concurrency-*.md/json. Reproduced below end-to-end: a real
+#      --sweep against the soak-harness stub endpoint with early-stopped
+#      AND KV-clipped cells must finish rc=0 and write the artifacts.
+#
+#   2. VRAM and the GPU label were RIG-WIDE on a multi-GPU host:
+#      vram_used_mb() summed memory.used across every card (a neighbor
+#      service's usage entered the leak/peak verdict and the envelope
+#      vram_peak_gb), and _gpu_fp() named every card after GPU 0 (a
+#      3060 pinned next to busy 3090s read "4× GeForce RTX 3090").
+#      Both are now scoped to the probed container's cards (docker
+#      DeviceRequests / the NVIDIA/CUDA env), with per-card peaks
+#      recorded, and a loud whole-rig fallback when no pin resolves.
+#
+# Hermetic: `docker` and `nvidia-smi` are stubbed on PATH (a fake 4-card
+# rig: two 3090s an unrelated service is chewing, a 3060 the probe is
+# pinned to, an A5000), and the endpoint is the soak-harness stub. No
+# GPU, no real docker, no server.
+set -euo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+# Force Python UTF-8 mode (PEP 540) before the first python3 call (#779).
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PROBE="$ROOT_DIR/scripts/concurrency-probe.sh"
+LIB="$ROOT_DIR/scripts/lib/concurrency_probe.py"
+FIX="$ROOT_DIR/scripts/tests/fixtures"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+
+[[ -f "$PROBE" && -f "$LIB" && -f "$FIX/soak-harness/stub-endpoint.py" ]] \
+  || fail "missing fixture or script"
+
+SHIMDIR="$(mktemp -d)"
+PS_NAME_FILE="$SHIMDIR/ps-name"   # the docker stub reports whatever this holds
+export SHIM_PS_NAME="$PS_NAME_FILE"
+
+# --- fake nvidia-smi: a 4-card rig with constant usage -------------------------
+# Cards 0,1 (two 3090s at 23000 MiB) are busy with an UNRELATED service —
+# exactly the bug's repro shape where a 12 GB card pinned at 10381 MiB next
+# to busy neighbors read "55319 MB". Card 2 is the 3060 the probe is pinned to.
+cat > "$SHIMDIR/nvidia-smi" <<'SHIM'
+#!/usr/bin/env bash
+query=""
+ids=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --query-gpu=*) query="${1#--query-gpu=}" ;;
+    -i) ids="$2"; shift ;;
+  esac
+  shift
+done
+ids="${ids//,/ }"
+[[ -z "$ids" ]] && ids="0 1 2 3"
+declare -A USED=( [0]=23000 [1]=23000 [2]=10381 [3]=15000 )
+declare -A NAME=( [0]="GeForce RTX 3090" [1]="GeForce RTX 3090" [2]="GeForce RTX 3060" [3]="A5000" )
+for i in $ids; do
+  case "$query" in
+    memory.used) echo "${USED[$i]:-}" ;;
+    name) echo "${NAME[$i]:-}" ;;
+    index,uuid) echo "$i, GPU-fake-$i" ;;
+    index,name) echo "$i, ${NAME[$i]:-}" ;;
+  esac
+done
+exit 0
+SHIM
+chmod +x "$SHIMDIR/nvidia-smi"
+
+# --- docker stub -----------------------------------------------------------------
+# `ps` reports the container from $SHIM_PS_NAME when that file exists.
+# `inspect NAME --format FMT` answers canned DeviceRequests / Env JSON per name.
+cat > "$SHIMDIR/docker" <<'SHIM'
+#!/usr/bin/env bash
+cmd="${1:-}"
+if [[ "$cmd" == "ps" ]]; then
+  [[ -f "${SHIM_PS_NAME:-}" ]] && cat "${SHIM_PS_NAME}"
+  exit 0
+fi
+if [[ "$cmd" == "inspect" && $# -ge 4 ]]; then
+  name="$2"; fmt="$4"
+  case "$name" in
+    pin-ids)
+      [[ "$fmt" == *DeviceRequests* ]] && echo '[{"driver":"nvidia","device_ids":["0","2"]}]' || echo 'null' ;;
+    pin-uuid)
+      [[ "$fmt" == *DeviceRequests* ]] && echo '[{"driver":"nvidia","device_ids":["GPU-fake-1"]}]' || echo 'null' ;;
+    pin-count)
+      [[ "$fmt" == *DeviceRequests* ]] && echo '[{"driver":"nvidia","count":2}]' || echo 'null' ;;
+    env-nvidia3)
+      [[ "$fmt" == *Config.Env* ]] && echo '["NVIDIA_VISIBLE_DEVICES=3"]' || echo 'null' ;;
+    env-cuda)
+      [[ "$fmt" == *Config.Env* ]] && echo '["NVIDIA_VISIBLE_DEVICES=all","CUDA_VISIBLE_DEVICES=1,2"]' || echo 'null' ;;
+    env-all)
+      [[ "$fmt" == *Config.Env* ]] && echo '["NVIDIA_VISIBLE_DEVICES=all"]' || echo 'null' ;;
+    env-bad)
+      [[ "$fmt" == *Config.Env* ]] && echo '["NVIDIA_VISIBLE_DEVICES=9"]' || echo 'null' ;;
+    vllm-qwen-test)
+      # the container the e2e probe run gets auto-detected for
+      [[ "$fmt" == *Config.Env* ]] && echo '["NVIDIA_VISIBLE_DEVICES=2"]' || echo 'null' ;;
+    *)
+      echo 'null' ;;
+  esac
+  exit 0
+fi
+exit 0
+SHIM
