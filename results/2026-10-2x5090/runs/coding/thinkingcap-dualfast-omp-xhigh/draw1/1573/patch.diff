 #
+# "set at boot" means in the engine's RESOLVED args. When an image starts
+# the engine through its own launcher (bucko's qwen38-serve), the flag is
+# inside that script and invisible in the container argv, so for vLLM the
+# check falls back to the engine's boot log — vLLM dumps its non-default
+# args at startup, and that dump is what the running engine actually has.
+#
 # What each engine does WITHOUT its prerequisite (read from the pinned images):
 #   llama.cpp  nothing to send — the harness cannot set a boot flag per request,
 #              and a compose-shipped `--reasoning-budget "${REASONING_BUDGET:--1}"`
@@ -229,6 +235,35 @@ _thinking_budget_container_facts() {
   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# The same question, asked of the engine's own words instead of its argv.
+# An image that starts vLLM through its own launcher (bucko's qwen38-serve)
+# adds --reasoning-parser inside that script, so the container argv — what
+# _thinking_budget_container_facts reads — shows none, and a refusal built on
+# the argv alone was a false positive the operator could not override. The
+# engine's boot log is the resolved truth: vLLM dumps its non-default args at
+# startup, and a reasoning_parser in that dump is what the running engine
+# actually has.
+#
+# <container> — stdout: `PARSER <value>` when the log reports one (the last
+# boot in the log wins, the same rule as everywhere else in this file),
+# `PARSER none` when the log was read but reports no parser, nothing when the
+# log cannot be read at all (no docker, container gone, boot lines rotated
+# away) — the caller turns that into unverifiable, not a refusal.
+_thinking_budget_vllm_log_facts() {
+  local log
+  # The startup dump sits in the first lines of a boot; a long-lived
+  # container's log has no --head, so bound the read the same way
+  # concurrency_probe does (head kills the stream once the window is full).
+  log="$(docker logs "$1" 2>/dev/null | head -n 6000 || true)"
+  [[ -n "$log" ]] || return 0
+  printf '%s\n' "$log" | python3 -c '
+import re, sys
+txt = sys.stdin.buffer.read().decode("utf-8", "replace")
+hits = [h for h in re.findall(r"reasoning_parser[\"\x27]?\s*[:=]\s*[\"\x27]?([A-Za-z0-9_-]+)", txt) if h.lower() != "none"]
+print("PARSER " + (hits[-1] if hits else "none"))
+'
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -284,7 +319,7 @@ THINKING_BUDGET_EVIDENCE=""
 THINKING_BUDGET_REASONING_PARSER=""
 
 thinking_budget_verify() {
-  local kind="$1" want="$2" c="${CONTAINER:-}" facts="" have_container=0
+  local kind="$1" want="$2" c="${CONTAINER:-}" facts="" log_facts="" have_container=0
   THINKING_BUDGET_EVIDENCE=""
   THINKING_BUDGET_REASONING_PARSER=""
   if [[ -n "$c" && "$c" != "none" ]] && command -v docker >/dev/null 2>&1 \
@@ -331,8 +366,25 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv says no parser — but the argv is only what the container
+          # was asked to run. An image that starts vLLM through its own
+          # launcher (bucko's qwen38-serve) adds --reasoning-parser inside
+          # that script, invisible to docker inspect; the engine's boot log
+          # is the resolved truth. An unreadable log is no evidence either
+          # way, so it is unverifiable (overridable), not a refusal.
+          log_facts="$(_thinking_budget_vllm_log_facts "$c")"
+          case "$log_facts" in
+            "PARSER none")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser (none in its argv and none in its boot log's non-default args) — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+            "PARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s argv shows no --reasoning-parser (the image starts vLLM through its own launcher), but its boot log reports 'reasoning_parser': '${log_facts#PARSER }' in its non-default args — the running engine carries the parser, so the budget will take effect"
+              return 0 ;;
+            *)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s argv shows no --reasoning-parser and its boot log could not be read to check whether the image's launcher adds one — if it was booted WITHOUT --reasoning-parser, vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError)"
+              return 2 ;;
+          esac
+          ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
