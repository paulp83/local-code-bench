+    # (3) no flag anywhere: covered when the mount alone is the
+    # load-bearing artifact (model-dir auto-load — carnice is
+    # wired_at: [volumes]; qwen38 declares flag_required: false).
+    return _declared_chat_template_flag(spec) is None or not spec.get("flag_required", True)
+
