+    lines = body.splitlines()
+
+    # (1) the load-bearing mount line(s): this patch's own source on the
+    # same line as the mounted target. The target is the spec's
+    # `mounted_at` verbatim, or a path CARRYING it (qwen38's suffix
+    # mount over each model dir's own chat_template.jinja).
+    targets: list[str] = []
+    for ln in lines:
+        if not any(src in ln for src in sources):
+            continue
+        target = _mount_target(ln)
+        if target and mounted_at in target:
+            targets.append(target)
+    if not targets:
+        return False
+
+    # (2) any chat-template flag in the command decides: it must be the
+    # patch's declared family (whole token) and name the mounted path.
+    # The flag/path adjacency is read from the PARSED service (list item
+    # vs folded-scalar token), not from dump lines — a wrapped ``>-``
+    # scalar can split flag and path across lines.
+    try:
+        data = _compose_yaml_load(body)
+    except Exception:
