+def _chat_template_wired(patch: dict, body: str) -> bool:
+    """Whether a ``delivery_mechanism: chat_template`` patch is genuinely
+    wired into the (merged) service ``body`` (follow-up to #1610).
+
+    A template patch is in use only when BOTH hold:
