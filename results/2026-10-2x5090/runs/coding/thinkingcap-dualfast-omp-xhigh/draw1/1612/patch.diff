+def _declared_chat_template_flag(spec: dict) -> str | None:
+    """The flag family the patch's ``invoke`` declares, read as the FIRST
+    token — never by substring: the mount-only carnice invoke
+    ("… (no --chat-template arg)") mentions the flag only in prose, and a
+    prose mention must not make the flag load-bearing. ``None`` = the
+    patch is wired mount-only."""
+    invoke = (spec.get("invoke") or "").strip()
+    if not invoke:
+        return None
+    first = invoke.split()[0]
+    return first if first in _CHAT_TEMPLATE_FLAGS else None
