+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify THIS patch's own vendored ``.jinja``
+    on its mount line (follow-up to #1597/#1610): the file's basename when
+    it is unique (e.g. ``apex-qwen-chat-template.jinja``) and/or its patch
+    directory name (``qwen38-reasoning-effort-template``,
+    ``glm53-minja-numeric-index``). The stock ``chat_template.jinja``
+    basename is shared by every model-dir mount and ``patches`` is the
+    parent of all of them, so a mount line carrying only those belongs to
+    some OTHER template. Sourced from the spec's ``jinja`` and the
+    patch's ``files`` (usually the same path). A patch with no unique
+    source name is unreachable — its mount cannot be told apart from any
+    other template's."""
+    names: set[str] = set()
+    spec = patch.get("delivery_spec") or {}
+    for rel in [spec.get("jinja"), *(patch.get("files") or [])]:
+        if not rel:
+            continue
+        path = Path(str(rel))
+        if path.suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES:
+            # a file entry: its own patch directory identifies it too
+            # (composes usually mount the whole directory)
+            for n in (path.name, path.parent.name):
+                if n and n not in _GENERIC_TEMPLATE_SOURCE_NAMES:
+                    names.add(n)
+        elif path.name and path.name not in _GENERIC_TEMPLATE_SOURCE_NAMES:
+            names.add(path.name)
+    return sorted(names)
+
