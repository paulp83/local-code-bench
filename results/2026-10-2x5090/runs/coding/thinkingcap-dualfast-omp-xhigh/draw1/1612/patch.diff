+def _command_flag_paths(data: dict | None, flag: str) -> list[str]:
+    """The path(s) named by whole-token ``flag`` in any service's
+    ``command``/``entrypoint`` of the PARSED effective compose. The flag
+    must be an EXACT token (so ``--chat-template`` never matches inside
+    ``--chat-template-file`` — the prefix trap — nor inside
+    ``--default-chat-template-kwargs``); the named path is the next
+    token: the adjacent list item when the flag stands alone on its
+    item (the block/flow list style most composes use), or the next
+    whitespace-separated token when flag and path share a (possibly
+    folded ``>-`` / wrapped) scalar (the ik-llama style), where the
+    dump's line-wrap position is irrelevant.
+    """
+    out: list[str] = []
+    services = (data or {}).get("services") or {}
+    if not isinstance(services, dict):
+        return out
+    for svc in services.values():
+        if not isinstance(svc, dict):
+            continue
+        for key in ("command", "entrypoint"):
+            raw = svc.get(key)
+            if raw is None:
+                continue
+            items = [str(x) for x in raw] if isinstance(raw, list) else [str(raw)]
+            for j, item in enumerate(items):
+                toks = item.split()
+                if flag not in toks and not any(t.startswith(flag + "=") for t in toks):
+                    continue
+                for k, t in enumerate(toks):
+                    if t == flag:
+                        if k + 1 < len(toks):
+                            out.append(toks[k + 1])
+                        elif j + 1 < len(items):
