+up_variant() {
+  local v="$1"
+  # The slug-level checks that REFUSE a launch (unknown slug, lifecycle gate,
+  # missing compose file, missing model dir) run in validate_variant() BEFORE
+  # down_running() — the lifecycle gate in particular must never run after the
+  # teardown. Kept here too: cheap, and keeps this function safe if called
+  # directly by a test.
+  if [[ -z "${VARIANTS[$v]:-}" ]]; then
+    echo "ERROR: unknown variant '${v}'." >&2
+    echo "Run: bash scripts/switch.sh --list" >&2
+    exit 1
+  fi
+  IFS='|' read -r eng dir file <<< "${VARIANTS[$v]}"
+  local full_dir="${ROOT_DIR}/${dir}"
+  if [[ ! -f "${full_dir}/${file}" ]]; then
+    echo "ERROR: compose file missing at ${full_dir}/${file}" >&2
+    exit 1
+  fi
+
+  # Post-teardown preflight: every check below needs the GPUs as they are
+  # AFTER down_running() released the previous container — the free-VRAM gate
+  # retries through the tear-down settle window, and the residency sizer prices
+  # the FREE VRAM the new container will actually get.
+  if [[ -f "${ROOT_DIR}/scripts/preflight.sh" ]]; then
+    # shellcheck source=preflight.sh
