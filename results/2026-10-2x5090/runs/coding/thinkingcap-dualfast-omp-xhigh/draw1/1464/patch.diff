   fi
   gpu_preflight
   # Orphaned engine shared-memory segments (ipc: host puts them in the HOST /dev/shm, where an unclean
@@ -1617,6 +1665,10 @@ VARIANT="$(resolve_default_variant "$VARIANT")"
