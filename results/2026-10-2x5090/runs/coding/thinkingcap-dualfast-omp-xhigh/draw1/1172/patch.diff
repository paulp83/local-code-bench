+def _compute_per_dev(text):
+    """sched_reserve totals with the re-reservation rule (see module docstring)."""
+    prim = {}     # dev -> primary (target) buffer, latest reservation
+    second = {}   # dev -> distinct context (drafter) buffer, latest reservation
+    retry = False  # a failed reservation was logged; the next smaller value is a retry
+    for m in re.finditer(
+        r"sched_reserve:\s*"
+        r"(?:compute buffer allocation failed"
+        r"|(CUDA\d) compute buffer size\s*=\s+([\d.]+) MiB)",
+        text,
+    ):
+        if m.group(1) is None:
+            retry = True
+            continue
+        dev, val = m.group(1), float(m.group(2))
+        if val >= prim.get(dev, 0.0) or retry:
+            prim[dev] = val
+            retry = False
+        else:
+            second[dev] = val
+    return {dev: prim[dev] + second.get(dev, 0.0) for dev in set(prim) | set(second)}
+
