+    gpu_vram_report_lines "$our_container"
   fi
 } | redact
 
diff --git a/scripts/tests/test-gpu-vram-report.sh b/scripts/tests/test-gpu-vram-report.sh
new file mode 100755
index 0000000..a166f7a
--- /dev/null
+++ b/scripts/tests/test-gpu-vram-report.sh
@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+# test-gpu-vram-report — gpu_vram_report_lines attributes each GPU's VRAM to
+# the process that actually holds it (#1537).
+#
+# Before the fix, report.sh's Display section found ONE running club container
+# and credited every card with >100 MiB in use to it. #1537's report said
+# GPUs 0 and 2 were "held by running sglang-cmp170hx" while that container
+# could only see GPU 1 and nvidia-smi showed another container's
+# VLLM::Worker_TP0/1 on GPUs 0 and 2.
+#
+# Contract asserted (stubs for nvidia-smi + docker; a fake proc root via
+# GPU_ATTR_PROC, so no GPU / daemon is needed):
+#   ours            … (held by running `<ours>`)
+#   other container … (held by `<other>`[, not `<ours>`])   — + ours when set
+#   host process    … (held by `<process_name>`)
+#   no owner        … ⚠ something is using this GPU [(not `<ours>`)]
+#   idle ≤100 MiB   … <N> MiB ✓
+#   no nvidia-smi   … no output, rc 0
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+# shellcheck source=../lib/gpu-select.sh
+source "$ROOT_DIR/scripts/lib/gpu-select.sh"
+
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+T="$(mktemp -d)"
+trap 'rm -rf "$T"' EXIT
+BIN="$T/bin"; PROC="$T/proc"
+mkdir -p "$BIN" "$PROC/200" "$PROC/301" "$PROC/302"
+
+# Full container ids — the cgroup scope carries the full id, docker ps must be
+# queried with --no-trunc to match it.
+ID_A="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+ID_B="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+printf '0::/system.slice/docker-%s.scope\n' "$ID_A" > "$PROC/301/cgroup"   # -> vllm-other
+printf '0::/system.slice/docker-%s.scope\n' "$ID_B" > "$PROC/302/cgroup"   # -> sglang-cmp170hx (ours)
+printf '0::/user.slice/user-1000.slice/session-41.scope\n' > "$PROC/200/cgroup"  # host session
+
+cat > "$BIN/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+for a in "$@"; do
+  case "$a" in
+    --query-gpu=*)       printf '%s\n' "$GPUQ"; exit 0 ;;
+    --query-compute-apps=*)
+      [[ -n "${APPQ:-}" ]] && printf '%s\n' "$APPQ"
+      exit 0 ;;
+  esac
+done
+exit 1
+EOF
+cat > "$BIN/docker" <<'EOF'
+#!/usr/bin/env bash
+case "${1:-}" in
+  info) exit "${DOCKER_INFO_RC:-0}" ;;
+  ps)   [[ -n "${DOCKER_PS:-}" ]] && printf '%s\n' "$DOCKER_PS"; exit 0 ;;
+  exec) [[ -n "${DOCKER_EXEC_OUT:-}" ]] && printf '%s\n' "$DOCKER_EXEC_OUT"; exit 0 ;;
+  *) exit 0 ;;
+esac
+EOF
+chmod +x "$BIN/nvidia-smi" "$BIN/docker"
+
+run() {  # run <ours> — echoes the report lines with the current stub payloads
+  ( export PATH="$BIN:$PATH" GPU_ATTR_PROC="$PROC"
+    source "$ROOT_DIR/scripts/lib/gpu-select.sh"
+    gpu_vram_report_lines "$1" )
+}
+
+# --- scenario 1: the #1537 shape — ours on GPU 1, another container's
+# workers on GPUs 0+2, GPU 3 idle -----------------------------------------
+GPUQ=$'0,GPU-A,18500\n1,GPU-B,16200\n2,GPU-C,18300\n3,GPU-D,55' \
+APPQ=$'GPU-A,301,VLLM::Worker_TP0\nGPU-C,301,VLLM::Worker_TP1\nGPU-B,302,sglang::scheduler' \
+DOCKER_PS="$ID_A|vllm-other
+$ID_B|sglang-cmp170hx" \
+run sglang-cmp170hx > "$T/out1" || fail "function returned nonzero"
+L0="$(command grep -m1 'GPU 0 idle VRAM' "$T/out1")"
+L1="$(command grep -m1 'GPU 1 idle VRAM' "$T/out1")"
+L3="$(command grep -m1 'GPU 3 idle VRAM' "$T/out1")"
+[[ "$L0" == *"held by \`vllm-other\`"* ]] || fail "GPU0 must name the other container: $L0"
+[[ "$L0" == *"not \`sglang-cmp170hx\`"* ]] || fail "GPU0 must say it is not ours: $L0"
+[[ "$L1" == *"held by running \`sglang-cmp170hx\`"* ]] || fail "GPU1 must credit our container: $L1"
+[[ "$L1" != *"not \`"* ]] || fail "GPU1 (ours) must not carry a 'not' addendum: $L1"
+[[ "$L3" == *"55 MiB ✓"* ]] || fail "idle card must end with ✓: $L3"
+
+# --- scenario 2: bare host process + in-use card with no owner ------------
+GPUQ=$'0,GPU-A,512\n1,GPU-B,3000' \
+APPQ=$'GPU-A,200,firefox' \
+DOCKER_PS="$ID_A|vllm-other
+$ID_B|sglang-cmp170hx" \
+run sglang-cmp170hx > "$T/out2" || fail "function returned nonzero"
+L0="$(command grep -m1 'GPU 0 idle VRAM' "$T/out2")"
+L1="$(command grep -m1 'GPU 1 idle VRAM' "$T/out2")"
+[[ "$L0" == *"held by \`firefox\`"* ]] || fail "host process must be named: $L0"
+[[ "$L0" != *"not \`"* ]] || fail "host-process line carries no 'not ours': $L0"
+[[ "$L1" == *"⚠ something is using this GPU"* && "$L1" == *"not \`sglang-cmp170hx\`"* ]] \
+  || fail "unowned card with ours set must warn + say not ours: $L1"
+
+# --- scenario 3: host lists NO compute apps -> container's own view -------
+GPUQ=$'0,GPU-A,3000\n1,GPU-B,12000' \
+APPQ= \
+DOCKER_PS="$ID_B|sglang-cmp170hx" \
+DOCKER_EXEC_OUT='GPU-B,100,sglang::scheduler' \
+run sglang-cmp170hx > "$T/out3" || fail "function returned nonzero"
+L0="$(command grep -m1 'GPU 0 idle VRAM' "$T/out3")"
+L1="$(command grep -m1 'GPU 1 idle VRAM' "$T/out3")"
+[[ "$L1" == *"held by running \`sglang-cmp170hx\`"* ]] \
+  || fail "card in our container's own view must be credited to us: $L1"
+[[ "$L0" == *"⚠ something is using this GPU"* && "$L0" == *"not \`sglang-cmp170hx\`"* ]] \
+  || fail "busy card outside our view must warn + say not ours: $L0"
+
+# --- scenario 4: no club container at all (OUR_CONTAINER empty) -----------
+GPUQ=$'0,GPU-A,16000\n1,GPU-B,512\n2,GPU-C,30' \
+APPQ=$'GPU-A,301,VLLM::Worker_TP0\nGPU-B,200,chrome' \
+DOCKER_PS="$ID_A|vllm-other
+$ID_B|sglang-cmp170hx" \
+run "" > "$T/out4" || fail "function returned nonzero"
+L0="$(command grep -m1 'GPU 0 idle VRAM' "$T/out4")"
+L1="$(command grep -m1 'GPU 1 idle VRAM' "$T/out4")"
+L2="$(command grep -m1 'GPU 2 idle VRAM' "$T/out4")"
+[[ "$L0" == *"held by \`vllm-other\`"* && "$L0" != *"not \`"* ]] \
+  || fail "no-ours: name the other container, no 'not' addendum: $L0"
+[[ "$L1" == *"held by \`chrome\`"* ]] || fail "no-ours: host process named: $L1"
+[[ "$L2" == *"30 MiB ✓"* ]] || fail "idle card must end with ✓: $L2"
+
+# --- scenario 5: docker daemon down — cgroup says docker, no ps map -------
+GPUQ=$'0,GPU-A,16000' \
+APPQ=$'GPU-A,301,VLLM::Worker_TP0' \
+DOCKER_INFO_RC=1 \
+run sglang-cmp170hx > "$T/out5" || fail "function returned nonzero"
+L0="$(command grep -m1 'GPU 0 idle VRAM' "$T/out5")"
+[[ "$L0" == *"held by \`VLLM::Worker_TP0\`"* && "$L0" == *"not \`sglang-cmp170hx\`"* ]] \
+  || fail "daemon down: fall back to the process name: $L0"
+
+# the no-smi path needs no external tools (bash builtins only), so a
+# temporarily emptied PATH suffices — no subshell, no hard-coded bash path
+mkdir -p "$T/emptybin"
+_old_path="$PATH"
+PATH="$T/emptybin" out="$(
+  GPU_ATTR_PROC="$PROC"
+  source "$ROOT_DIR/scripts/lib/gpu-select.sh"
+  gpu_vram_report_lines sglang-cmp170hx
+)"
+rc=$?
+PATH="$_old_path"
+[[ $rc -eq 0 && -z "$out" ]] || fail "no nvidia-smi: expected empty output + rc 0, got rc=$rc out='$out'"
+
+echo "PASS: gpu_vram_report_lines attributes each card to its holder (#1537)"
