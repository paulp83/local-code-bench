diff --git a/scripts/lib/gpu-select.sh b/scripts/lib/gpu-select.sh
index ed69318..30bda72 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,133 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# gpu_vram_report_lines [OUR_CONTAINER]
+#   One "- **GPU <index> idle VRAM:** <used> MiB <attribution>" line per GPU —
+#   report.sh's Display section (#1537). Attributes each busy card to the
+#   process that ACTUALLY holds it: the old report credited every card with
+#   >100 MiB in use to the one running club container it found, even when
+#   another container's workers sat on cards that one could not see.
+#   Data: `nvidia-smi --query-gpu=index,uuid,memory.used` +
+#   `--query-compute-apps=gpu_uuid,pid,process_name`. A pid's container comes
+#   from ${GPU_ATTR_PROC:-/proc}/<pid>/cgroup (…/docker-<id>.scope) mapped to
+#   a name through `docker ps` (full ids — that is what the cgroup carries).
+#   When the host lists no compute processes at all (driver-in-VM / WSL-style
+#   rigs), OUR_CONTAINER's own view replaces it: `docker exec <ours>
+#   nvidia-smi …` — under the classic runtime a container sees only its
+#   exposed cards (same UUIDs), so that list IS its placement, and every app
+#   in it runs in our container by construction. OUR_CONTAINER may be empty
+#   (no club container running). Line endings:
+#     ours          … (held by running `<ours>`)
+#     other cont.   … (held by `<other>`[, …][, not `<ours>`])  — + ours if set
+#     host process  … (held by `<process_name>`)
+#     no owner      … ⚠ something is using this GPU [(not `<ours>`)]
+#     idle ≤100 MiB … <N> MiB ✓
+gpu_vram_report_lines() {
+  local our_container="${1:-}"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  local gpus apps
+  gpus="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null)"
+  [[ -n "$gpus" ]] || return 0
+  apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)"
+
+  # container id -> name, from docker ps (--no-trunc: the cgroup scope carries
+  # the FULL id, so short ids would never match)
+  local -a _vram_ids=() _vram_names=()
+  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
+    while IFS='|' read -r _vid _vname; do
+      [[ -n "$_vid" ]] || continue
+      _vram_ids+=("$_vid"); _vram_names+=("$_vname")
+    done < <(docker ps --no-trunc --format '{{.ID}}|{{.Names}}' 2>/dev/null)
+  fi
+
+  # Container-view fallback — ONLY when the host listed no compute processes
+  # at all (driver-in-VM / WSL-style). Any app on this card in OUR_CONTAINER's
+  # own view runs in our container by construction.
+  local cont_apps=""
+  if [[ -z "$apps" && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    cont_apps="$(docker exec "$our_container" nvidia-smi \
+        --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)"
+  fi
+
+  local idx uuid used ours c_list p_list c_disp p_disp
+  local _uuid _pid _name _cg _cid _i _o
+  while IFS=, read -r idx uuid used; do
+    idx="${idx// /}"; uuid="${uuid// /}"; used="${used// /}"
+    [[ "$idx" =~ ^[0-9]+$ ]] || continue
+    if ! [[ "$used" =~ ^[0-9]+$ ]] || [[ "$used" -le 100 ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+      continue
+    fi
+
+    ours=0; c_list=""; p_list=""; c_disp=""; p_disp=""
+    if [[ -n "$apps" ]]; then
+      while IFS=, read -r _uuid _pid _name; do
+        [[ "${_uuid// /}" == "$uuid" ]] || continue
+        # trim surrounding whitespace; the name keeps internal spaces
+        _name="${_name#"${_name%%[![:space:]]*}"}"
+        _name="${_name%"${_name##*[![:space:]]}"}"
+        [[ -n "$_name" ]] || continue
+        # pid -> container: <proc>/<pid>/cgroup carries docker-<id>.scope;
+        # the id maps to a name through docker ps. No cgroup or no match ->
+        # a bare host process (the name is the attribution).
+        _cg=""
+        _o="$_name"
+        if [[ -r "${proc_root}/${_pid}/cgroup" ]]; then
+          _cg="$(command grep -oE 'docker-[0-9a-fA-F]{6,64}\.scope' \
+              "${proc_root}/${_pid}/cgroup" 2>/dev/null | head -1)"
+          if [[ -n "$_cg" ]]; then
+            _cid="${_cg#docker-}"; _cid="${_cid%.scope}"
+            for _i in "${!_vram_ids[@]}"; do
+              if [[ "${_vram_ids[$_i]}" == "$_cid" ]]; then
+                _o="${_vram_names[$_i]}"
+                break
+              fi
+            done
+          fi
+        fi
+        if [[ -n "$our_container" && "$_o" == "$our_container" ]]; then
+          ours=1
+          break
+        fi
+        if [[ -n "$_cg" ]]; then
+          case " ${c_list} " in *" ${_o} "*) : ;;
+            *) c_list="${c_list:+$c_list }${_o}"; c_disp="${c_disp:+$c_disp, }\`${_o}\`" ;;
+          esac
+        else
+          case " ${p_list} " in *" ${_o} "*) : ;;
+            *) p_list="${p_list:+$p_list }${_o}"; p_disp="${p_disp:+$p_disp, }\`${_o}\`" ;;
+          esac
+        fi
+      done <<< "$apps"
+    elif [[ -n "$cont_apps" ]]; then
+      while IFS=, read -r _uuid _pid _name; do
+        [[ "${_uuid// /}" == "$uuid" ]] || continue
+        ours=1
+        break
+      done <<< "$cont_apps"
+    fi
+
+    if [[ $ours -eq 1 ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${our_container}\`)"
+    elif [[ -n "$c_disp" || -n "$p_disp" ]]; then
+      local parts
+      if [[ -n "$c_disp" && -n "$p_disp" ]]; then parts="$c_disp, $p_disp"
+      elif [[ -n "$c_disp" ]]; then parts="$c_disp"
+      else parts="$p_disp"; fi
+      local suffix=""
+      # the "not ours" addendum belongs to container holders and to the
+      # unowned case; a bare host process is named for what it is
+      if [[ -n "$our_container" && -n "$c_disp" ]]; then
+        suffix=", not \`${our_container}\`"
+      fi
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by ${parts}${suffix})"
+    elif [[ -n "$our_container" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (not \`${our_container}\`)"
+    else
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container)"
+    fi
+  done <<< "$gpus"
+}
