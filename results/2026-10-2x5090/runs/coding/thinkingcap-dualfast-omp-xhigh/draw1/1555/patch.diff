+fi
+got="$(URL="http://127.0.0.1:${sgl_port}" python3 "$LIB" --spec-label)"
+kill "$sgl_pid" 2>/dev/null || true
+if [[ "$got" != "MTP n=4" ]]; then
+  fail "SGLang EAGLE n=4 on /get_server_info should print 'MTP n=4' (it read 'spec ?' in #1537): got '$got'"
+fi
+# 3c. --spec-label: nothing when neither source is readable.
+got="$(PATH="$STUB:$PATH" CONTAINER=no-such-container URL=http://127.0.0.1:1 python3 "$LIB" --spec-label)"
+if [[ -n "$got" ]]; then
+  fail "unreadable engine sources should print nothing, got '$got'"
+fi
+# 3d. The shell must read the drafter with --spec-label.
+command grep -q -- '--spec-label' "$PROBE" \
+  || fail "concurrency-probe.sh must read the drafter with --spec-label"
+rm -rf "$STUB"
+echo "  ✓ container by published port + drafter from the engine (vLLM log HEAD, SGLang /get_server_info, nothing when unreadable)"
 
