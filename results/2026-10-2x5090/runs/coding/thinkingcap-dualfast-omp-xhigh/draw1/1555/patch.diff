+# ── which container the probe is hitting, and which drafter is actually
+# ── running (#1537)
+# Both card fields were read from the wrong place: the container came from a
+# `vllm-(qwen|gemma)` NAME heuristic that no SGLang container matches (so the
+# card read "spec ?" and summed VRAM rig-wide), and the drafter came from a
+# grep of the container's `Cmd` — but the Qwen vLLM composes build
+# --speculative-config from SPEC_N inside their entrypoint, so it never appears
+# in `Cmd` (the card read "spec off" with MTP n=4 running). The engine itself
+# knows: vLLM prints the resolved config in its engine-init line, SGLang serves
+# it on /get_server_info.
+
+_VLLM_ENGINE_INIT_RE = re.compile(r"Initializing a V1 LLM engine")
+_SPEC_CONFIG_NONE_RE = re.compile(r"speculative_config=None\b")
+_SPEC_METHOD_RE = re.compile(r"speculative_config=SpeculativeConfig\(method='([^']+)'")
+_SPEC_NUM_RE = re.compile(r"num_spec_tokens=(\d+)")
+
+# vLLM SpeculativeConfig method strings -> card label.
+_SPEC_METHOD_NAMES = {
+    "mtp": "MTP",
+    "dflash": "DFlash",
+    "eagle": "EAGLE",
+    "ngram": "ngram",
+    "medusa": "Medusa",
+    "mlp_speculator": "MLP",
+}
+
+# SGLang /get_server_info speculative_algorithm -> card label. EAGLE over the
+# target's own checkpoint is the in-checkpoint MTP head (our SGLang MTP composes
+# run `--speculative-algorithm EAGLE --speculative-draft-model-path <target>`),
+# so it prints MTP, not EAGLE.
+_SGLANG_ALGO_NAMES = {"EAGLE": "MTP", "EAGLE3": "EAGLE3", "DFLASH": "DFlash"}
+
+# The vLLM engine-init line is among the first lines of a boot; the cap exists
+# only to bound a read of a container that has no such line (SGLang, llama.cpp)
+# on a long uptime, where the log would otherwise be scanned to EOF.
+_LOG_HEAD_LINES = 2000
+
+
+def _url_port(url):
+    """The host port of a URL: its explicit port, else the scheme default."""
+    s = str(url or "").strip()
+    try:
+        p = urllib.parse.urlsplit(s)
+        if p.port:
+            return p.port
+    except ValueError:
+        pass
+    return 443 if s.lower().startswith("https") else 80
+
+
+def container_for_url(url):
+    """Name of the running container that publishes the port of ``url`` (any
+    engine, from `docker ps`), or '' when none does or docker is unavailable.
+    Replaces the container-name heuristic, which found no SGLang container
+    (#1537)."""
+    port = _url_port(url)
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--filter", f"publish={port}", "--format", "{{.Names}}"],
+            capture_output=True, text=True, encoding="utf-8", timeout=10,
+        ).stdout
+    except Exception:
+        return ""
+    for line in out.splitlines():
+        name = line.strip()
+        if name:
+            return name
+    return ""
+
+
+def _vllm_spec_label(container):
+    """The drafter vLLM is actually running, from the `Initializing a V1 LLM
+    engine ... with config: ... speculative_config=...` line at the HEAD of
+    `docker logs` (not the tail: after a long uptime the tail has no memory of
+    the boot, and the engine-init line is one of its first lines).
+    `speculative_config=SpeculativeConfig(method='mtp', ..., num_spec_tokens=4)`
+    prints `MTP n=4`; `speculative_config=None` prints `spec off`. The flag is
+    built from SPEC_N inside the compose entrypoint, so the log is the only
+    readable source for it. None when the line is absent or the log is
+    unreadable."""
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+        )
+    except Exception:
+        return None
+    try:
+        for i, raw in enumerate(proc.stdout):
+            if i >= _LOG_HEAD_LINES:
+                break
+            line = raw.decode("utf-8", "replace")
+            if "speculative_config" not in line or not _VLLM_ENGINE_INIT_RE.search(line):
+                continue
+            if _SPEC_CONFIG_NONE_RE.search(line):
+                return "spec off"
+            m = _SPEC_METHOD_RE.search(line)
+            if not m:
+                continue
+            method = m.group(1)
+            name = _SPEC_METHOD_NAMES.get(method, method.capitalize())
+            n = _SPEC_NUM_RE.search(line)
+            return f"{name} n={n.group(1)}" if n else name
+    except Exception:
+        return None
+    finally:
+        proc.kill()
+    return None
+
+
+def _http_json(url, timeout=5):
+    """GET ``url`` as JSON, or None on any failure (refused, 4xx, not JSON)."""
+    try:
+        with urllib.request.urlopen(url, timeout=timeout) as resp:
+            return json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+
+
+def _sglang_spec_label(url):
+    """The drafter SGLang is actually running, from GET ``<url>/get_server_info``
+    (`speculative_algorithm`, `speculative_num_steps`): EAGLE over the target's
+    own checkpoint prints `MTP n=<steps>`. None when the endpoint is
+    unreachable or the server runs without speculative decoding."""
+    base = str(url or "").strip().rstrip("/")
+    if not base:
+        return None
+    info = _http_json(base + "/get_server_info")
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    if not algo:
+        return None
+    steps = info.get("speculative_num_steps")
+    if steps in (None, ""):
+        steps = info.get("speculative_num_draft_tokens")
+    name = _SGLANG_ALGO_NAMES.get(str(algo).upper(), str(algo).capitalize())
+    return f"{name} n={steps}" if steps not in (None, "") else name
+
+
+def spec_label(container="", url=""):
+    """The drafter actually running, read from the ENGINE — never from the
+    compose's intent. vLLM: its engine-init line (docker logs HEAD). SGLang:
+    GET <url>/get_server_info. '' when neither source is readable."""
+    if container:
+        label = _vllm_spec_label(container)
+        if label:
+            return label
+    if url:
+        label = _sglang_spec_label(url)
+        if label:
+            return label
+    return ""
+
