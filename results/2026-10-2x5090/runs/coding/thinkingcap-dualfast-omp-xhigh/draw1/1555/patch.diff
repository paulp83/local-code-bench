+
+# #1537 (2/3): the card's container and drafter came from the wrong sources. The container
+# was found by a `vllm-(qwen|gemma)` NAME heuristic (no SGLang container matches, so the
+# card read "spec ?" and summed VRAM rig-wide), and the drafter by a grep of the container's
+# Cmd (the Qwen vLLM composes build --speculative-config from SPEC_N inside their entrypoint,
+# so the grep read "spec off" with MTP n=4 running). Both now come from the engine:
+# --container-for-url resolves the container by the port $URL publishes on, and --spec-label
+# reads vLLM's engine-init line (docker logs HEAD) or SGLang's /get_server_info.
+STUB="$(mktemp -d)"
+cat > "$STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  inspect)
+    case "$2" in
+      vllm-mtp-ctr|vllm-off-ctr) echo '[{"HostConfig":{"DeviceRequests":[{"Count":0,"DeviceIDs":["0"]}]},"Config":{"Env":[]},"Cmd":["vllm","serve"]}]' ;;
+      *) echo "Error: No such object: $2" >&2; exit 1 ;;
+    esac ;;
+  ps)
+    [[ "$*" == *"--filter publish=8020"* ]] && echo "sglang-qwen38-27b-mtp-dual"
+    ;;
+  logs)
+    case "$2" in
+      vllm-mtp-ctr) echo "(EngineCore pid=430) INFO 09-26 15:09:32 [core.py:158] Initializing a V1 LLM engine with config: model='/models/qwen3.8-27b', speculative_config=SpeculativeConfig(method='mtp', model=None, num_spec_tokens=4, num_speculativetokens_per_level=None, draft_token_ids=None), ssm_state_dtype=torch.bfloat16" ;;
+      vllm-off-ctr) echo "(EngineCore pid=430) INFO 09-26 15:09:32 [core.py:158] Initializing a V1 LLM engine with config: model='/models/qwen3.8-27b', speculative_config=None, ssm_state_dtype=torch.bfloat16" ;;
+    esac ;;
+esac
+exit 0
+DOCK
+chmod +x "$STUB/docker"
+# 2a. --container-for-url: the container publishing $URL's port, any engine;
+#     nothing when no container does.
+got="$(PATH="$STUB:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+if [[ "$got" != "sglang-qwen38-27b-mtp-dual" ]]; then
+  fail "--container-for-url should find the container publishing :8020 by PORT, not by name: got '$got'"
+fi
+got="$(PATH="$STUB:$PATH" URL=http://localhost:9999 python3 "$LIB" --container-for-url)"
+if [[ -n "$got" ]]; then
+  fail "no container publishes :9999 — the flag should print nothing, got '$got'"
+fi
+# 2b. The shell must resolve CONTAINER from the port (and must not hand-list
+#     container name prefixes).
+command grep -q -- '--container-for-url' "$PROBE" \
+  || fail "concurrency-probe.sh must resolve CONTAINER with --container-for-url"
+command grep -vE '^[[:space:]]*#' "$PROBE" | command grep -q 'vllm-(qwen|gemma)' \
+  && fail "the vllm-(qwen|gemma) name heuristic is back — a container is found by the port it publishes, not its name"
+# 3a. --spec-label, vLLM: the engine-init line at the HEAD of the logs (a dead URL
+#     proves the log is the source, not the endpoint).
+got="$(PATH="$STUB:$PATH" CONTAINER=vllm-mtp-ctr URL=http://127.0.0.1:1 python3 "$LIB" --spec-label)"
+if [[ "$got" != "MTP n=4" ]]; then
+  fail "vLLM with SpeculativeConfig(method='mtp', num_spec_tokens=4) in its log should print 'MTP n=4' (it said 'spec off' in #1537): got '$got'"
+fi
+got="$(PATH="$STUB:$PATH" CONTAINER=vllm-off-ctr URL=http://127.0.0.1:1 python3 "$LIB" --spec-label)"
+if [[ "$got" != "spec off" ]]; then
+  fail "vLLM with speculative_config=None should print 'spec off': got '$got'"
+fi
+# 3b. --spec-label, SGLang: /get_server_info. EAGLE over the target's own
+#     checkpoint is the in-checkpoint MTP head.
+SGL_PORT_FILE="$(mktemp)"
+python3 - "$SGL_PORT_FILE" <<'PY' &
+import http.server, json, socketserver, sys, threading
+
+class H(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        if self.path == "/get_server_info":
+            body = json.dumps({"speculative_algorithm": "EAGLE", "speculative_num_steps": 4}).encode()
+            self.send_response(200)
+            self.send_header("Content-Type", "application/json")
+            self.end_headers()
+            self.wfile.write(body)
+        else:
+            self.send_response(404)
+            self.end_headers()
+    def log_message(self, *args):
+        pass
+
+srv = socketserver.TCPServer(("127.0.0.1", 0), H)
+with open(sys.argv[1], "w") as fh:
+    fh.write(str(srv.server_address[1]))
+threading.Thread(target=srv.serve_forever, daemon=True).start()
+import time
+while True:
+    time.sleep(60)
+PY
+sgl_pid=$!
+for _ in $(seq 50); do
+  if [[ -s "$SGL_PORT_FILE" ]]; then break; fi
+  sleep 0.1
+done
+sgl_port="$(cat "$SGL_PORT_FILE" 2>/dev/null)"
