@@ -25,6 +25,41 @@ from club3090_tui_core.registry import VariantRow
 if TYPE_CHECKING:  # pragma: no cover - annotations only
     from scripts.lib.profiles.model_spec import ModelSpec
 
+# ── Re-exports (PEP 562): the shared compose→spec derivation (#1202 P1) ──────
+# ComposeFacts / _ENGINE_BY_IMAGE / derive_compose_facts moved to
+# scripts/lib/profiles/compose_facts.py — the shared, stdlib-only home, so the
+# CLI (not just this cockpit) can import the compose→spec derivation. This
+# module __getattr__ keeps every existing
+# `from club3090_cockpit.data import ComposeFacts, derive_compose_facts, ...`
+# working unchanged.
+
+_COMPOSE_FACTS_REEXPORTS = ("ComposeFacts", "_ENGINE_BY_IMAGE", "derive_compose_facts")
+
+
+def __getattr__(name: str):
+    if name in _COMPOSE_FACTS_REEXPORTS:
+        try:
+            from scripts.lib.profiles import compose_facts
+        except ModuleNotFoundError:
+            # `scripts` is owned by the repo root, which is not on sys.path when
+            # the cockpit is imported from tools/serve-cockpit/ alone. Repair
+            # it the way __main__.main() does (C3_REPO_ROOT override, else the
+            # root derived from this file's location). Fires only when
+            # `scripts` is unresolvable — never shadows an existing tree.
+            import os
+            import sys
+            from pathlib import Path
+
+            root = (
+                os.environ.get("C3_REPO_ROOT")
+                or str(Path(__file__).resolve().parents[3])
+            )
+            if root not in sys.path:
+                sys.path.insert(0, root)
+            from scripts.lib.profiles import compose_facts
+        return getattr(compose_facts, name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
 # ── Fit verdict ───────────────────────────────────────────────────────────────
 
 
