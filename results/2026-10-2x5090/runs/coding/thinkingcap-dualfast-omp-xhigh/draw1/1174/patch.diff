+def is_tool_unavailable(rc: int, blob: str) -> bool:
+    """True iff a failed rung-1 run is a "the download tool itself is missing"
+    failure — rc 127 (command not found), or the missing-CLI message — as
+    opposed to a hub error the classic path could have retried. Rung 3 (raw
+    resolve + curl) has no dependency on the `hf` CLI, so this kind of
+    failure is fallback-eligible. The too-large refusal is a different
+    escalation trigger, caught by `is_xet_refusal`."""
