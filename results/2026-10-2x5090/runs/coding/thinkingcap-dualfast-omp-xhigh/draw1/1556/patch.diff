+  logs)
+    name=""
+    for a in "\$@"; do case "\$a" in logs|--*) continue ;; esac; [ -n "\$a" ] && name="\$a"; done
+    [ -n "\$name" ] && [ -f "\$stub_dir/logs-\$name" ] && cat "\$stub_dir/logs-\$name" ;;
