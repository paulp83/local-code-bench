+  bash "$PROBE" --sweep --dry --n 1,2,4 2>&1)"
+command grep -qF 'slots=4 (server /get_server_info max_running_requests)' <<<"$out" \
+  || fail "SGLang env-set (no flag in cmd) must label the server-info source, not 'undetected'"
+out="$(PATH="$KV_STUB:$PATH" KV_STUB_DIR="$KV_STUB" URL="http://127.0.0.1:$V1_PORT" MODEL=x \
+  bash "$PROBE" --sweep --dry --n 1,2,4 2>&1)"
+command grep -qF 'slots=8 (container max-num-seqs)' <<<"$out" || fail "vLLM slots source regressed"
+command grep -qF 'KV=551000' <<<"$out" || fail "vLLM card must carry the /metrics pool (was 'KV ?')"
+echo "  ✓ sweep header: slots source label + max-len + KV on both engines"
+
+# 14. the SGLang recommendation speaks SGLang's knob names; vLLM's are no-ops there.
+card="$(python3 "$LIB" --card <<'JSON'
+{
+  "model": "qwen3.8-27b", "slug": "sgl/dual-mtp", "spec": "MTP n=4",
+  "gpus": "2× RTX 3090", "kv_tokens": 548520, "slots": 2,
+  "served_max_len": 262144, "engine": "sglang", "gen_tokens": 256,
+  "cache": "shared 75%", "command": "bash scripts/concurrency-probe.sh --sweep",
+  "rows": [
+    {"ctx": 1024, "n": 1, "strm": 87.3, "agg": 87, "ttft_s": 0.1, "vram_gb": 38.2, "clean": 1, "pass": 1, "skip": null},
+    {"ctx": 1024, "n": 2, "strm": 61.0, "agg": 122, "ttft_s": 0.4, "vram_gb": 39.8, "clean": 1, "pass": 1, "skip": null},
+    {"ctx": 16384, "n": 1, "strm": 87.3, "agg": 87, "ttft_s": 0.8, "vram_gb": 38.2, "clean": 1, "pass": 1, "skip": null},
+    {"ctx": 16384, "n": 2, "strm": 51.8, "agg": 104, "ttft_s": 1.4, "vram_gb": 39.1, "clean": 1, "pass": 1, "skip": null}
+  ]
+}
+JSON
+)"
+command grep -qF 'MAX_RUNNING_REQUESTS=2' <<<"$card" || fail "SGLang rec must say MAX_RUNNING_REQUESTS (SGLang's knob)"
+command grep -qF 'CONTEXT_LENGTH=<keep 262K>' <<<"$card" || fail "SGLang rec must keep CONTEXT_LENGTH (SGLang's knob)"
+command grep -qF 'served context-length=262K' <<<"$card" || fail "SGLang rec must label the served context-length"
+command grep -q 'MAX_NUM_SEQS' <<<"$card" && fail "SGLang rec must not name MAX_NUM_SEQS (ignored by SGLang composes)"
+command grep -q 'MAX_MODEL_LEN' <<<"$card" && fail "SGLang rec must not name MAX_MODEL_LEN (ignored by SGLang composes)"
+echo "  ✓ SGLang recommendation uses MAX_RUNNING_REQUESTS / CONTEXT_LENGTH"
+
+for pid in "$SGL_A_PID" "$SGL_B_PID" "$SGL_TP_PID" "$V1_PID" "$V2_PID"; do
+  kill "$pid" 2>/dev/null || true
+done
+for pid in "$SGL_A_PID" "$SGL_B_PID" "$SGL_TP_PID" "$V1_PID" "$V2_PID"; do
+  wait "$pid" 2>/dev/null || true
+done
+rm -rf "$KV_STUB"
+
 echo "test-concurrency-probe: ok"
