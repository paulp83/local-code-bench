+# Parent dir names that do NOT identify a patch (a file directly under
+# ``patches/`` is identified by the file's own name, a repo script under
+# ``scripts/lib/`` by its own name, and so on).
+_NON_IDENTIFYING_PARENTS = {"patches", "local", "lib", "scripts", "bin", "cache"}
+
+
+def _spec_source_markers(patch: dict) -> list[str]:
+    """Path fragments that identify THIS patch's OWN artifacts in the
+    SOURCE position of a compose bind-mount line (``<src>:<dst>``).
+
+    A fragment is the last two (and, where the path is longer, last three)
+    components of one of the patch's source paths — e.g.
+    ``patches/vllm-effort-budget`` or ``fa2-fp8kv-sm86/install.sh``.
+    Those are the identifying units of a club-3090 mount: the patch's own
+    directory (install-script composes mount the whole directory, never
+    the individual file) or the patch's own vendored file. Deliberately
+    never:
+
+    * the parent directory's name alone (``patches``) — every compose that
+      mounts ANY patch contains it;
+    * a bare generic filename (``install.sh``, ``apply.py``) — every
+      compose that runs ANY installer contains it;
+    * the in-container target (``/etc/club3090/...``) — a DIFFERENT patch
+      can be mounted at the same target (the vLLM and SGLang W4A8 patches
+      both use ``/etc/club3090/w4a8``), so the target cannot tell them
+      apart.
+
+    For a file entry the PARENT directory's fragments are included too (a
+    compose mounts the patch directory the file lives in), unless the
+    parent is one of the non-identifying names above.
+    """
+    spec = patch.get("delivery_spec") or {}
+    rels: list[str] = [str(rel) for rel in patch.get("files") or []]
+    for key in ("script", "jinja", "sidecar"):
+        val = spec.get(key)
+        if val:
+            rels.append(str(val))
+    for of in spec.get("overlay_files") or []:
+        src = of.get("src")
+        if src:
+            rels.append(str(src))
+
+    markers: list[str] = []
+    for rel in rels:
+        parts = Path(rel).parts
+        if len(parts) >= 2:
+            markers.append("/".join(parts[-2:]))
+        if len(parts) >= 3:
+            markers.append("/".join(parts[-3:]))
+        parent = Path(rel).parent
+        if parent.parts and parent.name not in _NON_IDENTIFYING_PARENTS:
+            pp = parent.parts
+            if len(pp) >= 2:
+                markers.append("/".join(pp[-2:]))
+            if len(pp) >= 3:
