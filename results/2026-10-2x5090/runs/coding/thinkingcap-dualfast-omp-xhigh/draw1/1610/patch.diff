+def _spec_mount_wired(patch: dict, body: str, vol_markers: list[str]) -> bool:
+    """True iff ``body`` carries a bind-mount line whose SOURCE identifies
+    THIS patch and whose in-container target is the one the spec declares.
+
+    The declared target alone is NOT sufficient: a different patch can be
+    mounted at the same in-container target (the vLLM and SGLang W4A8
+    patches both use ``/etc/club3090/w4a8``), so the line's SOURCE must
+    identify this patch (a fragment from :func:`_spec_source_markers`) and
+    must sit in the source position — before the target on the line, where
+    Compose always puts it. A target-less spec (declared install script,
+    no ``mounted_at``) is satisfied by any mount line whose source
+    identifies the patch. Only list-item (``- …``) lines count, so an
+    entrypoint echo of a repo path can never read as a mount.
+    """
+    sources = _spec_source_markers(patch)
+    if not vol_markers and not sources:
+        return False
+    if not sources:
+        return any(marker in body for marker in vol_markers)
+    for line in body.splitlines():
+        if not line.lstrip().startswith("- "):
+            continue
+        tpos = -1
+        if vol_markers:
+            target = next((m for m in vol_markers if m in line), None)
+            if target is None:
+                continue
+            tpos = line.find(target)
+        for marker in sources:
+            mpos = line.find(marker)
+            if mpos >= 0 and (tpos < 0 or mpos <= tpos):
+                return True
+    return False
+
