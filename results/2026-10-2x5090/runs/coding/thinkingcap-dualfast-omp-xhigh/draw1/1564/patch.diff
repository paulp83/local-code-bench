+def _engine_ids_in(root: Path, rel: str) -> set[str]:
+    """The engine ids defined by the ``*.yml`` files under <root>/<rel>.
+
+    compat keys engine profiles by the YAML ``id`` field, NOT the file name
+    (``llama-cpp-mainline.yml`` carries id ``llama-cpp-local``), so scan for
+    the top-level ``id:`` line rather than matching stems. A file whose id
+    line is missing or unparseable contributes nothing — it cannot prove its
+    id is taken."""
+    ids: set[str] = set()
+    d = root / rel
+    if not d.is_dir():
+        return ids
+    for path in sorted(d.glob("*.yml")):
+        try:
+            for line in path.read_text(encoding="utf-8").splitlines():
+                if line.startswith("id:"):
+                    val = line[3:].strip().strip("\"'")
+                    if val:
+                        ids.add(val)
+                    break
+        except OSError:
+            continue
+    return ids
+
+
