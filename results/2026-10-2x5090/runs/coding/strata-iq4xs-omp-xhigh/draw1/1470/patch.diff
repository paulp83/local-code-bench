diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..9149555 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,41 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ #1462 follow-up, PCIe rigs: SGLang admits CustomAllReduceV2 only on a FULL
+# NVLink (can_use_custom_all_reduce_v2 → full_nvlink), so every PCIe rig runs the
+# V1 CustomAllreduce — which logs NOTHING at init. Its only success signal is the
+# rank-0 line after CUDA-graph capture (register_graph_buffers early-returns when
+# the kernel is disabled, so the line implies it is live). Before this fix such a
+# healthy boot scored "unknown" — report.sh and the bench card said "no P2P
+# engagement signal" and it could never score on.
+# Real wording: sglang/srt/distributed/device_communicators/custom_all_reduce.py.
+_sgl_v1=$(cat <<'EOF'
+[2026-10-11 03:14:07] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-11 03:14:12 TP0] sglang is using nccl==2.30.7
+[2026-10-11 03:15:03 TP0] Registering 4352 cuda graph addresses
+EOF
+)
+_ev1="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev1" "Registering 4352 cuda graph addresses"
+r="$(printf '%s\n' "$_ev1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"   # unfiltered stream too
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 PCIe boot -> on (got $r)"
+# The restart-epoch rules apply to a V1 success as well: a later operator-disabled
+# restart must not inherit the earlier boot's registration line…
+r="$(printf '%s\n%s' "$_ev1" "[sglang] BOOT disable_custom_all_reduce=True" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator-disabled restart must beat an earlier V1 registration (got $r)"
+# …and a stale registration must not mask a latest boot with no AR evidence.
+r="$(printf '%s\n%s' "$_ev1" "[sglang] BOOT disable_custom_all_reduce=False" | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "later boot with no AR evidence stays unknown, not a stale on (got $r)"
+# An engine veto outranks success wording inside the current boot slice: the two
+# cannot co-occur (registration implies live), so if one ever did, the safe read
+# is nccl_only — never on.
+r="$(printf '%s\n%s\n%s' '[sglang] BOOT disable_custom_all_reduce=False' "CustomAllreduce is disabled because it's not supported on more than two PCIe-only GPUs." 'Registering 4352 cuda graph addresses' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_gated" ]] || fail "same-slice veto must outrank a registration line (got $r)"
+unset _sgl_v1 _ev1
+echo "  ✓ SGLang V1 (PCIe): graph-buffer registration scores custom-AR on; epoch + veto precedence preserved"
+
