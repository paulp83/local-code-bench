+def container_gpu_ids(container):
+    """GPU ids CONTAINER can see; [] = every GPU / unresolvable (rig-wide).
+
+    The two ways docker exposes GPUs, in resolution order:
+      * HostConfig.DeviceRequests[].DeviceIDs — set by `--gpus '"device=3"'`
+      * Config.Env NVIDIA_VISIBLE_DEVICES / CUDA_VISIBLE_DEVICES — the
+        nvidia-container-runtime path most composes take
+    "all" / "void" / empty mean the container sees every GPU, i.e. there is
+    nothing to scope to. Without this resolution the probe attributed the
+    whole rig's memory and card names to the service under test (a 12 GB
+    RTX 3060 read as 55 GB on 4× RTX 3090 on a shared box).
+    """
+    if not container:
+        return []
+    dev = _docker_inspect_fmt(
+        container,
+        "{{range .HostConfig.DeviceRequests}}{{range .DeviceIDs}}{{.}},{{end}}{{end}}",
+    )
+    ids = [x.strip() for x in dev.strip().strip(",").split(",") if x.strip()]
+    if ids:
+        return ids
+    env = _docker_inspect_fmt(container, "{{range .Config.Env}}{{println .}}{{end}}")
+    vis = {}
+    for line in env.splitlines():
+        for var in ("NVIDIA_VISIBLE_DEVICES", "CUDA_VISIBLE_DEVICES"):
+            if line.startswith(var + "="):
+                vis[var] = line.split("=", 1)[1].strip()
+    for var in ("NVIDIA_VISIBLE_DEVICES", "CUDA_VISIBLE_DEVICES"):
+        v = vis.get(var, "")
+        if not v or v.lower() in ("all", "void"):
+            continue
+        ids = [x.strip() for x in v.split(",") if x.strip()]
+        if ids:
+            return ids
+    return []
+
