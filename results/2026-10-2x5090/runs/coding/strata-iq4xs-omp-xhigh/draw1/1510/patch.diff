+    Scoped to `gpus` when given, rig-wide otherwise. Returns (-1, []) when
+    nvidia-smi cannot answer — callers treat -1 as unknown, as before.
+    """
+    rows = _nvidia_smi_rows(("index", "name", "memory.used"), gpus)
+    cards = []
+    for idx, name, used in rows:
+        try:
+            cards.append((idx, name, int(used)))
+        except ValueError:
+            return -1, []
+    if not cards:
+        return -1, []
+    return sum(c[2] for c in cards), cards
