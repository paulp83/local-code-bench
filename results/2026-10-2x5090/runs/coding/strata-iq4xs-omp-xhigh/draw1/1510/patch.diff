+# 11. --sweep must SURVIVE skipped cells (emit_row stdin bug).
+#     emit_row ran `python3 - <<'PY'` — python reads its PROGRAM from stdin, so
+#     the heredoc swallowed the piped row: json.loads("") raised and set -e
+#     killed the sweep at the first skip, before the card, the
+#     `=== recommend ===` block and results/concurrency-*.{md,json} were
+#     written. The row must travel as ARGV. All three skip paths (clipped /
+#     early-stop / budget) are driven here with NO GPU and NO server: the
+#     cell probe is stubbed by putting a fake python3 on PATH that answers a
+#     bare `python3 $PROBE_PY` (one arg = a cell run) with a failing RESULT
+#     line and execs the real interpreter for everything else.
+command grep -q '| emit_row' "$PROBE" \
+  && fail "a pipe into emit_row reintroduces the stdin-swallow crash (#246 sibling)"
+command grep -q 'json.loads(sys.argv\[2\])' "$PROBE" \
+  || fail "emit_row must json.loads the ROW from argv, not stdin"
