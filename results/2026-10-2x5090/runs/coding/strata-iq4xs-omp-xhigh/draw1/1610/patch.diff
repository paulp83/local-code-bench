+def _source_identity_tokens(patch: dict, root: Path) -> set[str]:
+    """Names that identify THIS patch as the SOURCE side of a mount.
+
+    Derived from the patch id plus its declared source paths (``files``
+    and the spec's ``script``/``sidecar``): a directory entry contributes
+    its own basename (e.g. ``vllm-effort-budget``), a file entry its
+    containing patch-directory basename (``fa2-fp8kv-sm86``) and its
+    filename. :data:`GENERIC_SOURCE_NAMES` entries are dropped — the
+    patch directory's OWN name (or the id) is the identifying token, not
+    the ``patches`` grandparent or a bare ``install.sh``.
+    """
+    tokens: set[str] = set()
+    if patch.get("id"):
+        tokens.add(str(patch["id"]))
+    paths = [str(rel) for rel in patch.get("files") or []]
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "sidecar"):
+        if spec.get(key):
+            paths.append(str(spec[key]))
+    for rel in paths:
+        p = Path(rel)
+        candidates = [p.name] if (root / rel).is_dir() else [p.parent.name, p.name]
+        for tok in candidates:
+            if tok and tok not in GENERIC_SOURCE_NAMES:
+                tokens.add(tok)
+    return tokens
+
