+def _mount_source_present(patch: dict, root: Path, body: str) -> bool:
+    """True iff some body line pairs a declared mount TARGET with one of
+    this patch's source-identity tokens (``…<src>/<patch-dir>:<dest>``).
+
+    Patches with no declared volume marker (pure invoke wiring, e.g. a
+    python_sidecar mounted and run by basename) trivially pass — there
+    is no target to confuse. A compose that bind-mounts a DIFFERENT
+    patch at this patch's declared target has the target line but never
+    this patch's source token on it, and correctly does NOT reach.
+    """
+    vol_markers, _ = _spec_wiring_markers(patch)
+    if not vol_markers:
+        return True
+    tokens = _source_identity_tokens(patch, root)
+    if not tokens:
+        return True
+    for line in body.splitlines():
+        if any(m in line for m in vol_markers) and any(t in line for t in tokens):
+            return True
+    return False
+
+
+def _legacy_entrypoint_invoke_reaches(patch: dict, root: Path, body: str) -> bool:
+    """Legacy ``delivery.entrypoint_invoke`` fallback, marker-sound.
