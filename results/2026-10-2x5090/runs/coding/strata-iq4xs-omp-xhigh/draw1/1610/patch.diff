+# (6) Install-script (delivery.entrypoint_invoke) patches: an UNWIRED
+#     compose must report NOT-reached. The legacy fallback used to answer
+#     True for every compose that mounts any patch dir (its markers were
+#     the "patches" grandparent of a dir entry and bare filenames like
+#     install.sh), so stripping a patch's mount + invoke from a compose
+#     was undetectable. Controls per install-script patch (synthetic
+#     fixtures, no docker needed):
+#       full    — mount + invoke present            -> reaches (positive)
+#       stripped— this patch's mount + invoke gone, a DECOY install-script
+#                 patch still mounted (body keeps the "patches" and
+#                 "install.sh" strings that defeated the old fallback)
+#                                                       -> must NOT reach
+#       swapped — a DIFFERENT patch mounted at this patch's target with
+#                 the invoke kept (the sound spec check matches the
+#                 target alone; only source identity catches this)
+#                                                       -> must NOT reach
+#     Plus a legacy-only control: entries WITHOUT any delivery_spec still
+#     reach by their patch-dir name, but not by "patches"/"install.sh".
+decoy_mount = "      - ../../../patches/decoy-other-patch:/etc/club3090/decoy-patch:ro\n"
+decoy_entry = (
+    "    entrypoint:\n"
+    "      - /bin/bash\n"
+    "      - -c\n"
+    "      - |\n"
+    "        bash /etc/club3090/decoy-patch/install.sh\n"
+)
+install_script_patches = [
+    p for p in patches
+    if (p.get("delivery") or {}).get("entrypoint_invoke")
+    and p.get("delivery_mechanism") == "install_script"
+    and (p.get("delivery_spec") or {}).get("mounted_at")
+]
+for patch in install_script_patches:
+    spec = patch["delivery_spec"]
+    mounted = spec["mounted_at"]
+    src_dir = Path(spec.get("script") or patch["id"]).parent.name
+    inv = spec.get("invoke") or ""
+    inv_line = f"        {inv} || exit 1\n" if "/" in inv else ""
+    with tempfile.TemporaryDirectory() as _td2:
+        _tdp2 = Path(_td2)
+        full = _tdp2 / "full.yml"
+        full.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ../../../patches/{src_dir}:{mounted}:ro\n"
+            + decoy_mount + decoy_entry + inv_line +
+            "        exec vllm-serve --model m\n",
+            encoding="utf-8",
+        )
+        stripped = _tdp2 / "stripped.yml"
+        stripped.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            + decoy_mount + decoy_entry +
+            "        exec vllm-serve --model m\n",
+            encoding="utf-8",
+        )
+        swapped = _tdp2 / "swapped.yml"
+        swapped.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            f"      - ../../../patches/decoy-other-patch:{mounted}:ro\n"
+            + decoy_mount + decoy_entry + inv_line +
+            "        exec vllm-serve --model m\n",
+            encoding="utf-8",
+        )
+        if not pa.reaches(root, patch, str(full)):
