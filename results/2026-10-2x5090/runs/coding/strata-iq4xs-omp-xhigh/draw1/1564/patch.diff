+# The YAML catalog.sh derives for an engine the catalog does not know (shape
+# mirrored from its output: id / display_name / type / stability / min_sm).
+_ENGINE_YAML = (
+    "schema_version: 1\n"
+    "id: their-engine\n"
+    "display_name: their-engine (local, registered from a compose)\n"
+    "type: llama.cpp\n"
+    "stability: experimental\n"
+    "min_sm: '8.6'\n"
+)
+
+
+class TestLocalEngineProfile:
+    """`local_engine_profile` carries the YAML of a NEW engines.d/<engine>.yml
+    IN THE SPEC, so the write goes through promote's plan / --dry-run / confirm.
+    catalog.sh used to write that file itself BEFORE promote ever ran — so every
+    `register --dry-run` leaked it, and a test could only "prove" the round
+    trip's engine-profile check on that leak."""
+
+    _BYO_SLUG = "their-engine/my-model-dual-autoround-int4"
+
+    def test_dry_run_plans_the_engine_profile_and_writes_nothing(self, root):
+        spec = _spec(slug=self._BYO_SLUG)
+        spec["local_engine_profile"] = _ENGINE_YAML
+        res = _run_cli(root, spec, "--layer", "local", "--dry-run")
+        assert res.returncode == 0, res.stderr + res.stdout
+        assert "engines.d/their-engine.yml (new local ENGINE profile)" in res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+        for rel in LOCAL_ARTIFACTS:
+            assert not (root / rel).exists(), rel
+
+    def test_real_write_lands_the_engine_profile(self, root):
+        spec = _spec(slug=self._BYO_SLUG)
+        spec["local_engine_profile"] = _ENGINE_YAML
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == 0, res.stderr + res.stdout
+        ep = root / "scripts/lib/profiles-local/engines.d/their-engine.yml"
+        assert ep.read_text(encoding="utf-8") == _ENGINE_YAML
+
+    def test_without_the_key_no_engines_d_is_created(self, root):
+        res = _run_cli(root, _spec(), "--layer", "local")
+        assert res.returncode == 0, res.stderr + res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_bad_shape_refuses_before_any_write(self, root):
+        spec = _spec(slug=self._BYO_SLUG)
+        spec["local_engine_profile"] = "   "
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "local_engine_profile" in res.stderr
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+        for rel in LOCAL_ARTIFACTS:
+            assert not (root / rel).exists(), rel
+
+    def test_core_layer_refuses_the_key(self, root):
+        # engines.d lives in the gitignored profiles-local/ — a CORE write may
+        # not reach into it, same containment rule as compose.path.
+        spec = _spec(layer_local=False)
+        spec["local_engine_profile"] = _ENGINE_YAML
+        res = _run_cli(
+            root, spec, "--layer", "core",
+            env_extra={"C3_ALLOW_CORE_PROMOTE": "1"},
+        )
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "local_engine_profile" in res.stderr
+        assert not (root / "scripts/lib/profiles-local").exists()
+
+
