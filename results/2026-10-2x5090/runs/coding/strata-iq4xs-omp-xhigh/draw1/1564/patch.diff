-# 2b. arch is REQUIRED and must be refused BEFORE the write — promote reads it
+# 2a. the dry-run PLAN must list the engine-profile write — the write moved
+# into promote.py (spec key `local_engine_profile`), which owns the plan,
+# the --dry-run exit and the confirm.
+[[ "$out" == *"engines.d/their-engine.yml (new local ENGINE profile)"* ]] \
+  || { echo "  FAIL dry-run plan does not list the engine profile write"; rc=1; }
+
+# 2b. and the dry-run must have written NOTHING under the local layer — no
+# engines.d, no models.d, no compose, no registry row. (README/.gitignore ride
+# in with the `cp -r scripts/lib` above; they are the layer's baseline.) This
+# check sits between the dry runs above and the round trip below precisely
+# because the round trip used to be able to pass on files the dry runs leaked.
+leaked="$(find "$TMP/scripts/lib/profiles-local" -type f 2>/dev/null \
+          -not -name README.md -not -name .gitignore)"
+if [[ -n "$leaked" ]]; then
+  echo "  FAIL --dry-run wrote local-layer files:"; echo "$leaked"; rc=1
+else
+  echo "  ok   --dry-run wrote nothing (no engines.d leak)"
+fi
+
+# 2c. arch is REQUIRED and must be refused BEFORE the write — promote reads it
 # with .get, so a missing arch passes its validation and then dies in the
 # post-write re-check, leaving the layer written and broken ("NO ROLLBACK").
 out="$(scripts/catalog.sh register --compose "$C" --engine their-engine --engine-type llama.cpp --root "$TMP" --dry-run -y 2>&1)"; code=$?
