 pass "soak: the container's own URL → that container (positive control)"
 
+
+# ---------------------------------------------------------------------------
+echo "--- 4. concurrency-probe.sh picks its container the same way (#1584 follow-up) ---"
+# The probe reads CONTAINER for the slot count (served-slots.sh inspects it FIRST), the GPU
+# label, the spec label and the KV pool. Repro from the issue: a local vLLM on :8020 at
+# --max-num-seqs 4 made URL=http://10.9.9.9:8020 announce "CONCURRENCY=4 (detected: container
+# max-num-seqs)" — the port-only python matcher compared the port and ignored the host, and
+# the vllm-(qwen|gemma) name fallback bound one even when nothing matched. Both are gone;
+# the probe asks club_container_for_url, which checks the URL's HOST against the publish
+# address. curl never answers, so both legs stop at the slot detection — the assertion is at
+# the docker layer (like the soak leg above), not in the probe's exit code.
+sbin2="$tmp/sbin2"; mkdir -p "$sbin2"
+cat > "$sbin2/docker" <<'EOF'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >> "$MOCK_LOG"
+case "$1" in
+  ps)      printf '%s\n' "vllm-mock|0.0.0.0:8020->8000/tcp|vllm/vllm-openai:v0" ;;
+  inspect) [[ "$*" == *"Config.Cmd"* ]] && echo "" ;;   # no flags: detection ends at the URL
+esac
+exit 0
+EOF
+printf '#!/usr/bin/env bash\nexit 7\n' > "$sbin2/curl"
+chmod +x "$sbin2"/*
+probe4() {   # probe4 URL → the run's output; docker calls land in $tmp/probe-docker.log
+  : > "$tmp/probe-docker.log"
+  PATH="$sbin2:$PATH" MOCK_LOG="$tmp/probe-docker.log" URL="$1" \
+    CONCURRENCY_PROBE_RECORD=0 timeout 120 bash scripts/concurrency-probe.sh 2>&1 || true
+}
+out="$(probe4 http://10.9.9.9:8020)"
+command grep -q "cannot detect the served slot count" <<<"$out" \
+  || { printf '%s\n' "$out" >&2; fail "probe: a remote URL must fall back to the endpoint, not bind the local container"; }
+if command grep -qE "CONCURRENCY=[0-9]" <<<"$out"; then fail "probe: a remote URL announced a slot count: $out"; fi
+if command grep -q "inspect.*vllm-mock" "$tmp/probe-docker.log"; then fail "probe: a remote URL inspected the local container"; fi
+pass "probe: remote URL → local container never bound, no slot count inherited"
+out="$(probe4 http://localhost:8020)"
+command grep -q "inspect.*vllm-mock" "$tmp/probe-docker.log" \
+  || fail "probe: the serving container was not inspected — the remote leg proves nothing"
+
+pass "probe: the container's own URL → that container (positive control)"
 echo "test-preflight-autodetect: ok"
