index 0000000..bfd5d74
--- /dev/null
+++ b/scripts/lib/profiles/amend.py
@@ -0,0 +1,400 @@
+#!/usr/bin/env python3
+"""Local-layer AMENDMENT — rename a slug or edit a field, in place (#1202 P7).
+
+promote.py creates local entries; demote.py removes them. Between those two
+endpoints the layer was create-and-delete only: change ONE field meant demote +
+re-promote, and — worse — #1204 decided that a local slug shadowed by a newly
+shipped curated slug is kept and MARKED "so the user can rename it", but no
+rename existed. The remedy switch.sh and BRING_YOUR_OWN.md advertised could not
+be reached. This closes that gap:
+
+    python3 scripts/lib/profiles/amend.py rename --slug OLD --to NEW
+    python3 scripts/lib/profiles/amend.py update --slug SLUG --set KEY=VALUE
+
+The ONLY file that makes a slug exist is
+``scripts/lib/profiles-local/registry.local.json``, and that is the only file
+either subcommand writes. The model profile (``models.d/<id>.yml``) and the
+compose tree (``composes/<id>/…``) are addressed by MODEL ID, not by slug, so
+they survive a rename untouched — and ``compose_path`` keeps pointing at a
+file that is still there.
+
+CORE IS NEVER TOUCHED — twice over. The write target does not exist under
+``scripts/lib/profiles/``, and the same location-based guard demote.py uses
+refuses a slug absent from ``registry.local.json`` BEFORE anything else is
+read: a curated slug can never appear in the only file this tool writes. On
+the rename side the mirror rule matters too: renaming ONTO a curated slug is
+refused, because the collision that shadowing created must not be recreatable
+with a single command.
+
+An entry's ``engine`` field IS its slug's namespace (that is what every
+launcher resolves in ``profiles.engines[engine]`` and what
+``load_local_registry`` merges consumers rely on), so rename rewrites
+``engine`` alongside the key and refuses a destination whose namespace is not
+a known engine — a slug nothing can boot is how you ship an unreachable entry.
+
+``origin`` is NOT editable: provenance is stamped by the loader
+(``load_local_registry`` injects ``origin="local"`` and refuses a raw entry
+that self-declares it), and publishing later flips a field in the CURATED
+catalog, never a user edit here.
+
+Exit codes match promote.py / demote.py: 0 success, 3 refusal (nothing
+written), 2 internal failure after the write started.
+
+Success markers (the c3 parser hook, same shape as PROMOTE_OK / DEMOTE_OK)::
+
+    RENAME_OK <old> -> <new>
+    UPDATE_OK <slug>
+"""
+
+from __future__ import annotations
+
+import argparse
+import inspect
+import json
+import os
+import re
+import sys
+from pathlib import Path
+from typing import Optional
+
+_HERE = Path(__file__).resolve()
+_DEFAULT_ROOT = _HERE.parents[3]
+
+_LOCAL_REGISTRY_REL = "scripts/lib/profiles-local/registry.local.json"
+_LOCAL_ENGINES_REL = "scripts/lib/profiles-local/engines.d"
+_CORE_ENGINES_REL = "scripts/lib/profiles/engines"
+
+EXIT_COLLISION = 3
+EXIT_INTERNAL = 2
+
+# Same slug shape promote.py writes and load_local_registry refuses anything
+# else on. Duplicated deliberately: importing promote.py would drag its
+# spec-validation surface in for one regex.
+_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$")
+# Engine profile YAMLs carry `id: <name>` (the file STEM can differ from the
+# id — llama-cpp-mainline.yml declares `id: llama-cpp-local`), so read the id.
+# Stdlib-only regex by design: the launcher table path must not need PyYAML.
+_ENGINE_ID_RE = re.compile(r"(?m)^id:[ \t]*([^\s#]+)[ \t]*(?:#.*)?$")
+
+
+class Refusal(Exception):
+    """A collision / bad-shape refusal → exit 3, nothing written."""
+
+
+class InternalError(Exception):
+    """A post-refusal write failure → exit 2, state may need a fix."""
+
+
+def _info(msg: str) -> None:
+    print(f"[amend] {msg}", file=sys.stderr)
+
+
+def _load_local_raw(root: Path) -> dict:
+    """The RAW registry.local.json dict ({} when absent). Bad JSON is a
+    refusal — we never rewrite a file we cannot parse."""
+    path = root / _LOCAL_REGISTRY_REL
+    if not path.exists():
+        return {}
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise Refusal(f"{path} is unreadable — fix or remove it first: {exc}")
+    if not isinstance(raw, dict):
+        raise Refusal(f"{path}: expected a JSON object of {{slug: kwargs}}")
+    return raw
+
+
+def _core_registry(root: Path):
+    """The curated registry MODULE (COMPOSE_REGISTRY + _entry) read from the
+    root we operate on. FAIL-CLOSED: the core-safety checks (is OLD curated?
+    is NEW a curated name? are these still valid _entry kwargs?) all need it,
+    so an unloadable catalog refuses rather than proceeding blind."""
+    sys.path.insert(0, str(root))
+    try:
+        import scripts.lib.profiles.compose_registry as cr
+        return cr
+    except Exception as exc:
+        raise Refusal(
+            f"the curated catalog (compose_registry.py) cannot be read from "
+            f"{root}: {exc}. Refusing — without it the curated-safety checks "
+            f"cannot be made."
+        )
+
+
+def _known_engines(root: Path) -> set:
+    """Every engine id the catalog resolves: core ``engines/*.yml`` plus the
+    local layer's ``engines.d/*.yml`` (a user's own build lives there after
+    catalog.sh register wrote its profile). Keyed by the profile's ``id``,
+    which is exactly what ``profiles.engines[engine]`` boots from."""
+    ids: set = set()
+    for rel in (_CORE_ENGINES_REL, _LOCAL_ENGINES_REL):
+        d = root / rel
+        if not d.is_dir():
+            continue
+        for yml in sorted(d.glob("*.yml")):
+            try:
+                text = yml.read_text(encoding="utf-8", errors="replace")
+            except OSError:
+                continue
+            m = _ENGINE_ID_RE.search(text)
+            ids.add(m.group(1) if m else yml.stem)
+    return ids
+
+
+def _require_local_slug(raw: dict, cr, slug: str) -> None:
+    """Location-based core guard (same rule demote.py uses): a slug absent
+    from registry.local.json is refused BEFORE anything is read or written —
+    it fails closed, and a curated slug can never be in the only file we write.
+    The curated/typo distinction only shapes the message."""
+    if slug in raw and isinstance(raw[slug], dict):
+        return
+    if slug in raw:
+        raise Refusal(
+            f"{slug}'s entry in {_LOCAL_REGISTRY_REL} is not an object — "
+            f"fix the JSON before amending it"
+        )
+    if slug in cr.COMPOSE_REGISTRY:
+        raise Refusal(
+            f"{slug!r} is a CURATED catalog entry, not a local one. This tool "
+            f"only amends the local layer; a curated entry is git-tracked and "
+            f"git is its editing tool."
+        )
+    known = ", ".join(sorted(raw)) or "(none registered)"
+    raise Refusal(f"{slug} is not in {_LOCAL_REGISTRY_REL}. Registered: {known}")
+
+
+def _parse_value(text: str):
+    """`--set k=v` values arrive as strings; JSON-parse first so numbers,
+    booleans and null land with their real types (`max_ctx=8192` must not
+    become the string "8192"). Anything non-JSON is an honest string."""
+    try:
+        return json.loads(text)
+    except ValueError:
+        return text
+
+
+def _write_registry(root: Path, raw: dict) -> None:
+    """Atomic rewrite: temp sibling + os.replace, so a failed encode/dump
+    leaves the working registry intact (#777/#780 lesson — never truncate a
+    file that matters before you know the new bytes are good)."""
+    reg = root / _LOCAL_REGISTRY_REL
+    tmp = reg.with_name(reg.name + ".tmp")
+    try:
+        tmp.write_text(
+            json.dumps(raw, indent=2, ensure_ascii=False) + "\n",
+            encoding="utf-8",
+        )
+        os.replace(tmp, reg)
+    except OSError as exc:
+        try:
+            tmp.unlink()
+        except OSError:
+            pass
+        raise InternalError(f"could not rewrite {reg}: {exc}")
+
+
+def _describe(changes: list) -> str:
+    return "\n".join(f"[amend]   {c}" for c in changes)
+
+
+def rename_local(root: Path, old: str, new: str, *, dry_run: bool = False) -> Optional[str]:
+    """Move a local entry's slug, keeping `engine` == the new namespace.
+    Returns the success marker, or None for dry-run / no-op."""
+    raw = _load_local_raw(root)
+    cr = _core_registry(root)
+    _require_local_slug(raw, cr, old)
+
+    if new == old:
+        _info(f"{old} is already named that — nothing to do")
+        return None
+    if not _SLUG_RE.match(new):
+        raise Refusal(
+            f"new slug {new!r} must be '<engine>/<name>' — lowercase, one "
+            f"slash, e.g. my-llamacpp/my-model"
+        )
+    # Renaming ONTO a curated slug is the shadow collision #1204 just told the
+    # user to FIX — recreating it with the remedy tool would be farce.
+    if new in cr.COMPOSE_REGISTRY:
+        raise Refusal(
+            f"{new!r} is a CURATED slug — core owns that name and wins every "
+            f"lookup. Pick a different <name> (or <engine>/<name>)."
+        )
+    new_ns = new.split("/", 1)[0]
+    known = _known_engines(root)
+    if new_ns not in known:
+        sample = ", ".join(sorted(known)[:8])
+        raise Refusal(
+            f"{new_ns!r} is not a known engine, so nothing could boot {new!r} "
+            f"(the launcher resolves profiles.engines[engine]). Known: "
+            f"{sample}… — register your own engine first (catalog.sh register "
+            f"--engine <id> --engine-type <lineage>) or rename onto one of these."
+        )
+    if new in raw:
+        raise Refusal(
+            f"{new!r} already exists in the local layer — pick another name "
+            f"(or unregister it first)"
+        )
+
+    entry = dict(raw[old])
+    was_shadowed = old in cr.COMPOSE_REGISTRY
+    updated = dict(entry, engine=new_ns)
+    # Dry-wrap EXACTLY like the loader will (promote.py's rule): an entry the
+    # loader rejects must refuse BEFORE the write, not brick the layer after.
+    try:
+        cr._entry(**updated)
+    except TypeError as exc:
+        raise Refusal(f"renaming {old!r} would produce bad _entry kwargs: {exc}")
+    except ValueError as exc:
+        raise Refusal(f"renaming {old!r} would produce an entry the loader rejects: {exc}")
+
+    changes = [f"slug      {old}  ->  {new}", f"engine    {entry.get('engine')}  ->  {new_ns}"]
+    if was_shadowed:
+        changes.append("shadow    this rename clears the shadowed_by_core mark")
+    print(_describe(changes), file=sys.stderr)
+    if dry_run:
+        _info("--dry-run — nothing written")
+        return None
+
+    try:
+        raw.pop(old)
+        raw[new] = updated
+        _write_registry(root, raw)
+    except InternalError:
+        raise
+    except OSError as exc:
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+    _info(f"renamed {old} -> {new}" + (" (shadow cleared)" if was_shadowed else ""))
+    return f"RENAME_OK {old} -> {new}"
+
+
+def update_local(root: Path, slug: str, sets: list, *, dry_run: bool = False) -> Optional[str]:
+    """Amend fields of a local entry in place. Returns the success marker,
+    or None for dry-run."""
+    raw = _load_local_raw(root)
+    cr = _core_registry(root)
+    _require_local_slug(raw, cr, slug)
+    entry = dict(raw[slug])
+
+    # Editable = exactly the _entry kwargs the loader will accept, minus the
+    # two fields that are NOT this entry's to own:
+    #   origin — stamped by the loader (#1202), a raw `origin` FAILS the load;
+    #   model  — also the FILE address (models.d/<id>.yml, composes/<id>/),
+    #            editing it silently orphans the tree demote.py manages.
+    allowed = frozenset(inspect.signature(cr._entry).parameters) - {"origin"}
+    parsed = {}
+    for item in sets:
+        key, sep, text = str(item).partition("=")
+        key = key.strip()
+        if not sep or not key:
+            raise Refusal(f"--set {item!r} is not KEY=VALUE")
+        if key == "origin":
+            raise Refusal(
+                "origin is NOT editable — the local loader stamps it "
+                "(origin=\"local\") and refuses a raw entry that self-declares "
+                "it. Provenance flips by publishing to the curated catalog, "
+                "never by editing this field."
+            )
+        if key not in allowed:
+            raise Refusal(
+                f"{key!r} is not a registry field the loader accepts. "
+                f"Editable: {', '.join(sorted(allowed))}"
+            )
+        if key == "model":
+            raise Refusal(
+                "model is not settable here — the model id is also the FILE "
+                "address (models.d/<id>.yml, composes/<id>/); editing only the "
+                "entry would orphan them. Unregister and register under the "
+                "new id instead."
+            )
+        value = _parse_value(text)
+        if key == "engine":
+            # engine == namespace is the invariant every consumer of the
+            # merged view relies on; changing the engine IS a rename.
+            ns = slug.split("/", 1)[0]
+            if not isinstance(value, str) or value not in _known_engines(root):
+                raise Refusal(
+                    f"engine {value!r} is not a known engine — boot resolves "
+                    f"profiles.engines[engine] and would KeyError on this entry"
+                )
+            if value != ns:
+                tail = slug.split("/", 1)[-1]
+                raise Refusal(
+                    f"engine must equal the slug namespace {ns!r} — to change "
+                    f"the engine, rename: catalog.sh rename --slug {slug} "
+                    f"--to {value}/{tail}"
+                )
+        parsed[key] = value
+
+    merged = dict(entry)
+    merged.update(parsed)
+    if merged == entry:
+        _info(f"{slug}: no value changes")
+        return None if dry_run else f"UPDATE_OK {slug}"
+    # Re-validate against the loader's own constructor BEFORE writing — same
+    # dry-wrap rule as promote.py: never write what the loader will refuse.
+    try:
+        cr._entry(**merged)
+    except TypeError as exc:
+        raise Refusal(f"the amended entry would have bad _entry kwargs: {exc}")
+    except ValueError as exc:
+        raise Refusal(f"the amended entry would be rejected by the loader: {exc}")
+
+    print(_describe(
+        [f"{k}  {entry.get(k)!r}  ->  {parsed[k]!r}" for k in sorted(parsed)]
+    ), file=sys.stderr)
+    if dry_run:
+        _info("--dry-run — nothing written")
+        return None
+
+    try:
+        raw[slug] = merged
+        _write_registry(root, raw)
+    except InternalError:
+        raise
+    except OSError as exc:
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+    _info(f"updated {slug} ({', '.join(sorted(parsed))})")
+    return f"UPDATE_OK {slug}"
+
+
+def main(argv: Optional[list] = None) -> int:
+    ap = argparse.ArgumentParser(
+        description="Amend a LOCAL-layer registry entry in place (never the curated catalog)."
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    p_r = sub.add_parser("rename", help="move a local slug (keeps engine == namespace)")
+    p_r.add_argument("--slug", required=True, help="the existing local slug")
+    p_r.add_argument("--to", required=True, help="the new '<engine>/<name>' slug")
+
+    p_u = sub.add_parser("update", help="edit fields of a local entry")
+    p_u.add_argument("--slug", required=True, help="the local slug to amend")
+    p_u.add_argument(
+        "--set", dest="sets", action="append", required=True, metavar="KEY=VALUE",
+        help="field to amend (repeatable); origin is not editable",
+    )
+
+    for p in (p_r, p_u):
+        p.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root")
+        p.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
+
+    args = ap.parse_args(argv)
+    root = Path(args.root).resolve()
+    try:
+        if args.cmd == "rename":
+            marker = rename_local(root, args.slug, args.to, dry_run=args.dry_run)
+        else:
+            marker = update_local(root, args.slug, args.sets, dry_run=args.dry_run)
+    except Refusal as exc:
+        print(f"[amend] refused: {exc}", file=sys.stderr)
+        return EXIT_COLLISION
+    except InternalError as exc:
+        print(f"[amend] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    if marker:
+        print(marker)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
