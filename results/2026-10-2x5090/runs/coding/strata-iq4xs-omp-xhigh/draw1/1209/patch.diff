@@ -0,0 +1,167 @@
+#!/usr/bin/env bash
+# Guard: scripts/catalog.sh rename / update — the in-place LOCAL-layer amend (#1202 P7).
+#
+# The layer used to be create-and-delete only, and that broke a PROMISE: #1204
+# decided a local slug shadowed by a newly shipped curated one is kept and
+# MARKED "so the user can rename it" — while no rename existed. These checks pin
+# the properties that make the remedy actually reachable AND harmless:
+#   1. rename moves the slug, rewrites `engine` to the new namespace, keeps
+#      origin=local, and the layer still loads through load_local_registry;
+#   2. update amends a field in place without orphaning the model files
+#      (origin / model are refused; so is an engine != the slug namespace);
+#   3. both refuse CURATED slugs on every side (as OLD, as --to, as --slug);
+#   4. both refuse a destination namespace no engine can boot;
+#   5. --dry-run exits 0 and writes nothing; NOTHING under scripts/lib/profiles/
+#      ever changes.
+# Everything runs in a THROWAWAY root; the real layer is never touched.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+W="$TMP/config.json"
+C="$TMP/byo.yml"
+cat > "$C" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a byo-amend-probe -c 4096 -ctk q8_0
+YML
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+OLD="their-engine/byo-amend-probe"
+NEW="llama-cpp-local/byo-amended"
+
+ok()   { echo "  ok   $1"; }
+bad()  { echo "  FAIL $1"; rc=1; }
+
+# ── fixture: one registered local model ─────────────────────────────────────
+scripts/catalog.sh register --compose "$C" --engine their-engine --engine-type llama.cpp \
+  --weights "$W" --root "$TMP" -y >/dev/null 2>&1 || { echo "  FAIL fixture register failed"; exit 1; }
+CORE_MD5="$(find "$TMP/scripts/lib/profiles" -type f | sort | xargs -r md5sum | md5sum)"
+
+# ── 1. rename --dry-run: exit 0, registry byte-identical, no marker ─────────
+before="$(md5sum "$REG" | cut -d' ' -f1)"
+out="$(scripts/catalog.sh rename --slug "$OLD" --to "$NEW" --root "$TMP" --dry-run 2>&1)"; code=$?
+[[ "$code" -eq 0 ]] && ok "rename --dry-run exits 0" || bad "rename --dry-run exited $code"
+[[ "$(md5sum "$REG" | cut -d' ' -f1)" == "$before" ]] \
+  && ok "rename --dry-run wrote nothing" || bad "rename --dry-run MOVED the registry"
+[[ "$out" != *"RENAME_OK"* ]] && ok "rename --dry-run emits no success marker" \
+  || bad "--dry-run emitted RENAME_OK"
+
+# ── 2. rename for real ──────────────────────────────────────────────────────
+out="$(scripts/catalog.sh rename --slug "$OLD" --to "$NEW" --root "$TMP" 2>&1)"; code=$?
+[[ "$code" -eq 0 ]] && ok "rename exits 0" || bad "rename failed: $out"
+[[ "$out" == *"RENAME_OK $OLD -> $NEW"* ]] && ok "RENAME_OK emitted" || bad "no RENAME_OK: $out"
+python3 - "$TMP" "$OLD" "$NEW" <<'PY' && ok "key moved, engine == namespace, origin=local kept" || bad "registry content wrong after rename"
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+root, old, new = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
+local = __import__("scripts.lib.profiles.compose_registry",
+                   fromlist=["load_local_registry"]).load_local_registry(root)
+assert old not in local, f"{old} still present"
+assert new in local, f"{new} missing"
+e = local[new]
+assert e["engine"] == new.split("/")[0], f"engine {e['engine']!r} != namespace"
+assert e["origin"] == "local", f"origin lost: {e['origin']!r}"
+assert all(k.split("/")[0] == v["engine"] for k, v in local.items()), "engine != namespace somewhere"
+PY
+[ -d "$TMP/scripts/lib/profiles-local/composes/byo-amend-probe" ] \
+  && ok "model files survive the rename (addressed by model id)" \
+  || bad "rename destroyed the compose tree"
+
+# ── 3. update: field edit in place ───────────────────────────────────────────
+before="$(md5sum "$REG" | cut -d' ' -f1)"
+out="$(scripts/catalog.sh update --slug "$NEW" --set max_ctx=8192 --root "$TMP" --dry-run 2>&1)"; code=$?
+[[ "$code" -eq 0 && "$(md5sum "$REG" | cut -d' ' -f1)" == "$before" ]] \
+  && ok "update --dry-run exits 0, changes nothing" || bad "update --dry-run broke (code=$code)"
+out="$(scripts/catalog.sh update --slug "$NEW" --set max_ctx=8192 --root "$TMP" 2>&1)"; code=$?
+[[ "$code" -eq 0 && "$out" == *"UPDATE_OK $NEW"* ]] && ok "update exits 0 + UPDATE_OK" || bad "update failed: $out"
+python3 - "$TMP" "$NEW" <<'PY' && ok "--set lands typed (JSON-parsed) and origin survives" || bad "update value wrong"
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+root, slug = Path(sys.argv[1]), sys.argv[2]
+local = __import__("scripts.lib.profiles.compose_registry",
+                   fromlist=["load_local_registry"]).load_local_registry(root)
+assert local[slug]["max_ctx"] == 8192, local[slug]["max_ctx"]
+assert local[slug]["origin"] == "local"
+PY
+
+# ── 4. refusals — non-zero, registry unchanged ───────────────────────────────
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+for argv in \
+  "rename --slug $CORE --to llama-cpp-local/whatever" \
+  "rename --slug $NEW --to $CORE" \
+  "rename --slug $NEW --to no-such-engine/whatever" \
+  "rename --slug no-such/slug --to $NEW" \
+  "update --slug $CORE --set max_ctx=1" \
+  "update --slug $NEW --set origin=core" \
+  "update --slug $NEW --set model=some-other-id" \
+  "update --slug $NEW --set engine=vllm-stable" \
+  "update --slug $NEW --set not_a_field=1"; do
+  before="$(md5sum "$REG" | cut -d' ' -f1)"
+  out="$(scripts/catalog.sh $argv --root "$TMP" 2>&1)"; code=$?
+  if [[ "$code" -eq 0 ]]; then bad "should refuse: catalog.sh $argv"
+  elif [[ "$(md5sum "$REG" | cut -d' ' -f1)" != "$before" ]]; then bad "refusal wrote anyway: $argv"
+  else ok "refused: $argv"
+  fi
+done
+out="$(scripts/catalog.sh rename --slug "$NEW" --to "$CORE" --root "$TMP" 2>&1)"
+[[ "$out" == *"CURATED"* ]] && ok "curated rename refusal names the curated catalog" \
+  || bad "curated refusal message unhelpful: $out"
+out="$(scripts/catalog.sh update --slug "$NEW" --set origin=core --root "$TMP" 2>&1)"
+[[ "$out" == *"origin"* && "$out" == *"NOT editable"* ]] \
+  && ok "origin refusal explains provenance" || bad "origin refusal unhelpful: $out"
+
+# ── 5. the #1204 story end to end: a shadowed slug renames OUT of shadow ────
+python3 - "$TMP" <<'PY' && ok "shadow fixture loads, marked shadowed_by_core" || bad "shadow fixture broken"
+import json, sys
+from pathlib import Path
+sys.path.insert(0, ".")
+root = Path(sys.argv[1])
+reg = root / "scripts/lib/profiles-local/registry.local.json"
+raw = json.loads(reg.read_text(encoding="utf-8"))
+src = next(iter(raw))
+raw["vllm/minimal"] = dict(raw[src], model="shadow-probe", engine="vllm-stable")
+reg.write_text(json.dumps(raw, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+local = __import__("scripts.lib.profiles.compose_registry",
+                   fromlist=["load_local_registry"]).load_local_registry(root)
+assert local["vllm/minimal"]["shadowed_by_core"] is True
+PY
+out="$(scripts/catalog.sh rename --slug vllm/minimal --to vllm-stable/minimal-shadow \
+       --root "$TMP" 2>&1)"; code=$?
+[[ "$code" -eq 0 ]] && ok "shadowed slug renames in place" || bad "shadow rename failed: $out"
+python3 - "$TMP" <<'PY' && ok "rename cleared the shadow; engine == namespace" || bad "shadow persists after rename"
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+root = Path(sys.argv[1])
+local = __import__("scripts.lib.profiles.compose_registry",
+                   fromlist=["load_local_registry"]).load_local_registry(root)
+assert "vllm/minimal" not in local
+e = local["vllm-stable/minimal-shadow"]
+assert not e["shadowed_by_core"] and e["engine"] == "vllm-stable" and e["origin"] == "local"
+PY
+
+# ── 6. the curated catalog stayed untouched throughout ───────────────────────
+[[ "$(find "$TMP/scripts/lib/profiles" -type f | sort | xargs -r md5sum | md5sum)" == "$CORE_MD5" ]] \
+  && ok "no file under scripts/lib/profiles/ changed" || bad "CURATED CATALOG CHANGED"
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames, amends, and cannot reach core" \
+                   || echo "FAIL: catalog.sh rename/update regression"
+exit "$rc"
