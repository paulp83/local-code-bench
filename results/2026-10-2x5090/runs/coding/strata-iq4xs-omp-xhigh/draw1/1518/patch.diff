diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..5846b8a 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1027,7 +1027,24 @@ down_running() {
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      # Since #1498 the label holds a COMMA-JOINED list (the slug's compose plus
+      # the slug_label.py override appended at up time). Pass each path as its
+      # own -f, as litellm-log.sh does — one -f with the joined string fails
+      # every teardown ("compose file … is invalid") and silently degrades to
+      # docker stop, leaving networks and orphans behind. The override only
+      # adds labels, so drop listed files that no longer exist (e.g. the data
+      # dir moved); if none remain, fall back to docker stop without compose.
+      local -a _cfg_files=() _cfg_args=()
+      local _f
+      IFS=',' read -ra _cfg_files <<< "$lbl_file"
+      for _f in "${_cfg_files[@]}"; do
+        [[ -n "$_f" && -f "$_f" ]] && _cfg_args+=(-f "$_f")
+      done
+      if [[ "${#_cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${_cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..68390a0 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -60,8 +60,11 @@ trap cleanup EXIT
 
 # --- Mock `docker`: records compose-down / stop to $DOCKER_MOCK_LOG -----------
 # Labels are returned non-empty so the compose-down branch is taken; the
-# config_files label embeds the container name so the log identifies which
-# container was brought down.
+# config_files label defaults to one REAL file under $DOCKER_MOCK_WORKDIR
+# (down_running drops listed files that don't exist) whose name embeds the
+# container name, so the log identifies which container was brought down.
+# DOCKER_MOCK_LABEL_FILE overrides the raw label value verbatim (e.g. a
+# comma-joined two-file list as #1498 emits, or stale paths).
 cat > "${tmp_dir}/docker" <<'EOF'
 #!/usr/bin/env bash
 sub="$1"; shift || true
@@ -80,7 +83,13 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      if [[ -n "${DOCKER_MOCK_LABEL_FILE:-}" ]]; then
+        printf '%s\n' "$DOCKER_MOCK_LABEL_FILE"
+      else
+        f="${DOCKER_MOCK_WORKDIR}/compose-${cname}.yml"
+        : > "$f"   # real file: down_running drops non-existent listed files
+        printf '%s\n' "$f"
+      fi
     fi
     ;;
   stop)
@@ -135,6 +144,47 @@ assert_not_contains "$log" "COMPOSE"                          "nothing torn down
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
 
+# --- Scenario 3: #1498 comma-joined config_files label ------------------------
+# Since #1498 every slug container is started with TWO compose files (the slug's
+# compose + the slug_label.py override), recorded by docker as one comma-joined
+# string in com.docker.compose.project.config_files. down_running must pass each
+# path as its own -f; passing the joined string as one -f names a path that
+# never exists, so compose fails and teardown silently degrades to docker stop,
+# leaving the compose network and orphans behind.
+: > "$DOCKER_MOCK_LOG"
+fa="${tmp_dir}/slug-compose.yml"
+fb="${tmp_dir}/label-override.yml"
+: > "$fa"; : > "$fb"
+export DOCKER_MOCK_LABEL_FILE="${fa},${fb}"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_contains     "$log" "COMPOSE -f ${fa} -f ${fb} down --remove-orphans" "comma-joined label: one -f per file, in label order"
+assert_not_contains "$log" "STOP"                                            "no docker stop fallback while a compose file remains"
+
+# --- Scenario 4: one listed file is stale (e.g. the data dir moved) -----------
+# The label override only adds labels, so a missing entry is dropped and the
+# remaining files still run compose down.
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_LABEL_FILE="${fa},${tmp_dir}/gone.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_contains     "$log" "COMPOSE -f ${fa} down --remove-orphans" "stale listed file dropped, compose still runs with the rest"
+assert_not_contains "$log" "gone.yml"                               "non-existent file not passed as -f"
+assert_not_contains "$log" "STOP"                                   "no docker stop fallback while one compose file remains"
+
+# --- Scenario 5: every listed file is gone ------------------------------------
+# Nothing left to hand compose: fall back to docker stop without calling it.
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_LABEL_FILE="${tmp_dir}/gone-a.yml,${tmp_dir}/gone-b.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+
+assert_not_contains "$log" "COMPOSE"            "compose not called when no listed file exists"
+assert_contains     "$log" "STOP vllm-qwen36-27b" "all compose files gone: docker stop fallback"
+
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
 echo "PASS: $PASS   FAIL: $FAIL"
