+rm -rf "$SPEC_STUB"
+echo "  ✓ _spec_fp reads vLLM's engine-config line from the docker logs HEAD (not Cmd, not tail)"
+
+#1537 (5): the SGLang source of --spec-label is GET $URL/get_server_info. The sglang
+# mtp.yml composes serve the target's OWN mtp.* head behind --speculative-algorithm
+# EAGLE (draft path == target path): that prints MTP n=<steps>, not EAGLE.
+SGL_TMP="$(mktemp -d)"
+cat > "$SGL_TMP/srv.py" <<'PY'
+import http.server, json, sys
+routes = json.loads(sys.argv[2])
+class H(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        path = self.path.split("?")[0]
+        if path not in routes:
+            self.send_error(404); return
+        body = json.dumps(routes[path]).encode()
+        self.send_response(200); self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
+    def log_message(self, *a): pass
+srv = http.server.HTTPServer(("127.0.0.1", 0), H)
+open(sys.argv[1], "w").write(str(srv.server_address[1]))
+srv.serve_forever()
+PY
+sgl_probe() {  # sgl_probe <routes-json> -> --spec-label against a live get_server_info
+  : > "$SGL_TMP/port"
+  python3 "$SGL_TMP/srv.py" "$SGL_TMP/port" "$1" >/dev/null 2>&1 &
