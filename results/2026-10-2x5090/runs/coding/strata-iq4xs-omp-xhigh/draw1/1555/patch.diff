+fi
+got="$(sgl_probe '{"/get_server_info": {"model_path":"/models/t","speculative_algorithm":"EAGLE3","speculative_draft_model_path":"/models/drafter","speculative_num_steps":3}}')"
+if [[ "$got" != "EAGLE3 n=3" ]]; then fail "EAGLE3 with a separate drafter stays EAGLE3 n=3: got '$got'"; fi
+got="$(sgl_probe '{"/get_server_info": {"model_path":"/models/t","speculative_algorithm":null}}')"
