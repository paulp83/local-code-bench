+# ── which container answers $URL, and what the engine says about spec decode (#1537) ─
+def container_for_url(url):
+    """Name of the running container publishing ``url``'s port, or None.
+
+    ``docker ps`` port matching, engine-agnostic ON PURPOSE: the old CONTAINER
+    heuristic grepped names for ``vllm-(qwen|gemma)``, so an SGLang container was
+    never found and its card was labelled and measured rig-wide."""
+    if not url:
+        return None
+    try:
+        parsed = urllib.parse.urlparse(url)
+        port = parsed.port
+    except ValueError:  # unparsable port in the URL
+        return None
+    if port is None:
+        if parsed.scheme in ("http", "https"):
+            port = 443 if parsed.scheme == "https" else 80
+        else:
+            return None
+    try:
+        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+                             capture_output=True, text=True, encoding="utf-8", timeout=10)
+    except Exception:
+        return None
+    if out.returncode != 0:
+        return None
+    for line in out.stdout.splitlines():
+        parts = line.split("\t", 1) if "\t" in line else line.split(None, 1)
+        if len(parts) != 2:
+            continue
+        name, ports = parts[0].strip(), parts[1]
+        if not name or not ports.strip():
+            continue
+        for mapping in ports.split(","):
+            left, arrow, _right = mapping.strip().partition("->")
+            if not arrow:
+                continue  # exposed but not published: no host port to match
+            m = re.match(r"^(?:\[[^\]]*\]|[^:\[\]]+)?:([0-9]+)(?:-([0-9]+))?(?:/[a-z0-9]+)?$",
+                         left.strip())
+            if not m:
+                continue
+            lo = int(m.group(1))
+            hi = int(m.group(2)) if m.group(2) else lo
+            if lo <= port <= hi:
+                return name
+    return None
+
+
+# vLLM prints its resolved engine config exactly once, at BOOT: the
+# `Initializing a V1 LLM engine ... with config: ... speculative_config=...` line
+# sits at the HEAD of `docker logs`. A tail read of a server that has served for
+# a week never sees it — and the Qwen3.8 vLLM composes build --speculative-config
+# INSIDE their entrypoint script (from SPEC_N), so it never reaches the container
+# Cmd either, which is how a card claimed "spec off" with MTP n=4 running (#1537).
+_VLLM_ENGINE_CFG = "Initializing a V1 LLM engine"
+
+
+def _parse_vllm_spec_line(line):
+    """'MTP n=4' / 'DFLASH n=2' / 'spec off' from an engine-config line, else None."""
+    idx = line.find("speculative_config=")
+    if idx < 0:
+        return None
+    tail = line[idx + len("speculative_config="):]
+    if re.match(r"None\b", tail):
+        return "spec off"
+    m = re.search(r"method='([^']*)'", tail)
+    if not m:
+        return None
+    label = m.group(1).strip().upper() or "SPEC"
+    n = re.search(r"num_spec_tokens=([0-9]+)", tail)
+    return f"{label} n={n.group(1)}" if n else label
+
+
+def _vllm_spec_label(container, max_lines=20000, timeout=30):
+    """The speculative label read from the HEAD of `docker logs $container`.
+    None when the container, the daemon, or the config line is unreadable."""
+    if not container:
+        return None
+    try:
+        proc = subprocess.Popen(["docker", "logs", container],
+                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                text=True, encoding="utf-8", errors="replace")
+    except Exception:
+        return None
+    label = None
+    try:
+        start = time.time()
+        for i, line in enumerate(proc.stdout):
+            if i >= max_lines or time.time() - start > timeout:
+                break
+            if _VLLM_ENGINE_CFG in line and "speculative_config=" in line:
+                label = _parse_vllm_spec_line(line)
+                break
+    except Exception:
+        label = None
+    finally:
+        try:
+            proc.kill()
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+    return label
+
+
+def _sglang_spec_label(url, timeout=5):
+    """'MTP n=4' / 'EAGLE3 n=3' / 'spec off' from SGLang's GET $URL/get_server_info
+    (speculative_algorithm + speculative_num_steps); None when the endpoint does
+    not answer — not SGLang, or unreachable."""
+    if not url:
+        return None
+    try:
+        with urllib.request.urlopen(url.rstrip("/") + "/get_server_info", timeout=timeout) as resp:
+            data = json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+    if not isinstance(data, dict):
+        return None
+    algo = data.get("speculative_algorithm")
+    if algo is None or str(algo).strip() in ("", "NONE"):
+        return "spec off"
+    label = str(algo).strip().upper()
+    # The sglang mtp.yml composes run the target's OWN mtp.* head behind
+    # --speculative-algorithm EAGLE: the draft path IS the target path. That is
+    # MTP, not an EAGLE drafter — label it the way the compose documents it.
+    if label in ("EAGLE", "EAGLE3"):
+        draft = str(data.get("speculative_draft_model_path") or "").strip().rstrip("/")
+        target = str(data.get("model_path") or "").strip().rstrip("/")
+        if draft and draft == target:
+            label = "MTP"
+    steps = data.get("speculative_num_steps")
+    if steps is not None and str(steps).strip() != "":
+        return f"{label} n={steps}"
+    return label
+
+
+def spec_label(container="", url=""):
+    """Speculative-decoding label from the ENGINE (never the container Cmd).
+    SGLang's HTTP endpoint first — cheap and authoritative when the port answers
+    it; then vLLM's engine-config log line. None when neither source is readable."""
+    return _sglang_spec_label(url) or _vllm_spec_label(container)
+
