+echo "  ✓ VRAM + GPU label scoped to the container's GPUs (ids, comma-joined ids, UUIDs, NVIDIA_VISIBLE_DEVICES; rig-wide fallback)"
+
+#1537 (2): CONTAINER resolves from the port $URL publishes, not from a name pattern.
+# The old `vllm-(qwen|gemma)` grep never matched an SGLang container, so its card was
+# unscoped. The REAL probe runs against a stub that publishes a `sglang-*` container on
+# :30000 whose inspect Cmd serves 8 slots: resolving it prints N=8 in the banner; NOT
+# resolving it falls through the vLLM/llama.cpp probes to the #818 FATAL (dead port).
+SGSTUB="$(mktemp -d)"
+cat > "$SGSTUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  ps) printf 'sglang-qwen38\t0.0.0.0:30000->30000/tcp, [::]:30000->30000/tcp\nother-thing\t127.0.0.1:9090->9090/tcp\n' ;;
+  inspect) echo 'python -m sglang.launch_server --max-running-requests 8' ;;
+  *) exit 0 ;;
+esac
+DOCK
+chmod +x "$SGSTUB/docker"
+set +e
+out="$(PATH="$SGSTUB:$PATH" URL=http://127.0.0.1:30000 MODEL=x ROUNDS=1 PROMPT_TOKENS=128 GEN_TOKENS=8 \
+       REQ_TIMEOUT=5 CONCURRENCY_PROBE_RECORD=0 bash "$PROBE" 2>&1)"; rc=$?
+set -e
