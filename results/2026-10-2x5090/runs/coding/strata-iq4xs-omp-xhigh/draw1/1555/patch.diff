+#1537 (3): --container-for-url itself — docker ps port matching, engine-agnostic.
+CTR_STUB="$(mktemp -d)"
+cat > "$CTR_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in ps) : ;; *) exit 1 ;; esac
+printf 'club-3090-sglang\t0.0.0.0:30000->30000/tcp, [::]:30000->30000/tcp\n'
+printf 'ranger\t0.0.0.0:8020-8021->8000-8001/tcp\n'
+printf 'unpublished\t8000/tcp\n'
+printf 'noports\t\n'
+DOCK
+chmod +x "$CTR_STUB/docker"
+got="$(PATH="$CTR_STUB:$PATH" URL=http://localhost:30000 python3 "$LIB" --container-for-url)"
+if [[ "$got" != "club-3090-sglang" ]]; then fail "--container-for-url (publisher on :30000): got '$got'"; fi
+got="$(PATH="$CTR_STUB:$PATH" URL=http://127.0.0.1:8021/v1 python3 "$LIB" --container-for-url)"
+if [[ "$got" != "ranger" ]]; then fail "--container-for-url (port inside a published range): got '$got'"; fi
+got="$(PATH="$CTR_STUB:$PATH" URL=http://localhost:8000 python3 "$LIB" --container-for-url)"
+if [[ -n "$got" ]]; then fail "exposed-but-not-published (8000/tcp) is not a publisher: got '$got'"; fi
