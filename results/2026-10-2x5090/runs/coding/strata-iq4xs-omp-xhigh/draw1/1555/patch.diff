+if [[ -n "$got" ]]; then fail "no publisher prints nothing: got '$got'"; fi
+rm -rf "$CTR_STUB"
+echo "  ✓ --container-for-url (published port, ranges; exposed-only and no-match print nothing)"
+
+#1537 (4): the card's drafter field must come from the ENGINE. The Qwen3.8 vLLM
+# composes build --speculative-config inside their entrypoint (never in Cmd): the old
+# Cmd grep printed "spec off" while MTP n=4 served. Extract the REAL _spec_fp and run
+# it against a docker whose `logs` carry the boot-time engine-config line at the HEAD,
+# with request noise (including a decoy speculative_config=None) after it.
+SPEC_STUB="$(mktemp -d)"
+cat > "$SPEC_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in logs) : ;; *) exit 1 ;; esac
+case "$2" in
+  vllm-mtp)
+    echo "INFO Initializing a V1 LLM engine (v0.11.0) with config: model=/models/Qwen3.8, speculative_config=SpeculativeConfig(method='mtp', model=/models/Qwen3.8, num_spec_tokens=4), tokenizer=x"
+    for i in $(seq 40); do echo "INFO srv 127.0.0.1 speculative_config=None request noise $i"; done ;;
+  vllm-none)
+    echo "INFO Initializing a V1 LLM engine (v0.11.0) with config: model=/models/x, speculative_config=None, tokenizer=x" ;;
+  *) exit 1 ;;
+esac
+DOCK
+chmod +x "$SPEC_STUB/docker"
+spec_fn="$(awk '/^_spec_fp\(\) \{/{f=1} f{print} f&&/^\}$/{exit}' "$PROBE")"
+if [[ -z "$spec_fn" ]]; then fail "_spec_fp() not found in concurrency-probe.sh"; fi
+spec_probe() {  # spec_probe <container> -> the card's drafter label
+  PATH="$SPEC_STUB:$PATH" URL=http://127.0.0.1:1 CONTAINER="$1" PROBE_PY="$LIB" bash -c \
+    "$spec_fn"$'\n''_container_cmd() { docker inspect "$CONTAINER" --format "{{json .Config.Cmd}}" 2>/dev/null || true; }'\
+$'\n''_spec_fp'
+}
+got="$(spec_probe vllm-mtp)"
