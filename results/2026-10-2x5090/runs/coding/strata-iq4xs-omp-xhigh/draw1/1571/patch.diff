diff --git a/scripts/tests/test-gpu-select.sh b/scripts/tests/test-gpu-select.sh
index 00a311b..3c8eace 100755
--- a/scripts/tests/test-gpu-select.sh
+++ b/scripts/tests/test-gpu-select.sh
@@ -76,4 +76,73 @@ PY
   fi
 fi
 
+# (5) gpu_vram_report_lines (#1537): every busy card is attributed to the
+# process that HOLDS it — via --query-compute-apps pids mapped to containers
+# through <GPU_ATTR_PROC>/<pid>/cgroup + docker ps — never blanket-credited
+# to the one running club container. Stubbed nvidia-smi/docker + fake proc.
+grep -q 'gpu_vram_report_lines' scripts/report.sh \
+  || fail "report.sh no longer calls gpu_vram_report_lines (#1537 attribution)"
+
+T5="$(mktemp -d)"; BIN5="$T5/bin"; PR5="$T5/proc"
+mkdir -p "$BIN5" "$PR5/1001" "$PR5/1002" "$PR5/2001"
+FULL_OTHER="$(printf 'a%.0s' {1..64})"
+FULL_OURS="$(printf 'b%.0s' {1..64})"
+printf '0::/system.slice/docker-%s.scope\n' "$FULL_OTHER" > "$PR5/1001/cgroup"
+printf '0::/system.slice/docker-%s.scope\n' "$FULL_OURS"  > "$PR5/1002/cgroup"
+printf '0::/user.slice/session-2.scope\n'                  > "$PR5/2001/cgroup"
+cat > "$BIN5/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+case "$*" in
+  *query-gpu=index,uuid,memory.used*)
+    printf '0, GPU-aaa0, 23000\n1, GPU-bbb1, 21000\n2, GPU-ccc2, 1500\n3, GPU-ddd3, 5000\n4, GPU-eee4, 3\n' ;;
+  *query-compute-apps=gpu_uuid,pid,process_name*)
+    [[ "${STUB_APPS:-1}" == 1 ]] || exit 0
+    printf 'GPU-aaa0, 1001, VLLM::Worker_TP0\nGPU-ccc2, 1002, VLLM::Worker_TP1\nGPU-ddd3, 2001, Xorg\n' ;;
+  *query-compute-apps=gpu_uuid*)
+    # the container's own view: it runs on GPU-bbb1 AND GPU-ccc2
+    printf 'GPU-bbb1\nGPU-ccc2\n' ;;
+esac
+EOF
+cat > "$BIN5/docker" <<'EOF'
+#!/usr/bin/env bash
+case "$1" in
+  ps)   printf 'aaaaaaaaaaaa vllm-node\nbbbbbbbbbbbb sglang-ours\n' ;;
+  exec) printf 'GPU-bbb1\nGPU-ccc2\n' ;;
+esac
+EOF
+chmod +x "$BIN5/nvidia-smi" "$BIN5/docker"
+
+(
+  export PATH="$BIN5:$PATH" GPU_ATTR_PROC="$PR5"
+  v5() { # gpu_index, expected substring, output
+    local l
+    l="$(printf '%s\n' "$3" | command grep -F "**GPU $1 idle VRAM:**")"
+    [[ "$l" == *"$2"* ]] || { echo "FAIL #1537 GPU $1: expected '$2' in '$l'" >&2; exit 1; }
+  }
+
+  out="$(gpu_vram_report_lines 'sglang-ours')"
+  v5 0 'held by `vllm-node`'        "$out"  # another container gets the credit
+  v5 0 'not `sglang-ours`'          "$out"  # …and is explicitly NOT ours
+  v5 1 '⚠ something is using this GPU' "$out"  # busy, host sees no process on it
+  v5 1 'not `sglang-ours`'          "$out"
+  v5 2 'held by running `sglang-ours`' "$out" # ours, via its pid's cgroup
+  v5 3 'held by `Xorg`'             "$out"  # process outside any container
+  v5 4 '3 MiB ✓'                    "$out"  # idle
+
+  out="$(gpu_vram_report_lines '')"
+  v5 0 'held by `vllm-node`'        "$out"
+  [[ "$(printf '%s\n' "$out" | command grep '^')" != *'not `'* ]] \
+    || { echo "FAIL #1537: empty OUR_CONTAINER must not emit 'not'" >&2; exit 1; }
+
+  # Host lists NO compute apps: ours placed from the container's own view
+  # (docker exec nvidia-smi), across BOTH its cards; the rest stay warnings.
+  out="$(STUB_APPS=0 gpu_vram_report_lines 'sglang-ours')"
+  v5 0 '⚠ something is using this GPU' "$out"
+  v5 0 'not `sglang-ours`'          "$out"
+  v5 1 'held by running `sglang-ours`' "$out"
+  v5 2 'held by running `sglang-ours`' "$out"
+) || fail "gpu_vram_report_lines attribution (#1537)"
+rm -rf "$T5"
+
 echo "PASS: gpu-select.sh + estate_cli resolver agree; launcher sources the lib; export sets both masks"
+
