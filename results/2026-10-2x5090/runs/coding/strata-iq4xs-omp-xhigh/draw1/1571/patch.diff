diff --git a/scripts/lib/gpu-select.sh b/scripts/lib/gpu-select.sh
index ed69318..c73039c 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,108 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# gpu_vram_report_lines "<our_container>"
+#   One "- **GPU <index> idle VRAM:** ..." markdown line per host GPU for
+#   scripts/report.sh (#1537). The bug this fixes: report.sh credited ONE
+#   running container with EVERY card that had memory in use. Each busy card
+#   is now attributed to the PROCESS that actually holds it:
+#     - owners come from nvidia-smi --query-compute-apps (pid per GPU);
+#     - a pid maps to its container through <proc>/<pid>/cgroup
+#       (.../docker-<id>.scope; proc root $GPU_ATTR_PROC, default /proc)
+#       resolved to a name via `docker ps` (id → name);
+#     - a pid outside any container is named by its process_name;
+#     - when the host lists NO compute processes at all, our own card is
+#       placed from `docker exec <ours> nvidia-smi --query-compute-apps`
+#       (the container's own view); a busy card with no owner then reads
+#       "⚠ something is using this GPU" — never silently "held by ours".
+#   OUR_CONTAINER may be empty; the "not `<ours>`" notes are then omitted.
+#   Card with <=100 MiB used is idle and ends "<N> MiB ✓".
+gpu_vram_report_lines() {
+  local our_container="${1:-}"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  local gpu_lines app_lines
+  gpu_lines="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null || true)"
+  [[ -n "${gpu_lines//[[:space:]]/}" ]] || return 0
+  app_lines="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null || true)"
+
+  # Host lists no compute processes at all (driver/runtime combos do this) —
+  # fall back to OUR container's own view of where its processes run.
+  local ours_uuids=""
+  if [[ -z "${app_lines//[[:space:]]/}" && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    ours_uuids="$(docker exec "$our_container" nvidia-smi \
+        --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null \
+      | tr -d ' \r' | command grep '^GPU-' | sort -u | paste -sd, - 2>/dev/null || true)"
+  fi
+
+  # docker ps id→name table, fetched once (only pids in a docker cgroup need it).
+  local docker_ps=""
+  if [[ -n "${app_lines//[[:space:]]/}" ]] && command -v docker >/dev/null 2>&1; then
+    docker_ps="$(docker ps --format '{{.ID}} {{.Names}}' 2>/dev/null || true)"
+  fi
+
+  # uuid → owner, owner tagged: "c|<container name>" or "p|<process name>".
+  local -A uuid_owner=()
+  local auuid apid apname cgfile cid owner did dname
+  if [[ -n "${app_lines//[[:space:]]/}" ]]; then
+    while IFS=, read -r auuid apid apname; do
+      auuid="${auuid//[[:space:]]/}"; apid="${apid//[[:space:]]/}"
+      [[ -z "$auuid" || -z "$apid" ]] && continue
+      [[ -n "${uuid_owner[$auuid]:-}" ]] && continue  # first owner wins
+      apname="${apname#"${apname%%[![:space:]]*}"}"   # ltrim (IFS kept commas inside the name)
+      owner=""
+      cgfile="${proc_root}/${apid}/cgroup"
+      if [[ -r "$cgfile" ]]; then
+        cid="$(command grep -oE 'docker[-/][0-9a-f]+' "$cgfile" 2>/dev/null | head -1 || true)"
+        cid="${cid#docker?}"  # strip the docker- / docker/ separator
+        if [[ -n "$cid" && -n "$docker_ps" ]]; then
+          while read -r did dname; do
+            [[ -z "$did" ]] && continue
+            # docker ps prints the 12-char short id; the cgroup holds the full one.
+            case "$cid" in "$did"*) owner="c|${dname}"; break ;; esac
+          done <<< "$docker_ps"
+        fi
+      fi
+      [[ -z "$owner" && -n "$apname" ]] && owner="p|${apname}"
+      [[ -n "$owner" ]] && uuid_owner["$auuid"]="$owner"
+    done <<< "$app_lines"
+  fi
+
+  local idx uuid used owner_name
+  while IFS=, read -r idx uuid used; do
+    idx="${idx//[[:space:]]/}"; uuid="${uuid//[[:space:]]/}"; used="${used//[[:space:]]/}"
+    [[ -n "$idx" ]] || continue
+    if ! [[ "$used" =~ ^[0-9]+$ ]] || (( used <= 100 )); then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+      continue
+    fi
+    owner="${uuid_owner[$uuid]:-}"
+    if [[ -z "$owner" && -n "$ours_uuids" ]]; then
+      case ",${ours_uuids}," in *",${uuid},"*) owner="c|${our_container}" ;; esac
+    fi
+    case "$owner" in
+      'c|'*)
+        owner_name="${owner#c|}"
+        if [[ -n "$our_container" && "$owner_name" == "$our_container" ]]; then
+          echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${owner_name}\`)"
+        elif [[ -n "$our_container" ]]; then
+          echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${owner_name}\`, not \`${our_container}\`)"
+        else
+          echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${owner_name}\`)"
+        fi
+        ;;
+      'p|'*)
+        echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${owner#p|}\`)"
+        ;;
+      *)
+        if [[ -n "$our_container" ]]; then
+          echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU, not \`${our_container}\` (display, browser, container)"
+        else
+          echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container)"
+        fi
+        ;;
+    esac
+  done <<< "$gpu_lines"
+}
