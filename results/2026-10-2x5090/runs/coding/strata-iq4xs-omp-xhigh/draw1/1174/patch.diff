+# ---------------------------------------------------------------------------
+# "tool unavailable" signature (missing `hf` CLI)
+# ---------------------------------------------------------------------------
+
+# Command-not-found signatures for `is_tool_unavailable`: rc 127 is checked
+# by the function itself; these text markers cover a wrapper/shim whose
+# shell reports the missing command, and `_hf_download`'s own line —
+# "neither `hf` nor `huggingface-cli` is on PATH" — matched on its tail.
+_TOOL_UNAVAILABLE_MARKERS = (
+    "is on path",
+    "command not found",
+)
+
+
+def is_tool_unavailable(rc: int, blob: str) -> bool:
+    """True iff rung 1 failed because the `hf` CLI itself could not be run.
+
+    The command-not-found class: rc 127 is the shell convention, and it is
+    what `_hf_download` returns when neither `hf` nor `huggingface-cli`
+    resolves on PATH. Unlike the Xet wall this says NOTHING about the repo
+    or the file — and rung 3 depends only on urllib + curl — so this failure
+    class is fallback-eligible and must NOT kill the ladder."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return any(m in low for m in _TOOL_UNAVAILABLE_MARKERS)
+
