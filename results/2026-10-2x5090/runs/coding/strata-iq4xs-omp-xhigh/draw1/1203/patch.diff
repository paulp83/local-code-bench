+# ── Compose→spec facts (SHARED — #1202 P1) ─────────────────────────────────────────
+# ComposeFacts / _ENGINE_BY_IMAGE / derive_compose_facts moved to
+# scripts/lib/profiles/compose_facts.py so the CLI and the cockpit share ONE
+# implementation: the UI owning the only derivation is what made the local
+# model layer write-only from the UI (#1153). data.py keeps the API surface —
+# derive_compose_facts delegates below, ComposeFacts re-exports via the
+# module __getattr__.
+
+_COMPOSE_FACTS_MODULE = None
+
+
+def _compose_facts():
+    """The shared ``scripts.lib.profiles.compose_facts`` module, imported lazily.
+
+    Lazy + bootstrapped: the module is stdlib-only but lives in
+    ``scripts.lib.profiles``, only importable once the repo root is on sys.path
+    (same lazy pattern as ``_plain_spec_to_model_spec``); c3 runs from
+    tools/serve-cockpit/, so mirror ``__main__`` — ``C3_REPO_ROOT`` else
+    ``__file__``-relative — when it isn't already importable."""
+    global _COMPOSE_FACTS_MODULE
+    if _COMPOSE_FACTS_MODULE is not None:
+        return _COMPOSE_FACTS_MODULE
+    import os as _os
+    import sys as _sys
+    from pathlib import Path
+    try:
+        from scripts.lib.profiles import compose_facts
+    except ModuleNotFoundError:  # repo root not on sys.path (c3 runs from tools/)
+        env_root = _os.environ.get("C3_REPO_ROOT")
+        root = Path(env_root).resolve() if env_root else Path(__file__).resolve().parents[3]
+        if not (root / "scripts" / "lib" / "profiles" / "__init__.py").is_file():
+            raise
+        _sys.path.insert(0, str(root))
+        from scripts.lib.profiles import compose_facts
+    _COMPOSE_FACTS_MODULE = compose_facts
+    return compose_facts
 
 
