diff --git a/tools/serve-cockpit/tests/test_compose_facts_shared.py b/tools/serve-cockpit/tests/test_compose_facts_shared.py
new file mode 100644
index 0000000..84d8315
--- /dev/null
+++ b/tools/serve-cockpit/tests/test_compose_facts_shared.py
@@ -0,0 +1,113 @@
+"""#1202 P1 — compose→spec derivation lives in the SHARED profiles module.
+
+The local model layer was write-only from the UI (#1153) because the UI owned
+the ONLY implementation of compose→spec derivation: a user with a working
+compose had a door in c3 and none from the CLI. The fix is a single source —
+``scripts/lib/profiles/compose_facts.py`` — which the launcher path must be
+able to import on bare python3, and which ``club3090_cockpit.data`` delegates
+to. These tests pin the two properties that make the sharing real rather than
+cosmetic: the shared module's no-PyYAML importability, and object identity
+across the cockpit/CLI boundary (a second implementation would pass any
+field-by-field diff but break isinstance and drift silently)."""
+
+from __future__ import annotations
+
+import sys
+from dataclasses import asdict
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[3]
+
+# The CLI door: importable package-qualified, exactly like a launcher/script
+# would — this is what "nothing outside the cockpit could import it" (#1202)
+# was about. Inserting REPO mirrors CockpitData.__init__'s sys.path bootstrap,
+# so the identity assertions below compare against the SAME module object the
+# lazy loader resolves, not a second copy imported under a different name.
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+from scripts.lib.profiles import compose_facts as shared  # noqa: E402
+
+from club3090_cockpit import data  # noqa: E402
+
+VLLM_COMPOSE = (
+    "services:\n"
+    "  vllm:\n"
+    "    image: vllm/vllm-openai:v0.27.1\n"
+    "    command:\n"
+    "      - --model\n"
+    "      - /models/my-model\n"
+    "      - --max-model-len=32768\n"
+)
+
+
+class TestSharedModule:
+    def test_cli_door_derives_a_compose(self):
+        f = shared.derive_compose_facts(VLLM_COMPOSE, path="/tmp/x.yml")
+        assert f.ok and f.engine == "vllm"
+        assert f.model_path == "/models/my-model" and f.max_ctx == "32768"
+
+    def test_importable_on_the_no_pyyaml_path(self):
+        """The launcher's stdlib-only guarantee (#584): compose_facts must not
+        reach PyYAML even transitively. Execute the module FRESH with `yaml`
+        poisoned — a real ImportError at exec time, not a source-text grep,
+        and without evicting the cached copy (the identity tests below must
+        see the same module object data's loader resolves)."""
+        import builtins
+        import importlib.util
+
+        real_import = builtins.__import__
+
+        def _no_yaml(name, *args, **kwargs):
+            if name.split(".")[0] == "yaml":
+                raise ImportError("PyYAML is not installed (launcher path)")
+            return real_import(name, *args, **kwargs)
+
+        builtins.__import__ = _no_yaml
+        try:
+            spec = importlib.util.find_spec("scripts.lib.profiles.compose_facts")
+            fresh = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(fresh)
+            assert fresh.derive_compose_facts("").error == "empty compose"
+        finally:
+            builtins.__import__ = real_import
+
+    def test_engine_detection_walks_the_image_map(self):
+        for image, engine in (
+            ("vllm/vllm-openai:v0.27.1", "vllm"),
+            ("ghcr.io/x/llamacpp-club3090:1", "llama-cpp"),
+            ("ggml-org/llama.cpp:latest", "llama-cpp"),
+            ("some/ik_llama:dev", "ik-llama"),
+        ):
+            f = shared.derive_compose_facts(f"services:\n  x:\n    image: {image}\n")
+            assert f.engine == engine, image
+
+
+class TestCockpitDelegation:
+    def test_data_reexports_the_shared_class_identity(self):
+        # module attribute (PEP 562 __getattr__) AND the from-import path
+        assert data.ComposeFacts is shared.ComposeFacts
+        from club3090_cockpit.data import ComposeFacts
+        assert ComposeFacts is shared.ComposeFacts
+
+    def test_derivation_returns_the_shared_class(self):
+        f = data.derive_compose_facts(VLLM_COMPOSE)
+        assert isinstance(f, shared.ComposeFacts)
+        assert asdict(f) == asdict(shared.derive_compose_facts(VLLM_COMPOSE))
+
+    def test_delegation_matches_shared_on_rejections(self):
+        """Route-K's contract is refuse-not-guess on junk; the wrapper must not
+        introduce its own failure shape (including never raising)."""
+        for junk in ("", "   \n", "\x00\x01", "]]]{{{", "image:\n" * 30, "- " * 50,
+                     "services:\n  x:\n    build: .\n"):
+            assert (
+                asdict(data.derive_compose_facts(junk))
+                == asdict(shared.derive_compose_facts(junk))
+            ), junk
+
+    def test_unknown_attributes_still_raise(self):
+        try:
+            getattr(data, "ComposeFactsX")
+            assert False, "expected AttributeError"
+        except AttributeError:
+            pass
