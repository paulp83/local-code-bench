   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# vLLM's own boot log — the fallback when the container argv shows no parser.
+# An image that starts vLLM through its own launcher script (bucko's official
+# Qwen3.8 image runs `qwen38-serve`, which appends `--reasoning-parser qwen3`
+# INSIDE the script) keeps the flag out of `docker inspect` entirely, so
+# "absent from argv" is NOT positive evidence of absence. vLLM prints the
+# config it actually resolved at the head of the log, twice over:
+#   [api_server] non-default args: {..., 'reasoning_parser': 'qwen3', ...}
+#   [core] Initializing a V1 LLM engine .. with config: .. reasoning_parser='qwen3' ..
+# The first lists ONLY non-defaults (the key absent = still the default = no
+# parser); the second spells every value, `reasoning_parser=None` being the
+# negative form. Either line settles the question; NEITHER line means the log
+# is unreadable or predates the boot — no evidence, which is NOT the same
+# thing as absence. `restart: unless-stopped` means one log can hold several
+# boots: the LAST resolved-args line is the current boot, the same rule
+# detect_nvlink.sh sets. Streams line by line — a long-lived engine's log can
+# be hundreds of MB, and `docker logs` has no --head.
+# stdin: `docker logs <c> 2>&1`. stdout, one line:
+#   BOOTPARSER <value>   reasoning_parser resolved — positive evidence PRESENT
+#   BOOTPARSER none      a resolved-args line seen without it — positive ABSENCE
+#   BOOT none            no resolved-args line readable — NO evidence
+_THINKING_BUDGET_BOOTLOG_PY="$(cat <<'PY'
+import re, sys
+
+RP = re.compile(r"'reasoning_parser':\s*([^,}]+)|\breasoning_parser=([^,)\s]+)")
+last = None
+for line in sys.stdin:
+    if "non-default args:" in line or "Initializing a V1 LLM engine" in line:
+        last = line
+if last is None:
+    print("BOOT none")
+    sys.exit(0)
+m = RP.search(last)
+val = (m.group(1) or m.group(2) or "").strip().strip("\"'") if m else ""
+print("BOOTPARSER %s" % (val if val and val != "None" else "none"))
+PY
+)"
+_thinking_budget_vllm_bootlog_facts() {
+  python3 -c "$_THINKING_BUDGET_BOOTLOG_PY"
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,8 +377,27 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # Not in argv is NOT proof of absence: an image that starts vLLM
+          # through its own launcher sets --reasoning-parser inside that
+          # script, where docker inspect cannot see it. Ask the server's own
+          # boot log before refusing — and refuse HARD (rc 1) only when the
+          # log positively shows no parser. An unreadable log is no evidence
+          # at all (rc 2), which THINKING_BUDGET_UNVERIFIED=1 can acknowledge.
+          # `|| true`: docker logs failing under pipefail must not kill the
+          # wrapper mid-verify; the parser turns its silence into BOOT none.
+          local _tb_boot
+          _tb_boot="$(docker logs "$c" 2>&1 | _thinking_budget_vllm_bootlog_facts || true)"
+          case "$_tb_boot" in
+            "BOOTPARSER none")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — neither its argv nor its boot log's resolved args carry one — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+            "BOOTPARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s boot log resolves reasoning_parser to '${_tb_boot#BOOTPARSER }' — the image's launcher sets the flag inside the image, so the boot log shows it and the container argv does not"
+              return 0 ;;
+            *)
+              THINKING_BUDGET_EVIDENCE="container ${c} shows no --reasoning-parser in its argv and its boot log carries no resolved-args line — neither source can say whether a reasoning parser is configured"
+              return 2 ;;
+          esac ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
