+def _template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line (#1610
+    follow-up): its own template directory / template filename, minus names that carry
+    no patch identity — `patches` (every compose that mounts any patch) and the bare
+    model-dir name `chat_template.jinja` (almost every vendored override has it, so it
+    would let ANY template mount satisfy the check)."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    names: set[str] = set()
+    rels = [(patch.get("delivery_spec") or {}).get("jinja")]
+    rels += [f for f in patch.get("files") or [] if Path(f).suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES]
+    for rel in rels:
+        if not rel:
+            continue
+        path = Path(rel)
+        names.add(path.name)
+        names.add(path.parent.name)       # composes usually mount `<patch-dir>/chat_template.jinja`
+    return sorted(n for n in names
+                  if n and n != "patches" and n not in _CHAT_TEMPLATE_AUTOLOAD_NAMES)
+
+
+def _template_flag(spec: dict) -> str | None:
+    """The explicit template-selection flag this patch's `invoke` declares
+    (`--chat-template` for vLLM, `--chat-template-file` for llama.cpp), or None."""
+    invoke = spec.get("invoke") or ""
+    if re.search(r"--chat-template-file(?![\w-])", invoke):
+        return "--chat-template-file"
+    if re.search(r"--chat-template(?![\w-])", invoke):
+        return "--chat-template"
+    return None
+
+
+def _template_flag_names_mount(body: str, flag: str, mounted_at: str) -> bool:
+    """True iff the body passes ``flag`` NAMING ``mounted_at``.
+
+    Accepted shapes (both engines' shipped styles):
+      * inline: ``--chat-template /etc/x.jinja`` / ``--chat-template=/etc/x.jinja``,
+        including inside one quoted command string;
+      * YAML block list: the flag and the path as ADJACENT list items
+        (``- --chat-template`` / ``- /etc/x.jinja``).
+
+    A bare flag (no adjacent named path) is NOT wiring, and the flag token must
+    match exactly — ``--chat-template`` never matches as the prefix of
+    ``--chat-template-file`` (or the other way round) (#1610 follow-up cause 1).
+    """
+    if not flag or not mounted_at:
+        return False
+    tok = re.compile(r"(?<![\w-])" + re.escape(flag) + r"(?![\w-])")
+    flag_item = re.compile(r"^\s*-\s+[\"']?" + re.escape(flag) + r"[\"']?\s*$")
+    path_item = re.compile(r"^\s*-\s+[\"']?([^\s\"']+)[\"']?\s*$")
+    lines = body.splitlines()
+    for i, ln in enumerate(lines):
+        if flag_item.match(ln):
+            j = i + 1
+            while j < len(lines) and not lines[j].strip():
+                j += 1
+            if j < len(lines):
+                m = path_item.match(lines[j])
+                if m and m.group(1).endswith(mounted_at):
+                    return True
+            continue
+        for m in tok.finditer(ln):
+            pm = re.match(r"\s*=?\s*[\"']?([^\s\"']+)", ln[m.end():])
+            if pm and pm.group(1).endswith(mounted_at):
+                return True
+    return False
+
+
+def _chat_template_wired(patch: dict, spec: dict, body: str) -> bool:
+    """Sound wiring check for ``delivery_mechanism: chat_template`` (#1610 follow-up).
+
+    Two shipped wiring styles, both keyed on the patch's OWN template (source-aware
+    mount line, the #1597 rule for install scripts):
+      * explicit-flag style (``/etc/<name>.jinja`` targets — froggeric/gemma/apex/
+        glm53): this patch's template is mounted at ``mounted_at`` AND the declared
+        ``--chat-template``/``--chat-template-file`` flag names that mounted path;
+      * model-dir autoload style (target named ``chat_template.jinja`` — carnice,
+        qwen38 incl. its SGLang lanes): the engine renders the template from the
+        model dir with no flag, so the source-aware mount alone is the load-bearing
+        artifact (vLLM composes may ALSO pass the flag; that only corroborates).
+    """
+    mounted_at = spec.get("mounted_at")
+    sources = _template_sources(patch)
+    if not mounted_at or not sources:
+        return False
+    # The container target alone is not this patch's — two patches can mount at the
+    # same target, and `mounted_at: /chat_template.jinja` (qwen38) is a suffix of ANY
+    # model-dir template mount. Require the patch's own source on the SAME line (#1597).
+    vol_ok = any(mounted_at in ln and any(s in ln for s in sources) for ln in body.splitlines())
+    if not vol_ok:
+        return False
+    if mounted_at.rsplit("/", 1)[-1] in _CHAT_TEMPLATE_AUTOLOAD_NAMES:
+        # Autoload target: the mount alone is the wiring — UNLESS the command
+        # selects a different template with either flag form (the compose then
+        # serves ANOTHER template, and this mount is dead weight).
+        named = any(_template_flag_names_mount(body, f, mounted_at)
+                    for f in ("--chat-template", "--chat-template-file"))
+        if named:
+            return True
+        return not re.search(r"(?<![\w-])--chat-template(-file)?(?![\w-])", body)
+    return _template_flag_names_mount(body, _template_flag(spec), mounted_at)
+
