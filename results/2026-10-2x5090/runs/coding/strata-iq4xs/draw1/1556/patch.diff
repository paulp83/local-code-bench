+  python3 "$LIB" --card <<JSON
+{
+  "model": "qwen3.8-27b", "slug": "sgl/qwen38-27b-dual-max", "engine": "$1",
+  "served_max_len": 163840, "gen_tokens": 256, "rows": [
+    {"ctx": 1024, "n": 1, "strm": 87.3, "agg": 87, "ttft_s": 0.1, "clean": 1, "pass": 1},
+    {"ctx": 1024, "n": 8, "strm": 38.0, "agg": 241, "ttft_s": 0.4, "clean": 1, "pass": 1},
+    {"ctx": 16384, "n": 1, "strm": 87.3, "agg": 87, "ttft_s": 0.8, "clean": 1, "pass": 1},
+    {"ctx": 16384, "n": 2, "strm": 51.8, "agg": 104, "ttft_s": 1.4, "clean": 1, "pass": 1}
