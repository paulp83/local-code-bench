+#!/usr/bin/env bash
+[ "$1" = logs ] || exit 0
+name="$2"; [ "$2" = "--tail" ] && name="$4"
+case "$name" in
+  # The boot line sits at the HEAD, then thousands of traffic lines: a --tail 2500 read
+  # alone would never see it on either engine.
+  vllm-serving)
+    echo "INFO [core.py:123] GPU KV cache size: 210,000 tokens"
+    for i in $(seq 1 4000); do echo "INFO [loggers.py] Avg generation throughput: 80.0 tokens/s"; done ;;
+  sglang-serving)
+    echo "[2026-09-30 00:00:00] max_total_num_tokens=158116, chunked_prefill_size=2048, max_running_requests=1, context_len=163840"
