@@ -25,6 +25,46 @@ from club3090_tui_core.registry import VariantRow
 if TYPE_CHECKING:  # pragma: no cover - annotations only
     from scripts.lib.profiles.model_spec import ModelSpec
 
+
+# ── Shared compose facts (#1202 P1) ──────────────────────────────────────────
+# ``ComposeFacts`` / ``_ENGINE_BY_IMAGE`` / ``derive_compose_facts`` were lifted
+# out of this module into ``scripts.lib.profiles.compose_facts`` so the CLI (and
+# anything else outside the cockpit) can derive facts from an existing compose —
+# the UI no longer owns the only implementation.  They are imported LAZILY: this
+# module is on the launcher's no-PyYAML path and ``scripts`` is not always on
+# sys.path at import time (c3 runs from tools/serve-cockpit/).  ``__getattr__``
+# re-exports ``ComposeFacts`` so every existing ``from ...data import
+# ComposeFacts`` caller works unchanged.
+def _compose_facts_module():
+    """Lazily import the shared ``compose_facts`` module (stdlib-only)."""
+    try:
+        from scripts.lib.profiles import compose_facts  # noqa: E402
+    except ModuleNotFoundError:
+        _ensure_scripts_importable()
+        from scripts.lib.profiles import compose_facts  # noqa: E402
+    return compose_facts
+
+
+def __getattr__(name: str):
+    # Re-export the symbols that moved to the shared profiles package, lazily,
+    # so importing this module never drags in ``scripts``.
+    if name in ("ComposeFacts", "_ENGINE_BY_IMAGE"):
+        return getattr(_compose_facts_module(), name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def _ensure_scripts_importable() -> None:
+    """Put the repo root on sys.path so ``scripts.lib.profiles`` resolves.
+
+    c3 runs from tools/serve-cockpit/, so the repo root is not otherwise on
+    sys.path.  Only inserts roots that actually carry the package tree.
+    """
+    import sys
+    from pathlib import Path
+    root = Path(__file__).resolve().parents[3]
+    if str(root) not in sys.path and (root / "scripts" / "lib" / "profiles" / "compose_facts.py").exists():
+        sys.path.insert(0, str(root))
+
