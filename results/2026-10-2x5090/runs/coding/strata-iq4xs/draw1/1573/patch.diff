+              return 1 ;;
+            "PARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s boot log reports reasoning_parser=${logfacts#PARSER } (--reasoning-parser set by the image's own launcher, so the container argv carries none)"
+              return 0 ;;
