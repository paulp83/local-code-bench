+# vLLM's own account of what it booted with. `non-default args: {...}` is logged
+# once at startup and lists only what differs from vLLM's defaults, so a parser
+# set ANYWHERE — the container argv, a wrapper script inside the image, an env
+# file — shows up here, which `docker inspect` cannot see (bucko's image starts
+# vLLM through `qwen38-serve`, which adds `--reasoning-parser qwen3` itself).
+# argv 1 = this lib's directory (resolved_config.dict_after parses the dump),
+# argv 2 = the container. stdout, one line:
+#   PARSER <value>   the boot log names a reasoning parser
+#   PARSER none      the log dumps RESOLVED args and no parser is among them
+#   LOG <note>       the log cannot answer (unreadable, empty, rotated, or a dump
+#                    shape this parser does not know) — the argv's silence is
+#                    then NOT evidence of absence, so the caller must not refuse
+# `docker logs` has no --head, so the read is bounded to resolved_config's prefix.
+_THINKING_BUDGET_VLLM_BOOT_LOG_PY="$(cat <<'PY'
+import re, sys
+
+lib_dir, container = sys.argv[1], sys.argv[2]
+if lib_dir:
+    import os
+    sys.path.insert(0, lib_dir)
+
+MARKER = "non-default args:"
+
+try:
+    # one server_args / non-default-args parser for the whole repo (resolved_config)
+    from resolved_config import dict_after as _dict_after
+except Exception:  # noqa: BLE001 — standalone use (or a stripped checkout) still works
+    _dict_after = None
+
+
+def read_log():
+    """(text, note) — the container's log from the start; the dump is at boot."""
+    try:
+        from resolved_config import _boot_log_prefix
+    except Exception:
+        import subprocess
+        try:
+            p = subprocess.run(["docker", "logs", container], capture_output=True,
+                               text=True, encoding="utf-8", errors="replace", timeout=60)
+        except (OSError, subprocess.SubprocessError) as exc:
+            return "", "could not read the boot log (%s)" % exc
+        return p.stdout + p.stderr, None
+    try:
+        text, _truncated, err = _boot_log_prefix(container)
+    except Exception as exc:  # noqa: BLE001 — a fallback source is never fatal
+        return "", "could not read the boot log (%s)" % exc
+    return text, err
+
+
+def dump_dict(line, at):
+    """The resolved-args dict of one dump line, or None when it will not parse."""
+    if _dict_after is not None:
+        found = _dict_after(line[at:], MARKER)
+        return found if isinstance(found, dict) else None
+    import ast
+    m = re.search(r"\{.*\}", line[at:])
+    if not m:
+        return None
+    try:
+        lit = ast.literal_eval(m.group(0))
+    except (ValueError, SyntaxError):
+        return None
+    return lit if isinstance(lit, dict) else None
+
+
+def quoted_parser(line):
+    """The parser named by a dump this parser cannot read. A quoted value only —
+    `reasoning_parser=None` is the ABSENCE of a parser, never a match."""
+    m = re.search(r"""['"]reasoning_parser['"]\s*[:=]\s*['"]([^'"]+)['"]""", line)
+    if m:
+        return m.group(1)
+    m = re.search(r"\breasoning_parser\s*=\s*['\"]([^'\"]+)['\"]", line)
+    return m.group(1) if m else None
+
+
+def parse(text):
+    parser, seen, parsed = None, 0, 0
+    for line in text.splitlines():
+        at = line.lower().find(MARKER)
+        if at < 0:
+            continue
+        seen += 1
+        args = dump_dict(line, at)
+        if args is None:
+            continue
+        parsed += 1
+        # The LAST dump wins: `docker logs` holds every boot of the container and
+        # `non-default args:` lists only what differs from vLLM's defaults, so a
+        # key ABSENT from the newest dump means the server in service has none.
+        rp = args.get("reasoning_parser")
+        parser = rp.strip() if isinstance(rp, str) and rp.strip() else None
+    if parser:
+        return "PARSER %s" % parser
+    if parsed:
+        return "PARSER none"
+    for line in text.splitlines():
+        hit = quoted_parser(line)
+        if hit:
+            return "PARSER %s" % hit
+    if seen:
+        return "LOG the boot log's resolved-args dump could not be read"
+    return "LOG no resolved-args dump in the boot log"
+
+
+text, note = read_log()
+if note:
+    print("LOG %s" % note)
+elif not text.strip():
+    print("LOG boot log is empty (log driver not `json-file`, or the log was rotated)")
+else:
+    print(parse(text))
+PY
+)"
+_thinking_budget_vllm_boot_log_facts() {
+  python3 -c "$_THINKING_BUDGET_VLLM_BOOT_LOG_PY" "$_TB_LIB_DIR" "$1" 2>/dev/null
+}
