diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..8f5922b 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1027,7 +1027,25 @@ down_running() {
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      # config_files can hold several comma-joined paths (the slug compose +
+      # the club3090.slug label override added since #1498). Pass each as its
+      # own -f — a single -f over the joined string is read as one bogus path
+      # and the down silently falls back to docker stop (#1498 regression).
+      # Drop listed files that no longer exist (the data dir may have moved);
+      # only the compose file matters for down, the override just adds labels.
+      local -a cfg_args=() _cfgs
+      local f _p
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      for f in "${_cfgs[@]}"; do
+        [[ -n "$f" ]] || continue
+        if [[ "$f" = /* ]]; then _p="$f"; else _p="${lbl_dir}/${f}"; fi
+        [[ -e "$_p" ]] && cfg_args+=(-f "$f")
+      done
+      if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
