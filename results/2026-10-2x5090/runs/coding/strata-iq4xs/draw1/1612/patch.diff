     return sorted(n for n in names if n and n not in _GENERIC_SCRIPT_NAMES and n != "patches")
 
 
+# Template filenames shared by every vendored chat template (like the generic
+# script names above): on a mount line they identify NO particular template, so
+# they never count as a patch-specific source. A patch's container target (or,
+# for qwen38, the bare `/chat_template.jinja` suffix mounted over each model
+# dir) is likewise shared, so the vendored template's OWN directory / filename
+# must pin the mount line.
+_GENERIC_TEMPLATE_NAMES = frozenset({"chat_template.jinja", "chat_template.j2", "chat_template.jinja2"})
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify THIS chat_template patch on its mount line:
+    the vendored jinja's own filename and its directory, minus generic names
+    (chat_template.jinja) and the shared "patches" parent. Derived from
+    ``delivery_spec.jinja`` (the canonical artifact) and ``files``."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    spec = patch.get("delivery_spec") or {}
+    names: set[str] = set()
+    for rel in [spec.get("jinja"), *(patch.get("files") or [])]:
+        if not rel:
+            continue
+        path = Path(rel)
+        names.add(path.name)
+        names.add(path.parent.name)
+    return sorted(n for n in names
+                  if n and n not in _GENERIC_TEMPLATE_NAMES and n != "patches")
+
+
+def _command_tokens(body: str) -> list[str]:
+    """Flatten a merged compose body into command-style tokens: drop the leading
+    YAML list dash, split each remaining line on whitespace, and strip the
+    quoting/commas docker/safe_dump adds. Used to match a `--chat-template[-file]`
+    flag against the path it names (adjacent list items or an inline `flag path`
+    form), so a bare flag with a different argument never satisfies the check."""
+    toks: list[str] = []
+    for raw in body.splitlines():
+        line = re.sub(r"^\s*-\s*", "", raw).strip()
+        toks.extend(line.split())
+    return [t.strip().strip(",").strip("'\"") for t in toks]
+
+
+def _flag_names_mount(body: str, flag: str, mounted_at: str) -> bool:
+    """True iff ``flag`` appears as a standalone token whose NEXT token names a
+    path containing ``mounted_at``. Exact-token matching means `--chat-template`
+    never matches a `--chat-template-file` (or `--default-chat-template-kwargs`)
+    token — the flag must be the one the compose actually passes — and the path
+    must be THIS template's mount, so `--chat-template <other file>` fails."""
+    toks = _command_tokens(body)
+    for i in range(len(toks) - 1):
+        if toks[i] == flag and mounted_at in toks[i + 1]:
+            return True
+    return False
+
+
+def _chat_template_wired(patch: dict, body: str) -> bool:
+    """Sound chat_template wiring (the #1610 install-script analogue for templates).
+
+    A compose genuinely ships THIS patch's template only when it mounts the
+    vendored file (source-matched) and — for the explicit-flag style — passes
+    `--chat-template` / `--chat-template-file` naming that mount. The container
+    target / `/chat_template.jinja` suffix and a bare `--chat-template` flag are
+    shared by every template, so neither counts on its own (#1610 lesson): any
+    compose mounting some template over a model dir used to "reach" every chat-
+    template patch, and every vLLM compose passing `--chat-template` for its own
+    template used to reach apex / glm53.
+
+    ``wired_at`` (`command` normalised to `entrypoint`):
+      * ``volumes`` (mount-only: carnice, qwen38 — vLLM/SGLang auto-load the
+        model-dir template) -> the source-qualified mount is load-bearing;
+      * ``[volumes, entrypoint]`` (explicit flag: gemma, froggeric, apex, glm53)
+        -> require the mount AND the flag naming that mount.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = {("entrypoint" if w == "command" else w) for w in (wired_at or [])}
+
+    sources = _chat_template_sources(patch)
+    if sources:
+        # The vendored template's own dir/filename must be on the SAME line as
+        # the mount target (two patches can share a target / suffix — #1597).
+        # The source must sit OUTSIDE the target path itself: apex names its
+        # mount `apex-qwen-chat-template.jinja:/etc/apex-qwen-chat-template.jinja`
+        # so its filename is a substring of the target, and a bare command-flag
+        # line `--chat-template-file /etc/apex-qwen-chat-template.jinja` would
+        # otherwise look like a mount. Blanking the target first pins the real
+        # source segment (the `src:` before the bind-mount separator).
+        vol_ok = any(mounted_at in ln and any(s in ln.replace(mounted_at, "\x00")
+                                              for s in sources)
+                     for ln in body.splitlines())
+    else:
+        vol_ok = mounted_at in body
+    if not vol_ok:
+        return False
+
+    if "entrypoint" not in wired_at:
+        return True  # mount-only: the source-qualified mount is the artifact.
+
+    invoke = spec.get("invoke") or ""
+    if "--chat-template-file" in invoke:
+        flag = "--chat-template-file"
+    elif "--chat-template" in invoke:
+        flag = "--chat-template"
+    else:
+        return True  # no --chat-template flag style declared -> mount-only.
+    return _flag_names_mount(body, flag, mounted_at)
+
+
 def _spec_wiring_markers(patch: dict) -> tuple[list[str], list[str]]:
     """Derive (volume_markers, invoke_markers) from ``delivery_spec``.
 
@@ -494,6 +606,8 @@ def _spec_wiring_present(patch: dict, body: str) -> bool:
     spec = patch.get("delivery_spec")
     if not spec:
         return False
+    if patch.get("delivery_mechanism") == "chat_template":
+        return _chat_template_wired(patch, body)
     wired_at = spec.get("wired_at")
     if isinstance(wired_at, str):
         wired_at = [wired_at]
