+# ---------------------------------------------------------------------------
+# #1610 follow-up — chat_template negative controls. A bare `--chat-template`
+# flag and a shared container target / `/chat_template.jinja` suffix used to
+# make every chat-template patch "reach" every compose that mounts SOME
+# template (qwen38 109, apex 91, glm53 91 on master). Each must NOT reach a
+# compose that runs a DIFFERENT patch's template — controls that fail on the
+# pre-fix code.
+# ---------------------------------------------------------------------------
+def _cpath(slug):
+    e = COMPOSE_REGISTRY.get(slug)
+    if not e:
+        return None
+    return root / (e["compose_path"] if isinstance(e, dict) else e)
+
+
+_CT_NEG = [
+    # (patch id, slug whose compose mounts a DIFFERENT template)
+    ("qwen38-reasoning-effort-template", "vllm/gemma-31b-dual"),
+    ("apex-qwen-chat-template", "vllm/gemma-31b-dual"),
+    ("glm53-minja-numeric-index", "vllm/gemma-31b-dual"),
+    ("apex-qwen-chat-template", "vllm/dual"),
+    ("glm53-minja-numeric-index", "vllm/dual"),
+]
+for _pid, _slug in _CT_NEG:
+    _patch = _pmap.get(_pid)
+    _path = _cpath(_slug)
+    if _patch is None or _path is None or not _path.exists():
+        errors.append(f"#1610 chat_template control: {_pid} / {_slug} no longer exist")
+        continue
+    if pa.reaches(root, _patch, str(_path)):
+        errors.append(
+            f"#1610: {_pid} still 'reaches' {_slug}, which ships a DIFFERENT "
+            f"chat template (a bare --chat-template flag / shared target must "
+            f"not count)"
+        )
+
 arch_allowed_keys = pa.ARCH_ALLOWED_KEYS
 arch_required = pa.ARCH_REQUIRED_KEYS
