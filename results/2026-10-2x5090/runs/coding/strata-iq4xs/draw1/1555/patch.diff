+# ── which container publishes $URL, and what its engine actually booted with ──
+# The card named the wrong box twice on the #1537 rig: `CONTAINER` came from a
+# `vllm-(qwen|gemma)` name heuristic (an SGLang container was never found) and
+# `_spec_fp` grepped `Cmd` for --speculative-config (the Qwen3.8 vLLM composes
+# build that flag inside their entrypoint from SPEC_N, so it never appears in
+# Cmd). Both fixes read from `docker ps` / `docker logs` / the engine's own HTTP
+# introspection instead of the container name or Cmd.
+def _url_port(url):
+    """The port in ``url`` (``http://h:8020/v1`` -> ``"8020"``), or None."""
+    m = re.search(r"://[^/:]+:(\d+)\b", url or "")
+    return m.group(1) if m else None
+
+
+def container_for_url(url):
+    """Name of the running container that publishes $URL's port, or "". Reads a
+    single `docker ps` (any engine — docker or podman) and matches the published
+    HOST port of each container's Ports column. Empty when $URL has no port, when
+    docker can't be asked, or when no running container publishes that port."""
+    port = _url_port(url)
+    if not port:
+        return ""
+    try:
+        r = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}|{{.Ports}}"],
+            capture_output=True, text=True, timeout=10,
+            encoding="utf-8", errors="replace",
+        )
+    except Exception:
+        return ""
+    if r.returncode != 0:
+        return ""
+    for line in r.stdout.splitlines():
+        name, sep, ports = line.partition("|")
+        if not sep:
+            continue
+        name = name.strip()
+        if not name:
+            continue
+        # Published host ports: 0.0.0.0:8020->8000/tcp, [::]:8020->8000/tcp -> {8020}
+        if port in set(re.findall(r":(\d+)\s*(?:->|→)", ports)):
+            return name
+    return ""
+
+
+def _get_url_json(url):
+    """GET $url parsed as JSON, or None on any failure (timeout, non-200, bad JSON)."""
+    try:
+        with urllib.request.urlopen(url, timeout=5) as resp:
+            return json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+
+
+def _docker_logs_head(container, lines=1200):
+    """The first ``lines`` lines of `docker logs $container` (stdout+stderr), or "".
+    Read WITHOUT --tail: the vLLM engine-config line (speculative_config=…) is at the
+    HEAD of boot, where engine_stats/detect_kv's tail reads never see it."""
+    if not container:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "logs", container],
+            capture_output=True, text=True, timeout=30,
+            encoding="utf-8", errors="replace",
+        )
+    except Exception:
+        return ""
+    # Slice each stream's head before combining: vLLM prints the config line to
+    # stderr, so a huge stdout progress stream must not push it out of the window.
+    head = "\n".join((out.stdout or "").splitlines()[:lines])
+    head += "\n" + "\n".join((out.stderr or "").splitlines()[:lines])
+    if not head.strip():
+        txt = (out.stdout or "") + (out.stderr or "")
+        head = "\n".join(txt.splitlines()[-lines:])
+    return head
+
+
+def _vllm_spec_label(container):
+    """Spec-decode label from the vLLM engine-config line, or None when the line
+    is not in the log head (not vLLM, still booting, or logs unreadable).
+
+    `Initializing a V1 LLM engine … with config: … speculative_config=
+    SpeculativeConfig(method='mtp', …, num_spec_tokens=4)` -> 'MTP n=4'; a plain
+    `speculative_config=None` -> 'spec off'. Read at the HEAD of the log, not the
+    tail — the config line is printed once at engine init and scrolls away."""
+    head = _docker_logs_head(container)
+    if not head:
+        return None
+    i = head.find("Initializing a V1 LLM engine")
+    if i < 0:
+        return None
+    j = head.find("speculative_config=", i)
+    if j < 0:
+        return None
+    after = head[j + len("speculative_config="):].lstrip()
+    if after.startswith("None"):
+        return "spec off"
+    if after.startswith("SpeculativeConfig"):
+        seg = after[:600]
+        m = re.search(r"method=['\"]([^'\"]+)['\"]", seg)
+        n = re.search(r"num_spec(?:ulative_)?tokens=(\d+)", seg)
+        method = (m.group(1) if m else "spec").upper()
+        return f"{method} n={n.group(1)}" if n else method
+    return None
+
+
+def _sgl_spec_label(url):
+    """Spec-decode label from SGLang's GET $URL/get_server_info, or None when the
+    endpoint is unreadable (vLLM 404s it, so this cleanly hands off to _vllm_spec_label).
+
+    `speculative_algorithm` + `speculative_num_steps` -> '<ALGO> n=<steps>'; EAGLE over
+    the target's own checkpoint (no separate draft path, or draft == model) is the MTP
+    head -> 'MTP n=<steps>'; no algorithm reported -> 'spec off'."""
+    info = _get_url_json((url or "").rstrip("/") + "/get_server_info")
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    if not algo:
+        return "spec off"
+    steps = info.get("speculative_num_steps")
+    draft = (info.get("speculative_draft_model_path") or "").strip().rstrip("/")
+    model = (info.get("model_path") or "").strip().rstrip("/")
+    method = str(algo).strip().upper()
+    # EAGLE/EAGLE3 pointed at the target's own checkpoint == the model's MTP head.
+    if method in ("EAGLE", "EAGLE3") and (not draft or (model and draft == model)):
+        method = "MTP"
+    return f"{method} n={steps}" if steps else method
+
+
+def spec_label(container, url):
+    """The speculative-decoding label for the running engine, or "" when neither
+    source is readable. vLLM: the engine-config line in the container log head.
+    SGLang: the server's own /get_server_info. vLLM wins when its config line is
+    present; otherwise fall through to the HTTP introspection (SGLang)."""
+    v = _vllm_spec_label(container)
+    if v is not None:
+        return v
+    s = _sgl_spec_label(url)
+    if s is not None:
+        return s
+    return ""
+
+
