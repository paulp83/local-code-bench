+def gpu_fingerprint(container=None):
+    """GPU label scoped to the container's cards, e.g. '1× GeForce RTX 3060'.
+
+    Matches the historical '<n>× <first name>' shape (NVIDIA prefix stripped);
+    when the container cannot be resolved it reports rig-wide and appends a
+    '(all host GPUs)' note so a multi-GPU rig is never silently mislabelled."""
+    sel = container_gpu_selectors(container)
+    try:
+        out = subprocess.run(
+            _nvidia_smi_cmd(sel, "name", nounits=False),
+            capture_output=True,
+            text=True,
+            timeout=10,
+        ).stdout
+    except Exception:
+        return "? GPU"
+    names = [re.sub(r"^NVIDIA ", "", n.strip()) for n in out.splitlines() if n.strip()]
+    if not names:
+        return "? GPU"
+    label = f"{len(names)}× {names[0]}"
+    if not sel:
+        label += " (all host GPUs)"
+    return label
+
