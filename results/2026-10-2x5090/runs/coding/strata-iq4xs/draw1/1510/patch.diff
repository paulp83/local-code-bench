+            ["docker", "inspect", container],
+            capture_output=True,
+            text=True,
+            timeout=10,
+        ).stdout
+        if not out.strip():
+            return None
+        data = json.loads(out)
+    except Exception:
+        return None
+    if isinstance(data, list):
+        return data[0] if data else None
+    return data
+
+
+def container_gpu_selectors(container=None):
+    """Host GPU indices/UUIDs the container's CUDA sees, in CUDA order.
+
+    Resolved from docker inspect: HostConfig.DeviceRequests[].DeviceIDs (the
+    --gpus path) first, then NVIDIA_VISIBLE_DEVICES, remapped by
+    CUDA_VISIBLE_DEVICES. None means "could not resolve / all GPUs" — callers
+    fall back to rig-wide and should say so."""
+    if container is None:
+        container = _env("CONTAINER")
+    container = (container or "").strip()
+    if not container:
+        return None
+    ckey = ("sel", container)
+    if ckey in _GPU_SCOPE_CACHE:
+        return _GPU_SCOPE_CACHE[ckey]
+    sel = None
+    info = _inspect_container(container)
+    if isinstance(info, dict):
+        base = None
+        for req in (info.get("HostConfig") or {}).get("DeviceRequests") or []:
+            if req.get("DeviceIDs"):
+                base = [str(x) for x in req["DeviceIDs"]]
+        cenv = {}
+        for entry in (info.get("Config") or {}).get("Env") or []:
+            key, sep, value = str(entry).partition("=")
+            if sep and value.strip():
+                cenv[key] = value.strip()
+        nvd = cenv.get("NVIDIA_VISIBLE_DEVICES", "")
+        if base is None and nvd and nvd.strip().lower() not in ("all", "void", "none"):
+            base = [v.strip() for v in nvd.split(",") if v.strip()]
+        cvd = cenv.get("CUDA_VISIBLE_DEVICES", "")
+        if cvd:
+            picks = [v.strip() for v in cvd.split(",") if v.strip()]
+            if base is not None and all(p.isdigit() for p in picks):
+                base = [base[int(p)] for p in picks if int(p) < len(base)]
+            elif base is None:
+                base = picks
+        sel = base or None
+    _GPU_SCOPE_CACHE[ckey] = sel
+    return sel
+
+
+def _nvidia_smi_cmd(scope, query, nounits=True):
+    """nvidia-smi query command scoped to `scope` (list of ids) or rig-wide."""
+    fmt = "csv,noheader" + (",nounits" if nounits else "")
+    cmd = ["nvidia-smi", "--query-gpu=" + query, "--format=" + fmt]
+    if scope:
+        cmd += ["-i", ",".join(str(s) for s in scope)]
+    return cmd
+
+
