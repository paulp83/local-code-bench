+def vram_used_per_card_mb(container=None):
+    """[(index, name, used_mb)] for the container's GPUs (bench per-card peaks)."""
+    sel = container_gpu_selectors(container)
+    rows = []
+    try:
+        out = subprocess.run(
+            _nvidia_smi_cmd(sel, "index,name,memory.used"),
+            capture_output=True,
+            text=True,
+            timeout=10,
