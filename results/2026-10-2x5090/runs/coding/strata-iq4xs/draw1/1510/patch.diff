+    for line in out.splitlines():
+        cells = [c.strip() for c in line.split(",")]
+        if len(cells) >= 3:
+            try:
+                rows.append((cells[0], cells[1], int(cells[2])))
+            except ValueError:
+                continue
+    return rows
