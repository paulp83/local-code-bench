+# --- GPU scoping (the probed container's cards, not the whole rig) ----------
+# On a multi-GPU rig an unrelated service on another card must not be attributed
+# to the container under test: a rig-wide memory.used sum can fail a clean run's
+# VRAM-leak gate (or hide a real leak), and labelling every GPU with GPU 0's name
+# reports the wrong hardware. We resolve the host GPUs the container's CUDA can
+# actually see and scope every nvidia-smi query to them. When nothing can be
+# resolved we fall back to rig-wide and SAY SO, never silently mislabel.
+_GPU_SCOPE_CACHE: dict = {}
+
+
+def _inspect_container(container):
+    """docker inspect <container> -> first JSON object, or None on any failure."""
+    if not container:
+        return None
     try:
         out = subprocess.run(
-            [
-                "nvidia-smi",
-                "--query-gpu=memory.used",
-                "--format=csv,noheader,nounits",
