+# A rung-1 failure of the "the tool itself isn't here" kind: the `hf` binary is
+# missing (`_hf_download` synthesises rc=127 + this notice when neither `hf`
+# nor `huggingface-cli` resolves) or a shell reports command-not-found. This is
+# NOT the too-large policy wall — it is a missing binary — and rung 3 (raw
+# resolve + curl + the sha256 gate) has NO dependency on `hf`, so unlike an
+# auth or disk error this failure is FALLBACK-ELIGIBLE: escalating can actually
+# serve the pull.
+_COMMAND_NOT_FOUND_MARKERS = (
+    "on path",            # "neither `hf` ... is on PATH" / "not found on PATH"
+    "command not found",  # the shell's own words (rc 127)
+    "is not recognized",  # cmd.exe's wording
+    "can't open",         # "python: can't open file 'hf'"
+    "cannot open",
+)
+
+
+def is_command_not_found(blob: str, rc: Optional[int] = None) -> bool:
+    """True iff a rung-1 `hf download` failed because the tool is unavailable
+    (missing binary / command-not-found), NOT because of an auth, disk or
+    size error.
+
+    `rc == 127` is the conventional shell code for command-not-found and is
+    authoritative on its own; the textual markers catch wrappers that exit a
+    different code but print the words. Deliberately NOT matching a bare
+    "not found" — that would swallow a 404 (repo/file missing), which rung 3
+    cannot fix either and which must keep its own clear error."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return any(m in low for m in _COMMAND_NOT_FOUND_MARKERS)
+
+
