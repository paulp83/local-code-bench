+# ── Catalog provenance (origin) — first-class, #1202 P2 ───────────────────────
+# WHERE an entry lives, independent of its SLUG. Two closed values:
+#   ORIGIN_CORE  — curated: git-tracked in scripts/lib/profiles/registry.yaml.
+#   ORIGIN_LOCAL — community: the gitignored scripts/lib/profiles-local/ layer.
+#
+# This used to be INFERRED from the slug prefix (a `local/` namespace), which
+# tied provenance to slug SHAPE and forced `export_pr.py` to RENAME on publish
+# (strip `local/`, prefix the engine namespace). With origin as a field, a
+# later slug hard-cut (P3 — local slugs move to `<engine>/<name>`) collapses
+# that arithmetic to identity: PUBLISH BECOMES A VALUE FLIP, NOT A RENAME, and a
+# user's scripts / notes / compose pins survive it. The merge below is CORE-WINS:
+# a curated entry is never shadowed by a same-slug local one — the catalog you
+# ship is the catalog that wins.
+ORIGIN_CORE = "core"
+ORIGIN_LOCAL = "local"
+ORIGIN_VALUES = (ORIGIN_CORE, ORIGIN_LOCAL)
