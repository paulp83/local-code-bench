   return 1
 }
+
+# url_names_this_host URL — exit 0 when the URL's host is this machine: loopback, or one of the
+# addresses `hostname -I` reports. ports_serve_url applies the same rule to a published mapping;
+# this asks it on its own, so a caller can tell "that URL is another machine" (say so, and leave
+# the container facts unknown) from "this local port has no container" (#1584 follow-up).
+url_names_this_host() {
+  local host port addrs a own
+  read -r host port < <(url_host_port "${1:-}")
+  [[ -n "$port" ]] || return 1
+  addrs="$(_host_addrs "$host")"
+  [[ -n "$addrs" ]] || return 1
+  own=" $(hostname -I 2>/dev/null) "
+  while IFS= read -r a; do
+    [[ -n "$a" ]] || continue
+    if [[ "$a" == 127.* || "$a" == ::1 || "$own" == *" ${a} "* ]]; then
+      return 0
+    fi
+  done <<<"$addrs"
+  return 1
+}
