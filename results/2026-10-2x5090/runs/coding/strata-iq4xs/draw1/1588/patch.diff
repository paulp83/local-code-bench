+# #1584 follow-up, the script half: the name fallback that used to sit behind the port match bound
+# a container for a URL it never served. Driving the real script at a remote URL with a local vLLM
+# on :8020 (--max-num-seqs 4) must therefore end at "cannot detect the served slot count" — not at
+# `CONCURRENCY=4 (detected: container max-num-seqs)`. curl is stubbed so the dead remote host costs
+# no timeouts.
+URL_STUB="$(mktemp -d)"
+cat > "$URL_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  ps) echo "vllm-qwen36-27b-single|0.0.0.0:8020->8000/tcp" ;;
+  inspect) echo "vllm serve /m --max-num-seqs 4 --max-model-len 32768" ;;
+  *) exit 0 ;;
+esac
+DOCK
+cat > "$URL_STUB/curl" <<'CURL'
+#!/usr/bin/env bash
+exit 28
+CURL
+chmod +x "$URL_STUB/docker" "$URL_STUB/curl"
+command grep -qF -- 'club_container_for_url' "$PROBE" \
+  || fail "concurrency-probe.sh no longer asks the shared host-aware picker (club_container_for_url)"
+set +e
+out="$(PATH="$URL_STUB:$PATH" CONCURRENCY_PROBE_RECORD=0 URL=http://10.9.9.9:8020 MODEL=m bash "$PROBE" 2>&1)"; rc=$?
+set -e
+[[ "$rc" == "2" ]] || fail "a remote URL with no container here should FATAL on the slot count, got $rc: $out"
+command grep -q "detected: container max-num-seqs" <<<"$out" \
+  && fail "a remote URL bound the LOCAL container's --max-num-seqs (#1584 follow-up): $out"
+command grep -q "no running container publishes" <<<"$out" \
+  || fail "a remote URL should say that no container here serves it: $out"
+# The same URL with a container that DOES serve it keeps the container facts.
+set +e
+out="$(PATH="$URL_STUB:$PATH" CONCURRENCY_PROBE_RECORD=0 URL=http://localhost:8020 MODEL=m CONCURRENCY= bash "$PROBE" 2>&1)"; rc=$?
+set -e
+command grep -q "CONCURRENCY=4 (detected: container max-num-seqs)" <<<"$out" \
+  || fail "a local URL must still bind the container publishing it: $out"
+rm -rf "$URL_STUB"
+echo "  ✓ container picked by URL host AND port; no name fallback (a remote URL binds nothing)"
