+model_list:
+  # === Current serving primaries (one GPU service runs at a time per gpu-mode;
+  #     routes to the inactive backends fail until that mode is brought up) ===
+  #
+  # LOCAL block policy (#1078): routes between the GENERATED markers below are
+  # derived from the registry by scripts/lib/litellm-emit.sh — never hand-edit
+  # them; flip compose_registry._entry(gateway=True) and regenerate instead.
+  # `litellm-emit.sh --check` gates the region against drift. Routes BELOW the
+  # END marker are hand-maintained: local models not yet gateway-flagged in
+  # compose_registry (today only agents-a1) plus the cloud block at the bottom.
+  # Non-functional scenes still emit a route, annotated `# status: <status>`.
+  #
+  # Qwen 3.6 27B — MTP n=3 + fp8/int8-PTH KV + 262K + vision.
+  # Started by `gpu-mode 27b` → vllm-qwen36-27b-dual at :8010. Stack default.
+  # NOTE: EVERY 27b scene (autoround / fp8 / awq / lmcache) serves the neutral shared
+  # primary `qwen3.6-27b` (+ its own quant-specific name as an alias), so this route
+  # matches whichever scene is on :8010 regardless of quant (#482/#490). The quant
+  # differs by compose path/port + the scene's alias, NOT by the primary name.
+  #
+  # Local qwen3.8-27b (#1062) — the dual-max scene on :8091 serves BOTH served-names.
+  # ⚠️ Scene-dependent port: :8091 is the dual-max slug; other qwen3.8 slugs serve on their
+  # own registry default_port (dual-fast 8113, iq4xs 8090, …). The gateway lists one canonical
+  # port per model, same as every other local backend here.
+  # === BEGIN GENERATED LOCAL BLOCK — RUNTIME VIEW, rendered by scripts/lib/litellm-sync.sh ===
+  # Routes for endpoints that answered /v1/models at render time. Names come
+  # from each server's own model list, so a slug with no registry served_name
+  # still gets a route. Regenerated on every switch.sh launch and teardown.
+  # DO NOT EDIT — edit services/litellm/config.yaml (the catalog view) instead.
+  # (nothing serving right now — no local routes)
+  # === END GENERATED LOCAL BLOCK ===
+
+
+  # Agents-A1 — InternScience 35B agentic MoE (⚠️ caveats; the agentic thinking-ON
+  # specialist). Launched via `switch.sh vllm/agents-a1-dual` → vllm-agents-a1-dual
+  # at :8072 (own port — never share a sibling's; see the slug-masquerade note).
+  # Still hand-maintained: agents-a1 is not yet gateway-flagged in compose_registry.
+litellm_settings:
+  # A coding agent's turn can be a long cold prefill plus a 32K-token reply at
+  # ~70 tok/s — well past a short default. The client (omp, claude) owns the real
+  # timeout; the gateway must not cut the request first.
+  request_timeout: 1800
+  # Never re-send a failed request: on a local GPU a retry repeats the whole
+  # prefill, doubling the wait, and it lands on a server that just failed.
+  num_retries: 0
