diff --git a/scripts/lib/profiles/rename.py b/scripts/lib/profiles/rename.py
new file mode 100755
index 0000000..e02e610
--- /dev/null
+++ b/scripts/lib/profiles/rename.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Local-layer RENAME — the shadowing remedy #1204 promised (#1202 P7).
+
+When ``git pull`` ships a curated slug whose name a local model already uses,
+the local row is **shadowed**: core wins the lookup and the row is kept and
+marked, so ``switch.sh --list`` can say so and the user can rename it. The
+listing said it for two releases; nothing could do it. promote.py refuses every
+"already exists" case and demote.py only removes, so the advertised remedy — the
+one thing that makes "kept, not deleted" a kindness rather than a dead end — was
+unreachable.
+
+    python3 scripts/lib/profiles/rename.py --slug vllm/minimal --to vllm/my-minimal
+    python3 scripts/lib/profiles/rename.py --slug vllm/minimal --to vllm/my-minimal --dry-run
+    python3 scripts/lib/profiles/rename.py --slug vllm/minimal --to vllm/mine --model-id my-model
+
+The rename keeps the WHOLE entry consistent, not just the lookup key:
+
+  * ``registry.local.json`` — the slug key (in place, order preserved) and the
+    kwargs that encode the name (``model`` / ``compose_path`` / ``engine``);
+  * ``models.d/<id>.yml`` — moved with its ``id:`` line rewritten (with --model-id);
+  * ``composes/<id>/`` — the tree moved (and ``<engine>/`` with it when the rename
+    changes the engine namespace), so the entry never points at a deleted compose;
+  * ``engines.d/<engine>.yml`` — follows an engine-namespace rename when no other
+    local row still uses that engine (the same rule catalog.sh applies on
+    unregister).
+
+Refuses (exit 3, writes NOTHING) when the slug is not in the local layer
+(a curated slug — git is its editor), when the target slug is taken (local or
+curated — renaming a shadow into another shadow fixes nothing), when a new
+model id collides with a core model, or when the shape is not
+``<engine>/<name>``. Post-write failures exit 2 after a best-effort rollback.
+
+Field edits that are NOT renames live beside it:
+``update.py --slug <slug> --set default_port=20231``.
+
+Success marker::
+
+    RENAME_OK <new-slug>
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+from typing import Optional
+
+# Same-directory import: this script runs as `python3 scripts/lib/profiles/
+# rename.py`, so its dir is on sys.path — but the tests import it as a package
+# module, hence the dual form (promote.py / export_pr.py do the same).
+try:  # package context
+    from scripts.lib.profiles.update import (  # noqa: F401
+        EXIT_COLLISION,
+        EXIT_INTERNAL,
+        InternalError,
+        Refusal,
+        confirm,
+        plan_rename,
+        rename_local,
+    )
+except ImportError:  # direct-script context
+    from update import (  # noqa: F401
+        EXIT_COLLISION,
+        EXIT_INTERNAL,
+        InternalError,
+        Refusal,
+        confirm,
+        plan_rename,
+        rename_local,
+    )
+
+_DEFAULT_ROOT = Path(__file__).resolve().parents[3]
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    ap = argparse.ArgumentParser(
+        prog="rename.py",
+        description=(
+            "Rename a LOCAL catalog entry in place — the remedy for a slug a "
+            "curated entry now shadows. The curated catalog is unreachable from "
+            "here: a slug absent from registry.local.json is refused before "
+            "anything is read."
+        ),
+    )
+    ap.add_argument("--slug", "--from", "--old", dest="slug", required=True,
+                    metavar="SLUG", help="the current local <engine>/<name> slug")
+    ap.add_argument("--to", "--new", dest="to", metavar="NEW_SLUG", default=None,
+                    help="the new <engine>/<name> slug")
+    ap.add_argument("--model-id", default=None,
+                    help="also rename the MODEL id, moving models.d/<id>.yml and "
+                         "composes/<id>/ with it")
+    ap.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root")
+    ap.add_argument("--dry-run", action="store_true",
+                    help="print the plan, write nothing")
+    ap.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
+    args = ap.parse_args(argv)
+
+    if not args.to and not args.model_id:
+        ap.error("rename needs --to <engine>/<name> and/or --model-id <id>")
+
+    root = Path(args.root).resolve()
+    if not args.yes and not args.dry_run and sys.stdin.isatty():
+        if not confirm("rename", args.slug, tag="rename"):
+            print("[rename] aborted — nothing changed", file=sys.stderr)
+            return EXIT_COLLISION
+    try:
+        plan = rename_local(root, args.slug, args.to, model_id=args.model_id,
+                            dry_run=args.dry_run)
+    except Refusal as exc:
+        print(f"[rename] refused: {exc}", file=sys.stderr)
+        return EXIT_COLLISION
+    except InternalError as exc:
+        print(f"[rename] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    if not args.dry_run:
+        print(f"RENAME_OK {plan['slug_to']}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
