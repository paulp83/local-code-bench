diff --git a/scripts/tests/test-report-gpu-holder.sh b/scripts/tests/test-report-gpu-holder.sh
new file mode 100755
index 0000000..582bd48
--- /dev/null
+++ b/scripts/tests/test-report-gpu-holder.sh
@@ -0,0 +1,210 @@
+#!/usr/bin/env bash
+# test-report-gpu-holder — each GPU's VRAM is attributed to the PROCESS that
+# holds it, never to "the one running club container" (#1537).
+#
+# Why this test exists. #1537's report said GPUs 0 and 2 were "held by running
+# `sglang-cmp170hx`". That container could only see GPU 1; `nvidia-smi` showed
+# another container's `VLLM::Worker_TP0/1` on 0 and 2. report.sh had found ONE
+# running club container and credited it with every card above 100 MiB, so the
+# reporter blamed their own engine for a foreign container's VRAM while the
+# foreign container — the actual fault — was never mentioned.
+#
+# Contract asserted here:
+#   - a card is credited to a container ONLY when one of that container's own
+#     processes is on it (the "(held by running `X`)" wording survives for the
+#     cards X really holds, so a correct report still reads the same);
+#   - a card held by a foreign container names that container, and says out
+#     loud that it is NOT the club container;
+#   - a card with memory in use and no compute process on it is never blamed on
+#     a container (that is display/graphics memory, or something hidden);
+#   - when nothing can be read (no docker, unreadable cgroups) the report says
+#     the holder is unidentifiable rather than guessing "ours";
+#   - an idle card still renders ✓, and a rig with no nvidia-smi still reports.
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0; FAIL=0
+ok() { PASS=$((PASS+1)); }
+no() { echo "FAIL: $1" >&2; FAIL=$((FAIL+1)); }
+has()   { if [[ "$2" == *"$3"* ]]; then ok; else no "$1: missing '$3'"; fi; }
+hasnt() { if [[ "$2" != *"$3"* ]]; then ok; else no "$1: must NOT contain '$3'"; fi; }
+
+# shellcheck source=fixtures/report-harness/report-env.sh
+source "${ROOT_DIR}/scripts/tests/fixtures/report-harness/report-env.sh"
+report_env_init "$ROOT_DIR"
+trap report_env_cleanup EXIT
+
+# Two containers, one of ours and one not, and the host PIDs each owns. The
+# numbers are arbitrary: the docker stub below is what says which PID belongs
+# to which container, and nvidia-smi's stub is what says which PID is on which
+# card — that pairing is the whole behaviour under test.
+OURS=sglang-cmp170hx
+OTHER=vllm-other
+ID_OURS=2222222222222222222222222222222222222222222222222222222222222222
+ID_OTHER=1111111111111111111111111111111111111111111111111111111111111111
+PID_OTHER=41001          # cards 0 and 2 (with its TP sibling at +1), another
+PID_OURS=41003           # card 1, our engine
+PID_UNKNOWN=41004          # card 3, an owner nothing can resolve
+
+install_stubs() {
+  report_nvsmi_stub <<'EOSMI'
+#!/usr/bin/env bash
+args="$*"
+case "$args" in
+  *compute-apps=gpu_uuid*)
+    [[ "${MOCK_COMPUTE_APPS:-1}" == 1 ]] || { echo 'Field "compute_apps" is not a valid field to query.'; exit 2; }
+    echo "GPU-0, ${PID_OTHER}, VLLM::Worker_TP0, 22900"
+    echo "GPU-2, ${PID_OTHER_B}, VLLM::Worker_TP1, 22900"
+    echo "GPU-1, ${PID_OURS}, python3, 23000"
+    [[ "${MOCK_UNKNOWN_HOLDER:-0}" == 1 ]] && echo "GPU-3, ${PID_UNKNOWN}, python3, 1200"
+    exit 0 ;;
+  *compute-apps=pid*) exit 1 ;;
+  *index,uuid*)   echo "0, GPU-0"; echo "1, GPU-1"; echo "2, GPU-2"; echo "3, GPU-3"; echo "4, GPU-4"; exit 0 ;;
+  *index,memory.used*)
+    echo "0, 23000"; echo "1, 23000"; echo "2, 22900"; echo "3, ${MOCK_GPU3_USED:-400}"; echo "4, 0"; exit 0 ;;
+  "") echo "CUDA Version: 13.2"; exit 0 ;;
+  *) exit 0 ;;
+esac
+EOSMI
+  report_docker_stub <<'EOSDK'
+#!/usr/bin/env bash
+case "$*" in
+  *info*) exit 0 ;;
+  *"--no-trunc --format"*)
+    printf '%s %s\n' "$MOCK_ID_OTHER" "$OTHER"
+    printf '%s %s\n' "$MOCK_ID_OURS" "$OURS"
+    exit 0 ;;
+  *"top $OTHER "*) echo "$PID_OTHER"; echo "$PID_OTHER_B"; exit 0 ;;
+  *"top $OURS "*)  echo "$PID_OURS"; exit 0 ;;
+  *"ps --format {{.Names}}"*) echo "$OURS"; exit 0 ;;
+  *"ps --format {{.ID}} {{.Names}}"*)
+    printf '%s %s\n' "$MOCK_ID_OTHER" "$OTHER"
+    printf '%s %s\n' "$MOCK_ID_OURS" "$OURS"
+    exit 0 ;;
+esac
+exit 1
+EOSDK
+}
+
+export OURS OTHER ID_OURS ID_OTHER
+export PID_OTHER PID_OURS PID_UNKNOWN
+export PID_OTHER_B=$((PID_OTHER+1))   # 41002 — must not collide with PID_OURS
+export MOCK_ID_OURS="$ID_OURS" MOCK_ID_OTHER="$ID_OTHER"
+install_stubs
+
+# ── 1. THE #1537 STATE: three busy cards, ours holds exactly one of them ─────
+report_run --no-redact
+[[ "$REPORT_RC" -eq 0 ]] || no "#1537 report must still exit 0 (got $REPORT_RC)"
+
+# The two foreign cards name the foreign container and refuse to name ours as
+# the holder.
+gpu0="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 0 idle VRAM' || true)"
+gpu2="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 2 idle VRAM' || true)"
+has  "GPU 0 names the container that actually holds it" "$gpu0" "$OTHER"
+has  "GPU 2 names the container that actually holds it" "$gpu2" "$OTHER"
+has  "GPU 0 says it is not the club container"          "$gpu0" "NOT the running club container"
+has  "GPU 2 says it is not the club container"          "$gpu2" "NOT the running club container"
+hasnt "GPU 0 is not credited to our container"  "$gpu0" "held by running \`$OURS\`"
+hasnt "GPU 2 is not credited to our container"  "$gpu2" "held by running \`$OURS\`"
+has  "GPU 0 names the process that holds it" "$gpu0" "VLLM::Worker_TP0"
+has  "GPU 2 names the process that holds it" "$gpu2" "VLLM::Worker_TP1"
+
+# THE NEGATIVE CONTROL: the card our container really holds keeps the wording it
+# always had. Without this arm, a fix that simply stopped naming any container
+# would pass every assertion above.
+gpu1="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 1 idle VRAM' || true)"
+has "GPU 1 (ours) still reads 'held by running'" "$gpu1" "(held by running \`$OURS\`"
+has "GPU 1 names our process"                    "$gpu1" "pid ${PID_OURS}"
+
+# Idle cards are untouched, and the section never claims a holder for them.
+gpu4="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 4 idle VRAM' || true)"
+has "idle card still renders the check mark" "$gpu4" "0 MiB ✓"
+
+# ── 2. memory in use, no compute process on the card → never our fault ──────
+export MOCK_GPU3_USED=0
+report_run --no-redact
+[[ "$REPORT_RC" -eq 0 ]] || no "report with no display card exits 0"
+unset MOCK_GPU3_USED
+
+# GPU 3 has 400 MiB used and NO compute row: display memory. It must not be
+# credited to the running container.
+export MOCK_COMPUTE_APPS=1
+report_run --no-redact
+gpu3="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 3 idle VRAM' || true)"
+hasnt "a card with no compute process is not blamed on our container" "$gpu3" "held by running \`$OURS\`"
+has   "a card with no compute process says so" "$gpu3" "no CUDA compute process listed on this card"
+
+# ── 3. an unresolvable holder: stated as unknown, never as ours ─────────────
+export MOCK_UNKNOWN_HOLDER=1
+report_run --no-redact
+gpu3="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 3 idle VRAM' || true)"
+hasnt "an unresolvable holder is not blamed on our container" "$gpu3" "held by running \`$OURS\`"
+has   "an unresolvable holder is called out" "$gpu3" "NOT identifiable"
+unset MOCK_UNKNOWN_HOLDER
+
+# ── 4a. our container is running but holds NONE of the busy cards ───────────
+install_stubs
+report_docker_stub <<'EOSDK1B'
+#!/usr/bin/env bash
+case "$*" in
+  *info*) exit 0 ;;
+  *"--no-trunc --format"*)
+    printf '%s %s\n' "$MOCK_ID_OTHER" "$OTHER"
+    printf '%s %s\n' "$MOCK_ID_OURS" "$OURS"
+    exit 0 ;;
+  *"top $OTHER "*) echo "$PID_OTHER"; echo "$PID_OTHER_B"; exit 0 ;;
+  *"top $OURS "*)  exit 0 ;;      # our container owns no process on any card
+  *"ps --format {{.Names}}"*) echo "$OURS"; exit 0 ;;
+  *"ps --format {{.ID}} {{.Names}}"*)
+    printf '%s %s\n' "$MOCK_ID_OTHER" "$OTHER"
+    printf '%s %s\n' "$MOCK_ID_OURS" "$OURS"
+    exit 0 ;;
+esac
+exit 1
+EOSDK1B
+report_run --no-redact
+hasnt "no card is credited to a container that holds none of them" "$REPORT_OUT" "held by running \`$OURS\`"
+has   "the report says out loud that our container holds nothing" "$REPORT_OUT" "holds NO VRAM on these cards"
+
+# ── 4. NO docker at all: honest "cannot tell", not "ours" ───────────────────
+report_docker_stub <<'EOSDK2'
+#!/usr/bin/env bash
+exit 1
+EOSDK2
+report_run --no-redact
+[[ "$REPORT_RC" -eq 0 ]] || no "no-docker report must still exit 0 (got $REPORT_RC)"
+hasnt "with no docker nothing is credited to a running container" "$REPORT_OUT" "held by running"
+gpu0="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 0 idle VRAM' || true)"
+has  "with no docker the holder is still named by process" "$gpu0" "VLLM::Worker_TP0"
+
+# ── 5. --query-compute-apps unsupported: UNKNOWN, never an idle card ────────
+export MOCK_COMPUTE_APPS=0
+report_docker_stub <<'EOSDK3'
+#!/usr/bin/env bash
+exit 1
+EOSDK3
+report_nvsmi_stub <<'EOSMI2'
+#!/usr/bin/env bash
+args="$*"
+case "$args" in
+  *compute-apps*) echo 'Field "compute_apps" is not a valid field to query.'; exit 2 ;;
+  *index,memory.used*) echo "0, 23000"; echo "1, 0"; exit 0 ;;
+  "") echo "CUDA Version: 13.2"; exit 0 ;;
+  *) exit 0 ;;
+esac
+EOSMI2
+report_run --no-redact
+[[ "$REPORT_RC" -eq 0 ]] || no "unreadable compute-apps must still exit 0 (got $REPORT_RC)"
+gpu0="$(printf '%s\n' "$REPORT_OUT" | command grep 'GPU 0 idle VRAM' || true)"
+has   "a failed compute-apps query is reported as unknown" "$gpu0" "UNKNOWN"
+hasnt "a busy card is never rendered as held by our container" "$gpu0" "held by running"
+unset MOCK_COMPUTE_APPS
+
+echo "----------------------------------------"
+echo "PASS: $PASS  FAIL: $FAIL"
+[[ "$FAIL" -eq 0 ]] || exit 1
+echo "OK: report.sh per-GPU VRAM attribution"
