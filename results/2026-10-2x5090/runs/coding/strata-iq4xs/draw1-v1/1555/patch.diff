+# ── which drafter the container is running (#1537) ────────────────────────────
+# The card said "spec off" on a rig serving MTP n=4. The old check grepped the
+# container's `.Config.Cmd` for `--speculative-config`, and that flag is NOT in
+# the Cmd: every club-3090 vLLM compose builds it inside its ENTRYPOINT script
+# from SPEC_N (`SPEC_ARGS=(--speculative-config "{…"num_speculative_tokens":$_spec_n…}")`),
+# and compose maps `entrypoint:` to `.Config.Entrypoint` — so the Cmd carries
+# only the `command:` half of the launch. The SGLang composes invert the split:
+# the whole launch script IS the Cmd, the flags sit in a `"${SPEC[@]}"` array and
+# the depth in `${SPEC_N:-4}`, so neither the method nor n can be read off a flat
+# flag list either. Read, in decreasing order of authority:
+#   1. what the ENGINE applied — its own startup dump (`non-default args:` for
+#      vLLM, `server_args=` for SGLang, the same two dumps run_context.py reads).
+#      A dump that parsed and named no drafter IS a real "spec off", not a gap.
+#   2. what the container RECEIVED — `.Config.Entrypoint` + `.Config.Cmd` +
+#      `.Config.Env`, resolving the depth the way the launch script resolves it:
+#      env SPEC_N when non-empty, else the script's own `${SPEC_N:-4}` default, so
+#      the default is read from the compose that ships it instead of being
+#      hardcoded here (test-spec-depth-default-drift.sh: those defaults differ);
+#   3. the COMPOSE's own verdict, the `[spec] drafter ON - mtp n=4` line its
+#      entrypoint echoes into the log — same authority as (2), reached only when
+#      `docker inspect` says nothing (its method names are matched by a
+#      vocabulary, so it reads after the argv it describes).
+# Absence of evidence stays distinguishable from evidence of absence: "spec ?"
+# when nothing was readable, "spec off" when a launch was read and carries none.
+SPEC_OFF = "spec off"
+SPEC_UNKNOWN = "spec ?"
+
+# Engine method names -> the label this repo prints them under. Anything else is
+# echoed upper-cased rather than dropped: a drafter this file has never heard of
+# must still read as a drafter on the card.
+SPEC_METHOD_LABELS = {
+    "mtp": "MTP",
+    "eagle": "EAGLE", "eagle1": "EAGLE", "eagle2": "EAGLE", "eagle3": "EAGLE3",
+    "dflash": "DFlash", "dflash2": "DFlash2", "dspark": "DSpark",
+    "ngram": "ngram", "medusa": "Medusa", "standalone": "Standalone",
+}
+# Longest first: `dflash2` must not match as `dflash`, `eagle3` not as `eagle`.
+SPEC_METHOD_WORDS = sorted(SPEC_METHOD_LABELS, key=len, reverse=True)
+
+
+def _spec_label(method, n=None):
+    """'mtp'/4 -> 'MTP n=4'; a method this table does not know is upper-cased."""
+    if method is None:
+        return ""
+    raw = str(method).strip().strip("'\"{}")
+    if raw.lower().startswith("draft-"):
+        raw = raw[len("draft-"):]                       # llama.cpp: draft-mtp
+    if not raw:
+        return ""
+    label = SPEC_METHOD_LABELS.get(raw.lower(), raw.upper())
+    n = "" if n is None else str(n).strip().strip("'\"")
+    return f"{label} n={n}" if re.fullmatch(r"[0-9]+", n or "") else label
+
+
+def _dump_value(line, key):
+    """One value out of an engine startup dump, from either dump shape.
+
+    vLLM prints a dict literal (`'speculative_config': {'method': 'mtp', …}`),
+    SGLang a dataclass repr (`speculative_algorithm='EAGLE'`); the key is quoted
+    in the first and bare in the second. Regex rather than a dict parse so a line
+    truncated mid-dump still yields what it carries.
+    """
+    m = re.search(r"['\"]?\b%s\b['\"]?\s*[:=]\s*['\"]?([^,'\"})\s]+)" % re.escape(key),
+                  line or "")
+    return m.group(1).strip() if m else None
+
+
+def _last_line(text, marker):
+    """The LAST line of `text` carrying `marker` ("" when there is none).
+
+    `docker logs` of a restarted container holds every boot, and SPEC_N is a HOST
+    env var — so an older boot can name a different drafter than the one serving.
+    Every reader below scans the single line it is given, which is what makes
+    "the newest boot wins" the rule.
+    """
+    for ln in reversed((text or "").splitlines()):
+        if marker in ln:
+            return ln
+    return ""
+
+
+def spec_from_engine_dump(text):
+    """What the ENGINE says it applied — 'MTP n=4' / 'spec off' / "" (no dump)."""
+    text = text or ""
+    line = _last_line(text, "non-default args:")        # vLLM
+    if line:
+        if "speculative_config" in line:
+            lab = _spec_label(_dump_value(line, "method"),
+                              _dump_value(line, "num_speculative_tokens"))
+            if lab:
+                return lab
+        if "{" in line:
+            return SPEC_OFF       # vLLM printed its config; no drafter is in it
+    line = _last_line(text, "server_args=")             # SGLang
+    if line:
+        algo = _dump_value(line, "speculative_algorithm")
+        if algo and algo.lower() not in ("none", ""):
+            # The depth the compose calls SPEC_N is --speculative-num-steps.
+            # num_draft_tokens is steps+1 (it counts the token being verified).
+            n = _dump_value(line, "speculative_num_steps")
+            if n in (None, ""):
+                n = _dump_value(line, "speculative_num_draft_tokens")
+            return _spec_label(algo, n) or "spec on"
+        if "ServerArgs" in line or "server_args={" in line:
+            return SPEC_OFF
+    return ""
+
+
+def spec_from_echo(text):
+    """The compose's own verdict, echoed by its entrypoint into the container log:
+
+        [spec] drafter ON - mtp n=4, draft sampling probabilistic    (vLLM)
+        [spec] native MTP ON (n=4)                                   (SGLang)
+        [spec] drafter OFF (SPEC_N=0 / SPEC=off) - no speculative …  (both)
+
+    The LAST `[spec]` line wins (see _last_line). "" when the log has none — an
+    engine whose log scrolled past the boot, or a compose with no drafter toggle.
+    """
+    line = _last_line(text or "", "[spec]")
+    if not line:
+        return ""
+    if re.search(r"\bON\b", line):
+        n = re.search(r"\bn[ =]?=?\s*([0-9]+)", line)
+        for word in SPEC_METHOD_WORDS:
+            if re.search(r"\b%s\b" % re.escape(word), line, re.I):
+                return _spec_label(word, n.group(1) if n else None)
+        return "spec on"
+    if re.search(r"\bOFF\b", line):
+        return SPEC_OFF
+    return ""
+
+
+def _script_default(text, var):
+    """What a launch script falls back to for `${VAR:-<default>}`, following a
+    nested chain (`${SPEC_N:-${NUM_SPEC_TOKENS:-3}}`, the multi-card composes) the
+    way the shell does — every club-3090 entrypoint writes the default inline.
+    None when the text alone cannot know it (a bare `${SPEC_N}`)."""
+    body = text or ""
+    m = re.search(r"\$\{\s*" + re.escape(var) + r"\s*:-", body)
+    if not m:
+        return None
+    start, depth, i = m.end(), 1, m.end()
+    while i < len(body) and depth:
+        if body[i] == "{":
+            depth += 1
+        elif body[i] == "}":
+            depth -= 1
+        i += 1
+    default = body[start:i - 1].strip().strip('"').strip("'").strip()
+    if re.fullmatch(r"[0-9]+", default):
+        return int(default)
+    nested = re.match(r"\s*\$\{\s*([A-Za-z_][A-Za-z0-9_]*)\s*:-", default)
+    if nested:
+        return _script_default(default, nested.group(1))
+    return None
+
+
+def _spec_depth(text, env=None):
+    """The drafter depth a launch script would compute, or None.
+
+    Exactly how those scripts compute it: SPEC_N from the environment when it is
+    non-empty — the composes forward it BARE, so an unset host var arrives as the
+    empty string and the script's own default applies — `SPEC=off` forcing 0, and
+    otherwise `${SPEC_N:-<default>}`. The default is read from the compose that
+    ships it, never hardcoded here: the shipped depths run 1 through 7
+    (test-spec-depth-default-drift.sh guards the composes against drifting apart).
+    """
+    env = env or {}
+    raw = (env.get("SPEC_N") or "").strip()
+    if re.fullmatch(r"[0-9]+", raw):
+        return int(raw)
+    # A non-numeric SPEC_N hard-errors in every entrypoint (`exit 1`), so there is
+    # no honest depth in it — fall through to the script's own default.
+    if (env.get("SPEC") or "").strip().lower() in ("off", "false", "no", "0"):
+        return 0
+    for target in ("_spec_n", "_n", "spec_n"):
+        m = re.search(r"\b%s\s*=\s*"\s*\$\{\s*SPEC_N\s*:-" % target, text or "")
+        if m:
+            return _script_default(text[m.start():], "SPEC_N")
+    return _script_default(text, "SPEC_N")
+
+
+def _flag_value(body, *flags):
+    """A launch flag's value, with `${VAR:-value}` resolved the way the shell
+    resolves it (the prism compose passes `--spec-type "${SPEC_TYPE:-draft-mtp}"`).
+    None when the flag is absent, or when its value is a variable with no default
+    (`"$_spec_n"`) — the caller then falls back to _spec_depth.
+    """
+    for flag in flags:
+        m = re.search(r"--%s[\s=]+(\S+)" % re.escape(flag), body or "")
+        if not m:
+            continue
+        tok = m.group(1).strip().strip('"').strip("'").strip("\\").strip()
+        nested = re.match(r"^\$\{[A-Za-z_][A-Za-z0-9_]*:-(.*)\}$", tok)
+        if nested:
+            tok = nested.group(1).strip().strip('"').strip("'")
+        if not tok or tok.startswith(("$", "%", ")")):
+            return None
+        return tok
+    return None
+
+
+def _flag_int(body, *flags):
+    val = _flag_value(body, *flags)
+    return val if val is not None and re.fullmatch(r"[0-9]+", val) else None
+
+
+def spec_from_launch(text, env=None):
+    """'MTP n=4' from what the container received (Entrypoint + Cmd), or "".
+
+    ⚠️ Comment lines AND echo lines are dropped before extracting anything. Both
+    name flags in prose: the composes document "`--speculative-draft-model-
+    quantization` IS LOAD-BEARING" in comments — resolved_config.py strips them
+    for the same reason — and they echo the drafter's removal message, which
+    contains the literal text `--spec-type flags emitted`. Read as a flag, the
+    sentence announcing that a drafter was REMOVED reports a drafter.
+    """
+    text = text or ""
+    if not text.strip():
+        return ""
+    body = "\n".join(ln for ln in text.splitlines()
+                      if not re.match(r"\s*(#|echo\b|printf\b)", ln))
+    depth = _spec_depth(body, env)
+    if depth == 0:
+        # The flags live behind `if [ "$_spec_n" -gt 0 ]`, so a depth of 0 is the
+        # drafter being OFF even though the flag text is still in the script.
+        return SPEC_OFF
+    n = str(depth) if depth is not None else None
+
+    if "--speculative-config" in body:                                     # vLLM
+        cfg = re.search(r"--speculative-config[\s=]+(.*)", body)
+        blob = (cfg.group(1) if cfg else body).lower()
+        method = re.search(r'\\?"method\\?"\s*:\s*\\?"([a-z0-9_.-]+)', blob)
+        tok = re.search(r'\\?"num_speculative_tokens\\?"\s*:\s*\\?"?([0-9]+)', blob)
+        return _spec_label(method.group(1) if method else None,
+                           tok.group(1) if tok else n) or "spec on"
+    if "--speculative-algorithm" in body:                                   # SGLang
+        algo = _flag_value(body, "speculative-algorithm")
+        steps = _flag_int(body, "speculative-num-steps")
+        if steps is None:
+            steps = _flag_int(body, "speculative-num-draft-tokens")
+        return _spec_label(algo, steps or n) or "spec on"
+    kind = _flag_value(body, "spec-type")                          # llama.cpp family
+    if kind:
+        return _spec_label(kind, _flag_int(body, "spec-draft-n-max") or n) or "spec on"
+    if re.search(r"--spec\w*|--model-draft|--draft\b|(^|\s)-md(\s|$)", body, re.I):
+        # A drafter with no flag shape this file knows. Only words that name a
+        # DRAFTER and never a main model may be trusted by substring — `mtp`
+        # appears in main-model filenames (`…-MTP-Q8_0.gguf`), and the old Cmd
+        # grep read one of those as a drafter on a spec-off server.
+        for word in ("dflash2", "dflash", "dspark", "ngram"):
+            if word in body.lower():
+                return _spec_label(word, n)
+        return "spec on"
+    return ""
+
+
+def _container_launch(container):
+    """(.Config.Entrypoint + .Config.Cmd as one text, .Config.Env as a dict).
+
+    ⚠️ Entrypoint AND Cmd. Reading only the Cmd is the #1537 bug: the vLLM
+    composes' `entrypoint:` is where the drafter flag is built, and compose puts
+    it in `.Config.Entrypoint`, never in `.Config.Cmd`.
+    """
+    if not container:
+        return "", {}
+    cfg = {}
+    try:
+        out = subprocess.run(["docker", "inspect", container],
+                             capture_output=True, text=True, encoding="utf-8",
+                             errors="replace", timeout=15)
+        info = json.loads(out.stdout)[0]
+        cfg = (info.get("Config") or {}) if isinstance(info, dict) else {}
+    except Exception:
+        # A bare inspect that will not parse (a warning line ahead of the JSON, a
+        # deprecated-flag notice on stdout) still yields the two fields this needs.
+        argv = []
+        for key in ("Entrypoint", "Cmd"):
+            try:
