+# Chat-template artifacts are frequently vendored as the model-dir convention
+# ``chat_template.jinja`` (mounted OVER the checkpoint's own template), so the
+# bare filename is shared by every template patch — like a generic script name,
+# it cannot identify a specific patch on a mount line.
+_GENERIC_TEMPLATE_NAMES = frozenset({"chat_template.jinja", "chat_template.j2", "chat_template.jinja2"})
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line.
+
+    A chat-template mount line reads ``<host source>:<container dest>:ro``. The
+    dest (`mounted_at`) alone is not enough: ``qwen38-reasoning-effort-template``
+    mounts at the suffix ``/chat_template.jinja`` and any compose that mounts
+    ANY template over a model dir matches it (#1611), exactly the shared-target
+    trap #1597 fixed for install scripts. So the vendored template's own source
+    (its patch directory, or a template file that carries the patch's name) must
+    appear on the SAME line as the dest."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    jinja = (patch.get("delivery_spec") or {}).get("jinja")
+    if not jinja:
+        return []
+    path = Path(jinja)
+    names: set[str] = set()
+    if path.name and path.name not in _GENERIC_TEMPLATE_NAMES:
+        names.add(path.name)                 # e.g. apex-qwen-chat-template.jinja
+    if path.parent.name and path.parent.name != "patches":
+        names.add(path.parent.name)          # e.g. qwen38-reasoning-effort-template
+    return sorted(n for n in names if n)
+
+
