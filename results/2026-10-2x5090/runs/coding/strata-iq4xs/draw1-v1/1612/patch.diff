+# ---------------------------------------------------------------------------
+# #1611 — chat_template patches must NOT reach composes that mount a DIFFERENT
+# template. The chat-template volume marker is now source-aware (the vendored
+# template's own directory/filename must share the mount line with the target,
+# mirroring #1597's install-script fix), the bare `--chat-template` flag is no
+# longer a stand-alone invoke marker (every vLLM compose passes it, and it is a
+# substring of `--chat-template-file`), and `wired_at: [volumes, command]` is
+# treated like `[volumes, entrypoint]`. On the pre-fix code all of these
+# over-reported: qwen38 reached 109 composes (62 load-bearing), apex 91 (4),
+# glm53 91 (0).
+# ---------------------------------------------------------------------------
+# (a) The Qwen3.8 reasoning-effort template must not reach a Gemma compose
+#     (it only shares the `/chat_template.jinja` mount SUFFIX there).
+for _pid, _slug in (("qwen38-reasoning-effort-template", "vllm/gemma-31b-dual"),
+                    ("apex-qwen-chat-template", "vllm/gemma-31b-dual"),
+                    ("glm53-minja-numeric-index", "vllm/gemma-31b-dual"),
+                    # apex / glm53 must not reach a vLLM compose that only passes
+                    # --chat-template for its OWN (froggeric) template.
+                    ("apex-qwen-chat-template", "vllm/dual"),
+                    ("glm53-minja-numeric-index", "vllm/dual")):
+    _patch = _pmap.get(_pid)
+    _src = COMPOSE_REGISTRY.get(_slug)
+    if _patch is None or _src is None:
+        errors.append(f"#1611 negative control: {_pid} / {_slug} no longer exist — pick another pair")
+        continue
+    _path = root / (_src["compose_path"] if isinstance(_src, dict) else _src)
+    if _patch.get("delivery_mechanism") != "chat_template":
+        errors.append(f"#1611 control patch {_pid} is no longer a chat_template patch")
+    elif reaches(_patch, str(_path)):
+        errors.append(f"#1611: {_pid} 'reaches' {_slug}, which mounts a DIFFERENT chat template")
+
+# (b) Each chat_template patch still reaches its OWN load-bearing composes, and
+#     stripping its mount/arg from that compose makes it stop reaching (#1611 —
+#     proves the markers are real, not generic substrings a neighbour satisfies).
+for _pid, _slug in (("apex-qwen-chat-template", "ik-llama/apex-mtp-compact"),
+                    ("qwen38-reasoning-effort-template", "vllm/qwen38-27b-dual-max")):
+    _patch = _pmap.get(_pid)
+    _src = COMPOSE_REGISTRY.get(_slug)
+    if _patch is None or _src is None:
+        errors.append(f"#1611 positive control: {_pid} / {_slug} no longer exist — pick another pair")
+        continue
+    _path = root / (_src["compose_path"] if isinstance(_src, dict) else _path)
+    if not reaches(_patch, str(_path)):
+        errors.append(f"#1611 positive control: {_pid} does not reach its own load-bearing {_slug}")
+
