+# --------------------------------------------------------------------------
+# Legacy `delivery:`-only fallback markers.
+#
+# Deprecated patch entries that declare only the boolean ``delivery:`` block
+# (no concrete ``delivery_spec``) still need a text probe. The pre-fix probe
+# used the bare file basename (``install.sh``) and the mount parent
+# (``patches``) — both present in essentially every compose that runs *any*
+# install script / mounts *any* ``…/patches/…`` dir, so the probe was
+# effectively always-True and could never report an unwired patch. These sets
+# let the probe match only identifying artifacts instead.
+# --------------------------------------------------------------------------
+GENERIC_PATCH_FILENAMES = {
+    "install.sh",
+    "install.bash",
+    "install.py",
+    "apply.sh",
+    "apply.bash",
+    "apply.py",
+    "patch.sh",
+    "patch.py",
+    "run.sh",
+    "setup.sh",
+    "bootstrap.sh",
+    "entrypoint.sh",
+    "main.py",
+}
+GENERIC_PATCH_DIRNAMES = {"patches", "overlay", "overlays", "scripts", "lib"}
+
+
+def _legacy_reach_markers(root: Path, patch: dict) -> list[str]:
+    """Identifying text markers for the legacy ``delivery:``-only fallback.
+
+    For every declared ``files`` entry we use the **patch's own directory
+    name** (the deepest non-generic component) and — for a file entry — its
+    own basename *only when it is not a generic script name*. We never add a
+    generic ``patches`` grandparent nor a bare ``install.sh``: those appear in
+    unrelated composes and made the fallback always-True.
+    """
+    markers: list[str] = []
+    for rel in patch.get("files") or []:
+        target = root / rel
+        path = Path(rel)
+        if target.is_dir():
+            name = path.name
+            if name and name not in GENERIC_PATCH_DIRNAMES:
+                markers.append(name)
+        else:
+            parent = path.parent.name
+            if parent and parent not in GENERIC_PATCH_DIRNAMES:
+                markers.append(parent)
+            if path.name and path.name not in GENERIC_PATCH_FILENAMES:
+                markers.append(path.name)
+    # De-duplicate, preserve first-seen order.
+    seen: set[str] = set()
+    return [m for m in markers if not (m in seen or seen.add(m))]
+
+
