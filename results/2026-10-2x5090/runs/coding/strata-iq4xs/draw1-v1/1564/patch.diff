+def _validate_engine_profile(ep: Any) -> tuple[str, str]:
+    """Validate a spec's optional ``engine_profile`` block. Raises Refusal.
+
+    Shape: ``{"path": "<repo-rel under profiles-local/engines.d>",
+              "content": "<profile YAML text>"}``.
+    Contained inside the local layer — the same rule as the compose path — so a
+    local write can never leave the gitignored tree. promote.py writes it ONLY
+    on a real (non-dry-run) run: catalog.sh must hand the profile over rather
+    than writing it, so that --dry-run leaks nothing."""
+    if not isinstance(ep, dict):
+        raise Refusal("spec.engine_profile must be an object with path + content")
+    path = ep.get("path")
+    content = ep.get("content")
+    if not isinstance(path, str) or not path:
+        raise Refusal("spec.engine_profile.path is required")
+    if not isinstance(content, str) or not content.strip():
+        raise Refusal("spec.engine_profile.content is required (the profile YAML text)")
+    _refuse_if_path_escapes(path, _LOCAL_ENGINES_REL, "spec.engine_profile.path")
+    return path, content
+
