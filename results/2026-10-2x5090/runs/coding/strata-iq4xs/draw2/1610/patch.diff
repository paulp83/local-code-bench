+# --------------------------------------------------------------------------
+# Mount-source matching: a container-side mount target (e.g.
+# ``/etc/club3090/effort-budget``) is NOT unique to a patch — a compose can
+# bind-mount a DIFFERENT patch's tree at the SAME in-container target. The
+# load-bearing artifact is identified by the mount's SOURCE (this patch's
+# own directory / script), not merely its target, so a foreign patch parked
+# at this target must never satisfy the wiring check.
+# --------------------------------------------------------------------------
+#: File basenames shared by every install-script / overlay patch; seeing one
+#: in a compose body says nothing about WHICH patch is wired — non-identifying.
+NON_IDENTIFYING_NAMES = {
+    "patches",
+    "install.sh",
+    "apply.sh",
+    "apply.py",
+    "patch.sh",
+    "patch.py",
+    "setup.sh",
+    "run.sh",
+    "main.py",
+    "overlay",
+    "local",
+}
+
+
+def _patch_source_idents(patch: dict) -> list[str]:
+    """Concrete substrings that identify THIS patch on the SOURCE side of a
+    bind mount — derived from the declared host paths (``files`` /
+    ``delivery_spec.script`` / ``sidecar`` / ``overlay_files[].src``).
+
+    For a file path the identifying token is its containing directory name
+    (the patch dir, e.g. ``vllm-effort-budget``); for a directory path it is
+    the directory's own name. Generic basenames (``install.sh``, ``patches``,
+    …) are dropped — they appear in every compose and would re-open the
+    false-positive this guards against.
+    """
+    spec = patch.get("delivery_spec") or {}
+    raw: list[str] = list(patch.get("files") or [])
+    for key in ("script", "sidecar"):
+        v = spec.get(key)
+        if v:
+            raw.append(v)
+    for of in spec.get("overlay_files") or []:
+        s = of.get("src")
+        if s:
+            raw.append(s)
+
+    idents: list[str] = []
+
+    def _add(ident: str) -> None:
+        if ident and ident not in NON_IDENTIFYING_NAMES and ident not in idents:
+            idents.append(ident)
+
+    for rel in raw:
+        parts = Path(rel).parts
+        # Every patch artifact lives under a `…/patches/<patch-dir>/…` tree;
+        # the component right after the (last) `patches` segment is the patch
+        # directory and is the most reliable, extension-proof identifier
+        # (dotted dir names like `vllm-pr42006-v0.22.0` survive a `Path.suffix`
+        # check being fooled by the trailing `.0`).
+        if "patches" in parts:
+            i = len(parts) - 1 - parts[::-1].index("patches")
+            if i + 1 < len(parts):
+                _add(parts[i + 1])
+        p = Path(rel)
+        if p.suffix:  # file entry -> its containing patch dir
+            _add(p.parent.name)
+        else:  # directory entry -> its own name
+            _add(p.name)
+    return idents
+
+
+def _mount_target_from_source(body: str, target: str, source_idents: list[str]) -> bool:
+    """True iff ``target`` is bind-mounted in ``body`` from a SOURCE that
+    names one of ``source_idents`` (i.e. THIS patch, not a foreign patch
+    sharing the same container-side path).
+
+    Only short-form ``source:target[:mode]`` mount lines count; the source is
+    the text preceding the target token on such a line. The patch's own
+    entrypoint invoke line (``bash <target>/install.sh``) carries no source
+    component and so never satisfies this on its own.
+    """
+    if not source_idents:
+        return False
+    for line in body.splitlines():
+        if target not in line:
+            continue
+        source_side = line.split(target)[0]
+        if any(ident in source_side for ident in source_idents):
+            return True
+    return False
+
+
+def _volume_marker_present(patch: dict, marker: str, body: str) -> bool:
+    """A declared volume marker is present only when the mount is genuinely
+    this patch's.
+
+    For an ``install_script`` patch the marker is its ``mounted_at`` target —
+    require the mount's SOURCE to name this patch (a foreign patch mounted at
+    the same target is not this patch's wiring). Every other marker (overlay
+    ``dest``s, chat-template targets) keeps the simple presence test.
+    """
+    spec = patch.get("delivery_spec") or {}
+    if (
+        patch.get("delivery_mechanism") == "install_script"
+        and marker
+        and marker == spec.get("mounted_at")
+    ):
+        idents = _patch_source_idents(patch)
+        if idents:
+            return _mount_target_from_source(body, marker, idents)
+    return marker in body
+
+
