+# The `hf`/`huggingface-cli` CLI is ABSENT — a "tool unavailable" rung-1
+# failure. Unlike the too-large wall, this is not a property of the repo at all:
+# the classic downloader simply could not run. Rung 3 (raw resolve + curl + the
+# sha256 gate) has NO dependency on `hf`, so a missing binary is fallback-
+# ELIGIBLE, not fatal: a stdlib-only host (no pipx/uv `hf`) still gets the pull
+# served over curl. Matched on the shell's own exit code (127 = command not
+# found) and on the message `_hf_download` emits when the lookup fails.
+# Deliberately specific: a bare "not found" would false-positive on a 404
+# "Repository not found" / "Revision not found" and wrongly send a real hub
+# error down the fallback, so every marker here names the *binary*, not a
+# resource on the hub.
+_TOOL_UNAVAILABLE_MARKERS = (
+    "is on path",            # "neither `hf` nor `huggingface-cli` is on PATH"
+    "command not found",     # a shell's own 127 diagnostic
+    "executablefile not found",  # python FileNotFoundError for the exe
+    "filenoent",             # FileNotFoundError rendered in the traceback
+)
+
+
+def is_tool_unavailable(rc: Optional[int] = None, blob: str = "") -> bool:
+    """True iff rung 1 failed because the `hf` CLI could not be RUN at all
+    (absent binary, rc=127, command-not-found), NOT because the hub refused the
+    transfer. This is fallback-ELIGIBLE: rung 3 fetches via `curl` against the
+    public resolve endpoint and needs no `hf`, so a host that has `python3` +
+    `curl` but no `hf` should still get its weights rather than a bare exit 1.
+
+    rc 127 is the authoritative signal (the shell's command-not-found code,
+    which `_hf_download` mirrors when `shutil.which` finds nothing); the blob
+    markers are the belt-and-braces for callers that surface a 127 differently
+    or run the CLI through a wrapper."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return any(m in low for m in _TOOL_UNAVAILABLE_MARKERS)
+
