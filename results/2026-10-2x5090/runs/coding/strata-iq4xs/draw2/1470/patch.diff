diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..e8f7d21 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -96,6 +96,31 @@ r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' 'CustomAllRed
 [[ "$r" == "nccl_only_degraded" ]] || fail "SGLang P2P veto -> degraded (got $r)"
 r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' "CustomAllreduce is disabled because it's not supported on more than two PCIe-only GPUs." | p2p_classify_engagement)"
 [[ "$r" == "nccl_only_gated" ]] || fail "SGLang topology veto -> gated (got $r)"
+# SGLang V1 CustomAllReduce: admitted on PCIe rigs (V2 is NVLink-gated via
+# can_use_custom_all_reduce_v2 -> full_nvlink). V1 is silent at init; its only
+# success signal is "Registering N cuda graph addresses" after CUDA-graph capture
+# on rank 0. That line must score on, exactly like V2's "All Reduce config:".
+_sgl_v1=$(cat <<'EOF'
+[2026-09-28 09:00:00] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-09-28 09:00:11 TP0] sglang is using nccl==2.30.7
+[2026-09-28 09:01:02 TP0] Registering 4352 cuda graph addresses
+EOF
+)
+_v1="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_v1" "cuda graph addresses"
+r="$(printf '%s\n' "$_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 cuda graph addresses -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 graph capture -> on (got $r)"
+# A requested-on boot with no capture yet stays unknown (no false positive).
+r="$(printf '%s' "[sglang] BOOT disable_custom_all_reduce=False" | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "V1 requested without capture proof -> unknown (got $r)"
+# Latest boot wins: an operator-disabled restart must not inherit an earlier capture.
+r="$(printf '%s\n%s' "$_v1" "[sglang] BOOT disable_custom_all_reduce=True" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "V1 capture must not leak into a later operator-disabled boot (got $r)"
+unset _sgl_v1 _v1
+echo "  ✓ SGLang V1 CustomAllreduce (PCIe): 'Registering N cuda graph addresses' scores on"
+
 unset _sgl_raw _sgl_evidence
 echo "  ✓ SGLang runtime: NCCL + custom-AR init classified; restart epoch and vetoes preserved"
 
