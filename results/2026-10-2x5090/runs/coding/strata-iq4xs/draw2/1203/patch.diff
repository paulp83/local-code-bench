+
+def _compose_facts():
+    """Resolve the shared compose-facts module (stdlib-only). Cached; raises only
+    when the repo's scripts tree genuinely is not importable."""
+    global _compose_facts_mod
+    if _compose_facts_mod is not None:
+        return _compose_facts_mod
+    import sys
+    from pathlib import Path
+
+    try:
+        from scripts.lib.profiles import compose_facts as cf
+    except Exception:
+        cf = None
+    if cf is None:
+        # Anchor on a REAL checkout root — this file's parents, plus the
+        # C3_REPO_ROOT override __main__.py uses for installs outside the tree.
+        # Never a tmp fixture root: services.CockpitData documents why pinning
+        # an arbitrary root to the regular `scripts.lib.profiles` package is a
+        # bug (it shadows the real tree for every later profiles import).
+        import os
+
+        env_root = os.environ.get("C3_REPO_ROOT")
+        roots = [Path(env_root)] if env_root else []
+        roots += list(Path(__file__).resolve().parents)
+        for cand in roots:
+            if (cand / "scripts" / "lib" / "profiles" / "compose_facts.py").is_file():
+                root = str(cand)
+                if root not in sys.path:
+                    sys.path.insert(0, root)
+                try:
+                    from scripts.lib.profiles import compose_facts as cf2  # noqa: F401
+                    cf = cf2
+                except Exception:
+                    break
+    if cf is None:
+        raise ImportError(
+            "scripts/lib/profiles/compose_facts.py is not importable — the shared "
+            "compose→spec derivation (#1153 Route-K) ships with the repo."
+        )
+    _compose_facts_mod = cf
+    return cf
+
+
+def derive_compose_facts(text: str, path: str = "") -> "ComposeFacts":
+    """Read a user-supplied compose (#1153 Route-K). Never raises on bad input.
+
+    Thin delegate: the implementation lives in the shared core so the CLI and the
+    cockpit can never drift apart.  See
+    ``scripts/lib/profiles/compose_facts.derive_compose_facts``."""
+    return _compose_facts().derive_compose_facts(text, path=path)
+
+
+def __getattr__(name: str):
+    """Re-export the relocated compose-facts names (PEP 562, #1202 P1).
+
+    `from club3090_cockpit.data import ComposeFacts` keeps working while the
+    class itself lives in the shared core; resolving it lazily is what keeps
+    data.py importable before the repo root is on sys.path."""
+    if name in _COMPOSE_FACTS_REEXPORTS:
+        return getattr(_compose_facts(), name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
