 # ---- server-side reasoning budget: read it back, size the client cap --------
-# A club vLLM / SGLang compose wired for it can cap reasoning SERVER-side with a
-# budget chosen by the request's effort (scripts/lib/effort_budget.py); its
-# entrypoint prints one `[effort-budget] v1 …` line at boot. A client cap at or
-# below that budget cuts off the answer that follows the server's forced close,
-# and the run then measures the cap — so on a thinking leg the DEFAULT thinking cap grows to
-# budget + THINKING_BUDGET_HEADROOM when that is larger. The budget is also
+# A server that caps reasoning SERVER-side turns the client's thinking cap into a
+# trap: a cap at or below the server's budget cuts off the answer that follows the
+# server's forced close, and the run then measures the cap. So on a thinking leg
+# the wrapper reads the budget that is IN EFFECT and grows the DEFAULT thinking
+# cap to budget + THINKING_BUDGET_HEADROOM when that is larger. The budget is also
 # stamped on the Quality: line and recorded by benchlocal (--server-thinking-budget,
 # when the installed benchlocal-cli has it).
+#   Two readbacks, because the budget takes two shapes server-side:
+#     vLLM / SGLang  a club compose wired for effort budgets (scripts/lib/
+#                    effort_budget.py) prints ONE `[effort-budget] v1 …` line at
+#                    boot, the budget chosen by the request's effort. The line's
+#                    format is engine-neutral and effort_budget.py owns its
+#                    parsing (the LAST line wins: `docker logs` spans restarts).
+#     llama.cpp      nothing prints such a line: the budget is the
+#                    `--reasoning-budget N` the container BOOTS with — server-wide
+#                    and the same for every effort, since llama.cpp has no
+#                    per-request field. Resolved from the container's boot command
+#                    by scripts/lib/thinking-budget.sh, the machinery
+#                    --thinking-budget verification already uses (a flag present
+#                    with `${REASONING_BUDGET:--1}` is UNRESTRICTED, so the flag's
+#                    presence proves nothing and its resolved value is asked for).
 #   Not read on --resume (benchlocal restores the original run's own record) or on
 #   a --no-thinking leg (no reasoning, nothing to bound). Never overrides a choice:
-#   --thinking-budget N (sent per request — the request's budget wins on the
-#   server, so the server's is not the one in effect), an explicit
+#   --thinking-budget N (that run's own budget is what is in effect), an explicit
 #   --thinking-max-tokens / THINKING_MAX_TOKENS, or --pack-budgets.
-# Engine-neutral by design: the readback line is the same on every engine, and
-# effort_budget.py owns its parsing (the LAST line wins: `docker logs` spans restarts).
 SERVER_THINKING_BUDGET=""          # N | off | empty = unknown / not in effect
 SERVER_THINKING_EFFORT=""          # the effort that budget was read for
 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+
+# Report a budget that IS in effect and size the client cap against it. $1 is the
+# readback sentence ("server budget N reasoning tokens …, read from …"), $2 the
+# note for a --thinking-budget run — whose own budget is the one in effect, so the
+# server's is not recorded. A cap YOU chose is only ever kept, never widened: the
+# one that can cut the answer off is the wrapper's default.
+server_budget_apply_cap() {
+  local _sb_what="$1" _sb_tb_note="$2" _sb_headroom
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    echo "[quality-test] ${_sb_what} — ${_sb_tb_note}; cap from --thinking-budget"
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+  elif [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$SERVER_THINKING_BUDGET" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${SERVER_THINKING_BUDGET}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+  elif [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+  else
+    _sb_headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+    if ! [[ "$_sb_headroom" =~ ^[1-9][0-9]*$ ]]; then
+      echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${_sb_headroom}'" >&2
+      exit 2
+    fi
+    if [[ $(( SERVER_THINKING_BUDGET + _sb_headroom )) -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+      THINKING_MAX_TOKENS=$(( SERVER_THINKING_BUDGET + _sb_headroom ))
+      THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${_sb_headroom}"
+      echo "[quality-test] ${_sb_what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${SERVER_THINKING_BUDGET} + ${_sb_headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+    else
+      echo "[quality-test] ${_sb_what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${_sb_headroom} tokens for the answer"
+    fi
+  fi
+}
+
+# llama.cpp's half of the readback: ask ${CONTAINER}'s boot command for its
+# --reasoning-budget. Prints the report and leaves SERVER_THINKING_BUDGET at N
+# (in effect) / off (unrestricted) / "" (nothing readable). Returns 0 whenever
+# ${CONTAINER} IS a llama.cpp server — even when its value cannot be resolved —
+# and 1 for any other engine, having said nothing, so the caller falls back to
+# the `[effort-budget]` line.
+server_budget_read_llamacpp() {
+  # shellcheck source=lib/thinking-budget.sh
+  source "${ROOT_DIR}/scripts/lib/thinking-budget.sh"
+  [[ "$(thinking_budget_engine_kind)" == "llamacpp" ]] || return 1
+  local _sb_facts
+  _sb_facts="$(docker inspect "$CONTAINER" 2>/dev/null | _thinking_budget_container_facts llamacpp)"
+  case "$_sb_facts" in
+    "BUDGET -"*|"BUDGET none")
+      # A negative budget (what the shipped composes resolve to when
+      # REASONING_BUDGET was never set: -1) is llama.cpp's own "no limit" — the
+      # flag is PRESENT and UNRESTRICTED, exactly like no flag at all.
+      SERVER_THINKING_BUDGET="off"
+      echo "[quality-test] server budget: off (${CONTAINER} boots llama.cpp with --reasoning-budget -1 or none: unrestricted) — thinking cap unchanged"
+      ;;
+    "BUDGET unresolvable"*)
+      # A value the shell cannot resolve to a token count: the server does cap
+      # reasoning, but its size is unknown — so the cap stays put and nothing is
+      # stamped (a wrong budget is worse than an absent one).
+      echo "[quality-test] server budget: unknown (llama.cpp --reasoning-budget unresolvable in ${CONTAINER}'s boot command — ${_sb_facts#BUDGET unresolvable }) — thinking cap unchanged"
+      ;;
+    "BUDGET "*)
+      SERVER_THINKING_BUDGET="${_sb_facts#BUDGET }"
+      server_budget_apply_cap \
+        "server budget ${SERVER_THINKING_BUDGET} reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from ${CONTAINER}'s boot command" \
+        "the --thinking-budget ${THINKING_BUDGET} this run verified"
+      ;;
+    *)
+      echo "[quality-test] WARN: could not read llama.cpp --reasoning-budget from ${CONTAINER} — thinking cap unchanged:" >&2
+      printf '%s\n' "${_sb_facts:-no output from docker inspect}" | sed 's/^/[quality-test]   /' >&2
+      ;;
+  esac
+  return 0
+}
