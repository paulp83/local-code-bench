+def _chat_template_flag_names_mount(lines: list[str], mounted_at: str) -> bool:
+    """True iff a `--chat-template` / `--chat-template-file` flag names
+    ``mounted_at`` — either as a same-line token or as the immediately following
+    list item (the two-token style renders as adjacent list items, so the joined
+    string never appears). The bare `--chat-template` is never matched as a
+    prefix of `--chat-template-file`, and a flag pointing at some OTHER file does
+    not count (#1616)."""
+    for i, ln in enumerate(lines):
+        for flag_re in _CHAT_TEMPLATE_FLAG_RES:
+            for match in flag_re.finditer(ln):
+                if mounted_at in ln[match.end():]:        # flag + path, same line
+                    return True
+                if i + 1 < len(lines) and mounted_at in lines[i + 1]:  # adjacent list items
+                    return True
+    return False
