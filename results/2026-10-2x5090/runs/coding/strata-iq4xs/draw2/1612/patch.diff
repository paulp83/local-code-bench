+       ``mounted_at`` must appear, and where that target is a generic model-dir
+       suffix (``…/chat_template.jinja``) the patch's own vendored source must
+       be on the SAME line, so a compose mounting a DIFFERENT template at the
+       same generic path no longer passes (#1616);
+    2. the launch command names that mounted path with
+       ``--chat-template`` / ``--chat-template-file``. A bare flag elsewhere, a
+       flag naming another file, and the bare flag matched as a prefix of
+       ``--chat-template-file`` all fail.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
