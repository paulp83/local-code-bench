+def _chat_template_sources(patch: dict) -> list[str]:
+    """Source-side names that identify THIS chat-template patch on its mount
+    line: the vendored template's own directory (a generic `chat_template.jinja`
+    mounted from a patch dir) or its distinct filename (`apex-qwen-chat-template
+    .jinja`, mounted directly). Excludes the shared `patches/` parent and the
+    generic `chat_template.jinja` basename (shared by every model dir)."""
+    names: set[str] = set()
+    for rel in patch.get("files") or []:
+        path = Path(rel)
+        if path.suffix not in CHAT_TEMPLATE_ARTIFACT_SUFFIXES:
+            continue
