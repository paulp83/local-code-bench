+    lines = body.splitlines()
+    sources = _chat_template_sources(patch)
+    # The container target identifies this patch on its own only when its
+    # basename is specific (e.g. /etc/apex-qwen-chat-template.jinja). For a
+    # specific target, require it to appear as a bind-mount TARGET — in the
+    # merged YAML a mount renders `SOURCE:TARGET[:MODE]`, so the target is
+    # preceded by a `:` (the source:target separator) and followed by `:mode`
+    # or end-of-line — so a bare `--chat-template <path>` argument (space-
+    # delimited on the command list) no longer satisfies the MOUNT check
+    # (removing the mount must drop coverage even if the command still names
+    # the path, #1616).
+    # A generic `chat_template.jinja` suffix (qwen38, carnice) is shared by
