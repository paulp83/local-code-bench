   THINKING_BUDGET_REASONING_PARSER=""
   if [[ -n "$c" && "$c" != "none" ]] && command -v docker >/dev/null 2>&1 \
@@ -329,6 +387,21 @@ thinking_budget_verify() {
         return 2
       fi
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
+      # An empty argv result AND a `PARSER none` both go to the boot log before
+      # becoming a refusal. `docker inspect` reports what the LAUNCHER was
+      # given; an image that starts vLLM through its own script appends
+      # --reasoning-parser inside that script, where argv never sees it — and
+      # reading it as "booted WITHOUT" there is positive evidence that cannot
+      # be overridden, i.e. the flag is simply unusable on that image. vLLM's
+      # boot log prints the config it actually applied, so it is consulted
+      # before the argv's silence is allowed to read as a refusal.
+      if [[ "$facts" == "PARSER none" || -z "$facts" ]]; then
+        log_facts="$(_thinking_budget_vllm_boot_log_facts "$c")"
+        if [[ "$log_facts" == "PARSER "* && "$log_facts" != "PARSER none" ]]; then
+          THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${log_facts#PARSER }: the container argv carries none, but its boot log reports reasoning_parser=${log_facts#PARSER } in non-default args — the flag is set inside the image's own launcher, which docker inspect cannot see"
+          return 0
+        fi
+      fi
       case "$facts" in
         "PARSER none")
           THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
