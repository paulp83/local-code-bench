+# vLLM's own readback of what it APPLIED: its boot log. An image that starts
+# vLLM through its own launcher script (bucko's official image ships
+# `qwen38-serve`, which appends `--reasoning-parser qwen3` inside the script)
+# carries NO parser in `docker inspect`'s argv — the argv is what the launcher
+# received, not what vLLM received. vLLM prints its resolved config at boot:
+#
+#     (APIServer pid=1) INFO … non-default args: {'model': '/models/x',
+#         'reasoning_parser': 'qwen3', …}
+#
+# which only lists NON-default values — so a parser set anywhere, by anyone,
+# is visible there. Same idea as SGLang's /server_info: read the engine's own
+# statement, not the flag we think we passed.
+#
+# The dump sits at the HEAD of the log and `docker logs` has no --head, so read
+# a bounded prefix: `head -c` closes the pipe and docker dies on SIGPIPE, which
+# is the point, not a failure (hence `|| true` under `set -o pipefail`).
+# stdin: the boot log. stdout: `PARSER <value>` when the dump names one,
+# `PARSER none` when the dump is there without one, NOTHING when there is no
+# dump to read (log driver off, rotated away, a newer format) — "no dump" is
+# silence, never a false `none`.
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import re, sys
+
+# Both spellings the log can carry: 'reasoning_parser': 'qwen3' (the python
+# dict vLLM prints) and reasoning_parser=qwen3. A null-ish value is an ABSENT
+# parser, not a parser named None.
+_KEY = re.compile(r"""['\"]?reasoning_parser['\"]?\s*[:=]\s*['\"]?([^'",}\s]+)""")
+_DUMP = re.compile(r"""non[-_]default args\s*:|non_default_args""")
+_NULL = ("none", "null", "false", "")
+
+text = sys.stdin.read()
+vals = [m.group(1).strip().strip('\'"') for m in _KEY.finditer(text)]
+vals = [v for v in vals if v.lower() not in _NULL]
+if vals:
+    # The LAST boot wins: a container that was restarted with a different
+    # config ends its log with the config that is serving now.
+    print("PARSER %s" % vals[-1])
+elif _DUMP.search(text):
+    print("PARSER none")
+PY
+)"
+_thinking_budget_vllm_boot_log_facts() {
+  # `|| true`: docker dies of SIGPIPE the moment head -c is satisfied, and a
+  # log driver that cannot serve logs exits non-zero — neither is worth an
+  # abort inside a verification that still has the argv to fall back on.
+  docker logs "$1" 2>&1 | head -c 8388608 2>/dev/null \
+    | python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY" 2>/dev/null || true
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -284,7 +342,7 @@ THINKING_BUDGET_EVIDENCE=""
 THINKING_BUDGET_REASONING_PARSER=""
 
