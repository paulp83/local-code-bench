diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..5d1c464 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1026,8 +1026,21 @@ down_running() {
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
-    if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+    # config_files can hold several comma-joined paths — the slug's compose
+    # plus the #1498 label override. Pass each as its own -f (a single -f over
+    # the joined string fails compose validation) and drop entries that no
+    # longer exist: the override can vanish by teardown time (e.g. the data
+    # dir moved) and `down` doesn't need it. Fall back to docker stop when
+    # nothing usable remains.
+    local -a cfg_args=()
+    local -a _cfgs=()
+    local _cf
+    IFS=',' read -ra _cfgs <<< "$lbl_file"
+    for _cf in "${_cfgs[@]}"; do
+      [[ -n "$_cf" && -e "$_cf" ]] && cfg_args+=(-f "$_cf")
+    done
+    if [[ -n "$lbl_dir" && ${#cfg_args[@]} -gt 0 ]]; then
+      (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..4f2b111 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -80,7 +80,12 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      # Absolute path that actually exists on disk — down_running() drops
+      # listed files that no longer exist, so the mock must hand back a file
+      # that is really there for the compose-down branch to run.
+      f="${DOCKER_MOCK_WORKDIR}/compose-${cname}.yml"
+      : > "$f"
+      printf '%s\n' "$f"
     fi
     ;;
   stop)
