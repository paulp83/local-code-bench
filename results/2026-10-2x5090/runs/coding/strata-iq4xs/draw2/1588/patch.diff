+def url_host_port(url):
+    """(host, port) parsed from ``url``; the port defaults from the scheme."""
+    url = url or ""
+    m = re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://(?:[^/?#@]*@)?([^/?#]*)", url)
     if not m:
+        return "", ""
+    hostport = m.group(1)
+    if hostport.startswith("["):
+        rb = hostport.find("]")
+        if rb < 0:
+            return "", ""
+        host = hostport[1:rb]
+        rest = hostport[rb + 1:]
+        port = rest[1:] if rest.startswith(":") else ""
+    elif ":" in hostport:
+        host, port = hostport.rsplit(":", 1)
+    else:
+        host, port = hostport, ""
+    if not port:
+        port = "443" if url.startswith("https") else "80"
+    return host, port
