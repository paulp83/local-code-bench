+def _host_addresses(host):
+    """The addresses ``host`` names: a literal IP is itself; localhost / 0.0.0.0
+    are loopback; a hostname is whatever it resolves to (empty when it doesn't).
+    ``http://<this rig's hostname>:PORT`` must count as this host (#1584)."""
+    if not host:
+        return set()
+    if host in ("localhost", "0.0.0.0"):
+        return {"127.0.0.1", "::1"}
+    if host == "::1" or host == "[::1]":
+        return {"::1"}
+    if host.startswith("[") and host.endswith("]"):   # IPv6 literal
+        return {host}
+    if ":" in host:                                    # bare IPv6 literal
+        return {host}
+    if re.fullmatch(r"[0-9.]+", host):                 # IPv4 literal
+        return {host}
+    try:                                               # hostname → its addresses
+        return {info[4][0] for info in socket.getaddrinfo(host, None)}
+    except Exception:
+        return set()
+
+
+def _local_interface_addrs():
+    """IPs assigned to THIS host, best-effort: ``hostname -I`` plus what the
+    hostname resolves to. A wildcard (:8020) publish only serves a URL whose host
+    is one of these (or loopback) — that is how a remote IP is told from a local
+    one (#1584)."""
+    addrs = set()
+    try:
+        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True,
+                             encoding="utf-8", timeout=5)
+        if out.returncode == 0:
+            addrs.update(out.stdout.split())
+    except Exception:
+        pass
+    try:
+        addrs.update(socket.gethostbyname_ex(socket.gethostname())[2])
+    except Exception:
+        pass
+    return addrs
+
+
+def _is_loopback(a):
+    return a.startswith("127.") or a in ("::1", "[::1]") or a.startswith("::ffff:127.")
+
+
+# A single docker "Ports" field maps URL's host:port on THIS host? Mirrors
+# listen-scope.sh's ports_serve_url: same host port (or inside a range), and the
+# URL's resolved host is an address the mapping is actually published on — any of
+# this host's addresses (or loopback) for a 0.0.0.0 / :: bind, loopback only for a
+# 127.x / ::1 bind, that exact address otherwise.
+def _ports_serve_url(ports, port, addrs, own):
+    for mapping in (ports or "").split(","):
+        mapping = mapping.strip()
+        if "->" not in mapping:                # exposed-only, not published
+            continue
+        left = mapping.split("->", 1)[0].strip()    # bind:hostport, e.g. 0.0.0.0:8020
+        if left.startswith("["):                    # [::]:8020
+            rb = left.find("]")
+            if rb < 0:
+                continue
+            bind = left[1:rb]
+            hostport = left[rb + 1:].lstrip(":")
+        elif ":" in left:
+            bind, hostport = left.rsplit(":", 1)
+        else:
+            continue
+        lo, _, hi = hostport.partition("-")
+        hi = hi or lo
+        if not lo.isdigit() or not hi.isdigit():
+            continue
+        if not (int(lo) <= port <= int(hi)):
+            continue
+        for a in addrs:
+            if bind in ("0.0.0.0", "::", ""):
+                if _is_loopback(a) or a in own:
+                    return True
+            elif bind.startswith("127.") or bind in ("::1", "[::1]"):
+                if _is_loopback(a):
+                    return True
+            elif a == bind:
+                return True
+    return False
+
