index ed69318..6183dd0 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,153 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# ---------------------------------------------------------------------------
+# Per-GPU VRAM attribution — scripts/report.sh "Display / desktop state" (#1537)
+# ---------------------------------------------------------------------------
+#
+# A shared report must say WHO holds each GPU's memory. The old code credited
+# the ONE running club-3090 container it found with EVERY card above 100 MiB,
+# so on a rig where our container saw only GPU 1 while another container's
+# `VLLM::Worker_TP0/1` owned GPUs 0 and 2, the report claimed all three were
+# "held by running <ours>". nvidia-smi already carries the truth: each compute
+# process sits on a specific GPU (by UUID — indices get renumbered, UUIDs never
+# do), and each host pid lives in a specific container (by its cgroup path).
+# These attribute every card to the process on it instead of to a guess.
+#
+# Seam for tests: the proc root comes from $GPU_ATTR_PROC (default /proc), so
+# the <pid>/cgroup reads can be pointed at a fixture directory.
+
+# _gpu_attr_container_for_pid <proc_root> <pid> <docker_ps_lines>
+#   The RUNNING container NAME a host pid belongs to, or empty when the pid is
+#   not inside a docker container we can resolve to a name. The container id is
+#   read from <proc>/<pid>/cgroup — the systemd driver writes a
+#   `docker-<id>.scope` segment, the cgroupfs driver a `/docker/<id>` one; both
+#   are matched here. <docker_ps_lines> is `docker ps --format
+#   '{{.ID}} {{.Names}}'` output, whose short id is a prefix of the cgroup's
+#   full id (matched both directions so a full-id or short-id docker works).
+_gpu_attr_container_for_pid() {
+  local proc_root="$1" pid="$2" ps="$3"
+  [[ -z "$pid" ]] && return 0
+  [[ -r "${proc_root}/${pid}/cgroup" ]] || return 0
+  local id line d_id d_name
+  id="$(command grep -oE 'docker[-/][0-9a-f]{6,}' \
+          "${proc_root}/${pid}/cgroup" 2>/dev/null | head -1 \
+        | sed -E 's#^docker[-/]##')"
+  [[ -z "$id" ]] && return 0
+  local lc_id="${id,,}"
+  while IFS= read -r line; do
+    [[ -z "$line" ]] && continue
+    d_id="${line%% *}"; d_name="${line#* }"
+    [[ -z "$d_id" || "$d_id" == "$line" ]] && continue
+    if [[ "$lc_id" == "${d_id,,}"* || "${d_id,,}" == "$lc_id"* ]]; then
+      printf '%s' "$d_name"
+      return 0
+    fi
+  done <<< "$ps"
+  return 0
+}
+
+# gpu_vram_report_lines "<our_container>"
+#   One "- **GPU <index> idle VRAM:** ..." line per GPU for report.sh's Display
+#   section, each attributed to the PROCESS that holds the card — not to
+#   whatever single container happened to be running. OUR_CONTAINER may be
+#   empty (no club-3090 container up): the lines still name the real holder, and
+#   only add a "not <ours>" contrast when it is set. Emits nothing when there is
+#   no nvidia-smi or no GPU row (the caller has already gated on nvidia-smi).
+#
+#   Reading, per GPU:
+#     idle (a few MiB)            → "<N> MiB ✓"
+#     held by our container        → "held by running <ours>"
+#     held by another container    → "held by <other>"  (+ "not <ours>" if ours set)
+#     held by an out-of-container  → "held by <process_name>"
+#     memory in use, no owner      → "⚠ something is using this GPU" (+ "not <ours>")
+gpu_vram_report_lines() {
+  local our_container="${1:-}"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  # Host GPU list: index,uuid,memory.used (MiB). The UUID is the join key to the
+  # compute-apps query below.
+  local gpus
+  gpus="$(nvidia-smi --query-gpu=index,uuid,memory.used \
+            --format=csv,noheader,nounits 2>/dev/null)" || gpus=""
+  [[ -z "${gpus//[[:space:]]/}" ]] && return 0
+
+  # Compute apps: gpu_uuid,pid,process_name. process_name may contain commas,
+  # so it is read LAST and takes the whole remainder of the line. May be empty
+  # (older driver, a container without full GPU permission, ...).
+  local apps=""
+  apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name \
+            --format=csv,noheader,nounits 2>/dev/null || true)"
+  local apps_have=0
+  [[ -n "${apps//[[:space:]]/}" ]] && apps_have=1
+
+  # id->name map for every RUNNING container, so a pid's cgroup id resolves to a
+  # readable name. Empty (every process then reads as "outside a container")
+  # when docker is absent or the daemon is unreachable — never a hard failure.
+  local ps=""
+  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
+    ps="$(docker ps --format '{{.ID}} {{.Names}}' 2>/dev/null || true)"
+  fi
+
+  # When the HOST lists no compute processes we cannot attribute anything from
+  # the host — then place OURS from the container's own view of which global GPU
+  # UUIDs it is running on (the same query gpu_select_container_uuids uses).
+  local our_uuids=""
+  if [[ "$apps_have" -eq 0 && -n "$our_container" ]]; then
+    # The container's own nvidia-smi reports the SAME global UUIDs the host
+    # query uses, so extracting every GPU-* token (regardless of the other
+    # columns printed) maps the container's view back onto the host indices.
+    our_uuids="$(docker exec "$our_container" nvidia-smi \
+        --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null \
+      | tr -d ' \t' | command grep -oE 'GPU-[[:alnum:]_-]+' | sort -u | paste -sd, - || true)"
+  fi
+
+  local idx uuid used owner proc_name a_uuid a_pid a_proc
+  while IFS=',' read -r idx uuid used; do
+    idx="${idx//[[:space:]]/}"; uuid="${uuid//[[:space:]]/}"; used="${used//[[:space:]]/}"
+    # Keep only the leading integer — tolerant of a "MiB" suffix on a driver
+    # that ignored nounits, and empty for "[N/A]" so the row is skipped.
+    used="${used%%[![:digit:]]*}"
+    [[ -z "$idx" ]] && continue
+    [[ "$used" =~ ^[0-9]+$ ]] || continue
+    if [[ "$used" -le 100 ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+      continue
+    fi
+
+    # Busy card — find the compute process running on THIS gpu (match by UUID).
+    owner=""; proc_name=""
+    if [[ "$apps_have" -eq 1 ]]; then
+      while IFS=',' read -r a_uuid a_pid a_proc; do
+        a_uuid="${a_uuid//[[:space:]]/}"; a_pid="${a_pid//[[:space:]]/}"
+        a_proc="${a_proc# }"; a_proc="${a_proc% }"
+        [[ "$a_uuid" == "$uuid" ]] || continue
+        proc_name="$a_proc"
+        owner="$(_gpu_attr_container_for_pid "$proc_root" "$a_pid" "$ps")"
+        break
+      done <<< "$apps"
+    fi
+
+    if [[ -n "$owner" ]]; then
+      if [[ -n "$our_container" && "$owner" == "$our_container" ]]; then
+        echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${owner}\`)"
+      elif [[ -n "$our_container" ]]; then
+        echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${owner}\` — not \`${our_container}\`)"
+      else
+        echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${owner}\`)"
+      fi
+    elif [[ -n "$proc_name" ]]; then
+      # A compute process we cannot map to a container — name it directly.
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${proc_name}\`)"
+    elif [[ -n "$our_uuids" && ",${our_uuids}," == *",${uuid},"* ]]; then
+      # Host lists no processes; the container's own view puts it on this card.
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${our_container}\`)"
+    elif [[ -n "$our_container" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU — not \`${our_container}\`"
+    else
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container)"
+    fi
+  done <<< "$gpus"
+}
