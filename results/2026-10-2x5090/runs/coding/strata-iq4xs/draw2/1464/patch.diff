diff --git a/scripts/tests/test-switch-preflight-before-teardown.sh b/scripts/tests/test-switch-preflight-before-teardown.sh
new file mode 100755
index 0000000..f6fdbd5
--- /dev/null
+++ b/scripts/tests/test-switch-preflight-before-teardown.sh
@@ -0,0 +1,144 @@
+#!/usr/bin/env bash
+# Test: switch.sh gates a launch BEFORE it tears down the running slug.
+#
+# Contract: switch.sh used to bring the running slug down FIRST and only then
+# run the checks that can refuse a launch (unknown slug, (NA) status without
+# --force, model files missing on the host). A refused launch therefore left
+# the rig serving NOTHING. The refusing checks now run first, so a refusal must
+# not touch docker at all — the running container stays up.
+#
+# Validates (with a mock `docker` on PATH that records every invocation):
+#   1. A mistyped slug is refused without any docker call.
+#   2. An (NA: experimental) slug without --force is refused without any docker
+#      call, and the --force hint is still printed.
+#   3. A compose whose weights are not on the host is refused without any docker
+#      call (the worktree-without-MODEL_DIR case).
+#   4. An ACCEPTED launch still tears down and then brings the new variant up —
+#      in that order (the fix must not skip the teardown).
+set -uo pipefail
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0; FAIL=0
+ok()   { PASS=$((PASS + 1)); echo "  ok   $1"; }
+bad()  { FAIL=$((FAIL + 1)); echo "  FAIL $1" >&2; }
+assert_contains() {
+  local hay="$1" needle="$2" label="$3"
+  if [[ "$hay" == *"$needle"* ]]; then ok "$label"; else
+    bad "$label: expected output to CONTAIN: $needle" >&2
+    printf '%s\n' "$hay" >&2
+  fi
+}
+
+T="$(mktemp -d)"
+trap 'rm -rf "$T"' EXIT
+mkdir -p "$T/bin"
+
+# --- mock docker / nvidia-smi / compose --------------------------------------
+cat > "$T/bin/docker" <<'D'
+#!/usr/bin/env bash
+printf 'docker %s\n' "$*" >> "$MOCK_LOG"
+[[ "${1:-}" == "ps" ]] && printf 'vllm-some-running-model\n'
+exit 0
+D
+cat > "$T/bin/nvidia-smi" <<'N'
+#!/usr/bin/env bash
+case "$*" in
+  *compute-apps*) exit 0 ;;
+  *memory.free*) printf '0, 23000, 24576\n' ;;
+  *compute_cap*) printf '0, NVIDIA GeForce RTX 3090, 24576, 8.6\n' ;;
+  *memory.total*) printf '24576\n' ;;
+  *index*) printf '0\n' ;;
+  *) printf 'NVIDIA GeForce RTX 3090\n' ;;
+esac
+exit 0
+N
+cat > "$T/bin/compose" <<'C'
+#!/usr/bin/env bash
+printf 'compose %s\n' "$*" >> "$MOCK_LOG"
+C
+chmod +x "$T/bin/docker" "$T/bin/nvidia-smi" "$T/bin/compose"
+
+export MOCK_LOG="$T/mock.log"
+export PATH="$T/bin:$PATH"
+export COMPOSE_BIN="$T/bin/compose"
+# Keep the hardware/RAM gates out of the picture — this test is about ORDER.
+export PREFLIGHT_NO_HARDWARE=1
+
+run() {   # run() <cmd…> → sets OUT / RC / LOG / DOCKER_CALLS / COMPOSE_CALLS
+  : > "$MOCK_LOG"
+  OUT="$("$@" 2>&1)"; RC=$?
+  LOG="$(cat "$MOCK_LOG")"
+  DOCKER_CALLS="$(printf '%s\n' "$LOG" | grep -c '^docker ' || true)"
+  COMPOSE_CALLS="$(printf '%s\n' "$LOG" | grep -c '^compose ' || true)"
+}
+
+# --- 1. mistyped slug --------------------------------------------------------
+run env PATH="$T/bin:$PATH" bash scripts/switch.sh --no-wait vllm/typo-not-a-slug
+assert_contains "$OUT" "unknown variant" "typo is refused"
+[[ "$RC" -ne 0 ]] && ok "typo exits non-zero" || bad "typo must exit non-zero"
+[[ "$DOCKER_CALLS" -eq 0 && "$COMPOSE_CALLS" -eq 0 ]] \
+  && ok "typo refused WITHOUT touching docker (running slug survives)" \
+  || bad "typo refused AFTER touching docker: $DOCKER_CALLS docker / $COMPOSE_CALLS compose call(s)"
+
+# --- 2. (NA) status without --force ------------------------------------------
+NA_SLUG="$(python3 - "$ROOT_DIR" <<'PY'
+import sys; sys.path.insert(0, sys.argv[1])
+from scripts.lib.profiles.compose_registry import get_registry
+for k, v in get_registry().items():
+    if (v.get("status") or "") == "experimental":
+        print(k); break
+PY
+)"
+if [[ -n "$NA_SLUG" ]]; then
+  run env PATH="$T/bin:$PATH" bash scripts/switch.sh --no-wait "$NA_SLUG"
+  assert_contains "$OUT" "(NA: experimental)" "NA slug is refused without --force"
+  assert_contains "$OUT" "--force"            "NA refusal still prints the --force hint"
+  [[ "$DOCKER_CALLS" -eq 0 && "$COMPOSE_CALLS" -eq 0 ]] \
+    && ok "NA slug refused WITHOUT touching docker" \
+    || bad "NA slug refused AFTER touching docker: $DOCKER_CALLS docker / $COMPOSE_CALLS compose call(s)"
+else
+  bad "no experimental slug in the registry to gate the NA path with"
+fi
+
+# --- 3. weights not on the host (the worktree / no-MODEL_DIR case) -----------
+GOOD_SLUG="$(python3 - "$ROOT_DIR" <<'PY'
+import sys; sys.path.insert(0, sys.argv[1])
+from scripts.lib.profiles.compose_registry import get_registry
+for k, v in get_registry().items():
+    if (v.get("status") or "production") == "production":
+        print(k); break
+PY
+)"
+if [[ -n "$GOOD_SLUG" ]]; then
+  run env PATH="$T/bin:$PATH" MODEL_DIR="$T/no-weights-here" bash scripts/switch.sh --no-wait "$GOOD_SLUG"
+  assert_contains "$OUT" "aren't on host" "missing weights refused"
+  [[ "$DOCKER_CALLS" -eq 0 && "$COMPOSE_CALLS" -eq 0 ]] \
+    && ok "missing weights refused WITHOUT touching docker" \
+    || bad "missing weights refused AFTER touching docker: $DOCKER_CALLS docker / $COMPOSE_CALLS compose call(s)"
+
+  # --- 4. an accepted launch DOES tear down, then bring up -------------------
+  run env PATH="$T/bin:$PATH" PREFLIGHT_NO_COMPOSE_DEPS=1 FORCE=1 bash scripts/switch.sh --no-wait "$GOOD_SLUG"
+  [[ "$RC" -eq 0 ]] && ok "accepted launch succeeds ($GOOD_SLUG)" \
+    || { bad "accepted launch failed (rc=$RC)"; printf '%s\n' "$OUT" >&2; }
+  assert_contains "$OUT" "bringing up: ${GOOD_SLUG}" "accepted launch brings the variant up"
+  [[ "$COMPOSE_CALLS" -ge 1 ]] && ok "compose up ran" || bad "compose up never ran"
+  [[ "$DOCKER_CALLS" -ge 1 ]] && ok "teardown still runs on an accepted launch" \
+    || bad "accepted launch never touched docker — teardown was skipped"
+  # Teardown (docker ps) must precede the bring-up, not follow it.
+  first_docker="$(printf '%s\n' "$LOG" | grep -n '^docker ' | head -1 | cut -d: -f1)"
+  last_compose="$(printf '%s\n' "$LOG" | grep -n '^compose .*up ' | tail -1 | cut -d: -f1)"
+  if [[ -n "$first_docker" && -n "$last_compose" && "$first_docker" -lt "$last_compose" ]]; then
+    ok "teardown happens BEFORE bring-up on the accepted path"
+  else
+    bad "teardown did not precede bring-up (docker line ${first_docker:-∅}, compose-up line ${last_compose:-∅})"
+  fi
+else
+  bad "no production slug found for the accepted-launch case"
+fi
+
+echo "----------------------------------------"
+echo "PASS: $PASS   FAIL: $FAIL"
+[[ "$FAIL" -eq 0 ]] || exit 1
+echo "OK: switch.sh gates before it tears down"
