+def _local_engine_profile_parts(spec: dict):
+    """(engine, content) for a NEW local ENGINE profile carried in the spec, or
+    None when the spec carries no such profile.
+
+    catalog.sh derives a minimal engine profile for an engine the catalog does
+    not know. It used to WRITE that file itself, in its own python, BEFORE
+    handing the spec to promote.py — which owns the plan, the ``--dry-run``
+    exit and the confirm. A write that had already happened could not be
+    stopped by any of those, so ``--dry-run`` leaked a real
+    ``engines.d/<engine>.yml`` (and that leaked file is what the round-trip
+    test's "engine profile written" check was silently passing on). The YAML
+    now rides in the spec as ``local_engine_profile`` and is written by
+    ``_write_local`` — gated by ``--dry-run`` like every other artifact.
+
+    Raises Refusal on a malformed entry or an engine id that could escape the
+    engines.d layer (path traversal)."""
+    lep = spec.get("local_engine_profile")
+    if not lep:
+        return None
+    if not isinstance(lep, dict):
+        raise Refusal("spec.local_engine_profile must be an object {engine, content}")
+    engine = lep.get("engine")
+    content = lep.get("content")
+    if not isinstance(engine, str) or not engine:
+        raise Refusal("spec.local_engine_profile.engine must be a non-empty string")
+    if not isinstance(content, str) or not content.strip():
+        raise Refusal("spec.local_engine_profile.content must be the ENGINE profile YAML")
+    if "/" in engine or ".." in engine or engine.startswith("."):
+        raise Refusal(f"spec.local_engine_profile.engine is not a safe engine id: {engine!r}")
+    return engine, content
+
