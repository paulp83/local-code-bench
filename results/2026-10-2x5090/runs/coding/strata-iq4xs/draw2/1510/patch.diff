+def container_gpu_selectors(container, inspect_json=None):
+    """Host GPU indices/UUIDs the container is pinned to; None = rig-wide.
+
+    Resolves the GPUs BEHIND the service under test, not the whole rig:
+      1. HostConfig.DeviceRequests[].DeviceIDs  (device reservations → HOST idx)
+      2. NVIDIA_VISIBLE_DEVICES in Config.Env    (host idx / UUID; "all" → None)
+      3. CUDA_VISIBLE_DEVICES                    (container-relative: index into
+         the base list when it is all digits, else treat as host selectors)
+
+    ``inspect_json`` lets callers (and tests) inject a pre-fetched `docker
+    inspect` payload instead of shelling out. Returns None when no container is
+    given, docker fails, or the container is not pinned to specific cards — the
+    caller then falls back to rig-wide measurement and says so. Selectors are
+    accepted verbatim by `nvidia-smi -i` (index, serial, UUID, or PCI bus id).
+    """
+    if inspect_json is None:
+        if not container:
+            return None
+        try:
+            proc = subprocess.run(
+                ["docker", "inspect", container],
+                capture_output=True,
+                text=True,
+                timeout=15,
+                encoding="utf-8",
+                errors="replace",
+            )
+            if proc.returncode != 0 or not proc.stdout.strip():
+                return None
+            inspect_json = json.loads(proc.stdout)
+        except Exception:
+            return None
+    if isinstance(inspect_json, list):
+        inspect_json = inspect_json[0] if inspect_json else None
+    if not isinstance(inspect_json, dict):
+        return None
+
+    base = None
+    for req in (inspect_json.get("HostConfig") or {}).get("DeviceRequests") or []:
+        ids = req.get("DeviceIDs") if isinstance(req, dict) else None
+        if ids:
+            base = [str(x) for x in ids]
+
+    env = {}
+    for entry in (inspect_json.get("Config") or {}).get("Env") or []:
+        key, sep, value = str(entry).partition("=")
+        if sep and value.strip():
+            env[key] = value.strip()
+
+    nvd = env.get("NVIDIA_VISIBLE_DEVICES", "")
+    if base is None and nvd and nvd.strip().lower() not in ("all", "void", "none"):
+        base = [v.strip() for v in nvd.split(",") if v.strip()]
+
+    cvd = env.get("CUDA_VISIBLE_DEVICES", "")
+    if cvd:
+        picks = [v.strip() for v in cvd.split(",") if v.strip()]
+        if base is not None and picks and all(p.isdigit() for p in picks):
+            base = [base[int(p)] for p in picks if int(p) < len(base)]
+        elif base is None and picks:
+            base = picks
+
+    return base or None
+
