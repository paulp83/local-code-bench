+def gpu_fingerprint(container=None, selectors=None):
+    """Human label for the GPUs behind the probed container.
+
+    "1× GeForce RTX 3060" for one card, "2× GeForce RTX 3090 + 1× RTX 4090" for
+    a pinned mixed set. When the container's cards cannot be resolved it falls
+    back to the whole rig and appends " (rig-wide)" so the card is honest about
+    the attribution instead of silently blaming every GPU on the machine.
+    """
+    if selectors is None:
+        selectors = container_gpu_selectors(container) if container else None
+    names = gpu_names(selectors)
+    if not names:
+        return "? GPU"
+    uniq = []
+    for nm in names:
+        if nm not in uniq:
+            uniq.append(nm)
+    if len(uniq) == 1:
+        label = f"{len(names)}× {uniq[0]}"
+    else:
+        label = " + ".join(f"{names.count(x)}× {x}" for x in uniq)
+    if selectors is None:
+        label += " (rig-wide)"
+    return label
+
