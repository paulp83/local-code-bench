+def gpu_names(selectors=None):
+    """GPU product names for ``selectors`` (rig-wide when None). [] on failure."""
+    try:
+        cmd = ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"]
+        if selectors:
+            cmd += ["-i", ",".join(str(x) for x in selectors)]
+        out = subprocess.run(
+            cmd, capture_output=True, text=True, timeout=10
+        ).stdout
+    except Exception:
+        return []
+    names = []
+    for line in out.splitlines():
+        n = line.strip()
+        if not n:
