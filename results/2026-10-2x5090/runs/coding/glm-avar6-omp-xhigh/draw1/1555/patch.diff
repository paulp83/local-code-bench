+        if s[j] == open_c:
+            depth += 1
+        elif s[j] == close_c:
+            depth -= 1
+            if depth == 0:
+                return s[open_idx + 1:j]
+    return ""
+
+
+def _vllm_spec_from_config_line(line):
+    """Spec label from one vLLM boot line, or None when it carries no spec config.
+
+    `speculative_config=None` → 'spec off';
+    `SpeculativeConfig(method='mtp', …, num_spec_tokens=4)` → 'MTP n=4'
+    (some versions print the field as num_speculative_tokens, some as
+    num_spec_tokens — both are read). Any other method prints as written
+    ('ngram', 'eagle n=4', …) rather than being folded into MTP.
+    """
+    i = line.find("speculative_config=")
+    if i < 0:
+        return None
+    val = line[i + len("speculative_config="):]
+    if re.match(r"None\b", val):
+        return "spec off"
