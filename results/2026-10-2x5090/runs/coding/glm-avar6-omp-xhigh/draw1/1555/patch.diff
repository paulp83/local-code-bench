+def container_for_url(url=None):
+    """Name of the running container publishing the port of ``url``, or ''.
+
+    From `docker ps` (any engine). The Ports column lists every published mapping
+    as `0.0.0.0:8020->8020/tcp, :::8020->8020/tcp`; the digits before each `->`
+    are the HOST-side port, so matching $URL's port finds the container that
+    actually serves it — a name heuristic cannot, and a container publishing a
+    different port must not be picked either.
