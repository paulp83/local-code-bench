+        port = urllib.parse.urlsplit(str(url or "").strip()).port
+    except ValueError:
+        return ""
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}|{{.Ports}}"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=15,
+        )
+    except Exception:
+        return ""
+    for line in (out.stdout or "").splitlines():
+        name, _sep, ports = line.partition("|")
