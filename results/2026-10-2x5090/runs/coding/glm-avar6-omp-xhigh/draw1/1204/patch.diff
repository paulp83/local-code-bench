+            # community | local). Provenance comes from the entry, never a
+            # slug-prefix sniff; "community" stays a future core-side value,
+            # not origin's business.
+            "source": (
+                "local"
+                if (REG.get(d["slug"], {}) or {}).get("origin") == "local"
+                else "curated"
+            ),
