diff --git a/scripts/tests/test-switch-refuse-before-teardown.sh b/scripts/tests/test-switch-refuse-before-teardown.sh
new file mode 100755
index 0000000..9b94183
--- /dev/null
+++ b/scripts/tests/test-switch-refuse-before-teardown.sh
@@ -0,0 +1,223 @@
+#!/usr/bin/env bash
+# test-switch-refuse-before-teardown — a refused switch.sh launch must NOT take
+# the running slug down.
+#
+# Bug: switch.sh tore the running slug down FIRST and only then ran the checks
+# that can refuse a launch. A refused launch therefore left the rig serving
+# nothing — hit three ways in one day on the reference rig:
+#   1. an experimental slug run without --force        (status_gate)
+#   2. a worktree whose model files weren't on the host (preflight_compose_deps)
+#   3. a mistyped slug                                  (unknown-variant guard)
+#
+# Contract:
+#   * switch.sh's main flow calls validate_variant() BEFORE down_running().
+#   * validate_variant() holds every refusal that needs NO teardown state:
+#     registry status, unknown slug, compose-file presence, host-side model
+#     files, GPU identity/capability, host RAM.
+#   * The teardown-DEPENDENT gates stay in up_variant() AFTER down_running():
+#     preflight_compose_gpu_fit + gpu_preflight (they gate on FREE VRAM, which
+#     the still-running slug is holding — pre-teardown they would refuse every
+#     healthy switch) and the free-VRAM-sized offload resolvers.
+#
+# Harness: static order assertions + a functional run of the real switch.sh
+# against a mock `docker` on PATH that records every down/stop/up call. Fully
+# offline — no docker daemon, no GPU.
+set -uo pipefail
+
+# switch.sh's table derivation + resolver calls are python3; carry the repo's
+# UTF-8-mode default here too (#779; test-locale-utf8.sh).
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0
+FAIL=0
+fail() { echo "FAIL: $*" >&2; FAIL=$((FAIL + 1)); }
+ok()   { PASS=$((PASS + 1)); }
+assert_contains() {
+  local haystack="$1" needle="$2" label="$3"
+  if [[ "$haystack" == *"$needle"* ]]; then ok; else
+    fail "$label: expected output to contain: $needle"; printf '%s\n' "$haystack" | head -20 >&2
+  fi
+}
+assert_not_contains() {
+  local haystack="$1" needle="$2" label="$3"
+  if [[ "$haystack" != *"$needle"* ]]; then ok; else
+    fail "$label: expected output to NOT contain: $needle"; printf '%s\n' "$haystack" | head -20 >&2
+  fi
+}
+
+SWITCH="$ROOT_DIR/scripts/switch.sh"
+
+# ---------------------------------------------------------------------------
+# Static 1 — main-flow ordering: validate_variant BEFORE down_running.
+# (`--down) down_running;` in the arg parser never matches '^down_running$',
+# so this anchors on the launch-flow call.)
+# ---------------------------------------------------------------------------
+line_validate="$(command grep -n '^validate_variant "\${VARIANT}"$' "$SWITCH" | head -1 | cut -d: -f1)"
+line_down="$(command grep -n '^down_running$' "$SWITCH" | head -1 | cut -d: -f1)"
+line_up="$(command grep -n '^up_variant "\${VARIANT}"$' "$SWITCH" | head -1 | cut -d: -f1)"
+if [[ -n "$line_validate" && -n "$line_down" && -n "$line_up" \
+      && "$line_validate" -lt "$line_down" && "$line_down" -lt "$line_up" ]]; then
+  ok
+else
+  fail "main flow must run validate_variant -> down_running -> up_variant in that order (validate='${line_validate}', down='${line_down}', up='${line_up}')"
+fi
+
+# Function bodies via the repo's sed-extraction convention.
+validate_body="$(sed -n '/^validate_variant()/,/^}/p' "$SWITCH")"
+up_body="$(sed -n '/^up_variant()/,/^}/p' "$SWITCH")"
+[[ -n "$validate_body" ]] || fail "could not extract validate_variant() from scripts/switch.sh"
+[[ -n "$up_body" ]] || fail "could not extract up_variant() from scripts/switch.sh"
+
+# Static 2 — validate_variant holds the teardown-independent refusals.
+for check in \
+  'unknown variant' \
+  'status_gate "$v"' \
+  'compose file missing' \
+  'preflight_compose_deps' \
+  'preflight_compose_hardware' \
+  'preflight_lmcache_ram' \
+  'preflight_offload_split_mode'; do
+  assert_contains "$validate_body" "$check" "validate_variant must hold refusal: $check"
+done
+
+# Static 3 — the teardown-dependent gates stay POST-teardown in up_variant.
+for check in 'gpu_preflight' 'preflight_compose_gpu_fit'; do
+  assert_contains "$up_body" "$check" "up_variant must keep teardown-dependent gate: $check"
+done
+
+# Static 4 — no duplication: validate_variant must NOT hold the teardown-
+# dependent gates (a later "complete the move" would refuse every healthy
+# switch, because the running slug holds the free VRAM the gates look for),
+# and up_variant must NOT re-run the refusals (the caveats/forcing notices
+# would print twice).
+for check in 'gpu_preflight' 'preflight_compose_gpu_fit'; do
+  assert_not_contains "$validate_body" "$check" "validate_variant must NOT run teardown-dependent gate: $check"
+done
+for check in 'status_gate "$v"' 'preflight_compose_deps' 'preflight_compose_hardware' 'preflight_lmcache_ram' 'preflight_offload_split_mode'; do
+  assert_not_contains "$up_body" "$check" "up_variant must NOT duplicate refusal: $check"
+done
+
+# ---------------------------------------------------------------------------
+# Functional harness: mock `docker` records every down/stop/up call.
+# ---------------------------------------------------------------------------
+tmp_dir="$(mktemp -d)"
+cleanup() { rm -rf "$tmp_dir"; }
+trap cleanup EXIT
+
+cat > "${tmp_dir}/docker" <<'EOF'
+#!/usr/bin/env bash
+case "${1:-}" in
+  ps)
+    for n in ${DOCKER_MOCK_RUNNING:-}; do printf '%s\n' "$n"; done
+    ;;
+  inspect)
+    fmt=""; name=""
+    while [[ $# -gt 0 ]]; do
+      case "$1" in
+        -f|--format) fmt="${2:-}"; shift 2 || true ;;
+        *) name="$1"; shift ;;
+      esac
+    done
+    case "$fmt" in
+      *working_dir*)   printf '%s\n' "${DOCKER_MOCK_WORKDIR:-$PWD}" ;;
+      *config_files*)  printf '%s\n' "/mock/compose/${name}.yml" ;;
+      *)               printf '%s\n' "" ;;
+    esac
+    ;;
+  compose)
+    shift; echo "COMPOSE $*" >> "${DOCKER_MOCK_LOG}"
+    ;;
+  stop)
+    echo "STOP $*" >> "${DOCKER_MOCK_LOG}"
+    ;;
+  *) : ;;
+esac
+exit 0
+EOF
+chmod +x "${tmp_dir}/docker"
+export PATH="${tmp_dir}:$PATH"
+export COMPOSE_BIN="docker compose"
+export DOCKER_MOCK_LOG="${tmp_dir}/calls.log"
+export DOCKER_MOCK_WORKDIR="${tmp_dir}"
+# Keep the run offline and hermetic: no git fetch, no /dev/shm probing, no
+# ready-wait, no OWUI/litellm side effects on the --no-wait path.
+export PREFLIGHT_NO_FETCH=1
+export CLUB3090_SHM_DIR="${tmp_dir}/shm-scratch"
+mkdir -p "${tmp_dir}/shm-scratch"
+export PREFLIGHT_NO_KV_HINT=1
+export OWUI_REGISTER=0
+
+# run_switch ARGS... → sets RUN_OUT / RUN_RC; log starts empty.
+run_switch() {
+  : > "$DOCKER_MOCK_LOG"
+  RUN_OUT="$(NVIDIA_VISIBLE_DEVICES=0,1 READY_TIMEOUT=1 bash "$SWITCH" "$@" 2>&1)"
+  RUN_RC=$?
+}
+
+log_has_teardown() { command grep -qE 'COMPOSE .*down --remove-orphans|^STOP' "$DOCKER_MOCK_LOG"; }
+log_has_up()       { command grep -qE 'COMPOSE .*up -d --remove-orphans' "$DOCKER_MOCK_LOG"; }
+
+# --- Leg 1: mistyped slug — refuse, rig keeps serving -------------------------
+run_switch --no-wait definitely-not-a-slug
+assert_contains "$RUN_OUT" "ERROR: unknown variant 'definitely-not-a-slug'" "mistyped slug refused"
+if [[ "$RUN_RC" -ne 0 ]]; then ok; else fail "mistyped slug must exit non-zero"; fi
+if log_has_teardown; then fail "mistyped slug: rig was torn down before the refusal"; else ok; fi
+assert_not_contains "$RUN_OUT" "bringing down" "mistyped slug: no teardown in output"
+
+# --- Leg 2: experimental slug without --force — refuse, rig keeps serving -----
+run_switch --no-wait vllm/qwen-35b-a3b-dual-nvfp4
+assert_contains "$RUN_OUT" "is (NA: experimental)" "experimental slug refused without --force"
+if [[ "$RUN_RC" -ne 0 ]]; then ok; else fail "experimental slug must exit non-zero"; fi
+if log_has_teardown; then fail "experimental slug: rig was torn down before the refusal"; else ok; fi
+assert_not_contains "$RUN_OUT" "bringing down" "experimental slug: no teardown in output"
+
+# --- Leg 3: model files not on host (no MODEL_DIR) — refuse, rig keeps serving
+# (env prefix OUTSIDE the command — inside the arg vector it parses as a second
+# positional variant, which leg 1 already covers.)
+: > "$DOCKER_MOCK_LOG"
+RUN_OUT="$(NVIDIA_VISIBLE_DEVICES=0,1 READY_TIMEOUT=1 MODEL_DIR=/nonexistent-host-dir bash "$SWITCH" --no-wait vllm/dual 2>&1)"
+RUN_RC=$?
+assert_contains "$RUN_OUT" "expects model files that aren't on host" "missing model dir refused"
+if [[ "$RUN_RC" -ne 0 ]]; then ok; else fail "missing model dir must exit non-zero"; fi
+if log_has_teardown; then fail "missing model dir: rig was torn down before the refusal"; else ok; fi
+assert_not_contains "$RUN_OUT" "bringing down" "missing model dir: no teardown in output"
+
+# --- Leg 4: NEGATIVE CONTROL — a healthy switch still tears down then up ------
+export PREFLIGHT_NO_COMPOSE_DEPS=1
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b-dual"
+run_switch --no-wait vllm/dual
+assert_contains "$RUN_OUT" "bringing down: vllm-qwen36-27b-dual" "healthy switch tears the old slug down"
+assert_contains "$RUN_OUT" "bringing up: vllm/dual" "healthy switch brings the new slug up"
+if [[ "$RUN_RC" -eq 0 ]]; then ok; else fail "healthy switch must exit 0 (rc=$RUN_RC)"; fi
+if log_has_teardown; then ok; else fail "healthy switch: teardown call missing from docker log"; fi
+if log_has_up; then ok; else fail "healthy switch: compose up missing from docker log"; fi
+down_line="$(printf '%s\n' "$RUN_OUT" | command grep -n 'bringing down: vllm-qwen36-27b-dual' | head -1 | cut -d: -f1)"
+up_line="$(printf '%s\n' "$RUN_OUT" | command grep -n 'bringing up: vllm/dual' | head -1 | cut -d: -f1)"
+if [[ -n "$down_line" && -n "$up_line" && "$down_line" -lt "$up_line" ]]; then
+  ok
+else
+  fail "healthy switch: teardown must precede bring-up in output (down='${down_line}', up='${up_line}')"
+fi
+unset DOCKER_MOCK_RUNNING PREFLIGHT_NO_COMPOSE_DEPS
+
+# --- Leg 5: explicit `--down` still tears down on its own ----------------------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b-dual"
+down_out="$(NVIDIA_VISIBLE_DEVICES=0,1 bash "$SWITCH" --down 2>&1)"
+down_rc=$?
+assert_contains "$down_out" "bringing down: vllm-qwen36-27b-dual" "--down still tears down"
+if [[ "$down_rc" -eq 0 ]]; then ok; else fail "--down must exit 0 (rc=$down_rc)"; fi
+if log_has_teardown; then ok; else fail "--down: teardown call missing from docker log"; fi
+unset DOCKER_MOCK_RUNNING
+
+# --- Summary -------------------------------------------------------------------
+echo "----------------------------------------"
+echo "PASS: $PASS   FAIL: $FAIL"
+if [[ "$FAIL" -eq 0 ]]; then
+  echo "OK: switch.sh refuses a launch BEFORE tearing down the running slug"
+  exit 0
+fi
+exit 1
