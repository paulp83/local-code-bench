index 0fdd75b..b026b41 100755
--- a/scripts/preflight.sh
+++ b/scripts/preflight.sh
@@ -957,6 +957,25 @@ _preflight_compose_vllm_subdir() {
   printf '%s' "$value"
 }
 
+# _preflight_compose_hf_tokens <compose-file>... — emit every in-container
+# `/root/.cache/huggingface/<path>` token the vLLM deps check extracts, raw
+# (unresolved `${VAR:-default}` text included). Char-class must NOT exclude `:`
+# or `}` — model paths can be `/root/.cache/huggingface/${MODEL_SUBDIR:-default}`
+# (vLLM) and excluding those truncated the token to `${MODEL_SUBDIR` before
+# _preflight_compose_path_default could resolve the `:-default`, causing a false
+# "missing" (the gemma-4-12b MODEL_SUBDIR/SPEC_MODEL_SUBDIR composes). It MUST
+# exclude `\` — the assistant-drafter composes write the spec config as escaped
+# JSON (`SPEC_ARGS=(--speculative-config "{\"model\":\"/root/.cache/huggingface/<drafter>\"…}")`),
+# and without `\` the match ran past the dir name and consumed the trailing
+# backslash, capturing `<drafter>\` and demanding a `<MODEL_DIR>/<drafter>\/config.json`
+# that can never exist (the gemma-4-12b / 26b-a4b / 31b assistant composes).
+# Stop only at real delimiters (quote / backslash / whitespace / comma); the
+# `${VAR:-default}` resolver runs downstream.
+_preflight_compose_hf_tokens() {
+  command grep -hv '^[[:space:]]*#' "$@" 2>/dev/null \
+    | command grep -oE '/root/\.cache/huggingface/[^"'\''\\[:space:],]+' || true
+}
+
 _preflight_missing_rel() {
   local model_dir="$1"
   local item="$2"
@@ -1324,13 +1343,9 @@ preflight_compose_deps() {
           shard_dirs+=("${model_dir}/${subdir}")
         fi
       fi
