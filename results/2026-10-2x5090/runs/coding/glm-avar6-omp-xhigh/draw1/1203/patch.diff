 def compute_promote_scaffold(
@@ -3282,3 +3148,61 @@ def attribute_gpu_apps(
         if not name and app.used_mib > 0:
             degraded = True
     return apps, degraded
+
+
+# ── #1202 P1: compose→facts derivation moved to the shared profiles layer ───────
+
+# ComposeFacts / _ENGINE_BY_IMAGE / derive_compose_facts used to live in this
+# module. #1202 P1 lifted them verbatim into scripts/lib/profiles/compose_facts.py
+# so the CLI-side profiles tooling can import the same compose→spec derivation
+# the UI owned (the reason #1153's local-model layer was write-only from the
+# UI: a user with a working compose had a door in c3 and no door at all from
+# the CLI). This module-level __getattr__ (PEP 562) DELEGATES those names: it
+# fires only for attributes NOT in this module's namespace, lazily importing
+# them from the shared module on first access — every existing caller and test
+# keeps doing `from club3090_cockpit.data import derive_compose_facts` (or
+# reading ComposeFacts) unchanged. Lazy for the same reason
+# _plain_spec_to_model_spec above: the shared module lives in
+# scripts.lib.profiles, importable only once the repo root is on sys.path, and
+# this module must stay importable without it until a moved name is touched.
+_MOVED_TO_COMPOSE_FACTS = ("ComposeFacts", "_ENGINE_BY_IMAGE", "derive_compose_facts")
+
+
+def __getattr__(name: str):
+    if name not in _MOVED_TO_COMPOSE_FACTS:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    # Provision the repo root the same GUARDED way services.CockpitData.__init__
+    # does: only insert a root that actually carries the profiles tree, so a tmp
+    # fixture root on sys.path can never shadow the real one. __file__-derived
+    # for the editable-install layout (…/tools/serve-cockpit/club3090_cockpit/
+    # data.py → parents[3] = the repo root); a non-editable install has no
+    # scripts tree next to it, inserts nothing, and the import below fails
+    # loudly with the Fix hint instead of silently importing a foreign tree.
+    import sys as _sys
+    from pathlib import Path as _Path
+
+    root = _Path(__file__).resolve().parents[3]
+    if (
+        str(root) not in _sys.path
+        and (root / "scripts" / "lib" / "profiles" / "compose_facts.py").exists()
+    ):
+        _sys.path.insert(0, str(root))
+    try:
+        from scripts.lib.profiles.compose_facts import (
+            ComposeFacts,
+            _ENGINE_BY_IMAGE,
+            derive_compose_facts,
+        )
+    except ModuleNotFoundError as e:  # pragma: no cover - unresolvable scripts tree
+        raise ImportError(
+            "compose→spec derivation moved to scripts/lib/profiles/compose_facts.py "
+            "(#1202 P1); club3090_cockpit.data re-exports it lazily, but the repo "
+            "root carrying the scripts tree is not on sys.path. "
+            "Fix: run from the repo checkout (or construct CockpitData first — it "
+            "provisions sys.path), or export PYTHONPATH=<repo root>."
+        ) from e
+    return {
+        "ComposeFacts": ComposeFacts,
+        "_ENGINE_BY_IMAGE": _ENGINE_BY_IMAGE,
+        "derive_compose_facts": derive_compose_facts,
+    }[name]
