+# --------------------------------------------------------------------------
+# chat_template wiring — the dedicated sound check (replaces the generic
+# marker logic above for `delivery_mechanism: chat_template`).
+# --------------------------------------------------------------------------
+# The model-default template filename every HF repo ships. As a mount-SOURCE
+# identifier it is generic: any compose mounting any template names it, so it
+# may only corroborate a mount whose container target is itself specific.
+_GENERIC_TEMPLATE_BASENAMES = frozenset({"chat_template.jinja", "chat_template.jinja2", "chat_template.j2"})
+
+# llama.cpp takes `--chat-template-file`, vLLM `--chat-template`; the shorter
+# flag is a PREFIX of the longer one, so every body probe below must not let a
+# `--chat-template-file` occurrence satisfy a `--chat-template` probe.
+_CHAT_TEMPLATE_FLAGS = ("--chat-template-file", "--chat-template")
+
+
+def _chat_flag_rx(flag: str) -> re.Pattern:
+    """A chat-template flag that is NOT merely a prefix of a longer flag."""
+    return re.compile(re.escape(flag) + r"(?![-\w])")
+
+
+def _chat_template_sources(patch: dict) -> tuple[list[str], list[str]]:
+    """(strong, weak) host-side names identifying THIS patch's template on a
+    mount line (#1610 follow-up cause 3 — the same source-aware lesson #1597
+    taught for install scripts):
+
+    * strong — the vendored template's own directory name and any non-generic
+      filename (e.g. ``qwen38-reasoning-effort-template``,
+      ``apex-qwen-chat-template.jinja``, ``glm53-minja-numeric-index``): only a
+      mount whose source IS this patch's vendored file carries them;
+    * weak — the generic model-default basename (``chat_template.jinja``): any
+      template mount carries it, so it only corroborates a mount whose target
+      is specific (never the bare model-dir suffix targets).
+    """
+    spec = patch.get("delivery_spec") or {}
+    strong: set[str] = set()
+    weak: set[str] = set()
+    rels = list(patch.get("files") or [])
+    if spec.get("jinja"):
+        rels.append(spec["jinja"])
+    for rel in rels:
+        p = Path(rel)
+        name = p.name
+        if not name or name in _GENERIC_SCRIPT_NAMES or name == "patches":
+            continue
+        if p.suffix and name in _GENERIC_TEMPLATE_BASENAMES:
+            weak.add(name)
+        else:
+            strong.add(name)
+        parent = p.parent.name
+        if p.suffix and parent and parent != "patches":
+            strong.add(parent)
+    return sorted(strong), sorted(weak)
+
+
+def _chat_template_mount_ok(patch: dict, lines: list[str]) -> bool:
+    """True iff some body line mounts THIS patch's vendored template at the
+    spec's ``mounted_at`` target — the source identifies the patch, the target
+    the insertion point (#1610 follow-up cause 3).
+
+    A bare ``mounted_at`` (mounted straight over the served checkpoint's own
+    ``chat_template.jinja`` — the qwen38 style) is a SUFFIX of every model-dir
+    template target, so for those the generic basename must never count: the
+    line must carry this patch's own directory/unique filename.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    strong, weak = _chat_template_sources(patch)
+    bare_target = Path(mounted_at).parent == Path("/")
+    for ln in lines:
+        if mounted_at not in ln:
+            continue
+        if any(s in ln for s in strong):
+            return True
+        if not bare_target and any(w in ln for w in weak):
+            return True
+    return False
+
+
+def _flag_arg_names_target(lines: list[str], flag: str, target: str) -> bool:
+    """True iff a ``flag`` occurrence in ``lines`` is ARGUMENTED with ``target``:
+    either on the same line after the flag (flow-sequence items and folded
+    scalars render that way) or as the immediately following list item (block
+    sequences render `- --chat-template` / `- <path>` on adjacent lines).
+    The flag itself is never matched as a prefix of a longer flag."""
+    rx = _chat_flag_rx(flag)
+    for idx, ln in enumerate(lines):
+        for m in rx.finditer(ln):
+            if target in ln[m.end():]:
+                return True
+            for nxt in lines[idx + 1 : idx + 2]:
+                s = nxt.strip()
+                if s.startswith("-"):
+                    if target in s.lstrip("-").strip().strip("'\""):
+                        return True
+    return False
+
+
+def _chat_template_invoke_ok(patch: dict, lines: list[str]) -> bool:
+    """True iff the compose passes ``--chat-template`` / ``--chat-template-file``
+    naming THIS patch's mounted path (#1610 follow-up cause 1).
+
+    * explicit-flag style (the invoke names an absolute path — froggeric,
+      gemma-canonical, apex, glm53): the flag is REQUIRED wiring — a mount
+      alone is not a reach, and a flag naming another file is a foreign reach;
+    * scoped style (the invoke is a placeholder description — the qwen38
+      template's invoke reads "vLLM composes only"): the flag is
+      engine-conditional, so a compose that mounts the template and passes NO
+      chat-template flag still reaches (the engine auto-loads it from the
+      model dir — the SGLang composes). But a flag naming a FOREIGN template
+      never counts as reaching this patch.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at") or ""
+    invoke = spec.get("invoke") or ""
+    declared = [f for f in _CHAT_TEMPLATE_FLAGS if f in invoke]
+    if not declared:
+        return True  # mount-only style (carnice): no flag semantics to satisfy
+    ok = any(_flag_arg_names_target(lines, f, mounted_at) for f in declared)
+    if any(re.search(re.escape(f) + r"\s+[\"']?/", invoke) for f in declared):
+        return ok
+    any_flag = any(_chat_flag_rx(f).search(ln) for f in declared for ln in lines)
+    return ok or not any_flag
+
+
+def _chat_template_wired(patch: dict, lines: list[str]) -> bool:
+    """The sound chat_template reach: the compose must BOTH mount this patch's
+    vendored template (source-aware) AND, at the insertion point(s) its
+    ``wired_at`` claims, pass the flag naming that mounted path. ``command``
+    and ``entrypoint`` are the same launch-command insertion point (apex /
+    glm53 declare ``command`` on the llama.cpp composes)."""
+    spec = patch.get("delivery_spec") or {}
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = {"entrypoint" if w == "command" else w for w in (wired_at or [])}
+    if not _chat_template_mount_ok(patch, lines):
+        return False
+    if wired_at == {"volumes"}:
+        return True  # mount-only: the mounted template IS the load-bearing artifact
+    return _chat_template_invoke_ok(patch, lines)
+
