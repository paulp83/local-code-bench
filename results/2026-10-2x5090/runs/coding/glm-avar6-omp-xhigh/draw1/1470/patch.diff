diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..f1b3da9 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -99,6 +99,45 @@ r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' "CustomAllred
 unset _sgl_raw _sgl_evidence
 echo "  ✓ SGLang runtime: NCCL + custom-AR init classified; restart epoch and vetoes preserved"
 
+# ⭐ SGLang V1 CustomAllreduce — the class every PCIe rig runs. `can_use_custom_all_reduce_v2`
+# requires full NVLink, so a P2P rig boots the V1 CustomAllreduce, which logs NOTHING at
+# init. Its ONLY success signal is "Registering N cuda graph addresses", printed on rank 0
+# AFTER CUDA-graph capture when the captured graphs' buffers are registered. Without that
+# line a healthy PCIe boot could never score "on" — it showed unknown / "no P2P engagement
+# signal" in report.sh and on the bench card. Real wording shape, SGLang v0.5.20 V1 path
+# (the count is the number of registered addresses and varies with the captured graph set).
+_sgl_v1_raw=$(cat <<'EOF'
+[2026-10-09 03:41:12] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-09 03:42:04 TP0] sglang is using nccl==2.30.7
+[2026-10-09 03:44:51 TP0] Registering 258 cuda graph addresses
+EOF
+)
+# The normalizer must PASS THE LINE THROUGH: report.sh/bench.sh classify the filtered
+# stream, so a normalizer that drops it keeps the whole rig blind to V1 boots.
+_sgl_v1_ev="$(printf '%s\n' "$_sgl_v1_raw" | p2p_engine_log_evidence)"
+assert_contains "$_sgl_v1_ev" "Registering 258 cuda graph addresses"
+r="$(printf '%s\n' "$_sgl_v1_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1_raw" | p2p_classify_engagement)"   # unfiltered stream too
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 registration -> on (got $r)"
+# Boot args alone are still not proof (unchanged): drop the registration line and a
+# V1 boot degrades back to unknown, never a claimed "on".
+r="$(printf '%s\n%s' '[sglang] BOOT disable_custom_all_reduce=False' 'sglang is using nccl==2.30.7' | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "V1 boot without the registration line stays unknown (got $r)"
+# Restart epochs hold for the V1 line: a later operator-disabled boot must not inherit
+# the earlier boot's registration proof, and the reverse order stays a clean "on".
+r="$(printf '%s\n%s' "$_sgl_v1_ev" '[sglang] BOOT disable_custom_all_reduce=True' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator restart after a V1-registered boot wins (got $r)"
+r="$(printf '%s\n%s' '[sglang] BOOT disable_custom_all_reduce=True' "$_sgl_v1_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "V1-registered restart after an operator-disabled boot wins (got $r)"
+# On a STATE-carrying boot the same line is positive proof that falsifies our veto
+# prediction: a graph-buffer registration can only exist if the kernel initialized
+# and ran, so gate=expected_veto must not downgrade it to nccl_only_gated.
+r="$(printf '%s\n%s' '[nvlink] STATE v=1 transport=pcie_p2p kernel=on cause=none verified=yes gate=expected_veto mode=auto world=2' 'Registering 258 cuda graph addresses' | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "STATE gate=expected_veto falsified by V1 registration proof (got $r)"
+unset _sgl_v1_raw _sgl_v1_ev
+echo "  ✓ SGLang V1 (PCIe): graph-buffer registration line scores on; epochs and gate prediction hold"
+
