+def _check_local_engine_profile(spec: dict, root: Path, slug: str) -> None:
+    """The engine profile carried by catalog.sh register (``local_engine_profile``).
+    Validated HERE — before anything is written — because a profile that cannot
+    load takes the WHOLE profile system down on the next load (every launcher
+    calls load_profiles(), core slugs included): the same catastrophic dangling-
+    reference class the caller already refuses unknown workloads for. The write
+    itself happens in ``_write_local`` so it passes through this executor's plan
+    / --dry-run exit / confirm with every other artifact."""
+    lep = spec.get("local_engine_profile")
+    if lep is None:
+        return
+    if not isinstance(lep, dict):
+        raise Refusal(
+            "spec.local_engine_profile must be a dict "
+            "{'engine': <id>, 'content': <engine YAML text>}"
+        )
+    eng = lep.get("engine")
+    content = lep.get("content")
+    if not isinstance(eng, str) or not eng.strip():
+        raise Refusal(
+            "spec.local_engine_profile.engine is required and must be a non-empty string"
+        )
+    if not isinstance(content, str) or not content.strip():
+        raise Refusal(
+            "spec.local_engine_profile.content is required (the engine YAML text)"
+        )
+    slug_engine = slug.split("/", 1)[0]
+    if eng != slug_engine:
+        raise Refusal(
+            f"spec.local_engine_profile.engine {eng!r} != the registry slug's engine "
+            f"{slug_engine!r} — the entry would reference an engine whose profile "
+            f"is never written"
+        )
+    ep_path = root / _LOCAL_ENGINES_REL / f"{eng}.yml"
+    if ep_path.exists():
+        raise Refusal(f"local engine profile already exists: {ep_path}")
+    # Load the CARRIED text through the loader's OWN factory — a typo'd key or a
+    # YAML-broken value (a `--engine-type` string containing ': ' would do it)
+    # must refuse here, not break every load from then on. Skipped when the
+    # loader is unavailable for dependency reasons (no PyYAML): _post_write_checks
+    # already requires it, so such a rig cannot complete a write either way.
+    try:
+        import yaml  # noqa: E402
+    except Exception:
+        return
+    try:
+        if str(root) not in sys.path:
+            sys.path.insert(0, str(root))
+        from scripts.lib.profiles.compat import _engine as engine_factory  # noqa: E402
+    except Exception:
+        return
+    try:
+        data = yaml.safe_load(content)
+        profile = engine_factory(data or {}, ep_path)
+        assert profile.id == eng, f"profile id {profile.id!r} != engine {eng!r}"
+    except Exception as exc:
+        raise Refusal(
+            f"spec.local_engine_profile.content is not a loadable engine profile "
+            f"({_LOCAL_ENGINES_REL}/{eng}.yml): {exc}"
+        )
+
