+chmod +x "$HOST_STUB"/*
+
+set +e
+out="$(PATH="$HOST_STUB:$PATH" MODEL=qwen3.6-27b URL=http://localhost:8020 ROUNDS=1 bash "$PROBE" 2>&1)"; rc=$?
+set -e
