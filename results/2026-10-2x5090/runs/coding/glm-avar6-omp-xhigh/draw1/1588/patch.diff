+def _mapping_serves(ports, port, addrs, own):
+    """Does one `docker ps` Ports string serve ``port`` to one of ``addrs`` on this host?
+    The per-mapping arm of ports_serve_url (scripts/lib/listen-scope.sh, #1584): the mapping
+    must be published (an `->`), its host-side port or range must cover ``port``, and its bind
+    address must cover the URL's host — 0.0.0.0 / [::] / :: cover loopback and the machine's
+    own addresses, a 127.x / [::1] publish only a loopback URL, a specific address only itself."""
+    for m in ports.split(","):
+        m = m.strip()
+        if "->" not in m:
+            continue                              # exposed-only, not published
+        pub = m.split("->", 1)[0]
+        if ":" in pub:
+            bind, _, hp = pub.rpartition(":")     # 0.0.0.0:8020 · [::]:8020 · 127.0.0.1:6333-6334
+        else:
+            bind = hp = pub                       # the shell's ${m%:*} / ${m##*:} on a colon-less bind
+        bind = bind.strip("[]")
+        lo, sep, hi = hp.partition("-")
