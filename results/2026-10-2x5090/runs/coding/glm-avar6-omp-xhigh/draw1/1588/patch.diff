+def _host_addrs(host):
+    """Addresses ``host`` names — the twin of _host_addrs in scripts/lib/listen-scope.sh
+    (#1584): localhost / 0.0.0.0 are the loopback pair, an IPv6 literal or a numeric IPv4 is
+    itself, a name is whatever it resolves to. [] when it names no address of ours (another
+    machine's address, an unresolvable name): such a URL is not served by a container here."""
+    if host in ("localhost", "0.0.0.0"):
+        return ["127.0.0.1", "::1"]
+    if ":" in host or re.fullmatch(r"[0-9.]+", host):
+        return [host]
+    try:
+        infos = socket.getaddrinfo(host, None)
+    except Exception:
+        return []
+    return sorted({i[4][0] for i in infos})
+
