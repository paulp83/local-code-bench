+# --- #1584 follow-up: the container is picked by the URL's HOST ----------------
+# container_for_url used to compare the PORT alone, so with a local vLLM on :8020 at
+# --max-num-seqs 4, URL=http://10.9.9.9:8020 bound the local container and a run against another
+# machine reported its slot count, GPU label, spec and KV pool as the remote server's. And when
+# nothing matched, the script's `vllm-(qwen|gemma)` name heuristic bound one anyway. The lookup
+# must answer by the host: another machine's address or name, an unresolvable name, and a publish
+# that doesn't cover the URL's host (loopback-only vs LAN, single-address vs loopback) all refuse.
+# Same matrix as test-preflight-autodetect.sh's ports_serve_url section — both answers must agree.
+python3 - "$LIB" <<'PY' || fail "container_for_url host matrix"
+import importlib.util, socket, sys
+spec = importlib.util.spec_from_file_location("cp", sys.argv[1])
+m = importlib.util.module_from_spec(spec); sys.modules["cp"] = m
+spec.loader.exec_module(m)
+
+DNS = {"rig.lan": "192.168.1.5", "myrig": "127.0.1.1", "other.lan": "10.9.9.9"}
+real_getaddrinfo = socket.getaddrinfo
+def fake_getaddrinfo(host, port, *a, **k):
+    if host in DNS:
+        return [(socket.AF_INET, socket.SOCK_STREAM, 6, "", (DNS[host], 0))]
+    return real_getaddrinfo(host, port, *a, **k)
+socket.getaddrinfo = fake_getaddrinfo
+m._own_addrs = lambda: {"192.168.1.5", "172.17.0.1"}   # what `hostname -I` reports, as the shell side reads it
+
+W = "0.0.0.0:8020->8000/tcp, [::]:8020->8000/tcp"
+L = "127.0.0.1:8031->8000/tcp"
+S = "192.168.1.5:8040->8000/tcp"
+R = "0.0.0.0:6333-6334->6333-6334/tcp"
+E = "8000/tcp"
+cases = [
+    ("http://localhost:8020",            [f"vllm-a|{W}"], "vllm-a"),
+    ("http://localhost:8021",            [f"vllm-a|{W}"], ""),                # nobody publishes that port
+    ("http://127.0.0.1:8020/v1",         [f"vllm-a|{W}"], "vllm-a"),
+    ("http://[::1]:8020",                [f"vllm-a|{W}"], "vllm-a"),
+    ("http://192.168.1.5:8020",          [f"vllm-a|{W}"], "vllm-a"),          # this host's own LAN address
+    ("http://10.9.9.9:8020",             [f"vllm-a|{W}"], ""),                # THE #1584 repro: same port, another machine
+    ("http://rig.lan:8020",              [f"vllm-a|{W}"], "vllm-a"),          # a name resolving to this host's LAN address
+    ("http://myrig:8020",                [f"vllm-a|{W}"], "vllm-a"),          # this host's own name (Debian: 127.0.1.1)
+    ("http://other.lan:8020",            [f"vllm-a|{W}"], ""),                # a name resolving to another machine
+    ("http://unresolvable.invalid:8020", [f"vllm-a|{W}"], ""),                # a name resolving to nothing
+    ("http://localhost:8031",            [f"vllm-loop|{L}"], "vllm-loop"),
+    ("http://192.168.1.5:8031",          [f"vllm-loop|{L}"], ""),             # loopback-only publish is not on the LAN address
+    ("http://192.168.1.5:8040",          [f"vllm-lan|{S}"], "vllm-lan"),
+    ("http://localhost:8040",            [f"vllm-lan|{S}"], ""),              # a single-address publish is not on loopback
+    ("http://localhost:6334",            [f"qdrant|{R}"], "qdrant"),          # a published range counts
+    ("http://localhost:8000",            [f"exposed|{E}"], ""),               # exposed, not published
+    ("http://localhost:8021",            [f"vllm-a|{W}", "vllm-gemma|0.0.0.0:8021->8000/tcp"], "vllm-gemma"),
