+def _url_host_port(url):
+    """("host", "port") from a URL — the twin of url_host_port in scripts/lib/listen-scope.sh:
+    the port defaults from the scheme (80 / 443), userinfo is stripped, an IPv6 literal comes
+    back without its brackets. None when the URL carries no host at all."""
+    m = re.match(r"^([A-Za-z][A-Za-z0-9+.-]*)://([^/?#]+)", url or "")
     if not m:
+        return None
+    hostport = m.group(2).split("@")[-1]        # user@host:port → host:port
+    if not hostport:
+        return None
+    if hostport.startswith("["):                 # [::1]:8020
+        host, _, rest = hostport[1:].partition("]")
+        port = rest[1:] if rest.startswith(":") else ""
+    else:
+        host, _, port = hostport.partition(":")
+    if not host:
+        return None
+    if not port:
+        port = "443" if m.group(1).lower() == "https" else "80"
+    return host, port
