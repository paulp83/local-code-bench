diff --git a/scripts/tests/test-catalog-amend.sh b/scripts/tests/test-catalog-amend.sh
new file mode 100755
index 0000000..f41a117
--- /dev/null
+++ b/scripts/tests/test-catalog-amend.sh
@@ -0,0 +1,361 @@
+#!/usr/bin/env bash
+# Guard: scripts/catalog.sh rename / update — the local layer is no longer
+# create-and-delete only (#1202 P7), and the remedy #1204 advertised for a
+# SHADOWED slug ("kept and marked so the user can rename it") actually exists.
+#
+# Pins the properties the interface promises:
+#   1. rename moves the registry entry to the new key and the entry's `engine`
+#      field follows the new slug namespace; origin stays `local`; the layer
+#      still loads through load_local_registry; models.d/composes stay put;
+#   2. a shadowed local slug (a core slug that is ALSO a local row) is
+#      renameable and updateable — refusing it would leave the shadowed row
+#      with no remedy but unregister + re-register;
+#   3. refusals, each leaving the registry byte-identical: a slug that is not
+#      a local row (curated or typo), renaming ONTO a curated slug, renaming
+#      onto an existing local slug, `--set origin=…`, unknown kwargs, a status
+#      the loader refuses, an engine/namespace disagreement, and a new
+#      namespace that is not a known engine;
+#   4. --dry-run exits 0 and changes nothing; engine/namespace drift on OTHER
+#      rows is repaired (loudly) as part of any amend.
+set -uo pipefail
+# Non-UTF-8 locales break python3 reads/writes on this rig (#599/#584).
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+# Warm the real tree's __pycache__ BEFORE any md5 comparison: the curated-catalog
+# check below must measure content, not an import's bytecode side effect.
+python3 -c "import sys; sys.path.insert(0,'.'); import scripts.lib.profiles.compose_registry" >/dev/null 2>&1
+
+# Arch dims come from the weights. A fabricated config.json exercises that path
+# without depending on a multi-GB GGUF existing on a contributor's machine.
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+W="$TMP/config.json"
+C="$TMP/byo.yml"
+cat > "$C" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a byo-probe -c 65536 -ctk q8_0 -ts 1,1
+YML
+
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+
+# The merged-view reader every assertion uses — fails loudly if the layer broke.
+layer() {
+  python3 - "$TMP" <<'PY' 2>&1
+import json, sys
+from pathlib import Path
+root = Path(sys.argv[1])
+sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+try:
+    local = load_local_registry(root)
+except Exception as exc:
+    print("LOAD_FAIL:", exc)
+    raise SystemExit(0)
+print(json.dumps(local, default=str, sort_keys=True))
+PY
+}
+
+say_ok() { echo "  ok   $1"; }
+say_fail() { echo "  FAIL $1"; rc=1; }
+
+if ! scripts/catalog.sh register --compose "$C" --engine their-engine --engine-type llama.cpp --weights "$W" --root "$TMP" -y >/dev/null 2>&1; then
+  echo "  FAIL register failed in a throwaway root"; exit 1
+fi
+
+SLUG="their-engine/byo-probe"
+
+# 1. rename within a namespace: entry moves, engine field stays the namespace.
+if out="$(scripts/catalog.sh rename --slug "$SLUG" --to their-engine/byo-probe2 --root "$TMP" 2>/dev/null)" \
+   && [[ "$out" == "RENAME_OK $SLUG -> their-engine/byo-probe2" ]]; then
+  say_ok "rename within namespace succeeded with the success marker"
+else
+  say_fail "rename within namespace: stdout was '$out'"
+fi
+if [[ -f "$REG" ]] && command grep -q '"their-engine/byo-probe2"' "$REG" \
+   && ! command grep -q '"their-engine/byo-probe"' "$REG"; then
+  say_ok "registry key moved"
+else
+  say_fail "registry key did not move"
+fi
+l="$(layer)"
+if [[ "$l" != LOAD_FAIL* ]]; then
+  if python3 -c "
+import json, sys
+d = json.loads('''$l''')
+e = d['their-engine/byo-probe2']
+assert e['engine'] == 'their-engine', e['engine']
+assert e['origin'] == 'local', e['origin']
+" 2>/dev/null; then
+    say_ok "renamed row keeps engine == slug namespace and origin=local; layer loads"
+  else
+    say_fail "renamed row failed the engine/origin/load invariants"
+  fi
+else
+  say_fail "layer no longer loads after rename: $l"
+fi
+
+# 2. rename to another KNOWN engine: the engine field follows the namespace.
+if out="$(scripts/catalog.sh rename --slug their-engine/byo-probe2 --to llama-cpp-local/byo-probe --root "$TMP" 2>&1)"; then
+  if python3 -c "
+import json
+d = json.loads('''$(layer)''')
+e = d['llama-cpp-local/byo-probe']
+assert e['engine'] == 'llama-cpp-local', e['engine']
+" 2>/dev/null; then
+    say_ok "cross-engine rename rewrote the engine field to the new namespace"
+  else
+    say_fail "cross-engine rename did not sync the engine field"
+  fi
+else
+  say_fail "cross-engine rename refused: $out"
+fi
+SLUG="llama-cpp-local/byo-probe"
+
+# 3. --dry-run exits 0 and leaves the registry unchanged.
+before="$(md5sum "$REG" | cut -d' ' -f1)"
+if scripts/catalog.sh rename --slug "$SLUG" --to their-engine/byo-probe --root "$TMP" --dry-run >/dev/null 2>&1; then
+  say_ok "rename --dry-run exits 0"
+else
+  say_fail "rename --dry-run did not exit 0"
+fi
+if scripts/catalog.sh update --slug "$SLUG" --set workload=fast-chat --root "$TMP" --dry-run >/dev/null 2>&1; then
+  say_ok "update --dry-run exits 0"
+else
+  say_fail "update --dry-run did not exit 0"
+fi
+[[ "$before" == "$(md5sum "$REG" | cut -d' ' -f1)" ]] \
+  && say_ok "dry-runs changed nothing" \
+  || say_fail "a dry-run wrote"
+
+# 4. update succeeds and parses JSON-shaped values (ints, null).
+if out="$(scripts/catalog.sh update --slug "$SLUG" --set workload=fast-chat --set max_ctx=8192 --set status=experimental --set kv_format=q8_0 --root "$TMP" 2>/dev/null)" \
+   && [[ "$out" == "UPDATE_OK $SLUG" ]]; then
+  if python3 -c "
+import json
+d = json.loads('''$(layer)''')
+e = d['$SLUG']
+assert e['workload'] == 'fast-chat' and e['max_ctx'] == 8192, (e['workload'], e['max_ctx'])
+assert e['status'] == 'experimental' and e['kv_format'] == 'q8_0'
+assert e['engine'] == 'llama-cpp-local' and e['origin'] == 'local'
+" 2>/dev/null; then
+    say_ok "update wrote the amended kwargs; invariants intact"
+  else
+    say_fail "updated row failed the assertions"
+  fi
+else
+  say_fail "update failed: $out"
+fi
+
+# 5. JSON-shaped values: a string write, then null to clear it again.
+if scripts/catalog.sh update --slug "$SLUG" --set status_note="amended by test" --root "$TMP" >/dev/null 2>&1 \
+   && python3 -c "
+import json
+d = json.loads('''$(layer)''')
+assert d['$SLUG']['status_note'] == 'amended by test', d['$SLUG']['status_note']
+" 2>/dev/null; then
+  say_ok "--set writes a string kwarg"
+else
+  say_fail "--set of a string kwarg failed"
+fi
+if scripts/catalog.sh update --slug "$SLUG" --set status_note=null --root "$TMP" >/dev/null 2>&1 \
+   && python3 -c "
+import json
+d = json.loads('''$(layer)''')
+assert d['$SLUG']['status_note'] is None, d['$SLUG']['status_note']
+" 2>/dev/null; then
+  say_ok "--set status_note=null clears the field"
+else
+  say_fail "--set status_note=null did not clear"
+fi
+
+# 6. refusals. Each must exit non-zero AND leave the registry byte-identical.
+refuse() { # exit-code-check wrapper: $1 description, $2 expected fragment, rest = command
+  local desc="$1" needle="$2"; shift 2
+  local out code
+  out="$("$@" 2>&1)"; code=$?
+  if [[ "$code" -eq 0 ]]; then
+    say_fail "$desc was accepted (exit 0)"
+    return 0
+  fi
+  if [[ -n "$needle" && "$out" != *"$needle"* ]]; then
+    say_fail "$desc refused but does not name the fix ($needle)"
+    return 0
+  fi
+  say_ok "$desc refused${needle:+, fix named}"
+}
+CORE_SLUG="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+CORE_MODEL="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+e = next(iter(COMPOSE_REGISTRY.values())); print(e.get('model'))")"
+snap="$(md5sum "$REG" | cut -d' ' -f1)"
+check_unchanged() {
+  [[ "$snap" == "$(md5sum "$REG" | cut -d' ' -f1)" ]] && return 0
+  say_fail "a refusal wrote to the registry"
+  return 1
+}
+
+refuse "renaming a slug that is not registered" "not in" \
+  scripts/catalog.sh rename --slug nope/x --to their-engine/y --root "$TMP"
+check_unchanged
+refuse "renaming a CURATED slug" "CURATED" \
+  scripts/catalog.sh rename --slug "$CORE_SLUG" --to their-engine/y --root "$TMP"
+check_unchanged
+refuse "renaming ONTO a curated slug" "CURATED" \
+  scripts/catalog.sh rename --slug "$SLUG" --to "$CORE_SLUG" --root "$TMP"
+check_unchanged
+refuse "renaming to an unknown engine namespace" "not a known engine" \
+  scripts/catalog.sh rename --slug "$SLUG" --to no-such-engine/y --root "$TMP"
+check_unchanged
+refuse "renaming to the removed local/ namespace" "local/" \
+  scripts/catalog.sh rename --slug "$SLUG" --to local/y --root "$TMP"
+check_unchanged
+refuse "updating a CURATED slug" "CURATED" \
+  scripts/catalog.sh update --slug "$CORE_SLUG" --set workload=fast-chat --root "$TMP"
+check_unchanged
+refuse "updating an unregistered slug" "not in" \
+  scripts/catalog.sh update --slug nope/x --set workload=fast-chat --root "$TMP"
+check_unchanged
+refuse "--set origin= (origin is not editable)" "origin is not editable" \
+  scripts/catalog.sh update --slug "$SLUG" --set origin=core --root "$TMP"
+check_unchanged
+refuse "--set of an unknown kwarg" "unknown registry kwarg" \
+  scripts/catalog.sh update --slug "$SLUG" --set not_a_kwarg=1 --root "$TMP"
+check_unchanged
+refuse "--set status= the loader would refuse" "not one of" \
+  scripts/catalog.sh update --slug "$SLUG" --set status=not-a-status --root "$TMP"
+check_unchanged
+refuse "--set engine= that disagrees with the slug namespace" "rename" \
+  scripts/catalog.sh update --slug "$SLUG" --set engine=their-engine --root "$TMP"
+check_unchanged
+refuse "--set model= colliding with a core model id" "collides with a CORE model" \
+  scripts/catalog.sh update --slug "$SLUG" --set model="$CORE_MODEL" --root "$TMP"
+check_unchanged
+refuse "malformed --set (no '=')" "KEY=VALUE" \
+  scripts/catalog.sh update --slug "$SLUG" --set novalue --root "$TMP"
+check_unchanged
+if scripts/catalog.sh update --slug "$SLUG" --root "$TMP" >/dev/null 2>&1; then
+  say_fail "update without --set was accepted"
+else
+  say_ok "update without --set refused"
+fi
+check_unchanged
+
+# 7. rename onto an existing local slug → duplicate refused. Needs a second row.
+if ! scripts/catalog.sh register --compose "$C" --engine their-engine --model probe-two --engine-type llama.cpp --weights "$W" --root "$TMP" -y >/dev/null 2>&1; then
+  say_fail "second register failed"
+else
+  snap="$(md5sum "$REG" | cut -d' ' -f1)"   # the register wrote; re-baseline
+  refuse "renaming ONTO an existing local slug" "already a LOCAL slug" \
+    scripts/catalog.sh rename --slug their-engine/probe-two --to "$SLUG" --root "$TMP"
+  check_unchanged
+  refuse "--set model= colliding with another local row" "already used by another local slug" \
+    scripts/catalog.sh update --slug their-engine/probe-two --set model=byo-probe --root "$TMP"
+  check_unchanged
+fi
+
+# 8. THE #1204 REMEDY: a shadowed row (key == a curated slug, origin local) is
+#    renameable and updateable. Hand-write one next to the registered rows.
+python3 - "$TMP" "$CORE_SLUG" <<'PY' || { echo "  FAIL could not seed the shadow row"; rc=1; }
+import inspect, json, sys
+from pathlib import Path
+root, core_slug = Path(sys.argv[1]), sys.argv[2]
+sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY, _entry
+tmpl = dict(COMPOSE_REGISTRY[core_slug])
+kw = {n: tmpl[n] for n in inspect.signature(_entry).parameters if n in tmpl}
+kw.pop("origin", None)
+kw["model"] = "guard-amend-shadow"
+kw["status"] = "incubating"
+reg = root / "scripts/lib/profiles-local/registry.local.json"
+raw = json.loads(reg.read_text(encoding="utf-8"))
+raw[core_slug] = kw
+# a drift row: namespace IS a known engine, engine field says something else —
+# the drift the hard-cut abolished; any amend must repair it.
+raw["their-engine/drift"] = dict(kw, model="guard-amend-drift", engine="wrong-engine",
+                                 compose_path="scripts/lib/profiles-local/composes/drift/x/base.yml")
+reg.write_text(json.dumps(raw, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+PY
+
+if [[ "$rc" == "0" ]]; then
+  l="$(layer)"
+  if python3 -c "
+import json
+d = json.loads('''$l''')
+assert d['$CORE_SLUG'].get('shadowed_by_core') is True, 'shadow row not marked'
+assert d['their-engine/drift']['engine'] == 'wrong-engine'
+" 2>/dev/null; then
+    say_ok "shadow row seeded and marked shadowed_by_core; drift row seeded"
+  else
+    say_fail "seeded layer failed the pre-amend assertions: ${l:0:200}"
+  fi
+
+  if scripts/catalog.sh rename --slug "$CORE_SLUG" --to their-engine/renamed-shadow --root "$TMP" >/dev/null 2>&1; then
+    say_ok "SHADOWED slug renamed in place (the advertised remedy exists)"
+  else
+    say_fail "shadowed slug could not be renamed — the #1204 remedy is still unreachable"
+  fi
+  if scripts/catalog.sh update --slug their-engine/renamed-shadow --set status=experimental --root "$TMP" >/dev/null 2>&1; then
+    say_ok "shadowed-then-renamed row updated in place"
+  else
+    say_fail "renamed shadow row could not be updated"
+  fi
+  l="$(layer)"
+  if python3 -c "
+import json
+d = json.loads('''$l''')
+e = d['their-engine/renamed-shadow']
+assert e['origin'] == 'local' and e['engine'] == 'their-engine', (e['origin'], e['engine'])
+assert e['status'] == 'experimental'
+assert d['their-engine/drift']['engine'] == 'their-engine', 'drift not repaired'
+assert d['$SLUG']['engine'] == 'llama-cpp-local'
+" 2>/dev/null; then
+    say_ok "engine/namespace drift on an unrelated row repaired by the amend"
+  else
+    say_fail "drift repair assertion failed: ${l:0:200}"
+  fi
+fi
+
+# 9. the curated catalog is unreachable from the front door — no file changed.
+core_before="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+[[ "$core_before" == "$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)" ]] \
+  && say_ok "no file under scripts/lib/profiles/ changed" \
+  || say_fail "the curated catalog changed"
+
+# 10. round trip: the renamed slug unregisters cleanly.
+if scripts/catalog.sh unregister --slug "$SLUG" --root "$TMP" -y >/dev/null 2>&1; then
+  if command grep -q '"'"$SLUG"'"' "$REG" 2>/dev/null; then
+    say_fail "unregister left the renamed slug behind"
+  else
+    say_ok "renamed slug unregisters cleanly"
+  fi
+else
+  say_fail "unregister failed on a renamed slug"
+fi
+
+# 11. the front door advertises the new subcommands.
+if scripts/catalog.sh -h 2>&1 | command grep -q "rename.*--to"; then
+  say_ok "usage lists rename"
+else
+  say_fail "usage does not list rename"
+fi
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames and updates the local layer in place" \
+                   || echo "FAIL: catalog.sh amend regression"
+exit "$rc"
