+++ b/scripts/lib/profiles/amend.py
@@ -0,0 +1,639 @@
+#!/usr/bin/env python3
+"""Local-layer AMEND — rename a local slug or edit its registry kwargs.
+
+Until now the layer was create-and-delete only: ``promote.py`` refuses every
+"already exists" case and ``demote.py`` only removes, so changing ONE field
+meant unregistering and re-registering the model. That mattered more than
+ergonomics — #1204 decided a local slug colliding with a newly-shipped curated
+one is *shadowed* (kept, marked, "so the user can rename it"), and no rename
+existed: the advertised remedy could not be reached. This closes it.
+
+    python3 scripts/lib/profiles/amend.py rename --slug OLD --to NEW
+    python3 scripts/lib/profiles/amend.py update --slug SLUG --set KEY=VALUE [--set KEY=VALUE …]
+
+CORE IS NEVER TOUCHED. The only file either subcommand can write is
+``scripts/lib/profiles-local/registry.local.json`` (under ``--root``).
+``models.d/`` and ``composes/`` are keyed by MODEL id, which neither operation
+changes, so they are left exactly as they are; ``engines.d/`` is left alone too
+(rename never retires an engine — ``unregister`` does that cleanup).
+
+A slug that is not a local row — curated or a typo — is refused before
+anything is read or written, and renaming ONTO a curated slug is refused too:
+core wins the lookup, so a local row under a curated name would be unreachable
+by slug and unremovable by name.
+
+``origin`` is not editable. It is stamped by the loader; a local row that
+declared its own provenance would be spoofable (see test-registry-origin-field).
+
+The slug namespace IS the engine identity of a local row — ``promote.py``
+derives the slug from the engine — so a rename keeps ``entry["engine"]`` equal
+to the new slug's namespace, and an update that would break that equality is
+refused (move the slug with ``rename`` instead). Renaming to another engine
+requires that namespace to be a KNOWN engine: core engine profiles plus the
+local ``engines.d/`` ones. An unknown namespace is refused, because an entry
+whose ``engine`` resolves to nothing fails cross-reference validation for every
+consumer of the merged catalog.
+
+Every amend rewrites the whole registry and re-checks it for engine/namespace
+drift first: a row whose namespace IS a known engine but whose ``engine`` field
+says something else is repaired (loudly, naming the row), because that drift is
+exactly what the hard-cut (#1202 P3) abolished. A row whose namespace is NOT a
+known engine is reported but kept — rewriting its ``engine`` to an unknown id
+would break cross-reference validation, a worse outcome than the drift. Before
+anything is written, the FINAL dict is checked against every condition
+``load_local_registry()`` refuses on (shape, legacy namespace, origin spoofing,
+model-id collisions, ``_entry`` kwargs) — an amend must never leave a layer
+that no longer loads.
+
+Exit codes match promote.py / demote.py: 0 success, 3 refusal (nothing
+written), 2 internal failure after a write started.
+
+Success markers (the c3 parser hook)::
+
+    RENAME_OK <old> -> <new>
+    UPDATE_OK <slug>
+"""
+
+from __future__ import annotations
+
+import argparse
+import inspect
+import json
+import os
+import re
+import sys
+import tempfile
+from pathlib import Path
+from typing import Optional
+
+# An amend must not leave ANY trace outside registry.local.json — not even the
+# bytecode caches an import would otherwise write next to the curated catalog.
+sys.dont_write_bytecode = True
+
+_HERE = Path(__file__).resolve()
+_DEFAULT_ROOT = _HERE.parents[3]
+
+_LOCAL_DIR_REL = "scripts/lib/profiles-local"
+_LOCAL_REGISTRY_REL = f"{_LOCAL_DIR_REL}/registry.local.json"
+_LOCAL_ENGINES_REL = f"{_LOCAL_DIR_REL}/engines.d"
+
+EXIT_COLLISION = 3
+EXIT_INTERNAL = 2
+
+# The legacy namespace promote.py/demote.py hard-cut (#1202 P3).
+_LOCAL_NS = "local/"
+
+
+class Refusal(Exception):
+    """Nothing has been written; the caller can fix the input and retry."""
+
+
+class InternalError(Exception):
+    """The write had started — state may be partial."""
+
+
+def _info(msg: str) -> None:
+    print(f"[amend] {msg}", file=sys.stderr)
+
+
+# ── reading ───────────────────────────────────────────────────────────────────
+
+def _load_local_raw(root: Path) -> dict:
+    """The RAW registry.local.json dict ({} when absent). Bad JSON refuses:
+    amending a broken layer would either fail mid-write or bake the break in."""
+    path = root / _LOCAL_REGISTRY_REL
+    if not path.is_file():
+        return {}
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise Refusal(f"{path} is unreadable — fix or remove it first: {exc}")
+    if not isinstance(data, dict) or not all(isinstance(v, dict) for v in data.values()):
+        raise Refusal(f"{path} is not a JSON object of {{slug: {{_entry kwargs}}}}")
+    return data
+
+
+_CR = None
+
+
+def _registry_module(root: Path):
+    """compose_registry FROM THE GIVEN ROOT, imported once per process.
+
+    Always the root's own copy — a same-directory import would resolve the
+    DEFAULT tree's module even under --root, whose local_layer_root() would
+    then read the wrong registry.local.json."""
+    global _CR
+    if _CR is not None:
+        return _CR
+    sys.path.insert(0, str(root))
+    try:
+        import scripts.lib.profiles.compose_registry as cr  # noqa: E402
+    except Exception as exc:
+        raise Refusal(f"could not load the compose registry from {root}: {exc}")
+    _CR = cr
+    return cr
+
+
+def _core_catalog(root: Path) -> tuple[set, set]:
+    """(curated slugs, curated model ids) — the collision universe."""
+    cr = _registry_module(root)
+    return (
+        set(cr.COMPOSE_REGISTRY),
+        {e.get("model") for e in cr.COMPOSE_REGISTRY.values()},
+    )
+
+
+def _editable_kwargs(root: Path) -> frozenset:
+    """The _entry kwargs a user may set — every kwarg EXCEPT ``origin``.
+
+    Enumerated from the factory rather than a hand-kept list: a kwarg added to
+    _entry() later must be amendable without this file knowing (the same lesson
+    the register derivation in catalog.sh paid for twice)."""
+    cr = _registry_module(root)
+    params = inspect.signature(cr._entry).parameters
+    return frozenset(params) - {"origin"}
+
+
+# ── engines ───────────────────────────────────────────────────────────────────
+
+def _scan_engine_ids(dir_path: Path) -> set:
+    """Top-level ``id:`` of every engine YAML — the stdlib-only fallback set.
+
+    Anchored at column 0, so an ``id:`` inside a nested block scalar cannot be
+    picked up. Good enough for a fallback that only runs when PyYAML is
+    unavailable or the full profile load cannot complete."""
+    ids = set()
+    if not dir_path.is_dir():
+        return ids
+    for path in sorted(dir_path.glob("*.yml")):
+        try:
+            text = path.read_text(encoding="utf-8")
+        except OSError:
+            continue
+        m = re.search(r"^id:\s*(\S.*?)\s*$", text, re.MULTILINE)
+        if m:
+            ids.add(m.group(1))
+    return ids
+
+
+def _known_engines(root: Path) -> set:
+    """Engine ids the catalog knows: core engine profiles + local engines.d/.
+
+    Prefers compat.load_profiles() — the SAME set register uses to decide
+    whether an engine needs a local profile written for it. Falls back to the
+    stdlib scan when that cannot run (no PyYAML, or cross-reference errors from
+    a layer the user hand-edited): the guard must not disable itself, but it
+    must also not take the whole amend down with an unrelated profile-load
+    failure."""
+    prof = root / "scripts/lib/profiles"
+    # The probe is best-effort with a fallback, so its own logging (INFO
+    # progress, ERROR cross-ref dumps on a layer that will not load) is noise
+    # here — the amend's refusals carry the story. Defaulted, not forced: a
+    # user who set CLUB3090_LOG_LEVEL keeps their level.
+    os.environ.setdefault("CLUB3090_LOG_LEVEL", "CRITICAL")
+    engines: set = set()
+    try:
+        sys.path.insert(0, str(root))
+        from scripts.lib.profiles.compat import load_profiles  # noqa: E402
+
+        engines = set(load_profiles(prof).engines)
+    except Exception:
+        engines = set()
+    if not engines:
+        engines = _scan_engine_ids(prof / "engines") | _scan_engine_ids(
+            root / _LOCAL_ENGINES_REL
+        )
+    return engines
+
+
+# ── slugs ─────────────────────────────────────────────────────────────────────
+
+def _slug_namespace(slug: str, what: str) -> str:
+    """Validate the '<engine>/<name>' shape and return the namespace."""
+    parts = slug.split("/", 1)
+    if (
+        slug.count("/") != 1
+        or slug.startswith("/")
+        or slug.endswith("/")
+        or not parts[0]
+        or not parts[1]
+    ):
+        raise Refusal(f"{what} slug {slug!r} must be '<engine>/<name>'")
+    return parts[0]
+
+
+def _refuse_absent(root: Path, slug: str, raw: dict) -> None:
+    """Refuse a slug that is not a local row, naming curated vs typo."""
+    if slug in raw:
+        return
+    core_slugs, _ = _core_catalog(root)
+    if slug in core_slugs:
+        raise Refusal(
+            f"{slug!r} is a CURATED catalog entry, not a local one. This tool "
+            f"edits only {_LOCAL_REGISTRY_REL}; a curated entry is git-tracked "
+            f"and git is its edit tool."
+        )
+    known = ", ".join(sorted(raw)) or "(none registered)"
+    raise Refusal(f"{slug} is not in {_LOCAL_REGISTRY_REL}. Registered: {known}")
+
+
+def _legacy_ns_refusal(slug: str, *, onto: bool = False) -> Refusal:
+    # The stripped tail appears only INSIDE refusal messages, in branches the
+    # callers reached after proving the prefix is present — never as a derived
+    # value (test-local-slug-shape refuses that arithmetic outright).
+    if onto:
+        raise Refusal(
+            f"the {_LOCAL_NS!r} namespace was removed (#1202 P3) — local slugs use "
+            f"the same '<engine>/<name>' shape as curated ones. "
+            f"Use '<engine>/{slug[len(_LOCAL_NS):]}'"
+        )
+    raise Refusal(
+        f"{slug!r} still uses the removed {_LOCAL_NS!r} namespace — re-register "
+        f"it as '<engine>/{slug[len(_LOCAL_NS):]}' first (promote.py names that "
+        f"replacement)"
+    )
+
+
+# ── the engine/namespace invariant (#1202 P3) ─────────────────────────────────
+
+def _repair_engine_drift(raw: dict, known_engines: set) -> tuple[dict, list, list]:
+    """engine := slug namespace for any row that drifted, where the fix is safe.
+
+    Returns (repaired raw, repaired slugs, unrepairable slugs). A row whose
+    namespace is NOT a known engine is reported-but-kept — see the module
+    docstring; repairing it would write an unknown engine into the entry."""
+    repaired: list = []
+    unrepairable: list = []
+    out: dict = {}
+    for slug, entry in raw.items():
+        ns = slug.split("/", 1)[0] if slug.count("/") == 1 else None
+        if ns is None:
+            out[slug] = entry
+            continue
+        if entry.get("engine") == ns:
+            out[slug] = entry
+        elif ns in known_engines:
+            fixed = dict(entry)
+            fixed["engine"] = ns
+            out[slug] = fixed
+            repaired.append(slug)
+        else:
+            out[slug] = entry
+            unrepairable.append(slug)
+    return out, repaired, unrepairable
+
+
+def _assert_loadable(root: Path, new_raw: dict) -> None:
+    """Every condition load_local_registry() refuses on, checked BEFORE the write.
+
+    An amend must never leave a layer that no longer loads — prove the FINAL
+    dict passes, not hope the loader will. Mirrors compose_registry's checks
+    (shape, legacy namespace, origin spoofing, model-id collisions, _entry
+    kwargs) so the refusal can name the exact row instead of failing after."""
+    cr = _registry_module(root)
+    _core_slugs, core_models = _core_catalog(root)
+    seen_models: set = set()
+    for slug, kwargs in new_raw.items():
+        if slug.startswith(_LOCAL_NS):
+            _legacy_ns_refusal(slug)
+        parts = slug.split("/", 1)
+        if (
+            slug.count("/") != 1
+            or slug.startswith("/")
+            or slug.endswith("/")
+            or not parts[0]
+            or not parts[1]
+        ):
+            raise Refusal(f"local slug {slug!r} must be '<engine>/<name>'")
+        if "origin" in kwargs:
+            raise Refusal(
+                f"local entry {slug!r} may not set 'origin' — it is stamped by "
+                f"the loader, not self-declared"
+            )
+        model = kwargs.get("model")
+        if model in core_models:
+            raise Refusal(
+                f"local model id {model!r} collides with a core model"
+            )
+        if model in seen_models:
+            raise Refusal(f"duplicate local model id {model!r} (also on another row)")
+        seen_models.add(model)
+        try:
+            cr._entry(**kwargs)
+        except TypeError as exc:
+            raise Refusal(f"local entry {slug!r} has bad _entry kwargs: {exc}")
+        except ValueError as exc:
+            raise Refusal(f"local entry {slug!r}: {exc}")
+
+
+def _report_repairs(repaired: list, unrepairable: list, raw: dict) -> None:
+    for slug in repaired:
+        _info(
+            f"repaired engine drift on {slug!r}: engine now follows its "
+            f"slug namespace ({slug.split('/', 1)[0]!r})"
+        )
+    for slug in unrepairable:
+        _info(
+            f"⚠ {slug!r}: engine {raw[slug].get('engine')!r} does not match its slug "
+            f"namespace {slug.split('/', 1)[0]!r}, which is not a known engine — "
+            f"left as-is rather than writing an unknown engine into the entry"
+        )
+
+
+# ── rename ────────────────────────────────────────────────────────────────────
+
+def plan_rename(root: Path, old: str, new: str) -> dict:
+    """Validate a slug rename. Pure: reads only, never writes."""
+    raw = _load_local_raw(root)
+    _refuse_absent(root, old, raw)
+    _slug_namespace(old, "existing")
+    if old.startswith(_LOCAL_NS):
+        _legacy_ns_refusal(old)
+    if new == old:
+        return {"kind": "rename", "root": root, "old": old, "new": new, "noop": True}
+    if new.startswith(_LOCAL_NS):
+        _legacy_ns_refusal(new, onto=True)
+    new_ns = _slug_namespace(new, "new")
+    core_slugs, _ = _core_catalog(root)
+    if new in core_slugs:
+        raise Refusal(
+            f"cannot rename onto {new!r} — it is a CURATED catalog entry and core "
+            f"wins the lookup, so the renamed row would be unreachable by slug "
+            f"and unremovable by name"
+        )
+    if new in raw:
+        raise Refusal(
+            f"cannot rename onto {new!r} — it is already a LOCAL slug; renaming "
+            f"would leave a duplicate the loader refuses"
+        )
+    known = _known_engines(root)
+    if new_ns not in known:
+        raise Refusal(
+            f"the engine namespace {new_ns!r} of the new slug is not a known engine "
+            f"(known: {', '.join(sorted(known)) or 'none'}). The slug namespace IS "
+            f"the entry's engine identity, so it must resolve — register the engine "
+            f"first (catalog.sh register writes an engines.d/ profile from evidence) "
+            f"or rename within a known namespace"
+        )
+    entry = dict(raw[old])
+    entry["engine"] = new_ns
+    return {
+        "kind": "rename",
+        "root": root,
+        "old": old,
+        "new": new,
+        "noop": False,
+        "entry": entry,
+        "engine_changed": entry["engine"] != raw[old].get("engine"),
+    }
+
+
+def _describe_rename(plan: dict) -> None:
+    if plan["noop"]:
+        _info(f"{plan['old']} -> {plan['new']}: same slug, nothing to do")
+        return
+    _info(f"registry  {plan['old']} -> {plan['new']}  ({_LOCAL_REGISTRY_REL})")
+    if plan["engine_changed"]:
+        _info(f"engine    -> {plan['entry']['engine']!r} (follows the new slug namespace)")
+    _info("files     models.d/ + composes/ are keyed by MODEL id — untouched")
+
+
+def apply_rename(root: Path, plan: dict) -> None:
+    if plan["noop"]:
+        return
+    try:
+        raw = _load_local_raw(root)
+        new_raw = {
+            plan["new"] if slug == plan["old"] else slug: (
+                plan["entry"] if slug == plan["old"] else entry
+            )
+            for slug, entry in raw.items()
+        }
+        new_raw, repaired, unrepairable = _repair_engine_drift(
+            new_raw, _known_engines(root)
+        )
+        _assert_loadable(root, new_raw)
+        _write_raw(root, new_raw)
+    except OSError as exc:
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+    _info(f"renamed {plan['old']} -> {plan['new']}")
+    _report_repairs(repaired, unrepairable, new_raw)
+
+
+# ── update ────────────────────────────────────────────────────────────────────
+
+def _coerce(value: str):
+    """Registry kwargs are JSON-shaped; coerce a --set value the same way.
+
+    Numbers/booleans/null parse as JSON ("262144" → int, "null" → None, so
+    --set drafter=null works); anything else stays the string it is. A quoted
+    string ("…") also parses as JSON and keeps its literal content."""
+    try:
+        return json.loads(value)
+    except ValueError:
+        return value
+
+
+def plan_update(root: Path, slug: str, sets: list[str]) -> dict:
+    """Validate a kwargs update. Pure: reads only, never writes."""
+    raw = _load_local_raw(root)
+    _refuse_absent(root, slug, raw)
+    ns = _slug_namespace(slug, "existing")
+    if slug.startswith(_LOCAL_NS):
+        _legacy_ns_refusal(slug)
+    editable = _editable_kwargs(root)
+    cr = _registry_module(root)
+    _core_slugs, core_models = _core_catalog(root)
+
+    parsed: list[tuple[str, object]] = []
+    for item in sets:
+        if "=" not in item:
+            raise Refusal(f"--set takes KEY=VALUE (got {item!r} without '=')")
+        key, _, raw_value = item.partition("=")
+        if not key.strip():
+            raise Refusal(f"--set needs a KEY before '=' (got {item!r})")
+        if key == "origin":
+            raise Refusal(
+                "origin is not editable — it is stamped by the loader ('core' for "
+                "curated rows, 'local' for yours) and a row that declared its own "
+                "provenance would be spoofable. It changes only when the entry is "
+                "published to the curated catalog (export_pr.py)."
+            )
+        if key not in editable:
+            raise Refusal(
+                f"unknown registry kwarg {key!r}. Editable keys (the _entry kwargs): "
+                f"{', '.join(sorted(editable))}"
+            )
+        value = _coerce(raw_value)
+        if key == "engine" and value != ns:
+            raise Refusal(
+                f"engine {value!r} would disagree with the slug's namespace {ns!r} — "
+                f"the namespace IS the engine identity of a local row, so move the "
+                f"slug instead: amend.py rename --slug {slug} --to {ns}/<name>"
+            )
+        if key == "status" and value not in cr.STATUS_VALUES:
+            raise Refusal(
+                f"status {value!r} is not one of {cr.STATUS_VALUES} — the loader "
+                f"refuses it, so writing it would break the layer"
+            )
+        if key == "model":
+            if not isinstance(value, str) or not value.strip():
+                raise Refusal("model must be a non-empty string")
+            if value in core_models:
+                raise Refusal(
+                    f"model id {value!r} collides with a CORE model — the loader "
+                    f"refuses it, so writing it would break the layer"
+                )
+            others = {
+                e.get("model")
+                for s, e in raw.items()
+                if s != slug and isinstance(e, dict)
+            }
+            if value in others:
+                raise Refusal(
+                    f"model id {value!r} is already used by another local slug — "
+                    f"the loader refuses duplicate local model ids"
+                )
+        parsed.append((key, value))
+
+    entry = dict(raw[slug])
+    before = {k: entry.get(k) for k, _v in parsed}
+    entry.update(parsed)
+    # Dry-wrap the amended kwargs EXACTLY like the loader will (promote.py does
+    # the same before its write) — a bad kwarg or status must refuse with the
+    # --set that caused it, not with a generic whole-layer error after.
+    try:
+        cr._entry(**entry)
+    except TypeError as exc:
+        raise Refusal(f"the amended entry would not load: {exc}")
+    except ValueError as exc:
+        raise Refusal(f"the amended entry would not load: {exc}")
+    return {
+        "kind": "update",
+        "root": root,
+        "slug": slug,
+        "entry": entry,
+        "changes": [(k, before[k], v) for k, v in parsed],
+    }
+
+
+def _describe_update(plan: dict) -> None:
+    for key, old, new in plan["changes"]:
+        _info(f"{key:24s} {old!r} -> {new!r}")
+    _info(f"registry  {plan['slug']}  ({_LOCAL_REGISTRY_REL})")
+    _info("files     models.d/ + composes/ are keyed by MODEL id — untouched")
+
+
+def apply_update(root: Path, plan: dict) -> None:
+    try:
+        raw = _load_local_raw(root)
+        raw[plan["slug"]] = plan["entry"]
+        new_raw, repaired, unrepairable = _repair_engine_drift(
+            raw, _known_engines(root)
+        )
+        _assert_loadable(root, new_raw)
+        _write_raw(root, new_raw)
+    except OSError as exc:
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+    _info(f"updated {plan['slug']}")
+    _report_repairs(repaired, unrepairable, new_raw)
+
+
+# ── the write ─────────────────────────────────────────────────────────────────
+
+def _write_raw(root: Path, raw: dict) -> None:
+    """Rewrite registry.local.json atomically (temp sibling + os.replace).
+
+    Same formatting promote.py writes (indent=2, non-ASCII kept) so the file
+    never changes style behind a reader's back. A failed write leaves the
+    original intact — a truncated registry is a broken layer."""
+    reg = root / _LOCAL_REGISTRY_REL
+    tmp = None
+    try:
+        reg.parent.mkdir(parents=True, exist_ok=True)
+        fd, tmp = tempfile.mkstemp(dir=str(reg.parent), prefix=".registry.", suffix=".json")
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            json.dump(raw, fh, indent=2, ensure_ascii=False)
+            fh.write("\n")
+        os.replace(tmp, reg)
+        tmp = None
+    finally:
+        if tmp is not None:
+            try:
+                os.unlink(tmp)
+            except OSError:
+                pass
+
+
+# ── CLI ───────────────────────────────────────────────────────────────────────
+
+def main(argv: Optional[list[str]] = None) -> int:
+    ap = argparse.ArgumentParser(
+        prog="amend.py",
+        description=(
+            "Amend the LOCAL layer in place: rename a slug, edit registry kwargs. "
+            "Never touches the curated catalog."
+        ),
+    )
+    sub = ap.add_subparsers(dest="op", required=True)
+
+    p_rename = sub.add_parser(
+        "rename", help="rename a local slug (keeps engine = slug namespace)"
+    )
+    p_rename.add_argument("--slug", required=True, help="the existing local slug")
+    p_rename.add_argument("--to", required=True, help="the new '<engine>/<name>' slug")
+
+    p_update = sub.add_parser(
+        "update", help="edit a local entry's registry kwargs in place"
+    )
+    p_update.add_argument("--slug", required=True, help="the local slug to amend")
+    p_update.add_argument(
+        "--set",
+        action="append",
+        required=True,
+        metavar="KEY=VALUE",
+        help="a _entry kwarg to set (repeatable); JSON-shaped values parse as JSON",
+    )
+
+    for p in (p_rename, p_update):
+        p.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root")
+        p.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
+    args = ap.parse_args(argv)
+
+    root = Path(args.root).resolve()
+    try:
+        if args.op == "rename":
+            plan = plan_rename(root, args.slug, args.to)
+            _describe_rename(plan)
+            if not args.dry_run:
+                apply_rename(root, plan)
+        else:
+            plan = plan_update(root, args.slug, list(args.set))
+            _describe_update(plan)
+            if not args.dry_run:
+                apply_update(root, plan)
+    except Refusal as exc:
+        print(f"[amend] refused: {exc}", file=sys.stderr)
+        return EXIT_COLLISION
+    except InternalError as exc:
+        print(f"[amend] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    if args.dry_run:
+        _info("dry-run — nothing written")
+        return 0
+    if args.op == "rename":
+        print(f"RENAME_OK {args.slug} -> {args.to}")
+    else:
+        print(f"UPDATE_OK {args.slug}")
+    return 0
+
+
+if __name__ == "__main__":  # pragma: no cover - thin CLI shim
+    try:
+        raise SystemExit(main())
+    except Refusal as exc:  # defensive: raised outside the validate window
+        print(f"[amend] REFUSED: {exc}", file=sys.stderr)
+        raise SystemExit(EXIT_COLLISION)
+    except InternalError as exc:
+        print(f"[amend] ERROR: {exc}", file=sys.stderr)
+        raise SystemExit(EXIT_INTERNAL)
