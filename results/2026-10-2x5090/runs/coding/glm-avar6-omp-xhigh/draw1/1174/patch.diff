+# The "tool unavailable" class — the `hf` CLI itself is missing or unusable, so
+# rung 1 never downloaded anything. Two surfaces, both rc=127: `_hf_download`'s
+# own synthetic (this exact message, lowercased) and the shell's
+# command-not-found. "not found" alone is NOT a marker: huggingface_hub's own
+# 404 says "Repository Not Found".
+_TOOL_UNAVAILABLE_MARKERS = (
+    "command not found",
+    "neither `hf` nor `huggingface-cli` is on path",
+)
+
+
+def is_tool_unavailable(blob: str) -> bool:
+    """True iff a failed `hf download` failed because the TOOL is missing or
+    unusable on this host (the rc=127 class), not because the download did.
+
+    Rung 3 (raw resolve + curl) has NO dependency on `hf`, so this failure
+    class is fallback-eligible: the ladder must fall through to rung 3 instead
+    of dying on exactly the host where the fallback matters most. Mirrors
+    `is_xet_refusal`'s discipline — markers on a lowercased haystack, never a
+    bare rc: a CLI can exit 127 for its own reasons, and while a false
+    positive only costs one unnecessary (and honest) fallback attempt, a
+    false negative kills the ladder."""
+    low = (blob or "").lower()
+    return any(m in low for m in _TOOL_UNAVAILABLE_MARKERS)
+
