diff --git a/scripts/lib/gpu-select.sh b/scripts/lib/gpu-select.sh
index ed69318..4374202 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,177 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# gpu_vram_report_lines "<our_container>"
+#   One "- **GPU <idx> idle VRAM:** ..." line per GPU, attributing the memory
+#   to the process that ACTUALLY holds it (#1537). report.sh previously
+#   credited one running club container with EVERY card carrying >100 MiB: on
+#   the #1537 rig our container could only see GPU 1 while nvidia-smi showed
+#   another container's VLLM workers on GPUs 0 and 2 — and the report named
+#   OUR container for all three.
+#
+#   Attribution (host-side; no container introspection beyond docker):
+#     - nvidia-smi --query-gpu=index,uuid,memory.used lists the cards;
+#     - nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name lists who
+#       runs on them (a process spanning N cards appears N times);
+#     - a pid maps to a container through its cgroup (`.../docker-<id>.scope`;
+#       the proc root is $GPU_ATTR_PROC, default /proc — overridable so this
+#       is testable without a real /proc) and the id to a name via `docker ps`;
+#     - a pid whose cgroup shows no docker scope is a host-side process
+#       (display, browser, trainer) and is attributed by process name.
+#
+#   Some drivers hide container processes from the HOST compute-apps list
+#   entirely — an empty list while every card still carries GiB. When we do
+#   have a running club container, its own nvidia-smi (via docker exec) still
+#   sees its processes, so an empty host list falls back to the container's
+#   view and attributes those cards to the container: any pid the container's
+#   nvidia-smi reports lives in its pid namespace, so it IS ours (host-side
+#   cgroups cannot resolve container-namespace pids). A card that stays
+#   unattributed reads as "⚠ something is using this GPU" — never as ours.
+#
+#   OUR_CONTAINER may be empty (no docker / nothing running): lines then drop
+#   the ", not \`<ours>\`" clause instead of guessing. Prints one line per GPU;
+#   no nvidia-smi or no cards prints nothing — the honest degraded state, like
+#   the other gpu_select_* resolvers. Self-contained on purpose: no helper
+#   functions, no external tools beyond nvidia-smi/cat/docker.
+gpu_vram_report_lines() {
+  local our_container="$1"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  # --- the cards (host view): index, uuid, memory used ----------------------
+  local gpu_rows=""
+  gpu_rows="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null)" || gpu_rows=""
+  [[ -n "${gpu_rows//[[:space:]]/}" ]] || return 0
+
+  # --- who runs on them: one row per process per GPU ------------------------
+  local apps=""
+  apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)" || apps=""
+
+  # Empty host list but a running container? Ask the container's OWN
+  # nvidia-smi — the same driver table seen from inside, where its processes
+  # are visible.
+  local container_view=0
+  if [[ -z "${apps//[[:space:]]/}" && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    local capps=""
+    capps="$(docker exec "$our_container" nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)" || capps=""
+    if [[ -n "${capps//[[:space:]]/}" ]]; then
+      apps="$capps"
+      container_view=1
+    fi
+  fi
+
+  # --- docker ps: container id -> name. Both the full id and docker's 12-char
+  # short form are indexed, so a cgroup-scope id matches either. -------------
+  local -A cid_name=()
+  if command -v docker >/dev/null 2>&1; then
+    local ps_out="" ps_line cid cname
+    ps_out="$(docker ps --format '{{.ID}}|{{.Names}}' 2>/dev/null)" || ps_out=""
+    while IFS= read -r ps_line; do
+      ps_line="${ps_line%$'\r'}"
+      [[ -n "${ps_line//[[:space:]]/}" ]] || continue
+      if [[ "$ps_line" == *'|'* ]]; then
+        cid="${ps_line%%|*}"; cname="${ps_line#*|}"
+      else
+        cid="${ps_line%%[[:space:]]*}"; cname="${ps_line#*[[:space:]]}"
+      fi
+      cid="${cid//[[:space:]]/}"
+      cname="${cname#"${cname%%[![:space:]]*}"}"
+      cname="${cname%"${cname##*[![:space:]]}"}"
+      [[ -n "$cid" && -n "$cname" ]] || continue
+      cid_name["$cid"]="$cname"
+      cid_name["${cid:0:12}"]="$cname"
+    done <<< "$ps_out"
+  fi
+
+  # --- holder per pid (cached), then per GPU uuid. First process seen on a
+  # card wins: the memory is attributed to ONE holder, the engine running it.
+  local -A pid_holder=() pid_kind=()
+  local -A gpu_holder=() gpu_kind=()
+  local row u p pname cg scope holder kind nm k
+  while IFS= read -r row; do
+    row="${row%$'\r'}"
+    u="${row%%,*}"; row="${row#*,}"
+    p="${row%%,*}"; pname="${row#*,}"
+    u="${u//[[:space:]]/}"; p="${p//[[:space:]]/}"
+    pname="${pname#"${pname%%[![:space:]]*}"}"
+    pname="${pname%"${pname##*[![:space:]]}"}"
+    case "$u" in
+      GPU-*|MIG-*) : ;;
+      *) continue ;;
+    esac
+    [[ "$p" =~ ^[0-9]+$ ]] || continue
+
+    if [[ "$container_view" == 1 ]]; then
+      holder="$our_container"; kind="container"
+    else
+      if [[ -z "${pid_holder[$p]:-}" ]]; then
+        cg="$(cat "$proc_root/$p/cgroup" 2>/dev/null)" || cg=""
+        scope=""
+        if [[ "$cg" =~ docker-([0-9a-zA-Z]+)[.]scope ]]; then
+          scope="${BASH_REMATCH[1]}"
+        elif [[ "$cg" =~ [/]docker/([0-9a-zA-Z]+) ]]; then
+          scope="${BASH_REMATCH[1]}"     # cgroupfs driver: .../docker/<id>
+        fi
+        if [[ -n "$scope" ]]; then
+          nm="${cid_name[$scope]:-}"
+          [[ -n "$nm" ]] || nm="${cid_name[${scope:0:12}]:-}"
+          if [[ -z "$nm" ]]; then
+            for k in "${!cid_name[@]}"; do
+              if [[ "$scope" == "$k"* ]]; then nm="${cid_name[$k]}"; break; fi
+            done
+          fi
+          pid_holder[$p]="${nm:-$scope}"   # unresolvable id is still honest
+          pid_kind[$p]="container"
+        else
+          pid_holder[$p]="$pname"
+          pid_kind[$p]="process"
+        fi
+      fi
+      holder="${pid_holder[$p]:-}"
+      kind="${pid_kind[$p]:-}"
+    fi
+
+    [[ -n "$holder" ]] || continue
+    if [[ -z "${gpu_holder[$u]:-}" ]]; then
+      gpu_holder[$u]="$holder"
+      gpu_kind[$u]="$kind"
+    fi
+  done <<< "$apps"
+
+  # --- one line per GPU ------------------------------------------------------
+  local idx used used_num
+  while IFS=', ' read -r idx u used; do
+    idx="${idx//[[:space:]]/}"
+    u="${u//[[:space:]]/}"
+    used="${used#"${used%%[![:space:]]*}"}"
+    used="${used%"${used##*[![:space:]]}"}"
+    used_num="${used%%[!0-9]*}"      # leading integer; tolerates a " MiB" unit
+    [[ "$idx" =~ ^[0-9]+$ ]] || continue
+    if [[ "$used_num" =~ ^[0-9]+$ ]] && [[ "$used_num" -gt 100 ]]; then
+      holder="${gpu_holder[$u]:-}"
+      kind="${gpu_kind[$u]:-}"
+      if [[ -z "$holder" ]]; then
+        # Memory in use, no attributable owner: never credit our container.
+        if [[ -n "$our_container" ]]; then
+          echo "- **GPU $idx idle VRAM:** ${used_num} MiB ⚠ something is using this GPU (display, browser, another container — not \`${our_container}\`)"
+        else
+          echo "- **GPU $idx idle VRAM:** ${used_num} MiB ⚠ something is using this GPU (display, browser, container)"
+        fi
+      elif [[ "$kind" == "container" && "$holder" == "$our_container" && -n "$our_container" ]]; then
+        echo "- **GPU $idx idle VRAM:** ${used_num} MiB (held by running \`${holder}\`)"
+      elif [[ "$kind" == "container" ]]; then
+        if [[ -n "$our_container" ]]; then
+          echo "- **GPU $idx idle VRAM:** ${used_num} MiB (held by \`${holder}\`, not \`${our_container}\`)"
+        else
+          echo "- **GPU $idx idle VRAM:** ${used_num} MiB (held by \`${holder}\`)"
+        fi
+      else
+        echo "- **GPU $idx idle VRAM:** ${used_num} MiB (held by \`${holder}\`)"
+      fi
+    else
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+    fi
+  done <<< "$gpu_rows"
+  return 0
+}
