+# --------------------------------------------------------------------------
+# Patch identity — the host-side token that distinguishes THIS patch's
+# artifacts from every other patch's.
+# --------------------------------------------------------------------------
+# A compose-relative mount source always carries the patch directory's own
+# name after ``patches/`` (``../../../patches/vllm-effort-budget:...``), which
+# is what lets the wiring check match a mount's SOURCE to this patch instead
+# of merely its in-container target. Generic names are deliberately excluded:
+# the ``patches`` parent dir appears in every patch mount, and bare artifact
+# basenames (``install.sh``/``apply.py``/``sitecustomize.py``) appear in
+# every compose that runs ANY install script — treating either as
+# identifying is what let the legacy fallback report an unwired patch as
+# reached.
+def _patch_artifact_rels(patch: dict) -> list[str]:
+    """Repo-relative artifact paths this patch declares (``files`` plus the
+    spec's ``script``/``sidecar``/``jinja``)."""
+    rels = list(patch.get("files") or [])
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "sidecar", "jinja"):
+        value = spec.get(key)
+        if value:
+            rels.append(value)
+    return rels
+
+
+def _patch_identity_tokens(patch: dict) -> list[str]:
+    """The patch directory's own name under ``patches/`` (or the artifact's
+    own filename when it sits directly in ``patches/``), per declared
+    artifact. Never a generic parent dir or a generic basename."""
+    tokens: set[str] = set()
+    for rel in _patch_artifact_rels(patch):
+        parts = Path(rel).parts
+        if "patches" not in parts:
+            continue
+        idx = parts.index("patches")
+        if idx + 1 < len(parts):
+            tokens.add(parts[idx + 1])
+    return sorted(tokens)
+
+
+def _patch_host_dirs(patch: dict, root: Path) -> list[Path]:
+    """Absolute host dirs holding this patch's artifacts
+    (``<root>/…/patches/<patch-dir>``), resolved."""
+    dirs: set[Path] = set()
+    for rel in _patch_artifact_rels(patch):
+        parts = Path(rel).parts
+        if "patches" not in parts:
+            continue
+        idx = parts.index("patches")
+        if idx + 1 < len(parts):
+            dirs.add((root / Path(*parts[: idx + 2])).resolve())
+    return sorted(dirs)
+
+
+_TOKEN_BOUNDARY = re.compile(r"[A-Za-z0-9_.\-]")
+
+
+def _token_in(text: str, token: str) -> bool:
+    """Substring match honouring path-segment boundaries: the token must not
+    be a proper prefix of a longer name, so ``vllm-effort-budget`` does not
+    match a mount of ``vllm-effort-budget-v2``."""
+    if not token:
+        return False
+    start = 0
+    while True:
+        idx = text.find(token, start)
+        if idx < 0:
+            return False
+        start = idx + 1
+        if idx > 0 and _TOKEN_BOUNDARY.match(text[idx - 1]):
+            continue
+        end = idx + len(token)
+        if end < len(text) and _TOKEN_BOUNDARY.match(text[end]):
+            continue
+        return True
+
+
+def _split_colon_segments(token: str) -> list[str]:
+    """Split ``<src>:<dst>[:<mode>]`` at ``:``, keeping ``${VAR:-default}``
+    wrappers intact (the ``:`` inside a default is not a mount separator)."""
+    segments: list[str] = []
+    buffer: list[str] = []
+    depth = 0
+    i = 0
+    while i < len(token):
+        ch = token[i]
+        if ch == "$" and token[i + 1 : i + 2] == "{":
+            depth += 1
+            buffer.append("${")
+            i += 2
+            continue
+        if depth and ch == "}":
+            depth -= 1
+        if ch == ":" and depth == 0:
+            segments.append("".join(buffer))
+            buffer = []
+            i += 1
+            continue
+        buffer.append(ch)
+        i += 1
+    segments.append("".join(buffer))
+    return segments
+
+
+def _mount_pairs(line: str) -> list[tuple[str, str]]:
+    """(source, container-target) pairs of the bind mounts on a body line.
+
+    Targets are container-absolute (``/…``) and sources path-like; port
+    mappings and env assignments do not shape-match and are skipped."""
+    pairs: list[tuple[str, str]] = []
+    for raw in line.split():
+        token = raw.strip().strip('"').strip("'").strip()
+        segments = _split_colon_segments(token)
+        if len(segments) < 2 or not segments[1].startswith("/"):
+            continue
+        src, dst = segments[0], segments[1]
+        if "/" in src:
+            pairs.append((src, dst))
+    return pairs
+
+
+_ENV_DEFAULT_RE = re.compile(r"^\$\{[A-Za-z0-9_]+(?::?-)([^{}]*)\}$")
+
+
+def _resolve_mount_source(src: str, compose_dir: Path | None) -> Path | None:
+    """Resolve a mount source literal against the compose's directory.
+
+    ``${VAR:-default}`` resolves through its default; a bare ``${VAR}`` (an
+    operator override whose value we cannot see) is unresolvable and falls
+    back to the identity-token match."""
+    match = _ENV_DEFAULT_RE.match(src)
+    if match:
+        src = match.group(1).strip().strip('"').strip("'").strip()
+    elif src.startswith("${"):
+        return None
+    if not src or "/" not in src:
+        return None
+    path = Path(src)
+    if not path.is_absolute() and compose_dir is not None:
+        path = compose_dir / path
+    try:
+        return path.resolve()
+    except OSError:
+        return None
+
+
+def _patch_mounted(
+    patch: dict,
+    body: str,
+    targets: list[str],
+    root: Path | None = None,
+    compose_dir: Path | None = None,
+) -> bool:
+    """True iff ``body`` shows a bind mount OF THIS PATCH.
+
+    Match the mount's SOURCE to this patch — its declared
+    ``patches/<dir>`` path — not merely the in-container target: a compose
+    that mounts a DIFFERENT patch at the same target is not wired for this
+    one. A mount whose source resolves to a real host path decides
+    authoritatively; only an unresolvable source (a fixture, or an
+    operator ``${VAR}`` override) falls back to the boundary-matched
+    patch-directory token."""
+    tokens = _patch_identity_tokens(patch)
+    if not tokens:
+        return False
+    host_dirs = _patch_host_dirs(patch, root) if root is not None else []
+    for line in body.splitlines():
+        for src, dst in _mount_pairs(line):
+            if targets and not any(target in dst for target in targets):
+                continue
+            resolved = _resolve_mount_source(src, compose_dir)
+            if resolved is not None and resolved.exists():
+                if any(d == resolved or d in resolved.parents for d in host_dirs):
+                    return True
+                # A real mount at the declared target whose source is NOT
+                # this patch: a different patch is wired here — this line
+                # is not this patch's mount (no token fallback).
+                continue
+            if any(_token_in(src, tok) for tok in tokens):
+                return True
+    return False
+
