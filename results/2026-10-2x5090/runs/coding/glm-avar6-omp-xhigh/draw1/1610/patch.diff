+# ---------------------------------------------------------------------------
+# (7) Install-script negative controls — reaches() must STOP answering True
+#     once a patch's mount + invoke are removed from a compose, and must not
+#     answer True for a compose that wires a DIFFERENT patch at the same
+#     in-container target. The legacy `delivery:` fallback's markers (the
+#     parent dir name — always `patches` — for directory artifacts, and the
+#     bare basename — `install.sh` — for file artifacts) matched nearly every
+#     wired compose, so an unwired install-script patch reported reached and
+#     the sound delivery_spec check never got the final say. With a
+#     delivery_spec declared, the spec check alone decides; these controls
+#     pin that.
+# ---------------------------------------------------------------------------
+def _strip_needles(patch: dict) -> list[str]:
+    """Every body string that ties a line to THIS patch's wiring: its
+    patches/<dir> identity, its declared mount target(s), its invoke
+    string, and its script/sidecar/jinja artifact (path + basename)."""
+    needles: set[str] = set()
+    for rel in patch.get("files") or []:
+        parts = Path(rel).parts
+        if "patches" in parts:
+            i = parts.index("patches")
+            if i + 1 < len(parts):
+                needles.add(parts[i + 1])
+    spec = patch.get("delivery_spec") or {}
+    for key in ("mounted_at", "invoke"):
+        value = spec.get(key)
+        if value:
+            needles.add(value)
+    for key in ("script", "sidecar", "jinja"):
+        value = spec.get(key)
+        if value:
+            needles.add(value)
+            needles.add(Path(value).name)
+    return sorted(n for n in needles if n)
+
