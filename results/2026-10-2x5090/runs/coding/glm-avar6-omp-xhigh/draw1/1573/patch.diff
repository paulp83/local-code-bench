+# vLLM's boot log as the second readback: an image that starts vLLM THROUGH
+# its own launcher (bucko's `qwen38-serve` adds --reasoning-parser inside the
+# script) shows NO parser in the container argv, yet the server was booted
+# with one. At boot vLLM dumps its resolved non-default args — a dump that
+# lists ONLY the args differing from their defaults, so `reasoning_parser` in
+# it is the same class of evidence the argv flag is, straight from the engine.
+# Parsed with resolved_config's dict_after — the one parser for these dumps
+# (its docstring: shared with run_context.py, which reads the same vLLM/SGLang
+# dumps) — and read through its _boot_log_prefix: a long-lived engine's log
+# can be hundreds of MB and `docker logs` has no `--head`. The container is
+# passed by name; docker runs from PATH, so a test-mocked docker is honoured.
+# stdout: `PARSER <value>` | `PARSER none`; a log that cannot be read answers
+# `PARSER none` and the argv's verdict stands — this readback can only UPGRADE
+# the argv's "no parser" to verified, never downgrade evidence that exists.
+_thinking_budget_vllm_boot_log_facts() {
+  python3 - "$_TB_LIB_DIR" "$1" <<'PY'
+import sys
+sys.path.insert(0, sys.argv[1])
+from resolved_config import dict_after, _boot_log_prefix
+
+blob, _truncated, _note = _boot_log_prefix(sys.argv[2])
+# The LAST parsed dump is the running boot's args: a container that restarted
+# shows every boot's dump, and an earlier boot that had a parser must not
+# outvote the later boot that dropped it — the whole last dump wins, not the
+# last key sighting (the same last-occurrence rule the argv facts use).
+args = None
+for line in blob.splitlines():
+    if "non-default args:" not in line:
+        continue
+    parsed = dict_after(line, "non-default args:")
+    if isinstance(parsed, dict):
+        args = parsed
+parser = args.get("reasoning_parser") if args else ""
+print("PARSER %s" % parser if parser else "PARSER none")
+PY
+}
+
