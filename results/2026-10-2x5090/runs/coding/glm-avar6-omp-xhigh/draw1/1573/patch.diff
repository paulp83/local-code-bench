 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,8 +376,33 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv is not the whole truth: an image that starts vLLM THROUGH
+          # its own launcher (bucko's qwen38-serve) adds --reasoning-parser
+          # inside that script, so the container argv shows none — and this
+          # branch read as a refusal, which THINKING_BUDGET_UNVERIFIED=1 could
+          # not override because it is positive evidence. The server's own
+          # boot log is the resolved truth (see the helper): read it before
+          # refusing.
+          # A readback crash must degrade to the refusal, not abort the run
+          # (set -e): handle the status explicitly — the traceback still
+          # reaches stderr, since command substitution captures stdout only.
+          local boot
+          boot="$(_thinking_budget_vllm_boot_log_facts "$c")" || boot=""
+          # "PARSER none" must be matched FIRST: the `PARSER *` glob would
+          # swallow it and verify a boot log that answered "no parser".
+          case "$boot" in
+            "PARSER none")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+            "PARSER "*)
+              local bv="${boot#PARSER }"
+              THINKING_BUDGET_EVIDENCE="container ${c} argv carries no --reasoning-parser, but its boot log resolves reasoning_parser=${bv} (the image starts vLLM through its own launcher)"
+              return 0 ;;
+            *)
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
+              return 1 ;;
+          esac
+          ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
