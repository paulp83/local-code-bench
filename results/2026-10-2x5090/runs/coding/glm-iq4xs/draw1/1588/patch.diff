+    #1584: the port alone was the whole test, so URL=http://<other host>:8020
+    bound the local container on :8020 and a remote run reported this rig's
+    slots, GPUs and spec as its own. The host has to be one the mapping serves.
+    """
+    host, port = _url_host_port(url)
+    if not host:
         return ""
-    port = m.group(1)
     if ps_lines is None:
         try:
             out = subprocess.run(["docker", "ps", "--format", "{{.Names}}|{{.Ports}}"],
@@ -372,11 +471,11 @@ def container_for_url(url, ps_lines=None):
             ps_lines = out.stdout.splitlines()
         except Exception:
             return ""
-    pat = re.compile(r":" + port + r"->")
     for line in ps_lines:
         name, _, ports = line.partition("|")
-        if name and pat.search(ports):
-            return name.strip()
+        name = name.strip()
+        if name and _ports_serve_url(ports, host, port):
