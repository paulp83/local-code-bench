-# ── which container, and is a drafter on (#1537) ──────────────────────────────
+# ── which container, and is a drafter on (#1537, #1584) ───────────────────────
 # The card's container and spec label used to come from a name heuristic (`vllm-(qwen|gemma)`) and
 # a grep of the container's Cmd. Both lied on #1537: an SGLang container was never found (card
 # listed every GPU on the host, spec "?"), and a vLLM compose that builds --speculative-config in
 # its entrypoint script from SPEC_N read "spec off" with MTP n=4 running. These read the truth:
 # the container publishing the probed URL's port, and the drafter the ENGINE says it loaded.
+# #1584 follow-up: "publishing the port" is not enough — a URL on another machine shares the
+# port with nothing local, and the old port-only match bound the local container anyway (so a
+# remote run announced this rig's slots, GPUs, spec and KV pool as its own). The container is
+# the one that serves the URL: same port, on an address the mapping is published to.
+@functools.lru_cache(maxsize=None)
+def _host_addresses(host):
+    """The addresses ``host`` names, one per line. A literal is itself, a name is
+    whatever the resolver says (``localhost`` is the loopback pair)."""
+    host = (host or "").strip("[]").lower()
+    if not host:
+        return []
+    if host in ("localhost", "0.0.0.0", "*"):
+        return ["127.0.0.1", "::1"]
+    if ":" in host or re.fullmatch(r"[0-9.]+", host):
+        return [host]
+    addrs = set()
+    try:
+        for info in socket.getaddrinfo(host, None):
+            addrs.add(info[4][0])
+    except Exception:
+        return []
+    return sorted(addrs)
+
+
+@functools.lru_cache(maxsize=None)
+def _own_addresses():
+    """Every address THIS machine answers to — what a 0.0.0.0 publish serves."""
+    addrs = {"127.0.0.1", "::1"}
+    for name in (socket.gethostname(), "localhost"):
+        try:
+            for info in socket.getaddrinfo(name, None):
+                addrs.add(info[4][0])
+        except Exception:
+            pass
+    return addrs
+
+
+def _ports_serve_url(ports, host, port):
+    """True when a `docker ps` "Ports" string publishes ``port`` to ``host`` (#1584).
+    Same answer listen-scope.sh's ports_serve_url gives: the port has to match AND
+    the URL's host has to be an address the mapping is published on — so
+    URL=http://<other machine>:8020 no longer binds the local :8020 container."""
+    for addr in _host_addresses(host):
+        for m in (ports or "").split(","):
+            m = m.strip()
+            if "->" not in m:
+                continue                      # an exposed-only port, not published
+            bind, _, _hp = m.partition("->")
+            if bind.startswith("["):                 # [::]:8020->8000/tcp
+                ip, _, hp = bind[1:].partition("]")
+                hp = hp.lstrip(":")
+            else:
+                ip, _, hp = bind.rpartition(":")
+            lo, _, hi = hp.partition("-")
+            hi = hi or lo
+            if not (lo.isdigit() and hi.isdigit()):
+                continue
+            if not (int(lo) <= port <= int(hi)):
+                continue
+            if ip in ("", "0.0.0.0", "::", "*"):
+                if addr in ("127.0.0.1", "::1") or addr in _own_addresses():
+                    return True
+            elif ip.startswith("127.") or ip == "::1":
+                if addr in ("127.0.0.1", "::1"):
+                    return True
+            elif addr == ip:
+                return True
+    return False
+
+
+def _url_host_port(url):
+    """("host", port) for URL, the port defaulted from the scheme (80 / 443) —
+    the same answer listen-scope.sh's url_host_port gives, IPv6 brackets included."""
+    url = (url or "").strip()
+    if "://" in url:
+        scheme, _, rest = url.partition("://")
+    else:
+        scheme, rest = "http", url
+    hostport = rest.split("/", 1)[0]
+    hostport = hostport.rsplit("@", 1)[-1]
+    if hostport.startswith("["):                       # http://[::1]:8020/...
+        host, _, tail = hostport[1:].partition("]")
+        port_part = tail.lstrip(":")
+    elif hostport.count(":") > 1:                      # a bare IPv6 literal, no port
+        host, port_part = hostport, ""
+    else:
+        host, _, port_part = hostport.rpartition(":")
+    if not host:
+        return "", 0
+    if port_part.isdigit():
+        return host, int(port_part)
+    return host, 443 if scheme == "https" else 80
+
+
 def container_for_url(url, ps_lines=None):
-    """Name of the running container publishing ``url``'s host port, else ""."""
-    m = re.match(r"^[a-z]+://[^/:]+:(\d+)", url or "")
