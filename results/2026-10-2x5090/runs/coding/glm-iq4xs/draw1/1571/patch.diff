--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,114 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# gpu_vram_report_lines "<our_container>"
+#   Per-GPU VRAM attribution for scripts/report.sh's "Display / desktop state"
+#   section (#1537). The pre-fix report credited a single running club container
+#   with EVERY card that had >100 MiB in use — wrong when another container (or
+#   a bare process) holds the other cards, which pointed triage at the wrong
+#   workload.
+#
+#   Prints one line per GPU, each containing `**GPU <index> idle VRAM:**`, using
+#   the HOST's view (`--query-gpu=index,uuid,memory.used` +
+#   `--query-compute-apps=gpu_uuid,pid,process_name`) to attribute each card to
+#   the process actually on it:
+#     - a pid is mapped to a container via <proc>/<pid>/cgroup
+#       (.../docker-<id>.scope; the proc root comes from $GPU_ATTR_PROC,
+#       default /proc) and the id resolved to a name through `docker ps`;
+#     - our container            -> "held by running `<ours>`";
+#     - another container        -> "held by `<other>`, not `<ours>`";
+#     - a non-container process  -> "held by `<process_name>`";
+#     - when the host lists NO compute processes, ours is placed from its own
+#       view (`docker exec <ours> nvidia-smi ...`) — the container sees its
+#       cards through a namespace the host view may not;
+#     - memory in use with no owner -> "⚠ something is using this GPU";
+#     - an idle card (a few MiB)    -> "<N> MiB ✓".
+#   Echoes nothing when nvidia-smi is unavailable or unreadable.
+gpu_vram_report_lines() {
+  local our_container="$1"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+
+  # Host compute apps: uuid -> "pid|process_name" (first process on a card
+  # wins — a second tenant is a separate fight, not a mis-attribution).
+  local -A _vram_pid=() _vram_proc=()
+  local have_apps=0 uuid pid pname
+  while IFS=',' read -r uuid pid pname; do
+    uuid="${uuid//[[:space:]]/}"; pid="${pid//[[:space:]]/}"; pname="${pname# }"
+    [[ "$uuid" == GPU-* ]] || continue
+    have_apps=1
+    _vram_pid["$uuid"]="$pid"
+    _vram_proc["$uuid"]="$pname"
+  done < <(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name \
+               --format=csv,noheader 2>/dev/null)
+
+  # When the host view is empty, ask OUR container what it sees: the compute
+  # processes live in its own namespace and the host may not enumerate them.
+  local -A _ours_gpu=()
+  if [[ "$have_apps" -eq 0 && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    while IFS=',' read -r uuid pid pname; do
+      uuid="${uuid//[[:space:]]/}"
+      [[ "$uuid" == GPU-* ]] || continue
+      _ours_gpu["$uuid"]=1
+    done < <(docker exec "$our_container" nvidia-smi \
+                 --query-compute-apps=gpu_uuid,pid,process_name \
+                 --format=csv,noheader 2>/dev/null)
+  fi
+
+  # docker id -> name, for cgroup scope ids (prefix match: the scope carries
+  # the full 64-char id, `docker ps` may print only the short one).
+  local -A _docker_name=()
+  if command -v docker >/dev/null 2>&1; then
+    local did dname
+    while read -r did dname; do
+      [[ -n "$did" ]] && _docker_name["$did"]="$dname"
+    done < <(docker ps --format '{{.ID}} {{.Names}}' 2>/dev/null)
+  fi
+
+  # pid -> container name, via the cgroup the process lives in.
+  _vram_container_of() {
+    local p="$1" cg id name
+    [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] || return 0
+    cg="$(cat "${proc_root}/${p}/cgroup" 2>/dev/null)" || return 0
+    id="$(sed -n 's/.*docker-\([0-9a-f]\{12,\}\)\.scope.*/\1/p' <<< "$cg" | head -1)"
+    [[ -n "$id" ]] || return 0
+    for name in "${!_docker_name[@]}"; do
+      case "$id" in
+        "$name"*) printf '%s' "${_docker_name[$name]}"; return 0 ;;
+      esac
+    done
+  }
+
+  local idx gused guuid p name
+  while IFS=',' read -r idx guuid gused; do
+    idx="${idx//[[:space:]]/}"; guuid="${guuid//[[:space:]]/}"; gused="${gused//[[:space:]]/}"
+    [[ "$idx" =~ ^[0-9]+$ && "$gused" =~ ^[0-9]+$ ]] || continue
+    if [[ "$gused" -le 100 ]]; then
+      printf -- '- **GPU %s idle VRAM:** %s MiB ✓\n' "$idx" "$gused"
+      continue
+    fi
+    if [[ -n "${_vram_pid[$guuid]:-}" ]]; then
+      p="${_vram_pid[$guuid]}"
+      name="$(_vram_container_of "$p")"
+      if [[ -n "$name" ]]; then
+        if [[ -n "$our_container" && "$name" == "$our_container" ]]; then
+          printf -- '- **GPU %s idle VRAM:** %s MiB (held by running `%s`)\n' "$idx" "$gused" "$name"
+        elif [[ -n "$our_container" ]]; then
+          printf -- '- **GPU %s idle VRAM:** %s MiB (held by `%s`, not `%s`)\n' "$idx" "$gused" "$name" "$our_container"
+        else
+          printf -- '- **GPU %s idle VRAM:** %s MiB (held by `%s`)\n' "$idx" "$gused" "$name"
+        fi
+      else
+        printf -- '- **GPU %s idle VRAM:** %s MiB (held by `%s`)\n' "$idx" "$gused" "${_vram_proc[$guuid]}"
+      fi
+    elif [[ -n "${_ours_gpu[$guuid]:-}" ]]; then
+      printf -- '- **GPU %s idle VRAM:** %s MiB (held by running `%s`)\n' "$idx" "$gused" "$our_container"
+    elif [[ -n "$our_container" ]]; then
+      printf -- '- **GPU %s idle VRAM:** %s MiB ⚠ something is using this GPU (not `%s`)\n' "$idx" "$gused" "$our_container"
+    else
+      printf -- '- **GPU %s idle VRAM:** %s MiB ⚠ something is using this GPU (display, browser, container)\n' "$idx" "$gused"
+    fi
+  done < <(nvidia-smi --query-gpu=index,uuid,memory.used \
+               --format=csv,noheader,nounits 2>/dev/null)
+}
