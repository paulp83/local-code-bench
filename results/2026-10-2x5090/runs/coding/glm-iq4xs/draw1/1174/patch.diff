+def is_tool_unavailable(blob: str, rc: Optional[int] = None) -> bool:
+    """True iff a failed rung-1 attempt failed because the `hf` CLI itself is
+    missing or not runnable (rc=127 from the shell, or our own "not on PATH"
+    report) \u2014 NOT because the hub refused the transfer.
+
+    This is a *fallback-eligible* failure: rung 3 (raw resolve + curl) has no
+    dependency on `hf` at all, so a missing CLI must never kill the ladder. It
+    is deliberately narrow \u2014 an ordinary rung-1 error (a network blip, a
+    401, a disk-full) still reports honestly instead of being pushed down the
+    slow path."""
+    if rc is not None and int(rc) == 127:
+        return True
+    low = (blob or "").lower()
+    return ("on path" in low
+            or "command not found" in low
+            or "no such file or directory" in low
+            or "cannot execute" in low)
+
