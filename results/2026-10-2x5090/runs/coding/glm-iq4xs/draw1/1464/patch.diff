-up_variant() {
+# --- Refusable checks (MUST run before any teardown) -------------------------
+# Everything that can REFUSE a launch lives in validate_variant(), and
+# switch.sh's main path calls it BEFORE down_running(). History: the checks used
+# to live inline in up_variant(), which ran AFTER down_running() — so a refused
+# launch (an experimental slug without --force, a compose whose model files
+# aren't on this host, a typo'd slug) had already brought the running slug down
+# and left the rig serving NOTHING. Validate first, tear down second.
+# Idempotent per slug: the main path validates up front, and up_variant()
+# re-invokes it only when that hasn't already happened.
+validate_variant() {
   local v="$1"
   if [[ -z "${VARIANTS[$v]:-}" ]]; then
     echo "ERROR: unknown variant '${v}'." >&2
@@ -1252,11 +1261,6 @@ up_variant() {
     preflight_compose_deps "${full_dir}/${file}" || exit 1
     if [[ "$eng" == "vllm" ]]; then
       preflight_compose_hardware "${full_dir}/${file}" "$v" "${FORCE:-0}" || exit 1
-      # Free-VRAM gate: fail fast (not a 600s restart-loop) when the GPUs don't have
