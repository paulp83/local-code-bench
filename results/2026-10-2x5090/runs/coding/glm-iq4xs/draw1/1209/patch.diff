@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# Guard: `catalog.sh rename` / `catalog.sh update` AMEND a LOCAL entry in place
+# (#1204). The local layer was create-and-delete only, which mattered beyond
+# ergonomics: #1204 decided a local slug colliding with a newly-shipped curated
+# one is shadowed — kept and MARKED "so the user can rename it" — and no rename
+# existed. A remedy was advertised that could not be reached.
+#
+# Pinned here:
+#   1. rename moves the registry entry, the engine field and the compose tree;
+#   2. the layer still loads through load_local_registry with origin: local, and
+#      every entry's engine equals its slug's namespace;
+#   3. curated slugs are unreachable — as source, as rename target, through
+#      update;
+#   4. --set origin=... is refused (provenance is the loader's, not the row's);
+#   5. an unknown engine namespace is refused;
+#   6. --dry-run exits 0 and changes nothing; no curated file ever changes.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+
+fail=0; pass=0
+ok()  { pass=$((pass+1)); printf 'ok   %s\n' "$1"; }
+bad() { fail=$((fail+1)); printf 'FAIL %s\n' "$1"; }
+
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+P="$TMP/scripts/lib/profiles-local"
+mkdir -p "$P/models.d" "$P/composes/my-probe/llama-cpp/compose/single/q4"
+printf 'services:\n  probe:\n    image: busybox\n' \
+  > "$P/composes/my-probe/llama-cpp/compose/single/q4/base.yml"
+cat > "$P/models.d/my-probe.yml" <<'YML'
+schema_version: 1
+id: my-probe
+display_name: Probe
+family: dense
+attention_k_eq_v: false
+YML
+cat > "$P/registry.local.json" <<'JSON'
+{
+  "llama-cpp/my-probe": {
+    "model": "my-probe", "weights_variant": "q4", "workload": "fast-chat",
+    "engine": "llama-cpp", "drafter": null, "kv_format": "q8_0", "tp": 1,
+    "max_ctx": 4096, "max_num_seqs": 1, "mem_util": 0.9,
+    "compose_path":
+      "scripts/lib/profiles-local/composes/my-probe/llama-cpp/compose/single/q4/base.yml",
+    "default_port": 20255, "kvcalc_key": "SKIP", "status": "incubating"
+  }
+}
+JSON
+
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+before="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+
+refuse() { # refuse <what> -- args...
+  local what="$1"; shift
+  if scripts/catalog.sh "$@" --root "$TMP" >/dev/null 2>&1; then
+    bad "$what was accepted"
+  else
+    ok "$what refused"
+  fi
+}
+refuse "rename of a curated slug" rename --slug "$CORE" --to vllm/x
+refuse "rename ONTO a curated slug" rename --slug llama-cpp/my-probe --to "$CORE"
+refuse "rename to an unknown engine namespace" rename --slug llama-cpp/my-probe --to not-an-engine/x
+refuse "update of a curated slug" update --slug "$CORE" --set max_ctx=1
+refuse "--set origin" update --slug llama-cpp/my-probe --set origin=local
+refuse "an unknown slug" update --slug nope/nothing --set max_ctx=1
+
+if scripts/catalog.sh rename --slug llama-cpp/my-probe --to vllm/my-probe \
+      --root "$TMP" --dry-run >/dev/null 2>&1; then
+  if [[ "$(python3 -c "import json;print(list(json.load(open('$P/registry.local.json')))[0])")" \
+        == "llama-cpp/my-probe" ]]; then
+    ok "--dry-run exits 0 and leaves the registry unchanged"
+  else
+    bad "--dry-run changed the registry"
+  fi
+else
+  bad "--dry-run rename failed"
+fi
+
+if scripts/catalog.sh rename --slug llama-cpp/my-probe --to vllm/my-probe \
+      --root "$TMP" >/dev/null 2>&1; then
+  ok "rename exits 0"
+else
+  bad "rename failed"
+fi
+[[ -f "$P/composes/my-probe/vllm/compose/single/q4/base.yml" ]] \
+  && ok "the compose tree moved with the slug" \
+  || bad "the compose tree did not move"
+
+python3 - "$TMP" <<'PY' && ok "the layer still loads (origin local, engine == namespace)" \
+                  || bad "the amended layer does not load"
+import sys
+from pathlib import Path
+root = Path(sys.argv[1]); sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+local = load_local_registry(root)
+assert list(local) == ["vllm/my-probe"], list(local)
+for slug, entry in local.items():
+    assert entry["origin"] == "local", entry["origin"]
+    assert entry["engine"] == slug.split("/")[0], (slug, entry["engine"])
+PY
+
+if scripts/catalog.sh update --slug vllm/my-probe --set max_ctx=8192 \
+      --root "$TMP" >/dev/null 2>&1; then
+  got="$(python3 -c "import json;d=json.load(open('$P/registry.local.json'));print(d['vllm/my-probe']['max_ctx'])")"
+  [[ "$got" == "8192" ]] && ok "update --set writes the field" || bad "update --set wrote $got"
+else
+  bad "update --set failed"
+fi
+
+after="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+[[ "$before" == "$after" ]] && ok "no curated catalog file changed" \
+                            || bad "the curated catalog changed"
+
+(( fail == 0 )) && echo "PASS: catalog.sh rename/update amend the local layer only" \
+                || echo "FAIL: catalog.sh amend regression"
+exit "$fail"
