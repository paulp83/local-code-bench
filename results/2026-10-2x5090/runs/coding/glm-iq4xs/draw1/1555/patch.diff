diff --git a/scripts/lib/concurrency_probe.py b/scripts/lib/concurrency_probe.py
index 4a75db5..0700a33 100755
--- a/scripts/lib/concurrency_probe.py
+++ b/scripts/lib/concurrency_probe.py
@@ -366,11 +366,146 @@ def container_gpus(container):
         selectors = visible_gpu_selectors(inspect)
     except Exception:
         return None, "every GPU on the host (rig-wide: run_context.py unavailable)"
+    # Compose turns `device_ids: ["${ESTATE_GPUS}"]` into ONE DeviceIDs entry
+    # holding the whole list ("2,3"), not two entries ("2", "3"). Split those so
+    # the card scopes to both GPUs instead of looking up an index literally
+    # named "2,3" (which matches nothing -> falls back to every GPU on the host).
+    if selectors:
+        selectors = [
+            part for sel in selectors for part in str(sel).split(",") if part.strip()
+        ]
     if selectors is None:
         return None, f"every GPU on the host (container {container} sees them all)"
     return selectors, f"GPU {', '.join(selectors)} (container {container})"
 
 
+# ── container <-> port resolution + spec-decoding label (#1537) ────────────────
+# The card's CONTAINER came from a `vllm-(qwen|gemma)` name heuristic, so an SGLang
+# container was never found and its card listed every GPU on the host and measured
+# VRAM rig-wide. And `_spec_fp` grepped the container's `Cmd` for
+# `--speculative-config`, which a compose that builds that flag inside its
+# entrypoint script (from SPEC_N) never shows. Both now come from what is actually
+# running: the container that publishes $URL's port, and the spec label the engine
+# itself prints at boot / serves on /get_server_info.
+def _url_port(url):
+    m = re.search(r":(\d+)", str(url or "").split("/")[2] if "//" in str(url or "") else "")
+    return m.group(1) if m else ""
+
+
+def container_for_url(url):
+    """Name of the running container publishing $URL's port, or '' when none does."""
+    port = _url_port(url)
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+            timeout=15,
+        ).stdout
+    except Exception:
+        return ""
+    for line in out.splitlines():
+        cells = line.split("\t", 1)
+        if len(cells) != 2:
+            continue
+        name, ports = cells[0].strip(), cells[1]
+        # `0.0.0.0:8020->8020/tcp`, `:::8020->8020/tcp`, `0.0.0.0:8020->8020/udp`
+        if re.search(rf"->\s*{port}/", ports) or re.search(
+            rf":{port}->", ports
+        ):
+            return name
+    return ""
+
+
+def _vllm_spec_label(container):
+    """'MTP n=4' / 'spec off' from the HEAD of `docker logs`, or None if unreadable.
+
+    vLLM logs the whole engine config on one line at boot:
+      Initializing a V1 LLM engine (version …) with config: … speculative_config=
+      SpeculativeConfig(method='mtp', …, num_spec_tokens=4)
+    That line sits at the HEAD (boot), not the tail — the tail is request traffic —
+    and `speculative_config=None` is what a non-spec compose prints.
+    """
+    if not container:
+        return None
+    try:
+        out = subprocess.run(
+            ["docker", "logs", container],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+            timeout=30,
+        )
+    except Exception:
+        return None
+    txt = out.stdout or ""
+    if "speculative_config=" not in txt:
+        txt += out.stderr or ""
+    head = txt[:4000000]
+    for line in head.splitlines():
+        i = line.find("speculative_config=")
+        if i < 0:
+            continue
+        frag = line[i + len("speculative_config="):]
+        if frag.startswith("None"):
+            return "spec off"
+        method = re.search(r"method=['\"]?([A-Za-z0-9_-]+)", frag)
+        ntok = re.search(r"num_spec_tokens=['\"]?(\d+)", frag)
+        if method:
+            return _spec_label(method.group(1), ntok.group(1) if ntok else None)
+        return "spec on"
+    return None
+
+
+def _sglang_spec_label(url):
+    """'MTP n=4' / 'spec off' from SGLang's GET /get_server_info, or None."""
+    if not url:
+        return None
+    try:
+        req = urllib.request.Request(str(url).rstrip("/") + "/get_server_info")
+        with urllib.request.urlopen(req, timeout=10) as resp:
+            info = json.load(resp)
+    except Exception:
+        return None
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    steps = info.get("speculative_num_steps")
+    if algo in (None, "", "NONE"):
+        return "spec off"
+    n = None
+    for k in ("speculative_num_draft_tokens", "speculative_num_steps"):
+        v = info.get(k)
+        if isinstance(v, int):
+            n = v
+            break
+    try:
+        steps = int(steps) if steps not in (None, "") else None
+    except (TypeError, ValueError):
+        steps = None
+    return _spec_label(str(algo), steps if steps is not None else n)
+
+
+def _spec_label(method, n):
+    """'MTP n=4' for mtp / eagle over the target's own checkpoint, else the method."""
+    m = str(method or '').strip().strip("'\\").lower()
+    if not m:
+        return "spec on"
+    if m in ("none", "null"):
+        return "spec off"
+    label = "MTP" if m in ("mtp", "eagle", "eagle3", "nextn") else m.upper()
+    if n:
+        return f"{label} n={n}"
+    return label
+
+
+def spec_label(url=None, container=None):
+    """Spec-decoding label from the engine, or '' when neither source is readable."""
+    label = _vllm_spec_label(container)
+    if label is None:
+        label = _sglang_spec_label(url)
+    return label or ""
+
+
 def _smi_rows():
     out = subprocess.run(
         ["nvidia-smi", "--query-gpu=index,uuid,name,memory.used", "--format=csv,noheader,nounits"],
@@ -1198,10 +1333,20 @@ def main(argv=None):
     p.add_argument("--plan-tsv", action="store_true")
     p.add_argument("--card", action="store_true")
     p.add_argument("--detect-kv", action="store_true")
+    p.add_argument("--container-for-url", action="store_true",
+                   help="name of the running container publishing $URL's port ('' when none does)")
+    p.add_argument("--spec-label", action="store_true",
+                   help="speculative-decoding label from the engine (vLLM boot log / SGLang /get_server_info)")
     p.add_argument("--gpu-label", action="store_true",
                    help="'N× <GPU name>' for the GPUs $CONTAINER sees (every GPU when it can't be resolved)")
     args = p.parse_args(argv)
 
+    if args.container_for_url:
+        print(container_for_url(_env("URL")))
+        return 0
+    if args.spec_label:
+        print(spec_label(_env("URL"), _env("CONTAINER")))
+        return 0
     if args.gpu_label:
         print(gpu_label(container_gpus(_env("CONTAINER"))[0]))
         return 0
