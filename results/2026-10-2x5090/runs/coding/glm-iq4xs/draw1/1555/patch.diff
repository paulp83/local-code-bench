+# #1537: Compose joins `device_ids: ["${ESTATE_GPUS}"]` into ONE DeviceIDs entry
+# ("2,3"), not two ("2", "3") — the literal index matched nothing, so the card fell
+# back to every GPU on the host.
+got="$(scope comma-ids)"
+[[ "$got" == "1× GeForce RTX 3090 + 1× GeForce RTX 3060|25381|['2', '3']"* ]] \
+  || fail "a Compose-style comma-joined DeviceIDs entry should scope to GPUs 2 and 3: got '$got'"
+echo "  ✓ Compose's comma-joined DeviceIDs entry scopes to those GPUs, not rig-wide"
 rm -rf "$GPU_STUB"
 echo "  ✓ VRAM + GPU label scoped to the container's GPUs (ids, UUIDs, NVIDIA_VISIBLE_DEVICES; rig-wide fallback)"
 
+# #1537: CONTAINER came from a `vllm-(qwen|gemma)` name heuristic (never matched an
+# SGLang container) and _spec_fp grepped `Cmd` for --speculative-config, which the
+# Qwen3.8 vLLM compose builds inside its entrypoint. Both now come from what runs:
+# the container publishing $URL's port, and the label the engine itself reports.
+PORT_STUB="$(mktemp -d)"
+cat > "$PORT_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  ps) printf 'vllm-ctr\t0.0.0.0:8020->8020/tcp\nsglang-ctr\t:::8030->8030/tcp\nunpub\t9000/tcp\n' ;;
+  logs)
+    case "$2" in
+      vllm-ctr) echo "INFO 02-01 10:00:00 [v1] Initializing a V1 LLM engine (version 0.9.2) with config: model='Qwen', speculative_config=SpeculativeConfig(method='mtp', num_spec_tokens=4), max_model_len=32768" ;;
+      vllm-off) echo "INFO ... Initializing a V1 LLM engine (version 0.9.2) with config: speculative_config=None, max_model_len=32768" ;;
+      *) exit 1 ;;
+    esac ;;
+  *) exit 1 ;;
+esac
+DOCK
+chmod +x "$PORT_STUB/docker"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+[[ "$got" == "vllm-ctr" ]] || fail "--container-for-url should name the container publishing $URL's port: got '$got'"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:8030 python3 "$LIB" --container-for-url)"
+[[ "$got" == "sglang-ctr" ]] || fail "--container-for-url must match any engine's container (IPv6 publish form too): got '$got'"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:9199 python3 "$LIB" --container-for-url)"
+[[ -z "$got" ]] || fail "--container-for-url should print nothing when no container publishes the port: got '$got'"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:8020 CONTAINER=vllm-ctr python3 "$LIB" --spec-label)"
+[[ "$got" == "MTP n=4" ]] \
+  || fail "--spec-label should read the vLLM boot line the entrypoint-composed flag produces: got '$got'"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:8020 CONTAINER=vllm-off python3 "$LIB" --spec-label)"
+[[ "$got" == "spec off" ]] || fail "--spec-label should print 'spec off' for speculative_config=None: got '$got'"
+got="$(PATH="$PORT_STUB:$PATH" URL=http://localhost:8020 CONTAINER=sglang-ctr python3 "$LIB" --spec-label)"
+[[ -z "$got" ]] \
+  || fail "--spec-label prints nothing when neither the boot log nor /get_server_info is readable: got '$got'"
+rm -rf "$PORT_STUB"
+echo "  ✓ --container-for-url + --spec-label resolve the real container and engine-reported spec label"
+
 echo "test-concurrency-probe: ok"
