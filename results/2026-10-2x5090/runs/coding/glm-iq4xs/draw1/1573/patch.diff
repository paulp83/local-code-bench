+# vLLM's boot log readback. An image that starts vLLM through ITS OWN launcher
+# (e.g. bucko's `qwen38-serve` script) puts `--reasoning-parser` inside that
+# script, so `docker inspect` argv shows no parser and the argv check alone
+# would refuse a server that actually has one. The resolved config IS printed
+# at boot, under `non-default args`:
+#   ... non-default args: {'model': ..., 'reasoning_parser': 'qwen3', ...}
+# stdout: `PARSER <name>` (last occurrence wins) or nothing when unavailable.
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import re, sys
+
+text = sys.stdin.read()
+# `non-default args` / `EngineArgs` dump first (the resolved truth), then the
+# flag itself in a logged command line, in case a future vLLM stops dumping.
+pats = (
+    r"'reasoning_parser'\s*[:=]\s*'([^']+)'",
+    r'"reasoning_parser"\s*[:=]\s*"([^"]+)"',
+    r"--reasoning-parser(?:=|[ \t]+)([A-Za-z0-9_.-]+)",
+)
+for pat in pats:
+    hits = re.findall(pat, text)
+    if hits:
+        print("PARSER %s" % hits[-1])
+        sys.exit(0)
+PY
+)"
+_thinking_budget_vllm_boot_log_facts() {
+  local c="$1" logs=""
+  command -v docker >/dev/null 2>&1 || return 0
+  logs="$(docker logs "$c" 2>&1 || true)"
+  [[ -n "$logs" ]] || return 0
+  python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY" <<<"$logs" 2>/dev/null || true
+}
+
