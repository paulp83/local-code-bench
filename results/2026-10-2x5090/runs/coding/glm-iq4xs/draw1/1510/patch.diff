diff --git a/scripts/tests/test-concurrency-probe.sh b/scripts/tests/test-concurrency-probe.sh
index 9ed47a1..d9898b9 100755
--- a/scripts/tests/test-concurrency-probe.sh
+++ b/scripts/tests/test-concurrency-probe.sh
@@ -196,4 +196,92 @@ command grep -q "not ready" <<<"$out" || fail "gate should report the not-ready
 command grep -q "FATAL: --sweep cannot detect" <<<"$out" && fail "gate must abort BEFORE slot detection"
 echo "  ✓ --sweep WARMUP gate: opt-in, dry-skips, default-silent, fails closed"
 
+
+# 11. #1240-style regression: --sweep must survive skipped cells. emit_row used to
+#     feed the row on stdin to `python3 -`, whose stdin is the heredoc -- so
+#     sys.stdin.read() returned "" and json.loads("") aborted the whole sweep at
+#     the first skip (budget / clipped / early-stop). The row now travels as argv.
+emit_src="$(awk '/^  emit_row\(\)/,/^  }$/' "$PROBE")"
+[[ -n "$emit_src" ]] || fail "could not extract emit_row from $PROBE"
+rowjson_src="$(awk '/^  row_json\(\)/,/^  }$/' "$PROBE")"
+[[ -n "$rowjson_src" ]] || fail "could not extract row_json from $PROBE"
+if command grep -q 'sys.stdin.read()' <<<"$emit_src"; then
+  fail "emit_row still reads the row from stdin (json.loads(\"\") kills the sweep)"
+fi
+command grep -q 'json.loads(sys.argv' <<<"$emit_src" \
+  || fail "emit_row should take the row as an argument"
+cells_test="$(mktemp)"
+bash -c '
+  set -euo pipefail
+  cells_jsonl="$1"
+  '"$emit_src"'
+  '"$rowjson_src"'
+  emit_row "$(row_json 32768 8 "N*(ctx+gen) > KV_TOKENS")"
+  emit_row "$(row_json 4096 4 budget)"
+  emit_row "$(row_json 1024 2 early-stop)"
+' cprobe "$cells_test"
+[[ "$(wc -l < "$cells_test")" == "3" ]] || fail "expected 3 skip rows, got $(wc -l < "$cells_test")"
+command grep -q '"skip": "budget"' "$cells_test" || fail "budget skip row not recorded"
+command grep -q '"skip": "early-stop"' "$cells_test" || fail "early-stop skip row not recorded"
+command grep -q 'KV_TOKENS' "$cells_test" || fail "clipped skip row not recorded verbatim"
+rm -f "$cells_test"
+echo "  ✓ --sweep skip rows are recorded (emit_row takes the row as argv)"
+
+# 12. VRAM + the GPU label are the PROBED card(s), not the rig. Stub docker
+#     (container pinned to GPU 2) and nvidia-smi (4 cards, one busy) and check
+#     both the python VRAM query and the shell GPU fingerprint.
+gpusim="$(mktemp -d)"
+trap 'rm -rf "$SHIMDIR" "$gpusim"' EXIT
+cat > "$gpusim/docker" <<'SIM'
+#!/usr/bin/env bash
+for a in "$@"; do
+  [ "$a" = "--format" ] && { echo "-np 8"; exit 0; }
+done
+echo '[{"HostConfig":{"DeviceRequests":[{"DeviceIDs":["2"]}]},"Config":{"Env":[]}}]'
+exit 0
+SIM
+cat > "$gpusim/nvidia-smi" <<'SIM'
+#!/usr/bin/env bash
+ids=""; q=""
+if [ "$1" = "-i" ]; then ids="$2"; shift 2; fi
+for a in "$@"; do case "$a" in *query-gpu*) q="$a";; esac; done
+case "$q" in
+  *name*) if [ -n "$ids" ]; then echo "NVIDIA GeForce RTX 3060"
+          else printf 'NVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\n'; fi;;
+  *memory.used*) if [ -n "$ids" ]; then echo 10381; else echo 24000; echo 24000; echo 24000; echo 24000; fi;;
+  *index,uuid*) printf '0, GPU-a\n1, GPU-b\n2, GPU-c\n3, GPU-d\n';;
+esac
+exit 0
+SIM
+chmod +x "$gpusim/docker" "$gpusim/nvidia-smi"
+PATH="$gpusim:$PATH" CONTAINER=vllm-probe CONCURRENCY_PROBE_GPU_IDS= python3 -c '
+import sys; sys.path.insert(0, sys.argv[1])
+from concurrency_probe import container_gpu_ids, vram_used_mb, vram_used_per_gpu_mb
+ids = container_gpu_ids()
+assert ids == [2], f"container_gpu_ids should resolve to the container GPU, got {ids}"
+assert vram_used_mb(ids) == 10381, f"vram_used_mb should be the probed card only, got {vram_used_mb(ids)}"
+assert vram_used_per_gpu_mb(ids) == [10381], "per-card peaks should be per card"
+' "$ROOT_DIR/scripts/lib" || fail "container-scoped GPU/VRAM resolution failed"
+PATH="$gpusim:$PATH" CONTAINER= CONCURRENCY_PROBE_GPU_IDS= python3 -c '
+import sys; sys.path.insert(0, sys.argv[1])
+from concurrency_probe import container_gpu_ids, vram_used_mb
+assert container_gpu_ids() == [], "no container must resolve to rig-wide"
+assert vram_used_mb([]) == 96000, "unscoped query stays rig-wide"
+' "$ROOT_DIR/scripts/lib" || fail "rig-wide fallback failed"
+_fp_case() {
+  local which="$1" cont="$2"
+  PATH="$gpusim:$PATH" CONTAINER="$cont" bash -c "
+    ROOT_DIR='$ROOT_DIR'
+    source <(awk '/^_container_gpu_ids\(\)/,/^}/' '$PROBE')
+    source <(awk '/^_gpu_fp\(\)/,/^}/' '$PROBE')
+    _gpu_fp
+  " 2>/dev/null
+}
+fp="$(_fp_case scoped vllm-probe)"
+[[ "$fp" == "1× GeForce RTX 3060" ]] || fail "_gpu_fp should label the probed card only, got: $fp"
+fp_rig="$(_fp_case rig '')"
+[[ "$fp_rig" == "4× GeForce RTX 3090" ]] || fail "rig-wide fallback label wrong: $fp_rig"
+rm -rf "$gpusim"
+echo "  ✓ VRAM + GPU label scoped to the probed container's card(s) (rig-wide disclosed)"
+
 echo "test-concurrency-probe: ok"
