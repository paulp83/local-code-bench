+def container_gpu_ids(container=None):
+    """Host GPU indices the probed container's CUDA actually sees.
+
+    Resolved from `docker inspect` (classic runtime DeviceRequests, then the
+    NVIDIA_VISIBLE_DEVICES / CUDA_VISIBLE_DEVICES env the container was started
+    with), with UUID selectors mapped back to host indices via nvidia-smi.
+    Returns [] when nothing can be resolved — the caller then falls back to
+    rig-wide behaviour and SAYS SO instead of silently mis-attributing.
+    """
+    if container is None:
+        explicit = _env("CONCURRENCY_PROBE_GPU_IDS")
+        if explicit:
+            try:
+                return [int(x) for x in explicit.split(",") if x.strip()]
+            except ValueError:
+                return []
+        container = _env("CONTAINER")
+    if not container:
+        return []
+    inspects = _docker_inspect(container)
+    if not inspects:
+        return []
+    insp = inspects[0]
+    ids: list[str] = []
+    for req in (insp.get("HostConfig") or {}).get("DeviceRequests") or []:
+        if req.get("DeviceIDs"):
+            ids = [str(x) for x in req["DeviceIDs"]]
+    env = {}
+    for entry in (insp.get("Config") or {}).get("Env") or []:
+        key, sep, value = entry.partition("=")
+        if sep and value.strip():
+            env[key] = value.strip()
+    nvd = env.get("NVIDIA_VISIBLE_DEVICES", "")
+    if not ids and nvd and nvd not in ("all", "void", "none"):
+        ids = [v.strip() for v in nvd.split(",") if v.strip()]
+    cvd = env.get("CUDA_VISIBLE_DEVICES", "")
+    if cvd and cvd not in ("all", "void", "none"):
+        picks = [v.strip() for v in cvd.split(",") if v.strip()]
+        if ids and all(p.isdigit() for p in picks):
+            ids = [ids[int(p)] for p in picks if int(p) < len(ids)]
+        elif picks:
+            ids = picks
+    out: list[int] = []
+    uuids = []
+    for i in ids:
+        if i.isdigit():
