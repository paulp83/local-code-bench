   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# The reasoning budget a llama.cpp serving container was BOOTED with, from its
+# own command line (quality-test.sh's server-budget readback; llama.cpp prints
+# no `[effort-budget] v1` line — that is the vLLM / SGLang entrypoint's).
+# stdout, one word (+ a detail):
+#   <N>              --reasoning-budget resolved to N (>= 0: a real cap)
+#   off              booted with --reasoning-budget -1 or with no flag: unrestricted
+#   unresolvable <d> the flag is there but its value does not resolve to a number
+#   (nothing)        the container is not a llama.cpp server — caller keeps its
+#                    own engine-neutral path (and its "unknown" message)
+# Reads docker inspect ONCE and classifies it here so a caller never has to
+# guess the engine family. The value resolution (${REASONING_BUDGET:-N} through
+# Config.Env, last occurrence wins, LLAMA_ARG_THINK_BUDGET as the env spelling)
+# is the same one --thinking-budget verifies against: one code path (#1617).
+thinking_budget_llamacpp_boot_budget() {
+  local c="${CONTAINER:-}" facts="" detect
+  [[ -n "$c" && "$c" != "none" ]] || return 0
+  command -v docker >/dev/null 2>&1 || return 0
+  docker inspect "$c" >/dev/null 2>&1 || return 0
+  facts="$(docker inspect "$c" 2>/dev/null)" || return 0
+  detect="$(printf '%s' "$facts" | _thinking_budget_container_facts llamacpp-detect 2>/dev/null || true)"
+  [[ "$detect" == "LLAMACPP yes" ]] || return 0
+  local line
+  line="$(printf '%s' "$facts" | _thinking_budget_container_facts llamacpp 2>/dev/null || true)"
+  case "$line" in
+    "BUDGET none")           echo "off" ;;
+    "BUDGET -1")             echo "off" ;;
+    "BUDGET unresolvable"*)  echo "unresolvable ${line#BUDGET unresolvable }" ;;
+    "BUDGET "*)              echo "${line#BUDGET }" ;;
+    *)                       echo "unresolvable (no --reasoning-budget in the boot command, and no LLAMA_ARG_THINK_BUDGET)" ;;
+  esac
+  return 0
+}
+
 # SGLang's own readback: /server_info (v0.5.21) dumps the RESOLVED ServerArgs
 # (server_args.resolved_dict()); /get_server_info is the deprecated alias.
 # Walks the whole document so a regrouping of the args (v0.5.20+ groups them)
