+def _patch_source_markers(root: Path | None, patch: dict) -> list[str]:
+    """Host-side strings that identify THIS patch's own vendored artifacts.
+
+    Derived from ``files``: the patch directory's own name (never the
+    generic parent ``patches`` and never a generic artifact basename), so a
+    mount line carrying e.g. ``.../patches/vllm-effort-budget:...`` can be
+    attributed to this patch rather than to any patch mount.
+    """
+    markers: list[str] = []
+    for rel in patch.get("files") or []:
+        rel_path = Path(rel)
+        name = rel_path.name
+        is_dir = bool(root) and (root / rel).is_dir()
+        if not is_dir and rel_path.suffix:
+            # a file entry: the identifying component is its parent patch dir
+            name = rel_path.parent.name
+        if not name or name in GENERIC_ARTIFACT_NAMES:
+            continue
+        if name not in markers:
+            markers.append(name)
+    return markers
+
+
+def _volume_mount_attributed(
+    root: Path | None, patch: dict, body: str, mounted_at: str
+) -> bool:
+    """True iff a mount line targeting ``mounted_at`` sources THIS patch.
+
+    Matching the container-side target alone is unsound: two patches may
+    (and do) mount different vendored dirs at the same in-container path, so
+    the mount's SOURCE must carry one of this patch's own markers on the
+    same line. When the patch declares no identifying source name we cannot
+    attribute the mount and fall back to target-only (no false negatives).
+    """
+    if mounted_at not in body:
+        return False
+    sources = _patch_source_markers(root, patch)
+    if not sources:
+        return True
+    return any(
+        mounted_at in line and any(src in line for src in sources)
+        for line in body.splitlines()
+    )
+
