+# Vendored-template names that do NOT identify a chat_template patch: every
+# vendored template is mounted from a `patches/` directory, and the model-dir
+# convention names the artifact `chat_template.jinja` itself.
+_CHAT_TEMPLATE_GENERIC_SOURCES = frozenset({"patches", "chat_template.jinja", "chat_template.jinja2", "chat_template.j2"})
+
+# The two engine flags a chat_template patch can be invoked with. `--chat-template`
+# is a SUBSTRING of `--chat-template-file`, so the vLLM-style flag must be matched
+# with a boundary — a llama.cpp `--chat-template-file` compose must not satisfy it.
+_CHAT_TEMPLATE_FLAG_RES = {
+    "--chat-template": re.compile(r"--chat-template(?!-)"),
+    "--chat-template-file": re.compile(r"--chat-template-file\b"),
+}
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line: the
+    vendored template's own directory or filename (#1610 did the same for install
+    scripts). Generic names (`patches`, the model-dir `chat_template.jinja`
+    convention) are skipped — they appear on every template mount."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    jinja = (patch.get("delivery_spec") or {}).get("jinja") or ""
+    src = Path(jinja)
+    names = {src.parent.name, src.name}
+    return sorted(n for n in names if n and n not in _CHAT_TEMPLATE_GENERIC_SOURCES)
+
+
+def _chat_template_flag(patch: dict) -> str | None:
+    """The engine flag this patch's own `invoke` documents, or None for a
+    mount-only template (mounted over the model dir, engine auto-loads it)."""
+    invoke = (patch.get("delivery_spec") or {}).get("invoke") or ""
+    if "--chat-template-file" in invoke:
+        return "--chat-template-file"
+    if "--chat-template" in invoke:
+        return "--chat-template"
+    return None
+
+
+def _is_bind_mount_target(line: str, target: str) -> bool:
+    """True iff ``line`` uses ``target`` as a bind-mount DESTINATION.
+
+    Compose's short syntax is ``<source>:<target>[:<mode>]``, so the target is
+    always colon-preceded (long form: ``target: <path>``). This is what keeps
+    the flag's argument — `--chat-template /etc/….jinja` — from being mistaken
+    for the mount itself when a compose passes the flag but drops the mount."""
+    # A line that passes the engine flag is the flag's ARGUMENT, never a mount
+    # (volume entries never carry `--chat-template`).
+    if any(rx.search(line) for rx in _CHAT_TEMPLATE_FLAG_RES.values()):
+        return False
+    esc = re.escape(target)
+    # short form `…:<target>[:<mode>]` — covers a target declared in full …
+    if re.search(":" + esc + r"(?![\w.\-])", line):
+        return True
+    # … and a SUFFIX target (`mounted_at: /chat_template.jinja` is only the tail
+    # of `/models/<weights>/chat_template.jinja:ro`) — the trailing `:<mode>` is
+    # what makes it a mount destination rather than a bare mention.
+    if re.search(esc + ":", line):
+        return True
+    return bool(re.search(r"target:\s*" + esc + r"\s*$", line))
+
+
+def _chat_template_volume_ok(patch: dict, body: str) -> bool:
+    """True iff ``body`` mounts THIS patch's vendored template file.
+
+    Source-aware (the #1597/#1610 lesson): the mount target alone is not this
+    patch's — `qwen38-reasoning-effort-template` declares the SUFFIX
+    `/chat_template.jinja` (it is mounted over each model dir's own
+    `chat_template.jinja`), so the bare target also appears on every other
+    template's source line. Require the patch's own directory/filename on the
+    SAME bind-mount line (:func:`_is_bind_mount_target` — the flag's argument is
+    NOT a mount); when the spec offers no distinctive name, accept only a line
+    that carries the vendored basename too."""
+
+    mounted_at = (patch.get("delivery_spec") or {}).get("mounted_at")
+    if not mounted_at:
+        return False
+    jinja = (patch.get("delivery_spec") or {}).get("jinja") or ""
+    own = _chat_template_sources(patch)
+    for ln in body.splitlines():
+        if not _is_bind_mount_target(ln, mounted_at):
+            continue
+        if any(n in ln for n in own):
+            return True
+        # No distinctive in-tree name on the line: the target must be a real
+        # mount target (not a suffix inside a longer host path) and the
+        # vendored basename must be on the line too.
+        delimited = re.search(r"(?<![\w.\-])" + re.escape(mounted_at), ln)
+        if delimited and Path(jinja).name in ln:
+            return True
+    return False
+
+
+# Basenames an engine AUTO-LOADS from the mount target without any flag: a
+# template mounted over the served checkpoint's own `chat_template.jinja` is
+# rendered from the model dir (vLLM/SGLang) or via the GGUF's embedded metadata
+# (llama.cpp), so the mount alone is the load-bearing artifact.
+_CHAT_TEMPLATE_AUTOLOAD_NAMES = {"chat_template.jinja", "chat_template.jinja2", "chat_template.j2"}
+
+
+def _chat_template_requires_flag(patch: dict) -> bool:
+    """True when the mount target is a STANDALONE template file the engine only
+    selects via an explicit `--chat-template`/`--chat-template-file` arg (e.g.
+    `/etc/qwen-froggeric-chat-template.jinja`). A template mounted OVER the
+    served checkpoint's own `chat_template.jinja` (`/chat_template.jinja`,
+    `/models/<weights>/chat_template.jinja`) needs no flag — the engine
+    auto-loads it — so requiring one would drop every mount-only compose."""
+    mounted_at = (patch.get("delivery_spec") or {}).get("mounted_at") or ""
+    return Path(mounted_at).name not in _CHAT_TEMPLATE_AUTOLOAD_NAMES
+
+
+def _chat_template_invoke_ok(patch: dict, body: str) -> bool:
+    """True iff ``body`` passes the engine chat-template flag naming the
+    mounted path. The bare flag never counts on its own: it must name THIS
+    patch's `mounted_at`, on the flag's own line or the adjacent list item
+    (Compose renders `[--chat-template, <path>]` as two lines)."""
+    flag = _chat_template_flag(patch)
+    mounted_at = (patch.get("delivery_spec") or {}).get("mounted_at") or ""
+    if not mounted_at:
+        return False
+    lines = body.splitlines()
+    # Which flags does this compose pass at all? (The vLLM-style token is
+    # matched with a boundary so `--chat-template-file` does not count for it.)
+    passed = [f for f in _CHAT_TEMPLATE_FLAG_RES if _CHAT_TEMPLATE_FLAG_RES[f].search(body)]
+    if not passed:
+        # No chat-template flag anywhere: fine for a mount-only template,
+        # a coverage loss for one whose target the engine cannot auto-load.
+        return not _chat_template_requires_flag(patch)
+    if len(passed) > 1:
+        # Both spellings present: the stricter one decides (a compose that
+        # passes `--chat-template-file` is not passing `--chat-template`).
+        flag = "--chat-template-file"
+    elif not (flag and flag in passed):
+        # The compose passes a chat-template flag this patch's invoke does not
+        # document — it names some other template, so it cannot select ours.
+        return not _chat_template_requires_flag(patch)
+    rx = _CHAT_TEMPLATE_FLAG_RES[flag]
+    for idx, ln in enumerate(lines):
+        if not rx.search(ln):
+            continue
+        window = [ln] + ([lines[idx + 1]] if idx + 1 < len(lines) else [])
+        if any(mounted_at in w for w in window):
+            return True
+    return False
+
+
+def _chat_template_wired(patch: dict, body: str) -> bool:
+    """Effective chat_template coverage: mount THIS template file AND, when the
+    patch is invoked with an explicit engine flag, pass that flag naming the
+    mounted path. Either half alone is unsound (a compose that mounts *some*
+    template, or that passes `--chat-template` for *another* template)."""
+    if not _chat_template_volume_ok(patch, body):
+        return False
+    return _chat_template_invoke_ok(patch, body)
+
