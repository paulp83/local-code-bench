+# ---------------------------------------------------------------------------
+# NEGATIVE CONTROL â the legacy `delivery:` fallback must not override the
+# sound delivery_spec verdict. Strip a patch's mount + invoke lines from a
+# copy of a compose that carries it and assert reaches() == False. The old
+# fallback matched the bare filename (`install.sh`) or the parent dir name
+# (`patches`), so a stripped compose still reported True and an unwired
+# install-script patch was undetectable.
+for _patch in patches:
+    _spec = _patch.get("delivery_spec") or {}
+    if not (_spec.get("script") or _spec.get("sidecar")):
+        continue
+    _needles = [
+        _patch["id"],
+        _spec.get("mounted_at") or "",
+        Path(_spec.get("script") or _spec.get("sidecar")).parent.name,
+    ]
+    _needles = [n for n in _needles if n]
+    for _lb in _patch.get("load_bearing_when") or []:
+        for _slug in _lb.get("composes") or []:
+            _entry = COMPOSE_REGISTRY.get(_slug)
+            _cp = _compose_path(_entry) if _entry else None
+            if not _cp or not (root / _cp).exists():
+                continue
+            _text = (root / _cp).read_text(encoding="utf-8")
+            _kept = [l for l in _text.splitlines() if not any(n in l for n in _needles)]
+            if len(_kept) == len(_text.splitlines()):
+                continue  # nothing left to strip â not a meaningful control
+            _stripped = Path(tempfile.mkdtemp()) / Path(_cp).name
+            _stripped.write_text("\n".join(_kept), encoding="utf-8")
+            if reaches(_patch, str(_stripped)):
+                errors.append(
+                    f"{_patch['id']}: reaches() still True on {Path(_cp).name} with its "
+                    f"mount + invoke stripped (legacy fallback overriding delivery_spec)"
+                )
