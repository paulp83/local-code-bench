+def _legacy_file_marker(root: Path, rel: str) -> str | None:
+    """Identifying marker for a legacy `delivery:`-only entry's file/dir.
+
+    Deliberately NARROW: the old heuristic matched the bare filename
+    (``install.sh`` — present in every compose that runs any install
+    script) or, for directories, the parent's name (always ``patches`` —
+    present in every compose that mounts any patch dir), which made the
+    fallback vacuously true. Here a marker only counts if it names the
+    patch's own directory (for a directory entry) or is a filename that is
+    unique to the patch (for a file entry).
+    """
+    target = root / rel
+    if target.is_dir():
+        return Path(rel).name
+    name = Path(rel).name
+    if name in _GENERIC_PATCH_PARENTS or name in _GENERIC_FILENAMES:
+        return None
+    return name
+
