-# Engine-neutral by design: the readback line is the same on every engine, and
-# effort_budget.py owns its parsing (the LAST line wins: `docker logs` spans restarts).
+# Engine-shaped, deliberately: vLLM / SGLang print ONE `[effort-budget] v1` line
+# (effort_budget.py owns its parsing); llama.cpp prints `[reasoning] budget=N …`
+# — one budget, no effort map. Both readbacks take the LAST line (`docker logs`
+# spans restarts), and both feed the same cap/record logic above.
 SERVER_THINKING_BUDGET=""          # N | off | empty = unknown / not in effect
 SERVER_THINKING_EFFORT=""          # the effort that budget was read for
 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+
+# Apply one read-back budget that IS in effect (a number). Shared by both
+# readbacks below so the engines cannot drift: size the DEFAULT thinking cap,
+# warn when the operator's own cap would cut the answer off, and leave the
+# budget recorded. Never overrides a choice (--thinking-budget, an explicit
+# --thinking-max-tokens / THINKING_MAX_TOKENS, --pack-budgets); $2 is the note
+# printed when --thinking-budget overrides it (per engine: vLLM/SGLang send a
+# per-request budget that wins on the server, llama.cpp's boot flag IS the
+# budget, so there the request has to match it).
+_quality_test_server_budget_apply() {
+  local what="$1" override_note="$2" headroom cap
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    echo "[quality-test] ${what}${override_note}"
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+  elif [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$SERVER_THINKING_BUDGET" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${SERVER_THINKING_BUDGET}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+  elif [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+  else
+    headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+    if ! [[ "$headroom" =~ ^[1-9][0-9]*$ ]]; then
+      echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${headroom}'" >&2
+      exit 2
+    fi
+    cap=$(( SERVER_THINKING_BUDGET + headroom ))
+    if [[ "$cap" -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+      THINKING_MAX_TOKENS="$cap"
+      THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${headroom}"
+      echo "[quality-test] ${what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${SERVER_THINKING_BUDGET} + ${headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+    else
+      echo "[quality-test] ${what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${headroom} tokens for the answer"
+    fi
+  fi
+}
