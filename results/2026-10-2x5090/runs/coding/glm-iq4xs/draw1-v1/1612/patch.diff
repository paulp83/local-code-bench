+def _chat_template_flag_pair_ok(patch: dict, body: str) -> bool | None:
+    """For an explicit-flag chat_template spec: are the flag AND its target both wired?
+
+    Returns ``None`` when the spec is not the explicit-flag style (mount-only, or the
+    invoke names a per-variant path rather than ``mounted_at``) so the caller falls back
+    to the mount marker alone. Otherwise True iff the flag token and ``mounted_at``
+    appear together — on the SAME line, or on adjacent non-blank lines of the merged
+    body (the compose command list renders them as neighbouring items). The bare flag
+    alone is never enough: it is a substring of ``--chat-template-file`` and every
+    template-mounting compose passes one for its OWN template (#1624).
+    """
+    spec = patch.get("delivery_spec") or {}
+    invoke = spec.get("invoke") or ""
+    flags = _CHAT_TEMPLATE_FLAG_RE.findall(invoke)
+    mounted_at = spec.get("mounted_at")
+    # `mounted_at` must be NAMED by the invoke (a whole path token), not merely a
+    # substring of it: qwen38's `mounted_at` is the suffix `/chat_template.jinja`,
+    # which its `--chat-template <model dir>/chat_template.jinja` invoke contains
+    # without naming the declared target.
+    if not flags or not mounted_at or mounted_at not in re.findall(r"[^\s(),]+", invoke):
+        return None
+    flag = flags[0]
+    lines = [ln for ln in body.splitlines()]
+    for idx, ln in enumerate(lines):
+        if flag not in ln:
+            continue
+        if mounted_at in ln:
+            return True
+        # Adjacent list items: walk over blank (stripped-comment) lines only.
+        for peer in (idx - 1, idx + 1):
+            while 0 <= peer < len(lines) and not lines[peer].strip():
+                peer += 1 if peer > idx else -1
+            if 0 <= peer < len(lines) and mounted_at in lines[peer]:
+                return True
+    return False
+
+
+def _mount_sources_for(patch: dict) -> list[str]:
+    """Host-side names that must share the mount line for THIS patch.
+
+    Source-aware like #1610 did for install scripts, but only where the container
+    target is genuinely ambiguous: a chat_template `mounted_at` that is a plain
+    SUFFIX of the vendored template's own path (``/chat_template.jinja`` — mounted
+    OVER each model dir's own template) also matches every OTHER template's
+    host-side source path, so the patch's own directory/file name must be on the
+    mount line. A specific target (``/etc/club3090/gemma-canonical-template.jinja``)
+    identifies the patch on its own, as before.
+    """
+    if patch.get("delivery_mechanism") != "chat_template":
+        return _install_sources(patch)
+    spec = patch.get("delivery_spec") or {}
+    jinja = spec.get("jinja") or ""
+    mounted_at = spec.get("mounted_at") or ""
+    if not (jinja and mounted_at and jinja.endswith(mounted_at)):
+        return []  # specific target: the mount line is already this patch's
+    return _chat_template_sources(patch)
+
