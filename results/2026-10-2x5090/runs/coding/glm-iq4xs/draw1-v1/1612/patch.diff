+# A vendored chat-template artifact name that identifies NOTHING on its own: every
+# engine-side model dir carries one, and `mounted_at` for a mount-over-the-model-dir
+# patch is a SUFFIX of the host-side source path of any other template (#1597 family).
+_GENERIC_TEMPLATE_NAMES = frozenset({"patches", "chat_template.jinja", "chat_template.jinja2", "chat_template.j2"})
+
+# The vLLM/llama.cpp chat-template flags. `--chat-template` is a SUBSTRING of
+# `--chat-template-file`, so a bare substring probe for the former matches the latter
+# (and vice versa) — match on token boundaries only.
+_CHAT_TEMPLATE_FLAG_RE = re.compile(r"--chat-template(?:-file)?(?![\w-])")
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line: the
+    vendored `.jinja`'s own name and/or its patch directory (``qwen38-reasoning-effort-template``,
+    ``apex-qwen-chat-template.jinja``, ``glm53-minja-numeric-index/…``).
+
+    The container-side target alone is not this patch's: `mounted_at` may be a plain
+    suffix (``/chat_template.jinja`` — mounted OVER each model dir's own template) and
+    two patches can mount different templates at sibling targets, so — as #1610 did for
+    install scripts — the mount only counts when the patch's OWN source is on the same
+    line as the target (#1610/#1624).
+    """
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    spec = patch.get("delivery_spec") or {}
+    rels = [spec.get("jinja")] + list(patch.get("files") or [])
+    names: set[str] = set()
+    for rel in rels:
+        if not rel:
+            continue
+        path = Path(rel)
+        names.add(path.name)
+        if path.suffix:
+            names.add(path.parent.name)
+    return sorted(n for n in names if n and n not in _GENERIC_TEMPLATE_NAMES)
+
