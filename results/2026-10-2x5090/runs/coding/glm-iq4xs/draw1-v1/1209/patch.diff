index 0000000..f3c0054
--- /dev/null
+++ b/scripts/tests/test-local-update-rename.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# #1202 P7: a LOCAL entry can be RENAMED and UPDATED in place.
+#
+# The local layer was create-and-delete only: promote.py refused every
+# "already exists" case and demote.py only removed, so changing ONE field meant
+# demoting and re-promoting. That mattered more than ergonomics - #1204 decided
+# a local slug colliding with a newly-shipped curated one is SHADOWED (kept and
+# marked "so the user can rename it"), and no rename existed: the remedy the
+# catalog advertised could not be reached. This guard proves both directions.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+fail=0; pass=0
+ok()  { pass=$((pass+1)); echo "  ok   $1"; }
+bad() { fail=$((fail+1)); echo "  FAIL $1"; }
+
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+SLUG="vllm/rename-probe"; MID="rename-probe"
+COMPOSE="scripts/lib/profiles-local/composes/$MID/vllm/compose/single/q4/base.yml"
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+PROFILE="$TMP/scripts/lib/profiles-local/models.d/$MID.yml"
+
+spec() { # $1 = slug, $2 = display_name, $3 = port
+  cat > "$TMP/spec.json" <<JSON
+{
+  "model_id": "$MID", "display_name": "$2", "family": "dense",
+  "arch": {"hidden_size": 2048, "num_hidden_layers": 8, "num_attn_heads": 16,
+           "num_kv_heads": 2, "head_dim_attn": 128, "max_ctx_supported": 4096,
+           "attention_k_eq_v": false},
+  "weights": {"q4": {"path": "Probe-Q4", "local_subdir": "Probe-Q4", "size_gb": 1.0,
+             "format": "gguf", "status": "incubating", "hf_repo": "org/Probe",
+             "engine": "vllm-stable", "kind": "main", "verify_glob": "*.gguf"}},
+  "default_weight_variant": "q4", "vision_capable": false,
+  "compose": {"path": "$COMPOSE", "content": "# Profile (at-a-glance):\n#   Status:    Incubating\n# ---\nservices:\n  probe:\n    image: busybox\n"},
+  "registry_entry": {"slug": "$1", "kwargs": {"model": "$MID", "weights_variant": "q4",
+    "workload": "fast-chat", "engine": "vllm-stable", "drafter": null, "kv_format": "q8_0",
+    "tp": 1, "max_ctx": 4096, "max_num_seqs": 1, "mem_util": 0.9, "compose_path": "$COMPOSE",
+    "default_port": $3, "kvcalc_key": "SKIP"}}
+}
+JSON
+}
+
+# 1. promote, then update in place (was: demote + re-promote)
+spec "$SLUG" "Rename Probe" 20255
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes >"$TMP/promote.log" 2>&1 \
+  && ok "promote exits 0" || { bad "promote failed"; tail -3 "$TMP/promote.log"; }
+
+spec "$SLUG" "Rename Probe v2" 20256
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes --update >"$TMP/update.log" 2>&1 \
+  && ok "promote --update exits 0" || { bad "--update failed"; tail -3 "$TMP/update.log"; }
+command grep -q "UPDATE_OK $SLUG" "$TMP/update.log" && ok "UPDATE_OK emitted" || bad "no UPDATE_OK"
+python3 -c "import json,sys;d=json.load(open('$REG'));e=d['$SLUG'];sys.exit(0 if e['default_port']==20256 else 1)" \
+  && ok "the field change landed" || bad "the update did not change the entry"
+[[ -f "$PROFILE" ]] && ok "profile still present after update" || bad "profile vanished"
+
+# 2. update refuses an unregistered slug, a curated slug, and a model-id change
+spec "vllm/never-registered" "x" 20255
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes --update >/dev/null 2>&1 && bad "unknown slug accepted" || ok "unknown slug refused"
+spec "vllm/dual" "x" 20255
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes --update >/dev/null 2>&1 && bad "curated slug accepted" || ok "curated slug refused"
+
+# 3. dry-run changes nothing
+before="$(md5sum "$REG" | cut -d' ' -f1)"
+spec "$SLUG" "dry" 20257
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes --update --dry-run >/dev/null 2>&1 && ok "--dry-run exits 0" || bad "--dry-run failed"
+[[ "$before" == "$(md5sum "$REG" | cut -d' ' -f1)" ]] && ok "--dry-run wrote nothing" || bad "--dry-run WROTE"
+
+# 4. rename: the shadowing remedy
+NEW="vllm/rename-probe-mine"
+python3 scripts/lib/profiles/promote.py --rename-from "$SLUG" --rename-to "$NEW" \
+  --root "$TMP" --layer local >"$TMP/rename.log" 2>&1 \
+  && ok "rename exits 0" || { bad "rename failed"; tail -3 "$TMP/rename.log"; }
+command grep -q "RENAME_OK $SLUG -> $NEW" "$TMP/rename.log" && ok "RENAME_OK emitted" || bad "no RENAME_OK"
+python3 -c "
+import json, sys
+d = json.load(open('$REG'))
+assert '$NEW' in d and '$SLUG' not in d, d
+" && ok "registry re-keyed" || bad "registry NOT re-keyed"
+[[ -f "$PROFILE" ]] && ok "files stay put on a rename" || bad "rename moved the files"
+python3 -c "
+import sys; sys.path.insert(0, '$TMP/scripts/lib/profiles')
+import compose_registry as cr
+try: reg = cr.get_registry('$TMP')
+except TypeError: reg = cr.get_registry()
+e = cr.load_local_registry('$TMP')['$NEW']
+assert '$NEW' in reg and not e['shadowed_by_core'], e
+" && ok "new slug resolves via get_registry(), no longer shadowed" \
+   || bad "the new slug is not usable"
+
+# 5. rename refusals: unknown, curated target, same name
+python3 scripts/lib/profiles/promote.py --rename-from vllm/ghost --rename-to vllm/x \
+  --root "$TMP" --layer local >/dev/null 2>&1 && bad "unknown slug renamed" || ok "unknown slug refused"
+python3 scripts/lib/profiles/promote.py --rename-from "$NEW" --rename-to vllm/dual \
+  --root "$TMP" --layer local >/dev/null 2>&1 && bad "renamed onto a curated slug" \
+  || ok "renaming onto a curated slug refused"
+python3 scripts/lib/profiles/promote.py --rename-from "$NEW" --rename-to "$NEW" \
+  --root "$TMP" --layer local >/dev/null 2>&1 && bad "same-name rename accepted" || ok "same-name refused"
+
+# 6. the catalog front door agrees
+spec "$NEW" "Catalog Rename" 20255
+python3 scripts/lib/profiles/promote.py --spec-file "$TMP/spec.json" --root "$TMP" \
+  --layer local --yes --update >/dev/null 2>&1 && ok "update still works" || bad "update broke"
+bash scripts/catalog.sh rename --slug "$NEW" --to vllm/final --root "$TMP" >"$TMP/cat.log" 2>&1 \
+  && ok "catalog.sh rename works" || { bad "catalog.sh rename failed"; tail -3 "$TMP/cat.log"; }
+python3 -c "import json,sys;d=json.load(open('$REG'));sys.exit(0 if 'vllm/final' in d else 1)" \
+  && ok "catalog.sh rename re-keyed the registry" || bad "catalog.sh rename did not re-key"
+bash scripts/catalog.sh update --spec-file "$TMP/spec.json" --slug vllm/final --root "$TMP" -y \
+  >/dev/null 2>&1 && ok "catalog.sh update works" || { bad "catalog.sh update failed"; }
+python3 scripts/lib/profiles/promote.py --rename-from vllm/dual --rename-to vllm/y \
+  --root "$TMP" --layer local >/dev/null 2>&1 && bad "catalog.sh path renamed a CURATED slug" \
+  || ok "a curated slug is unreachable from rename"
+
+printf '\n%s: %d passed, %d failed\n' "$(basename "$0")" "$pass" "$fail"
+[ "$fail" -eq 0 ]
