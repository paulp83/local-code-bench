+              fi
+            done <<< "$holders"
+            if [[ -n "$ours" && -z "$theirs" ]]; then
+              echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running ${ours})"
+            elif [[ -n "$ours" ]]; then
