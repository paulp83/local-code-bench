+    # Crediting one running club container with every card above 100 MiB hid
+    # other tenants' workers entirely (a rig reported GPUs 0 and 2 as "held by
+    # running `sglang-cmp170hx`" when that container could only see GPU 1 and
+    # nvidia-smi showed another container's VLLM worker on 0 and 2). Map
+    # compute processes to cards by UUID instead of guessing.
+    holders=$(report_gpu_holders)
