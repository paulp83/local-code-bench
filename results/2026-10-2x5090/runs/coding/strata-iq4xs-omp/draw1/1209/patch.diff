diff --git a/scripts/tests/test-catalog-rename-update.sh b/scripts/tests/test-catalog-rename-update.sh
new file mode 100755
index 0000000..a91986f
--- /dev/null
+++ b/scripts/tests/test-catalog-rename-update.sh
@@ -0,0 +1,180 @@
+#!/usr/bin/env bash
+# Guard: catalog.sh rename / update amend ONLY the local layer (#1202 P7).
+#
+# #1204 decided a local slug colliding with a newly-shipped curated one is
+# SHADOWED — kept and marked "so the user can rename it" — but no rename
+# existed: the advertised remedy was unreachable. These are the properties
+# that make rename/update safe to hand a stranger:
+#   1. --dry-run exits 0 and leaves registry.local.json byte-identical;
+#   2. a real amend lands (right values, right types) and touches nothing
+#      outside the local layer — the curated catalog's fingerprint cannot move;
+#   3. curated slugs are refused as SOURCE (core slugs are not in the local
+#      file) and as TARGET (renaming onto a curated slug would recreate the
+#      shadow), origin is never editable, and an unknown engine namespace is
+#      refused before the write;
+#   4. a SHADOWED local entry (its slug also shipped as curated) is exactly
+#      what rename must be able to rescue;
+#   5. after any amend the layer still loads through load_local_registry with
+#      origin: local, and every entry's engine equals its slug's namespace.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+W="$TMP/config.json"
+
+C="$TMP/byo.yml"
+cat > "$C" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a byo-probe -c 65536 -ctk q8_0 -ts 1,1
+YML
+
+scripts/catalog.sh register --compose "$C" --engine their-engine --engine-type llama.cpp \
+    --weights "$W" --root "$TMP" -y >/dev/null 2>&1 \
+  || { echo "  FAIL could not register the fixture in a throwaway root"; exit 1; }
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+
+before_core="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+failn() { echo "  FAIL $*"; rc=1; }
+md5_of() { md5sum "$REG" | awk '{print $1}'; }
+
+# ── 1. --dry-run: exit 0, byte-identical registry, for BOTH subcommands ─────
+before="$(md5_of)"
+scripts/catalog.sh rename --slug their-engine/byo-probe --to vllm/byo-probe \
+    --root "$TMP" --dry-run -y >/dev/null 2>&1 \
+  || failn "rename --dry-run exited non-zero"
+scripts/catalog.sh update --slug their-engine/byo-probe --set workload=long-ctx-single \
+    --root "$TMP" --dry-run -y >/dev/null 2>&1 \
+  || failn "update --dry-run exited non-zero"
+[[ "$(md5_of)" == "$before" ]] || failn "--dry-run mutated registry.local.json"
+[[ "$rc" == "0" ]] && echo "  ok   --dry-run validates without writing"
+
+# ── 2. update lands: string AND int, engine untouched ───────────────────────
+scripts/catalog.sh update --slug their-engine/byo-probe \
+    --set workload=long-ctx-single --set max_ctx=7777 --root "$TMP" -y >/dev/null 2>&1 \
+  || failn "update failed"
+python3 - "$REG" <<'PY' || failn "update did not land with the right types"
+import json, sys
+e = json.load(open(sys.argv[1], encoding="utf-8"))["their-engine/byo-probe"]
+assert e["workload"] == "long-ctx-single", e["workload"]
+assert e["max_ctx"] == 7777 and isinstance(e["max_ctx"], int), repr(e["max_ctx"])
+assert e["engine"] == "their-engine"
+PY
+echo "  ok   update lands (JSON-typed values)"
+
+# ── 3. refusals: origin, core slug, bad key, unknown engine, bad target ─────
+before="$(md5_of)"
+out="$(scripts/catalog.sh update --slug their-engine/byo-probe --set origin=core \
+        --root "$TMP" -y 2>&1)"; code=$?
+if [[ "$code" -eq 0 || "$out" != *"origin"* ]]; then
+  failn "--set origin=… was not refused by name (exit $code): $out"
+fi
+
+scripts/catalog.sh update --slug "$CORE" --set workload=x --root "$TMP" -y >/dev/null 2>&1 \
+  && failn "update accepted a CURATED slug as source"
+
+scripts/catalog.sh update --slug their-engine/byo-probe --set bogus_key_xyz=1 \
+  --root "$TMP" -y >/dev/null 2>&1 && failn "a kwarg the loader would refuse was accepted"
+
+scripts/catalog.sh rename --slug "$CORE" --to their-engine/steal --root "$TMP" -y >/dev/null 2>&1 \
+  && failn "rename accepted a CURATED slug as source"
+
+scripts/catalog.sh rename --slug their-engine/byo-probe --to "$CORE" \
+  --root "$TMP" -y >/dev/null 2>&1 && failn "rename ONTO a curated slug was accepted"
+
+scripts/catalog.sh rename --slug their-engine/byo-probe --to not-an-engine/whatever \
+  --root "$TMP" -y >/dev/null 2>&1 && failn "an unknown engine namespace was accepted"
+
+[[ "$(md5_of)" == "$before" ]] || failn "a refusal changed registry.local.json"
+echo "  ok   origin / core-source / core-target / unknown-engine / bad-key refused"
+
+# ── 4. rename lands: new key, engine re-stamped to the new namespace ────────
+out="$(scripts/catalog.sh rename --slug their-engine/byo-probe --to vllm/byo-probe \
+       --root "$TMP" -y 2>&1)" \
+  || failn "rename failed: $out"
+[[ "$out" == *"RENAME_OK"* ]] || failn "rename emitted no RENAME_OK marker"
+python3 - "$REG" <<'PY' || failn "rename did not rewrite key + engine correctly"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+assert "their-engine/byo-probe" not in raw, "old slug still present"
+e = raw["vllm/byo-probe"]
+assert e["engine"] == "vllm", e["engine"]
+assert e["workload"] == "long-ctx-single", "amend lost earlier fields"
+PY
+echo "  ok   rename re-keys and re-stamps engine to the new namespace"
+# ── 5. THE REMEDY: a SHADOWED local row (slug also shipped curated) renames ─
+python3 - "$REG" "$CORE" <<'PY'
+import json, sys
+reg, core = sys.argv[1], sys.argv[2]
+raw = json.load(open(reg, encoding="utf-8"))
+row = dict(raw["vllm/byo-probe"], model="shadow-probe")
+raw[core] = row
+json.dump(raw, open(reg, "w", encoding="utf-8"))
+PY
+scripts/catalog.sh rename --slug "$CORE" --to vllm/shadow-renamed --root "$TMP" -y >/dev/null 2>&1 \
+  || failn "a SHADOWED local entry could not be renamed away — the #1204 remedy"
+python3 - "$REG" "$CORE" <<'PY' || failn "shadow rename did not land"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+assert sys.argv[2] not in raw
+assert raw["vllm/shadow-renamed"]["engine"] == "vllm"
+PY
+echo "  ok   shadowed local slug renames away from the curated collision"
+
+# ── 6. post-amend invariants: layer loads, origin=local, engine==namespace ──
+python3 - "$TMP" <<'PY' || failn "post-amend invariants broken"
+import sys
+sys.path.insert(0, ".")
+from pathlib import Path
+from scripts.lib.profiles.compose_registry import load_local_registry
+local = load_local_registry(Path(sys.argv[1]))
+assert local, "the amended layer loaded as empty"
+for slug, entry in local.items():
+    assert entry.get("origin") == "local", f"{slug} lost origin=local"
+    assert entry.get("engine") == slug.split("/", 1)[0], \
+        f"{slug}: engine {entry.get('engine')!r} != namespace"
+PY
+
+# ── 7. repair: an entry whose engine drifted is FIXED by the next amend ─────
+python3 - "$REG" <<'PY'
+import json, sys
+reg = sys.argv[1]
+raw = json.load(open(reg, encoding="utf-8"))
+raw["vllm/shadow-renamed"]["engine"] = "vllm-stable"   # profile-id drift
+json.dump(raw, open(reg, "w", encoding="utf-8"))
+PY
+scripts/catalog.sh update --slug vllm/byo-probe --set workload=fast-chat \
+    --root "$TMP" -y >/dev/null 2>&1 || failn "update failed on the repair fixture"
+python3 - "$REG" <<'PY' || failn "amend did not repair the drifted engine field"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+assert raw["vllm/shadow-renamed"]["engine"] == "vllm", raw["vllm/shadow-renamed"]["engine"]
+PY
+echo "  ok   engine==namespace enforced across the layer on write"
+
+# ── 8. the curated catalog never moved ───────────────────────────────────────
+[[ "$before_core" == "$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)" ]] \
+  || failn "the curated catalog changed"
+echo "  ok   curated catalog byte-identical after every amend"
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames, updates, and cannot reach core" \
+                   || echo "FAIL: catalog.sh rename/update regression"
+exit "$rc"
