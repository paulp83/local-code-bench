diff --git a/scripts/lib/profiles/amend.py b/scripts/lib/profiles/amend.py
new file mode 100755
index 0000000..35ff982
--- /dev/null
+++ b/scripts/lib/profiles/amend.py
@@ -0,0 +1,433 @@
+#!/usr/bin/env python3
+"""Local-layer AMENDMENT — rename or update a model ``promote.py`` wrote.
+
+The local layer was create-and-delete only: ``promote.py`` refuses every
+"already exists" case, ``demote.py`` only removes. That mattered more than
+ergonomics — #1204 decided that a local slug colliding with a newly-shipped
+curated one is **shadowed** (kept and *marked* "so the user can rename it",
+see compose_registry.load_local_registry), and no rename existed. The remedy
+was advertised and unreachable.
+
+    python3 scripts/lib/profiles/amend.py rename --slug old/slug --to new/slug
+    python3 scripts/lib/profiles/amend.py update --slug engine/name --set KEY=VALUE
+
+Like demote.py, CORE IS NEVER TOUCHED: the guard is LOCATION, not name — a
+slug absent from ``registry.local.json`` is refused before anything is read
+or written. That deliberately still allows the shadow case: a local row whose
+slug also shipped as curated IS in the local file, and renaming it away is
+exactly what this tool exists for. Renaming ONTO a curated slug is refused —
+core owns that lookup and git manages it.
+
+Only ``scripts/lib/profiles-local/registry.local.json`` is rewritten (atomic
+temp sibling + ``os.replace``). Two invariants are enforced on every write:
+
+  * the local layer's engine field and the slug namespace are ONE fact (that
+    is what ``catalog.sh register`` writes), so the renamed entry's ``engine``
+    is re-stamped to NEW's namespace and ANY entry whose engine drifted from
+    its namespace is repaired in the same atomic write;
+  * the RESULTING layer must still load through
+    ``compose_registry.load_local_registry`` — validated in a throwaway temp
+    root, never on disk — so this tool can never write a registry the
+    launchers refuse (bad kwarg, model collision, legacy ``local/`` slug).
+
+``origin`` is never editable: the loader stamps it on the built entry, and a
+raw entry carrying it is refused by the loader anyway.
+
+Exit codes match promote.py / demote.py: 0 success, 3 refusal (nothing
+written), 2 internal failure after the write started.
+
+Success markers (parseable, mirror PROMOTE_OK / DEMOTE_OK)::
+
+    RENAME_OK <old> -> <new>
+    UPDATE_OK <slug>
+"""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import io
+import json
+import os
+import re
+import sys
+import tempfile
+from pathlib import Path
+from typing import Optional
+
+_HERE = Path(__file__).resolve()
+_DEFAULT_ROOT = _HERE.parents[3]
+
+_LOCAL_DIR_REL = "scripts/lib/profiles-local"
+_LOCAL_REGISTRY_REL = f"{_LOCAL_DIR_REL}/registry.local.json"
+
+EXIT_COLLISION = 3
+EXIT_INTERNAL = 2
+
+# Same slug shape promote.py writes and load_local_registry accepts.
+_SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$")
+
+# `origin` is never editable: provenance is stamped by the loader (local rows
+# ARE the local layer), never self-declared by the entry.
+_NOT_EDITABLE = "origin"
+
+
+class Refusal(Exception):
+    """Nothing has been written; the caller can fix the input and retry."""
+
+
+class InternalError(Exception):
+    """The rewrite had started — state may be partial."""
+
+
+def _info(msg: str) -> None:
+    print(f"[amend] {msg}", file=sys.stderr)
+
+
+def _ensure_repo_importable(root: Path) -> None:
+    """Put the checkout (then --root) on sys.path so the scripts package
+    resolves regardless of how this script was invoked (script runs get the
+    SCRIPT dir on sys.path, not the cwd). The checkout is inserted first:
+    the curated catalog the guards reason about is the one this code ships
+    with, not a copy under --root."""
+    for p in (str(_DEFAULT_ROOT), str(root)):
+        if p not in sys.path:
+            sys.path.insert(0, p)
+
+
+def _load_local_raw(root: Path) -> dict:
+    """The RAW registry.local.json dict ({} when absent). Bad JSON is a
+    refusal — we never overwrite a file we cannot parse."""
+    path = root / _LOCAL_REGISTRY_REL
+    if not path.exists():
+        return {}
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise Refusal(f"{path} is unreadable — fix or remove it first: {exc}")
+    if not isinstance(data, dict) or not all(isinstance(v, dict) for v in data.values()):
+        raise Refusal(f"{path}: expected a JSON object of {{slug: {{kwargs}}}}")
+    return data
+
+
+def _core_slugs(root: Path) -> set:
+    """The curated slug set, for the refusal messages and the core guard."""
+    _ensure_repo_importable(root)
+    try:
+        from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY  # noqa: E402
+
+        return set(COMPOSE_REGISTRY)
+    except Exception:
+        # An unreadable core catalog must not turn "is this curated?" into
+        # "therefore amendable": callers fail closed on the raw-layer check
+        # first, so the only slug reaching this empty set is unknown anyway.
+        return set()
+
+
+def _known_engines(root: Path, raw: dict) -> set:
+    """Engine namespace-prefixes a rename target may use.
+
+    The union of: namespaces the curated slugs use (``vllm``, ``llamacpp``,
+    …), engine PROFILE ids (``vllm-stable``, ``llama-cpp-local``, …), local
+    engine profiles the user registered (``engines.d/*.yml`` — their own
+    builds), and namespaces ALREADY present in their own layer. Refusing a
+    typo'd namespace ("vlll/foo") is the point; refusing a legitimate one
+    would put the guard between the user and the remedy this tool is."""
+    engines = {slug.split("/", 1)[0] for slug in _core_slugs(root)}
+    engines |= {slug.split("/", 1)[0] for slug in raw}
+    eng_dir = root / _LOCAL_DIR_REL / "engines.d"
+    if eng_dir.is_dir():
+        engines |= {p.stem for p in eng_dir.glob("*.yml")}
+        engines |= {p.stem for p in eng_dir.glob("*.yaml")}
+    _ensure_repo_importable(root)
+    try:
+        from scripts.lib.profiles.compat import load_profiles  # noqa: E402
+
+        # load_profiles is chatty (profile banners, cross-reference notes on
+        # half-seeded layers that are NOT this tool's business) — the engines
+        # SET is all we need, so the noise stays off the caller's stream.
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+            engines |= set(load_profiles().engines)
+    except Exception:
+        # An engine profile that will not parse must not block renames into
+        # namespaces we can already prove are real from the catalogs above.
+        pass
+    return engines
+
+
+def _require_local(root: Path, raw: dict, slug: str) -> None:
+    """⛔ CORE SAFETY (inherited from demote.py): the guard is WHERE the entry
+    physically lives. Absent from registry.local.json → refuse; if curated,
+    say so, else list what IS registered. A SHADOWED local row (its slug also
+    shipped as curated) is present in raw and stays amendable — renaming it
+    away is the #1204 remedy this tool exists to serve."""
+    if slug in raw:
+        return
+    if slug in _core_slugs(root):
+        raise Refusal(
+            f"{slug!r} is a CURATED catalog entry, not a local one. This tool "
+            f"only amends the local layer; a curated entry is git-tracked and "
+            f"git is its amendment tool."
+        )
+    known = ", ".join(sorted(raw)) or "(none registered)"
+    raise Refusal(f"{slug} is not in {_LOCAL_REGISTRY_REL}. Registered: {known}")
+
+
+def _engine_repairs(candidate: dict) -> list:
+    """Force the local-layer invariant `engine == the slug's namespace` on
+    EVERY entry, mutating the candidate. Returns [(slug, was, now)] for the
+    entries that were off.
+
+    register writes both from one value; promote.py's local spec may carry an
+    engine PROFILE id ("llama-cpp-local") next to a coarse slug namespace
+    ("llama-cpp"). After any amend the whole layer must satisfy the invariant,
+    so drifted entries are repaired in the same atomic write."""
+    repaired = []
+    for slug, kwargs in candidate.items():
+        ns = slug.split("/", 1)[0]
+        if kwargs.get("engine") != ns:
+            repaired.append((slug, kwargs.get("engine"), ns))
+            kwargs["engine"] = ns
+    return repaired
+
+
+def _validate_candidate(candidate: dict) -> dict:
+    """Load the CANDIDATE layer exactly as the runtime loader would — in a
+    throwaway temp root, never on disk. A write that would break
+    load_local_registry (bad kwarg, model collision, legacy namespace, …) is
+    refused BEFORE anything is rewritten, so the tool can never leave the
+    launchers refusing to start."""
+    _ensure_repo_importable(_DEFAULT_ROOT)
+    from scripts.lib.profiles.compose_registry import (  # noqa: E402
+        LocalRegistryError,
+        load_local_registry,
+    )
+
+    with tempfile.TemporaryDirectory() as td:
+        reg = Path(td) / _LOCAL_REGISTRY_REL
+        reg.parent.mkdir(parents=True, exist_ok=True)
+        reg.write_text(json.dumps(candidate), encoding="utf-8")
+        try:
+            return load_local_registry(Path(td))
+        except LocalRegistryError as exc:
+            raise Refusal(f"the resulting layer would not load: {exc}") from exc
+
+
+def _describe_repairs(repairs: list) -> None:
+    for slug, was, now in repairs:
+        _info(
+            f"repaired engine on {slug}: {was!r} -> {now!r} "
+            f"(engine follows the slug namespace)"
+        )
+
+
+def _write_registry(root: Path, candidate: dict) -> None:
+    """Atomic rewrite: temp sibling + os.replace (a failed encode can never
+    truncate the registry — #777/#780)."""
+    reg = root / _LOCAL_REGISTRY_REL
+    tmp = reg.with_name(reg.name + ".tmp")
+    try:
+        reg.parent.mkdir(parents=True, exist_ok=True)
+        tmp.write_text(
+            json.dumps(candidate, indent=2, ensure_ascii=False) + "\n",
+            encoding="utf-8",
+        )
+        os.replace(tmp, reg)
+    except OSError as exc:
+        tmp.unlink(missing_ok=True)
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+
+
+def plan_rename(root: Path, old: str, new: str) -> dict:
+    """What renaming `old` -> `new` would write. Pure: reads only, never
+    writes. Raises Refusal for every input the write must not accept."""
+    raw = _load_local_raw(root)
+    _require_local(root, raw, old)
+
+    if old == new:
+        raise Refusal(f"rename needs a different name: {old!r} -> itself")
+    if not _SLUG_RE.match(new):
+        raise Refusal(f"bad target slug {new!r} — expected <engine>/<name> ([a-z0-9…])")
+    # Core owns the curated lookup (get_registry: "CORE WINS"), so landing a
+    # local row ON a curated slug would silently produce the very shadow this
+    # tool exists to flee — refuse instead of recreating it one step later.
+    if new in _core_slugs(root):
+        raise Refusal(
+            f"{new!r} is a CURATED catalog slug — a local entry cannot take it. "
+            f"Rename to another name instead."
+        )
+    if new in raw:
+        raise Refusal(
+            f"{new} is already registered locally — renaming onto it would "
+            f"silently drop the existing entry"
+        )
+    ns = new.split("/", 1)[0]
+    known = _known_engines(root, raw)
+    if ns not in known:
+        raise Refusal(
+            f"engine namespace {ns!r} of {new!r} is not a known engine. "
+            f"Known: {', '.join(sorted(known))}. For your own engine build, "
+            f"catalog.sh register writes profiles-local/engines.d/<engine>.yml "
+            f"— rename within an engine that already has one."
+        )
+    if not raw[old]:
+        raise Refusal(f"entry for {old} is empty — nothing to rename")
+
+    target = dict(raw[old])
+    target["engine"] = ns
+    candidate = {}
+    for s, k in raw.items():  # keep file order; the NEW key takes OLD's slot
+        candidate[new if s == old else s] = target if s == old else dict(k)
+    repairs = _engine_repairs(candidate)
+    loaded = _validate_candidate(candidate)
+    return {
+        "old": old,
+        "new": new,
+        "candidate": candidate,
+        "repairs": repairs,
+        "loaded": loaded,
+    }
+
+
+def plan_update(root: Path, slug: str, sets: list) -> dict:
+    """What applying ``--set KEY=VALUE`` pairs would write. Pure: reads only."""
+    raw = _load_local_raw(root)
+    _require_local(root, raw, slug)
+
+    if not sets:
+        raise Refusal("update needs at least one --set KEY=VALUE")
+
+    ns = slug.split("/", 1)[0]
+    parsed = []
+    for item in sets:
+        if "=" not in item:
+            raise Refusal(f"--set expects KEY=VALUE, got {item!r}")
+        key, value = item.split("=", 1)
+        key = key.strip()
+        if not key:
+            raise Refusal(f"--set expects KEY=VALUE, got {item!r} (empty key)")
+        if key == _NOT_EDITABLE:
+            raise Refusal(
+                f"{_NOT_EDITABLE!r} is not editable: provenance is stamped by "
+                f"the loader, never declared by the entry"
+            )
+        if key == "engine" and value != ns:
+            # The invariant is engine == namespace; changing the engine IS a
+            # rename. (A set equal to the namespace is a no-op: accepted.)
+            raise Refusal(
+                f"engine is not editable via --set: it is the slug's own "
+                f"namespace ({ns!r}). Changing the engine IS a rename — use: "
+                f"rename --slug {slug} --to {value}/{slug.split('/', 1)[-1]}"
+            )
+        # TYPE-PRESERVE: parse as JSON first so `max_ctx=8192` lands as an int
+        # and `status=experimental` as a string — _entry() does not coerce,
+        # and a string "8192" would sit in the layer forever.
+        try:
+            parsed.append((key, json.loads(value)))
+        except ValueError:
+            parsed.append((key, value))
+
+    candidate = {s: dict(k) for s, k in raw.items()}
+    for key, value in parsed:
+        candidate[slug][key] = value
+    repairs = _engine_repairs(candidate)
+    loaded = _validate_candidate(candidate)
+    return {
+        "slug": slug,
+        "sets": parsed,
+        "candidate": candidate,
+        "repairs": repairs,
+        "loaded": loaded,
+    }
+
+
+def rename_local(root: Path, old: str, new: str, *, dry_run: bool = False) -> dict:
+    """Rename a local slug. Returns the plan (validation already ran)."""
+    plan = plan_rename(root, old, new)
+    _info(f"{'would rename' if dry_run else 'rename'} {old} -> {new}")
+    _describe_repairs(plan["repairs"])
+    if dry_run:
+        _info("--dry-run — nothing written")
+        return plan
+    _write_registry(root, plan["candidate"])
+    _info(f"renamed {old} -> {new} in {_LOCAL_REGISTRY_REL}")
+    return plan
+
+
+def update_local(root: Path, slug: str, sets: list, *, dry_run: bool = False) -> dict:
+    """Amend fields of a local entry. Returns the plan."""
+    plan = plan_update(root, slug, sets)
+    pretty = ", ".join(f"{k}={v!r}" for k, v in plan["sets"])
+    _info(f"{'would update' if dry_run else 'update'} {slug}: {pretty}")
+    _describe_repairs(plan["repairs"])
+    if dry_run:
+        _info("--dry-run — nothing written")
+        return plan
+    _write_registry(root, plan["candidate"])
+    _info(f"updated {slug} in {_LOCAL_REGISTRY_REL}")
+    return plan
+
+
+def _confirm(prompt: str, assume_yes: bool) -> bool:
+    if assume_yes or not sys.stdin.isatty():
+        return True
+    try:
+        reply = input(f"[amend] {prompt} [y/N] ").strip().lower()
+    except EOFError:
+        reply = ""
+    return reply in ("y", "yes")
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    ap = argparse.ArgumentParser(
+        description="Rename or update a model in the LOCAL layer (never the curated catalog)."
+    )
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    def _common(p):
+        p.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root")
+        p.add_argument("--dry-run", action="store_true", help="validate + print, write nothing")
+        p.add_argument("-y", "--yes", action="store_true", help="skip the confirmation")
+
+    rp = sub.add_parser("rename", help="rename a local slug in place")
+    rp.add_argument("--slug", required=True, help="the existing local <engine>/<name>")
+    rp.add_argument("--to", required=True, help="the new <engine>/<name>")
+    _common(rp)
+
+    up = sub.add_parser("update", help="amend fields of a local entry")
+    up.add_argument("--slug", required=True, help="the existing local <engine>/<name>")
+    up.add_argument("--set", dest="sets", action="append", metavar="KEY=VALUE",
+                    help="field to amend (repeatable); origin is not editable")
+    _common(up)
+
+    args = ap.parse_args(argv)
+    root = Path(args.root).resolve()
+
+    try:
+        if args.cmd == "rename":
+            if not _confirm(f"rename {args.slug} -> {args.to}?", args.yes or args.dry_run):
+                print("[amend] aborted — nothing written", file=sys.stderr)
+                return EXIT_COLLISION
+            rename_local(root, args.slug, args.to, dry_run=args.dry_run)
+            if not args.dry_run:
+                print(f"RENAME_OK {args.slug} -> {args.to}")
+        else:
+            if not _confirm(
+                f"update {args.slug} ({', '.join(args.sets or [])})?", args.yes or args.dry_run
+            ):
+                print("[amend] aborted — nothing written", file=sys.stderr)
+                return EXIT_COLLISION
+            update_local(root, args.slug, args.sets or [], dry_run=args.dry_run)
+            if not args.dry_run:
+                print(f"UPDATE_OK {args.slug}")
+    except Refusal as exc:
+        print(f"[amend] refused: {exc}", file=sys.stderr)
+        return EXIT_COLLISION
+    except InternalError as exc:
+        print(f"[amend] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
