+# ---------------------------------------------------------------------------
+# Negative controls for install-script patches (delivery.entrypoint_invoke):
+# (a) a copy of the patch's own load-bearing compose with the patch's mount
+#     + invoke lines REMOVED must report not-reached. The legacy marker
+#     fallback used to answer True here unconditionally — a directory entry
+#     contributed the `patches` parent-name marker, a file entry the bare
+#     `install.sh` marker, and every compose that mounts anything matches
+#     one of them (the always-True class).
+# (b) a compose mounting a DIFFERENT patch at the SAME in-container target
+#     must not count as reached — the mount SOURCE, not just the target,
+#     has to identify this patch (qwen-w4a8-int8-act and
+#     qwen38-sglang-autoround-w4a8-v0519 both ship /etc/club3090/w4a8).
+# (c) positive sanity: the patch's own dir mounted at its target still
+#     reaches (the source match must not over-tighten).
+import tempfile as _pa_tempfile  # noqa: E402
+
+
+def _strip_target_lines(text: str, target: str) -> str:
+    return "\n".join(l for l in text.splitlines() if target not in l)
+
+
+_tmpdir = _pa_tempfile.TemporaryDirectory()
+_tmp = Path(_tmpdir.name)
+_install_script_patches = [
+    p for p in patches
+    if p.get("delivery_mechanism") == "install_script"
+    and (p.get("delivery") or {}).get("entrypoint_invoke")
+    and (p.get("delivery_spec") or {}).get("mounted_at")
+]
+for patch in _install_script_patches:
+    _target = patch["delivery_spec"]["mounted_at"]
+    _lb_composes = [
+        c
+        for lb in patch.get("load_bearing_when") or []
+        for c in lb.get("composes") or []
+        if c in COMPOSE_REGISTRY
+    ]
+    if not _lb_composes:
+        continue
+    # (a) stripped copy of the real load-bearing compose.
+    _full = pa.compose_text(root, _lb_composes[0])
+    _stripped = _tmp / f"stripped-{patch['id']}.yml"
+    _stripped.write_text(_strip_target_lines(_full, _target), encoding="utf-8")
+    if _target in pa.service_body(pa.compose_text(root, str(_stripped))):
+        errors.append(
+            f"{patch['id']} negative-control fixture is malformed: "
+            f"stripped copy still names {_target}"
+        )
+    elif pa.reaches(root, patch, str(_stripped)):
+        errors.append(
+            f"{patch['id']} FALSE REACH: a copy of its load-bearing compose "
+            f"with the mount + invoke lines for {_target} removed was still "
+            f"reported wired (the always-True legacy fallback)"
+        )
+    # (c) positive sanity: THIS patch's own source mounted at its target
+    #     (plus its declared invoke line) must reach — the source match
+    #     must not over-tighten.
+    _own = _tmp / f"own-{patch['id']}.yml"
+    _inv = next(
+        (m for m in pa._spec_wiring_markers(patch)[1] if "/" in m),
+        f"bash {_target}/install.sh",
+    )
+    _src = sorted(pa._patch_source_identifiers(patch))[0]
+    _own.write_text(
+        "services:\n"
+        "  svc:\n"
+        "    image: scratch\n"
+        "    volumes:\n"
+        "      - ../../../patches/%s:%s:ro\n"
+        "    command: \"%s\"\n"
+        % (_src, _target, _inv),
+        encoding="utf-8",
+    )
+    if not pa.reaches(root, patch, str(_own)):
+        errors.append(
+            f"{patch['id']} MISSING REACH: its own source dir mounted at "
+            f"{_target} + declared invoke line no longer counts as wired "
+            f"(source matching over-tightened)"
+        )
+
+# (b) same-target, different-source pairs among shipped entries.
+_by_target: dict[str, list] = {}
+for patch in _install_script_patches:
+    _by_target.setdefault(patch["delivery_spec"]["mounted_at"], []).append(patch)
+for _target, _group in sorted(_by_target.items()):
+    if len(_group) < 2:
+        continue
+    for _a, _b in ((_group[0], _group[1]), (_group[1], _group[0])):
+        _fx = _tmp / f"cross-{_a['id']}.yml"
+        _fx.write_text(
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            "      - ../../../patches/%s-other-patch:%s:ro\n"
+            % (_b["id"], _target),
+            encoding="utf-8",
+        )
+        if pa.reaches(root, _a, str(_fx)):
+            errors.append(
+                f"{_a['id']} FALSE REACH: a compose mounting a DIFFERENT "
+                f"patch at the same in-container target {_target} was "
+                f"reported wired — mount matching must bind the SOURCE, "
+                f"not just the target"
+            )
+_tmpdir.cleanup()
