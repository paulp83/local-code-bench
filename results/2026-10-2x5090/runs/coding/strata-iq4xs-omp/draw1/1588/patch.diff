+command grep -q "cannot detect the served slot count" <<<"$out" || fail "expected the honest FATAL about undetectable slots, got: $out"
+command grep -q "no running container publishes" <<<"$out" || fail "expected the host-only note naming the URL, got: $out"
+rm -rf "$REMOTE_STUB"
+echo "  ✓ URL on another host → host-only, never the local container on the same port (#1584)"
