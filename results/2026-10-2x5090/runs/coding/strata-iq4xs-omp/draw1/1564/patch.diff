diff --git a/scripts/tests/test-catalog-cli.sh b/scripts/tests/test-catalog-cli.sh
index 9e49c84..ab45680 100755
--- a/scripts/tests/test-catalog-cli.sh
+++ b/scripts/tests/test-catalog-cli.sh
@@ -63,6 +63,25 @@ else
 fi
 [[ "$out" == *"dry-run"* ]] || { echo "  FAIL --dry-run did not reach the executor"; rc=1; }
 
+# 2a. --dry-run writes NOTHING — including the engine profile. catalog.sh used
+# to write engines.d/<engine>.yml itself, BEFORE handing the spec to promote.py,
+# so a dry run leaked it onto disk. The leak even hid in THIS test: the dry runs
+# above pre-created the engine file, so the round trip's "engine profile
+# written" check below would have passed on the dry-run's leftovers. promote.py
+# owns that write now, and a dry run must leave the layer pristine.
+leaked=""
+for f in engines.d/their-engine.yml models.d/byo-probe.yml registry.local.json; do
+  [[ -e "$TMP/scripts/lib/profiles-local/$f" ]] && leaked="$leaked $f"
+done
+if [[ -n "$leaked" ]]; then
+  echo "  FAIL --dry-run wrote local-layer files:$leaked"; rc=1
+else
+  echo "  ok   --dry-run wrote nothing (engine profile included)"
+fi
+# the plan must NAME the engine profile it will write
+[[ "$out" == *"engines.d/their-engine.yml (new local ENGINE profile)"* ]] \
+  || { echo "  FAIL dry-run plan does not list the engine profile"; rc=1; }
+
 # 2b. arch is REQUIRED and must be refused BEFORE the write — promote reads it
 # with .get, so a missing arch passes its validation and then dies in the
 # post-write re-check, leaving the layer written and broken ("NO ROLLBACK").
