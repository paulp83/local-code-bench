index b395a69..900fbaf 100755
--- a/scripts/tests/test_promote.py
+++ b/scripts/tests/test_promote.py
@@ -265,6 +265,66 @@ class TestLocalLayer:
         assert raw["vllm/my-model-dual-autoround-int4"]["status"] == "incubating"
 
 
+class TestLocalEngineProfile:
+    """`local_engine_profile` — the engine YAML catalog.sh derives for an
+    unknown engine travels IN THE SPEC so promote's plan, --dry-run exit and
+    confirm gate it. It used to be written by catalog.sh before promote ever
+    ran, which made --dry-run leak engines.d/<engine>.yml onto disk."""
+
+    _EP = (
+        "schema_version: 1\n"
+        "id: my-engine\n"
+        "display_name: my-engine (local, registered from a compose)\n"
+        "type: llama.cpp\n"
+        "stability: experimental\n"
+        "min_sm: 7.5\n"
+    )
+
+    def _spec_with_ep(self, **kw):
+        spec = _spec(slug="my-engine/my-model-dual-autoround-int4", **kw)
+        spec["local_engine_profile"] = self._EP
+        return spec
+
+    def test_dry_run_lists_the_engine_profile_and_writes_nothing(self, root):
+        res = _run_cli(root, self._spec_with_ep(), "--layer", "local", "--dry-run")
+        assert res.returncode == 0, res.stderr + res.stdout
+        assert "engines.d/my-engine.yml (new local ENGINE profile)" in res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+        for rel in LOCAL_ARTIFACTS:
+            assert not (root / rel).exists(), rel
+
+    def test_real_write_lands_in_engines_d_verbatim(self, root):
+        res = _run_cli(root, self._spec_with_ep(), "--layer", "local")
+        assert res.returncode == 0, res.stderr + res.stdout
+        ep = root / "scripts/lib/profiles-local/engines.d/my-engine.yml"
+        assert ep.is_file()
+        assert ep.read_text(encoding="utf-8") == self._EP
+
+    def test_absent_key_writes_no_engine_file(self, root):
+        # No key → the old three-artifact behavior; nothing lands in engines.d.
+        res = _run_cli(root, _spec(), "--layer", "local")
+        assert res.returncode == 0, res.stderr + res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_empty_profile_refused_before_any_write(self, root):
+        spec = self._spec_with_ep()
+        spec["local_engine_profile"] = "   "
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "non-empty string" in res.stderr
+        for rel in LOCAL_ARTIFACTS:
+            assert not (root / rel).exists(), rel
+
+    def test_core_layer_refuses_the_local_key(self, root):
+        # engines.d is the LOCAL layer; a core spec must not smuggle one in.
+        spec = self._spec_with_ep(layer_local=False)
+        res = _run_cli(root, spec, "--layer", "core",
+                       env_extra={"C3_ALLOW_CORE_PROMOTE": "1"})
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "LOCAL-layer key" in res.stderr
+        assert not (root / "scripts/lib/profiles/engines.d").exists()
+
+
 class TestCoreGate:
     def test_core_without_flag_exits_nonzero_and_writes_nothing(self, root):
         res = _run_cli(root, _spec(layer_local=False), "--layer", "core")
