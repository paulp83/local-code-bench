--- a/scripts/lib/thinking-budget.sh
+++ b/scripts/lib/thinking-budget.sh
@@ -16,6 +16,10 @@
 #   engine      server prerequisite               request shape
 #   llama.cpp   --reasoning-budget N (boot flag)  none — server-wide
 #   vLLM        --reasoning-parser <name>         thinking_token_budget: N
+#                 — read from the container argv OR, when the argv shows
+#                 none, from the server's own boot log (a launcher script
+#                 inside the image can add the flag where docker inspect
+#                 cannot see it)
 #   SGLang      --enable-custom-logit-processor   custom_logit_processor +
 #                                                 custom_params.thinking_budget
 #
@@ -229,6 +233,36 @@ _thinking_budget_container_facts() {
   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# vLLM's own boot-log readback. An image that starts vLLM through its own
+# launcher SCRIPT (bucko's qwen38-serve) adds --reasoning-parser INSIDE that
+# script, so the container argv — all `docker inspect` can show — never
+# carries it. The API server prints the resolved args once per boot:
+#   (APIServer pid=1) INFO … [api_utils.py:286] non-default args: {… 'reasoning_parser': 'qwen3', …}
+# and a parser absent from THAT dict is a parser the server did not load —
+# same "resolved truth" role SGLang's /server_info plays below. `docker logs`
+# can hold several boots (restart policy), so the LAST non-default args line
+# wins, matching the llama.cpp last-occurrence rule.
+# arg: container name. stdout: the parser name, or NOTHING when there is no
+# evidence either way (no parser in the last boot, docker logs unreadable, or
+# the server never reached that line).
+_TB_VLLM_BOOTLOG_PY="$(cat <<'PY'
+import re, sys
+pat = re.compile(r"""["']reasoning_parser["']\s*:\s*["']([^"']+)["']""")
+last = ""
+for line in sys.stdin:
+    if "non-default args:" in line:
+        last = ""
+        for m in pat.finditer(line):
+            last = m.group(1)
+print(last)
+PY
+)"
+_thinking_budget_vllm_bootlog_parser() {
+  # stderr: docker itself complains when there is no such container — the
+  # empty stdout is the evidence-absent answer the caller already handles.
+  docker logs "$1" 2>&1 | python3 -c "$_TB_VLLM_BOOTLOG_PY" 2>/dev/null || true
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,6 +365,17 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
+          # Absence from the argv is NOT positive evidence of absence: an
+          # image that starts vLLM through its own launcher script adds
+          # --reasoning-parser where docker inspect cannot see it (bucko's
+          # qwen38-serve). The server's own boot log settles it — only when
+          # THAT shows no parser (or is unreadable) does the old refusal stand.
+          local bootlog
+          bootlog="$(_thinking_budget_vllm_bootlog_parser "$c")"
+          if [[ -n "$bootlog" ]]; then
+            THINKING_BUDGET_EVIDENCE="container ${c}'s boot log reports reasoning_parser=${bootlog} in non-default args — the parser is loaded even though the container argv cannot show it (its launcher adds it)"
+            return 0
+          fi
           THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
           return 1 ;;
         "PARSER "*)
