--- /dev/null
+++ b/scripts/tests/test-concurrency-probe-sweep-skip.sh
@@ -0,0 +1,177 @@
+#!/usr/bin/env bash
+# test-concurrency-probe-sweep-skip — GPU-free regression for the two
+# concurrency-probe.sh #sweep bugs:
+#
+#   1. emit_row consumed the skip-row JSON on STDIN while `python3 -` reads
+#      its PROGRAM from stdin (the heredoc), so every skip path (budget /
+#      clipped / early-stop) crashed the sweep (JSONDecodeError + set -e):
+#      measured cells printed, but the card, the === recommend === block and
+#      the results/concurrency-*.{md,json} files were never written.
+#      Guards: each skip class must run the sweep to rc=0 and still write the
+#      results files. (Fix: the row arrives as argv, read via sys.argv[2].)
+#
+#   2. VRAM + the GPU label were rig-wide, not the probed container's cards:
+#      vram_used_mb() summed every GPU on the host, and _gpu_fp() counted all
+#      GPUs and stamped them with GPU 0's name — a 1×3060 container on a rig
+#      where an unrelated service ran on the other cards read "55319 MB on
+#      4× RTX 3090". Guards: the resolver + the nvidia-smi calls must scope
+#      to docker-inspect's GPU set (shimmed rig: container pinned to GPU 3),
+#      and the card must print the scoped label.
+#
+# All offline: docker/nvidia-smi are PATH shims, the probe cell runs through
+# the CP_RUN_PROBE seam (no server, no GPU), and results go to a temp
+# RESULTS_DIR so the repo tree stays clean.
+set -euo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PROBE="$ROOT_DIR/scripts/concurrency-probe.sh"
+LIB="$ROOT_DIR/scripts/lib/concurrency_probe.py"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+SHIM="$TMP/shim"; mkdir -p "$SHIM"
+RESDIR="$TMP/results"; mkdir -p "$RESDIR"
+
+# --- mock docker: one container, pinned to GPU 3 ------------------------------
+cat > "$SHIM/docker" <<'EOF'
+#!/usr/bin/env bash
+case "${1:-}" in
+  ps) echo "vllm-qwen" ;;
+  inspect)
+    if [[ "$*" == *"--format"* ]]; then
+      echo 'vllm serve --model /x --max-num-seqs 32 --max-model-len 32768'
+    else
+      printf '%s\n' '[{"Config":{"Cmd":["vllm","serve","--max-num-seqs","32","--max-model-len","32768"],"Env":["NVIDIA_VISIBLE_DEVICES=3"]},"HostConfig":{"DeviceRequests":[]}}]'
+    fi ;;
+  *) : ;;
+esac
+EOF
+
+# --- mock nvidia-smi: 4-GPU rig, only GPU 3 is the 3060 ------------------------
+# Rig-wide total 14979*3 + 10381 = 55319 MB; the scoped figure is 10381 MB.
+cat > "$SHIM/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+sel="" query=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    -i) sel="$2"; shift 2 ;;
+    --query-gpu=*) query="${1#--query-gpu=}"; shift ;;
+    *) shift ;;
+  esac
+done
+row() { # host-index used-MB name — emit only when selected (or no -i filter)
+  [[ -z "$sel" || ",$sel," == *",$1,"* ]] || return 0
+  case "$query" in
+    *memory.used*) echo "$1, $2" ;;
+    name*) echo "$3" ;;
+    *) echo "$1" ;;
+  esac
+}
+row 0 14979 "NVIDIA GeForce RTX 3090"
+row 1 14979 "NVIDIA GeForce RTX 3090"
+row 2 14979 "NVIDIA GeForce RTX 3090"
+row 3 10381 "NVIDIA GeForce RTX 3060"
+EOF
+chmod +x "$SHIM/docker" "$SHIM/nvidia-smi"
+export PATH="$SHIM:$PATH"
+
+# --- stub probe cell (CP_RUN_PROBE seam): prints a RESULT line per N ----------
+# STUB_FAIL_N=8 simulates a failed rung (drives early-stop); STUB_SLEEP_N=4
+# burns 2 s (drives the wall budget).
+STUB="$TMP/cell.sh"
+cat > "$STUB" <<'EOF'
+#!/usr/bin/env bash
+N="${CP_N:-1}"
+if [[ -n "${STUB_FAIL_N:-}" && "$N" == "${STUB_FAIL_N}" ]]; then
+  echo "probe stub: N=$N simulated failure"
+  echo "RESULT N=$N ctx=${PROMPT_TOKENS:-0} clean=0 pass=0 mps_tps=0.00 agg_tps=0.00 leak=-1 vram_peak=10381 vram_peak_cards=3:10381 ttft_ms=1 running=0 waiting=$N running_max=0 waiting_max=$N"
+  exit 1
+fi
+if [[ -n "${STUB_SLEEP_N:-}" && "$N" == "${STUB_SLEEP_N}" ]]; then sleep 2; fi
+echo "probe stub round table (N=$N)"
+echo "RESULT N=$N ctx=${PROMPT_TOKENS:-0} clean=1 pass=1 mps_tps=20.00 agg_tps=$((20 * N)) leak=0 vram_peak=10381 vram_peak_cards=3:10381 ttft_ms=100 running=$N waiting=0 running_max=$N waiting_max=0"
+EOF
+chmod +x "$STUB"
+
+run_sweep() { # run_sweep <name> [extra env assignments...] — KV clip: 32K×N=8 overflows
+  local name="$1"; shift
+  ( env URL="http://127.0.0.1:1" MODEL=test-model CONTAINER=vllm-qwen \
+      CONCURRENCY_PROBE_RECORD=0 RESULTS_DIR="$RESDIR/$name" \
+      CP_RUN_PROBE="bash $STUB" KV_TOKENS=262144 \
+      MODEL_PINNED=1 \
+      "$@" \
+      bash "$PROBE" --sweep --ctx "1k 32k" --n 4,8,16 )
+}
+mkdir -p "$RESDIR"/{kv,es,budget}
+
+# --- 1. KV-clipped skip: sweep must FINISH and write the card + files ---------
+# Pre-fix this aborted at "skip (N*(ctx+gen)…)" with rc=1 and zero files.
+out="$(run_sweep kv 2>&1)" || fail "clipped-skip sweep must exit 0, got rc=1 — $(tail -3 <<<"$out" | tr '\n' ' ')"
+command grep -q "skip (N\*(ctx+gen)" <<<"$out" || fail "expected a KV-clipped skip cell in the plan"
+command grep -q "=== recommend ===" <<<"$out" || fail "card must carry the recommendation the skipped run used to lose"
+ls "$RESDIR"/kv/concurrency-*.json >/dev/null 2>&1 || fail "results JSON not written"
+ls "$RESDIR"/kv/concurrency-*.md   >/dev/null 2>&1 || fail "results card not written"
+command grep -q '"skip": "N\*(ctx+gen)' "$RESDIR"/kv/concurrency-*.json \
+  || fail "skipped cell missing from the results JSON"
+# Issue 2, label half: the card must name the container's 3060, not the rig.
+command grep -q "1× GeForce RTX 3060" "$RESDIR"/kv/concurrency-*.md \
+  || fail "GPU label must be scoped to the container's card (1× GeForce RTX 3060)"
+command grep -q "RTX 3090" "$RESDIR"/kv/concurrency-*.md \
+  && fail "GPU label leaked rig-wide RTX 3090s for a 3060-pinned container"
+echo "  ✓ clipped skip: sweep finishes, card + JSON written, GPU label scoped"
+
+# --- 2. early-stop skip --------------------------------------------------------
+out="$(run_sweep es STUB_FAIL_N=8 2>&1)" || fail "early-stop sweep must exit 0"
+command grep -q "skip (early-stop" <<<"$out" || fail "expected an early-stop skip cell"
+command grep -q '"skip": "early-stop"' "$RESDIR"/es/concurrency-*.json \
+  || fail "early-stop row missing from the results JSON"
+echo "  ✓ early-stop skip: sweep finishes, row recorded"
+
+# --- 3. budget skip ------------------------------------------------------------
+out="$(run_sweep budget WALL_BUDGET=1s STUB_SLEEP_N=4 2>&1)" || fail "budget sweep must exit 0"
+command grep -q "skip (budget)" <<<"$out" || fail "expected a budget skip cell"
+command grep -q '"skip": "budget"' "$RESDIR"/budget/concurrency-*.json \
+  || fail "budget row missing from the results JSON"
+echo "  ✓ budget skip: sweep finishes, row recorded"
+
+# --- 4. the VRAM query is scoped to the container's cards ---------------------
+PYTHONPATH="$ROOT_DIR/scripts/lib" python3 - <<'PY' || fail "vram scoping"
+import sys
+from concurrency_probe import container_gpu_selectors, vram_samples_mb, vram_used_mb
+
+bad = []
+def ck(cond, msg):
+    if not cond: bad.append(msg)
+
+sel = container_gpu_selectors("vllm-qwen")
+ck(sel == ["3"], f"container_gpu_selectors -> {sel!r}, expected ['3']")
+ck(container_gpu_selectors("") is None, "no container must resolve to None (rig-wide fallback)")
+ck(vram_samples_mb(sel) == [("3", 10381)],
+   f"per-card samples must hold ONLY the selected card: {vram_samples_mb(sel)!r}")
+ck(vram_used_mb(sel) == 10381,
+   f"scoped VRAM must be the 3060's 10381 MB, got {vram_used_mb(sel)}")
+ck(vram_used_mb() == 14979 * 3 + 10381,
+   f"unscoped must still sum the rig (guard symmetry), got {vram_used_mb()}")
+# A scoped query whose cards do not exist fails CLOSED (-1), it does not
+# silently fall back to the rig-wide sum — that would re-hide the mislabel.
+ck(vram_used_mb(["9"]) == -1,
+   f"a selector nvidia-smi cannot resolve must read -1, got {vram_used_mb(['9'])}")
+
+if bad:
+    for b in bad: print("  ⛔", b)
+    sys.exit(1)
+print("  ✓ vram_used_mb scoped to docker-inspect's GPU set; rig-wide only on fallback")
+PY
+
+# --- 5. wiring: emit_row takes the row as an argument -------------------------
+command grep -q 'json.loads(sys.argv\[2\])' "$PROBE" \
+  || fail "emit_row must read the row from argv — stdin belongs to the heredoc"
+command grep -qE '\| emit_row' "$PROBE" \
+  && fail "a piped '| emit_row' caller reintroduces the stdin collision"
+command grep -q 'nvidia-smi -i' "$LIB" \
+  || fail "the VRAM query must pass -i when scoped to the container's cards"
+echo "  ✓ wiring: emit_row argv, no piped callers, nvidia-smi -i scoping"
+
+echo "test-concurrency-probe-sweep-skip: ok"
