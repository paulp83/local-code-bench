diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..d5daf11 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,34 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ SGLang admits CustomAllReduceV2 only on full NVLink, so on a PCIe rig the
+# kernel that actually runs is the V1 CustomAllreduce — and V1 logs NOTHING at
+# init. Its sole success signal is the rank-0 graph-buffer registration after
+# CUDA-graph capture (real wording, sglang/srt/distributed/device_communicators/
+# custom_all_reduce.py; vLLM's V1 shares it, same semantics). Before this fix a
+# healthy V1 boot scored "unknown" in report.sh and on the bench card — and
+# could never score on.
+_sgl_v1="$(printf '%s\n' \
+  "[t] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}" \
+  "[t TP0] sglang is using nccl==2.27.7" \
+  "[t TP0] Registering 4352 cuda graph addresses" \
+  "[t TP0] Registering 258 cuda graph addresses")"
+_sgl_v1_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_sgl_v1_ev" "Registering 4352 cuda graph addresses"
+r="$(printf '%s\n' "$_sgl_v1_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"   # unfiltered stream too
+[[ "$r" == "on" ]] || fail "unfiltered V1 PCIe boot -> on (got $r)"
+# Restart epochs apply to V1 success as well: it must not leak into a later
+# operator-disabled restart, and a failed restart must outrank it.
+r="$(printf '%s\n%s' "$_sgl_v1_ev" '[sglang] BOOT disable_custom_all_reduce=True' | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator-disabled restart after a V1 success boot wins (got $r)"
+_sgl_v1_restart="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' 'Setup Custom allreduce failed with boom. To silence this warning, specify --disable-custom-all-reduce explicitly.')"
+r="$(printf '%s\n%s' "$_sgl_v1_ev" "$_sgl_v1_restart" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_failed" ]] || fail "failed restart after a V1 success boot -> nccl_only_failed (got $r)"
+unset _sgl_v1 _sgl_v1_ev _sgl_v1_restart
+echo "  ✓ SGLang V1 (PCIe) graph-buffer registration scores custom-AR ON; restart epochs sliced"
+
