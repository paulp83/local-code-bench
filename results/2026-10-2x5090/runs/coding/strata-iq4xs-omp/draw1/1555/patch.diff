+0, GPU-aaaa0000-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 15000
+1, GPU-aaaa1111-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 14938
+2, GPU-aaaa2222-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3090, 15000
+3, GPU-bbbb3333-0000-0000-0000-000000000000, NVIDIA GeForce RTX 3060, 10381
+ROWS
+SMI
+cat > "$C_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = inspect ] || exit 0
+case "$2" in
+  pinned-comma) echo '[{"HostConfig":{"DeviceRequests":[{"Count":0,"DeviceIDs":["2,3"]}]},"Config":{"Env":[]}}]' ;;
+  *) echo "Error: No such object: $2" >&2; exit 1 ;;
+esac
+DOCK
+chmod +x "$C_STUB/nvidia-smi" "$C_STUB/docker"
+got="$(PATH="$C_STUB:$PATH" python3 - "$ROOT_DIR/scripts/lib" pinned-comma <<'PY'
+import sys
+sys.path.insert(0, sys.argv[1])
+import concurrency_probe as c
+sel, _ = c.container_gpus(sys.argv[2])
+print(f"{c.gpu_label(sel)}|{c.vram_used_mb(sel)}|{','.join(sel or [])}")
+PY
+)"
+[[ "$got" == "1× GeForce RTX 3090 + 1× GeForce RTX 3060|25381|2,3" ]] \
+  || fail "DeviceIDs [\"2,3\"] must scope to GPUs 2+3 (3090+3060, 15000+10381 MB): got '$got'"
+rm -rf "$C_STUB"
+echo "  ✓ comma-joined DeviceIDs entry scopes like two pinned ids"
+
+# #1537 (2): --container-for-url resolves the container by the port it PUBLISHES
+# (any engine) — the vllm-(qwen|gemma) name heuristic never found an SGLang one.
+P_STUB="$(mktemp -d)"
+cat > "$P_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = ps ] || exit 0
+printf 'svc-llama\t127.0.0.1:9090->8080/tcp\nsvc-vllm\t0.0.0.0:8020->8000/tcp, :::8020->8000/tcp\nexposed-only\t8021/tcp\n'
+DOCK
+chmod +x "$P_STUB/docker"
+got="$(PATH="$P_STUB:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+[[ "$got" == "svc-vllm" ]] || fail "--container-for-url on the publishing container: got '$got'"
+got="$(PATH="$P_STUB:$PATH" URL=http://127.0.0.1:9090/v1 python3 "$LIB" --container-for-url)"
+[[ "$got" == "svc-llama" ]] || fail "--container-for-url with a path in the URL: got '$got'"
+out="$(PATH="$P_STUB:$PATH" URL=http://localhost:8021 python3 "$LIB" --container-for-url)"
+[[ -z "$out" ]] || fail "an exposed-but-unpublished port must not match: got '$out'"
+out="$(PATH="$P_STUB:$PATH" URL=http://localhost:7070 python3 "$LIB" --container-for-url)"
