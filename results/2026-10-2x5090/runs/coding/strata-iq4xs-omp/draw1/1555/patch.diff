+# ── which container + which drafter the card names (#1537) ─────────────────────
+# CONTAINER used to come from a vllm-(qwen|gemma) name heuristic, which never
+# matched an SGLang container, and _spec_fp grepped the container's Cmd for
+# --speculative-config — a flag the Qwen3.8 vLLM composes build inside their
+# entrypoint script from SPEC_N, so it never appears in Cmd. Both cards read the
+# truth from the engine instead: which container publishes the URL's port, and
+# what the engine itself says it booted with.
+
+def container_for_url(url):
+    """Name of the running container publishing the port `url` points at, or None."""
+    try:
+        # Tolerate a bare host:port the way curl would read it.
+        parts = urllib.parse.urlparse(url if "//" in url else "//" + url)
+        port = parts.port
+        if port is None:
+            port = 443 if parts.scheme == "https" else 80
+    except Exception:
+        return None
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", timeout=10,
+        )
+    except Exception:
+        return None
+    for line in out.stdout.splitlines():
+        name, _, ports = line.partition("\t")
+        # A published mapping reads `0.0.0.0:8020->8000/tcp` / `[::]:8020->8000/tcp`
+        # / `8020->8020/tcp`; the host side is what the URL dials. A bare
+        # `8020/tcp` is exposed-but-unpublished and must NOT match.
+        for tok in ports.split(","):
+            m = re.search(r"(?:^|[\[.:])(\d+)->", tok.strip())
+            if m and int(m.group(1)) == port:
+                return name.strip() or None
+    return None
+
+
+# The engine-config line is printed once, at boot: scanning the TAIL of `docker
+# logs` misses it on any container that has served for a while, so stream the
+# head and stop at the first match.
+_SPEC_LOG_HEAD_LINES = 3000
+
+
+def _vllm_spec_label(container):
+    """vLLM's own engine-config dump: 'MTP n=4' / 'spec off', or None when the
+    container or its boot line is not readable."""
+    if not container:
+        return None
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+            text=True, encoding="utf-8", errors="replace",
+        )
+    except Exception:
+        return None
+    label = None
+    try:
+        for line in itertools.islice(proc.stdout, _SPEC_LOG_HEAD_LINES):
+            if "Initializing a V1 LLM engine" not in line or "speculative_config=" not in line:
+                continue
+            m = re.search(r"speculative_config=(None|SpeculativeConfig\([^)]*\))", line)
+            if not m:
+                break
+            if m.group(1) == "None":
+                label = "spec off"
+            else:
+                meth = re.search(r"method='([^']+)'", m.group(1))
+                if meth:
+                    n = re.search(r"num_spec_tokens=(\d+)", m.group(1))
+                    label = meth.group(1).upper() + (f" n={n.group(1)}" if n else "")
+            break
+    except Exception:
+        return None
+    finally:
+        for closer in (proc.stdout.close, proc.terminate):
+            try:
+                closer()
+            except Exception:
+                pass
+        try:
+            proc.wait(timeout=5)
+        except Exception:
+            try:
+                proc.kill()
+            except Exception:
+                pass
+    return label
+
+
+def _sglang_spec_label(url):
+    """SGLang reports the drafter it actually serves with on /get_server_info;
+    None when the endpoint is not an SGLang answer."""
+    if not url:
+        return None
+    try:
+        with urllib.request.urlopen(url.rstrip("/") + "/get_server_info", timeout=5) as r:
+            info = json.loads(r.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+    if not isinstance(info, dict) or "speculative_algorithm" not in info:
+        return None
+    algo = str(info.get("speculative_algorithm") or "").strip()
+    if not algo:
+        return "spec off"
+    steps = info.get("speculative_num_steps")
+    draft = str(info.get("speculative_draft_model_path") or "").strip().rstrip("/")
+    model = str(info.get("model_path") or "").strip().rstrip("/")
+    # Native MTP on SGLang is EAGLE over the target's own checkpoint: mtp.yml
+    # passes the target path as --speculative-draft-model-path, and SGLang
+    # defaults it to the target when unset.
+    if algo.upper().startswith("EAGLE") and (not draft or draft == model):
+        name = "MTP"
+    else:
+        name = algo.upper()
+    return name + (f" n={steps}" if steps not in (None, "") else "")
+
+
+def spec_label(container="", url=""):
+    """Drafter label for the card, read from the engine: vLLM's boot config (via
+    $CONTAINER) first, then SGLang's /get_server_info (via $URL). None when
+    neither source is readable — the caller then falls back."""
+    return _vllm_spec_label(container) or _sglang_spec_label(url)
+
