+from http.server import BaseHTTPRequestHandler, HTTPServer
+sys.path.insert(0, sys.argv[1])
+import concurrency_probe as c
+RESP = [
+    {"model_path": "/m", "speculative_algorithm": "EAGLE",
+     "speculative_draft_model_path": "/m", "speculative_num_steps": 4},
+    {"model_path": "/m", "speculative_algorithm": "EAGLE3",
+     "speculative_draft_model_path": "/drafter", "speculative_num_steps": 3},
+    {"model_path": "/m", "speculative_algorithm": "EAGLE",
+     "speculative_draft_model_path": None, "speculative_num_steps": 2},
+    {"model_path": "/m", "speculative_algorithm": None},
+]
+class H(BaseHTTPRequestHandler):
+    i = 0
+    def do_GET(self):
+        body = json.dumps(RESP[H.i]).encode(); H.i += 1
+        self.send_response(200); self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body))); self.end_headers()
+        self.wfile.write(body)
+    def log_message(self, *a): pass
+srv = HTTPServer(("127.0.0.1", 0), H)
+threading.Thread(target=srv.serve_forever, daemon=True).start()
+url = f"http://127.0.0.1:{srv.server_address[1]}"
+labels = [c._sglang_spec_label(url) for _ in RESP]
+srv.shutdown()
+print("|".join(str(x) for x in labels))
+PY
+)"
+[[ "$got" == "MTP n=4|EAGLE3 n=3|MTP n=2|spec off" ]] \
