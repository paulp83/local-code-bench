+#!/usr/bin/env bash
+[ "$1" = logs ] || exit 0
+case "$2" in
+  vllm-mtp)
+    echo "INFO 10-13 [core.py:100] Initializing a V1 LLM engine (v0.11.0) with config: model='/m', speculative_config=SpeculativeConfig(method='mtp', model=None, num_spec_tokens=4), load_config=LoadConfig()"
+    for _i in $(seq 1 5000); do echo "INFO: 127.0.0.1 - POST /v1/chat/completions 200 OK"; done ;;
+  vllm-off)
+    echo "INFO Initializing a V1 LLM engine (v0.11.0) with config: model=/m, speculative_config=None"
