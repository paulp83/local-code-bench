diff --git a/scripts/tests/test-switch-refuse-before-teardown.sh b/scripts/tests/test-switch-refuse-before-teardown.sh
new file mode 100755
index 0000000..84fd9bf
--- /dev/null
+++ b/scripts/tests/test-switch-refuse-before-teardown.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# Gate: switch.sh must refuse a launch BEFORE tearing down the running slug.
+#
+# THE DEFECT
+# switch.sh brought the running slug down FIRST and only then ran the checks
+# that can refuse a launch, so a refused launch left the rig serving nothing.
+# Hit twice on the reference rig in one day: an experimental slug run without
+# --force, and a worktree whose model files weren't on the host (no
+# MODEL_DIR). A mistyped slug did the same.
+#
+# THE CONTRACT (up_variant()'s phase order)
+#   1. every static refusal check — unknown slug, lifecycle gate, missing
+#      model files — runs with NOTHING brought down;
+#   2. teardown happens only on a committed launch;
+#   3. the GPU-state gates (which can only be measured after the running
+#      container released its VRAM) stay post-teardown.
+#
+# Harness: a recording `docker` shim on PATH (so any teardown attempt —
+# down_running() always starts with `docker ps` — lands in a log) plus
+# COMPOSE_BIN=: so even a committed boot cannot touch a real daemon.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+
+PASS=0
+FAIL=0
+fail() { echo "  FAIL: $1"; FAIL=$((FAIL+1)); }
+ok()   { echo "  ✓ $1"; PASS=$((PASS+1)); }
+assert_contains()     { [[ "$1" == *"$2"* ]] || fail "$3 (missing: '$2' in: $(tail -1 <<<"$1"))"; }
+assert_not_contains() { [[ "$1" != *"$2"* ]] || fail "$4 (unexpected: '$2' in: $1)"; }
+
+T="$(mktemp -d)"
+cleanup() { rm -rf "$T"; }
+trap cleanup EXIT
+mkdir -p "$T/bin" "$T/empty-model-dir"
+
+# Recording docker: logs every call; `ps` reports a managed club-3090 container
+# so down_running() WOULD have something to tear down if it were reached, and
+# `inspect` answers the label probes so a reached teardown runs fully.
+cat > "$T/bin/docker" <<'EOF'
+#!/usr/bin/env bash
+echo "docker $*" >> "${SWITCH_TEST_DOCKER_LOG:?}"
+case "$1" in
+  ps)      echo "vllm-qwen36-27b-minimal" ;;
+  inspect) case "$3" in
+             *working_dir*)  echo "/tmp" ;;
+             *config_files*) echo "compose-fake.yml" ;;
+           esac ;;
+esac
+exit 0
+EOF
+chmod +x "$T/bin/docker"
+
+export SWITCH_TEST_DOCKER_LOG="$T/docker-calls.log"
+
+# run_switch <label> <expect-rc:zero|nonzero> <needle in output> [extra env]...
+# Captures combined output + records docker calls since the last run.
+run_switch() {
+  local label="$1" want="$2" needle="$3"; shift 3
+  : > "$SWITCH_TEST_DOCKER_LOG"
+  local out rc=0
+  out="$(env "$@" PATH="$T/bin:$PATH" COMPOSE_BIN=: \
+        bash scripts/switch.sh "${ARGS[@]}" 2>&1)" || rc=$?
+  RC="$rc"
+  OUT="$out"
+  DOCKER_CALLS="$(cat "$SWITCH_TEST_DOCKER_LOG")"
+  if [[ "$want" == nonzero && "$rc" -eq 0 ]]; then
+    fail "$label: expected refusal, launch proceeded"
+  elif [[ "$want" == zero && "$rc" -ne 0 ]]; then
+    fail "$label: expected success, got rc=$rc: $(tail -1 <<<"$out")"
+  fi
+  if [[ -n "$needle" ]]; then
+    assert_contains "$out" "$needle" "$label output"
+  fi
+}
+
+# --- 1. mistyped slug ------------------------------------------------------
+ARGS=(vllm/minnal)
+run_switch "mistyped slug" nonzero "unknown variant"
+[[ -z "$DOCKER_CALLS" ]] \
+  && ok "mistyped slug refused without touching docker (rig keeps serving)" \
+  || fail "mistyped slug touched docker before refusing: $DOCKER_CALLS"
+
+# --- 2. experimental slug without --force ----------------------------------
+ARGS=(vllm/qwen38-27b-dual-max)
+run_switch "experimental slug" nonzero "won't launch without an explicit override"
+[[ -z "$DOCKER_CALLS" ]] \
+  && ok "(NA: experimental) refused before teardown" \
+  || fail "status gate ran after teardown: $DOCKER_CALLS"
+
+# --- 3. model files missing on the host (compose-deps) ---------------------
+# MODEL_DIR points at an empty dir → the mount exists but the weights don't;
+# deterministic refusal on any rig, with or without models-cache.
+ARGS=(vllm/minimal)
+run_switch "missing model files" nonzero "expects model files" "MODEL_DIR=$T/empty-model-dir"
+[[ -z "$DOCKER_CALLS" ]] \
+  && ok "missing model files refused before teardown" \
+  || fail "compose-deps refusal happened after teardown: $DOCKER_CALLS"
+
+# --- 4. a COMMITTED launch still tears down and boots ----------------------
+# The inverse half: refusing early must not have moved teardown off the launch
+# path. PREFLIGHT_NO_COMPOSE_DEPS=1 + COMPOSE_BIN=: keep it daemon-free.
+ARGS=(--no-owui --no-wait vllm/minimal)
+run_switch "committed launch" zero "bringing up" \
+  PREFLIGHT_NO_COMPOSE_DEPS=1 "MODEL_DIR=$T/empty-model-dir"
+assert_contains "$DOCKER_CALLS" "docker ps" \
+  "committed launch must reach down_running() (it starts with docker ps)"
+assert_not_contains "$OUT" "ERROR" "committed launch must not error"
+
+# --- 5. negative control: the harness notices teardown ---------------------
+# A guard that cannot fail proves nothing — `--down` exercises the same
+# down_running() entry and MUST show the docker calls the refusals above
+# claim are absent.
+: > "$SWITCH_TEST_DOCKER_LOG"
+env PATH="$T/bin:$PATH" COMPOSE_BIN=: bash scripts/switch.sh --down >/dev/null 2>&1 || true
+grep -q "docker ps" "$SWITCH_TEST_DOCKER_LOG" \
+  && ok "--down still tears down (recording harness is live)" \
+  || fail "harness is blind — --down recorded no docker calls"
+
+echo "----------------------------------------"
+echo "PASS: $PASS   FAIL: $FAIL"
+[[ "$FAIL" -eq 0 ]] || exit 1
+echo "OK: switch.sh refuses a launch before tearing down the running slug"
