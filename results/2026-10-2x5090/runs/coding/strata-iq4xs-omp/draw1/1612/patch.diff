+# ---------------------------------------------------------------------------
+# #1623 — chat_template attribution is source- and path-aware. A bare
+# `--chat-template` flag elsewhere, a mount of ANOTHER patch's template, the
+# `chat_template.jinja` mount-suffix collision, or `--chat-template` matched
+# as a prefix of `--chat-template-file` must NOT make a patch "reach".
+# These controls fail on the pre-#1623 code, which appended the bare flag to
+# the invoke markers and treated `wired_at: [volumes, command]` as unknown.
+# ---------------------------------------------------------------------------
+_ctmap = {p["id"]: p for p in chat_template_patches}
+
+
+def _ct_compose_path(slug: str):
+    src = COMPOSE_REGISTRY.get(slug)
+    if src is None:
+        return None
+    return root / (src["compose_path"] if isinstance(src, dict) else src)
+
+
+def _ct_first_lb(pid: str):
+    p = _ctmap.get(pid)
+    if not p:
+        return None
+    for lb in p.get("load_bearing_when") or []:
+        for s in lb.get("composes") or []:
+            return s
+    return None
+
+
+# (a) The Qwen3.8 template must NOT reach a Gemma compose: the Gemma compose
+#     mounts the google-canonical template (whose host path ALSO ends in
+#     `chat_template.jinja`) and passes --chat-template for THAT file.
+_gemma_slug = _ct_first_lb("gemma-google-canonical-chat-template")
+_q38 = _ctmap.get("qwen38-reasoning-effort-template")
