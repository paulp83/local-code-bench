+        errors.append(f"#1623: qwen38-reasoning-effort-template reaches {_gemma_slug}, "
+                      "which mounts a DIFFERENT (Gemma) template")
+
+# (b) apex / glm53 / qwen38 must NOT reach a vLLM compose that only passes
+#     --chat-template for its OWN (froggeric) template — and froggeric must
+#     not reach the ik-llama apex compose, where the bare flag only appears
+#     as a PREFIX of --chat-template-file.
+_frg_slug = _ct_first_lb("qwen-froggeric-chat-template")
+if _frg_slug:
+    _fp = _ct_compose_path(_frg_slug)
+    for _pid in ("apex-qwen-chat-template", "glm53-minja-numeric-index",
+                 "qwen38-reasoning-effort-template"):
+        _pp = _ctmap.get(_pid)
+        if _fp and _pp is not None and pa.reaches(root, _pp, str(_fp)):
+            errors.append(f"#1623: {_pid} reaches {_frg_slug}, which passes "
+                          "--chat-template only for its OWN (froggeric) template")
+_apex_slug = _ct_first_lb("apex-qwen-chat-template")
+_frg = _ctmap.get("qwen-froggeric-chat-template")
+if _apex_slug and _frg is not None:
