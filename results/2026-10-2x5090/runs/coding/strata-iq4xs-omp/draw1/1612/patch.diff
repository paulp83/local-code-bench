+                      "compose — --chat-template inside --chat-template-file is a "
+                      "prefix collision, not wiring")
+
+# (c) Removal controls on the REAL composes (#1597 style): removing the mount
+#     OR the flag (for the flag-style patches) must lose coverage.
+for _pid in ("qwen-froggeric-chat-template", "gemma-google-canonical-chat-template",
+             "apex-qwen-chat-template"):
+    _p = _ctmap.get(_pid)
+    _slug = _ct_first_lb(_pid)
+    _path = _ct_compose_path(_slug) if _slug else None
+    if _p is None or _path is None or not _path.exists():
+        errors.append(f"#1623 removal control: {_pid} / {_slug} no longer exist")
+        continue
+    if not pa.reaches(root, _p, str(_path)):
+        errors.append(f"#1623 positive control: {_pid} does not reach {_slug}")
