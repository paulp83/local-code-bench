+def _chat_template_flag_names_mount(body: str, mounted_at: str) -> bool:
+    """True iff ``--chat-template`` / ``--chat-template-file`` actually NAMES
+    ``mounted_at`` — the flag-style wiring of a vendored chat template.
+
+    A bare flag is NOT wiring (#1623): the old code probed the substring
+    ``"--chat-template"`` anywhere in the body, which every compose passing
+    ANY ``--chat-template`` / ``--chat-template-file`` for its OWN template
+    satisfied (and it even matched inside ``--chat-template-file`` as a
+    prefix). The flag counts only when the mounted path follows it directly:
+    same (possibly YAML-wrapped) line, ``=``-joined, or as the adjacent
+    command list item in the merged body.
+    """
+    if not mounted_at:
+        return False
+    path = re.escape(mounted_at)
+    # `--chat-template /path`, `--chat-template-file /path` (ik-llama folded
+    # command strings), `--chat-template=/path`, or the pair split by a YAML
+    # line-fold (`[\s=]` + whitespace only between flag and path).
+    if re.search(r"--chat-template(?:-file)?[ \t]*[\s=][ \t]*" + path, body):
+        return True
+    # `- --chat-template` as its own command list item, the path the NEXT
+    # list item (how `docker compose config` / `yaml.safe_dump` render an
+    # explicit command list after the extends merge).
+    return re.search(
+        r"^[ \t]*(?:-[ \t]*)?--chat-template(?:-file)?[ \t]*\n[ \t]*-[ \t]*\S*" + path,
+        body,
+        re.M,
+    ) is not None
+
+
+def _chat_template_wiring_present(patch: dict, body: str, wired_at: set) -> bool:
+    """Chat-template wiring: the compose must mount THIS patch's vendored
+    template (the mount source names the patch's own directory or file, the
+    #1610 install-script rule) at the declared ``mounted_at``, and — when the
+    patch is flag-style — the ``--chat-template`` / ``--chat-template-file``
+    flag must name exactly that mounted path (#1623).
+
+    A bare ``--chat-template`` flag satisfies neither check, so a compose
+    wiring some OTHER template never "reaches" this patch. Mount-only wiring
+    (``wired_at: [volumes]`` — carnice, whose vLLM mount the engine
+    auto-loads, and qwen38, whose SGLang composes render the mounted file
+    with no flag while its vLLM composes name it — that pairing is held by
+    test-qwen38-template.sh) requires the source-aware mount only.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at") or ""
+    if not mounted_at:
+        return False
+    sources = _chat_template_sources(patch)
+    if sources:
+        # The source name must appear as a full path segment of the mount
+        # syntax (`/src/` or `/src:`): the mounted dest may CONTAIN the source
+        # name (`/etc/apex-qwen-chat-template.jinja` contains
+        # `apex-qwen-chat-template.jinja`), so a plain substring would let the
+        # flag-arg line alone masquerade as the mount (#1623).
+        src_re = re.compile(
+            r"(?:^|[\s/])(?:" + "|".join(re.escape(s) for s in sources) + r")[:/]"
+        )
+        vol_ok = any(mounted_at in ln and src_re.search(ln) for ln in body.splitlines())
+    else:
+        # No identifying source (jinja named generically, flat under
+        # patches/): fall back to the container target alone.
+        vol_ok = mounted_at in body
+    if "--chat-template" in (spec.get("invoke") or ""):
+        inv_ok = _chat_template_flag_names_mount(body, mounted_at)
+    else:
+        # Mount-only invoke (prose, e.g. carnice's "vLLM auto-loads it"):
+        # the mount itself is the corroborating evidence.
