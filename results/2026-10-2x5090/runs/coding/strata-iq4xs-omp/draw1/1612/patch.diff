+# Template file names many chat_template patches share (the vendored file is
+# usually named after the MODEL's artifact, not the patch). On a mount line
+# the bare name matches EVERY template patch's mount — the same trap as a
+# generic script name (#1597/#1623) — so the identifying name is the patch's
+# own directory unless the file itself is patch-named.
+_CHAT_TEMPLATE_GENERIC_NAMES = frozenset({"chat_template.jinja", "chat_template.jinja2", "chat_template.j2"})
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line:
+    the `delivery_spec.jinja` file name (when patch-specific) and its parent
+    directory, minus generic ones."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    jinja = (patch.get("delivery_spec") or {}).get("jinja") or ""
+    if not jinja:
+        return []
+    path = Path(jinja)
+    names: set[str] = set()
+    if path.name and path.name not in _CHAT_TEMPLATE_GENERIC_NAMES:
+        names.add(path.name)
+    if path.parent.name and path.parent.name != "patches":
+        names.add(path.parent.name)
+    return sorted(names)
+
 
