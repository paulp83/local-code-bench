diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..8c36eb6 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1022,12 +1022,35 @@ down_running() {
     [[ -n "${managed[$c]:-}" ]] || continue   # not ours — leave it alone
     brought_down=1
     echo "[switch] bringing down: ${c}"
-    # derive the compose dir/file from the container's labels — stop fallback
+    # derive the compose dir/file(s) from the container's labels — stop fallback.
+    # Since #1498 the config_files label can hold several comma-joined paths
+    # (the slug's compose plus the slug-label override); docker compose takes
+    # one -f per file, so split the list. Drop entries that no longer exist
+    # (e.g. the label override went away after a data-dir move) — `down` does
+    # not need the label file, it only adds labels. Relative entries resolve
+    # against the recorded working_dir, same as compose would.
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      local -a cfg_paths=() cfg_args=()
+      local -a _cfgs
+      local f p
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      for f in "${_cfgs[@]}"; do
+        [[ -n "$f" ]] || continue
+        if [[ -e "$f" ]]; then
+          cfg_paths+=("$f")
+        elif [[ "$f" != /* && -e "$lbl_dir/$f" ]]; then
+          cfg_paths+=("$lbl_dir/$f")
+        fi
+      done
+      if [[ ${#cfg_paths[@]} -gt 0 ]]; then
+        for p in "${cfg_paths[@]}"; do cfg_args+=(-f "$p"); done
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..90eec0d 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -16,6 +16,9 @@
 #   5. Teardown passes --remove-orphans.
 #   6. When only unmanaged containers run, nothing is torn down and the
 #      "no club-3090 container running" path is taken.
+#   7. A comma-joined config_files label (post-#1498: compose file + slug-label
+#      override) becomes one -f per file, dropping files that no longer exist.
+#   8. When every listed file is gone, teardown falls back to docker stop.
 #
 # Harness: extract down_running() via sed, source it, inject a VARIANT_CONTAINER
 # managed set + a mock `docker` on PATH that records compose-down / stop calls.
@@ -80,7 +83,13 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      if [[ -n "${DOCKER_MOCK_CONFIG_FILES:-}" ]]; then
+        printf '%s\n' "$DOCKER_MOCK_CONFIG_FILES"
+      else
+        # down_running drops -f entries that no longer exist — materialise the default.
+        : > "$DOCKER_MOCK_WORKDIR/compose-$cname.yml"
+        printf 'compose-%s.yml\n' "$cname"
+      fi
     fi
     ;;
   stop)
@@ -135,6 +144,29 @@ assert_not_contains "$log" "COMPOSE"                          "nothing torn down
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
 
+# --- Scenario 3: comma-joined config_files label (#1498) -----------------------
+# Docker compose records several compose files (the slug's compose plus the
+# slug-label override) comma-joined in one label. down_running must pass one
+# -f per file and drop entries that no longer exist.
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b"
+: > "${tmp_dir}/cfg-a.yml"; : > "${tmp_dir}/cfg-b.yml"
+export DOCKER_MOCK_CONFIG_FILES="${tmp_dir}/cfg-a.yml,${tmp_dir}/cfg-missing.yml,${tmp_dir}/cfg-b.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_contains     "$log" "-f ${tmp_dir}/cfg-a.yml -f ${tmp_dir}/cfg-b.yml down" "comma-joined label → one -f per surviving file"
+assert_not_contains "$log" "cfg-missing"   "missing listed file not passed to compose"
+assert_not_contains "$log" "STOP"          "compose down used when at least one file survives"
+
+# --- Scenario 4: every listed file gone → stop fallback, no compose ------------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_CONFIG_FILES="${tmp_dir}/gone-1.yml,${tmp_dir}/gone-2.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_not_contains "$log" "COMPOSE"                "compose not invoked when no listed file exists"
+assert_contains     "$log" "STOP vllm-qwen36-27b"  "falls back to docker stop when no listed file exists"
+unset DOCKER_MOCK_CONFIG_FILES
+
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
 echo "PASS: $PASS   FAIL: $FAIL"
