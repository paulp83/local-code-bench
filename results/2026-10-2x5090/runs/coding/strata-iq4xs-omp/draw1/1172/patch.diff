+def _compute_per_dev(text):
+    """Per-device total compute buffer, counting each context exactly once.
+
+    Every sched_reserve line is a (re-)reservation, and the log never labels
+    which context it belongs to. A drafter-pinned device logs e.g.
+    5208.35 (target), 1606.48 (drafter), 5240.16 (target RE-RESERVE after the
+    drafter loaded): first and third are the same buffer re-reserved and must
+    not be summed; the second is additive. A purely positional rule ("lines
+    after the drafter's load_tensors are the drafter's") is wrong -- the
+    re-reservation follows. The one signature the log does carry is ORDER:
+    a value strictly SMALLER than the last value seen for that device can
+    only be a distinct, smaller context (the drafter); anything else re-reserves
+    the main buffer and replaces it. This under-counts only in the exotic case
+    of a drafter that grows its compute buffer between reservations -- the
+    measured alternative (last-wins) dropped 1.6 GiB on every drafter boot.
+    """
+    primary, extra, last = {}, {}, {}
+    for m in re.finditer(
+        r"sched_reserve:\s+(CUDA\d) compute buffer size\s*=\s*([\d.]+) MiB", text
+    ):
+        dev, val = m.group(1), float(m.group(2))
+        if dev not in primary:
+            primary[dev] = val
+        elif val < last[dev]:
+            extra[dev] = extra.get(dev, 0.0) + val
+        else:
+            primary[dev] = val
+        last[dev] = val
+    return {d: primary[d] + extra.get(d, 0.0) for d in primary}
+
