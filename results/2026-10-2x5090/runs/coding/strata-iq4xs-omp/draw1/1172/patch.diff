diff --git a/scripts/tests/test-vram-breakdown.sh b/scripts/tests/test-vram-breakdown.sh
new file mode 100755
index 0000000..dc1eeb6
--- /dev/null
+++ b/scripts/tests/test-vram-breakdown.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+# test-vram-breakdown — guards for scripts/lib/vram_breakdown.py (#1119).
+#
+# The three defects this pins all shipped together on a drafter-pinned boot
+# (glm53-flash-dual-iq3xxs-moecache): the drafter's load_tensors line
+# OVERWROTE the target's under model= (last-wins), llama_memory_recurrent
+# state buffers matched nothing, and the drafter's sched_reserve was
+# overwritten by the target's later re-reservation. Net effect: 84% of the
+# reported `unaccounted` was identifiable memory.
+#
+# Fixture is the REAL line shapes and numbers from that boot log.
+set -euo pipefail
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+export PYTHONUTF8="${PYTHONUTF8:-1}"   # repo rule: locale must not decide python decoding
+PY="$ROOT_DIR/scripts/lib/vram_breakdown.py"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+[[ -f "$PY" ]] || fail "missing $PY"
+
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+
+# nvidia-smi stand-in: vram_breakdown parses
+#   --query-gpu=index,memory.used,memory.total  --format=csv,noheader,nounits
+cat > "$TMP/bin_nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+echo "0, 21000, 24576"
+echo "1, 22992, 24576"
+EOF
+install -m 0755 "$TMP/bin_nvidia-smi" "$TMP/nvidia-smi"
+
+# Boot log, real shapes. CUDA1 carries the drafter: target loads first,
+# drafter second; the target then RE-RESERVES compute after the drafter loads.
+cat > "$TMP/boot.log" <<'EOF'
+load_tensors:   CUDA0 model buffer size   = 3313.42 MiB
+load_tensors:   CUDA1 model buffer size   = 3313.42 MiB
+llama_memory_hybrid: _comp_state: CUDA0 rs state buffer size =  102.50 MiB
+llama_kv_cache: CUDA0 KV buffer size      = 1361.00 MiB
+sched_reserve:  CUDA0 compute buffer size = 5208.35 MiB
+[moe-cache] CUDA0 pool[0]: type=mxfp4 expert=4352 KiB slots=2216 total=9653 MiB
+sched_reserve:  CUDA0 compute buffer size = 5240.16 MiB
+load_tensors:   CUDA1 model buffer size   =  655.73 MiB
+llama_kv_cache: CUDA1 KV buffer size      = 1281.00 MiB
+llama_memory_recurrent: CUDA1 rs buffer size =  205.00 MiB
+llama_kv_cache: CUDA1 KV buffer size      =   80.00 MiB
+sched_reserve:  CUDA1 compute buffer size = 5208.35 MiB
+sched_reserve:  CUDA1 compute buffer size = 1606.48 MiB
+[moe-cache] CUDA1 pool[0]: type=mxfp4 expert=4352 KiB slots=2216 total=9653 MiB
+sched_reserve:  CUDA1 compute buffer size = 5240.16 MiB
+EOF
+
+out="$(PATH="$TMP:$PATH" python3 "$PY" "$TMP/boot.log")" || fail "parser exited non-zero:
+$out"
+
+# --- defect 1: model must be target + drafter, never last-wins --------------
+# 3313.42 + 655.73 = 3969.15 -> 3969. Before the fix this printed 656:
+# the drafter's weights, with the target's 3,313 MiB lost to unaccounted.
+command grep -q 'CUDA1: model=3969' <<<"$out" \
+  || fail "CUDA1 model= must be target+drafter (3969), got:
+$out"
+command grep -q 'CUDA0: model=3313' <<<"$out" \
+  || fail "CUDA0 model= must be the single target buffer (3313), got:
+$out"
+echo "  ✓ model sums target+drafter load_tensors; single-model device unchanged"
+
+# --- defect 2: llama_memory_recurrent state must be counted -----------------
+command grep -q 'state=205' <<<"$out" \
+  || fail "CUDA1 state= must carry the recurrent (rs) buffer (205), got:
+$out"
+command grep -q 'state=102' <<<"$out" \
+  || fail "CUDA0 state= must keep matching _comp_state (DeepSeek-hybrid) lines:
+$out"
+echo "  ✓ recurrent rs buffer counted; _comp_state path still matches"
+
+# --- defect 3: compute must count each context exactly once -----------------
+# CUDA1 sequence 5208.35 / 1606.48 / 5240.16: first and last are the SAME
+# target buffer re-reserved (must NOT sum to 12054); the 1606.48 drafter
+# context is additive -> 5240.16 + 1606.48 = 6846.64 -> 6847.
+command grep -q 'compute=6847' <<<"$out" \
+  || fail "CUDA1 compute= must be re-reserved target + drafter (6847), got:
+$out"
+# CUDA0 is the no-drafter control: reserve 5208.35 then re-reserve 5240.16.
+# Summing them (10448) would double-count; last-wins (5240) is the right
+# answer for a single-context device.
+command grep -q 'compute=5240' <<<"$out" \
+  || fail "CUDA0 compute= must be the re-reservation alone (5240), not a sum:
+$out"
+echo "  ✓ compute re-reservations replace, strictly-smaller interleaved contexts add"
+
+# --- end to end: the reported unaccounted must actually shrink --------------
+# CUDA1 acc = 3969.15 + 1361.00 + 205.00 + 6846.64 + 9653 = 22034.79
+#          -> 22992 - 22034.79 = 957.21 -> 957
+command grep -q 'total=22992/24576MiB(94%)  unaccounted=957' <<<"$out" \
+  || fail "CUDA1 unaccounted must close to 957, got:
+$out"
+echo "  ✓ unaccounted reconciles: named buffers + unaccounted == nvidia-smi used"
+
+# moe-cache stays LAST-per-pool even when logged twice (pre-existing trap).
+cat > "$TMP/twice.log" <<'EOF'
+load_tensors:   CUDA0 model buffer size   = 3313.42 MiB
+[moe-cache] CUDA0 pool[0]: type=mxfp4 expert=4352 KiB slots=1000 total=4250 MiB
+[moe-cache] CUDA0 pool[0]: type=mxfp4 expert=4352 KiB slots=3038 total=12911 MiB
+EOF
+out2="$(PATH="$TMP:$PATH" python3 "$PY" "$TMP/twice.log")" \
+  || fail "parser failed on the double-allocation fixture:
+$out2"
+command grep -q 'pool=12911' <<<"$out2" \
+  || fail "moe-cache pool must take the LAST allocation (12911), never sum:
+$out2"
+command grep -q 'WARNING: 2 moe-cache allocations' <<<"$out2" \
+  || fail "the double-allocation warning must still fire:
+$out2"
+echo "  ✓ moe-cache last-wins trap preserved alongside the drafter fixes"
+
+# no argv -> usage exit 1, unreadable file -> exit 1 (contract unchanged)
+python3 "$PY" >/dev/null 2>&1 && fail "no argument must exit 1"
+python3 "$PY" "$TMP/does-not-exist.log" >/dev/null 2>&1 && fail "missing file must exit 1"
+echo "  ✓ CLI contract unchanged"
+
+echo "test-vram-breakdown: ok"
