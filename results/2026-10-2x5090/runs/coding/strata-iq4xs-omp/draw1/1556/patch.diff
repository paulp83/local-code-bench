+# #1537 follow-up (1): the card's KV pool. --detect-kv parsed only vLLM's line, and
+# only from the last 2500 log lines — a container that has been serving for a while
+# has scrolled past its boot line, and SGLang never prints the vLLM one at all.
+kv="$(python3 -c 'import sys; sys.path.insert(0,"'"$ROOT_DIR"'/scripts/lib"); from concurrency_probe import parse_kv_tokens_text as p; print(p("INFO scheduler.py:1500] max_total_num_tokens=146720, chunked_prefill_size=8192, max_running_requests=2, context_len=262144"))')"
+[[ "$kv" == "146720" ]] || fail "parse_kv_tokens_text must read SGLang's pool line, got $kv"
+KV_STUB="$(mktemp -d)"
+cat > "$KV_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+# `docker logs <container>` (NO --tail flag — the reader takes the log head).
+# The pool line sits at the HEAD, then 3000 lines of traffic: a --tail 2500 read
+# — what the old --detect-kv did — would never see it.
+case "${2:-}" in
+  sgl-kv)
+    echo "INFO 09-28 12:00:00 scheduler.py:1500] max_total_num_tokens=146720, chunked_prefill_size=8192, max_prefill_tokens=16384, max_running_requests=2, context_len=262144"
+    for i in $(seq 1 3000); do echo 'INFO: 127.0.0.1 - "POST /v1/chat/completions HTTP/1.1" 200 OK'; done ;;
+  vllm-kv)
+    echo "(EngineCore pid=1) INFO GPU KV cache size: 210,000 tokens"
+    for i in $(seq 1 3000); do echo '(EngineCore) INFO Engine 000: Avg generation throughput: 80.0 tokens/s'; done ;;
+  *) exit 1 ;;
+esac
+DOCK
+chmod +x "$KV_STUB/docker"
+got="$(PATH="$KV_STUB:$PATH" CONTAINER=sgl-kv python3 "$LIB" --detect-kv)"
+[[ "$got" == "146720" ]] || fail "--detect-kv on a scrolled SGLang boot log: got '$got', want 146720"
+got="$(PATH="$KV_STUB:$PATH" CONTAINER=vllm-kv python3 "$LIB" --detect-kv)"
+[[ "$got" == "210000" ]] || fail "--detect-kv on a scrolled vLLM boot log: got '$got', want 210000"
+rm -rf "$KV_STUB"
+echo "  ✓ KV pool: both engines' boot lines, read at the log head past 3000 scrolled lines"
+
+# #1537 follow-up (2): the sweep header's slots SOURCE label. The count came from
+# _detect_slots' SGLang paths while slots_src still said "undetected" (the chain
+# skipped them), and the engine map — which names the knobs in the recommendation —
+# never said sglang. Run the REAL sweep header (SWEEP_DRY: plans, boots nothing)
+# against stubs of the two SGLang sources.
+SLOTS_STUB="$(mktemp -d)"
+cat > "$SLOTS_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = inspect ] && { echo '--host 0.0.0.0 --port 30000 --max-running-requests 4 --context-length 262144'; exit 0; }
+exit 0
+DOCK
+chmod +x "$SLOTS_STUB/docker"
+out="$(PATH="$SLOTS_STUB:$PATH" URL=http://127.0.0.1:1 MODEL=x bash "$PROBE" --sweep --dry --n 1,2,4 2>&1)"
+command grep -q "slots=4 (container max-running-requests)" <<<"$out" \
+  || fail "--sweep header must label the container max-running-requests source (not 'undetected'): $(command grep -m1 'slots=' <<<"$out")"
+
+SGL_SLOT_PORT="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')"
+python3 -c '
+import json, sys
+from http.server import BaseHTTPRequestHandler, HTTPServer
+INFO = {"model_path": "/models/q", "max_running_requests": 4, "speculative_algorithm": None}
+class H(BaseHTTPRequestHandler):
+    def do_GET(self):
+        ok = self.path == "/get_server_info"
+        self.send_response(200 if ok else 404)
+        self.send_header("Content-Type", "application/json")
+        self.end_headers()
+        self.wfile.write(json.dumps(INFO if ok else {}).encode())
+    def log_message(self, *a):
+        pass
+HTTPServer(("127.0.0.1", int(sys.argv[1])), H).serve_forever()
+' "$SGL_SLOT_PORT" &
+SGL_SLOT_PID=$!
+for _ in $(seq 1 50); do curl -s -m 1 "http://127.0.0.1:$SGL_SLOT_PORT/get_server_info" >/dev/null 2>&1 && break; sleep 0.1; done
+out="$(URL=http://127.0.0.1:$SGL_SLOT_PORT MODEL=x bash "$PROBE" --sweep --dry --n 1,2,4 2>&1)"
+kill "$SGL_SLOT_PID" 2>/dev/null || true
+wait "$SGL_SLOT_PID" 2>/dev/null || true
+command grep -q "slots=4 (server /get_server_info max_running_requests)" <<<"$out" \
+  || fail "--sweep header must label the server-info max_running_requests source (not 'undetected'): $(command grep -m1 'slots=' <<<"$out")"
+
+# A 1-slot SGLang server's fix hint must name the knob its compose reads (the hint
