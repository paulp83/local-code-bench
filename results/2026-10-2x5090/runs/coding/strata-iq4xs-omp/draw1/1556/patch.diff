+command grep -q "MAX_NUM_SEQS" <<<"$rec_card" && fail "SGLang rec must NOT name MAX_NUM_SEQS (SGLang composes ignore it)"
+command grep -q "MAX_MODEL_LEN" <<<"$rec_card" && fail "SGLang rec must NOT name MAX_MODEL_LEN (SGLang composes ignore it)"
+command grep -q "SGLang:" <<<"$rec_card" || fail "same-cell SGLang rec must print the SGLang note, not the vLLM one: $rec_card"
