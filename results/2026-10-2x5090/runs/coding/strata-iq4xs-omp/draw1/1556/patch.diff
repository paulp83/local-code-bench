+  "slug": "sgl/qwen38-27b-mtp-dual",
+  "spec": "MTP n=3",
+  "gpus": "2× RTX 3090",
+  "kv_tokens": 146720,
+  "slots": 4,
+  "served_max_len": null,
+  "engine": "sglang",
+  "gen_tokens": 256,
+  "cache": "cold",
+  "command": "bash scripts/concurrency-probe.sh --sweep",
+  "rows": [
+    {"ctx": 16384, "n": 1, "strm": 80.0, "agg": 80, "ttft_s": 0.8, "vram_gb": 40.0, "clean": 1, "pass": 1, "skip": null},
+    {"ctx": 16384, "n": 2, "strm": 60.0, "agg": 120, "ttft_s": 1.2, "vram_gb": 41.0, "clean": 1, "pass": 1, "skip": null},
+    {"ctx": 16384, "n": 4, "strm": 20.0, "agg": 80,  "ttft_s": 3.0, "vram_gb": 42.0, "clean": 1, "pass": 1, "skip": null}
+  ]
+}
+JSON
+)"
+command grep -q "MAX_RUNNING_REQUESTS=2" <<<"$rec_card" || fail "SGLang rec must recommend MAX_RUNNING_REQUESTS=2, got: $rec_card"
+command grep -q "CONTEXT_LENGTH" <<<"$rec_card" || fail "SGLang rec must name CONTEXT_LENGTH for the ctx knob"
+command grep -q "MAX_RUNNING_REQUESTS=2 bash scripts/switch.sh sgl/qwen38-27b-mtp-dual" <<<"$rec_card" \
