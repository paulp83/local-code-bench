+cat > "$SLOTS_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+[ "$1" = inspect ] && { echo '--host 0.0.0.0 --max-running-requests 1 --context-length 262144'; exit 0; }
+exit 0
