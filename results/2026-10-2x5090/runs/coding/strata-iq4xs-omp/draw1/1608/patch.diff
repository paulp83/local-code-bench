+def case_is_exhaustive(blk, arr, lines):
+    """True iff every execution path leaving this case has `arr` assigned:
+    there is a `*` default arm (otherwise the selector may match nothing) and
+    every arm either assigns `arr` (arm-head or own-line form) or terminates
+    (`exit`/`exec`, arm-head or own-line form). Deliberately heuristic in the
+    SAFE direction: an exit hidden inside a nested branch of an arm is NOT
+    trusted, so such a case simply must carry an assignment instead."""
