diff --git a/scripts/tests/test-report-gpu-vram.sh b/scripts/tests/test-report-gpu-vram.sh
new file mode 100755
index 0000000..316e370
--- /dev/null
+++ b/scripts/tests/test-report-gpu-vram.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+# test-report-gpu-vram — gpu_vram_report_lines attributes each GPU's VRAM to
+# the process that actually holds it (#1537).
+#
+# WHY THIS EXISTS
+# ---------------
+# report.sh's "Display / desktop state" found ONE running club container and
+# credited it with EVERY card above 100 MiB. #1537's report said GPUs 0 and 2
+# were "held by running sglang-cmp170hx" while nvidia-smi showed another
+# container's VLLM::Worker_TP0/1 on them. This guard runs the real function
+# against a stub nvidia-smi + docker + fake /proc and asserts the attribution
+# lines.
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+fail=0
+ok()  { echo "  ✓ $*"; }
+bad() { echo "  ✗ $*" >&2; fail=1; }
+
+T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
+
+# full 64-hex container ids + their names
+IDA="$(printf 'a%.0s' $(seq 64))"   # other-vllm
+IDB="$(printf 'b%.0s' $(seq 64))"   # ours
+
+# stub docker: ps -> id/name table; exec ours -> the container's OWN view (GPU 1)
+mkdir -p "$T/bin"
+cat > "$T/bin/docker" <<EOF
+#!/usr/bin/env bash
+case "\$1" in
+  ps)   echo "$IDA other-vllm"; echo "$IDB ours" ;;
+  exec) echo "GPU-uuid-1" ;;
+  *)    exit 0 ;;
+esac
+EOF
+chmod +x "$T/bin/docker"
+
+# stub nvidia-smi:
+#   gpu 0/2: 22xxx MiB held by other-vllm (pids 1001/1003)
+#   gpu 1  : 21000 MiB held by ours (pid 2002)
+#   gpu 3  : 3 MiB idle
+#   gpu 4  : 5000 MiB held by host Xorg (pid 4242, outside any container)
+# APPS_MODE=none -> the host lists no compute processes at all.
+cat > "$T/bin/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+for a in "$@"; do
+  case "$a" in
+    --query-gpu=*)
+      echo "0, GPU-uuid-0, 22000"; echo "1, GPU-uuid-1, 21000"
+      echo "2, GPU-uuid-2, 23000"; echo "3, GPU-uuid-3, 3"; echo "4, GPU-uuid-4, 5000" ;;
+    --query-compute-apps=*)
+      [ "${APPS_MODE:-}" = none ] && exit 0
+      echo "GPU-uuid-0, 1001, VLLM::Worker_TP0"
+      echo "GPU-uuid-1, 2002, sglang::scheduler"
+      echo "GPU-uuid-2, 1003, VLLM::Worker_TP1"
+      echo "GPU-uuid-4, 4242, Xorg" ;;
+  esac
+done
+EOF
+chmod +x "$T/bin/nvidia-smi"
+
+# fake proc root: pids 1001/1003 -> other-vllm's scope, 2002 -> ours,
+# 4242 -> host systemd scope (no docker-<id>.scope anywhere).
+mkdir -p "$T/proc"/{1001,1003,2002,4242}
+printf '0::/system.slice/docker-%s.scope\n' "$IDA" > "$T/proc/1001/cgroup"
+printf '0::/system.slice/docker-%s.scope\n' "$IDA" > "$T/proc/1003/cgroup"
+printf '0::/system.slice/docker-%s.scope\n' "$IDB" > "$T/proc/2002/cgroup"
+
+# run <ours> [APPS_MODE] -> the function's lines
+run() {
+  PATH="$T/bin:$PATH" GPU_ATTR_PROC="$T/proc" APPS_MODE="${2:-}" bash -c \
+    '. "$1/scripts/lib/gpu-select.sh"; gpu_vram_report_lines "$2"' _ "$ROOT" "$1"
+}
+
+# line <n> — the emitted line for GPU <n>
+line() { run "${3:-}" "${4:-}" | command grep "GPU $1 idle VRAM"; }
+
+has()  { [[ "$2" == *"$1"* ]] && ok "$1" || bad "missing [$1] in: $2"; }
+hasnt(){ [[ "$2" != *"$1"* ]] && ok "no [$1]" || bad "unexpected [$1] in: $2"; }
+
+# --- ours set: every card attributed to its real holder --------------------
+out="$(run ours)"
+l0="$(command grep 'GPU 0 idle VRAM' <<<"$out")"
+has 'held by `other-vllm`' "$l0"; has "not \`ours\`" "$l0"
+l1="$(command grep 'GPU 1 idle VRAM' <<<"$out")"
+has 'held by running `ours`' "$l1"; hasnt 'other-vllm' "$l1"
+l2="$(command grep 'GPU 2 idle VRAM' <<<"$out")"
+has 'held by `other-vllm`' "$l2"; has "not \`ours\`" "$l2"
+has '3 MiB ✓' "$(command grep 'GPU 3 idle VRAM' <<<"$out")"
+l4="$(command grep 'GPU 4 idle VRAM' <<<"$out")"
+has 'held by `Xorg`' "$l4"; hasnt 'docker-' "$l4"
+[[ "$(command grep -c 'idle VRAM' <<<"$out")" == 5 ]] \
+  && ok "one line per GPU" || bad "expected 5 lines: $out"
+
+# --- ours unset: attribution still runs, no `not` clause --------------------
+out="$(run '')"
+l0="$(command grep 'GPU 0 idle VRAM' <<<"$out")"
+has 'held by `other-vllm`' "$l0"; hasnt 'not ' "$l0"
+has 'held by `ours`' "$(command grep 'GPU 1 idle VRAM' <<<"$out")"
+
+# --- host lists NO compute processes: place ours from the container view ----
+out="$(run ours none)"
+l1="$(command grep 'GPU 1 idle VRAM' <<<"$out")"
+has 'held by running `ours`' "$l1"
+l0="$(command grep 'GPU 0 idle VRAM' <<<"$out")"
+has '⚠ something is using this GPU' "$l0"; has "not \`ours\`" "$l0"
+has '3 MiB ✓' "$(command grep 'GPU 3 idle VRAM' <<<"$out")"
+
+# host view empty AND no ours -> plain warning, no stray backtick clause
+out="$(run '' none)"
+l0="$(command grep 'GPU 0 idle VRAM' <<<"$out")"
+has '⚠ something is using this GPU' "$l0"; hasnt '`' "$l0"
+
+# --- report.sh calls the shared helper instead of its own loop --------------
+command grep -q 'gpu_vram_report_lines "$our_container"' scripts/report.sh \
+  && ok "report.sh calls gpu_vram_report_lines" \
+  || bad "report.sh does not call gpu_vram_report_lines"
+command grep -q 'scripts/lib/gpu-select.sh' scripts/report.sh \
+  && ok "report.sh sources gpu-select.sh" \
+  || bad "report.sh does not source gpu-select.sh"
+
+[[ $fail -eq 0 ]] && echo "PASS: test-report-gpu-vram (#1537)"
+exit $fail
