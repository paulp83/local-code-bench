diff --git a/scripts/lib/gpu-select.sh b/scripts/lib/gpu-select.sh
index ed69318..9830a18 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,108 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# gpu_vram_report_lines ["<our_container>"]
+#   The per-GPU "idle VRAM" lines of scripts/report.sh (#1537): attribute the
+#   used memory on each card to the PROCESS that actually holds it, instead of
+#   crediting every busy card to whatever club container happened to run. A
+#   pid becomes a container name through <proc>/<pid>/cgroup (the docker
+#   systemd scope `…/docker-<id>.scope`; proc root from $GPU_ATTR_PROC,
+#   default /proc) + docker ps (id -> name). When the host nvidia-smi lists
+#   NO compute processes, OURS is placed from the container's own view
+#   (docker exec … nvidia-smi, gpu_select_container_uuids). OUR_CONTAINER
+#   may be empty. Line endings callers/tests key on:
+#     (held by running `<ours>`)          - ours, attributed
+#     (held by `<other>`, not `<ours>`)   - another container holds it
+#     (held by `<process_name>`)          - a process outside any container
+#     ⚠ something is using this GPU … not `<ours>` - used, no owner found
+#     <N> MiB ✓                           - idle (<= 100 MiB)
+gpu_vram_report_lines() {
+  local our_container="${1:-}"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  local -A vram_index=() vram_used=() vram_owner=() vram_is_container=()
+  local vram_uuids=()
+  local idx uuid used
+  while IFS=, read -r idx uuid used; do
+    idx="${idx//[[:space:]]/}"; uuid="${uuid//[[:space:]]/}"; used="${used//[[:space:]]/}"
+    [[ -n "$idx" && -n "$uuid" ]] || continue
+    vram_index["$uuid"]="$idx"
+    vram_used["$uuid"]="$used"
+    vram_uuids+=("$uuid")
+  done < <(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null)
+  [[ ${#vram_uuids[@]} -gt 0 ]] || return 0
+
+  # id -> name for running containers; fetched once, only when the host lists
+  # any compute processes at all.
+  local apps docker_names=""
+  apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)"
+  if [[ -n "$apps" ]] && command -v docker >/dev/null 2>&1; then
+    docker_names="$(docker ps --no-trunc --format '{{.ID}} {{.Names}}' 2>/dev/null)"
+  fi
+
+  # First compute process seen on each GPU attributes it. A container-scope
+  # pid labels with the container NAME (so "ours" can be recognised); anything
+  # else falls back to the process name as printed by nvidia-smi.
+  local saw_apps=0 app_uuid app_pid app_name cid match d_id d_name label
+  while IFS=, read -r app_uuid app_pid app_name; do
+    app_uuid="${app_uuid//[[:space:]]/}"
+    [[ "$app_uuid" == GPU-* ]] || continue
+    saw_apps=1
+    [[ -n "${vram_owner[$app_uuid]:-}" ]] && continue
+    app_pid="${app_pid//[[:space:]]/}"
+    app_name="${app_name#"${app_name%%[![:space:]]*}"}"   # trim leading space
+    cid=""
+    if [[ "$app_pid" =~ ^[0-9]+$ ]]; then
+      # cgroup v2: …/docker-<id>.scope   cgroup v1: …/docker/<id>
+      match="$(command grep -oEm1 'docker[-/][0-9a-f]{12,64}' "$proc_root/$app_pid/cgroup" 2>/dev/null)"
+      match="${match#docker-}"; match="${match#docker/}"
+      cid="$match"
+    fi
+    if [[ -n "$cid" ]]; then
+      d_name=""
+      while read -r d_id d_name; do
+        [[ -n "$d_id" ]] || continue
+        case "$cid" in "$d_id"*) break ;; esac
+      done <<< "$docker_names"
+      [[ -n "$d_name" ]] || d_name="container ${cid:0:12}"
+      vram_owner["$app_uuid"]="$d_name"
+      vram_is_container["$app_uuid"]=1
+    else
+      vram_owner["$app_uuid"]="$app_name"
+    fi
+  done <<< "$apps"
+
+  # No host compute processes at all (some runtimes hide other tenants from
+  # the host view): place OURS at least, from the container's own nvidia-smi.
+  # Everything else stays ownerless -> the ⚠ line below.
+  if [[ $saw_apps -eq 0 && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    local ours_uuids u
+    ours_uuids="$(gpu_select_container_uuids "$our_container")"
+    local -a _ours_split=()
+    read -ra _ours_split <<< "${ours_uuids//,/ }"
+    for u in "${_ours_split[@]}"; do
+      [[ "$u" == GPU-* ]] || continue
+      vram_owner["$u"]="$our_container"
+      vram_is_container["$u"]=1
+    done
+  fi
+
+  for uuid in "${vram_uuids[@]}"; do
+    idx="${vram_index[$uuid]}"; used="${vram_used[$uuid]}"
+    if ! [[ "$used" =~ ^[0-9]+$ ]] || [[ "$used" -le 100 ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+    elif [[ -n "${vram_owner[$uuid]:-}" && -n "${vram_is_container[$uuid]:-}" && "$our_container" == "${vram_owner[$uuid]}" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${our_container}\`)"
+    elif [[ -n "${vram_is_container[$uuid]:-}" && -n "$our_container" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${vram_owner[$uuid]}\`, not \`${our_container}\`)"
+    elif [[ -n "${vram_owner[$uuid]:-}" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB (held by \`${vram_owner[$uuid]}\`)"
+    elif [[ -n "$our_container" ]]; then
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container; not \`${our_container}\`)"
+    else
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container)"
+    fi
+  done
+}
