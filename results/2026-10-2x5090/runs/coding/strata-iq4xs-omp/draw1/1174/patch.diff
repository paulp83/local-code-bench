diff --git a/scripts/tests/test-pull-download-ladder.sh b/scripts/tests/test-pull-download-ladder.sh
index f44df1d..26758b7 100755
--- a/scripts/tests/test-pull-download-ladder.sh
+++ b/scripts/tests/test-pull-download-ladder.sh
@@ -491,6 +491,89 @@ with tempfile.TemporaryDirectory() as td:
 check(callable(getattr(HF, "_main", None)) and callable(getattr(HF, "fetch", None)),
       "hf_fetch exposes a standalone fetch() + a CLI entry point")
 
+# ---------------------------------------------------------------------------
+# 14. a MISSING `hf` binary (rc=127) is fallback-ELIGIBLE, not a silent exit
+#     1: fetch() escalates to rung 3 (no `hf` dependency), rung 2 is skipped
+#     with its reason (it IS the same hf call), and the CLI prints the
+#     failure token + detail on a real failure (the #804/#812 auditable-log
+#     contract, asserted at the exit path where it was silently violated).
+# ---------------------------------------------------------------------------
+MISSING_HF = "neither `hf` nor `huggingface-cli` is on PATH"
+
+with tempfile.TemporaryDirectory() as td:
+    log = Log()
+    _orig_tree = HF.repo_tree
+    _orig_dl = HF._hf_download
+    _orig_watch = HF._run_with_stall_watchdog
+    _orig_curl = HF._curl_bin
+    HF.repo_tree = lambda *a, **k: TREE
+    HF._hf_download = lambda *a, **k: (127, MISSING_HF)
+    HF._curl_bin = lambda: "/usr/bin/curl"   # existence, never executed
+
+    def _watch(argv, watch, **k):
+        Path(watch).parent.mkdir(parents=True, exist_ok=True)
+        Path(watch).write_bytes(BODY)
+        return 0
+
+    HF._run_with_stall_watchdog = _watch
+    try:
+        # allow_xet=True on purpose: rung 2 must still be skipped, because
+        # it re-runs the SAME missing `hf download`.
+        res = HF.fetch("org/Big", Path(td), [BIG], allow_xet=True,
+                       token=None, log=log)
+    finally:
+        HF.repo_tree = _orig_tree
+        HF._hf_download = _orig_dl
+        HF._run_with_stall_watchdog = _orig_watch
+        HF._curl_bin = _orig_curl
+    check(res.ok and res.rung == "raw-resolve",
+          f"missing hf CLI (rc=127) escalates to rung 3 — stdlib-only hosts "
+          f"get the pull, not a bare exit 1 "
+          f"(ok={res.ok} rung={res.rung!r} failure={res.failure!r})")
+    check("UNAVAILABLE" in log.text() and "rung 3" in log.text(),
+          "the tool-missing failure is ANNOUNCED, naming rung 3 as the "
+          "continuation")
+    check("rung 2 (Xet) SKIPPED" in log.text() and "hf CLI" in log.text(),
+          "rung 2 is skipped WITH ITS REASON even when opted in — it needs "
+          "the same missing hf CLI")
+    check(res.verified == [BIG],
+          "the hf-free fallback artifact still passes the mandatory sha256 "
+          "gate")
+
+# ---------------------------------------------------------------------------
+# 15. the CLI never exits 1 on bare silence: the failure token + detail go
+#     to stderr (stdout stays a clean --json contract).
+# ---------------------------------------------------------------------------
+with tempfile.TemporaryDirectory() as td:
+    _orig_fetch = HF.fetch
+    HF.fetch = lambda *a, **k: HF.LadderResult(
+        ok=False, failure="fallback-failed",
+        detail="rung 1 failed (rc=1): boom")
+    err = io.StringIO()
+    _orig_stderr = sys.stderr
+    try:
+        sys.stderr = err
+        rc = HF._main(["org/Big", "--local-dir", td])
+    finally:
+        sys.stderr = _orig_stderr
+        HF.fetch = _orig_fetch
+    check(rc == 1, "a failing fetch still exits 1")
+    out = err.getvalue()
+    check("fallback-failed" in out and "rung 1 failed" in out,
+          f"the failing CLI run prints the failure TOKEN + DETAIL to stderr "
+          f"— no diagnostics-free exit (got {out!r})")
+
+    HF.fetch = lambda *a, **k: HF.LadderResult(ok=True, rung="classic")
+    err2 = io.StringIO()
+    try:
+        sys.stderr = err2
+        rc = HF._main(["org/Big", "--local-dir", td])
+    finally:
+        sys.stderr = _orig_stderr
+        HF.fetch = _orig_fetch
+    check(rc == 0 and err2.getvalue() == "",
+          "a succeeding run stays silent on stderr")
+
 if failures:
     print(f"\n{len(failures)} assertion(s) failed.", file=sys.stderr)
     sys.exit(1)
