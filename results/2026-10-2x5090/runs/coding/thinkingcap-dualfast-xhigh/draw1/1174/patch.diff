+def is_tool_unavailable(rc: int, blob: str) -> bool:
+    """True iff a rung-1 failure means the `hf` CLI is ABSENT from this host
+    (command-not-found, rc=127), NOT that a download failed.
+
+    Such a failure is fallback-eligible: rung 3 (raw resolve + curl) has no
+    dependency on `hf` at all, so a curl-only rig must still be able to pull
+    instead of dying at the very first rung. Matches on the rc, and on the
+    merged output for runners that surface it differently — never on a bare
+    "not found", so an unrelated missing file mid-download cannot false-
+    trigger an escalation (the same false-positive discipline as
+    `is_xet_refusal`)."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    return ("command not found" in low
+            or "neither `hf` nor `huggingface-cli` is on path" in low)
+
