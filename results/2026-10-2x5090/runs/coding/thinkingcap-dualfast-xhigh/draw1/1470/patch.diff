diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..bca0923 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,49 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ── SGLang V1 custom all-reduce (PCIe rigs) ──────────────────────────────────
+# SGLang admits CustomAllReduceV2 only on full NVLink, so every PCIe rig runs
+# the V1 kernel — which is SILENT at init. Its only success signal is the
+# "Registering N cuda graph addresses" line after CUDA-graph capture (rank 0,
+# plus one per rank). Before this fix such a boot scored "unknown" (no P2P
+# engagement signal) and could never score on.
+_v1=$(cat <<'EOF'
+[2026-09-28 11:04:02] server_args={'tp_size': 4, 'disable_custom_all_reduce': False}
+[2026-09-28 11:04:31 TP0] sglang is using nccl==2.30.7
+[2026-09-28 11:04:58 TP0] Capture cuda graph begin. This can take up to several minutes.
+[2026-09-28 11:05:41 TP0] Registering 4352 cuda graph addresses. This can take up to several minutes to increase the performance of custom allreduce operations. No need to worry if it takes long. Example time: 1.5 minutes for 1000 graphs.
+[2026-09-28 11:05:44 TP1] Registering 258 cuda graph addresses. This can take up to several minutes to increase the performance of custom allreduce operations. No need to worry if it takes long. Example time: 1.5 minutes for 1000 graphs.
+[2026-09-28 11:05:45 TP0] Capture cuda graph end.
+EOF
+)
+_ev="$(printf '%s
+' "$_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev" "Registering 4352 cuda graph addresses"
+r="$(printf '%s
+' "$_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph registration -> on (got $r)"
+# unfiltered stream too (the classifier must not depend on the pre-filter)
+r="$(printf '%s
+' "$_v1" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 registration -> on (got $r)"
+# capture lines alone are not a success signal
+r="$(printf '%s
+' "[sglang] BOOT disable_custom_all_reduce=False" 'TP0] Capture cuda graph begin. This can take up to several minutes.' 'TP0] Capture cuda graph end.' | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "cuda-graph capture lines without registration must stay unknown (got $r)"
+# an operator-disabled restart must not be upgraded by an earlier boot's success
+r="$(printf '%s
+' "$_ev" "[sglang] BOOT disable_custom_all_reduce=True" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "latest SGLang operator-disabled boot must win over an earlier V1 success (got $r)"
+# a setup failure in the CURRENT boot outranks the success line
+r="$(printf '%s
+' "[sglang] BOOT disable_custom_all_reduce=False" 'TP0] Registering 4352 cuda graph addresses.' 'TP0] Setup Custom allreduce failed with boom. To silence this warning, specify --disable-custom-all-reduce explicitly.' | p2p_engine_log_evidence | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_failed" ]] || fail "V1 setup failure must outrank the success line (got $r)"
+out="$(p2p_verdict 2 pcie_p2p on)"
+assert_contains "$out" "PCIe P2P engaged"
+assert_contains "$out" "custom all-reduce ON"
+unset _v1 _ev
+echo "  ✓ SGLang V1 custom all-reduce (PCIe rigs): graph registration scores on, capture lines stay unknown, epochs + vetoes preserved"
+
