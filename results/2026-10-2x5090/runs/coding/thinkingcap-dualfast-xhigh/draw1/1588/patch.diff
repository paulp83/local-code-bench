+
+# url_is_local URL — exit 0 when the URL's host is an address of THIS host: a
+# loopback, any address `hostname -I` reports (LAN IPs, the Docker bridge), or
+# a hostname that resolves to one. 1 for another machine or an unresolvable
+# name: such a run has no local container to bind, so a port-only match or a
+# name guess would report a local server's facts for someone else's run.
+url_is_local() {
+  local url="$1" host port addrs a own
+  read -r host port < <(url_host_port "$url")
+  [[ -n "$host" ]] || return 1
+  own=" $(hostname -I 2>/dev/null) "
+  addrs="$(_host_addrs "$host")"
+  [[ -n "$addrs" ]] || return 1
+  while IFS= read -r a; do
+    [[ -n "$a" ]] || continue
+    if [[ "$a" == 127.* || "$a" == "::1" || "$a" == "::" || "$own" == *" ${a} "* ]]; then
+      return 0
+    fi
+  done <<<"$addrs"
+  return 1
+}
