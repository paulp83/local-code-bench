+def _local_host_addrs():
+    """Addresses of THIS host: the loopbacks plus every address ``hostname -I``
+    reports (LAN IPs, the Docker bridge) plus what the local hostname resolves to.
+    A URL on one of these is a URL on this box; on any other address it is a URL
+    on another machine, which shares no container with us."""
+    addrs = {"127.0.0.1", "::1"}
+    try:
+        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True,
+                             encoding="utf-8", errors="replace", timeout=5)
+        addrs.update((out.stdout or "").split())
+    except Exception:
+        pass
+    try:
+        for _fam, _type, _proto, _canon, sockaddr in socket.getaddrinfo(socket.gethostname(), None):
+            addrs.add(sockaddr[0])
+    except Exception:
+        pass
+    return addrs
+
+
+def _url_host_addrs(host):
+    """The addresses a URL host names: a literal is itself, a hostname is what
+    ``getent ahosts`` (then the resolver) says it is. ``localhost`` names both
+    loopbacks. Empty when the name resolves to nothing."""
+    if not host:
+        return set()
+    if host in ("localhost", "0.0.0.0"):
+        return {"127.0.0.1", "::1"}
+    if re.fullmatch(r"[0-9.]+", host):                    # IPv4 literal
+        return {host}
+    if ":" in host and re.fullmatch(r"[0-9a-fA-F:]+", host):  # IPv6 literal
+        return {host}
+    addrs = set()
+    try:
+        out = subprocess.run(["getent", "ahosts", host], capture_output=True, text=True,
+                             encoding="utf-8", errors="replace", timeout=5)
+        addrs = {ln.split()[0] for ln in (out.stdout or "").splitlines() if ln.split()}
+    except Exception:
+        pass
+    if not addrs:
+        try:
+            addrs = {s[4][0] for s in socket.getaddrinfo(host, None)}
+        except Exception:
+            addrs = set()
+    return addrs
+
+
+def _url_host_is_local(host):
+    """True when a URL host names THIS machine: any loopback (127.x / ::1), any
+    address ``hostname -I`` reports (LAN IPs, the Docker bridge), or a name that
+    resolves to one of these. False for another machine or an unresolvable name."""
+    addrs = _url_host_addrs(host)
+    if not addrs:
+        return False
+    own = _local_host_addrs()
+    for a in addrs:
+        if a in own or a.startswith("127.") or a.startswith("::ffff:127.") or a == "::1":
+            return True
+    return False
+
