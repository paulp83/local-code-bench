+    two-card container scopes to a GPU that does not exist ("2,3" matches no
+    nvidia-smi index or UUID) and every VRAM figure falls back to rig-wide
+    (#1537)."""
+    out = []
+    for s in selectors:
+        for part in str(s).split(","):
+            part = part.strip()
+            if part:
+                out.append(part)
+    return out
