+# ── which container the numbers cover, and what drafter it runs (#1537) ──────
+# The card names its subject: the container serving $URL (a name heuristic like
+# vllm-(qwen|gemma) never found an SGLang container, so the card scoped VRAM to
+# every GPU on the host), and the drafter that engine is ACTUALLY running (the
+# Qwen3.8 vLLM composes build --speculative-config inside their entrypoint from
+# SPEC_N, so it never appears in the container Cmd and a Cmd grep said "spec
+# off" while MTP n=4 ran).
+def container_for_url(url):
+    """The running container that publishes `url`'s port (from `docker ps`,
+    any engine), or '' when no running container does.
+
+    The published PORT is what identifies the server the probe points at — not
+    a name pattern: a `vllm-(qwen|gemma)` heuristic never found an SGLang
+    container, and it could name a container that serves no $URL at all, which
+    is how the card scoped VRAM to the wrong GPUs (#1537)."""
+    try:
+        parts = urllib.parse.urlsplit(str(url or ""))
+        port = parts.port
+        if port is None:
+            port = 443 if parts.scheme == "https" else 80
+        if not port:
+            return ""
+    except (ValueError, TypeError):
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=10,
+        )
+    except Exception:
+        return ""
+    for line in (out.stdout or "").splitlines():
+        name, sep, ports = line.partition("\t")
+        if not sep or not ports.strip():
+            continue
+        # published mappings look like `0.0.0.0:8020->8000/tcp` (plus a
+        # `[::]:8020->8000/tcp` sibling); an unpinned port has no host side.
+        for mapping in ports.split(","):
+            host, arrow, _ = mapping.strip().partition("->")
+            if not arrow:
+                continue
+            if host.rsplit(":", 1)[-1] == str(port):
+                return name.strip()
+    return ""
+
+
+# The engine's boot config sits at the HEAD of its log, and `docker logs` has
+# no --head (it streams from the start). Read a bounded prefix and stop —
+# exactly the pattern resolved_config.py uses for the same dumps. The tail of
+# a long-lived engine is request noise, which is how a `--tail` read once
+# answered "spec off" while MTP was running.
+_LOG_HEAD_BYTES = 8 * 1024 * 1024
+
+
+def _log_head(container, max_bytes=_LOG_HEAD_BYTES):
+    """At most `max_bytes` from the head of the container's log ('' when the
+    log or docker itself is unreadable)."""
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.STDOUT,
+        )
+    except (FileNotFoundError, OSError):
+        return ""
+    chunks, total = [], 0
+    try:
+        while total < max_bytes:
+            chunk = proc.stdout.read(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            total += len(chunk)
+    finally:
+        try:
+            proc.stdout.close()
+        except OSError:
+            pass
+        if proc.poll() is None:
+            proc.kill()
+        proc.wait()
+    return b"".join(chunks).decode("utf-8", "replace")
+
+
+# How a drafter method is written on a card, across the two engines' spellings.
+_SPEC_METHOD_NAMES = {
+    "mtp": "MTP",
+    "eagle": "EAGLE",
+    "eagle3": "EAGLE3",
+    "dflash": "DFlash",
+    "dflash2": "DFlash2",
+    "ngram": "ngram",
+}
+
+
+def vllm_spec_label(container):
+    """The drafter label from a vLLM container's boot log, or None when the
+    engine's `Initializing a V1 LLM engine ... with config:` line is not in
+    the readable head of the log.
+
+    `speculative_config=None` prints `spec off`;
+    `SpeculativeConfig(method='mtp', ..., num_spec_tokens=4)` prints
+    `MTP n=4`. The flag is read from the LOG, not the container Cmd: the
+    Qwen3.8 vLLM composes build `--speculative-config` inside their entrypoint
+    from SPEC_N, so it never appears in `.Config.Cmd` and a Cmd grep said
+    "spec off" with MTP n=4 running (#1537)."""
+    if not container:
+        return None
+    txt = _log_head(container)
+    if not txt:
+        return None
+    for line in txt.splitlines():
+        if "speculative_config=" not in line or "Initializing" not in line:
+            continue
+        rest = line.split("speculative_config=", 1)[1].strip()
+        if rest.startswith("None"):
+            return "spec off"
+        m = re.search(r"method[\"']?\s*[:=]\s*[\"']?([A-Za-z0-9_]+)", rest)
+        method = m.group(1).lower() if m else ""
+        n = None
+        tm = re.search(
+            r"num_spec(?:ulative)?_tokens[\"']?\s*[:=]\s*[\"']?(\d+)", rest
+        )
+        if tm:
+            n = int(tm.group(1))
+        name = _SPEC_METHOD_NAMES.get(method, method.upper() if method else "spec")
+        if n and method != "ngram":
+            return f"{name} n={n}"
+        return name
+    return None
+
+
+def sgl_spec_label(url):
+    """The drafter label from `GET $URL/get_server_info` (SGLang), or None
+    when the endpoint is not readable (a vLLM server 404s it, a dead port
+    times out).
+
+    Read from `speculative_algorithm` + `speculative_num_steps`. EAGLE whose
+    draft path is the target's OWN checkpoint is the in-checkpoint MTP head —
+    SGLang's spelling of vLLM's `method='mtp'` — so it prints
+    `MTP n=<steps>` (#1537)."""
+    if not url:
+        return None
+    try:
+        with urllib.request.urlopen(
+            str(url).rstrip("/") + "/get_server_info", timeout=5
+        ) as resp:
+            info = json.load(resp)
+    except Exception:
+        return None
+    if not isinstance(info, dict):
+        return None
+
+    def field(key):
+        if info.get(key) is not None:
+            return info[key]
+        nested = info.get("server_args")
+        if isinstance(nested, dict):
+            return nested.get(key)
+        return None
+
+    algo = field("speculative_algorithm")
+    if algo is None or str(algo).strip().lower() in ("", "none", "null"):
+        return "spec off"
+    algo = str(algo).strip().upper()
+
+    def as_int(key):
+        v = field(key)
+        try:
+            return int(v) if v is not None else None
+        except (TypeError, ValueError):
+            return None
+
+    n = as_int("speculative_num_steps")
+    model = str(field("model_path") or "").rstrip("/")
+    draft = str(field("speculative_draft_model_path") or "").rstrip("/")
+    if algo in ("EAGLE", "EAGLE3"):
+        base = "MTP" if (model and draft == model) else algo
+        return f"{base} n={n}" if n else base
+    if algo == "DFLASH":
+        d = as_int("speculative_num_draft_tokens") or as_int(
+            "speculative_dflash_block_size"
+        )
+        return f"DFlash n={d}" if d else "DFlash"
+    if algo == "NGRAM":
+        return "ngram"
+    return algo
+
+
+def spec_label(container=None, url=None):
+    """The speculative-decoding label read from the ENGINE, or None when
+    neither source is readable (the card then shows "spec ?").
+
+    vLLM: the `Initializing a V1 LLM engine ... with config: ...
+    speculative_config=...` line at the HEAD of `docker logs $CONTAINER`.
+    SGLang: `GET $URL/get_server_info`. The container's Cmd is NOT a source:
+    the drafter flags are built inside the entrypoint (SPEC_N contract), so a
+    Cmd grep mislabels every entrypoint-driven compose (#1537)."""
+    container = container if container is not None else _env("CONTAINER")
+    url = url if url is not None else _env("URL")
+    label = vllm_spec_label(container) if container else None
+    if not label and url:
+        label = sgl_spec_label(url)
+    return label
+
