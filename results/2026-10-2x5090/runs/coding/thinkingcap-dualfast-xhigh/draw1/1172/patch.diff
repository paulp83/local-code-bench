+    """Collect MiB values per CUDA device from boot-log lines.
+
+    ``pat`` is one pattern or a list of them; each must capture (device, value)
+    as groups 1 and 2. With agg=False the last match per device wins; with
+    agg=True every match sums -- a pinned drafter emits the same line shapes as
+    the target, and on the same device both buffers are real.
+    """
     out = {}
-    for m in re.finditer(pat, text):
-        dev, val = m.group(1), float(m.group(2))
