+    for p in (pat if isinstance(pat, (list, tuple)) else (pat,)):
+        for m in re.finditer(p, text):
+            dev, val = m.group(1), float(m.group(2))
+            out[dev] = out.get(dev, 0.0) + val if agg else val
     return out
 
 
