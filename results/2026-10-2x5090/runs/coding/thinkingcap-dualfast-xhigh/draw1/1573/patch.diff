       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv is silent. That is NOT positive evidence of absence: an
+          # image that starts vLLM through its own launcher adds
+          # --reasoning-parser INSIDE that script, so the argv shows none
+          # while the running server carries the parser — the case the
+          # pre-fix check refused un-bypassably. vLLM dumps the args it
+          # actually started with in its boot log; read that.
+          log_facts="$(_thinking_budget_vllm_log_facts "$c")"
+          case "$log_facts" in
+            "LOG PARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c} argv carries no --reasoning-parser (the image's own launcher adds it), but its vLLM boot log shows 'reasoning_parser': '${log_facts#LOG PARSER }' in the non-default args — the server HAS the parser; verified"
+              return 0 ;;
+            "LOG NONE")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — the argv is silent and the vLLM boot log's non-default args carry no reasoning_parser, so vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError) and every scenario would fail"
+              return 1 ;;
+            *)
+              # The log was unreadable or carried no parseable dump: no
+              # evidence either way — an overridable (loudly labelled)
+              # refusal, not a positive one.
+              THINKING_BUDGET_EVIDENCE="container ${c} argv carries no --reasoning-parser and its vLLM boot log is unreadable or carries no parseable non-default args dump — whether the server has a reasoning parser cannot be confirmed"
+              return 2 ;;
+          esac
+          ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
