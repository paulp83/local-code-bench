+# vLLM's OWN readback of the args it started with: its boot log dumps
+# `non-default args: {'reasoning_parser': 'qwen3', ...}` (v0.29.0). An image
+# that starts vLLM through its own launcher adds --reasoning-parser inside
+# that script, so the container argv (docker inspect) shows a bare launcher
+# while the running server carries the parser — the log, not the argv, is
+# the resolved truth, and the argv's silence is NOT evidence of absence.
+# stdout, one line:
+#   LOG PARSER <v>   the last parseable non-default args dump (or a plain
+#                    reasoning_parser hit) carries the parser — the server has it
+#   LOG NONE         a parseable non-default args dump exists and the LAST one
+#                    (the running boot) has no reasoning_parser — positive
+#                    evidence of absence
+#   LOG UNKNOWN      the log was read but carries no parseable dump — no
+#                    evidence either way
+#   LOG UNREADABLE   `docker logs` failed or printed nothing
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import ast, re, sys
+
+text = sys.stdin.read()
+
+def dict_at(i):
+    # The balanced-brace dict literal starting after position i, on the same
+    # line — quote-aware, or None. The dump is a Python literal repr, so
+    # ast.literal_eval (never eval) is the exact parser; a JSON-shaped dump
+    # with `null`/`true`/`false` values fails it and falls back to the key
+    # scan below.
+    start = text.find("{", i)
+    if start < 0 or "\n" in text[i:start]:
+        return None
+    depth, quote, esc = 0, "", False
+    for j in range(start, len(text)):
+        ch = text[j]
+        if quote:
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == quote:
+                quote = ""
+            continue
+        if ch in "'\"":
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                try:
+                    v = ast.literal_eval(text[start:j + 1])
+                except (ValueError, SyntaxError):
+                    return None
+                return v if isinstance(v, dict) else None
+    return None
+
+# A restarted container carries every boot's dump; the RUNNING server is the
+# last one, so the last parseable non-default args dump wins.
+last = None
+for m in re.finditer(r"non-default args:\s*", text):
+    d = dict_at(m.end())
+    if d is not None:
+        last = d
+if last is not None:
+    rp = last.get("reasoning_parser")
+    if rp is not None and str(rp) not in ("", "None", "null"):
+        print("LOG PARSER %s" % rp)
+        sys.exit(0)
+    print("LOG NONE")
+    sys.exit(0)
+# No parseable dump: a plain key hit is still evidence of PRESENCE (a dump
+# the literal parser rejected) — but NOT of absence, since the engine may
+# not print that line at all (or the log is a partial tail). Absence needs a
+# parseable dump that lacks the key.
+m = re.search(r"[\"']?reasoning_parser[\"']?\s*[:=]\s*[\"']([A-Za-z0-9_.\-]+)", text)
+if m and m.group(1).lower() not in ("none", "null"):
+    print("LOG PARSER %s" % m.group(1))
+else:
+    print("LOG UNKNOWN")
+PY
+)"
+_thinking_budget_vllm_log_facts() {
+  local c="$1" log
+  log="$(docker logs "$c" 2>/dev/null)" || { echo "LOG UNREADABLE"; return 0; }
+  [[ -n "$log" ]] || { echo "LOG UNREADABLE"; return 0; }
+  python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY" <<<"$log" 2>/dev/null || echo "LOG UNKNOWN"
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,8 +422,28 @@ thinking_budget_verify() {
