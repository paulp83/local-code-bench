+# Host GPU selectors (indices or UUIDs, comma-separated) behind $CONTAINER — the
+# SAME resolution as container_gpu_ids() in the lib: compose devices: ->
+# HostConfig.DeviceRequests[].DeviceIDs first, then the NVIDIA_VISIBLE_DEVICES
+# env. Empty = unresolvable / "all": callers then fall back to the WHOLE RIG and
+# say so, because rig-wide figures include other services' cards (a container
+# pinned to one RTX 3060 used to read "4× RTX 3090" + 55 GB of a 4-card rig).
+_container_gpus() {
+  [[ -n "${CONTAINER:-}" ]] || { echo ""; return 0; }
+  command -v docker >/dev/null 2>&1 || { echo ""; return 0; }
+  command -v python3 >/dev/null 2>&1 || { echo ""; return 0; }
+  docker inspect "$CONTAINER" 2>/dev/null | python3 -c '
+import json, sys
+try:
+    blob = json.load(sys.stdin)
+except Exception:
+    raise SystemExit(0)
+if isinstance(blob, list):
+    blob = blob[0] if blob else {}
+if not isinstance(blob, dict):
+    raise SystemExit(0)
+base = None
+for req in (blob.get("HostConfig") or {}).get("DeviceRequests") or []:
+    if req.get("DeviceIDs"):
+        base = [str(x) for x in req["DeviceIDs"]]
+        break
+if not base:
+    for e in (blob.get("Config") or {}).get("Env") or []:
+        k, sep, v = e.partition("=")
+        if sep and k == "NVIDIA_VISIBLE_DEVICES" and v.strip():
+            base = [x.strip() for x in v.split(",") if x.strip()]
+            break
+if base and base != ["all"] and "void" not in base and "none" not in base:
+    print(",".join(base))
+' 2>/dev/null || true
+  return 0
+}
