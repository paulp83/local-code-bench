+    if isinstance(gpu_ids, str):
+        ids = [x.strip() for x in gpu_ids.split(",") if x.strip()]
+    else:
+        ids = [str(x).strip() for x in gpu_ids if str(x).strip()]
+    if not ids or set(ids) <= {"all", "void", "none"}:
+        return None
