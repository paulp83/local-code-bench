+    scope=""
+    names="$(nvidia-smi -i "$gpus" --query-gpu=name --format=csv,noheader 2>/dev/null \
+      | sed 's/^NVIDIA //' || true)"
+  else
+    scope=" (rig-wide)"
+    names="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null \
+      | sed 's/^NVIDIA //' || true)"
+  fi
   [[ -z "$names" ]] && { echo "? GPU"; return; }
   n="$(printf '%s\n' "$names" | wc -l | tr -d ' ')"
   first="$(printf '%s\n' "$names" | head -1)"
-  if [[ "$n" == "1" ]]; then echo "1× ${first}"
-  else echo "${n}× ${first}"
+  distinct="$(printf '%s\n' "$names" | sort -u | awk 'NF{printf "%s%s", (NR > 1 ? " + " : ""), $0} END{printf "\n"}')"
+  if [[ "$distinct" == "$first" ]]; then
+    echo "${n}× ${first}${scope}"
+  else
+    echo "${distinct}${scope}"
   fi
