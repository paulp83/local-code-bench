+def container_gpu_ids(container):
+    """Host GPU selectors (indices or UUIDs, as strings) behind ``container``.
+
+    Resolves the cards the container is actually pinned to, from ``docker
+    inspect``: ``HostConfig.DeviceRequests[].DeviceIDs`` (compose ``devices:``)
+    first, then the ``NVIDIA_VISIBLE_DEVICES`` env.
+
+    Returns ``None`` when the container is unset, unresolvable, or declares
+    ``all`` (including when docker itself is absent). Callers then fall back
+    to the WHOLE RIG and must say so: the figure then includes other
+    services' memory, and judging the leak gate on it can fail a clean run or
+    hide a real one (a probe pinned to one RTX 3060 read 55 GB across four
+    3090s while an unrelated service ran on the rest of the rig).
+    """
+    if not container:
+        return None
+    try:
+        out = subprocess.run(
+            ["docker", "inspect", container],
+            capture_output=True,
+            text=True,
+            timeout=10,
+            encoding="utf-8",
+            errors="replace",
+        )
+    except Exception:
+        return None
+    if out.returncode != 0:
+        return None
+    try:
+        blob = json.loads(out.stdout)
+    except Exception:
+        return None
+    if isinstance(blob, list):
+        blob = blob[0] if blob else {}
+    if not isinstance(blob, dict):
+        return None
+    base = None
+    for req in (blob.get("HostConfig") or {}).get("DeviceRequests") or []:
+        if req.get("DeviceIDs"):
+            base = [str(x) for x in req["DeviceIDs"]]
+            break
+    if base is None:
+        env = {}
+        for entry in (blob.get("Config") or {}).get("Env") or []:
+            key, sep, value = entry.partition("=")
+            if sep and key:
+                env[key] = value
+        nvd = (env.get("NVIDIA_VISIBLE_DEVICES") or "").strip()
+        if nvd and nvd not in ("all", "void", "none"):
+            base = [v.strip() for v in nvd.split(",") if v.strip()]
+    if not base or base == ["all"]:
+        return None
+    return base
+
+
+def _normalize_gpu_ids(gpu_ids):
+    """List/tuple of selectors or a comma-separated string -> list, or None."""
+    if gpu_ids is None:
