diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..c740751 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1022,12 +1022,33 @@ down_running() {
     [[ -n "${managed[$c]:-}" ]] || continue   # not ours — leave it alone
     brought_down=1
     echo "[switch] bringing down: ${c}"
-    # derive the compose dir/file from the container's labels — stop fallback
+    # derive the compose dir/files from the container's labels — stop fallback.
+    # Since #1498 the config_files label is comma-joined (the slug's compose
+    # plus the <data dir>/compose-labels/ override), so pass each path as its
+    # own -f — the joined string as one path fails the whole teardown. Drop
+    # any listed file that no longer exists (e.g. the override after a data-dir
+    # move): it only adds labels, so down works with the rest. None left → a
+    # plain docker stop, as before.
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
+    local -a cfg_args=() _cfgs=()
+    local f
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      for f in "${_cfgs[@]}"; do
+        [[ -n "$f" ]] || continue
+        # compose resolves relative -f against the project's working dir.
+        if [[ "$f" == /* ]]; then
+          [[ -f "$f" ]] || continue
+        else
+          [[ -f "$lbl_dir/$f" ]] || continue
+        fi
+        cfg_args+=(-f "$f")
+      done
+    fi
+    if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+      (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
     else
       docker stop "$c" >/dev/null
     fi
