+def _line_target_path_start(before: str, occ: int) -> int | None:
+    """Index in ``before`` where the in-container target path of a mount
+    line begins — the leading ``/`` immediately after the source/target
+    separator ``:``.
+
+    ``before`` is the text preceding the spec-marker occurrence at
+    ``occ``; the occurrence is a SUFFIX of the real target (e.g. the
+    qwen38-reasoning-effort-template spec declares the shared suffix
+    ``/chat_template.jinja`` while each compose mounts it under its own
+    model dir, ``/root/.cache/.../chat_template.jinja``).
+    """
+    for i in range(occ - 1, -1, -1):
+        if before[i] != "/":
+            continue
+        if i > 0 and before[i - 1] == ":":
+            return i
+        if i > 1 and before[i - 1] == " " and before[i - 2] == ":":
+            return i
+    return None
+
