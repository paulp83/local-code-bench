+def _all_mount_sources(body: str) -> list[str]:
+    """The SOURCE of every VOLUME-MOUNT line in ``body`` (short form
+    ``- <src>:<target>`` items and the docker-rendered ``source:`` lines).
+
+    Used for a spec whose declared volume wiring is the patch dir itself
+    (a ``script`` carried in a mounted dir with no explicit
+    ``mounted_at``): the dir's name must appear in some mount's source.
+    """
+    sources: list[str] = []
+    for raw in body.splitlines():
+        line = raw.rstrip()
+        stripped = line.strip()
+        m = re.match(r"^(-\s+)?source:\s*(.*)$", stripped)
+        if m:
+            value = m.group(2).strip().strip("\"'")
+            if value:
+                sources.append(value)
+            continue
+        # short form: a `- <src>:<in-container target>` list item.
+        if not stripped.startswith("- "):
+            continue
+        for c in range(len(line)):
+            if line[c] != ":":
+                continue
+            if not line[c + 1:].lstrip().startswith("/"):
+                continue
