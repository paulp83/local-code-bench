+def _patch_identity_markers(patch: dict) -> list[str]:
+    """Strings that identify THIS patch in a compose's VOLUME-MOUNT line.
+
+    A mount line is credited to the patch only when the mounted SOURCE
+    (the host path) names the patch's own directory or a non-generic
+    artifact of it — never when only the in-container TARGET matches: two
+    different patches may mount at the SAME target (the vLLM and SGLang
+    W4A8 patches both use ``/etc/club3090/w4a8``), and a target-only probe
+    (or the legacy fallback's ``patches`` parent-dir / ``install.sh``
+    filename markers) credits the wrong patch.
+    """
+    markers: list[str] = []
+    if patch.get("id"):
+        markers.append(patch["id"])
+    spec = patch.get("delivery_spec") or {}
+    rels: list[str] = []
+    for key in ("script", "jinja", "sidecar"):
+        rel = spec.get(key)
+        if rel:
+            rels.append(rel)
+    for of in spec.get("overlay_files") or []:
+        rel = (of or {}).get("src")
+        if rel:
+            rels.append(rel)
+    for rel in rels:
+        artifact = Path(rel)
+        if artifact.parent.name and artifact.parent.name != "patches":
+            markers.append(artifact.parent.name)
+        if artifact.name and artifact.name not in GENERIC_ARTIFACT_NAMES:
+            markers.append(artifact.name)
+    return markers
+
