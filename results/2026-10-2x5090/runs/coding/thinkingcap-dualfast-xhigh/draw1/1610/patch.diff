+def _mount_sources(body: str, target: str) -> list[str]:
+    """The mounted SOURCE text of every VOLUME-MOUNT reference in
+    ``body`` whose in-container target equals or ends with ``target``.
+
+    Handles both wire forms:
+      * short form ``- <src>:<target>(:<mode>)`` — the composes' own text
+        (and the offline-merge render);
+      * long form ``source: <src>`` / ``target: <target>`` pairs as
+        rendered by ``docker compose config`` (absolute host paths).
+
+    Non-mount mentions of ``target`` (entrypoint invoke lines, env
+    assignments, log/error strings) are NOT mount references and are
+    ignored: a target string inside an invoke line proves the compose
+    *calls into* the path, not that the patch's directory is *mounted*.
+    """
+    lines = body.splitlines()
+    sources: list[str] = []
+    for idx, raw in enumerate(lines):
+        line = raw.rstrip()
+        if target not in line:
+            continue
+        # Long form: `target: <path>` — the docker compose config render
+        # carries the source on the preceding line.
+        m = re.match(r"^(-\s+)?target:\s*(.*)$", line.strip())
+        if m:
+            value = m.group(2).strip().strip("\"'")
+            if value == target or value.endswith(target):
+                j = idx - 1
+                while j >= 0:
+                    prev = lines[j].strip()
+                    if not prev:
+                        j -= 1
+                        continue
+                    if prev.startswith("source:"):
+                        sources.append(prev[len("source:"):].strip().strip("\"'"))
+                    break
+                continue
+        for m in re.finditer(re.escape(target), line):
+            after = line[m.end():]
+            # Boundary: the target must end at a mode separator, quote,
+            # whitespace, or end-of-line — not mid-token.
+            if after and after[0] not in (":", '"', "'", " ", "\t", ","):
+                continue
+            before = line[: m.start()]
+            if not before:
+                continue
+            if before.rstrip()[-1] == ":":
+                # Classic `src:target` split — everything before the
+                # separator (list dash / quoting included) is the source.
+                sources.append(before.rstrip()[:-1])
+            else:
+                # The marker is a suffix of a longer in-container path:
+                # locate the real path start and take the source before it.
+                start = _line_target_path_start(before, m.start())
+                if start is not None:
+                    sources.append(before[: start - 1])
+    return sources
+
