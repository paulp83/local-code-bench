 SUB="$1"; shift
 
-COMPOSE="" SPEC_FILE="" ENGINE="" MODEL="" WORKLOAD="" PORT="" SLUG="" DRY="" YES="" RROOT="" WEIGHTS="" ETYPE="" MINSM=""
+COMPOSE="" SPEC_FILE="" ENGINE="" MODEL="" WORKLOAD="" PORT="" SLUG="" TO="" SETKV="" DRY="" YES="" RROOT="" WEIGHTS="" ETYPE="" MINSM=""
 while [[ $# -gt 0 ]]; do
   case "$1" in
     --compose)   COMPOSE="${2:-}"; shift 2 ;;
@@ -47,6 +250,8 @@ while [[ $# -gt 0 ]]; do
     --engine-type) ETYPE="${2:-}"; shift 2 ;;
     --min-sm)    MINSM="${2:-}"; shift 2 ;;
     --slug)      SLUG="${2:-}"; shift 2 ;;
+    --to)        TO="${2:-}"; shift 2 ;;
+    --set)       SETKV="${2:-}"; shift 2 ;;
     --root)      RROOT="${2:-}"; shift 2 ;;
     --dry-run)   DRY="--dry-run"; shift ;;
     -y|--yes)    YES="--yes"; shift ;;
@@ -305,6 +510,25 @@ PY
          --layer local ${RROOT:+--root "$RROOT"} ${DRY:+--dry-run} ${YES:+--yes}
     ;;
 
+  rename)
+    [[ -n "$SLUG" ]] || die "rename needs --slug <engine>/<name>"
+    [[ -n "$TO" ]] || die "rename needs --to <engine>/<name>"
+    # Local layer only (never scripts/lib/profiles/): re-stamps the entry's
+    # engine to the new slug's namespace, refuses a curated slug / a rename
+    # onto one / an unknown engine namespace, and writes nothing on --dry-run.
+    amend_local rename "$SLUG" "$TO" "$DRY"
+    exit $?
+    ;;
+
+  update)
+    [[ -n "$SLUG" ]] || die "update needs --slug <engine>/<name>"
+    [[ -n "$SETKV" ]] || die "update needs --set KEY=VALUE"
+    # Same guarantees as rename; origin is the one non-editable field (the
+    # loader stamps it), and --set engine=… moves the entry to that namespace.
+    amend_local update "$SLUG" "$SETKV" "$DRY"
+    exit $?
+    ;;
+
   -h|--help) usage 0 ;;
-  *) die "unknown subcommand: $SUB (expected register | unregister)" ;;
+  *) die "unknown subcommand: $SUB (expected register | unregister | rename | update)" ;;
 esac
