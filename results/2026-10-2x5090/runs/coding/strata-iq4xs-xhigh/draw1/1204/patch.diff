@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""#1202 P2 — catalog provenance is a first-class `origin` field; core wins.
+
+Exercises the loader (compose_registry), the writers (promote.py / export_pr.py)
+and the merged view against a THROWAWAY repo copy (the same harness as
+test_local_registry.py): the real checkout stays pristine.
+
+    pytest scripts/tests/test_catalog_origin.py
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+_COPY_TREES = ("scripts/lib", "tools/tui-core", "models")
+
+MID = "my-model"
+QUANT = "autoround-int4"
+LOCAL_SLUG = f"local/{MID}-dual-{QUANT}"
+LOCAL_COMPOSE_REL = (
+    f"scripts/lib/profiles-local/composes/{MID}/vllm/compose/dual/{QUANT}/base.yml"
+)
+
+GOOD_KWARGS = {
+    "model": MID,
+    "weights_variant": QUANT,
+    "workload": "long-ctx-single",
+    "engine": "vllm-stable",
+    "drafter": None,
+    "kv_format": "fp8_e5m2",
+    "tp": 2,
+    "max_ctx": 131072,
+    "max_num_seqs": 2,
+    "mem_util": 0.92,
+    "compose_path": LOCAL_COMPOSE_REL,
+    "default_port": 20242,
+    "kvcalc_key": f"{MID}:dual",
+    "status": "incubating",
+}
+
+
+@pytest.fixture()
+def root(tmp_path):
+    for rel in _COPY_TREES:
+        shutil.copytree(
+            REPO / rel,
+            tmp_path / rel,
+            ignore=shutil.ignore_patterns("__pycache__", "cache"),
+        )
+    return tmp_path
+
+
+def _write_local(root, payload):
+    p = root / "scripts/lib/profiles-local/registry.local.json"
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text(
+        payload if isinstance(payload, str) else json.dumps(payload, indent=2),
+        encoding="utf-8",
+    )
+    return p
+
+
+def _py(root, snippet):
+    return subprocess.run(
+        [sys.executable, "-c", snippet], cwd=str(root), capture_output=True, text=True
+    )
+
+
+class TestFieldShape:
+    def test_every_core_row_is_core(self, root):
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import (\n"
+            "    COMPOSE_REGISTRY, ORIGIN_CORE, ORIGIN_LOCAL, ORIGIN_VALUES,\n"
+            ")\n"
+            "assert ORIGIN_VALUES == (ORIGIN_CORE, ORIGIN_LOCAL) == ('core', 'local')\n"
+            "assert COMPOSE_REGISTRY and all(\n"
+            "    e['origin'] == ORIGIN_CORE for e in COMPOSE_REGISTRY.values()\n"
+            ")\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+    def test_bogus_origin_rejected_by_entry(self, root):
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import _entry\n"
+            "try:\n"
+            "    _entry(model='m', weights_variant='w', workload='fast-chat',\n"
+            "           engine='vllm-stable', drafter=None, kv_format='bf16', tp=1,\n"
+            "           max_ctx=8192, max_num_seqs=1, mem_util=0.9,\n"
+            "           compose_path='models/x/vllm/compose/single/q/base.yml',\n"
+            "           default_port=8010, origin='somewhere-else')\n"
+            "except ValueError as exc:\n"
+            "    assert 'origin' in str(exc), exc\n"
+            "else:\n"
+            "    raise SystemExit('origin was not validated')\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+    def test_origin_is_derived_never_yaml_data(self, root):
+        """registry.yaml rows may NOT state it — the file is the provenance."""
+        r = _py(
+            root,
+            "import scripts.lib.profiles.compose_registry as cr\n"
+            "assert 'origin' in cr._DERIVED_ENTRY_KEYS\n"
+            "raw = cr.load_registry_data()\n"
+            "assert all('origin' not in kw for kw in raw['entries'].values())\n"
+            "assert all(e['origin'] == 'core' for e in cr.COMPOSE_REGISTRY.values())\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+    def test_yaml_row_stating_origin_refused(self, root):
+        reg = root / "scripts/lib/profiles/registry.yaml"
+        text = reg.read_text(encoding="utf-8")
+        reg.write_text(
+            text.replace("    model: qwen3.6-27b\n",
+                         "    model: qwen3.6-27b\n    origin: local\n", 1),
+            encoding="utf-8",
+        )
+        r = _py(root, "import scripts.lib.profiles.compose_registry")
+        assert r.returncode != 0
+        assert "origin" in r.stderr and "derived" in r.stderr
+
+
+class TestLocalLayer:
+    def test_local_row_is_stamped_local(self, root):
+        _write_local(root, {LOCAL_SLUG: dict(GOOD_KWARGS)})
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import get_registry\n"
+            f"e = get_registry()['{LOCAL_SLUG}']\n"
+            "assert e['origin'] == 'local', e['origin']\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+    def test_local_row_may_restate_its_own_origin(self, root):
+        _write_local(root, {LOCAL_SLUG: dict(GOOD_KWARGS, origin="local")})
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import get_registry\n"
+            f"assert get_registry()['{LOCAL_SLUG}']['origin'] == 'local'\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+    def test_local_row_claiming_core_refused(self, root):
+        """A row cannot launder itself into the curated catalog's provenance."""
+        _write_local(root, {LOCAL_SLUG: dict(GOOD_KWARGS, origin="core")})
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import get_registry\n"
+            "get_registry()\n",
+        )
+        assert r.returncode != 0
+        assert "origin" in r.stderr and "core" in r.stderr
+
+    def test_local_row_claiming_unknown_origin_refused(self, root):
+        _write_local(root, {LOCAL_SLUG: dict(GOOD_KWARGS, origin="curated")})
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import get_registry\n"
+            "get_registry()\n",
+        )
+        assert r.returncode != 0
+        assert "origin" in r.stderr
+
+    def test_merged_view_keeps_core_precedence(self, root):
+        """CORE WINS at the merge: a local row is never able to replace one."""
+        _write_local(root, {LOCAL_SLUG: dict(GOOD_KWARGS)})
+        r = _py(
+            root,
+            "import scripts.lib.profiles.compose_registry as cr\n"
+            "core_slug = next(iter(cr.COMPOSE_REGISTRY))\n"
+            "shadow = dict(cr.COMPOSE_REGISTRY[core_slug], status='experimental')\n"
+            "merged = dict(cr.load_local_registry())\n"
+            "cr_local = merged\n"
+            "out = dict(cr.COMPOSE_REGISTRY)\n"
+            "for s, e in cr_local.items():\n"
+            "    out.setdefault(s, e)\n"
+            "assert out[core_slug] is cr.COMPOSE_REGISTRY[core_slug]\n"
+            "assert out[core_slug]['status'] != 'experimental'\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+
+class TestWriters:
+    def test_promote_strips_origin_and_loads_local(self, root):
+        spec = _promote_spec()
+        spec["registry_entry"]["kwargs"]["origin"] = "core"
+        f = root / "spec.json"
+        f.write_text(json.dumps(spec), encoding="utf-8")
+        r = subprocess.run(
+            [sys.executable, str(REPO / "scripts/lib/profiles/promote.py"),
+             "--spec-file", str(f), "--root", str(root), "--layer", "local", "--yes"],
+            cwd=str(root), capture_output=True, text=True,
+        )
+        assert r.returncode == 0, r.stdout + r.stderr
+        raw = json.loads(
+            (root / "scripts/lib/profiles-local/registry.local.json").read_text()
+        )
+        assert "origin" not in raw[LOCAL_SLUG]
+        r = _py(
+            root,
+            "from scripts.lib.profiles.compose_registry import get_registry\n"
+            f"assert get_registry()['{LOCAL_SLUG}']['origin'] == 'local'\n",
+        )
+        assert r.returncode == 0, r.stderr
+
+
+def _promote_spec():
+    return {
+        "model_id": MID,
+        "display_name": "My Model",
+        "family": "generic-dense",
+        "arch": {"hidden_size": 5120, "num_hidden_layers": 40, "num_attn_heads": 24,
+                 "num_kv_heads": 4, "head_dim_attn": 256, "max_ctx_supported": 131072},
+        "weights": {QUANT: {"path": f"{MID}-{QUANT}", "local_subdir": f"{MID}-{QUANT}",
+                            "size_gb": 12.5, "format": "autoround", "status": "incubating",
+                            "hf_repo": "org/model", "engine": "vllm", "kind": "main",
+                            "verify_glob": "*.safetensors"}},
+        "default_weight_variant": QUANT,
+        "compatible_drafters": [],
+        "vision_capable": False,
+        "compose": {
+            "path": LOCAL_COMPOSE_REL,
+            "content": (
+                "# Profile (at-a-glance):\n"
+                "#   Status: 🐣 Incubating\n"
+                "# ---\n"
+                "services:\n"
+                "  vllm:\n"
+                "    image: vllm/vllm-openai:v0.27.1\n"
+                "    container_name: vllm-my-model-dual\n"
+                "    ports:\n"
+                '      - "${PORT:-20242}:8000"\n'
+            ),
+        },
+        "registry_entry": {"slug": LOCAL_SLUG, "kwargs": dict(GOOD_KWARGS)},
+    }
+
+
+class TestExport:
+    def test_local_origin_never_rides_into_the_bundle(self, tmp_path):
+        """Publishing flips provenance; it never restates the local one."""
+        repo = tmp_path / "repo"
+        repo.mkdir()
+        for rel in ("scripts/lib",):
+            shutil.copytree(REPO / rel, repo / rel, ignore=shutil.ignore_patterns("__pycache__", "cache"))
+        (repo / "scripts/lib/profiles-local/models.d").mkdir(parents=True, exist_ok=True)
+        (repo / "scripts/lib/profiles-local/models.d" / f"{MID}.yml").write_text(
+            "schema_version: 1\n"
+            f"id: {MID}\n"
+            "display_name: My Model\n"
+            "family: generic-dense\n"
+            "weights:\n"
+            f"  {QUANT}:\n"
+            "    hf_repo: org/model\n"
+            '    files: ["*.safetensors"]\n'
+            '    format: "autoround"\n'
+            '    verify_glob: "*.safetensors"\n'
+            f"default_weight_variant: {QUANT}\n",
+            encoding="utf-8",
+        )
+        comp = repo / LOCAL_COMPOSE_REL
+        comp.parent.mkdir(parents=True, exist_ok=True)
+        comp.write_text(
+            "# Profile (at-a-glance):\n"
+            "#   Status: 🐣 Incubating\n"
+            "services:\n  vllm:\n    image: x\n",
+            encoding="utf-8",
+        )
+        _write_local(repo, {LOCAL_SLUG: dict(GOOD_KWARGS, origin="local")})
+        spec = repo / "spec.json"
+        spec.write_text(json.dumps({"model_id": MID}), encoding="utf-8")
+        out = tmp_path / "bundle"
+        r = subprocess.run(
+            [sys.executable, str(REPO / "scripts/lib/profiles/export_pr.py"),
+             "--spec-file", str(spec), "--root", str(repo), "--out", str(out)],
+            cwd=str(repo), capture_output=True, text=True,
+        )
+        assert r.returncode == 0, r.stdout + r.stderr
+        text = (out / "registry-entry.yaml").read_text(encoding="utf-8")
+        assert "\n    origin:" not in text     # provenance never travels
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(pytest.main([__file__, "-q"]))
