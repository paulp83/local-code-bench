-  local n
-  n="$(_served_seqs || true)"; [[ -n "$n" ]] && { echo "$n"; return; }
-  n="$(_served_np || true)";   [[ -n "$n" ]] && { echo "$n"; return; }
-  n="$(_served_max_running || true)"; [[ -n "$n" ]] && { echo "$n"; return; }
