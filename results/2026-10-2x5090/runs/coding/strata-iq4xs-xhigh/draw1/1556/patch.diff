+# What each engine prints once per boot as the size of its KV pool, in tokens:
+#   vLLM    "GPU KV cache size: 210,000 tokens"                      (optional leading ~)
+#   SGLang  "KV Cache is allocated. dtype: …, #tokens: 177667"  and the effective-limits line
+#           "max_total_num_tokens=158116 chunked_prefill_size=… max_running_requests=6 …"
+# The SGLang line is also the one report.sh reads, because it carries what took effect (SGLang
+# clamps what it was asked for) rather than what compose asked for.
+_KV_PATTERNS = (
+    r"GPU KV cache size:\s*~?([\d,]+)\s*tokens",
+    r"max_total_num_tokens=([\d,]+)",
+    r"KV Cache is allocated\.[^\n]*?#tokens:\s*([\d,]+)",
+)
+
+
