-  n="$(_props_slots || true)"; [[ -n "$n" ]] && { echo "$n"; return; }
-  echo ""
+  local entry fn
+  SLOT_COUNT=""; SLOT_SOURCE="undetected"; SLOT_ENGINE=""
+  for entry in "${_SLOT_SOURCES[@]}"; do
+    fn="${entry%%|*}"
+    SLOT_COUNT="$("$fn" || true)"
+    if [[ -n "$SLOT_COUNT" ]]; then
+      entry="${entry#*|}"
+      SLOT_SOURCE="${entry%%|*}"
+      SLOT_ENGINE="${entry##*|}"
+      return 0
+    fi
+  done
+  return 0
 }
 
