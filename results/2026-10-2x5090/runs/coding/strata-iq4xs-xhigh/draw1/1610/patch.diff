+def _split_mount_fields(value: str) -> list[str]:
+    """Split a Compose short-syntax mount ``SRC:DST[:MODE]`` on ``:`` at depth 0.
+
+    Braces and quotes are respected, so an interpolation default
+    (``${MODEL_DIR:-../..}:/models:ro``) never masquerades as a field separator.
+    """
+    fields: list[str] = []
+    current: list[str] = []
+    depth = 0
+    quote = ""
+    for ch in value:
+        if quote:
+            current.append(ch)
+            if ch == quote:
+                quote = ""
+            continue
+        if ch in ("'", '"'):
+            quote = ch
+            current.append(ch)
+            continue
+        if ch == "{":
+            depth += 1
+        elif ch == "}" and depth:
+            depth -= 1
+        elif ch == ":" and depth == 0:
+            fields.append("".join(current))
+            current = []
+            continue
+        current.append(ch)
+    fields.append("".join(current))
+    return [f.strip() for f in fields]
+
+
+def _split_flow_entries(text: str) -> list[str]:
+    """Split the inside of a YAML flow sequence on top-level commas."""
+    entries: list[str] = []
+    current: list[str] = []
+    depth = 0
+    quote = ""
+    for ch in text:
+        if quote:
+            current.append(ch)
+            if ch == quote:
+                quote = ""
+            continue
+        if ch in ("'", '"'):
+            quote = ch
+            current.append(ch)
+            continue
+        if ch in "[{":
+            depth += 1
+        elif ch in "]}":
+            depth -= 1
+        elif ch == "," and depth == 0:
+            entries.append("".join(current))
+            current = []
+            continue
+        current.append(ch)
+    entries.append("".join(current))
+    return [e.strip() for e in entries if e.strip()]
