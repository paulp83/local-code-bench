+    "install.bash",
+    "install.py",
+    "install",
+    "apply.sh",
+    "apply.py",
+    "apply",
+    "patch.sh",
+    "patch.py",
+    "run.sh",
+    "setup.sh",
+    "main.py",
+    "overlay.sh",
