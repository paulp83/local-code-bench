+def body_mount_pairs(body: str) -> list[tuple[str | None, str]]:
+    """Parse ``(source, target)`` bind mounts out of compose text.
+
+    Handles the short list form (``- ../../patches/x:/etc/club3090/x:ro``) and
+    the long form ``docker compose config`` renders (``- type: bind`` /
+    ``source: …`` / ``target: …``). A line this parser cannot read is skipped —
+    the parse is a strictness REFINEMENT of a substring probe, so it must never
+    turn an unfamiliar shape into a coverage loss.
+    """
+    pairs: list[tuple[str | None, str]] = []
+    pending_source: str | None = None
+    for raw in body.splitlines():
+        line = raw.strip()
+        if not line:
+            continue
+        item = None
+        dash = re.match(r"^-\s*(.*)$", line)
+        if dash:
+            item = dash.group(1).strip()
+        text = item if item is not None else line
+        kv = _MOUNT_KEY_RE.match(text)
+        if kv:
+            value = _unquote(kv.group(2))
+            if kv.group(1) in ("source", "src"):
+                pending_source = value
+                continue
+            if value.startswith("/"):
+                pairs.append((pending_source, value))
+            pending_source = None
+            continue
+        if item is None:
+            # A flow-style one-liner: `volumes: ["a:/etc/x:ro", "b:/etc/y"]`.
+            flow = re.match(r"^volumes\s*:\s*\[(.*)\]\s*$", line)
+            if flow:
+                for entry in _split_flow_entries(flow.group(1)):
+                    fields = _split_mount_fields(_unquote(entry))
+                    if len(fields) >= 2 and fields[1]:
+                        pairs.append((fields[0], fields[1]))
+            continue
+        # A long-syntax item opener (`- type: bind`) is not a new mount source.
+        if re.match(r"^type\s*:", item):
+            continue
+        pending_source = None
+        fields = _split_mount_fields(_unquote(item))
+        if len(fields) >= 2 and fields[1]:
+            pairs.append((fields[0], fields[1]))
+    return pairs
