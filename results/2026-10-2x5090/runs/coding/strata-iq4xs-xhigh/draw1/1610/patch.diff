+def _is_identifying(name: str, generic: Iterable[str] = ()) -> bool:
+    """True when ``name`` is specific enough to stand for exactly ONE patch."""
+    return bool(name) and name not in set(generic)
+
+
+def _invoke_marker_is_identifying(marker: str) -> bool:
+    """True when an invoke marker is more than a boilerplate filename.
+
+    A command or path (``bash /etc/club3090/w4a8/install.sh``) says WHERE the
+    script runs, so it identifies the patch's own wiring even when its last
+    path component is the universal ``install.sh``; a bare ``install.sh`` does
+    not (every other patch's install line would match it).
+    """
+    if "/" in marker:
+        return True
+    return _is_identifying(marker, GENERIC_PATCH_ARTIFACT_NAMES)
+
+
+def _artifact_identity_tokens(path: str) -> list[str]:
+    """Body markers that identify a patch artifact by its host-side path.
+
+    ``models/x/vllm/patches/<patch-dir>/install.sh`` → ``<patch-dir>`` (the
+    ``install.sh`` half is generic boilerplate and is dropped). A distinctive
+    filename is kept; a bucket directory (``local``) never is.
+    """
+    parts = [seg for seg in Path(path).as_posix().split("/") if seg]
+    tokens: list[str] = []
+    if "patches" in parts:
+        idx = parts.index("patches")
+        if idx + 1 < len(parts):
+            seg = parts[idx + 1]
+            if _is_identifying(seg, GENERIC_PATCH_DIR_NAMES | GENERIC_PATCH_ARTIFACT_NAMES):
+                tokens.append(seg)
+    base = parts[-1] if parts else ""
+    if _is_identifying(base, GENERIC_PATCH_ARTIFACT_NAMES) and base not in tokens:
+        tokens.append(base)
+    return tokens
+
+
+def patch_host_identities(patch: dict) -> list[str]:
+    """Every host-side token that identifies THIS patch's vendored artifact.
+
+    Derived from ``files`` plus the ``delivery_spec`` artifact paths (script /
+    jinja / sidecar / overlay sources) — i.e. the strings that appear in the
+    SOURCE half of the bind mount that delivers the patch. Empty when the patch
+    declares nothing identifying; callers must then not invent a negative.
+    """
+    paths: list[str] = list(patch.get("files") or [])
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "jinja", "sidecar", "overlay_dir"):
+        if spec.get(key):
+            paths.append(str(spec[key]))
+    for overlay in spec.get("overlay_files") or []:
+        if overlay.get("src"):
+            paths.append(str(overlay["src"]))
+    tokens: list[str] = []
+    for candidate in paths:
+        for tok in _artifact_identity_tokens(candidate):
+            if tok not in tokens:
+                tokens.append(tok)
+    pid = patch.get("id")
+    if pid and str(pid) not in tokens:
+        tokens.append(str(pid))
+    return tokens
+
