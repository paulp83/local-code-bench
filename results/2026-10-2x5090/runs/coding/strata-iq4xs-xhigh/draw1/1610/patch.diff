+#     one, so any compose that mounts *any* patch contains the string; and
+#   * the boilerplate artifact filenames (``install.sh``, ``apply.py``, …) that
+#     each install-script patch ships — any compose that runs *any* install
+#     script contains them.
+#
+# Probing a compose body for those is what made the legacy
+# ``delivery.entrypoint_invoke`` fallback effectively always-True: an
+# install-script patch kept reporting as wired after its compose stopped
+# mounting/invoking it (the sound ``delivery_spec`` check said False and the
+# fallback overrode it). A patch is identified by its OWN vendored path
+# segment (``patches/<patch-dir>``) or a distinctive artifact filename, and a
+# mount is only credited to the patch when its SOURCE — not just its
+# in-container target — belongs to that patch. Two patches can legitimately
+# share an in-container target: the vLLM and the SGLang W4A8 patches are both
+# mounted at ``/etc/club3090/w4a8``.
+GENERIC_PATCH_ARTIFACT_NAMES = {
