+def _source_is_a_patch_path(source: str) -> bool:
+    """True when a mount source is shaped like a vendored patch path.
+
+    A refutation needs evidence. ``…/patches/<other-patch>`` is evidence (it is
+    the in-tree mount shape, so it names a DIFFERENT patch); an opaque host
+    path that carries no ``patches/`` segment names nothing, so it cannot
+    contradict a mount target.
+    """
+    return bool(_PATCH_SHAPED_SOURCE_RE.search(source))
+
+
+def _mount_source_is_this_patch(patch: dict, source: str | None) -> bool:
+    """True when a mount's SOURCE half does not contradict ``patch``.
+
+    Confirmed when the source carries one of the patch's identity tokens.
+    Neither a missing source half, nor a patch with no identifying token of its
+    own, nor a source that is not shaped like a patch path is a refutation —
+    never manufacture a negative out of missing attribution. A patch-shaped
+    source (``…/patches/<dir>``) that belongs to none of it DOES contradict:
+    that is a different patch mounted at this patch's in-container target.
+    """
+    if source is None:
+        return True
+    identities = patch_host_identities(patch)
+    if not identities:
+        return True
+    if any(tok in source for tok in identities):
+        return True
+    return not _source_is_a_patch_path(source)
+
+
+def _volume_wiring_present(patch: dict, body: str, vol_markers: list[str]) -> bool:
+    """True when the body mounts THIS patch at one of its declared targets.
+
+    The declared target alone is not enough — a DIFFERENT patch mounted at the
+    same in-container path must not read as wired, so the mount's source is
+    matched to the patch too. When no mount line parses at all the substring
+    probe is kept (an unknown body shape must not become a false negative).
+    """
+    if not any(m in body for m in vol_markers):
+        return False
+    mounts = body_mount_pairs(body)
+    if not mounts:
+        return True
+    identities = patch_host_identities(patch)
+    for source, target in mounts:
+        if not any(m in target for m in vol_markers):
+            continue
+        if not identities or _mount_source_is_this_patch(patch, source):
+            return True
+    return False
