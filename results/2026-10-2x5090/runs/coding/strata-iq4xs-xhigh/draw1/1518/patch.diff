diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..11c4c79 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1026,8 +1026,27 @@ down_running() {
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
-    if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+    # The label is a COMMA-JOINED LIST of files, not a path: since #1498 every
+    # managed container carries its compose PLUS the club3090.slug label override
+    # and docker compose records both. Handing the joined string to a single -f
+    # fails (compose file "…,…" is invalid), which silently degraded every
+    # teardown to `docker stop` — the container stayed, along with its network and
+    # its orphans. One -f per file, like litellm-log.sh / resolved_config.py
+    # already do, and drop the entries that no longer exist (a data dir that moved
+    # takes the label override with it; the override only ADDS labels, so `down`
+    # needs nothing that is missing). Nothing left -> plain docker stop.
+    local -a cfg_list=() cfg_args=()
+    local f
+    [[ -n "$lbl_file" ]] && { IFS=',' read -r -a cfg_list <<< "$lbl_file" || true; }
+    for f in ${cfg_list[@]+"${cfg_list[@]}"}; do
+      [[ -n "$f" ]] || continue
+      # absolute as compose recorded it, or relative to the label's working dir
+      if [[ -f "$f" ]] || { [[ -n "$lbl_dir" ]] && [[ -f "${lbl_dir%/}/$f" ]]; }; then
+        cfg_args+=(-f "$f")
+      fi
+    done
+    if [[ -n "$lbl_dir" && ${#cfg_args[@]} -gt 0 ]]; then
+      (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..6c9dc45 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -16,6 +16,12 @@
 #   5. Teardown passes --remove-orphans.
 #   6. When only unmanaged containers run, nothing is torn down and the
 #      "no club-3090 container running" path is taken.
+#   7. com.docker.compose.project.config_files is a COMMA-JOINED LIST (compose file
+#      + the club3090.slug label override, #1498): every entry gets its own -f, an
+#      entry that no longer exists is dropped, and with nothing left teardown falls
+#      back to `docker stop` instead of calling compose. Passing the joined string as
+#      one -f fails ("compose file \"…,\" is invalid"), which silently degraded every
+#      teardown to stop-without-remove.
 #
 # Harness: extract down_running() via sed, source it, inject a VARIANT_CONTAINER
 # managed set + a mock `docker` on PATH that records compose-down / stop calls.
@@ -80,7 +86,13 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      # per-container override: DOCKER_MOCK_LABELS="name=path[,path…];name2=…"
+      lbl=""
+      IFS=';' read -ra _kv <<< "${DOCKER_MOCK_LABELS:-}"
+      for _e in ${_kv[@]+"${_kv[@]}"}; do
+        [[ "${_e%%=*}" == "$cname" ]] && lbl="${_e#*=}"
+      done
+      printf '%s\n' "${lbl:-compose-${cname}.yml}"
     fi
     ;;
   stop)
@@ -98,6 +110,7 @@ chmod +x "${tmp_dir}/docker"
 export DOCKER_MOCK_LOG="${tmp_dir}/calls.log"
 export DOCKER_MOCK_WORKDIR="${tmp_dir}"   # real dir so (cd "$lbl_dir") succeeds
 export PATH="${tmp_dir}:$PATH"
+export DOCKER_MOCK_LABELS=""              # per-scenario label overrides, see below
 export COMPOSE_BIN="docker compose"
 
 # Managed set, as derive_switch_variant_tables would populate it (default
@@ -113,6 +126,12 @@ declare -A VARIANT_CONTAINER=(
 # shellcheck source=/dev/null
 source "$HELPERS_FILE"
 
+# The default mock label is `compose-<container>.yml` (relative to the label's
+# working dir); teardown drops files that do not exist, so create them.
+for _n in vllm-qwen36-27b vllm-qwen36-27b-dual ik-llama-qwen36-27b beellama-qwen36-27b llama-cpp-qwen36-27b; do
+  touch "${tmp_dir}/compose-${_n}.yml"
+done
+
 # --- Scenario 1: mixed managed + unmanaged containers running -----------------
 : > "$DOCKER_MOCK_LOG"
 export DOCKER_MOCK_RUNNING="vllm-qwen36-27b unrelated-db ik-llama-qwen36-27b litellm"
@@ -135,6 +154,44 @@ assert_not_contains "$log" "COMPOSE"                          "nothing torn down
 assert_not_contains "$log" "STOP"                             "nothing stopped when only unmanaged running"
 assert_contains     "$out" "no club-3090 container running"   "reports no managed container running"
 
+# --- Scenario 3: the comma-joined config_files list (#1498) --------------------
+# Docker records the slug's compose AND the label override as one comma-joined
+# string. Split on "," and pass one -f per file, or `down` fails and degrades to
+# `docker stop` — the container stays with its network and its orphans.
+touch "${tmp_dir}/compose-base.yml" "${tmp_dir}/compose-label.yml"
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_RUNNING="vllm-qwen36-27b"
+export DOCKER_MOCK_LABELS="vllm-qwen36-27b=${tmp_dir}/compose-base.yml,${tmp_dir}/compose-label.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_contains     "$log" "${tmp_dir}/compose-base.yml"  "slug compose passed to down"
+assert_contains     "$log" "${tmp_dir}/compose-label.yml" "label override passed to down"
+assert_contains     "$log" "--remove-orphans"             "comma list still tears down with --remove-orphans"
+if [[ "$(command grep -c -- '-f ' <<<"$log")" == "1" && "$(command grep -o -- '-f' <<<"$log" | wc -l)" == "2" ]]; then
+  PASS=$((PASS + 1))
+else
+  echo "FAIL: comma-joined label must become TWO -f arguments: $log" >&2
+  FAIL=$((FAIL + 1))
+fi
+
+# --- Scenario 4: a listed file that is gone is dropped, the rest still down ----
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_LABELS="vllm-qwen36-27b=${tmp_dir}/compose-base.yml,${tmp_dir}/compose-gone.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_contains     "$log" "${tmp_dir}/compose-base.yml" "surviving compose file still torn down"
+assert_not_contains "$log" "compose-gone.yml"            "missing compose file dropped from -f"
+assert_not_contains "$log" "STOP"                        "a missing file alone must not fall back to docker stop"
+
+# --- Scenario 5: every listed file gone -> docker stop, compose untouched ------
+: > "$DOCKER_MOCK_LOG"
+export DOCKER_MOCK_LABELS="vllm-qwen36-27b=${tmp_dir}/gone1.yml,${tmp_dir}/gone2.yml"
+( set +u; down_running ) >/dev/null 2>&1 || true
+log="$(cat "$DOCKER_MOCK_LOG")"
+assert_contains     "$log" "STOP vllm-qwen36-27b" "falls back to docker stop when no compose file is left"
+assert_not_contains "$log" "COMPOSE"              "no compose call when every listed file is gone"
+export DOCKER_MOCK_LABELS=""
+
 # --- Summary ------------------------------------------------------------------
 echo "----------------------------------------"
 echo "PASS: $PASS   FAIL: $FAIL"
