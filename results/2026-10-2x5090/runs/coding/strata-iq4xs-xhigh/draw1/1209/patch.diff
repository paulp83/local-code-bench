diff --git a/scripts/tests/test-catalog-rename-update.sh b/scripts/tests/test-catalog-rename-update.sh
new file mode 100755
index 0000000..0b6756c
--- /dev/null
+++ b/scripts/tests/test-catalog-rename-update.sh
@@ -0,0 +1,186 @@
+#!/usr/bin/env bash
+# Guard: scripts/catalog.sh rename / update — the local layer is no longer
+# create-and-delete only (#1202 P7).
+#
+# Why this exists: #1204 decided that a local slug colliding with a newly-shipped
+# curated one is SHADOWED — kept and *marked* "so the user can rename it" — and no
+# rename existed, so `switch.sh --list` advertised a remedy that could not be
+# reached. Changing one field meant demoting and re-promoting. Both subcommands
+# write ONE file (registry.local.json), and this guard pins the five properties
+# that make them safe to hand a stranger:
+#   1. rename + update actually change the entry and exit 0;
+#   2. the curated catalog is unreachable — as the SOURCE and as the TARGET of a
+#      rename — and provably unchanged (hashed before/after);
+#   3. --dry-run exits 0 and leaves the file byte-identical;
+#   4. a local entry's engine stays equal to its slug namespace, and the layer
+#      still loads through load_local_registry with origin: local;
+#   5. origin is not editable, and neither is an engine namespace nothing knows.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+cat > "$TMP/byo.yml" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a byo-probe -c 65536 -ctk q8_0 -ts 1,1
+YML
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+before_registry=""
+slug_of() { python3 -c "import json,sys;print(next(iter(json.load(open(sys.argv[1],encoding='utf-8')))))" "$REG"; }
+
+scripts/catalog.sh register --compose "$TMP/byo.yml" --engine their-engine --engine-type llama.cpp \
+        --weights "$TMP/config.json" --root "$TMP" -y >/dev/null 2>&1 \
+  || { echo "  FAIL fixture: register failed in a throwaway root"; exit 1; }
+OLD="their-engine/byo-probe"
+
+# ── 1. --dry-run changes nothing but exits 0 ─────────────────────────────────
+before_bytes="$(md5sum "$REG" | cut -d' ' -f1)"
+out="$(scripts/catalog.sh rename --slug "$OLD" --to llamacpp/byo-probe --root "$TMP" --dry-run 2>&1)"; code=$?
+if [[ "$code" -ne 0 || "$(md5sum "$REG" | cut -d' ' -f1)" != "$before_bytes" ]]; then
+  echo "  FAIL rename --dry-run (exit $code) or it wrote something"; rc=1
+else
+  echo "  ok   rename --dry-run exits 0 and leaves the registry untouched"
+fi
+[[ "$out" == *"dry-run"* ]] || { echo "  FAIL --dry-run did not reach the executor"; rc=1; }
+out="$(scripts/catalog.sh update --slug "$OLD" --set max_ctx=8192 --root "$TMP" --dry-run 2>&1)"; code=$?
+[[ "$code" -eq 0 && "$(md5sum "$REG" | cut -d' ' -f1)" == "$before_bytes" ]] \
+  && echo "  ok   update --dry-run exits 0 and leaves the registry untouched" \
+  || { echo "  FAIL update --dry-run (exit $code)"; rc=1; }
+
+# ── 2. update changes the field, keeps the shape, keeps origin: local ────────
+if scripts/catalog.sh update --slug "$OLD" --set max_ctx=8192 --set workload=fast-chat \
+        --root "$TMP" >/dev/null 2>&1; then
+  python3 - "$TMP" "$OLD" <<'PY' || { echo "  FAIL update did not land, or the layer no longer loads"; rc=1; }
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import load_local_registry
+root, slug = Path(sys.argv[1]), sys.argv[2]
+row = load_local_registry(root)[slug]
+assert row["max_ctx"] == 8192, row["max_ctx"]          # parsed as a NUMBER
+assert row["workload"] == "fast-chat"
+assert row["origin"] == "local"                        # provenance survives
+assert row["engine"] == slug.split("/", 1)[0]
+PY
+  echo "  ok   update edited the fields; layer loads with origin: local"
+else
+  echo "  FAIL update refused a legal edit"; rc=1
+fi
+
+# ── 3. rename rewrites the key AND the engine (engine == namespace) ──────────
+if scripts/catalog.sh rename --slug "$OLD" --to llamacpp/byo-probe --root "$TMP" >/dev/null 2>&1; then
+  python3 - "$TMP" <<'PY' || { echo "  FAIL rename left the registry inconsistent"; rc=1; }
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import load_local_registry
+root = Path(sys.argv[1])
+local = load_local_registry(root)
+assert "llamacpp/byo-probe" in local and "their-engine/byo-probe" not in local, list(local)
+# EVERY row in the layer: a local entry's engine IS its slug namespace.
+for slug, row in local.items():
+    assert row["engine"] == slug.split("/", 1)[0], (slug, row["engine"])
+    assert row["origin"] == "local", slug
+    # The files never move: the model id is the file key, the tail is a label.
+    assert row["compose_path"].startswith("scripts/lib/profiles-local/composes/"), row
+PY
+  [[ -f "$TMP/scripts/lib/profiles-local/composes/byo-probe/their-engine/compose/single/gguf/base.yml" ]] \
+    && echo "  ok   rename re-keyed the entry, engine followed the namespace, files kept" \
+    || { echo "  FAIL rename moved or dropped the compose tree"; rc=1; }
+else
+  echo "  FAIL rename refused a legal rename"; rc=1
+fi
+
+# ── 4. refusals: nothing written, non-zero exit ──────────────────────────────
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+core_ns="${CORE%%/*}"
+hash_before="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+refused() {  # refused <expectation> <subcommand> <args…>
+  local want="$1"; shift
+  local out; out="$(scripts/catalog.sh "$@" --root "$TMP" 2>&1)"; local code=$?
+  if [[ "$code" -eq 0 ]]; then
+    echo "  FAIL '$want' was accepted"; rc=1
+  elif [[ "${out,,}" != *"${want,,}"* ]]; then
+    echo "  FAIL '$want' refused without naming it: ${out}"; rc=1
+  else
+    echo "  ok   $want refused"
+  fi
+}
+refused "CURATED"  rename --slug "$CORE" --to llamacpp/not-yours
+refused "CURATED"  rename --slug llamacpp/byo-probe --to "$CORE"
+refused "origin"   update --slug llamacpp/byo-probe --set origin=core
+refused "not a known engine" rename --slug llamacpp/byo-probe --to not-an-engine/byo-probe
+refused "not in"   update --slug llamacpp/nope --set max_ctx=1
+refused "KEY=VALUE" update --slug llamacpp/byo-probe --set max_ctx
+[[ "$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)" == "$hash_before" ]] \
+  && echo "  ok   the curated catalog is byte-identical throughout" \
+  || { echo "  FAIL something under scripts/lib/profiles changed"; rc=1; }
+# and the local entry survived every refusal above
+python3 - "$TMP" <<'PY' || { echo "  FAIL a refusal damaged the local entry"; rc=1; }
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import load_local_registry
+assert load_local_registry(Path(sys.argv[1]))["llamacpp/byo-probe"]["max_ctx"] == 8192
+PY
+
+# ── 5. THE REMEDY ITSELF: a shadowed local row renames off the shipped name ──
+python3 - "$TMP" "$CORE" <<'PY' || exit 1
+import json, sys
+from pathlib import Path
+root, core = Path(sys.argv[1]), sys.argv[2]
+reg = root / "scripts/lib/profiles-local/registry.local.json"
+raw = json.loads(reg.read_text(encoding="utf-8"))
+row = raw.pop("llamacpp/byo-probe")
+row["model"], row["engine"] = "my-shadow-probe", core.split("/", 1)[0]
+raw[core] = row                       # the shadowing collision #1204 marks
+reg.write_text(json.dumps(raw, indent=2) + "\n", encoding="utf-8")
+PY
+python3 - "$TMP" "$CORE" <<'PY' && echo "  ok   fixture really is shadowed" || { echo "  FAIL shadow fixture did not shadow"; rc=1; }
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import load_local_registry
+row = load_local_registry(Path(sys.argv[1]))[sys.argv[2]]
+assert row.get("shadowed_by_core"), row
+assert row["engine"] == sys.argv[2].split("/", 1)[0]     # the invariant holds pre-amend
+PY
+if scripts/catalog.sh rename --slug "$CORE" --to "$core_ns/my-shadow-probe" --root "$TMP" >/dev/null 2>&1; then
+  python3 - "$TMP" "$CORE" "$core_ns" <<'PY' \
+    && echo "  ok   the shadowed entry resolves again — the remedy is reachable" \
+    || { echo "  FAIL renamed but the mark or the invariant is wrong"; rc=1; }
+import sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY, load_local_registry
+root, core, ns = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
+local = load_local_registry(root)
+assert core not in local, "still shadowed"
+row = local[f"{ns}/my-shadow-probe"]
+assert not row.get("shadowed_by_core"), row
+assert row["origin"] == "local" and row["engine"] == ns, row
+assert f"{ns}/my-shadow-probe" not in COMPOSE_REGISTRY
+PY
+else
+  echo "  FAIL rename refused the one case it exists for"; rc=1
+fi
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames, updates, and still cannot reach core" \
+                   || echo "FAIL: catalog.sh rename/update regression"
+exit "$rc"
