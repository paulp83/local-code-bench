+#!/usr/bin/env python3
+"""Local-layer AMENDMENT — rename or edit a local catalog entry (#1202 P7).
+
+``promote.py`` writes a local model and ``demote.py`` removes it. Between those
+two poles the layer was **create-and-delete only**: changing one field meant
+demoting and re-promoting, and there was no rename at all. That is worse than
+inconvenient — #1204 decided that a local slug colliding with a newly-shipped
+curated one is **shadowed** (kept, and *marked*, "so the user can rename it"),
+and no rename existed. ``switch.sh --list`` advertised a remedy that could not
+be reached. This is that remedy::
+
+    python3 scripts/lib/profiles/amend.py --slug vllm/minimal --to vllm/my-minimal
+    python3 scripts/lib/profiles/amend.py --slug vllm/my-minimal --set max_ctx=32768
+    python3 scripts/lib/profiles/amend.py --slug vllm/my-minimal --set workload=long-ctx-single \
+                                          --set mem_util=0.85
+
+Both forms change the LOCAL layer only: the single file written is
+``scripts/lib/profiles-local/registry.local.json`` (``--root DIR`` moves it into
+a throwaway tree, exactly as promote/demote do). Nothing under
+``scripts/lib/profiles/`` is opened for writing, and the curated catalog has no
+row this tool can reach: a slug absent from the local registry is refused before
+anything is read — the same location-based guard ``demote.py`` uses, which fails
+closed and cannot be talked past by naming a curated slug.
+
+WHAT AN AMEND DOES NOT DO
+  * rename the *files*. The slug tail is a label; the model id (``model``) is
+    what keys ``models.d/<id>.yml`` and ``composes/<id>/``. Those keep their
+    names, ``compose_path`` keeps pointing at the same compose, and
+    ``demote.py`` still finds them (it reads ``model`` first, the tail only as a
+    fallback). ``--set model=…`` is refused for the same reason: retargeting a
+    model id without moving its files is how a layer grows orphans.
+  * touch a curated row. ``--to <curated slug>`` is refused — walking straight
+    back into the shadowing trap would be a joke of a remedy.
+  * edit provenance. ``origin`` is stamped ``local`` by the loader and is not a
+    field of the stored row; ``--set origin=…`` is refused.
+
+THE INVARIANT THIS TOOL ENFORCES
+  In the local layer the engine IS the slug namespace (``promote.py`` writes it
+  that way, and #1202 P3 removed the namespace that used to occupy the engine
+  slot), so every row written here satisfies ``engine == slug.split("/")[0]``. A
+  rename therefore rewrites ``engine`` along with the key, ``--set engine=…`` to
+  a different value is refused (rename to change engines), and rows that drifted
+  before this tool existed are repaired on the way past — loudly, one line each.
+  ``load_local_registry()`` is re-run over the result before this exits 0: an
+  amend that turns a loadable layer into an unloadable one is rolled back from
+  the bytes it read.
+
+Exit codes match promote.py / demote.py: 0 success, 3 refusal (nothing written),
+2 internal failure AFTER a write started (the write is restored).
+
+Success markers (the c3 parser hook, same shape as PROMOTE_OK / DEMOTE_OK)::
+
+    RENAME_OK <new-slug> (was <old-slug>)
+    UPDATE_OK <slug>
+"""
+
+from __future__ import annotations
+
+import argparse
+import inspect
+import json
+import os
+import re
+import sys
+from pathlib import Path
+from typing import Optional
+
+_HERE = Path(__file__).resolve()
+# Repo root of THIS checkout: <root>/scripts/lib/profiles/amend.py
+_REPO_ROOT = _HERE.parents[3]
+_DEFAULT_ROOT = _REPO_ROOT
+
+_LOCAL_DIR_REL = "scripts/lib/profiles-local"
+_LOCAL_REGISTRY_REL = f"{_LOCAL_DIR_REL}/registry.local.json"
+_LOCAL_COMPOSES_REL = f"{_LOCAL_DIR_REL}/composes"
+_LOCAL_ENGINES_REL = f"{_LOCAL_DIR_REL}/engines.d"
+_CORE_ENGINES_REL = "scripts/lib/profiles/engines"
+
+# The namespace P3 removed. A `local/…` slug is refused with the replacement
+# spelled out, never silently accepted as an engine called "local".
+_LOCAL_SLUG_PREFIX = "local/"
+
+EXIT_REFUSAL = 3
+EXIT_INTERNAL = 2
+
+# Fields an amend may NOT take. `origin` is the loader's stamp, `slug` is the
+# entry's KEY rather than a kwarg, `model` keys files this tool does not move —
+# and each refusal names the command that DOES do the job.
+_DERIVED_FIELDS = {
+    "origin": (
+        "origin is stamped by the loader ('local' for every row in this file), "
+        "not self-declared — provenance is not an editable field. Publishing a "
+        "local model upstream is export_pr.py / docs/BRING_YOUR_OWN.md §5, and "
+        "that flips the field later without renaming the slug you hold"
+    ),
+    "slug": (
+        "the slug is the entry's KEY, not a field: "
+        "scripts/catalog.sh rename --slug <current> --to <engine>/<name>"
+    ),
+    "model": (
+        "the model id keys models.d/<id>.yml and composes/<id>/; changing it here "
+        "would orphan those files. The slug tail is only a label — rename the slug "
+        "instead of the model id"
+    ),
+    "shadowed_by_core": (
+        "shadowed_by_core is reported by the loader, not stored. Rename the entry "
+        "off the curated slug and the mark clears itself"
+    ),
+}
+
+# One definition of the slug shape, shared with the writer that created the row.
+try:  # package context (`from scripts.lib.profiles import amend`)
+    from scripts.lib.profiles.promote import _SLUG_RE
+except Exception:  # pragma: no cover - direct-script context
+    try:
+        from promote import _SLUG_RE  # type: ignore[no-redef]
+    except Exception:  # pragma: no cover - defensive
+        _SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$")
+
+# Importing compose_registry / promote from the checkout must not leave a
+# __pycache__/*.pyc behind inside scripts/lib/profiles/ — that tree is the curated
+# catalog, and the guards that hash it to prove it is untouched cannot tell a
+# bytecode cache from a catalog edit.
+sys.dont_write_bytecode = True
+
+_ENGINE_ID_RE = re.compile(r"^id:\s*(\S+)\s*$")
+
+
+class Refusal(Exception):
+    """A refusal — nothing has been written; fix the input and retry."""
+
+
+class InternalError(Exception):
+    """The write happened and could not be verified. The original is restored."""
+
+
+def _info(msg: str) -> None:
+    print(f"[amend] {msg}", file=sys.stderr)
+
+
+# ── reading the layer ─────────────────────────────────────────────────────────
+def _load_local_raw(root: Path) -> dict:
+    """The RAW ``registry.local.json`` dict ({} when absent).
+
+    A file we cannot parse is a refusal, never a blank slate: this tool rewrites
+    the WHOLE file, so an unreadable one must stop it rather than empty it."""
+    path = root / _LOCAL_REGISTRY_REL
+    if not path.is_file():
+        return {}
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise Refusal(f"{path} is unreadable — fix or remove it first: {exc}")
+    if not isinstance(data, dict) or not all(isinstance(v, dict) for v in data.values()):
+        raise Refusal(f"{path}: expected a JSON object of {{slug: {{_entry kwargs}}}}")
+    return data
+
+
+def _registry_module(root: Path):
+    """compose_registry, preferring the copy under --root (promote.py does the same)."""
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    from scripts.lib.profiles import compose_registry as cr  # noqa: E402
+
+    return cr
+
+
+def _core_slugs(root: Path) -> set:
+    try:
+        return set(_registry_module(root).COMPOSE_REGISTRY)
+    except Exception:
+        return set()
+
+
+def _engine_profile_ids(root: Path) -> set:
+    """Engine PROFILE ids the layer knows: curated ``engines/`` + local ``engines.d/``.
+
+    Read textually rather than through ``load_profiles`` — that validates the
+    whole profile tree, and a rename has nothing to do with whether some
+    unrelated hardware profile parses (a ``--root`` copy is often partial)."""
+    ids: set = set()
+    for base in {root / _CORE_ENGINES_REL, _REPO_ROOT / _CORE_ENGINES_REL,
+                 root / _LOCAL_ENGINES_REL, _REPO_ROOT / _LOCAL_ENGINES_REL}:
+        try:
+            files = sorted(Path(base).glob("*.yml"))
+        except OSError:  # pragma: no cover - unreadable directory
+            continue
+        for f in files:
+            try:
+                for line in f.read_text(encoding="utf-8").splitlines():
+                    m = _ENGINE_ID_RE.match(line)
+                    if m:
+                        ids.add(m.group(1))
+            except (OSError, UnicodeDecodeError):
+                continue
+    return ids
+
+
+def _known_engines(root: Path, raw: dict) -> set:
+    """The engine namespaces a local slug may live under.
+
+    Deliberately the UNION of every vocabulary in play, because the interesting
+    case is the user's OWN engine — a fork of something we ship, which has no
+    curated row and no profile until ``catalog.sh register`` writes one:
+      * curated slug namespaces (``vllm``, ``llamacpp``, ``beellama``, …);
+      * the DEFAULTS / ENGINE_PREFERENCE engine keys;
+      * engine PROFILE ids — curated ``engines/`` and the layer's ``engines.d/``;
+      * the namespaces this layer already uses, so renaming *inside* the user's
+        own engine keeps working however they got there."""
+    engines: set = set()
+    try:
+        cr = _registry_module(root)
+        engines |= {str(s).split("/", 1)[0] for s in cr.COMPOSE_REGISTRY}
+        try:
+            engines |= set(cr.engine_set())
+        except Exception:
+            pass
+    except Exception:
+        pass
+    engines |= _engine_profile_ids(root)
+    engines |= {str(s).split("/", 1)[0] for s in raw}
+    return {e for e in engines if e}
+
+
+# ── --set parsing + validation ────────────────────────────────────────────────
+def _coerce(raw: str):
+    """A CLI value arrives as text; the registry field is not always text.
+
+    Parsed as JSON first, so ``max_ctx=32768`` is an int, ``moe_cache=true`` a
+    bool and ``serve_aliases='["a","b"]'`` a list; anything that is not JSON is
+    taken literally (``status=experimental`` stays a string)."""
+    try:
+        return json.loads(raw)
+    except ValueError:
+        return raw
+
+
+def _editable_field_names(cr) -> set:
+    """The field names a local row accepts — read from ``_entry`` itself, so this
+    list cannot rot the next time the registry grows a kwarg."""
+    try:
+        return set(inspect.signature(cr._entry).parameters) - {"origin"}
+    except (TypeError, ValueError):  # pragma: no cover - defensive
+        return set()
+
+
+def _refuse_if_outside_layer(rel: str, base_rel: str, what: str) -> None:
+    """promote.py's containment rule, applied on the edit path too: a LOCAL row
+    may not point outside its own layer (that is how it comes to reference a
+    curated file it has no business naming)."""
+    p = Path(rel)
+    if p.is_absolute() or ".." in p.parts:
+        raise Refusal(f"{what} must be a repo-relative path without '..': {rel!r}")
+    if not p.is_relative_to(Path(base_rel)):
+        raise Refusal(
+            f"a LOCAL entry's {what} must live under {base_rel}/ (got {rel!r}) — "
+            f"the curated catalog is not editable from this layer"
+        )
+
+
+def _refuse_curated_port(cr, want) -> None:
+    """Keep LOCAL rows out of the curated port band. promote.py refuses it at
+    write time; an edit must not be the door that walks back in (#1142)."""
+    if want is None:
+        return
+    try:
+        core_ports = {e.get("default_port") for e in cr.COMPOSE_REGISTRY.values()}
+    except Exception:
+        return
+    if want in core_ports:
+        raise Refusal(
+            f"default_port {want} is already used by the curated catalog. LOCAL "
+            f"models live in the 202xx band (20200 + crc32(model_id) % 100, the "
+            f"value promote.py and c3 assign) so a `git pull` of new curated slugs "
+            f"can never collide with yours — and keep the compose's "
+            f"${{PORT:-NNNN}} in step with the entry"
+        )
+
+
+def _apply_sets(cr, entry: dict, sets: list, slug: str, namespace: str) -> tuple:
+    """The amended row + human-readable notes. Raises Refusal."""
+    allowed = _editable_field_names(cr)
+    new = dict(entry)
+    notes: list = []
+    for item in sets:
+        if "=" not in item:
+            raise Refusal(f"--set expects KEY=VALUE, got {item!r}")
+        key, raw = item.split("=", 1)
+        key = key.strip()
+        if not key:
+            raise Refusal(f"--set expects KEY=VALUE, got {item!r}")
+        if key in _DERIVED_FIELDS:
+            raise Refusal(f"--set {key}=… is not editable: {_DERIVED_FIELDS[key]}")
+        if allowed and key not in allowed:
+            raise Refusal(
+                f"{key!r} is not a registry field. Editable: "
+                f"{', '.join(sorted(allowed - set(_DERIVED_FIELDS)))}"
+            )
+        value = _coerce(raw)
+        if key == "engine":
+            # The invariant, stated before the write: naming an engine is what
+            # the slug namespace already does.
+            if str(value) != namespace:
+                raise Refusal(
+                    f"the engine of a local entry IS its slug namespace "
+                    f"({namespace!r}). To move the entry to another engine, rename "
+                    f"it: --slug {slug} --to {namespace}/{slug.split('/', 1)[-1]}"
+                )
+            notes.append(f"engine    {namespace!r} (unchanged — it is the namespace)")
+        elif key == "compose_path":
+            _refuse_if_outside_layer(str(value), _LOCAL_COMPOSES_REL, "compose_path")
+            notes.append(f"path      {entry.get('compose_path')!r} -> {value!r}")
+        elif key == "status":
+            statuses = set(getattr(cr, "STATUS_VALUES", ()) or ())
+            if statuses and str(value) not in statuses:
+                raise Refusal(
+                    f"status {value!r} is not in the status enum: "
+                    f"{', '.join(sorted(statuses))}"
+                )
+            notes.append(f"status    {entry.get('status')!r} -> {value!r}")
+        elif key == "default_port":
+            _refuse_curated_port(cr, value)
+            notes.append(f"port      {entry.get('default_port')!r} -> {value!r}")
+        else:
+            notes.append(f"{key:9s} {entry.get(key, '(unset)')!r} -> {value!r}")
+        new[key] = value
+    return new, notes
+
+
+# ── planning ──────────────────────────────────────────────────────────────────
+def _refuse_if_not_local(raw: dict, root: Path, slug: str) -> None:
+    """Only a row that PHYSICALLY LIVES in the local layer may be amended.
+
+    Location, not name: a SHADOWED local row shares its slug with a curated one,
+    and un-shadowing it is exactly what this tool is for — so the curated check
+    below only explains a refusal, it never overrides the local one."""
+    if slug in raw:
+        return
+    # Checked before the empty-layer case: "nothing is registered yet" is true but
+    # not the point when the name asked for is a shipped one.
+    if slug in _core_slugs(root):
+        raise Refusal(
+            f"{slug!r} is a CURATED catalog entry, not a local one. This tool only "
+            f"amends {_LOCAL_REGISTRY_REL}; a curated entry is git-tracked and git "
+            f"is its edit tool."
+        )
+    if not raw:
+        raise Refusal(
+            f"{_LOCAL_REGISTRY_REL} has no entries, so there is nothing to amend. "
+            f"Register one first: scripts/catalog.sh register --compose <path>"
+        )
+    known = ", ".join(sorted(raw)) or "(none registered)"
+    raise Refusal(f"{slug} is not in {_LOCAL_REGISTRY_REL}. Registered: {known}")
+
+
+def _wrap(cr, row: dict):
+    """(ok, error) — does this row survive the loader's own ``_entry`` wrap?"""
+    try:
+        cr._entry(origin="local", **row)
+    except TypeError as exc:
+        return False, f"not valid registry kwargs: {exc}"
+    except ValueError as exc:
+        return False, f"rejected by the registry: {exc}"
+    return True, ""
+
+
+def plan_amend(root: Path, slug: str, to: str = "", sets: Optional[list] = None) -> dict:
+    """The candidate layer + the plan. Pure: reads only, never writes."""
+    sets = list(sets or [])
+    if not to and not sets:
+        raise Refusal("nothing to do: pass --to <engine>/<name> and/or --set KEY=VALUE")
+
+    raw = _load_local_raw(root)
+    _refuse_if_not_local(raw, root, slug)
+    cr = _registry_module(root)
+    entry = raw[slug]
+
+    candidate = {k: dict(v) for k, v in raw.items()}
+    notes: list = []
+    engine_noted = False
+
+    # ── rename: change the KEY (and the engine, which the namespace owns) ────
+    new_slug = slug
+    if to:
+        to = to.strip()
+        if to == slug:
+            raise Refusal(
+                f"--to equals the current slug ({slug!r}) — nothing to rename. "
+                f"Editing a field is: --slug {slug} --set KEY=VALUE"
+            )
+        if to.startswith(_LOCAL_SLUG_PREFIX):
+            raise Refusal(
+                f"the {_LOCAL_SLUG_PREFIX!r} namespace was removed (#1202). Local "
+                f"slugs use '<engine>/<name>' and provenance lives in the entry's "
+                f"origin field. Use '--to "
+                f"{slug.split('/', 1)[0]}/{to[len(_LOCAL_SLUG_PREFIX):]}'."
+            )
+        if not _SLUG_RE.match(to):
+            raise Refusal(
+                f"bad slug {to!r} — expected '<engine>/<name>' "
+                f"(pattern {_SLUG_RE.pattern})"
+            )
+        new_ns = to.split("/", 1)[0]
+        # ⛔ THE TARGET MATTERS AS MUCH AS THE SOURCE. Renaming ONTO a curated
+        # slug re-creates the shadowing this command exists to cure.
+        if to in _core_slugs(root):
+            raise Refusal(
+                f"{to!r} is a CURATED slug — core wins every lookup, so renaming "
+                f"onto it would leave this entry shadowed and unreachable again. "
+                f"Pick another name: --to {new_ns}/<something-else>"
+            )
+        if to in raw:
+            raise Refusal(
+                f"{to!r} is already registered locally; renaming onto it would "
+                f"silently replace that entry. Remove it first: "
+                f"scripts/catalog.sh unregister --slug {to}"
+            )
+        known = _known_engines(root, raw)
+        if new_ns not in known:
+            raise Refusal(
+                f"{new_ns!r} is not a known engine, so the entry would name a "
+                f"runtime nothing can resolve. Known engines: "
+                f"{', '.join(sorted(known))}. An engine we do not ship gets its "
+                f"profile from scripts/catalog.sh register --engine {new_ns} …"
+            )
+        new_slug = to
+        moved = dict(entry)
+        moved["engine"] = new_ns
+        notes.append(f"slug      {slug} -> {to}")
+        engine_noted = str(entry.get("engine")) != new_ns
+        if engine_noted:
+            notes.append(
+                f"engine    {entry.get('engine')!r} -> {new_ns!r} "
+                f"(a local entry's engine is its slug namespace)"
+            )
+        if str(entry.get("model") or "") != to.split("/", 1)[-1]:
+            notes.append(
+                f"model id  {entry.get('model')!r} KEPT — models.d/ and composes/ "
+                f"keep their names (the slug tail is a label, not the model id)"
+            )
+        candidate.pop(slug, None)
+        candidate[to] = moved
+
+    # ── --set: edit fields of the (possibly renamed) row ─────────────────────
+    if sets:
+        amended, set_notes = _apply_sets(
+            cr, candidate[new_slug], sets, new_slug, new_slug.split("/", 1)[0]
+        )
+        candidate[new_slug] = amended
+        notes.extend(set_notes)
+
+    # ── THE INVARIANT: engine == the slug's namespace, for EVERY row here ────
+    repairs = {}
+    for s, row in candidate.items():
+        ns = str(s).split("/", 1)[0]
+        if str(row.get("engine")) != ns:
+            repairs[s] = (row.get("engine"), ns)
+            row["engine"] = ns
+    for drifted, (old_engine, ns) in repairs.items():
+        if drifted == new_slug and engine_noted:
+            continue  # already reported as part of the rename
+        notes.append(
+            f"engine    {(drifted == new_slug and 'this entry') or drifted}: "
+            f"{old_engine!r} -> {ns!r} (repaired — a local entry's engine is its "
+            f"slug namespace)"
+        )
+
+    _validate_row(cr, candidate, new_slug, entry)
+    return {
+        "root": root,
+        "slug": slug,
+        "to": new_slug,
+        "renamed": new_slug != slug,
+        "entry": candidate[new_slug],
+        "candidate": candidate,
+        "notes": notes,
+        "repairs": repairs,
+    }
+
+
+def _validate_row(cr, candidate: dict, key: str, original: dict) -> None:
+    """Dry-wrap the row about to be written exactly as the loader will.
+
+    Only what THIS amend could break: a row that already failed to wrap before
+    the edit is the layer's pre-existing problem, and refusing here would make a
+    broken layer unfixable from inside it. The full layer gets re-loaded after
+    the write (see ``amend_local``)."""
+    row = candidate[key]
+    if key.count("/") != 1 or key.startswith("/") or key.endswith("/"):
+        raise Refusal(f"slug {key!r} must be '<engine>/<name>'")
+    if "origin" in row:
+        raise Refusal(f"--set origin=… is not editable: {_DERIVED_FIELDS['origin']}")
+    ok_before, _ = _wrap(cr, original)
+    ok, err = _wrap(cr, row)
+    if not ok and ok_before:
+        raise Refusal(f"the amended row is refused by the registry: {err}")
+    if not ok:
+        _info(f"note: this row was already refused by the registry before the "
+              f"amend ({err}); it is written as amended")
+
+
+# ── writing ───────────────────────────────────────────────────────────────────
+def _layer_loads(root: Path):
+    """(ok, error) — does the layer load through the loader every launcher uses?"""
+    try:
+        cr = _registry_module(root)
+    except Exception as exc:  # pragma: no cover - broken checkout
+        return False, f"compose_registry does not import: {exc}"
+    try:
+        cr.load_local_registry(root)
+    except Exception as exc:
+        return False, str(exc)
+    return True, ""
+
+
+def _write_registry(root: Path, candidate: dict) -> None:
+    """Atomic rewrite of registry.local.json (temp sibling + os.replace)."""
+    reg = root / _LOCAL_REGISTRY_REL
+    tmp = reg.with_name(reg.name + ".tmp")
+    text = json.dumps(candidate, indent=2, ensure_ascii=False) + "\n"
+    try:
+        reg.parent.mkdir(parents=True, exist_ok=True)
+        tmp.write_text(text, encoding="utf-8")
+        os.replace(tmp, reg)
+    except OSError as exc:
+        try:
+            tmp.unlink(missing_ok=True)
+        except OSError:
+            pass
+        raise InternalError(f"could not rewrite {_LOCAL_REGISTRY_REL}: {exc}")
+
+
+def describe(plan: dict) -> str:
+    lines = list(plan["notes"]) or [f"nothing changes for {plan['to']}"]
+    lines.append(f"file      {_LOCAL_REGISTRY_REL} (the entry only — no files move)")
+    lines.append("core      scripts/lib/profiles/ is never opened for writing")
+    return "\n".join(f"[amend]   {ln}" for ln in lines)
+
+
+def amend_local(root: Path, slug: str, to: str = "", sets: Optional[list] = None,
+                *, dry_run: bool = False) -> dict:
+    """Apply the amend. Returns the plan. Raises Refusal / InternalError."""
+    plan = plan_amend(root, slug, to, sets)
+    print(describe(plan), file=sys.stderr)
+    if dry_run:
+        _info("--dry-run — nothing written")
+        return plan
+
+    reg = root / _LOCAL_REGISTRY_REL
+    original = reg.read_bytes() if reg.is_file() else None
+    # Was the layer loadable BEFORE we touched it? An amend must never turn a
+    # working layer into a broken one — that gets rolled back. But a layer that
+    # was ALREADY broken (for a reason outside this one row) has to stay fixable
+    # from here, so a failure that pre-existed is reported, not undone.
+    before_ok, before_err = _layer_loads(root)
+
+    _write_registry(root, plan["candidate"])
+    after_ok, after_err = _layer_loads(root)
+    if not after_ok:
+        if before_ok:
+            try:
+                if original is None:
+                    reg.unlink(missing_ok=True)
+                else:
+                    reg.write_bytes(original)
+            except OSError as exc:  # pragma: no cover - desperate
+                raise InternalError(
+                    f"the layer does not load after the amend AND the rollback "
+                    f"failed: {exc}\n[amend] original bytes: {original!r}"
+                )
+            raise InternalError(
+                f"the layer does not load after the amend — rolled back: {after_err}"
+            )
+        _info(
+            f"⚠ the amend is written, but the layer does not load: {after_err}\n"
+            f"[amend]   it did not load before this amend either ({before_err}) — "
+            f"fix the row the loader names before launching"
+        )
+    elif plan["renamed"] and plan["slug"] in _core_slugs(root):
+        _info(f"{plan['slug']} was SHADOWED by a curated entry — it resolves again "
+              f"as {plan['to']}")
+    return plan
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    ap = argparse.ArgumentParser(
+        prog="amend.py",
+        description="Rename or edit an entry in the LOCAL catalog layer "
+                    "(never the curated catalog).",
+    )
+    ap.add_argument("--slug", required=True, help="the local <engine>/<name> to amend")
+    ap.add_argument("--to", default="", metavar="NEW",
+                    help="rename: the new <engine>/<name>")
+    ap.add_argument("--set", dest="sets", action="append", metavar="KEY=VALUE",
+                    help="edit a registry field (repeatable), e.g. --set max_ctx=32768")
+    ap.add_argument("--root", default=str(_DEFAULT_ROOT), help="repo root")
+    ap.add_argument("--dry-run", action="store_true", help="print the plan, write nothing")
+    # Deliberate: no interactive confirmation, and so no -y either. #1204 marked a
+    # shadowed entry "so the user can rename it", and a gate needing a TTY would
+    # leave that remedy unreachable from the very scripts and docs advertising it.
+    # The plan is printed before the write; the layer is the user's own tree, and
+    # an amend is one rename away from being undone.
+    args = ap.parse_args(argv)
+
+    root = Path(args.root).resolve()
+    try:
+        amend_local(root, args.slug, args.to, args.sets, dry_run=args.dry_run)
+    except Refusal as exc:
+        print(f"[amend] refused: {exc}", file=sys.stderr)
+        return EXIT_REFUSAL
+    except InternalError as exc:
+        print(f"[amend] FAILED: {exc}", file=sys.stderr)
+        return EXIT_INTERNAL
+    if args.dry_run:
+        return 0
+    if args.to:
+        print(f"RENAME_OK {args.to.strip()} (was {args.slug})")
+    else:
+        print(f"UPDATE_OK {args.slug}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
