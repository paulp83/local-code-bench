+def local_engine_profile(spec: dict) -> tuple[str, str]:
+    """The pending LOCAL engine profile as ``(engine_id, yaml_text)``, or ("", "").
+
+    Registering a compose whose engine the catalog does not ship (someone's own
+    build) needs an ENGINE profile too — cross-reference validation cannot
+    resolve a slug whose engine resolves nowhere. ``catalog.sh`` DERIVES that
+    profile from evidence and hands it over as ``spec["local_engine_profile"]``
+    instead of writing the file itself: the plan, the ``--dry-run`` exit and the
+    layer confirm all live HERE, so a write that happened out there could not be
+    stopped by any of them — a ``--dry-run`` register used to leave an
+    ``engines.d/<engine>.yml`` behind.
+
+    Accepted shapes: the YAML text, or ``{"engine": ID, "content": TEXT}``
+    (``id`` / ``yaml`` / ``text`` read too), or the profile MAPPING itself. With
+    no explicit id the engine is the slug's namespace, which IS the engine for a
+    local ``<engine>/<name>`` slug.
+
+    The id is validated because it becomes a FILENAME; the content is not, which
+    is deliberate — this layer exists so the user states their own engine's
+    capabilities, and refusing a field this tool merely guesses at is the
+    guessing it exists to avoid. Raises Refusal (nothing written) for a value
+    that cannot become a file inside engines.d/.
+    """
+    raw = spec.get("local_engine_profile")
+    if raw is None:
+        return "", ""
+    # A local slug IS `<engine>/<name>`, so the namespace is the engine whenever
+    # the spec does not state one.
+    slug_engine = str((spec.get("registry_entry") or {}).get("slug") or "").split(
+        "/", 1
+    )[0]
+
+    if isinstance(raw, str):
+        engine, text = "", raw
+    elif isinstance(raw, dict):
+        engine = str(raw.get("engine") or raw.get("id") or raw.get("engine_id") or "")
+        text = raw.get("content") or raw.get("yaml") or raw.get("text") or ""
+        if not isinstance(text, str):
+            raise Refusal(
+                "spec.local_engine_profile.content must be a string (the ENGINE "
+                "profile YAML)"
+            )
+        if not text.strip():
+            # The profile handed over as a MAPPING: render it with the ONE YAML
+            # emitter the ModelProfile uses, in the schema's own key order.
+            body = {k: v for k, v in raw.items() if k not in ("engine", "engine_id")}
+            if not body:
+                return "", ""
+            if raw.get("id") and engine and str(raw["id"]) != engine:
+                raise Refusal(
+                    f"spec.local_engine_profile.id {raw['id']!r} != engine "
+                    f"{engine!r} — one profile, one id"
+                )
+            rendered: dict[str, Any] = {"schema_version": body.pop("schema_version", 1)}
+            rendered["id"] = engine or slug_engine
+            rendered.update({k: v for k, v in body.items() if k != "id"})
+            text = "\n".join(_yaml_dump(rendered)) + "\n"
+    else:
+        raise Refusal(
+            "spec.local_engine_profile must be the ENGINE profile YAML (a string) "
+            "or {engine, content}"
+        )
+
+    if not text.strip():
+        return "", ""                    # nothing to carry — treat as absent
+    engine = engine.strip() or slug_engine
+    if not _ENGINE_ID_RE.match(engine or ""):
+        raise Refusal(
+            f"bad engine id for spec.local_engine_profile: {engine!r} — expected "
+            "[a-z0-9][a-z0-9._-]* (it becomes the engines.d/<engine>.yml filename)"
+        )
+    return engine, (text if text.endswith("\n") else text + "\n")
+
+
