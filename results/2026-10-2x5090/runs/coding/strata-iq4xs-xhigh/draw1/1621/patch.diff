+# thinking_budget_engine_kind with one more piece of evidence: the image read
+# out of the container's OWN inspect JSON (the payload a caller already needs to
+# read the boot command), so a server whose engine is visible only there — or
+# whose `docker inspect --format` answer is empty — is still classified. Order:
+# container name, inspect-JSON image, then thinking_budget_engine_kind (which
+# adds the `--format` image and the /v1/models `owned_by` fingerprint). The
+# DECISION stays engine-kind.sh's (#1282) — this only gathers evidence.
+thinking_budget_engine_kind_deep() {
+  local c="${1:-${CONTAINER:-}}" kind="unknown" img=""
+  if [[ -n "$c" && "$c" != "none" ]]; then
+    kind="$(engine_kind_from_container "$c")"
+    if [[ "$kind" == "unknown" ]]; then
+      img="$(docker inspect "$c" 2>/dev/null | python3 -c 'import json, sys
+try:
+    d = json.load(sys.stdin)
+except Exception:
+    sys.exit(0)
+if isinstance(d, list):
+    d = d[0] if d else {}
+print(((d or {}).get("Config") or {}).get("Image") or "")' 2>/dev/null || true)"
+      [[ -n "$img" ]] && kind="$(engine_kind_from_image "$img")"
+    fi
+  fi
+  if [[ "$kind" == "unknown" ]]; then kind="$(thinking_budget_engine_kind)"; fi
+  echo "$kind"
+  return 0
+}
+
+# What reasoning budget the llama.cpp server was booted with — the flag's
+# RESOLVED value, never its presence ($1 = container, default $CONTAINER).
+# stdout, one line:
+#   <N>                 the budget in effect (negative = unrestricted: llama.cpp's -1)
+#   none                no --reasoning-budget at all, or a negative value: unrestricted
+#   unresolvable <why>  the flag is there but its value cannot be resolved
+# Always rc 0 — `none` and `unresolvable` are answers, not errors. The reader
+# under it resolves `${REASONING_BUDGET:--N}` (and `$VAR`, quotes, script strings,
+# the last occurrence winning) through Config.Env exactly as the entrypoint
+# would, so a compose that ships the flag with its env never set reads back -1,
+# not "budgeted".
+thinking_budget_llamacpp_boot_budget() {
+  local c="${1:-${CONTAINER:-}}" facts=""
+  if [[ -z "$c" || "$c" == "none" ]] || ! command -v docker >/dev/null 2>&1; then
+    echo "unresolvable no serving container (container '${c:-unset}')"
+    return 0
+  fi
+  facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts llamacpp)"
+  case "$facts" in
+    "BUDGET none")    echo "none" ;;
+    # llama.cpp treats a negative budget as unrestricted; -1 is what the
+    # composes' `${REASONING_BUDGET:--1}` resolves to when the env was unset.
+    "BUDGET -"*[0-9]) echo "none" ;;
+    "BUDGET "[0-9]*)  echo "${facts#BUDGET }" ;;
+    "BUDGET unresolvable "*) echo "unresolvable ${facts#BUDGET unresolvable }" ;;
+    *) echo "unresolvable ${facts:-no output from docker inspect}" ;;
+  esac
+  return 0
+}
