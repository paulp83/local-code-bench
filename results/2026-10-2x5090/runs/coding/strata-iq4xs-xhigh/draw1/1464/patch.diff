diff --git a/scripts/tests/test-switch-refuse-before-teardown.sh b/scripts/tests/test-switch-refuse-before-teardown.sh
new file mode 100755
index 0000000..06d7087
--- /dev/null
+++ b/scripts/tests/test-switch-refuse-before-teardown.sh
@@ -0,0 +1,143 @@
+#!/usr/bin/env bash
+# Test for switch.sh refusal ORDER: a launch a check refuses must not have
+# touched the running variant.
+#
+# The bug: switch.sh brought the running slug down FIRST and only then ran the
+# checks that can say no, so a refused launch left the rig serving nothing. Hit
+# twice on the reference rig in one day —
+#   • an experimental slug run without --force;
+#   • a worktree whose model files weren't on the host (no MODEL_DIR);
+# and a mistyped slug did the same.
+#
+# Contract (all three must refuse with the rig still up):
+#   1. unknown / mistyped slug          → "unknown variant"
+#   2. (NA: …) slug without --force     → "not a reliable config"
+#   3. compose whose weights are absent → "aren't on host"
+# and the two controls that keep the fix honest:
+#   4. NEGATIVE CONTROL: an accepted launch still tears the old one down and
+#      brings the new one up (a "fix" that never tears down is worse);
+#   5. --force still forces an (NA) slug through the gate.
+#   6. STRUCTURAL: the refusing phase is wired before down_running in main.
+#
+# Harness: real scripts/switch.sh, mock `docker` on PATH (records every teardown
+# call), COMPOSE_BIN=: so nothing can boot, PREFLIGHT_NO_FETCH=1 so no git
+# network. Fully offline — no docker daemon, no GPU, no model boot.
+set -uo pipefail
+
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0
+FAIL=0
+assert_contains() {
+  local haystack="$1" needle="$2" label="$3"
+  if [[ "$haystack" == *"$needle"* ]]; then PASS=$((PASS + 1)); else
+    echo "FAIL: ${label}: expected output to CONTAIN: ${needle}" >&2
+    echo "--- switch.sh output ---" >&2; printf '%s\n' "$haystack" >&2
+    FAIL=$((FAIL + 1))
+  fi
+}
+assert_not_contains() {
+  local haystack="$1" needle="$2" label="$3"
+  if [[ "$haystack" != *"$needle"* ]]; then PASS=$((PASS + 1)); else
+    echo "FAIL: ${label}: expected output to NOT contain: ${needle}" >&2
+    echo "--- switch.sh output ---" >&2; printf '%s\n' "$haystack" >&2
+    FAIL=$((FAIL + 1))
+  fi
+}
+assert_refused() {  # <rc> <label> — a refused launch must exit non-zero
+  if [[ "$1" != 0 ]]; then PASS=$((PASS + 1)); else
+    echo "FAIL: ${2}: expected a non-zero exit (the launch was supposed to be refused)" >&2
+    FAIL=$((FAIL + 1))
+  fi
+}
+
+tmp_dir="$(mktemp -d)"
+cleanup() { rm -rf "$tmp_dir"; }
+trap cleanup EXIT
+
+BIN="${tmp_dir}/bin"; mkdir -p "$BIN"
+EMPTY_MODELS="${tmp_dir}/models"; mkdir -p "$EMPTY_MODELS"
+export CALLS="${tmp_dir}/docker-calls.log"; : > "$CALLS"
+
+# --- mock `docker`: `ps` reports ONE managed container; every teardown call
+# (compose down / stop) is appended to $CALLS. Nothing else is recorded, so an
+# empty $CALLS is proof the running container was left alone.
+cat > "${BIN}/docker" <<'DOCKERMOCK'
+#!/usr/bin/env bash
+sub="$1"; shift || true
+case "$sub" in
+  ps)      printf 'beellama-qwen36-27b\n' ;;
+  inspect) printf '\n' ;;                                  # no labels → stop path
+  stop)    printf 'STOP %s\n' "${1:-}" >> "$CALLS" ;;
+  compose) printf 'COMPOSE %s\n' "$*" >> "$CALLS" ;;
+esac
+exit 0
+DOCKERMOCK
+chmod +x "${BIN}/docker"
+
+run_switch() {  # <label> <args…> — records output/rc + any teardown call
+  local label="$1"; shift
+  : > "$CALLS"
+  SWITCH_OUT="$(COMPOSE_BIN=: PATH="${BIN}:${PATH}" MODEL_DIR="$EMPTY_MODELS" \
+                PREFLIGHT_NO_FETCH=1 PREFLIGHT_NO_COMPOSE_DEPS="${DEPS:-0}" \
+                timeout 300 bash scripts/switch.sh "$@" 2>&1)"
+  SWITCH_RC=$?
+  SWITCH_TEARDOWN="$(cat "$CALLS")"
+}
+
+# --- 1. mistyped slug --------------------------------------------------------
+run_switch "typo" vllm/minimal-not-a-slug --no-wait
+assert_refused "$SWITCH_RC" "mistyped slug refused"
+assert_contains "$SWITCH_OUT" "unknown variant" "mistyped slug names the bad slug"
+assert_not_contains "$SWITCH_OUT" "bringing down" "mistyped slug: no teardown announced"
+assert_not_contains "$SWITCH_TEARDOWN" "STOP" "mistyped slug: docker never called to stop"
+
+# --- 2. (NA: …) slug without --force ----------------------------------------
+run_switch "na" llamacpp/deepseek-flash-dual-q8 --no-wait
+assert_refused "$SWITCH_RC" "(NA) slug refused without --force"
+assert_contains "$SWITCH_OUT" "not a reliable config" "(NA) gate fires"
+assert_not_contains "$SWITCH_OUT" "bringing down" "(NA) slug: no teardown announced"
+assert_not_contains "$SWITCH_TEARDOWN" "STOP" "(NA) slug: docker never called to stop"
+
+# --- 3. weights missing from the host ---------------------------------------
+# vllm/minimal is a PRODUCTION slug, so this isolates the model-file check
+# (PREFLIGHT_NO_COMPOSE_DEPS is left OFF here, unlike runs 1/2/4).
+DEPS=0 run_switch "weights" vllm/minimal --no-wait
+assert_refused "$SWITCH_RC" "missing weights refused"
+assert_contains "$SWITCH_OUT" "aren't on host" "model-file check fires"
+assert_not_contains "$SWITCH_OUT" "bringing down" "missing weights: no teardown announced"
+assert_not_contains "$SWITCH_TEARDOWN" "STOP" "missing weights: docker never called to stop"
+
+# --- 4. NEGATIVE CONTROL: an accepted launch still switches ------------------
+DEPS=1 run_switch "accept" vllm/minimal --no-wait
+assert_contains "$SWITCH_OUT" "bringing down: beellama-qwen36-27b" "accepted launch tears the old slug down"
+assert_contains "$SWITCH_OUT" "bringing up: vllm/minimal" "accepted launch brings the new slug up"
+if [[ "$SWITCH_TEARDOWN" == *"STOP"* ]]; then PASS=$((PASS + 1)); else
+  echo "FAIL: accepted launch: the mock docker recorded no stop call" >&2
+  echo "--- switch.sh output ---" >&2; printf '%s\n' "$SWITCH_OUT" >&2
+  FAIL=$((FAIL + 1))
+fi
+
+# --- 5. --force still forces an (NA) slug through the gate -------------------
+DEPS=1 run_switch "force" --force beellama/dflash --no-wait
+assert_contains "$SWITCH_OUT" "WARNING: forcing" "--force still forces an (NA) slug"
+assert_contains "$SWITCH_OUT" "bringing up: beellama/dflash" "--force launch proceeds to the bring-up"
+
+# --- 6. STRUCTURAL: the refusing phase is wired before the teardown ----------
+gate_line="$(command grep -n '^preflight_variant "${VARIANT}"$' scripts/switch.sh | head -1 | cut -d: -f1)"
+down_line="$(command grep -n '^down_running$' scripts/switch.sh | head -1 | cut -d: -f1)"
+if [[ -n "$gate_line" && -n "$down_line" && "$gate_line" -lt "$down_line" ]]; then
+  PASS=$((PASS + 1))
+else
+  echo "FAIL: main flow must run preflight_variant before down_running" >&2
+  echo "      preflight_variant@${gate_line:-missing}  down_running@${down_line:-missing}" >&2
+  FAIL=$((FAIL + 1))
+fi
+
+echo "----------------------------------------"
+echo "PASS: $PASS   FAIL: $FAIL"
+[[ "$FAIL" -eq 0 ]] || exit 1
+echo "OK: switch.sh refuses a launch before tearing down the running slug"
