+def _compose_facts():
+    """The shared compose-facts module — lazy import, cached by the import system.
+
+    Raises ImportError rather than guessing: every cockpit path that gets here
+    runs inside the checkout."""
+    import os
+    import sys
+    from pathlib import Path
+
+    try:
+        from scripts.lib.profiles import compose_facts as mod
+    except ModuleNotFoundError:
+        mod = None
+    if getattr(mod, "derive_compose_facts", None) is not None:
+        return mod
+
+    # ``services.CockpitData`` puts the repo root on sys.path, but data.py has to
+    # work without a constructed data layer (the panes' pure helpers and the
+    # tests import it directly).  Insert ONLY a root that really carries THIS
+    # module — a tmp fixture root would shadow the real package tree.
+    root = Path(os.environ.get("C3_REPO_ROOT") or Path(__file__).resolve().parents[3])
+    if not (root / "scripts" / "lib" / "profiles" / "compose_facts.py").is_file():
+        raise ImportError(
+            "compose facts unavailable: scripts/lib/profiles/compose_facts.py is "
+            f"not importable and the repo root at {root} has none — run inside the "
+            "club-3090 checkout, or set C3_REPO_ROOT"
+        )
+    if str(root) not in sys.path:
+        sys.path.insert(0, str(root))
+    from scripts.lib.profiles import compose_facts as shared
+    return shared
+
+
+def __getattr__(name: str):
+    """PEP 562: re-export the names that moved into the shared profiles module."""
+    if name in MOVED_NAMES:
+        return getattr(_compose_facts(), name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
