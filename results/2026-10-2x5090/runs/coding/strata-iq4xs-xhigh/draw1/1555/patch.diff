 # peak under "4x RTX 3090". The container's GPUs come from `docker inspect`, read by
 # run_context.visible_gpu_selectors (DeviceRequests, then NVIDIA_VISIBLE_DEVICES, then
 # CUDA_VISIBLE_DEVICES) — the same reading quality-test.sh's run metadata uses.
+def _split_device_id_entries(inspect):
+    """Compose interpolates ``device_ids: ["${ESTATE_GPUS}"]`` into ONE DeviceIDs entry
+    holding ``"2,3"`` (docker passes that string through verbatim), and a selector of
+    ``"2,3"`` matches no ``nvidia-smi`` row — the container then read as seeing zero GPUs
+    and the probe's VRAM and GPU label silently fell back to rig-wide (#1537). Split every
+    comma-separated entry so ``["2,3"]`` is the same two GPUs as ``["2", "3"]``.
+
+    Returns the same object untouched when there is nothing to split (a Compose-free rig's
+    ``docker inspect`` is passed to ``run_context`` exactly as it arrived)."""
+    if not isinstance(inspect, dict):
+        return inspect
+    requests = (inspect.get("HostConfig") or {}).get("DeviceRequests")
+    if not isinstance(requests, list):
+        return inspect
+    split = False
+    out_requests = []
+    for req in requests:
+        if isinstance(req, dict) and isinstance(req.get("DeviceIDs"), list):
+            ids = []
+            for entry in req["DeviceIDs"]:
+                parts = [p.strip() for p in str(entry).split(",") if p.strip()]
+                if len(parts) > 1:
+                    split = True
+                ids.extend(parts)
+            req = {**req, "DeviceIDs": ids}
+        out_requests.append(req)
+    if not split:
+        return inspect
+    host = {**(inspect.get("HostConfig") or {}), "DeviceRequests": out_requests}
+    return {**inspect, "HostConfig": host}
+
