+# The "the tool itself never ran" signatures. Deliberately a DIFFERENT
+# detector from the Xet wall: here nothing reached the hub, so there is no
+# hub verdict to reason about — and, unlike the wall, the failure says nothing
+# about whether the *file* is fetchable. Rung 3 (raw resolve + curl) does not
+# invoke `hf` at all, so a missing CLI must never end the ladder.
+#
+# Narrow on purpose. A loose "not found" would swallow the hub's own
+# "404 Not Found" / "Repository not found" (a gated-or-wrong-slug problem the
+# fallback cannot fix), so what is matched is the *exec* failure vocabulary of
+# shells and POSIX errno 2, plus the CLI's own PATH message.
+_COMMAND_NOT_FOUND_MARKERS = (
+    "command not found",
+    "not recognized as an internal or external command",
+    "not on path",
+    "not in path",
+    "not found on the path",
+    "could not be found on the path",
+    "executable file not found",
+    "no such file or directory",
+)
+
+# "… is on PATH" is how this module has always phrased the complaint ("neither
+# `hf` nor `huggingface-cli` is on PATH"), and a bare "on path" substring would
+# also catch a hint that merely mentions PATH. Pairing it with the tool's name
+# keeps it a statement ABOUT the tool instead of an uncorroborated phrase match.
+_ON_PATH_RE = re.compile(r"(?:hf|the cli|cli)[^\n]{0,60}?is on path")
+
+# The shell's conventional "I could not run that" codes: 127 (no such command)
+# and 126 (found, not executable — a noexec mount, a venv without its bit).
+# Accepted on their own, because the wrapper that produces them (`sh -c`, a CI
+# launcher, a systemd ExecStart) often prints nothing at all.
+_RC_COMMAND_NOT_FOUND = 127
+_RC_NOT_EXECUTABLE = 126
+
+
+def is_command_not_found(blob: str, rc: Optional[int] = None) -> bool:
+    """True iff rung 1 failed because the `hf` CLI could not be **run**.
+
+    Complements ``is_xet_refusal``: that one is a hub-side policy wall, this
+    one is "no tool". Both are fallback-eligible, for different reasons — the
+    wall because retrying is futile, this because rung 3 has no `hf`
+    dependency at all. `rc` (the rung-1 exit code) is honoured on its own:
+    126/127 *are* "could not run the command" even with an empty blob."""
+    if rc is not None:
+        try:
+            code = int(rc)
+        except (TypeError, ValueError):
+            code = None
+        if code in (_RC_COMMAND_NOT_FOUND, _RC_NOT_EXECUTABLE):
+            return True
+    low = (blob or "").lower()
+    if any(m in low for m in _COMMAND_NOT_FOUND_MARKERS):
+        return True
+    return bool(_ON_PATH_RE.search(low))
+
+
+# The issue's own word for this class of failure; one function, two names.
+is_tool_unavailable = is_command_not_found
+
+
+# Carried on the result so a caller (the CLI, the cockpit log pane) can point
+# at the missing tool even when the failure it finally died on was rung 3's.
+NOTE_HF_MISSING = ("rung 1 (classic LFS) did not run: the `hf` CLI is not on "
+                   "PATH (command not found)")
+
+
+def is_fallback_eligible(blob: str, rc: Optional[int] = None) -> bool:
+    """Either reason the ladder may leave rung 1: the too-large wall, or a
+    `hf` that never started. Anything else (401, ENOSPC, …) is a verdict the
+    fallback rungs cannot improve and must keep its existing mapping."""
+    return is_xet_refusal(blob) or is_command_not_found(blob, rc=rc)
+
