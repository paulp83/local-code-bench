+# vLLM states what it actually booted with once, at startup, in its own dump:
+#   (APIServer pid=1) INFO ... [utils.py:250] non-default args: {'model': '/models/x', 'reasoning_parser': 'qwen3', ...}
+# An image that starts vLLM THROUGH ITS OWN LAUNCHER adds --reasoning-parser
+# inside that script, so `docker inspect` argv shows none and the log is the
+# only place the parser is visible (seen on bucko's official image, whose
+# `qwen38-serve` adds `--reasoning-parser qwen3`). vLLM prints a key only when
+# it is NON-DEFAULT, i.e. only when a parser IS configured — so a dump that is
+# present without the key is positive evidence of none, while a log with no dump
+# at all (rotated, log driver `none`, still booting) is no evidence at all and
+# prints nothing, leaving the caller's argv verdict standing.
+#
+# stdout, one line: `PARSER <value>` | `PARSER none` | (nothing = no evidence).
+# The dump parser is resolved_config's `dict_after` (#1265) — one reader for the
+# vLLM/SGLang dumps repo-wide — with a line regex fallback for a truncated read
+# or a newer dump shape, so a parse failure never reads as "no parser".
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import re, sys
+
+lib_dir = sys.argv[1] if len(sys.argv) > 1 else ""
+if lib_dir and lib_dir not in sys.path:
+    sys.path.insert(0, lib_dir)
+try:
+    from resolved_config import dict_after
+except Exception:  # noqa: BLE001 — the standalone read must still work
+    dict_after = None
+
+MARKER = "non-default args:"
+KEY = "reasoning_parser"          # vLLM's own gate on thinking_token_budget
+lines = sys.stdin.read().splitlines()
+
+hits, dump_seen = "", False
+for line in lines:
+    i = line.find(MARKER)
+    if i < 0:
+        continue
+    dump_seen = True
+    parsed = dict_after(line[i:], MARKER) if dict_after is not None else None
+    if isinstance(parsed, dict):
+        if isinstance(parsed.get(KEY), str) and parsed[KEY].strip():
+            hits = parsed[KEY].strip()      # the LAST dump in what we read wins
+        continue
+    # literal_eval failed (a truncated prefix, a newer dump shape): mine the line
+    # rather than conclude "no parser".
+    m = re.search(r"['\"]%s['\"][ \t]*:[ \t]*['\"]([^'\"]+)['\"]" % KEY, line[i:])
+    if m and m.group(1).strip():
+        hits = m.group(1).strip()
+
+if not hits and not dump_seen:
+    # A dump this reader does not recognise still NAMES the key. Limited to the
+    # head of the log (a startup dump precedes every request line) and to lines
+    # that are not an error/usage message, so a vLLM 400 hint quoting the field
+    # can never be mistaken for the server having one. Only ever POSITIVE: an
+    # unrecognised format must not turn into the "booted WITHOUT" refusal.
+    loose = re.compile(r"['\"]?%s['\"]?(?!_)\s*[:=]\s*['\"]([A-Za-z0-9._+-]+)['\"]" % KEY)
+    for line in lines[:200]:
+        if re.search(r"(?i)error|invalid|reject|usage|traceback|exception|raise", line):
+            continue
+        for m in loose.finditer(line):
+            hits = m.group(1).strip()
+
+if hits:
+    print("PARSER %s" % hits)
+elif dump_seen:
+    print("PARSER none")
+PY
+)"
+_thinking_budget_vllm_log_facts() {
+  python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY" "$_TB_LIB_DIR"
+}
+
+# vLLM prints the dump at the HEAD of the log and `docker logs` has no `--head`,
+# so the read is bounded instead of slurping a long-lived engine's (possibly
+# hundreds of MB) log — same limit as resolved_config's boot-log reader. A
+# restart reprints the dump with the same parser, so the head of the log answers
+# the question even when the newest restart's copy sits past the window.
+_THINKING_BUDGET_LOG_PREFIX_BYTES=8388608
+_thinking_budget_vllm_boot_log_facts() {
+  docker logs "$1" 2>&1 \
+    | head -c "$_THINKING_BUDGET_LOG_PREFIX_BYTES" 2>/dev/null \
+    | _thinking_budget_vllm_log_facts 2>/dev/null || true
+}
+
