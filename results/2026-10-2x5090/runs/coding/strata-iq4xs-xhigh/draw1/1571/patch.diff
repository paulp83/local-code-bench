diff --git a/scripts/lib/gpu-select.sh b/scripts/lib/gpu-select.sh
index ed69318..ef49383 100644
--- a/scripts/lib/gpu-select.sh
+++ b/scripts/lib/gpu-select.sh
@@ -109,3 +109,189 @@ gpu_select_assert_placement() {
   fi
   return 0
 }
+
+# ---------------------------------------------------------------------------
+# VRAM attribution (report.sh's "Display / desktop state") — club-3090#1537.
+# ---------------------------------------------------------------------------
+
+# gpu_vram_report_lines ["<our_container>"] — one
+#   "- **GPU <index> idle VRAM:** …" line per GPU, each card attributed to the
+#   process that ACTUALLY holds its VRAM. <our_container> may be empty.
+#
+#   Why (#1537): the old block found ONE running club-3090 container and
+#   credited it with every card above 100 MiB in use. On a rig where a second
+#   user's vLLM was loading GPUs 0 + 2 while our SGLang container held GPU 1,
+#   the report claimed GPUs 0 and 2 were "held by running sglang-cmp170hx" — a
+#   container that could not even see those cards. A misleading report sends
+#   whoever triages the issue to the wrong process.
+#
+#   Where the answer comes from (all read-only):
+#     nvidia-smi --query-gpu=index,uuid,memory.used
+#     nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name
+#   A GPU is matched to its compute processes by UUID (indices renumber inside
+#   a container — see the header of this file), the pid to a container through
+#   <proc>/<pid>/cgroup ("…/docker-<id>.scope", or the cgroup-v1
+#   "…/docker/<id>" layout) and `docker ps` id→name. The proc root is
+#   $GPU_ATTR_PROC (default /proc) so the attribution is testable.
+#
+#   Line shapes:
+#     our container … 12288 MiB (held by running `sglang-cmp170hx`)
+#     another one …… 21000 MiB (held by `other-vllm`, not `sglang-cmp170hx`)
+#     host process ……  1200 MiB (held by `Xorg`)
+#     no owner ……… 12000 MiB ⚠ something is using this GPU (…) — not `ours`
+#     idle card …………    15 MiB ✓
+#
+#   Fallback: some host drivers/permissions list NO compute process at all.
+#   Our container is then placed from its OWN nvidia-smi (`docker exec`,
+#   UUID-based for the same renumbering reason); any other card with memory in
+#   use stays honestly unowned rather than being blamed on ours.
+#
+#   Prints nothing when nvidia-smi is absent; always returns 0.
+gpu_vram_report_lines() {
+  local our_container="${1:-}"
+  local proc_root="${GPU_ATTR_PROC:-/proc}"
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+
+  local gpu_rows="" apps_rows=""
+  gpu_rows="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null)" || gpu_rows=""
+  [[ -n "$gpu_rows" ]] || return 0
+  apps_rows="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)" || apps_rows=""
+
+  # id → name for every RUNNING container, from ONE docker ps. Tolerates both
+  # the "{{.ID}} {{.Names}}" and a "|"-joined layout. Empty (no docker binary,
+  # daemon down, no permission) only costs the holder's NAME, never the card.
+  local ps_map=""
+  if command -v docker >/dev/null 2>&1; then
+    ps_map="$(docker ps --no-trunc --format '{{.ID}} {{.Names}}' 2>/dev/null)" || ps_map=""
+    if [[ -z "$ps_map" ]]; then
+      # No --no-trunc on a docker that would not take the flag (an id map that
+      # short still prefix-matches the 64-hex id from the cgroup).
+      ps_map="$(docker ps --format '{{.ID}} {{.Names}}' 2>/dev/null)" || ps_map=""
+    fi
+    ps_map="${ps_map//|/ }"
+  fi
+
+  # Pass 1 — the host's card table.
+  local -a g_idx=() g_uuid=() g_used=()
+  local r_idx r_uuid r_used
+  while IFS=, read -r r_idx r_uuid r_used; do
+    r_idx="${r_idx//[[:space:]]/}"; r_uuid="${r_uuid//[[:space:]]/}"
+    r_used="${r_used//$'\r'/}"
+    r_used="${r_used#"${r_used%%[![:space:]]*}"}"; r_used="${r_used%"${r_used##*[![:space:]]}"}"
+    [[ -n "$r_idx" ]] || continue
+    g_idx+=("$r_idx"); g_uuid+=("$r_uuid"); g_used+=("$r_used")
+  done <<< "$gpu_rows"
+
+  # Pass 2 — "<uuid>\t<name>" per compute process, named by container when the
+  # pid belongs to one, by its process name otherwise.
+  local -a holders=()
+  local host_lists_apps=0
+  local a_uuid a_pid a_name cg cid h_name psid psname
+  local cg_re_v2='docker-([0-9a-fA-F]{8,64})\.scope'
+  local cg_re_v1='/docker[/-]([0-9a-fA-F]{8,64})'
+  while IFS=, read -r a_uuid a_pid a_name; do
+    a_uuid="${a_uuid//[[:space:]]/}"
+    a_pid="${a_pid//[[:space:]]/}"
+    a_name="${a_name//$'\r'/}"
+    a_name="${a_name#"${a_name%%[![:space:]]*}"}"; a_name="${a_name%"${a_name##*[![:space:]]}"}"
+    [[ "$a_uuid" == GPU-* ]] || continue
+    host_lists_apps=1
+    h_name=""
+    if [[ -n "$a_pid" && "$a_pid" != '[N/A]' ]]; then
+      # Builtins only (no cat — this may run with a minimal PATH), and
+      # 2>/dev/null BEFORE the input redirect: the shell reports a failed
+      # redirect on whatever stderr is still attached, and a process that dies
+      # between the check and the read would otherwise land in the report.
+      cg=""
+      IFS= read -r -d '' cg 2>/dev/null \
+        < "${proc_root}/${a_pid}/cgroup" || true
+      cid=""
+      [[ "$cg" =~ $cg_re_v2 ]] && cid="${BASH_REMATCH[1]}"
+      [[ -z "$cid" && "$cg" =~ $cg_re_v1 ]] && cid="${BASH_REMATCH[1]}"
+      if [[ -n "$cid" ]]; then
+        # Prefix-tolerant: a short-id `docker ps` still matches the 64-hex id.
+        while read -r psid psname; do
+          [[ -z "$psid" ]] && continue
+          psname="${psname//$'\r'/}"
+          if [[ "$cid" == "$psid" || "$cid" == "${psid}"* || "${psid}" == "${cid}"* ]]; then
+            h_name="$psname"
+            break
+          fi
+        done <<< "$ps_map"
+      fi
+    fi
+    # No container for it (a host process, or an id this `docker ps` does not
+    # list): the process name is still the honest answer.
+    if [[ -z "$h_name" && -n "$a_name" && "$a_name" != '[N/A]' ]]; then
+      h_name="$a_name"
+    fi
+    [[ -n "$h_name" ]] && holders+=("${a_uuid}"$'\t'"${h_name}")
+  done <<< "$apps_rows"
+
+  # Fallback — a host that names no compute process at all: ask our container
+  # which UUIDs IT is running on. Only UUIDs count (the container renumbers
+  # the cards it can see), and only ours gets placed from this weaker view.
+  if [[ "$host_lists_apps" == "0" && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    local ours_view="" ours_uuid=""
+    ours_view="$(docker exec "$our_container" nvidia-smi \
+      --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null)" || ours_view=""
+    while read -r ours_uuid; do
+      [[ "$ours_uuid" == GPU-* ]] || continue
+      holders+=("${ours_uuid}"$'\t'"${our_container}")
+    done < <(printf '%s\n' "$ours_view" | command grep -o 'GPU-[^,[:space:]]*' | sort -u)
+  fi
+
+  # Pass 3 — one line per card, from the least to the most alarming claim: an
+  # idle card, a named holder, or a card in use that nobody can be blamed for.
+  local n="${#g_idx[@]}" i used num_used uuid label rec r_name r_uuid
+  local -a on=()
+  local r ours_here=0 joined
+  for (( i = 0; i < n; i++ )); do
+    used="${g_used[$i]}"; uuid="${g_uuid[$i]}"
+    num_used="${used//[^0-9]/}"
+    if [[ -z "$num_used" ]]; then
+      # A field the driver would not answer ("[N/A]") — never a silent ✓.
+      echo "- **GPU ${g_idx[$i]} idle VRAM:** ${used:-?} (not read)"
+      continue
+    fi
+    if (( num_used <= 100 )); then
+      echo "- **GPU ${g_idx[$i]} idle VRAM:** ${num_used} MiB ✓"
+      continue
+    fi
+
+    # Who holds THIS card? Every holder on it, de-duplicated (a TP worker per
+    # card, or two engines sharing one, are both worth naming).
+    on=(); ours_here=0
+    for rec in "${holders[@]:-}"; do
+      [[ -n "$rec" ]] || continue
+      r_uuid="${rec%%$'\t'*}"; r_name="${rec#*$'\t'}"
+      [[ "$r_uuid" == "$uuid" ]] || continue
+      for r in "${on[@]:-}"; do
+        [[ -n "$r" && "$r" == "$r_name" ]] && continue 2
+      done
+      on+=("$r_name")
+      [[ -n "$our_container" && "$r_name" == "$our_container" ]] && ours_here=1
+    done
+
+    if (( ours_here == 1 )); then
+      label="(held by running \`${our_container}\`)"
+    elif (( ${#on[@]} > 0 )); then
+      joined=""
+      for r in "${on[@]}"; do
+        joined="${joined:+${joined} + }\`${r}\`"
+      done
+      label="held by ${joined}"
+      # Ours is running and this is not it — say so, that is the whole point
+      # of the line (#1537).
+      [[ -n "$our_container" ]] && label="${label}, not \`${our_container}\`"
+      label="(${label})"
+    else
+      # Memory in use, nobody to blame — display, browser, or a container this
+      # host cannot see. State whose it is NOT and stop there.
+      label="⚠ something is using this GPU (display, browser, container)"
+      [[ -n "$our_container" ]] && label="${label} — not \`${our_container}\`"
+    fi
+    echo "- **GPU ${g_idx[$i]} idle VRAM:** ${num_used} MiB ${label}"
+  done
+  return 0
+}
