diff --git a/scripts/tests/test-report-gpu-attribution.sh b/scripts/tests/test-report-gpu-attribution.sh
new file mode 100755
index 0000000..6c6b281
--- /dev/null
+++ b/scripts/tests/test-report-gpu-attribution.sh
@@ -0,0 +1,216 @@
+#!/usr/bin/env bash
+# test-report-gpu-attribution — report.sh must credit each GPU's VRAM to the
+# process that actually holds it (club-3090#1537).
+#
+# The bug: "Display / desktop state" found ONE running club-3090 container and
+# credited it with every card over 100 MiB in use. On #1537's rig it printed
+# "GPU 0 … held by running `sglang-cmp170hx`" for a card that container could
+# not even see, while nvidia-smi showed another container's VLLM::Worker_TP0/1
+# on GPUs 0 and 2. A report that blames the wrong process sends triage off a
+# cliff, so what is asserted here is WHO gets named, per card:
+#   - our container   → "held by running `<ours>`"
+#   - another one     → "held by `<other>`" + "not `<ours>`"
+#   - host process    → "held by `<process_name>`"
+#   - no owner at all → "⚠ something is using this GPU" + "not `<ours>`", and
+#                       never a claim on our container
+#   - idle card       → ends "<N> MiB ✓"
+#   - a host listing no compute process at all places ours from the container's
+#     OWN nvidia-smi (docker exec), the only view left there.
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config   # tests never read your real settings (#1466)
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+
+ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT"
+# shellcheck source=../lib/gpu-select.sh
+source "$ROOT/scripts/lib/gpu-select.sh"
+
+PASS=0; FAIL=0
+ok() { PASS=$((PASS+1)); }
+no() { echo "FAIL: $1" >&2; FAIL=$((FAIL+1)); }
+has()   { if [[ "$1" == *"$2"* ]]; then ok; else no "$3: missing '$2'"; echo "--- got ---"; printf '%s\n' "$1"; fi; }
+hasnt() { if [[ "$1" != *"$2"* ]]; then ok; else no "$3: must NOT contain '$2'"; echo "--- got ---"; printf '%s\n' "$1"; fi; }
+# gpu_line <output> <index> — that card's line, so an assertion cannot pass on
+# some other card's text.
+gpu_line() { printf '%s\n' "$1" | command grep -F "**GPU $2 idle VRAM:**" | head -1; }
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+
+# ---------------------------------------------------------------------------
+# Layer 1 — gpu_vram_report_lines as a unit: scripted nvidia-smi + docker, and
+# a fake /proc (GPU_ATTR_PROC) for the pid→container step.
+# ---------------------------------------------------------------------------
+BIN="$TMP/bin"; PROC="$TMP/proc"; mkdir -p "$BIN" "$PROC/111" "$PROC/222" "$PROC/333"
+
+# pid 111 is OUR container (GPU-B), pid 222 is another user's vLLM (GPU-A/C),
+# pid 333 is a host process (Xorg) in no container at all.
+IDA="$(printf 'a%.0s' $(seq 1 64))"
+IDB="$(printf 'b%.0s' $(seq 1 64))"
+printf '0::/system.slice/docker-%s.scope\n' "$IDA" > "$PROC/111/cgroup"
+printf '0::/system.slice/docker-%s.scope\n' "$IDB" > "$PROC/222/cgroup"
+printf '0::/init.scope\n'                           > "$PROC/333/cgroup"
+
+cat > "$BIN/nvidia-smi" <<'EOS'
+#!/usr/bin/env bash
+case "$*" in
+  *"--query-compute-apps=gpu_uuid,pid,process_name"*)
+    [[ "${MOCK_APPS_FAIL:-0}" == "1" ]] && exit 1
+    printf '%s\n' "${MOCK_APPS:-}"
+    exit 0 ;;
+  *"--query-gpu=index,uuid,memory.used"*)
+    [[ "${MOCK_GPU_FAIL:-0}" == "1" ]] && exit 1
+    printf '%s, GPU-A, %s\n%s, GPU-B, %s\n%s, GPU-C, %s\n' \
+      "${I0:-0}" "${M0:-15000}" "${I1:-1}" "${M1:-13000}" "${I2:-2}" "${M2:-21000}"
+    exit 0 ;;
+esac
+exit 0
+EOS
+cat > "$BIN/docker" <<'EOS'
+#!/usr/bin/env bash
+case "$1" in
+  info) exit 0 ;;
+  ps)
+    # id→name (`--no-trunc`) versus the name list of everything else.
+    case "$*" in
+      *--no-trunc*) printf '%s|%s\n%s|%s\n' "$MOCK_ID_A" "$MOCK_NAME_A" \
+                                             "$MOCK_ID_B" "$MOCK_NAME_B" | tr '|' ' ' ;;
+      *)            printf '%s\n' "${MOCK_PS_NAMES:-}" ;;
+    esac
+    exit 0 ;;
+  exec) shift
+        [[ "${1:-}" == "$MOCK_OURS" ]] || exit 1
+        printf '%s\n' "${MOCK_CONTAINER_VIEW:-}"
+        exit 0 ;;
+esac
+exit 0
+EOS
+chmod +x "$BIN/nvidia-smi" "$BIN/docker"
+export PATH="$BIN:$PATH" GPU_ATTR_PROC="$PROC"
+export MOCK_ID_A="$IDA" MOCK_NAME_A="ours" MOCK_ID_B="$IDB" MOCK_NAME_B="other-vllm"
+
+call() { ( export MOCK_OURS="${1:-}"; gpu_vram_report_lines "${1:-}" ) 2>&1; }
+
+# 1. The #1537 rig — every card named by whoever really holds it.
+export MOCK_APPS="GPU-B, 111, sglang::scheduler
+GPU-A, 222, VLLM::Worker_TP0
+GPU-C, 222, VLLM::Worker_TP1"
+out="$(call ours)"
+l0="$(gpu_line "$out" 0)"; l1="$(gpu_line "$out" 1)"; l2="$(gpu_line "$out" 2)"
+has "$l1" 'held by running `ours`'  "our card names our container"
+hasnt "$l1" 'not `ours`'            "our card does not disclaim itself"
+has "$l0" 'held by `other-vllm`'    "GPU 0 names the other container"
+has "$l0" 'not `ours`'              "GPU 0 disclaims our container"
+hasnt "$l0" 'held by running'       "GPU 0 does not claim a running ours"
+has "$l2" 'held by `other-vllm`'    "GPU 2 names the other container"
+has "$l2" 'not `ours`'              "GPU 2 disclaims our container"
+# ...and with no club container running, the holder is still named, minus the
+# contrast against a container nobody is asking about.
+out="$(call '')"
+has "$(gpu_line "$out" 0)" 'held by `other-vllm`' "no ours: holder still named"
+hasnt "$(gpu_line "$out" 0)" 'not `'              "no ours: nothing to disclaim"
+
+# 2. A process outside every container is named by its process name.
+export MOCK_APPS="GPU-C, 333, Xorg"
+out="$(call ours)"
+has "$(gpu_line "$out" 2)" 'held by `Xorg`'  "a host process is named"
+# 3. No owner anywhere: an honest warning, and never a claim on ours.
+export MOCK_APPS="GPU-A, [N/A], [N/A]"
+out="$(call ours)"
+has "$(gpu_line "$out" 0)" '⚠ something is using this GPU' "an ownerless card warns"
+has "$(gpu_line "$out" 0)" 'not `ours`'                    "an ownerless card disclaims ours"
+out="$(call '')"
+has "$(gpu_line "$out" 0)" '⚠ something is using this GPU' "no ours: still warns"
+hasnt "$(gpu_line "$out" 0)" 'not `'                       "no ours: nothing to disclaim"
+
+# 4. The host lists NO compute process: place ours from the container's own view.
+export MOCK_APPS=""
+export MOCK_CONTAINER_VIEW="1, GPU-B, 13000 MiB"
+out="$(call ours)"
+has "$(gpu_line "$out" 1)" 'held by running `ours`'  "the container's own view places ours"
+l2="$(gpu_line "$out" 2)"
+has "$l2" '⚠ something is using this GPU'            "a card outside that view stays unowned"
+has "$l2" 'not `ours`'                               "…and explicitly is not ours"
+export MOCK_CONTAINER_VIEW=""
+has "$(gpu_line "$(call ours)" 1)" '⚠ something is using this GPU' "no view at all: warns"
+
+# 5. An idle card ends "✓".
+export MOCK_APPS="GPU-A, 333, Xorg" M0=8
+has "$(gpu_line "$(call ours)" 0)" '8 MiB ✓' "an idle card reads '<N> MiB ✓'"
+export M0=15000
+
+# 6. Degradations: no nvidia-smi, a failed query, no docker. None may print a
+# wrong owner or a non-zero exit.
+( PATH="$TMP/definitely-absent"; gpu_vram_report_lines "ours"; echo "rc=$?" ) > "$TMP/nv" 2>&1
+eq="$(cat "$TMP/nv")"
+[[ "$eq" == "rc=0" ]] && ok "no nvidia-smi: no lines, rc 0" || no "no nvidia-smi: got '$eq'"
+export MOCK_GPU_FAIL=1
+out="$(call ours)"; rc=$?
+[[ -z "$out" && $rc -eq 0 ]] && ok "failed GPU query: no lines, rc $rc" || no "failed GPU query: got '$out'"
+unset MOCK_GPU_FAIL
+export MOCK_APPS_FAIL=1
+l1="$(gpu_line "$(call ours)" 1)"
+has "$l1" '⚠ something is using this GPU' "failed compute-apps query degrades to unknown"
+has "$l1" 'not `ours`'                    "…and still disclaims ours"
+unset MOCK_APPS_FAIL
+# A PATH with the GPU tool but no docker (the stub needs bash for its shebang).
+mkdir -p "$TMP/nodocker" && cp "$BIN/nvidia-smi" "$TMP/nodocker/"
+ln -s "$(command -v bash)" "$TMP/nodocker/bash"
+export MOCK_APPS="GPU-A, 222, VLLM::Worker_TP0"
+out="$(PATH="$TMP/nodocker" call ours 2>&1)"
+has "$(gpu_line "$out" 0)" 'VLLM::Worker_TP0' "no docker: the process name still lands"
+
+# ---------------------------------------------------------------------------
+# Layer 2 — the REAL report.sh end to end, on #1537's rig.
+# ---------------------------------------------------------------------------
+# shellcheck source=fixtures/report-harness/report-env.sh
+source "${ROOT}/scripts/tests/fixtures/report-harness/report-env.sh"
+report_env_init "$ROOT"
+
+report_nvsmi_stub <<'EOS'
+#!/usr/bin/env bash
+case "$*" in
+  *"--query-compute-apps=gpu_uuid,pid,process_name"*)
+    printf 'GPU-B, 111, sglang::scheduler\nGPU-A, 222, VLLM::Worker_TP0\nGPU-C, 222, VLLM::Worker_TP1\n'
+    exit 0 ;;
+  *"--query-gpu=index,uuid,memory.used"*)
+    printf '0, GPU-A, 21000\n1, GPU-B, 13000\n2, GPU-C, 20500\n'; exit 0 ;;
+  *) exit 0 ;;
+esac
+EOS
+report_docker_stub <<'EOS'
+#!/usr/bin/env bash
+case "$1" in
+  info) exit 0 ;;
+  ps)
+    case "$*" in
+      *--no-trunc*) printf '%s sglang-cmp170hx\n%s other-vllm\n' "$MOCK_ID_A" "$MOCK_ID_B" ;;
+      *)            printf 'sglang-cmp170hx\n' ;;
+    esac
+    exit 0 ;;
+esac
+exit 0
+EOS
+
+report_run --no-redact
+set +e; R="$REPORT_OUT"; set -e
+has "$R" "## Display / desktop state" "the report still renders the desktop section"
+l0="$(gpu_line "$R" 0)"
+has "$l0" 'held by `other-vllm`'         "end-to-end: GPU 0 names the real holder"
+has "$l0" 'not `sglang-cmp170hx`'        "end-to-end: GPU 0 disclaims our container"
+has "$(gpu_line "$R" 1)" 'held by running `sglang-cmp170hx`' "end-to-end: our card still names us"
+
+# ---------------------------------------------------------------------------
+# Layer 3 — wiring guards (the fix lives in the lib, the call lives in report).
+# ---------------------------------------------------------------------------
+grep -q 'scripts/lib/gpu-select.sh' scripts/report.sh \
+  && ok "report.sh sources gpu-select.sh" || no "report.sh no longer sources gpu-select.sh"
+grep -q 'gpu_vram_report_lines "$our_container"' scripts/report.sh \
+  && ok 'report.sh calls gpu_vram_report_lines "$our_container"' \
+  || no 'report.sh no longer calls gpu_vram_report_lines "$our_container"'
+command grep -q 'query-compute-apps=gpu_uuid,pid,process_name' scripts/lib/gpu-select.sh \
+  && ok "the attribution reads the compute-apps table" \
+  || no "gpu-select.sh lost the compute-apps query"
+
