 p2p_classify_engagement() {
-  local text state sglang_boot engine_verdict transport kernel cause verified
+  local text state sglang_boot engine_verdict engine_engaged transport kernel cause verified
   text="$(cat)"
 
   # ── Step 0: slice to the CURRENT BOOT ────────────────────────────────────
@@ -207,6 +214,27 @@ p2p_classify_engagement() {
                                                                engine_verdict=operator ;;
   esac
 
+  # ── Step 2b: the engine's POSITIVE proof that its kernel is live ─────────
+  # Step 2 listens for refusals; these are the two lines the engines print when
+  # the custom all-reduce actually came up. They are the ONLY way a rig can
+  # score `on` without our own boot trail (SGLang and llama.cpp never run
