 def _per_dev(text, pat, agg=False):
+    """Map device -> MiB for `(CUDA\\d) ... ([\\d.]+) MiB` shaped log lines.
+
+    `pat` captures (device, MiB). Several matches per device are expected -- the
+    engine logs one line per buffer, not one line per run.
+
+    agg=False keeps the LAST value per device -- right for a buffer the engine
+    RE-reserves (it replaces what it reserved before). agg=True SUMS -- right for a
+    buffer that simply exists once per model context, where a drafter's line is not
+    a re-statement of the target's but a second allocation of its own.
+    """
