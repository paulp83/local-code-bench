+def _chat_template_mounted_here(patch: dict, body: str) -> bool:
+    """Is THIS patch's vendored template bind-mounted at the declared target?
+
+    Two sides of one mount line are checked, and only that line (plus the entry's
+    own `source:` key under `docker compose config`'s long form):
+
+    * the **destination** ends with `mounted_at` — qwen38 declares the suffix
+      `/chat_template.jinja` because it overrides the model dir's own copy, and
+      other patches' mount *sources* end with that same suffix;
+    * the **source** names this patch (`_chat_template_mount_sources`) — a
+      compose that mounts a different patch's `.jinja` is not this patch's
+      coverage, whatever it is mounted at (#1611)."""
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at") or ""
+    sources = _chat_template_mount_sources(patch)
+    if not mounted_at or not sources:
+        return False
+    lines = body.splitlines()
+    for idx, line in enumerate(lines):
+        dests, sources_seen = _mount_line_parts(line)
+        if not any(dest.endswith(mounted_at) for dest in dests):
+            continue
+        # Long-form (`docker compose config`) entries carry `source:` on the
+        # item's preceding line(s) — keep the whole entry in view.
+        for prev in lines[max(0, idx - 2):idx]:
+            sources_seen = sources_seen + _mount_line_parts(prev)[1]
+        if any(any(tok in src for tok in sources) for src in sources_seen):
+            return True
+    return False
+
+
+def _chat_template_wiring_present(patch: dict, body: str) -> bool:
+    """True iff ``body`` mounts this patch's template AND serves it.
+
+    Mount: `_chat_template_mounted_here`. Serve: the launch command's
+    `--chat-template` / `--chat-template-file` naming that mount — the LAST one,
+    because argparse lets the final occurrence win. A flag naming any other file
+    means the compose serves something else, so the patch, though mounted, is
+    inert (#1611).
