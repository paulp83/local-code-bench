+        stripped = match.group(1).strip()
+    stripped = stripped.strip(_QUOTE_CHARS)
+    if not stripped or stripped.startswith("#"):
+        return [], []
+    match = re.match(r"^(?:source|src):\s*(.+)$", stripped, re.IGNORECASE)
+    if match:
+        return [], [match.group(1).strip().strip(_QUOTE_CHARS)]
+    match = re.match(r"^target:\s*(.+)$", stripped, re.IGNORECASE)
+    if match:
+        return [match.group(1).strip().strip(_QUOTE_CHARS)], []
+    if "${" in stripped or ":" not in stripped:
+        return [], []
+    segs = [seg.strip().strip(_QUOTE_CHARS) for seg in stripped.split(":")]
+    if len(segs) == 2:
