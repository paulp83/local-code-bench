+def _mount_line_parts(line: str) -> tuple[list[str], list[str]]:
+    """(destinations, sources) declared by one rendered volume line.
+
+    Handles the compose / merged-YAML short form (`- <src>:<dst>[:mode]`) AND
+    the long form `docker compose config` renders (`- source: <src>` then
+    `target: <dst>` on the next line) — the source-aware check has to work on
+    both, or coverage disappears on a rig that has the docker CLI. A mount
+    source built from an env expression (`${MODEL_DIR:-…}/…:/root/…`) carries a
+    colon inside the source and is skipped rather than mis-parsed; no
+    chat-template bind in-tree is written that way.
+    """
+    stripped = line.strip()
+    match = re.match(r"^-\s+(.*)$", stripped)
