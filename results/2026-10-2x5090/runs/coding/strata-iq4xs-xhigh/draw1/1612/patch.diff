+def _auto_loads_template(mounted_at: str) -> bool:
+    """Would an engine render a template mounted at ``mounted_at`` with no flag?
+
+    True for the model-dir class of override, where the bind target is (a suffix
+    of) the checkpoint's own `chat_template.jinja` — vLLM and SGLang both load
+    that from the served model dir. An `/etc/…jinja` target only reaches the
+    engine when the launch command names it."""
+    if not mounted_at:
+        return False
+    return mounted_at.rstrip("/").rsplit("/", 1)[-1] in _AUTO_LOADED_TEMPLATE_NAMES
