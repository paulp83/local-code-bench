+# --------------------------------------------------------------------------
+# chat_template wiring (#1611) — the mount AND the flag must be THIS patch's.
+# --------------------------------------------------------------------------
+# A `chat_template` patch ships one vendored `.jinja` that a compose (a) binds
+# into the container and (b) — unless the engine auto-loads the path it was
+# bound at — names with `--chat-template` / `--chat-template-file`. Both halves
+# have to be *this patch's* before the patch counts as reaching the compose:
+#
+#   * the mount is pinned to the patch's own vendored file the way #1610 pinned
+#     install scripts — its patch directory (`qwen38-reasoning-effort-template`,
+#     `glm53-minja-numeric-index`) or its vendored filename
+#     (`apex-qwen-chat-template.jinja`) has to be on the mount line, next to the
+#     declared target. A generic `chat_template.jinja` filename never pins
+#     anything (every patch that overrides a model dir vendors that exact name);
+#   * the launch flag is read as a TOKEN, not a substring, and the file it names
+#     has to be this patch's `mounted_at`. `--chat-template` is a substring of
+#     `--chat-template-file`, and every vLLM compose passes the flag for its own
+#     template, so a bare flag says nothing about any given patch.
+#
+# A flag that names a DIFFERENT file means the compose is serving another
+# template (the flag overrides a model dir's mounted copy) → not reached. With
+# no flag at all the mount is load-bearing only when the target IS the engine's
+# auto-loaded model-dir template — the documented mount-only class (`wired_at:
+# [volumes]`: carnice, and the SGLang qwen38 slugs, whose engine "tests the
+# loaded template and needs no flag").
+_CHAT_TEMPLATE_FLAG_RE = re.compile(r"(--chat-template(?:-file)?)(?:=(.*))?")
+
+# Template file names an engine reads from the served model dir with NO flag.
+_AUTO_LOADED_TEMPLATE_NAMES = frozenset(
+    {"chat_template.jinja", "chat_template.j2", "chat_template.jinja2", "chat_template.tmpl"}
+)
+
+# A vendored template named one of these stems carries no patch identity, so it
+# may only pin a mount through its patch directory.
+_GENERIC_TEMPLATE_STEMS = frozenset(
+    {"chat_template", "chat-template", "chattemplate", "template"}
+)
+
+# ``wired_at`` spellings: `command` is the same insertion point as `entrypoint`
+# (the launch command the compose runs) — ik-llama / llama.cpp patches spell it
+# that way, and an unrecognised value used to drop the patch into the
+# "any declared marker" fallback (#1611).
+_WIRED_AT_ALIASES = {"command": "entrypoint", "volume": "volumes"}
+
+
+def _wired_at_points(spec: dict) -> set[str]:
+    """Normalised ``delivery_spec.wired_at`` insertion-point set."""
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    return {_WIRED_AT_ALIASES.get(w, w) for w in (wired_at or []) if w}
+
+
+def _chat_template_mount_sources(patch: dict) -> list[str]:
+    """Tokens that identify THIS patch's template on a mount line.
+
+    Composes bind with a compose-relative source
+    (`../../../patches/<patch-dir>/chat_template.jinja`) while ``delivery_spec``
+    records the repo-relative one; the token the two share is the patch
+    directory, or — when the `.jinja` sits directly in `patches/` — the vendored
+    file's own name. A generic name (`chat_template.jinja`) is dropped: it is
+    what every other chat_template patch vendors too, which is exactly the
+    false-positive class #1611 is about.
+    """
+    spec = patch.get("delivery_spec") or {}
+    names: list[str] = []
+    # The patch id is a token too: a compose that mounts `patches/<patch-id>/…`
+    # names the directory this row owns.
+    candidates = [spec.get("jinja") or "", patch.get("id") or ""] + list(patch.get("files") or [])
+    for rel in candidates:
+        if not rel:
+            continue
+        path = Path(rel)
+        parent = path.parent.name
+        if parent and parent != "patches":
+            names.append(parent)
+        if path.name and path.name.split(".")[0] not in _GENERIC_TEMPLATE_STEMS:
+            names.append(path.name)
+    return sorted({n for n in names if n and n != "patches" and n not in _GENERIC_SCRIPT_NAMES})
