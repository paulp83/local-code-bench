+
+def _command_tokens(body: str) -> list[str]:
+    """Whitespace tokens of the merged body with YAML list/flow punctuation and
+    quotes stripped, so a flag and the path following it line up whether the
+    merge rendered them as adjacent block-list items, as a flow list
+    (`[a, b, --chat-template, /path]`) or inside one command string."""
+    tokens: list[str] = []
+    for raw in body.splitlines():
+        for tok in raw.strip().split():
+            tok = tok.strip(_QUOTE_CHARS + "[],()").strip()
+            if tok and tok not in ("-", "|", ">", "|-"):
+                tokens.append(tok)
+    return tokens
+
