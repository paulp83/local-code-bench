+    With NO flag in the body the mount alone is the delivery only when the
+    target is the engine's auto-loaded model-dir template. That is not a hole:
+    the flag is a per-engine serving detail (the qwen38 row is mounted over the
+    checkpoint's own `chat_template.jinja`, which SGLang renders with no flag at
+    all — those 23 load-bearing slugs would otherwise read as uncovered), so the
+    flag can corroborate a mount but cannot be demanded of every engine."""
+    if not _chat_template_mounted_here(patch, body):
+        return False
+    mounted_at = (patch.get("delivery_spec") or {}).get("mounted_at") or ""
+    named = _chat_template_flag_paths(body)
+    if named:
+        # argparse semantics: the LAST occurrence is the file the engine
+        # actually serves, so a second flag naming another template wins.
+        return mounted_at in named[-1]
+    return _auto_loads_template(mounted_at)
+
