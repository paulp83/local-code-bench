+def _chat_template_flag_paths(body: str) -> list[str]:
+    """Files named by a `--chat-template` / `--chat-template-file` flag in ``body``.
+
+    Exact-token match: `--chat-template-kwargs` is not `--chat-template`, and a
+    `--chat-template` check must not be satisfied by the `--chat-template-file`
+    that a llama.cpp compose passes (#1611). The named file is the `=`-suffix or
+    the next token — which is how the merged body renders the pair (adjacent
+    `- --chat-template` / `- /path` list items)."""
+    named: list[str] = []
+    tokens = _command_tokens(body)
+    for idx, tok in enumerate(tokens):
+        match = _CHAT_TEMPLATE_FLAG_RE.fullmatch(tok)
+        if not match:
+            continue
+        arg = (match.group(2) or "").strip(_QUOTE_CHARS)
+        if not arg and idx + 1 < len(tokens):
+            arg = tokens[idx + 1].strip(_QUOTE_CHARS)
+        if arg.startswith("-"):
+            continue  # the next token is another flag: this one names no file
+        named.append(arg)
+    return named
+
