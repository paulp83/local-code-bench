diff --git a/scripts/tests/test-switch-refuse-before-teardown.sh b/scripts/tests/test-switch-refuse-before-teardown.sh
new file mode 100755
index 0000000..211a025
--- /dev/null
+++ b/scripts/tests/test-switch-refuse-before-teardown.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+# test-switch-refuse-before-teardown — a refused launch must NOT tear down the
+# running slug first. switch.sh splits the launch into up_variant (validate +
+# refuse, pre-teardown) and up_variant_launch (bring-up, post-teardown), so an
+# experimental slug without --force, a missing compose file, or a mistyped slug
+# exits without any down_running() side effect. Regression harness: extract the
+# two phases via sed and source them into a stub registry (same technique as
+# test-switch-orphan-teardown.sh).
+set -euo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+fail=0
+ok()   { echo "  ok: $1"; }
+note() { echo "  FAIL: $1" >&2; fail=1; }
+
+TMP="$(mktemp -d)"
+trap 'rm -rf "$TMP"' EXIT
+HELPERS="$TMP/helpers.sh"
+{
+  sed -n '/^_note_brief() {/,/^}/p' scripts/switch.sh
+  sed -n '/^status_gate() {/,/^}/p' scripts/switch.sh
+  sed -n '/^up_variant() {/,/^}/p' scripts/switch.sh
+  sed -n '/^up_variant_launch() {/,/^}/p' scripts/switch.sh
+} > "$HELPERS"
+# shellcheck source=/dev/null
+source "$HELPERS"
+
+# Registry stubs the phases read.
+declare -A VARIANTS=(
+  ["vllm/dual"]="vllm|models/fakemodel/vllm/compose|dual/quant/serving.yml"
+)
+declare -A VARIANT_STATUS=( ["vllm/dual"]="experimental" )
+declare -A VARIANT_STATUS_NOTE=( ["vllm/dual"]="stub note" )
+ROOT_DIR="$ROOT_DIR"   # refusal cases use a repo-relative dir → missing file
+FORCE=0
+COMPOSE_BIN="docker"
+DOWN_LOG="$TMP/down.log"
+# Sentinel "teardown": record every down_running() invocation. The real function
+# isn't loaded (it needs docker); the harness asserts nothing recorded it.
+teardown_stub() { echo "$*" >> "$DOWN_LOG"; }
+
+# --- 1. mistyped slug refuses pre-teardown -----------------------------------
+rm -f "$DOWN_LOG"
+( set +u; up_variant "no-such-slug" ) >/dev/null 2>&1 && note "unknown slug did not refuse"
+[[ -f "$DOWN_LOG" ]] && note "unknown slug triggered a teardown"
+ok "unknown slug refused with no teardown"
+
+# --- 2. (NA) status without --force refuses pre-teardown ----------------------
+rm -f "$DOWN_LOG"
+out="$( set +u; up_variant "vllm/dual" 2>&1 )" && note "experimental slug launched without --force"
+grep -q "won't launch without an explicit override" <<<"$out" || note "status gate message missing: $out"
+[[ -f "$DOWN_LOG" ]] && note "refused (NA) slug triggered a teardown"
+ok "(NA) slug refused with no teardown (msg: $(head -n1 <<<"$out"))"
+
+# --- 3. missing compose file (model not on host) refuses pre-teardown ---------
+rm -f "$DOWN_LOG"
+FORCE=1
+out="$( set +u; up_variant "vllm/dual" 2>&1 )" && note "missing compose file launched"
+grep -q "compose file missing" <<<"$out" || note "missing-file message missing: $out"
+[[ -f "$DOWN_LOG" ]] && note "missing-file refusal triggered a teardown"
+ok "missing compose file refused with no teardown"
+
+# --- 4. happy path: validate passes, launch phase brings up -------------------
+# Stub the preflight.sh library (the real one lives in scripts/preflight.sh and
+# needs docker/GPU context; the missing-file refusal in case 3 happens BEFORE
+# any of it is called, so stubbing only affects the happy path).
+for _fn in preflight_repo_drift preflight_compose_deps preflight_compose_hardware \
+           preflight_lmcache_ram resolve_offload_residency resolve_offload_threads \
+           resolve_cpu_moe_split preflight_cpu_offload_ram preflight_offload_split_mode \
+           preflight_kv_format_hint preflight_offload_thp preflight_single_card_util; do
+  eval "$_fn() { return 0; }"
+done
+mkdir -p "$TMP/fakemodel/vllm/compose/dual/quant"
+printf 'services: {}\n' > "$TMP/fakemodel/vllm/compose/dual/quant/serving.yml"
+# Happy path: root the phase functions at $TMP (the real ROOT_DIR is used for
+# the refusal cases above, which must see a MISSING file at a repo-relative path).
+ROOT_DIR="$TMP"
+VARIANTS=( ["vllm/dual"]="vllm|fakemodel/vllm/compose|dual/quant/serving.yml" )
+UP_ENG="" UP_DIR="" UP_FILE="" UP_FULL_DIR=""
+up_variant "vllm/dual" || note "valid slug failed validation"
+[[ "${UP_DIR:-}" == "fakemodel/vllm/compose" && "${UP_FILE:-}" == "dual/quant/serving.yml" ]] \
+  || note "up_variant did not export UP_DIR/UP_FILE (got ${UP_DIR:-} / ${UP_FILE:-})"
+# Launch phase: stub compose so `up -d` records instead of running docker.
+COMPOSE_BIN="echo compose-up"
+gpu_preflight() { return 0; }
+export_variant_engine_pin() { return 0; }
+preflight_ik_llama_image() { return 0; }
+apply_thinking_pin_env() { return 0; }
+preflight_compose_gpu_fit() { return 0; }
+bash() { echo "bash $*" >> "$DOWN_LOG"; }   # shm-cleanup goes through bash
+out="$( set +u; up_variant_launch "vllm/dual" 2>&1 )"
+grep -q "compose-up -f dual/quant/serving.yml up -d" <<<"$out" \
+  || note "launch phase did not bring up: $out"
+grep -q "bringing up: vllm/dual" <<<"$out" || note "bring-up banner missing"
+ok "happy path: validate then bring up (banner + compose-up recorded)"
+
+[[ $fail -eq 0 ]] && echo "test-switch-refuse-before-teardown: ok" || echo "test-switch-refuse-before-teardown: FAIL"
+exit $fail
