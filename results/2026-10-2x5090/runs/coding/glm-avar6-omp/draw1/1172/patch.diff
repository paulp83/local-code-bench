+    state = _per_dev(text, r"_comp_state:\s+(CUDA\d) \S+ \S+ state buffer size\s*=\s+([\d.]+) MiB", agg=True)
+    for dev, val in _per_dev(text, r"llama_memory_recurrent:\s+(CUDA\d) RS buffer size\s*=\s+([\d.]+) MiB", agg=True).items():
+        state[dev] = state.get(dev, 0.0) + val
 
