+    # the drafter). Last-wins silently overwrote the target's weights with the
+    # drafter's (measured: model=656 for a 3,313 MiB target). Buffers are
+    # additive, so sum every match per device.
+    model = _per_dev(text, r"load_tensors:\s+(CUDA\d) model buffer size\s*=\s+([\d.]+) MiB", agg=True)
+    compute = _per_dev(text, r"sched_reserve:\s+(CUDA\d) compute buffer size\s*=\s+([\d.]+) MiB")
+    kv = _per_dev(text, r"llama_kv_cache:\s+(CUDA\d) KV buffer size\s*=\s+([\d.]+) MiB", agg=True)
