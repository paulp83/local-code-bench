diff --git a/scripts/tests/test-vram-breakdown-drafter.sh b/scripts/tests/test-vram-breakdown-drafter.sh
new file mode 100755
index 0000000..d9a63b3
--- /dev/null
+++ b/scripts/tests/test-vram-breakdown-drafter.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# test-vram-breakdown-drafter — drafter-slug VRAM attribution (issue context:
+# #1118 per-GPU drill-down blocked by under-attribution).
+#
+# A slug pinning a drafter to a GPU emits the same log-line shapes as the target
+# model, AFTER the target: last-wins aggregation silently overwrote the target's
+# weights with the drafter's (3313 MiB target reported as model=656), and the
+# recurrent-state buffer matched nothing and fell into `unaccounted`.
+#
+# Hermetic: runs scripts/lib/vram_breakdown.py against a fixture boot log; no
+# docker/GPU. nvidia-smi is stubbed so the reconciliation math is deterministic.
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+fail() { echo "FAIL: $1" >&2; exit 1; }
+assert_contains() { [[ "$1" == *"$2"* ]] || { echo "FAIL: missing '$2' in:" >&2; echo "$1" >&2; exit 1; }; }
+
+PYTHONUTF8="${PYTHONUTF8:-1}"
+export PYTHONUTF8
+
+FIXTURE="$(mktemp)"
+STUB="$(mktemp -d)"
+trap 'rm -rf "$FIXTURE" "$STUB"' EXIT
+
+cat > "$STUB/nvidia-smi" <<'EOF'
+#!/usr/bin/env bash
+printf '0, 11200, 24576\n1, 22992, 24576\n'
+EOF
+chmod +x "$STUB/nvidia-smi"
+
+# Fixture mirroring a real glm53-flash-dual-iq3xxs-moecache boot (drafter on CUDA1),
+# with llama.cpp's column padding before '=' (spaces, not a single space).
+cat > "$FIXTURE" <<'EOF'
+load_tensors:   CUDA0 model buffer size   = 5000.00 MiB
+load_tensors:   CUDA1 model buffer size   = 3313.42 MiB
+load_tensors:   CUDA1 model buffer size   =  655.73 MiB
+llama_kv_cache: CUDA1 KV buffer size      =  1280.00 MiB
+llama_kv_cache: CUDA1 KV buffer size      =    80.00 MiB
+llama_memory_recurrent: CUDA1 RS buffer size =  205.00 MiB
+_comp_state:    CUDA1 123 456 state buffer size =  300.00 MiB
+sched_reserve:  CUDA1 compute buffer size = 1606.48 MiB
+sched_reserve:  CUDA1 compute buffer size = 5240.16 MiB
+EOF
+
+out="$(PATH="$STUB:$PATH" python3 scripts/lib/vram_breakdown.py "$FIXTURE")" || fail "invocation failed"
+
+# Defect 1: model must be target + drafter (3313.42 + 655.73 = 3969), NOT 656.
+assert_contains "$out" "CUDA1: model=3969"
+# Defect 2: recurrent state counted (205 RS + 300 _comp_state = 505).
+assert_contains "$out" "state=505"
+# kv still sums (1280 + 80).
+assert_contains "$out" "kv=1360"
+
+# CUDA1 used=22992; named = model+kv+state+compute → unaccounted visible.
+line="$(printf '%s\n' "$out" | grep 'CUDA1:')"
+assert_contains "$line" "total=22992/24576MiB(94%)"
+assert_contains "$line" "unaccounted=11918"
+
+echo "test-vram-breakdown-drafter: ok"
