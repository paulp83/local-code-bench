 assert_not_contains 7 "$QLINE" "budget="
 
+# ---- llama.cpp: no `[effort-budget]` line → read the boot command instead ------
+# llama.cpp's budget is a `--reasoning-budget` boot flag, resolved from
+# REASONING_BUDGET by the compose; the flag being present proves nothing, its
+# resolved value does. The mock carries the shipped compose's pattern
+# `--reasoning-budget "${REASONING_BUDGET:-32768}"` as a script-string element,
+# plus a container Env the reader must honour over the `:-` default.
+cat > "${tmp_bin}/docker" <<'MOCK_DOCKER_LLAMA'
+#!/usr/bin/env bash
+case "${1:-}" in
+  inspect)
+    if [[ "${2:-}" == "vllm-mock" ]]; then
+      if [[ "${3:-}" == "--format" ]]; then
+        case "${4:-}" in
+          *RestartCount*) echo 0 ;;
+          *Config.Image*) echo "vllm/vllm-openai:v0.31.0" ;;
+          *) echo "" ;;
+        esac
+        exit 0
+      fi
+      printf '[{"Name":"/vllm-mock","Config":{"Image":"vllm/vllm-openai:v0.31.0","Entrypoint":["vllm","serve"],"Cmd":["/m","--reasoning-parser","qwen3"],"Env":[]},"State":{"RestartCount":0},"HostConfig":{}}]\n'
+      exit 0
+    fi
+    if [[ "${2:-}" == "llamacpp-mock" ]]; then
+      if [[ "${3:-}" == "--format" ]]; then
+        case "${4:-}" in
+          *RestartCount*) echo 0 ;;
+          *Config.Image*) echo "ghcr.io/ggml-org/llama.cpp:server-cuda-b9999" ;;
+          *) echo "" ;;
+        esac
+        exit 0
+      fi
+      exec python3 -c '
+import json, os
+w = os.environ["SMOKE_WORK"]
+pattern = open(f"{w}/pattern.txt").read().strip()
+env = [l for l in open(f"{w}/env.txt").read().splitlines() if l.strip()]
+script = "exec llama-server \"$@\" \"${ROW[@]}\" " + pattern
+print(json.dumps([{"Name": "/llamacpp-mock", "Config": {
+  "Image": "ghcr.io/ggml-org/llama.cpp:server-cuda-b9999",
+  "Entrypoint": ["bash", "-c", script], "Cmd": ["--host", "0.0.0.0"], "Env": env},
+  "State": {"RestartCount": 0}}]))
+'
+    fi
+    exit 1 ;;
+  logs)
+    [[ "${2:-}" == "vllm-mock" ]] || exit 1
+    if [[ -n "${DOCKER_MOCK_LOGS:-}" && -f "${DOCKER_MOCK_LOGS}" ]]; then
+      if [[ "${DOCKER_MOCK_LOGS_STDERR:-0}" == "1" ]]; then cat "${DOCKER_MOCK_LOGS}" >&2; else cat "${DOCKER_MOCK_LOGS}"; fi
+    fi
+    exit 0 ;;
+  ps) exit 0 ;;
+esac
+exit 1
+MOCK_DOCKER_LLAMA
+chmod +x "${tmp_bin}/docker"
+export SMOKE_WORK="${tmp_work}"
+printf -- '--reasoning-budget "${REASONING_BUDGET:-32768}"\n' > "${tmp_work}/pattern.txt"
+: > "${tmp_work}/env.txt"
+
+# run_wrapper_llama [KEY=VAL ...] -- <wrapper args> — same as run_wrapper but
+# pointed at the llama.cpp container.
+run_wrapper_llama() {
+  local extra_env=()
+  while [[ $# -gt 0 && "$1" != "--" ]]; do extra_env+=("$1"); shift; done
+  [[ "${1:-}" == "--" ]] && shift
+  : > "$ARGS_LOG"
+  set +e
+  env -u THINKING_MAX_TOKENS -u THINKING_BUDGET -u REASONING_EFFORT -u PACK_BUDGETS \
+      -u THINKING_BUDGET_HEADROOM -u ENABLE_THINKING -u NO_THINKING -u MAX_TOKENS \
+      PATH="${tmp_bin}:$PATH" BENCHLOCAL_ARGS_LOG="$ARGS_LOG" \
+      PREFLIGHT_NO_AUTODETECT=1 URL=http://mock MODEL=mock-model CONTAINER=llamacpp-mock \
+      ${extra_env[@]+"${extra_env[@]}"} \
+      bash scripts/quality-test.sh "$@" > "${tmp_work}/run.out" 2>&1
+  RUN_RC=$?
+  set -e
+  OUT="$(cat "${tmp_work}/run.out")"
+  ARGS="$(tr '\n' ' ' < "$ARGS_LOG")"
+  QLINE="$(command grep -m1 '^Quality:   ' "${tmp_work}/run.out" || true)"
+}
+
+echo "--- 8. llama.cpp readback: boot command, not the boot log ---"
+printf 'REASONING_BUDGET=8192\n' > "${tmp_work}/env.txt"
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-env 16384  # 8192 + 4096 headroom is under the default cap: not raised
+assert_contains 8-env "$OUT" "server budget 8192 reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from llamacpp-mock's boot command — the default thinking cap 16384 already leaves ≥ 4096 tokens for the answer"
+[[ "$(arg_after --server-thinking-budget)" == "8192" ]] || fail_case 8-env "--server-thinking-budget was '$(arg_after --server-thinking-budget)'"
+assert_contains 8-env "$QLINE" ", budget=server 8192, packs "
+assert_not_contains 8-env "$QLINE" "(effort "  # server-wide: the same for every effort
+
+: > "${tmp_work}/env.txt"  # Env unset → the compose's :-default resolves
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-default 36864
+assert_contains 8-default "$OUT" "server budget 32768 reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from llamacpp-mock's boot command — thinking cap raised to 36864 (= 32768 + 4096 answer headroom"
+assert_contains 8-default "$QLINE" ", budget=server 32768, packs "
+
+# an effort is irrelevant to llama.cpp: the budget is server-wide, no effort tag
+run_wrapper_llama REASONING_EFFORT=low BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 8-effort 36864
+assert_not_contains 8-effort "$OUT" "(effort "
+assert_contains 8-effort "$QLINE" ", budget=server 32768, packs "
+
+echo "--- 9. llama.cpp off / unresolvable / --thinking-budget ---"
+printf -- '-1\n' > "${tmp_work}/pattern.txt"
+run_wrapper_llama -- --quick --enable-thinking
+expect_cap 9-off 16384
+assert_contains 9-off "$OUT" "server budget: off (llamacpp-mock boots llama.cpp with --reasoning-budget -1 or none: unrestricted)"
+assert_contains 9-off "$QLINE" ", sampling=server, budget=server off, packs "
+[[ "$(count_arg --server-thinking-budget)" == "0" ]] || fail_case 9-off "--server-thinking-budget takes a number only"
+
+: > "${tmp_work}/pattern.txt"  # no flag at all → the same "off" shape
+run_wrapper_llama -- --quick --enable-thinking
+expect_cap 9-noflag 16384
+assert_contains 9-noflag "$OUT" "server budget: off (llamacpp-mock boots llama.cpp with --reasoning-budget -1 or none: unrestricted)"
+
+printf -- '--reasoning-budget "${REASONING_BUDGET:-\\$HOME}"\n' > "${tmp_work}/pattern.txt"
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking
+expect_cap 9-unres 16384
+assert_contains 9-unres "$OUT" "server budget: unknown (llama.cpp --reasoning-budget unresolvable"
+assert_not_contains 9-unres "$QLINE" "budget="
+
+printf -- '--reasoning-budget "${REASONING_BUDGET:-32768}"\n' > "${tmp_work}/pattern.txt"
+printf 'REASONING_BUDGET=8192\n' > "${tmp_work}/env.txt"
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking --thinking-budget 8192
+expect_cap 9-tb 12288
+assert_contains 9-tb "$OUT" "the --thinking-budget 8192 this run verified; cap from --thinking-budget"
+[[ "$(count_arg --server-thinking-budget)" == "0" ]] || fail_case 9-tb "--server-thinking-budget must not be sent when --thinking-budget overrides the server"
+assert_not_contains 9-tb "$QLINE" "budget="
+: > "${tmp_work}/env.txt"
+
+echo "--- 10. llama.cpp: explicit cap warns and records; --pack-budgets records, keeps benchlocal caps ---"
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking --thinking-max-tokens 20000
+expect_cap 10-explicit 20000
+assert_contains 10-explicit "$OUT" "WARN: thinking cap 20000 is not above the server budget 32768"
+assert_contains 10-explicit "$QLINE" ", budget=server 32768, packs "
+run_wrapper_llama BL_MOCK_SERVER_BUDGET=1 -- --quick --enable-thinking --pack-budgets
+[[ "$(count_arg --thinking-max-tokens)" == "0" ]] || fail_case 10-pack "--pack-budgets must keep benchlocal's own caps"
+assert_contains 10-pack "$OUT" "--pack-budgets keeps benchlocal's own caps (not raised)"
+[[ "$(arg_after --server-thinking-budget)" == "32768" ]] || fail_case 10-pack "the budget is in effect and must still be recorded"
+
+# the vLLM mock is back in place for any later assertion
+cat > "${tmp_bin}/docker" <<'MOCK_DOCKER'
+#!/usr/bin/env bash
+case "${1:-}" in
+  inspect)
+    [[ "${2:-}" == "vllm-mock" ]] || exit 1
+    if [[ "${3:-}" == "--format" ]]; then
+      case "${4:-}" in
+        *RestartCount*) echo 0 ;;
+        *Config.Image*) echo "vllm/vllm-openai:v0.31.0" ;;
+        *) echo "" ;;
+      esac
+      exit 0
+    fi
+    printf '[{"Name":"/vllm-mock","Config":{"Image":"vllm/vllm-openai:v0.31.0","Entrypoint":["vllm","serve"],"Cmd":["/m","--reasoning-parser","qwen3"],"Env":[]},"State":{"RestartCount":0},"HostConfig":{}}]\n'
+    exit 0 ;;
+  logs)
+    [[ "${2:-}" == "vllm-mock" ]] || exit 1
+    if [[ -n "${DOCKER_MOCK_LOGS:-}" && -f "${DOCKER_MOCK_LOGS}" ]]; then
+      if [[ "${DOCKER_MOCK_LOGS_STDERR:-0}" == "1" ]]; then cat "${DOCKER_MOCK_LOGS}" >&2; else cat "${DOCKER_MOCK_LOGS}"; fi
+    fi
+    exit 0 ;;
+  ps) exit 0 ;;
+esac
+exit 1
+MOCK_DOCKER
+
 if [[ "$FAILED" != "0" ]]; then
   echo "FAIL: test-quality-server-budget" >&2
   exit 1
