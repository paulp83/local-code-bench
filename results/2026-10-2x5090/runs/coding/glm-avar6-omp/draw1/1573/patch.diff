@@ -229,6 +232,41 @@ _thinking_budget_container_facts() {
   python3 -c "$_THINKING_BUDGET_FACTS_PY" "$1"
 }
 
+# vLLM's own readback: `docker logs <container>`. The argv check above misses
+# images that start vLLM through their own launcher (bucko's `qwen38-serve`
+# adds `--reasoning-parser qwen3` inside the script, so `Config.Entrypoint`/
+# `Config.Cmd` show none) — but vLLM dumps its RESOLVED `non-default args` at
+# boot, which shows `'reasoning_parser': '<name>'` when a parser is wired no
+# matter who set it. stdout (one line, empty when docker itself failed):
+#   PARSER <value>   boot log shows a reasoning parser
+#   BOOTED           boot log shows vLLM booting with NO reasoning parser —
+#                    positive evidence the prerequisite is missing
+#   NODATA           nothing readable (docker failed, empty log, no vLLM
+#                    markers) — no evidence either way
+_thinking_budget_vllm_log_parser() {
+  local c="$1" out
+  out="$(docker logs "$c" 2>&1 | python3 -c '
+import re, sys
+try:
+    log = re.compile(r"\x1b\[[0-9;]*m").sub("", sys.stdin.read())
+except Exception:
+    print("NODATA"); raise SystemExit
+hits = re.findall(
+    r"(?:\x27|\")?reasoning_parser(?:\x27|\")?\s*[:=]\s*(?:\x27|\")([^\x27\"]+)(?:\x27|\")",
+    log)
+booted = ("non-default args" in log or "vLLM API server" in log
+          or "Engine args" in log or "vllm serve" in log)
+if hits:
+    print("PARSER", hits[-1])
+elif booted:
+    print("BOOTED")
+else:
+    print("NODATA")
+' 2>/dev/null)" || out=""
+  printf '%s\n' "$out"
+  return 0
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,8 +369,23 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
-          THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
-          return 1 ;;
+          # The argv may be silent because the image starts vLLM through its own
+          # launcher (bucko's qwen38-serve adds --reasoning-parser inside the
+          # script). Fall back to the boot log: vLLM's resolved non-default args
+          # dump shows 'reasoning_parser': <name> when a parser is wired.
+          local logfacts
+          logfacts="$(_thinking_budget_vllm_log_parser "$c")"
+          case "$logfacts" in
+            "PARSER "*)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s argv shows no --reasoning-parser, but its boot log shows vLLM reasoning_parser=${logfacts#PARSER } (set by the image's own launcher)"
+              return 0 ;;
+            "BOOTED")
+              THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail (the boot log's non-default args show no reasoning parser either)"
+              return 1 ;;
+            *)
+              THINKING_BUDGET_EVIDENCE="container ${c}'s argv was booted WITHOUT --reasoning-parser, and its boot log could not be read to check whether the image's own launcher sets one"
+              return 2 ;;
+          esac ;;
         "PARSER "*)
           THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${facts#PARSER }"
           return 0 ;;
