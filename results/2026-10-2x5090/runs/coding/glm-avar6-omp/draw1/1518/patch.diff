diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..b592111 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1027,7 +1027,23 @@ down_running() {
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      # The label is a comma-joined list of every compose file the project was
+      # brought up with (#1498: the slug compose + the slug-label override).
+      # One -f with the joined string is not a valid path — pass each entry as
+      # its own -f, mirroring litellm-log.sh. Entries that no longer exist on
+      # disk are dropped: the label file adds labels only, so down doesn't need
+      # it; if nothing remains, fall back to docker stop.
+      local -a cfg_args=() _cfgs
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      local _f
+      for _f in "${_cfgs[@]}"; do
+        [[ -n "$_f" && -f "$_f" ]] && cfg_args+=(-f "$_f")
+      done
+      if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
