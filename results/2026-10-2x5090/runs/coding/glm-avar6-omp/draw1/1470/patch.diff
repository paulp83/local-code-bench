diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..4936075 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -97,7 +97,33 @@ r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' 'CustomAllRed
 r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' "CustomAllreduce is disabled because it's not supported on more than two PCIe-only GPUs." | p2p_classify_engagement)"
 [[ "$r" == "nccl_only_gated" ]] || fail "SGLang topology veto -> gated (got $r)"
 unset _sgl_raw _sgl_evidence
-echo "  ✓ SGLang runtime: NCCL + custom-AR init classified; restart epoch and vetoes preserved"
+
+# SGLang V1 CustomAllreduce (PCIe rigs — V2 requires full NVLink). V1 logs
+# nothing at init; its ONLY success signal is `Registering N cuda graph
+# addresses`, rank 0, after CUDA-graph capture. Before this fix every PCIe-rig
+# opt-in scored "unknown". Real wording, sglang/srt/distributed/device_communicators.py.
+_sgl_v1=$(cat <<'EOF'
+[2026-10-14 10:00:01] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-14 10:00:07 TP0] sglang is using nccl==2.30.7
+[2026-10-14 10:00:31 TP0] Registering 4352 cuda graph addresses
+EOF
+)
+_sgl_v1_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_sgl_v1_ev" "Registering 4352 cuda graph addresses"
+r="$(printf '%s\n' "$_sgl_v1_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-registration line -> custom AR on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"   # unfiltered stream too
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 success -> on (got $r)"
+# A boot WITHOUT the success line (capture disabled, no graphs) still scores
+# unknown — the signal is evidence, not the boot config.
+r="$(printf '%s\n' "[sglang] BOOT disable_custom_all_reduce=False" "sglang is using nccl==2.30.7" | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "V1 success line absent -> still unknown (got $r)"
+# A veto must still outrank a stale success line from an earlier boot: the
+# last BOOT marker slices the epoch, so a later gated restart never reads on.
+r="$(printf '%s\n%s' "$_sgl_v1_ev" "[sglang] BOOT disable_custom_all_reduce=True" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator restart after V1 success -> nccl_only_operator (got $r)"
+unset _sgl_v1 _sgl_v1_ev
+echo "  ✓ SGLang V1 (PCIe) graph-registration success line classified on; epoch + veto preserved"
 
