+def _url_host_port(url):
+    """(host, port) of a URL, the port defaulted from the scheme. ("", "") when unparseable."""
+    m = re.match(r"^[a-z]+://(\[[0-9a-fA-F:]+\]|[^/:?#]+)(?::(\d+))?(?:[/?#]|$)", url or "")
     if not m:
+        return "", ""
+    return m.group(1), m.group(2) or "80"
+
+
+def _host_addrs(host):
+    """Addresses ``host`` names: a literal is itself, a name is what it resolves to.
+    localhost counts as both loopback halves, like the bash `ports_serve_url` helper."""
+    if host in ("localhost", "0.0.0.0"):
+        return {"127.0.0.1", "::1"}
+    host = host.strip("[]")
+    if re.fullmatch(r"[0-9.]+", host) or ":" in host:
+        return {host}
+    try:
+        return {ai[4][0] for ai in socket.getaddrinfo(host, None)}
+    except Exception:
+        return set()
+
+
+def _own_addrs():
+    """Addresses THIS machine answers to: loopback, the hostname's addresses, and every
+    interface address (a rig whose hostname doesn't resolve still answers on its LAN IP,
+    so `URL=http://<own-ip>:…` has to count as local — same as the bash helper's
+    `hostname -I`)."""
+    own = {"127.0.0.1", "::1"}
+    for name in (socket.gethostname(), socket.getfqdn()):
+        try:
+            own |= {ai[4][0] for ai in socket.getaddrinfo(name, None)}
+        except Exception:
+            pass
+    try:  # every interface address, no external binary: SIOCGIFADDR per interface
+        import fcntl
+        import struct
+        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        for line in open("/proc/net/dev", encoding="utf-8"):
+            ifname = line.split(":")[0].strip()
+            if not ifname or ifname == "lo":
+                continue
+            try:
+                addr = fcntl.ioctl(
+                    s.fileno(), 0x8915,  # SIOCGIFADDR
+                    struct.pack("256s", ifname[:15].encode("utf-8")))[20:24]
+                own.add(socket.inet_ntoa(addr))
+            except Exception:
+                pass
+        for line in open("/proc/net/if_inet6", encoding="utf-8"):
+            fields = line.split()
+            if len(fields) > 5 and fields[5] != "lo":
+                own.add(fields[0].lower())
+    except Exception:
+        pass
+    return own
+
+
+def _mapping_serves_url(mappings, host, port, own):
+    """True when one `docker ps` port mapping publishes ``port`` at an address ``host``
+    can name. Same rule as scripts/lib/listen-scope.sh's ports_serve_url: a 0.0.0.0 /
+    [::] bind covers any address of THIS host (a remote URL is still not served), a
+    127.x / [::1] bind covers loopback only, a specific bind must equal the address.
+    #1584: matching on the port alone bound the local container on :8020 for a URL on
+    another machine, which then reported the LOCAL server's slots/GPU/KV as its own."""
+    for m in mappings:
+        m = m.strip()
+        if "->" not in m:
+            continue
+        bind, _, hp = m.partition("->")
+        bind = bind.strip().strip("[]")
+        # the published side: "0.0.0.0:8144", "[::]:8144", "127.0.0.1:6333-6334"
+        parts = bind.rpartition(":")
+        addr = parts[0] if parts[0] else bind.replace(":" + hp.split("/")[0], "")
+        if parts[2]:
+            addr = parts[0].strip("[]")
+        lo_hi = parts[2].split("/", 1)[0] if parts[2] else hp.split("/")[0]
+        nums = lo_hi.split("-")
+        if len(nums) == 2 and all(n.isdigit() for n in nums):
+            lo, hi = int(nums[0]), int(nums[1])
+        elif len(nums) == 1 and nums[0].isdigit():
+            lo = hi = int(nums[0])
+        else:
+            continue
+        if not (lo <= int(port) <= hi):
+            continue
+        for a in _host_addrs(host):
+            if addr in ("0.0.0.0", "::", "*"):
+                if a in own or a in ("127.0.0.1", "::1"):
+                    return True
+            elif re.fullmatch(r"127(?:\.\d+)+", addr) or addr == "::1":
+                if a in ("127.0.0.1", "::1"):
+                    return True
+            elif addr == a:
+                return True
+    return False
+
+
+def container_for_url(url, ps_lines=None):
+    """Name of the running container publishing ``url`` — same host AND port — else "".
+    #1584: the old port-only match bound the local container on that port even when the
+    URL named another machine."""
+    host, port = _url_host_port(url)
+    if not host or not port.isdigit():
         return ""
-    port = m.group(1)
     if ps_lines is None:
         try:
             out = subprocess.run(["docker", "ps", "--format", "{{.Names}}|{{.Ports}}"],
@@ -372,14 +471,26 @@ def container_for_url(url, ps_lines=None):
             ps_lines = out.stdout.splitlines()
         except Exception:
             return ""
-    pat = re.compile(r":" + port + r"->")
+    own = _own_addrs()
     for line in ps_lines:
         name, _, ports = line.partition("|")
-        if name and pat.search(ports):
+        if name and _mapping_serves_url(ports.split(","), host, port, own):
             return name.strip()
     return ""
 
 
+def url_host_is_local(url):
+    """True when the URL's host is THIS machine (loopback or one of its addresses).
+    Gates concurrency-probe.sh's container-name heuristic (#1584): for a URL on
+    another machine, binding a local `vllm-*` container reports the local server's
+    slot count and GPU label as the remote run's."""
+    host, _port = _url_host_port(url)
+    if not host:
+        return False
+    own = _own_addrs()
+    return any(a in own for a in _host_addrs(host))
+
