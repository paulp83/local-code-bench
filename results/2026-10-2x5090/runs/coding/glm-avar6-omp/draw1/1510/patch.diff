+# 11. GPU-free regression: a --sweep run that hits a SKIPPED cell (KV-clip /
+#     budget / early-stop) must still emit its row and finish (write the card).
+#     Root cause (2026-10-14 report): emit_row fed the row to `python3 -` via
+#     stdin while the heredoc owned stdin, so json.loads("") raised and set -e
+#     killed the sweep at the first skipped cell.
+#     Mechanics: eval the sweep loop EXACTLY as the script defines it (sed range
+#     from `emit_row()` through `done < <(python3 ... --plan-tsv)`), with a stub
+#     plan generator and a stub run_probe — no GPU, no server, no docker.
+SWEEP_LOOP_SRC="$(sed -n '/^  emit_row()/,/done < <(python3 "\$PROBE_PY" --plan-tsv)/p' "$PROBE")"
+[[ -n "$SWEEP_LOOP_SRC" ]] || fail "could not extract the sweep loop"
+PLAN_STUB="$(mktemp)"; trap 'rm -f "$PLAN_STUB" "$SWEEP_CELL_LOG"' EXIT
+SWEEP_CELL_LOG="$(mktemp)"
+cat > "$PLAN_STUB" <<'PY'
+import sys
+# run → KV-clipped skip → then budget (budget_hit set after the first cell)
+sys.stdout.write("run\t1024\t1\t\nskip\t32768\t8\tKV\n")
+PY
+out="$(
+  PROBE_PY="$PLAN_STUB" bash -c '
+    # Stubs and state FIRST: sourcing the loop executes it immediately.
+    cells_jsonl="$(mktemp /tmp/cprobe-cells.XXXXXX)"
+    run_probe() {
+      printf "%s" "$1" >> "'"$SWEEP_CELL_LOG"'"
+      echo "RESULT N=$1 ctx=1024 clean=1 pass=1 mps_tps=100 agg_tps=100 ttft_ms=50 running=1 waiting=0 vram_peak=8000"
+      return 0
+    }
+    budget_hit=0
+    declare -A ROW_DEAD=()
+    WALL_SECS=0
+    PROMPT_TOKENS=1024
+    source /dev/stdin <<'"'"'LOOP'"'"'
+'"$SWEEP_LOOP_SRC"'
+LOOP
+    while IFS=$'"'"'\t'"'"' read -r action ctx n reason; do
+      [[ -z "${action:-}" ]] && continue
+      if [[ "$budget_hit" == "1" ]]; then
+        echo "[sweep] ${ctx} tok  N=${n}: skip (budget)"
+        emit_row "{\"ctx\":$ctx,\"n\":$n,\"skip\":\"budget\"}"
+        continue
+      fi
+      if [[ "$action" == "skip" ]]; then
+        echo "[sweep] ${ctx} tok  N=${n}: skip (${reason})"
+        emit_row "$(python3 -c '"'"'import json,sys; print(json.dumps({"ctx":int(sys.argv[1]),"n":int(sys.argv[2]),"skip":sys.argv[3]}))'"'"' "$ctx" "$n" "${reason:-clipped}")"
+        continue
+      fi
+      set +e
+      out="$(run_probe "$n")"
+      rc=$?
+      set -e
+      line="$(printf '"'"'%s\n'"'"' "$out" | command grep -m1 "^RESULT " || true)"
+      python3 - "$cells_jsonl" "$line" "$ctx" "$n" "$rc" <<'"'"'ROWPY'"'"'
+import json, sys
+path, line, ctx, n, rc = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])
+row = {"ctx": ctx, "n": n, "skip": None, "result": line}
+with open(path, "a", encoding="utf-8") as fh:
+    fh.write(json.dumps(row, ensure_ascii=False) + "\n")
+ROWPY
+      budget_hit=1
+    done < <(python3 "$PROBE_PY" --plan-tsv)
+    cat "$cells_jsonl"
+    echo "LOOP_FINISHED"
+  ' 2>&1
+)"
+command grep -q "skip (KV)" <<<"$out" || fail "stubbed sweep should hit a KV-clip skip"
+command grep -q "skip (budget)" <<<"$out" || fail "stubbed sweep should hit a budget skip"
+command grep -q "LOOP_FINISHED" <<<"$out" || fail "sweep must survive skipped cells (emit_row argv fix)"
+command grep -q '"skip": "KV"' <<<"$out" && command grep -q '"skip": "budget"' <<<"$out" \
+  || fail "skip rows must be written to the cells file, not lost to json.loads(\"\")"
+command grep -q '"skip": null' <<<"$out" || fail "measured row must still be written"
+[[ -s "$SWEEP_CELL_LOG" ]] || fail "measured cell must have probed (run_probe called)"
+echo "  ✓ --sweep survives skipped cells (emit_row argv, GPU-free regression)"
+
+# 12. GPU scoping: VRAM + GPU label must describe the PROBED container's card(s),
+#     not the rig (a pinned 3060 on a 4×3090 rig once reported 55 GB / 4× 3090).
+#     Offline: stub docker + nvidia-smi on PATH, assert the container's GPU ids
+#     are resolved and both queries are scoped to them; unresolvable → rig-wide
+#     AND labelled as such.
+GPU_SHIM="$(mktemp -d)"
+trap 'rm -rf "$GPU_SHIM" "$PLAN_STUB" "$SWEEP_CELL_LOG"' EXIT
+cat > "$GPU_SHIM/docker" <<'D'
+#!/bin/sh
+case "$*" in
+  *DeviceRequests*) echo 'GPU-abc123 ' ;;
+  *Config.Env*) printf '%s\n' 'PATH=/x' 'NVIDIA_VISIBLE_DEVICES=GPU-abc123' ;;
+esac
+D
+cat > "$GPU_SHIM/nvidia-smi" <<'N'
+#!/bin/sh
+case "$*" in
+  *memory.used*)
+    case "$*" in
+      *-i*) echo '10381' ;;
+      *) echo '10381'; echo '20000'; echo '20000'; echo '20000' ;;
+    esac ;;
+  *-i*) echo 'GeForce RTX 3060' ;;
+  *) echo 'GeForce RTX 3090'; echo 'GeForce RTX 3090'; echo 'GeForce RTX 3090'; echo 'GeForce RTX 3060' ;;
+esac
+N
+chmod +x "$GPU_SHIM/docker" "$GPU_SHIM/nvidia-smi"
+python3 - "$GPU_SHIM" "$ROOT_DIR/scripts/lib" <<'PY' || fail "container GPU scoping broken (see smoke above)"
+import os, subprocess, sys
+shim, libdir = sys.argv[1], sys.argv[2]
+os.environ["CONTAINER"] = "my-vllm"
+os.environ["PATH"] = shim + ":" + os.environ["PATH"]
+sys.path.insert(0, libdir)
+from concurrency_probe import container_gpu_ids, vram_used_mb, vram_per_card_mb, vram_scope_note
+ids = container_gpu_ids()
+assert ids == ["GPU-abc123"], ids
+assert vram_used_mb() == 10381, vram_used_mb()
+assert vram_per_card_mb() == [10381], vram_per_card_mb()
+assert "GPU-abc123" in vram_scope_note(), vram_scope_note()
+# unresolvable container → rig-wide sum, but the note must SAY SO
+os.environ["CONTAINER"] = "nope"
+def fake(cmd, **kw):
+    if cmd[:2] == ["docker", "inspect"]:
+        raise RuntimeError("no docker")
+    if cmd[0] == "nvidia-smi":
+        class R: stdout = "10381 20000 20000 20000\n"
+        return R()
+    raise AssertionError(cmd)
+subprocess.run = fake
+import concurrency_probe
+concurrency_probe._VRAM_SCOPE_NOTE = ""
+assert container_gpu_ids() == []
+assert vram_used_mb() == 70381, vram_used_mb()
+assert "rig-wide" in vram_scope_note(), vram_scope_note()
+print("ok")
+PY
+# Extract the two shell helpers ONCE to a file, so the child shells source
+# exactly the production code without nested-quoting gymnastics.
+awk '/^# GPU ids behind CONTAINER/{f=1} f&&/^_gpu_fp\(\) \{/{g=1} g&&/^}/{print;exit} f' \
+  "$PROBE" > "$GPU_SHIM/gpufp.sh"
+[[ -s "$GPU_SHIM/gpufp.sh" ]] && command grep -q '_gpu_fp()' "$GPU_SHIM/gpufp.sh" \
+  || fail "could not extract _gpu_fp from the probe"
+out="$(CONTAINER=my-vllm PATH="$GPU_SHIM:$PATH" bash -c 'source "$1"; _gpu_fp' _ "$GPU_SHIM/gpufp.sh")"
+[[ "$out" == "1× GeForce RTX 3060" ]] || fail "GPU label must be scoped to the container's card, got: $out"
+out="$(CONTAINER= PATH="$GPU_SHIM:$PATH" bash -c 'source "$1"; _gpu_fp' _ "$GPU_SHIM/gpufp.sh")"
+command grep -q "rig-wide" <<<"$out" || fail "unscoped GPU label must say rig-wide, got: $out"
+rm -rf "$GPU_SHIM"
+echo "  ✓ GPU scoping: VRAM + label describe the container's card(s) (rig-wide fallback labelled)"
+
 echo "test-concurrency-probe: ok"
