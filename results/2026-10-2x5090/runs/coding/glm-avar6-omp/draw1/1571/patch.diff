+# gpu_vram_report_lines "<our_container>"
+#   Per-GPU idle-VRAM attribution lines for report.sh's "Display / desktop
+#   state" section (#1537): ONE line per GPU that actually names the process
+#   holding the card, instead of crediting every busy card to the single
+#   running club container. OUR_CONTAINER may be empty (no club container
+#   running). Uses `nvidia-smi --query-gpu=index,uuid,memory.used` for the
+#   cards and `--query-compute-apps=gpu_uuid,pid,process_name` for the holders;
+#   a pid is mapped to a docker container via $GPU_ATTR_PROC (default /proc)
+#   `<pid>/cgroup` (`.../docker-<id>.scope`) + `docker ps` (id -> name).
+#   Lines (the substrings tests look for):
+#     - our container:  `held by running \`<ours>\``
+#     - another container: `held by \`<other>\``, plus `not \`<ours>\`` when
+#       OUR_CONTAINER is set
+#     - outside any container: `held by \`<process_name>\``
+#     - host lists no compute processes: ours is placed from
+#       `docker exec <ours> nvidia-smi ...` (the container's own view); a card
+#       with memory in use and no owner reads `⚠ something is using this GPU`
+#       ... `not \`<ours>\``
+#     - an idle card (a few MiB) ends with `<N> MiB ✓`
+gpu_vram_report_lines() {
+  local our_container="$1" proc_root="${GPU_ATTR_PROC:-/proc}" gpus apps exec_apps
+  command -v nvidia-smi >/dev/null 2>&1 || return 0
+  gpus="$(nvidia-smi --query-gpu=index,uuid,memory.used --format=csv,noheader,nounits 2>/dev/null)" || return 0
+  apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)" || true
+
+  local -A cid2name=()
+  if command -v docker >/dev/null 2>&1; then
+    local _cid _cname
+    while read -r _cid _cname; do
+      [[ -n "${_cid:-}" && -n "${_cname:-}" ]] && cid2name["$_cid"]="$_cname"
+    done < <(docker ps --format '{{.ID}} {{.Names}}' 2>/dev/null)
+  fi
+
+  # Host compute-app view can be empty even when a container is running (pid
+  # namespace / driver quirks) — fall back to the container's own view.
+  exec_apps=""
+  if [[ -z "$apps" && -n "$our_container" ]] && command -v docker >/dev/null 2>&1; then
+    exec_apps="$(docker exec "$our_container" nvidia-smi \
+        --query-compute-apps=gpu_uuid,pid,process_name --format=csv,noheader 2>/dev/null)" || true
+  fi
+
+  local -a app_lines=()
+  [[ -n "$apps" ]] && mapfile -t app_lines <<< "$apps"
+
+  local idx uuid used line app_uuid app_pid app_name rest cid cg name owner
+  while IFS=, read -r idx uuid used; do
+    idx="${idx//[[:space:]]/}"; uuid="${uuid//[[:space:]]/}"; used="${used//[[:space:]]/}"
+    [[ -z "$idx" || "$idx" != [0-9]* ]] && continue
+    owner=""
+    for line in "${app_lines[@]}"; do
+      app_uuid="${line%%,*}"
+      [[ "${app_uuid//[[:space:]]/}" == "$uuid" ]] || continue
+      rest="${line#*,}"
+      app_pid="${rest%%,*}"; app_pid="${app_pid//[[:space:]]/}"
+      app_name="${rest#*,}"; app_name="${app_name# }"
+      cid=""
+      if [[ -n "$app_pid" && -r "$proc_root/${app_pid}/cgroup" ]]; then
+        cg="$(cat "$proc_root/${app_pid}/cgroup" 2>/dev/null)" || cg=""
+        cid="$(printf '%s\n' "$cg" | command grep -oE 'docker-[0-9a-f]+\.scope' | head -1)"
+        cid="${cid#docker-}"; cid="${cid%.scope}"
+      fi
+      name=""
+      [[ -n "$cid" ]] && name="${cid2name[$cid]:-}"
+      if [[ -z "$name" && -n "$cid" ]]; then
+        for _cid in "${!cid2name[@]}"; do
+          if [[ "$cid" == "$_cid" || "$cid" == "$_cid"* ]]; then
+            name="${cid2name[$_cid]}"; break
+          fi
+        done
+      fi
+      if [[ -n "$name" ]]; then
+        if [[ "$name" == "$our_container" ]]; then
+          owner="(held by running \`${our_container}\`)"
+        else
+          owner="(held by \`${name}\`"
+          [[ -n "$our_container" ]] && owner="${owner}, not \`${our_container}\`"
+          owner="${owner})"
+        fi
+      else
+        owner="(held by \`${app_name}\`)"
+      fi
+      break
+    done
+    if [[ -z "$owner" && -n "$exec_apps" ]]; then
+      while IFS=, read -r app_uuid _rest; do
+        if [[ "${app_uuid//[[:space:]]/}" == "$uuid" ]]; then
+          owner="(held by running \`${our_container}\`)"
+          break
+        fi
+      done <<< "$exec_apps"
+    fi
+    if [[ "$used" =~ ^[0-9]+$ ]] && [[ "$used" -gt 100 ]]; then
+      if [[ -z "$owner" ]]; then
+        owner="⚠ something is using this GPU (display, browser, container)"
+        [[ -n "$our_container" ]] && owner="${owner}, not \`${our_container}\`"
+      fi
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ${owner}"
+    else
+      echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
+    fi
+  done <<< "$gpus"
+}
+
