     return selectors, f"GPU {', '.join(selectors)} (container {container})"
 
 
+def container_for_url(url):
+    """Name of the running container that publishes $URL's port (any engine —
+    vLLM, SGLang, llama.cpp), or None (#1537): the old `vllm-(qwen|gemma)` name
+    heuristic never found an SGLang container."""
+    m = re.search(r":([0-9]+)(?:/|$)", url or "")
+    if not m:
+        return None
+    port = m.group(1)
+    try:
+        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+                             capture_output=True, text=True, encoding="utf-8", timeout=10).stdout
+    except Exception:
+        return None
+    pub = re.compile(r"(?:0\.0\.0\.0|\[::\]|::):%s->" % re.escape(port))
+    for line in out.strip().splitlines():
+        name, _sep, ports = line.partition("\t")
+        if pub.search(ports):
+            return name
+    return None
+
+
+def _sglang_spec_label(url):
+    """SGLang spec label from GET /get_server_info, or None when it doesn't answer."""
+    try:
+        with urllib.request.urlopen(url.rstrip("/") + "/get_server_info", timeout=5) as r:
+            info = json.loads(r.read())
+    except Exception:
+        return None
+    if not isinstance(info, dict) or "speculative_algorithm" not in info:
+        return None
+    algo = info.get("speculative_algorithm")
+    if not algo:
+        return "spec off"
+    # EAGLE over the target's own checkpoint IS the MTP drafter — label it as one.
+    label = "MTP" if str(algo).upper() in ("EAGLE", "MTP") else str(algo).upper()
+    steps = info.get("speculative_num_steps")
+    if isinstance(steps, int):
+        label += f" n={steps}"
+    return label
+
+
+def _vllm_spec_label(container):
+    """vLLM spec label from the startup logs, or None when unreadable.
+
+    The Qwen3.8 vLLM composes build --speculative-config inside their entrypoint
+    from SPEC_N, so the flag never appears in the container's Cmd — read the
+    engine's own report instead, at the HEAD of `docker logs` (the
+    "Initializing a V1 LLM engine …" line, not the tail, which is request noise).
+    """
+    if not container:
+        return None
+    try:
+        proc = subprocess.Popen(["docker", "logs", container],
+                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                text=True, encoding="utf-8", errors="replace")
+    except Exception:
+        return None
+    hit = None
+    seen = 0
+    try:
+        for line in proc.stdout:
+            if "Initializing a V1 LLM engine" in line and "speculative_config=" in line:
+                hit = line
+                break
+            seen += len(line)
+            if seen > 16_000_000:  # don't scan a multi-GB log for a missing line
+                break
+    finally:
+        proc.kill()
+        proc.stdout.close()
+    if not hit:
+        return None
+    if re.search(r"speculative_config=None\b", hit):
+        return "spec off"
+    m = re.search(r"speculative_config=SpeculativeConfig\(\s*method='([^']+)'", hit)
+    if not m:
+        return None
+    label = m.group(1).upper()
+    n = re.search(r"num_spec_tokens=(\d+)", hit)
+    if n:
+        label += f" n={n.group(1)}"
+    return label
+
+
+def spec_label(url, container):
+    """Speculative-decoding label read from the engine, or None when neither
+    source is readable (SGLang /get_server_info, then vLLM startup logs)."""
+    sg = _sglang_spec_label(url)
+    if sg is not None:
+        return sg
+    return _vllm_spec_label(container)
+
