+# Basenames shared by every vendored template ("chat_template.jinja" is what
+# each patch's file is called on disk) identify nothing — a patch whose
+# `.jinja` sits directly under patches/ is identified by its file name alone.
+_GENERIC_TEMPLATE_BASENAMES = frozenset({"chat_template.jinja"})
+_GENERIC_TEMPLATE_DIRS = frozenset({"patches"})
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount line:
+    its vendored template's own file/directory names (#1610 follow-up). Two
+    patches can mount at the same container path (qwen38 mounts over EVERY
+    model dir's chat_template.jinja — `mounted_at: /chat_template.jinja` is a
+    SUFFIX, so the target substring alone matches any template mount), so the
+    patch's own source token must sit on the SAME line as the target."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    spec = patch.get("delivery_spec") or {}
+    names: set[str] = set()
+    for rel in ([spec["jinja"]] if spec.get("jinja") else []) + list(patch.get("files") or []):
+        path = Path(rel)
+        if path.name and path.name not in _GENERIC_TEMPLATE_BASENAMES:
+            names.add(path.name)
+        if path.parent.name and path.parent.name not in _GENERIC_TEMPLATE_DIRS:
+            names.add(path.parent.name)
+    return sorted(names)
+
+
+def _chat_template_flag(invoke: str) -> str | None:
+    """The chat-template flag a chat_template spec's invoke declares, if any.
+
+    ``--chat-template`` must not match as a prefix of ``--chat-template-file``
+    (hence the negative lookahead), and the flag alone is NOT an invoke
+    marker: a compose passing --chat-template for ITS OWN template satisfies
+    nothing for this patch (#1597 follow-up)."""
+    if re.search(r"--chat-template-file(?![\w-])", invoke):
+        return "--chat-template-file"
+    if re.search(r"--chat-template(?![\w-])", invoke):
+        return "--chat-template"
+    return None
+
+
+def _chat_template_invoke_ok(patch: dict, body: str) -> bool:
+    """Flag-side check for a chat_template spec, keyed on how the spec's own
+    invoke declares the flag:
+
+    * mount-only spec (no flag in ``invoke``, e.g. carnice): nothing to
+      check — the mount target is the load-bearing artifact;
+    * fully-specified flag (``invoke`` names the flag AND the mounted path,
+      e.g. froggeric / apex / glm53 / gemma): the compose MUST pass the flag
+      naming that path — flag and mount target on the same line or as
+      adjacent list items in the merged body (Compose renders `command:`
+      items one per line, so the joined literal never appears);
+    * flag declared with an unspecified path (qwen38: "--chat-template
+      <model dir>/chat_template.jinja" — the SGLang slugs of the same patch
+      are mount-only and pass no flag): any flag the compose DOES pass must
+      name the patch's mounted template; a flag naming another file is a
+      mismatch, no flag at all is the mount-only style and fine.
+    """
+    spec = patch.get("delivery_spec") or {}
+    flag = _chat_template_flag(spec.get("invoke") or "")
+    if not flag:
+        return True
+    mounted_at = spec.get("mounted_at") or ""
+    invoke = spec.get("invoke") or ""
+    # "fully specified" = the invoke names the flag followed EXACTLY by the
+    # mounted path (froggeric: "--chat-template /etc/qwen-froggeric-…"). A
+    # placeholder like qwen38's "<model dir>/chat_template.jinja" is NOT a
+    # full declaration (the SGLang slugs of that patch are mount-only and
+    # pass no flag, yet are load-bearing).
+    fully_specified = False
+    if flag and mounted_at:
+        m = re.search(re.escape(flag) + r"(?![\w-])\s+(\S+)", invoke)
+        fully_specified = bool(m) and m.group(1).rstrip(".,)") == mounted_at
+    lines = body.splitlines()
+    flag_pat = re.escape(flag) + r"(?![\w-])"
+    ok = False
+    for i, ln in enumerate(lines):
+        if not re.search(flag_pat, ln):
+            continue  # a bare flag line is not a "pass" on its own
+        # the flag names the mounted template on the same line, or as the
+        # adjacent list item in the merged body
+        if mounted_at in ln or (i + 1 < len(lines) and mounted_at in ln + "\n" + lines[i + 1]):
+            ok = True
+        else:
+            return False  # the flag names ANOTHER file — mismatch
+    if ok:
+        return True
+    return not fully_specified  # mount-only compose of a flag-style spec is fine
+
+
+def _chat_template_vol_ok(vol_markers: list[str], sources: list[str], body: str) -> bool:
+    """Source-aware mount check for a chat_template patch: the marker AND the
+    patch's own template source must sit on the same line, and that line must
+    be a BIND MOUNT, not a launch-command argument — the flag path
+    (--chat-template /etc/tpl.jinja) must not double as volume evidence when
+    the mount was removed. Mount lines are ``src:dest[:mode]`` (or long
+    syntax ``target: dest``), so the marker is colon-anchored."""
+    lines = body.splitlines()
+    for i, ln in enumerate(lines):
+        for m in vol_markers:
+            if m not in ln:
+                continue
+            src_pat = lambda txt: any(
+                re.search(r"(?<![\w.-])" + re.escape(s) + r"(?![\w-])", txt) for s in sources)
+            if re.search(r"target:\s*\S*" + re.escape(m), ln):
+                # long syntax: the source sits on a sibling `source:` line —
+                # check this line and the preceding one.
+                prev = lines[i - 1] if i else ""
+                if src_pat(ln) or src_pat(prev):
+                    return True
+                continue
+            tm = re.search(r":\S*" + re.escape(m) + r"(:\S*)?(\s|$)", ln)
+            if tm:
+                # short syntax src:dest[:mode] — the source token must sit on
+                # the SOURCE side of the mount (before the target): the
+                # target "/etc/tpl.jinja" itself contains a generic "tpl",
+                # but a source token occurring only inside the target is not
+                # this patch's file.
+                if src_pat(ln[: tm.start()]):
+                    return True
+    return False
+
