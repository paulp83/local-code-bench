+    def test_engine_profile_dry_run_writes_nothing(self, root):
+        """catalog.sh stages the ENGINE profile in the spec; --dry-run must not
+        leak engines.d/<engine>.yml ahead of promote's plan/confirm."""
+        spec = _spec()
+        spec["local_engine_profile"] = {
+            "path": "scripts/lib/profiles-local/engines.d/vllm.yml",
+            "content": "schema_version: 1\nid: vllm\ntype: vllm\n",
+        }
+        res = _run_cli(root, spec, "--layer", "local", "--dry-run")
+        assert res.returncode == 0
+        assert "dry-run" in res.stdout
+        # The plan names the engine profile with the agreed text.
+        assert (
+            "engines.d/vllm.yml (new local ENGINE profile)" in res.stdout
+        )
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+        for rel in LOCAL_ARTIFACTS:
+            assert not (root / rel).exists(), rel
+
+    def test_engine_profile_real_run_writes_it(self, root):
+        spec = _spec()
+        spec["local_engine_profile"] = {
+            "path": "scripts/lib/profiles-local/engines.d/vllm.yml",
+            "content": (
+                "schema_version: 1\nid: vllm\n"
+                "display_name: vllm (local, registered from a compose)\n"
+                "type: vllm\nstability: experimental\nmin_sm: '7.5'\n"
+            ),
+        }
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == 0, res.stderr
+        ep = root / "scripts/lib/profiles-local/engines.d/vllm.yml"
+        assert ep.is_file()
+        assert "type: vllm" in ep.read_text(encoding="utf-8")
+
+    def test_engine_profile_wrong_path_is_refused(self, root):
+        spec = _spec()
+        spec["local_engine_profile"] = {
+            "path": "scripts/lib/profiles-local/engines.d/other-engine.yml",
+            "content": "schema_version: 1\n",
+        }
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "must be" in res.stderr
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_engine_profile_refused_on_core_layer(self, root):
