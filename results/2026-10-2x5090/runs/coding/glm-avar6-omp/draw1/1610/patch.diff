+def _identity_tokens(rel: str) -> set[str]:
+    """Name(s) that identify *this* patch inside a compose mount source.
+
+    Returns the artifact's own basename when it is distinctive, and/or its
+    patch directory's name when the basename is generic (`install.sh`,
+    `apply.py`, …). Deliberately EXCLUDES the parent-of-a-directory marker
+    (`patches`) the legacy fallback used — every compose that mounts any
+    patch dir contains that string, so it identifies nothing.
+    """
+    path = Path(rel)
+    toks: set[str] = set()
+    name = path.name
+    parent = path.parent.name
+    if name and name not in GENERIC_BASENAMES:
+        toks.add(name)
+    if parent and parent not in GENERIC_BASENAMES and parent != "patches":
+        toks.add(parent)
+    return toks
+
+
+def _patch_source_tokens(patch: dict) -> set[str]:
+    """Every token that identifies this patch's on-disk artifacts."""
+    toks: set[str] = set()
+    for rel in patch.get("files") or []:
+        toks |= _identity_tokens(rel)
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "sidecar", "jinja"):
+        if spec.get(key):
+            toks |= _identity_tokens(spec[key])
+    return toks
+
+
+def _mount_sources_for_target(body: str, target: str) -> list[str]:
+    """Host-side source strings of the mount entries whose container-side
+    target is ``target`` — best-effort over short syntax (`- src:dst:ro`,
+    one line) and long syntax (`source:` / `target:` keys, which is what
+    `docker compose config` renders, source and target on separate lines
+    of the same list item)."""
+    sources: list[str] = []
+    lines = body.splitlines()
+    for i, line in enumerate(lines):
+        if target not in line:
+            continue
+        stripped = line.strip()
+        if re.match(r"^(?:-\s+)?target:\s", stripped):
+            # Long syntax: pair with a `source:` key at the same indent
+            # within the same list item.
+            indent = len(line) - len(line.lstrip())
+            for j in range(max(0, i - 8), min(len(lines), i + 8)):
+                if j == i:
+                    continue
+                m = re.match(r"(\s*)(?:-\s+)?source:\s*(\S+)", lines[j])
+                if m and abs(len(m.group(1)) - indent) <= 2:
+                    sources.append(m.group(2))
+        else:
+            # Short syntax: the source is the text between the list
+            # marker and the first `:` that precedes the target.
+            idx = line.find(target)
+            m = re.search(r"-\s*(\S+)\s*$", line[:idx])
+            if m:
+                sources.append(m.group(1))
+    return sources
+
