+# ---------------------------------------------------------------------------
+# Install-script unwiring negative control (2026-10-14): for every
+# `delivery.entrypoint_invoke: true` patch, strip its mount + invoke lines
+# from a copy of a load-bearing compose and assert reaches() == False. The
+# legacy fallback used to answer True regardless (a dir entry added its
+# parent's `patches` marker, a file entry the bare `install.sh` basename),
+# overriding the sound delivery_spec check — an unwired patch looked
+# reached. A compose that mounts a DIFFERENT patch at the same in-container
+# target must also stay False.
+# ---------------------------------------------------------------------------
+import tempfile as _tf
+
+for patch in patches:
+    if not ((patch.get("delivery") or {}).get("entrypoint_invoke")):
+        continue
+    lb_composes = [c for lb in patch.get("load_bearing_when") or [] for c in lb.get("composes") or []]
+    if not lb_composes:
+        continue
+    spec = patch.get("delivery_spec") or {}
+    src_tokens = pa._patch_source_tokens(patch)
+    target = spec.get("mounted_at")
+    with _tf.TemporaryDirectory() as _td:
+        _tdp = Path(_td)
+        for compose_name in lb_composes:
+            if compose_name not in COMPOSE_REGISTRY:
+                continue
+            cpath = root / COMPOSE_REGISTRY[compose_name]["compose_path"]
+            text = cpath.read_text(encoding="utf-8")
+            stripped = [
+                ln for ln in text.splitlines()
+                if not (any(t in ln for t in src_tokens) or (target and target in ln))
+            ]
+            stripped_path = _tdp / f"stripped-{compose_name.replace('/', '-')}.yml"
+            stripped_path.write_text("\n".join(stripped), encoding="utf-8")
+            if pa.reaches(root, patch, str(stripped_path)):
+                errors.append(
+                    f"{patch['id']} negative control FAILED: reaches() reported "
+                    f"True on {compose_name} with the patch's mount + invoke "
+                    f"lines removed (legacy fallback overriding the "
+                    f"delivery_spec check)"
+                )
+            # Cross-patch control: mount a DIFFERENT install-script patch's
+            # directory at this patch's target. Source-aware matching must
+            # refuse it.
+            others = [
+                q for q in patches
+                if q["id"] != patch["id"]
+                and ((q.get("delivery") or {}).get("entrypoint_invoke"))
+                and (q.get("delivery_spec") or {}).get("script")
+                and pa._patch_source_tokens(q)
+            ]
+            if target:
+                other = others[0] if others else None
+                if other:
