+{"vllm-stable/mym": {"model":"mym","weights_variant":"local","workload":"fast-chat",
+ "engine":"vllm-stable","drafter":null,"kv_format":"f16","tp":1,"max_ctx":4096,
+ "max_num_seqs":1,"mem_util":0.9,
+ "compose_path":"scripts/lib/profiles-local/composes/mym/vllm-stable/compose/single/gguf/base.yml",
+ "default_port":20201,"kvcalc_key":"SKIP"}}
+JSON
+echo x > "$TMP/scripts/lib/profiles-local/composes/mym/vllm-stable/compose/single/gguf/base.yml"
+
+if scripts/catalog.sh update --slug vllm-stable/mym --set workload=long-ctx-single \
+     --set max_ctx=65536 --root "$TMP" >/dev/null 2>&1; then
+  if python3 - "$REG" <<'PY' >/dev/null 2>&1
+import json, sys
+e = json.load(open(sys.argv[1]))["vllm-stable/mym"]
+assert e["workload"] == "long-ctx-single" and e["max_ctx"] == 65536
+assert e["engine"] == "vllm-stable"          # engine == slug namespace
+assert "origin" not in e                     # loader-stamped, never stored
+PY
+  then echo "  ok   update amends fields in place, engine still == namespace"
+  else echo "  FAIL update wrote wrong fields"; rc=1; fi
+else
+  echo "  FAIL update failed"; rc=1
+fi
+for bad in "--set origin=local" "--set engine=llamacpp-club3090"; do
+  if scripts/catalog.sh update --slug vllm-stable/mym $bad --root "$TMP" >/dev/null 2>&1; then
+    echo "  FAIL update accepted $bad"; rc=1
+  else
+    echo "  ok   update refused $bad"
+  fi
+done
+if scripts/catalog.sh update --slug vllm/minimal --set workload=x --root "$TMP" >/dev/null 2>&1; then
+  echo "  FAIL update accepted a curated slug"; rc=1
+else
+  echo "  ok   update refused a curated slug"
+fi
+if scripts/catalog.sh rename --slug vllm-stable/mym --to vllm/minimal --root "$TMP" \
+     --dry-run >/dev/null 2>&1; then
+  echo "  FAIL rename onto a curated slug passed --dry-run"; rc=1
+else
+  echo "  ok   rename onto a curated slug refused"
+fi
+if scripts/catalog.sh rename --slug vllm-stable/mym --to vllm-stable/mym2 --root "$TMP" \
+     >/dev/null 2>&1; then
+  if python3 - "$REG" <<'PY' >/dev/null 2>&1
+import json, sys, os
