+def is_tool_unavailable(rc: int, blob: str) -> bool:
+    """True iff rung 1 failed because the `hf` CLI itself could not run
+    (missing binary, rc=127) — NOT because the hub refused the pull.
+
+    This is fallback-eligible: rung 3 needs only `curl` and the resolve
+    endpoint, so a host without the CLI must not kill the ladder. Matched on
+    both the exit code and the verbatim phrasing `_hf_download` emits when
+    `shutil.which` finds nothing, so an rc=127 from a shell wrapper (or an
+    "not on PATH" style message) also qualifies."""
+    low = (blob or "").lower()
+    return rc == 127 or "not on path" in low or "command not found" in low
+
