diff --git a/scripts/tests/test-report-gpu-vram.sh b/scripts/tests/test-report-gpu-vram.sh
new file mode 100644
index 0000000..4d1a4e0
--- /dev/null
+++ b/scripts/tests/test-report-gpu-vram.sh
@@ -0,0 +1,104 @@
+#!/usr/bin/env bash
+# test-report-gpu-vram — report.sh must attribute each GPU's VRAM to the
+# CONTAINER whose process actually holds that card (#1537).
+#
+# The old code asked only "is ANY club-3090 container running?" and credited it
+# with every card above 100 MiB. On a rig where a second stack's tensor-parallel
+# workers owned other cards, the report told the maintainer our sglang container
+# held GPUs 0 and 2 it could not even see, while nvidia-smi showed another
+# container's VLLM::Worker processes there.
+#
+# Contract asserted here (against stub nvidia-smi + docker):
+#   - an idle card reads as idle (the negative control);
+#   - a card held by one of our containers names that container;
+#   - a card held by a DIFFERENT container names that container, and never
+#     credits the running club container with a card it does not hold;
+#   - a card held by a non-club container is flagged as not ours;
+#   - with no docker, a busy card falls back to the generic warning rather
+#     than naming a container we cannot verify.
+set -uo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config
+
+ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
+cd "$ROOT_DIR"
+
+PASS=0; FAIL=0
+ok(){ PASS=$((PASS+1)); }
+no(){ echo "FAIL: $1" >&2; FAIL=$((FAIL+1)); }
+has(){ [[ "$2" == *"$3"* ]] && ok || no "$1: missing '$3' (got: $2)"; }
+hasnt(){ [[ "$2" != *"$3"* ]] && ok || no "$1: must NOT contain '$3' (got: $2)"; }
+
+tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
+mkdir -p "$tmp/bin"
+
+fn="$tmp/fn.sh"
+awk '/^report_gpu_vram\(\) \{/,/^}/' scripts/report.sh > "$fn"
+[[ -s "$fn" ]] || { echo "FAIL: report_gpu_vram() not found in report.sh"; exit 1; }
+
+# nvidia-smi + docker stubs are driven by $GPU_ROWS / $UUID_ROWS / $APP_ROWS and
+# a $PS / <container>.pids mapping.
+cat > "$tmp/bin/nvidia-smi" <<'EOS'
+#!/usr/bin/env bash
+case "$*" in
+  *"--query-gpu=index,uuid"*)     printf '%s\n' "${UUID_ROWS:-}" ;;
+  *"--query-compute-apps"*)       printf '%s\n' "${APP_ROWS:-}" ;;
+  *"--query-gpu=index,memory.used"*) printf '%s\n' "${GPU_ROWS:-}" ;;
+esac
+EOS
+cat > "$tmp/bin/docker" <<'EOS'
+#!/usr/bin/env bash
+case "$1" in
+  info) exit 0 ;;
+  ps)   [[ -f "$STUB/ps" ]] && cat "$STUB/ps" ;;
+  top)  [[ -f "$STUB/$2.pids" ]] && cat "$STUB/$2.pids" ;;
+esac
+EOS
+chmod +x "$tmp/bin"/*
+export STUB="$tmp"
+
+run(){
+  (
+    export PATH="$tmp/bin:$PATH"
+    have(){ command -v "$1" >/dev/null 2>&1; }
+    club_container_re(){ echo '^(vllm-|llama-cpp-|ik-llama-|sglang-|beellama-|club3090-|tabbyapi-|exl3-)'; }
+    # shellcheck source=/dev/null
+    source "$fn"
+    report_gpu_vram
+  )
+}
+
+# --- the #1537 rig: GPU1 = our sglang, GPU0/2 = another vllm container's TP workers
+export UUID_ROWS=$'0, GPU-aaa\n1, GPU-bbb\n2, GPU-ccc'
+export GPU_ROWS=$'0, 18000\n1, 17500\n2, 2'
+export APP_ROWS=$'GPU-aaa, 100\nGPU-bbb, 200'
+printf 'vllm-other\nsglang-cmp170hx\n' > "$tmp/ps"
+printf '100\n' > "$tmp/vllm-other.pids"
+printf '200\n' > "$tmp/sglang-cmp170hx.pids"
+out="$(run)"
+
+# GPU 0 is now correctly attributed to vllm-other, NOT to the running sglang.
+has  "GPU0 named its real holder (not our single running container)" "$out" 'GPU 0 idle VRAM:** 18000 MiB (held by running `vllm-other`)'
+has  "GPU1 names our container" "$out" 'GPU 1 idle VRAM:** 17500 MiB (held by running `sglang-cmp170hx`)'
+has  "GPU2 idle reads as idle" "$out" 'GPU 2 idle VRAM:** 2 MiB ✓'
+hasnt "GPU0 no longer falsely credited to sglang-cmp170hx" "$out" 'GPU 0 idle VRAM:** 18000 MiB (held by running `sglang-cmp170hx`)'
+
+# --- a busy card held by a NON-club container is flagged, never called ours
+printf 'stack-x\nsglang-cmp170hx\n' > "$tmp/ps"
+printf '100\n' > "$tmp/stack-x.pids"
+out="$(run)"
+has "foreign holder flagged as not ours" "$out" 'GPU 0 idle VRAM:** 18000 MiB ⚠ held by `stack-x` — another container, not a club-3090 engine'
+
+# --- no docker: busy card with a resident process degrades to the generic warning
+(
+  export PATH="$tmp/bin:$PATH"
+  have(){ [ "$1" = nvidia-smi ]; }
+  club_container_re(){ return 1; }
+  # shellcheck source=/dev/null
+  source "$fn"
+  report_gpu_vram
+) > "$tmp/nodock" 2>&1
+out="$(cat "$tmp/nodock")"
+has "no docker -> generic warning" "$out" 'GPU 0 idle VRAM:** 18000 MiB ⚠ something is using this GPU (display, browser, container)'
+
+echo "test-report-gpu-vram: PASS $PASS, FAIL $FAIL"
+[[ "$FAIL" -eq 0 ]]
