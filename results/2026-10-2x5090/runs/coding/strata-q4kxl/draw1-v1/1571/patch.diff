--- a/scripts/report.sh
+++ b/scripts/report.sh
@@ -203,6 +203,100 @@ gpu_power_caps() {
       done
 }
 
+# report_gpu_vram — one "GPU N idle VRAM: …" line per GPU, attributing each busy
+# card to the CONTAINER whose process actually holds it (#1537).
+#
+# The old code asked only "is ANY club-3090 container running?" and credited it
+# with every card above 100 MiB. On a rig where a second stack's tensor-parallel
+# workers owned other cards, report.sh told the maintainer our container held
+# GPUs it could not even see — `nvidia-smi` showed `VLLM::Worker_TP*` on cards
+# the running sglang container had no access to. Attribute PER CARD instead:
+#   1. `--query-compute-apps` names the holding PID on each card (by UUID);
+#   2. `docker top <c> -o pid` maps host PIDs back to a running container;
+#   3. `club_container_re` says whether that container is one of ours.
+# Our container is named against a card only when its own process is on it. A
+# busy card held by a foreign container is flagged as such, never credited to
+# us. A card with no attributable process keeps the original warning.
+report_gpu_vram() {
+  have nvidia-smi || return 0
+
+  local _vram_uuid _vram_apps
+  # Card identity: compute-apps keys on UUID, this section keys on index.
+  _vram_uuid="$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader,nounits 2>/dev/null || true)"
+  # Which PID is resident on which card (UUID).
+  _vram_apps="$(nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader,nounits 2>/dev/null || true)"
+
+  # host PID -> container name, for every RUNNING container. Best-effort: empty
+  # without docker, in which case attribution degrades to the generic warning.
+  local _vram_owner="" _vram_c _vram_p
+  if have docker && docker info >/dev/null 2>&1; then
+    while IFS= read -r _vram_c; do
+      [[ -z "$_vram_c" ]] && continue
+      while read -r _vram_p; do
+        [[ "$_vram_p" =~ ^[0-9]+$ ]] || continue
+        _vram_owner+="${_vram_p}"$'\t'"${_vram_c}"$'\n'
+      done < <(docker top "$_vram_c" -o pid 2>/dev/null)
+    done < <(docker ps --format '{{.Names}}' 2>/dev/null)
+  fi
+
+  local _vram_re _vram_idx _vram_used _vram_uu _vram_holders \
+        _vram_au _vram_ap _vram_name _vram_ours _vram_foreign
+  _vram_re="$(club_container_re 2>/dev/null || true)"
+
+  nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits 2>/dev/null \
+    | while IFS=, read -r _vram_idx _vram_used; do
+        _vram_idx="${_vram_idx# }"; _vram_used="${_vram_used# }"
+        _vram_idx="${_vram_idx% }"; _vram_used="${_vram_used% }"
+        [[ "$_vram_idx" =~ ^[0-9]+$ ]] || continue
+        [[ "$_vram_used" =~ ^[0-9]+$ ]] || continue
+        if (( _vram_used <= 100 )); then
+          echo "- **GPU $_vram_idx idle VRAM:** ${_vram_used} MiB ✓"
+          continue
+        fi
+
+        # Map this index to its UUID, then list every container with a process
+        # resident on that card.
+        _vram_uu="$(awk -F',' -v i="$_vram_idx" \
+            'function t(s){gsub(/^ +| +$/,"",s);return s} t($1)==i{print t($2); exit}' <<<"$_vram_uuid")"
+        _vram_holders=""
+        if [[ -n "$_vram_apps" && -n "$_vram_uu" ]]; then
+          while IFS=, read -r _vram_au _vram_ap; do
+            _vram_au="${_vram_au# }"; _vram_au="${_vram_au% }"
+            _vram_ap="${_vram_ap# }"; _vram_ap="${_vram_ap% }"
+            [[ "$_vram_au" == "$_vram_uu" ]] || continue
+            _vram_name="$(awk -F'\t' -v p="$_vram_ap" '$1==p{print $2; exit}' <<<"$_vram_owner")"
+            [[ -n "$_vram_name" ]] && _vram_holders+="${_vram_name}"$'\n'
+          done <<<"$_vram_apps"
+        fi
+        _vram_holders="$(sort -u <<<"$_vram_holders" | sed '/^$/d')"
+
+        # Split the holders into ours and not-ours.
+        _vram_ours=""; _vram_foreign=""
+        while IFS= read -r _vram_name; do
+          [[ -z "$_vram_name" ]] && continue
+          if [[ -n "$_vram_re" ]] && command grep -qE -- "$_vram_re" <<<"$_vram_name"; then
+            _vram_ours+="${_vram_ours:+, }\`${_vram_name}\`"
+          else
+            _vram_foreign+="${_vram_foreign:+, }\`${_vram_name}\`"
+          fi
+        done <<<"$_vram_holders"
+
+        if [[ -n "$_vram_ours" ]]; then
+          echo "- **GPU $_vram_idx idle VRAM:** ${_vram_used} MiB (held by running ${_vram_ours})"
+        elif [[ -n "$_vram_foreign" ]]; then
+          # Holders exist but are not one of ours (or the registry could not be
+          # read, in which case do not assert "not ours" — just name the holder).
+          if [[ -n "$_vram_re" ]]; then
+            echo "- **GPU $_vram_idx idle VRAM:** ${_vram_used} MiB ⚠ held by ${_vram_foreign} — another container, not a club-3090 engine"
+          else
+            echo "- **GPU $_vram_idx idle VRAM:** ${_vram_used} MiB (held by running ${_vram_foreign})"
+          fi
+        else
+          echo "- **GPU $_vram_idx idle VRAM:** ${_vram_used} MiB ⚠ something is using this GPU (display, browser, container)"
+        fi
+      done
+}
+
 # ---------------------------------------------------------------------------
 # Header
 # ---------------------------------------------------------------------------
@@ -756,27 +850,7 @@ section "Display / desktop state"
     echo "- **Display processes running:** none detected"
   fi
 
-  if have nvidia-smi; then
-    # Check if a club-3090 container is running (lightweight — full detection is later)
-    # NB: top-level (not in a function) — plain assignment, not `local`.
-    our_container=""
-    if have docker && docker info >/dev/null 2>&1; then
-      our_container=$(club_running_container)
-    fi
-    nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits 2>/dev/null \
-      | while IFS=, read -r idx used; do
-          idx="${idx# }"; used="${used# }"
-          if [[ "$used" =~ ^[0-9]+$ ]] && [[ "$used" -gt 100 ]]; then
-            if [[ -n "$our_container" ]]; then
-              echo "- **GPU $idx idle VRAM:** ${used} MiB (held by running \`${our_container}\`)"
-            else
-              echo "- **GPU $idx idle VRAM:** ${used} MiB ⚠ something is using this GPU (display, browser, container)"
-            fi
-          else
-            echo "- **GPU $idx idle VRAM:** ${used} MiB ✓"
-          fi
-        done
-  fi
+  report_gpu_vram
 } | redact
 
