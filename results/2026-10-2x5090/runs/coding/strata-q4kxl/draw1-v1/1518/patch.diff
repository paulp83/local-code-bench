diff --git a/scripts/lib/bench-row-formatter.sh b/scripts/lib/bench-row-formatter.sh
index 6961abd..2d3e54e 100644
--- a/scripts/lib/bench-row-formatter.sh
+++ b/scripts/lib/bench-row-formatter.sh
@@ -400,7 +400,10 @@ def load() -> dict[str, Any]:
     name = str(config_blob.get("Name") or "").lstrip("/")
     served = flag(cmd, "--served-model-name")
     tp = flag(cmd, "--tensor-parallel-size")
-    compose = rel(labels.get("com.docker.compose.project.config_files") or "")
+    # Since #1498 the label is a comma-joined list of compose files (the slug
+    # compose plus the slug-label override). The bench record wants the slug's
+    # compose, which is the first entry; rel() can't handle a joined string.
+    compose = rel((labels.get("com.docker.compose.project.config_files") or "").split(",")[0].strip())
     if not compose:
         compose = infer_compose_path(name, served, tp)
     rig = parse_rig(read_text(require_file("rig.txt")))
diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..aaa9d2f 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1027,7 +1027,25 @@ down_running() {
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      # Since the slug-label feature (#1498) the compose bring-up adds a second
+      # override file, so the label is a COMMA-JOINED list of compose files.
+      # Docker Compose expects one -f per file; passing the joined string as a
+      # single -f fails with `compose file "…,…" is invalid` and silently falls
+      # back to `docker stop`, leaking the compose network and orphans. Split it
+      # the same way scripts/litellm-log.sh does, emitting one -f per compose
+      # file (skipping any empty entry left by a trailing comma).
+      local -a cfg_args=() _cfgs
+      local _f
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      for _f in "${_cfgs[@]}"; do
+        [[ -n "$_f" ]] || continue
+        cfg_args+=(-f "$_f")
+      done
+      if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
