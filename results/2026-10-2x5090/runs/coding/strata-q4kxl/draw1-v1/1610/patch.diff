 # --------------------------------------------------------------------------
 # gap_declared / reaches.
 # --------------------------------------------------------------------------
+# Generic artifact names that carry NO identifying signal: every compose
+# that mounts *any* install script contains `install.sh`, and every patch
+# lives under a `…/patches/…` directory, so `patches` (or a `local` /
+# `genesis` grouping dir) appears wherever any overlay is mounted. They must
+# never be used as legacy-fallback markers on their own.
+_GENERIC_ARTIFACT_NAMES = frozenset(
+    {
+        # generic file basenames
+        "install.sh",
+        "install",
+        "apply.sh",
+        "apply.py",
+        "apply",
+        "patch.sh",
+        "run.sh",
+        "setup.sh",
+        "main.py",
+        "entrypoint.sh",
+        # generic grouping directory names (under …/patches/)
+        "patches",
+        "local",
+        "genesis",
+        "vllm",
+        "sglang",
+    }
+)
+
+
+def _legacy_invoke_markers(patch: dict, root: Path) -> list[str]:
+    """Identifying markers for the deprecated ``delivery.entrypoint_invoke``
+    fallback (entries that carry only the ``delivery:`` block, no
+    ``delivery_spec``).
+
+    For each declared file we keep only *identifying* tokens:
+
+    * a non-generic file basename (e.g. ``patch_flashinfer_decode_pin.py``,
+      ``qwen3coder_tool_parser_deferred_commit.py``);
+    * the patch directory's OWN name (the ``…/patches/<name>`` directory that
+      holds the artifact) — never its ``patches`` / ``local`` parent.
+
+    Generic names (``install.sh``, ``patches``, …) are dropped: they appear
+    in any mount-bearing compose and would make the fallback always-True,
+    silently overriding a correct not-reached verdict.
+    """
+    markers: list[str] = []
+    for rel in patch.get("files") or []:
+        path = Path(rel)
+        name = path.name
+        is_dir = (root / rel).is_dir()
+        if name not in _GENERIC_ARTIFACT_NAMES:
+            markers.append(name)
+        # The patch directory's own name: the dir entry itself, or the
+        # holding directory for a file entry.
+        patch_dir = path if is_dir else path.parent
+        if patch_dir.name and patch_dir.name not in _GENERIC_ARTIFACT_NAMES:
+            markers.append(patch_dir.name)
+    # de-dup, preserve order
+    seen: set[str] = set()
+    out: list[str] = []
+    for m in markers:
+        if m not in seen:
+            seen.add(m)
+            out.append(m)
+    return out
+
+
+def _spec_is_decidable(patch: dict) -> bool:
+    """True iff ``delivery_spec`` carries a marker for EVERY insertion
+    point it claims in ``wired_at``.
+
+    When it does, :func:`_spec_wiring_present` can give a sound verdict and
+    that verdict is authoritative (a not-wired spec must not be rescued by
+    the legacy fallback). When the spec declares an insertion point it gives
+    no marker for, it cannot decide that point, so it is not authoritative
+    and the legacy fallback stays in play.
+    """
+    spec = patch.get("delivery_spec")
+    if not spec:
+        return False
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = set(wired_at or [])
+    vol_markers, inv_markers = _spec_wiring_markers(patch)
+    if "volumes" in wired_at and not vol_markers:
+        return False
+    if "entrypoint" in wired_at and not inv_markers:
+        return False
+    if not wired_at:
+        # Unknown / empty wired_at: decidable only if some marker exists.
+        return bool(vol_markers or inv_markers)
+    return True
+
