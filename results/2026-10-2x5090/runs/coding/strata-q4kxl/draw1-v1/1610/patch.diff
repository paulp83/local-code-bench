+# (4b) Legacy-fallback regression: an install-script patch whose mount +
+#     invoke are REMOVED from a compose must report NOT reached. Historically
+#     the read-only `delivery.entrypoint_invoke` fallback keyed on the bare
+#     `install.sh` basename and the always-`patches` parent-dir name, both of
+#     which every mount-bearing compose contains, so a stripped compose (no
+#     line left mentioning the patch) still reported reached — the legacy
+#     fallback silently overrode a correct not-reached verdict from the sound
+#     delivery_spec check. Build a mount-bearing fixture and its stripped
+#     twin; the real one reaches, the stripped twin MUST NOT.
+install_script_spec_patches = [
+    p for p in patches
+    if p.get("delivery_mechanism") == "install_script"
+    and (p.get("delivery_spec") or {}).get("mounted_at")
+    # prefer a DIRECTORY files entry: the old fallback added its parent dir
+    # name (always `patches`) as a marker — the exact string every
+    # mount-bearing compose contains, which is what made the fallback
+    # always-True for install-script patches.
+    and any((root / rel).is_dir() for rel in p.get("files") or [])
+]
+if install_script_spec_patches:
+    isp = install_script_spec_patches[0]
+    spec = isp["delivery_spec"]
+    mounted = spec["mounted_at"]
+    invoke = spec.get("invoke") or ""
+    with tempfile.TemporaryDirectory() as _td:
+        _tdp = Path(_td)
+        wired = _tdp / "wired.yml"
+        stripped = _tdp / "stripped.yml"
+        body = (
+            "services:\n"
+            "  svc:\n"
+            "    image: scratch\n"
+            "    volumes:\n"
+            "      - ../../patches/example:/x\n"
+            "      - ./scripts/detect_nvlink.sh:/etc/detect_nvlink.sh:ro\n"
+            "      - ./patches/%s:%s:ro\n"
+            "    entrypoint: [\"sh\", \"-c\", \"%s && vllm-serve\"]\n"
+            % (isp["id"], mounted, invoke)
+        )
+        wired.write_text(body, encoding="utf-8")
+        # Strip every line carrying a spec wiring marker (the patch's mount
+        # + invoke) — leaving a compose that mounts SOME patches dir and runs
+        # SOME install script but never this patch.
+        _vol, _inv = pa._spec_wiring_markers(isp)
+        _lines = [
+            ln for ln in body.splitlines()
+            if not any(m and m in ln for m in (_vol + _inv))
+        ]
+        stripped.write_text("\n".join(_lines) + "\n", encoding="utf-8")
+        if not pa.reaches(root, isp, str(wired)):
+            errors.append(
+                "install-script legacy-fallback control: a genuinely "
+                "mount+wired install_script patch (%s) was NOT reported "
+                "reached on a compose carrying its mount + invoke" % isp["id"]
+            )
+        if pa.reaches(root, isp, str(stripped)):
+            errors.append(
+                "install-script legacy-fallback FALSE-POSITIVE: install_script "
+                "patch %s still reported reached after its mount + invoke "
+                "lines were stripped from the compose (the generic "
+                "`install.sh`/`patches` legacy fallback overriding the sound "
+                "delivery_spec verdict)" % isp["id"]
+            )
+
