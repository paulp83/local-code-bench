+def _local_engine_profile_content(spec: dict) -> Optional[str]:
+    """The carried local ENGINE profile text, or None.
+
+    catalog.sh register builds a minimal engine profile for an engine the
+    curated catalog does not know and CARRIES it here instead of writing it
+    itself — so the write goes through this module's plan, ``--dry-run`` exit
+    and confirm like every other artifact. Without this, a ``--dry-run``
+    register leaked an ``engines.d/<engine>.yml`` that nothing downstream could
+    stop."""
+    lep = spec.get("local_engine_profile")
+    if isinstance(lep, str) and lep.strip():
+        return lep
+    return None
+
