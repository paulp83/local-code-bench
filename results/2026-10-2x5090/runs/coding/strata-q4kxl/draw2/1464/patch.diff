-up_variant() {
-  local v="$1"
+# Refusal-capable pre-flight that does NOT depend on the running slug having
+# been torn down. It MUST run BEFORE down_running() so that a launch which is
+# going to be refused leaves the currently-serving model untouched instead of
+# leaving the rig dark. We hit this twice on the reference rig in one day: an
+# experimental slug run without --force, and a worktree whose model files
+# weren't on the host (no MODEL_DIR) — both tore the running slug down first and
+# only then refused, so the rig served nothing. A mistyped slug did the same.
+#
+# Everything here either passes through or refuses the launch BEFORE anything is
+# torn down. The checks that need the GPUs to be FREE (they read memory.free:
+# preflight_compose_gpu_fit / gpu_preflight and the CPU-offload residency
+# sizers) deliberately stay in up_variant(), AFTER the teardown.
+preflight_launch() {
+  local v="$1" eng dir file
   if [[ -z "${VARIANTS[$v]:-}" ]]; then
     echo "ERROR: unknown variant '${v}'." >&2
     echo "Run: bash scripts/switch.sh --list" >&2
@@ -1239,12 +1251,14 @@ up_variant() {
     exit 1
   fi
 
-  # Pre-up sanity:
+  # Pre-up sanity that needs only the compose + the host's STATIC hardware
+  # (memory.total / SM), never the post-teardown free-VRAM state:
   #  - repo_drift: warn if local HEAD is behind origin/master
-  #  - compose_deps: HARD error if compose mounts a model dir that doesn't exist on host
-  #    (catches the "you didn't WITH_DFLASH_DRAFT=1 then tried dual-dflash-noviz" case;
-  #     see club-3090#37 — this is the canonical fix raphael / snoby asked for)
-  #  - kv_format_hint: soft warn if VRAM class needs --kv-cache-dtype override (#47)
+  #  - compose_deps: HARD error if compose mounts a model dir that doesn't exist
+  #    on host (the missing-MODEL_DIR / worktree case; see club-3090#37)
+  #  - compose_hardware: GPU VRAM-class / SM floor (reads memory.total)
+  #  - lmcache_ram: host-RAM guard (refuses even under --force; #133)
+  #  - offload_split_mode / kv_format_hint / offload_thp: offload + KV hints
   if [[ -f "${ROOT_DIR}/scripts/preflight.sh" ]]; then
     # shellcheck source=preflight.sh
     source "${ROOT_DIR}/scripts/preflight.sh"
@@ -1252,18 +1266,39 @@ up_variant() {
