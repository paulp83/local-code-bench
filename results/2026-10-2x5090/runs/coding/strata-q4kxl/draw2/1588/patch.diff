+def _url_host_port(url):
+    """(host, port) from ``url``, or (None, None). Handles a bracketed IPv6 host.
+    The port must be explicit (mirrors the old behaviour: a URL with no port can
+    not be matched against a docker publish)."""
+    m = re.match(r"^[a-z]+://\[([^\]]+)\]:(\d+)", url or "")
+    if not m:
+        m = re.match(r"^[a-z]+://([^/:]+):(\d+)", url or "")
     if not m:
+        return None, None
+    return m.group(1), int(m.group(2))
+
+
+def _host_addresses(host):
+    """The addresses a URL host names — mirrors listen-scope.sh's _host_addrs:
+    localhost / 0.0.0.0 → loopback; a literal IPv4 or bracketed IPv6 → itself; a
+    hostname → whatever it resolves to. ``URL=http://<this rig's hostname>:PORT``
+    must count as this host, or a correct container would be dropped."""
+    if not host:
+        return []
+    if host in ("localhost", "0.0.0.0"):
+        return ["127.0.0.1", "::1"]
+    if ":" in host or re.fullmatch(r"[0-9.]+", host):
+        return [host]
+    try:
+        return sorted({ai[4][0] for ai in socket.getaddrinfo(host, None)})
+    except Exception:
+        return []
+
+
+def _own_addresses():
+    """This host's own addresses (``hostname -I``), for matching a 0.0.0.0 publish."""
+    try:
+        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=5)
+        return set(out.stdout.split())
+    except Exception:
+        return set()
+
+
+def _mapping_serves(mapping, port, addrs, own):
+    """True when a single docker ``BIND:HPROT[-HPROT]->INTERNAL/tcp`` mapping
+    publishes ``port`` on one of ``addrs`` — mirrors listen-scope.sh's
+    ports_serve_url: a 0.0.0.0 / :: bind serves this host's own addresses (incl.
+    loopback); a 127.x / ::1 bind only loopback; anything else only that exact
+    address."""
+    if "->" not in mapping:
+        return False                                  # exposed, not published
+    left = mapping.split("->", 1)[0].strip()
+    if ":" not in left:
+        return False
+    bind, hport = left.rsplit(":", 1)
+    bind = bind.lstrip("[").rstrip("]")
+    lo, _, hi = hport.partition("-")
+    hi = hi or lo
+    try:
+        lo_i, hi_i = int(lo), int(hi)
+    except ValueError:
+        return False
+    if not (lo_i <= port <= hi_i):
+        return False
+    for a in addrs:
+        if bind in ("0.0.0.0", "::", ""):
+            if a.startswith("127.") or a == "::1" or a in own:
+                return True
+        elif bind.startswith("127.") or bind == "::1":
+            if a.startswith("127.") or a == "::1":
+                return True
+        else:
+            if a == bind:
+                return True
+    return False
+
+
