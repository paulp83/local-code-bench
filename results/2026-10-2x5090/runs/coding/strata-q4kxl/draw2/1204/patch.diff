+# First-class catalog PROVENANCE — which layer an entry's data lives in. This
+# replaces the old implicit convention where provenance was read off the SLUG
+# (a `local/` prefix). The loader is the single authority: a CORE row (loaded
+# from registry.yaml) is ALWAYS origin="core"; a LOCAL row (loaded from
+# registry.local.json) is ALWAYS origin="local". Because provenance is derived
+# from WHERE the data lives, publishing a model out of the local layer into the
+# curated catalog is a FLIP of this value — not a slug rename — so a user's
+# scripts, notes and compose pins survive promotion. "core wins": a local entry
+# can never claim a core origin (and never shadows a core slug — see
+# get_registry). It is an ASSIGNED field (like pp / gpu_assignment_mode), never
+# authorable in the DATA files.
+ORIGIN_VALUES = ("core", "local")
+CORE_ORIGIN = "core"
+LOCAL_ORIGIN = "local"
+
 # Compose `Status:` header emoji → registry status word. The header may carry
 # trailing prose after the canonical token (e.g. "✅ Production (NEW — ...)");
 # matching is by the leading emoji, so prose is tolerated.
