diff --git a/scripts/lib/p2p-state.sh b/scripts/lib/p2p-state.sh
index 6b53fb8..615bda1 100644
--- a/scripts/lib/p2p-state.sh
+++ b/scripts/lib/p2p-state.sh
@@ -101,7 +101,11 @@ p2p_driver_flavor() {
 # understood by the classifier. Keeping this here makes bench.sh and report.sh
 # consume identical evidence. In particular, SGLang does not run our
 # detect_nvlink.sh entrypoint, but it emits definitive runtime lines for NCCL
-# and CustomAllReduceV2 initialization.
+# and all-reduce initialization: CustomAllReduceV2 logs "All Reduce config:" on
+# success, while V1 CustomAllreduce (the path every PCIe rig takes — V2 is
+# NVLink-only) logs nothing at init and only surfaces "Registering N cuda graph
+# addresses" (rank 0, after CUDA-graph capture). Both are kept as engagement
+# proof; they are mutually exclusive per boot.
 p2p_engine_log_evidence() {
   awk '
     index($0, "server_args=") && index($0, "disable_custom_all_reduce") {
@@ -118,7 +122,8 @@ p2p_engine_log_evidence() {
     index($0, "disable_custom_all_reduce=True") ||
     index($0, "Setup Custom allreduce failed") ||
     index($0, "sglang is using nccl==") ||
-    index($0, "All Reduce config:") { print }
+    index($0, "All Reduce config:") ||
+    index($0, "cuda graph addresses") { print }
   '
 }
 # Engagement classifier — PURE (takes the boot-trail/env text on stdin so the
@@ -160,8 +165,8 @@ p2p_classify_engagement() {
     # SGLang has no club STATE line. Its server_args dump is the boot marker;
     # p2p_engine_log_evidence normalizes the enormous dict to this short line.
     # Slice at the last marker so an operator-disabled restart cannot combine
-    # with an "All Reduce config" success line from an earlier boot (or vice
-    # versa).
+    # with an earlier boot's success line ("All Reduce config" / "Registering N
+    # cuda graph addresses") (or vice versa).
     sglang_boot="$(printf '%s\n' "$text" | command grep -F '[sglang] BOOT disable_custom_all_reduce=' | tail -n 1)"
     if [ -n "$sglang_boot" ]; then
       text="$(printf '%s\n' "$text" | tac \
@@ -266,8 +271,14 @@ p2p_classify_engagement() {
       case "$text" in *"P2P off"*|*"using PCIe mode"*|*"forcing PCIe mode"*|*NCCL_P2P_DISABLE=1*) echo off; return 0 ;; esac
       echo nccl_only_operator; return 0 ;;
   esac
+  # CustomAllReduceV2 prints "All Reduce config:" on success. V1 CustomAllreduce
+  # — the ONLY custom path on a PCIe rig, since V2 is gated on full NVLink — logs
+  # nothing at init; its sole success signal is rank 0 registering the captured
+  # graph buffers ("Registering N cuda graph addresses"). Either is positive
+  # engagement proof: V1 only reaches that call when the custom kernel is live
+  # (a disabled/failed/gated boot never does, and those all resolve above).
   case "$text" in
-    *"All Reduce config:"*|*"custom all-reduce ON"*|*"enabling NVLink mode"*) echo on; return 0 ;;
+    *"All Reduce config:"*|*"Registering"*"cuda graph addresses"*|*"custom all-reduce ON"*|*"enabling NVLink mode"*) echo on; return 0 ;;
   esac
   case "$text" in
     *"P2P off"*|*"using PCIe mode"*|*"forcing PCIe mode"*) echo off; return 0 ;;
