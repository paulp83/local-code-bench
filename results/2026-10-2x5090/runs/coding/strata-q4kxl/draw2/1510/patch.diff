index 0000000..d4f7426
--- /dev/null
+++ b/scripts/tests/test-concurrency-probe-skip-scoping.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+# test-concurrency-probe-skip-scoping — GPU-free regression guards for two
+# concurrency-probe bugs:
+#   (1) --sweep aborted (rc=1) at the first SKIPPED cell: emit_row piped the row
+#       on stdin, but the python here-doc IS stdin, so json.loads("") raised and
+#       `set -e` killed the run before the card/recommend/results were written.
+#   (2) VRAM and the GPU label were rig-wide, not the probed container's cards.
+set -euo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PROBE="$ROOT_DIR/scripts/concurrency-probe.sh"
+LIB="$ROOT_DIR/scripts/lib/concurrency_probe.py"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+
+bash -n "$PROBE" || fail "bash -n"
+python3 -m py_compile "$LIB" || fail "py_compile"
+echo "  ✓ syntax"
+
+# --- (1) emit_row must accept the row as ARGV, not stdin ------------------------
+# Reproduce the exact emit_row contract from the script: argv[1]=path argv[2]=json.
+cells="$(mktemp)"
+python3 - "$cells" '{"ctx":32768,"n":8,"skip":"clipped"}' <<'PY' || fail "emit_row contract"
+import json, sys
+row = json.loads(sys.argv[2])
+with open(sys.argv[1], "a", encoding="utf-8") as fh:
+    fh.write(json.dumps(row, ensure_ascii=False) + "\n")
+PY
+[[ "$(wc -c < "$cells")" -gt 0 ]] || fail "emit_row wrote 0 bytes"
+grep -q '"skip": "clipped"' "$cells" || fail "emit_row row malformed"
+rm -f "$cells"
+# The script must no longer pipe into emit_row (the stdin collision).
+if command grep -vE '^[[:space:]]*#' "$PROBE" | command grep -qE 'printf .* \| emit_row'; then
+  fail "emit_row still fed via stdin pipe (json.loads('') crash returns)"
+fi
+command grep -qE 'emit_row\(\) \{' "$PROBE" || fail "emit_row() gone"
+command grep -qE 'python3 - "\$cells_jsonl" "\$1"' "$PROBE" \
+  || fail "emit_row must pass the row via argv (\$1)"
+echo "  ✓ emit_row takes the row as argv (skipped cells no longer kill --sweep)"
+
+# --- (2a) GPU resolution from docker inspect ------------------------------------
+PYTHONPATH="$ROOT_DIR/scripts/lib" python3 - "$LIB" <<'PY' || fail "container gpu resolution"
+import importlib.util, sys
+spec = importlib.util.spec_from_file_location("cp", sys.argv[1])
+m = importlib.util.module_from_spec(spec); sys.modules["cp"] = m
+spec.loader.exec_module(m)
+bad=[]
+def ck(c,msg):
+    if not c: bad.append(msg)
+ck(m.parse_container_gpus([{"HostConfig":{"DeviceRequests":[{"Capabilities":[["gpu"]],"DeviceIDs":["3"]}]},"Config":{"Env":[]}}])==["3"],
+   "DeviceRequests DeviceIDs must scope to that card")
+ck(m.parse_container_gpus([{"HostConfig":{"DeviceRequests":[]},"Config":{"Env":["NVIDIA_VISIBLE_DEVICES=0,1"]}}])==["0","1"],
+   "NVIDIA_VISIBLE_DEVICES fallback")
+ck(m.parse_container_gpus([{"HostConfig":{"DeviceRequests":[{"Capabilities":[["gpu"]],"DeviceIDs":["-1"]}]},"Config":{"Env":[]}}])==[],
+   "DeviceIDs -1 means all -> rig-wide")
+ck(m.parse_container_gpus([{"HostConfig":{},"Config":{"Env":["NVIDIA_VISIBLE_DEVICES=all"]}}])==[],
+   "NVIDIA_VISIBLE_DEVICES=all -> rig-wide")
+ck(m.parse_container_gpus({})==[], "empty inspect -> rig-wide")
+ck(m._nvidia_smi_gpu_args(["3"])==["-i","3"], "-i splice")
+ck(m._nvidia_smi_gpu_args([])==[], "no scope -> no -i")
+# gpu_fingerprint scoping vs rig-wide fallback (stub the nvidia-smi name query).
+m.gpu_names = lambda gpus=None: (
+    ["GeForce RTX 3060"] if gpus==["3"]
+    else ["GeForce RTX 3090"]*4)
+_ck = m.container_gpus
+m.container_gpus = lambda c: ["3"] if c else []
+ck(m.gpu_fingerprint("svc")=="1\u00d7 GeForce RTX 3060", "scoped label is the container's card")
+ck(m.gpu_fingerprint("svc").endswith("(rig-wide)"), "rig-wide fallback must say so") if False else None
+m.container_gpus = lambda c: []
+fp = m.gpu_fingerprint("svc")
+ck(fp=="4\u00d7 GeForce RTX 3090 (rig-wide)", f"unresolved -> rig-wide and says so, got {fp!r}")
+m.container_gpus = _ck
+if bad:
+    print("\n".join(bad)); raise SystemExit(1)
+PY
+echo "  ✓ GPU scope resolves from docker inspect; rig-wide fallback is flagged"
+
+# --- (2b) the VRAM query carries -i when scoped ---------------------------------
+SHIM="$(mktemp -d)"; trap 'rm -rf "$SHIM"' EXIT
+printf '#!/usr/bin/env bash\necho 10381\n' > "$SHIM/nvidia-smi"; chmod +x "$SHIM/nvidia-smi"
+out="$(PATH="$SHIM:$PATH" PYTHONPATH="$ROOT_DIR/scripts/lib" python3 - "$LIB" <<'PY'
+import importlib.util, sys
+spec = importlib.util.spec_from_file_location("cp", sys.argv[1])
+m = importlib.util.module_from_spec(spec); sys.modules["cp"] = m; spec.loader.exec_module(m)
+import subprocess
+seen={}
+orig=m.subprocess.run
+def spy(cmd,*a,**k):
+    if cmd and cmd[0]=="nvidia-smi": seen["cmd"]=cmd
+    return orig(cmd,*a,**k)
+m.subprocess.run=spy
+m.vram_used_mb(["3"])
+assert "-i" in seen["cmd"] and "3" in seen["cmd"], seen["cmd"]
+seen.clear()
+m.vram_used_mb()
+assert "-i" not in seen["cmd"], "no scope must not pass -i"
+PY
+)" || fail "vram scoping query"
+echo "  ✓ vram_used_mb scopes the nvidia-smi query to the container's cards"
+
+echo "test-concurrency-probe-skip-scoping: ok"
