+def derive_compose_facts(text: str, path: str = "") -> "ComposeFacts":
+    """Delegate to the shared ``compose_facts`` module (#1202 P1).
+
+    Implementation moved to
+    ``scripts.lib.profiles.compose_facts.derive_compose_facts`` so the cockpit
+    and the CLI derive spec facts identically; this thin wrapper keeps every
+    existing ``from club3090_cockpit.data import derive_compose_facts`` caller
+    working unchanged."""
+    return _load_compose_facts().derive_compose_facts(text, path)
