+# keeps working AND the import stays lazy (importing ``data`` never pays the
+# sys.path setup unless one of these names is actually touched).
+_COMPOSE_FACTS_REEXPORTS = frozenset({"ComposeFacts", "_ENGINE_BY_IMAGE"})
+
+
+def __getattr__(name: str):
+    """Re-export names relocated to the shared compose_facts module (#1202 P1)."""
+    if name in _COMPOSE_FACTS_REEXPORTS:
