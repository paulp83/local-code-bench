+# ── which container answers $URL, and what spec-decoding it runs (#1537) ──────
+# The concurrency card named the wrong container: CONTAINER came from a `vllm-(qwen|gemma)`
+# name heuristic, so an SGLang container was never found — it then labelled the wrong GPUs and
+# measured VRAM rig-wide. And the spec label grepped the container's Cmd for --speculative-config,
+# which a build that composes that flag inside its entrypoint (from SPEC_N) never shows. Both are
+# resolved here by asking the running rig: which container PUBLISHES the URL's port (any engine),
+# and what the ENGINE reports for speculation (vLLM's boot config, SGLang's get_server_info).
+_SPEC_LOG_PREFIX_BYTES = 8 * 1024 * 1024
+
+
+def _url_port(url):
+    """The host port $URL targets. '' when there is nothing to match on."""
+    url = (url or "").strip()
+    if not url:
+        return ""
+    candidate = url if "://" in url else "http://" + url
+    try:
+        parsed = urllib.parse.urlparse(candidate)
+        port = parsed.port
+    except ValueError:
+        return ""
+    if port:
+        return str(port)
+    return {"http": "80", "https": "443"}.get(parsed.scheme, "")
+
+
+def container_for_url(url):
+    """Name of the RUNNING container that publishes $URL's host port, or "".
+
+    Matches the published (host) side of `docker ps`'s Ports column — a host port is
+    always the token immediately left of an arrow (``0.0.0.0:8020->8000/tcp``). Engine
+    agnostic on purpose: the name heuristic missed every non-vLLM container (#1537).
+    """
+    port = _url_port(url)
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", timeout=10,
+        )
+    except Exception:
+        return ""
+    rx = re.compile(r"(?<!\d)" + re.escape(port) + r"->")
+    for line in (out.stdout or "").splitlines():
+        if not line.strip():
+            continue
+        if "\t" in line:
+            name, _, ports = line.partition("\t")
+        else:
+            # a plain `docker ps` table: NAMES is the last column, the port arrow lives
+            # in the (space-containing) PORTS column somewhere before it
+            cols = line.split()
+            name, ports = (cols[-1] if cols else ""), line
+        if rx.search(ports):
+            return name.strip()
+    return ""
+
+
+def _docker_logs_head(container, max_bytes=_SPEC_LOG_PREFIX_BYTES):
+    """Bounded PREFIX of `docker logs` (stdout+stderr merged). `docker logs` has no
+    --head, and a long-lived engine's log runs to hundreds of MB, so read a prefix and
+    stop — the engine config dump is at the boot log's HEAD (#1537: the tail reads
+    spec off on a spec-decoded run because the config line scrolls off)."""
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        )
+    except (FileNotFoundError, OSError):
+        return ""
+    chunks, total = [], 0
+    try:
+        while total < max_bytes:
+            chunk = proc.stdout.read(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            total += len(chunk)
+    finally:
+        try:
+            proc.stdout.close()
+        except OSError:
+            pass
+        if proc.poll() is None:
+            proc.kill()
+        proc.wait()
+    return b"".join(chunks).decode("utf-8", "replace")
+
+
+def _render_spec_label(method, n):
+    """'MTP n=4' / 'MTP' from a method name and an optional token count."""
+    label = str(method).upper()
+    try:
+        n = int(n)
+    except (TypeError, ValueError):
+        n = 0
+    if n:
+        label += f" n={n}"
+    return label
+
+
+def _vllm_spec_label(container):
+    """vLLM label from the container's boot config, or None when this is not a readable vLLM engine.
+
+    Reads `Initializing a V1 LLM engine ... with config: ... speculative_config=...` from the
+    HEAD of the log: SpeculativeConfig(method='mtp', ..., num_spec_tokens=4) -> 'MTP n=4';
+    speculative_config=None -> 'spec off'. None (not 'spec off') means "no vLLM config dump to
+    read", so the caller can fall through to the SGLang source.
+    """
+    if not container:
+        return None
+    head = _docker_logs_head(container)
+    if "speculative_config=" not in head:
+        return None
+    line = None
+    for ln in head.splitlines():
+        if "speculative_config=" in ln and ("with config:" in ln or "Initializing a V1 LLM engine" in ln):
+            line = ln
+            break
+    if line is None:
+        for ln in head.splitlines():
+            if "speculative_config=" in ln:
+                line = ln
+                break
+    if line is None:
+        return None
+    rest = line[line.index("speculative_config=") + len("speculative_config="):]
+    if rest.lstrip().startswith("None"):
+        return "spec off"
+    # method= / num_spec_tokens= only appear inside the SpeculativeConfig repr on this line;
+    # scanning the rest of the line (not a strict paren match) survives a model path that
+    # itself contains a parenthesis.
+    mm = re.search(r"method='([^']+)'", rest) or re.search(r'method="([^"]+)"', rest)
+    if not mm:
+        return "spec off"
+    nn = re.search(r"num_spec_tokens=(\d+)", rest)
+    return _render_spec_label(mm.group(1), nn.group(1) if nn else "")
+
+
+def _get_json(url, timeout=5):
+    try:
+        with urllib.request.urlopen(urllib.request.Request(url), timeout=timeout) as resp:
+            return json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+
+
+def _same_checkpoint(a, b):
+    def norm(x):
+        x = (x or "").strip().rstrip("/")
+        return os.path.normpath(x) if x else ""
+    na, nb = norm(a), norm(b)
+    return bool(na) and na == nb
+
+
+def _sglang_spec_label(url):
+    """SGLang label from GET $URL/get_server_info, or None when that is not readable.
+
+    speculative_algorithm / speculative_num_steps. EAGLE run over the target's OWN checkpoint
+    is MTP (the same Qwen MTP head vLLM reports as method='mtp'), so it prints 'MTP n=<steps>'.
+    """
+    if not url:
+        return None
+    data = _get_json(url.rstrip("/") + "/get_server_info")
+    if not isinstance(data, dict) or "speculative_algorithm" not in data:
+        return None
+    algo = data.get("speculative_algorithm")
+    if not algo:
+        return "spec off"
+    name = str(algo).upper()
+    # Qwen MTP rides SGLang's EAGLE path over the target's OWN checkpoint (the same MTP head
+    # vLLM reports as method='mtp'), so it prints "MTP n=<steps>". Only a separately-named
+    # drafter under EAGLE is a genuine EAGLE draft model rather than MTP.
+    if "EAGLE" in name:
+        model = data.get("model_path")
+        draft = data.get("speculative_draft_model_path")
+        if not draft or _same_checkpoint(model, draft):
+            name = "MTP"
+    return _render_spec_label(name, data.get("speculative_num_steps"))
+
+
+def spec_label(container, url):
+    """The speculative-decoding label read from the engine, or '' when neither source is readable.
+
+    vLLM first (its config dump is vLLM-specific, so a hit is decisive), then SGLang's
+    get_server_info. Reads from the ENGINE, not the container's Cmd: a build that composes
+    --speculative-config inside its entrypoint never shows it in Cmd (#1537).
+    """
+    v = _vllm_spec_label(container)
+    if v is not None:
+        return v
+    s = _sglang_spec_label(url)
+    if s is not None:
+        return s
+    return ""
+
