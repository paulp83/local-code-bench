diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..af87e1b 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1026,8 +1026,28 @@ down_running() {
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
+    # The label can hold several comma-joined compose files (the slug's
+    # compose plus the club3090.slug label override from #1498). Docker
+    # Compose needs each as its own -f; passing the joined string as one
+    # path fails with "compose file ...,… is invalid". Mirror litellm-log.sh:
+    # split on commas, drop entries that no longer exist (the label override
+    # can be gone by teardown time, e.g. after the data dir moved), and only
+    # fall back to a bare docker stop when no file survives.
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      local -a cfg_args=()
+      local -a _cfgs
+      local f
+      IFS=',' read -ra _cfgs <<< "$lbl_file"
+      for f in "${_cfgs[@]}"; do
+        if [[ -n "$f" ]] && { [[ -f "$f" ]] || [[ -f "$lbl_dir/$f" ]]; }; then
+          cfg_args+=(-f "$f")
+        fi
+      done
+      if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
diff --git a/scripts/tests/test-switch-orphan-teardown.sh b/scripts/tests/test-switch-orphan-teardown.sh
index ba3d7ef..e4ef964 100755
--- a/scripts/tests/test-switch-orphan-teardown.sh
+++ b/scripts/tests/test-switch-orphan-teardown.sh
@@ -80,7 +80,13 @@ case "$sub" in
     if [[ "$fmt" == *working_dir* ]]; then
       printf '%s\n' "$DOCKER_MOCK_WORKDIR"
     elif [[ "$fmt" == *config_files* ]]; then
-      printf 'compose-%s.yml\n' "$cname"
+      # Two comma-joined compose files (slug compose + the club3090.slug label
+      # override from #1498). Create them under the workdir so the existence
+      # check keeps them — down_running must pass each as its own -f.
+      f1="${DOCKER_MOCK_WORKDIR}/compose-${cname}.yml"
+      f2="${DOCKER_MOCK_WORKDIR}/compose-label-${cname}.yml"
+      : > "$f1"; : > "$f2"
+      printf '%s,%s\n' "$f1" "$f2"
     fi
     ;;
   stop)
