+def is_command_not_found(rc: Optional[int], blob: str) -> bool:
+    """Could rung 1 not even START because the `hf` CLI is absent/unusable?
+
+    The signal is `rc=127` (the shell's "command not found") or the explicit
+    note `_hf_download` returns when neither `hf` nor `huggingface-cli` is on
+    PATH. This is distinct from the #804 too-large wall: here nothing was even
+    attempted. It is *fallback-eligible* precisely because rung 3 (raw resolve
+    + curl + a mandatory sha256 gate) has NO dependency on `hf` — a host with
+    no `hf` (a bare stdlib python3) can still be served by the fallback. A
+    false negative here is the silent `EXIT=1` with no diagnostics the operator
+    otherwise gets when the CLI is simply not installed."""
+    if rc == 127:
+        return True
+    low = (blob or "").lower()
+    cli = "hf" in low or "huggingface" in low
+    return ("command not found" in low
+            or ("not found" in low and cli)
+            or ("no such file or directory" in low and cli)
+            or ("on path" in low and cli))
+
+
+def is_fallback_eligible(rc: Optional[int], blob: str) -> bool:
+    """Should a rung-1 failure ESCALATE to rungs 2/3 rather than hard-fail?
+
+    Two distinct reasons, both walls retrying rung 1 cannot get past:
+      * the #804 too-large refusal (a client-side policy wall, `is_xet_refusal`);
+      * the `hf` CLI itself missing (`is_command_not_found`) — the classic path
+        could not run, but the `hf`-independent rung 3 can.
+
+    Every OTHER non-zero exit stays a hard fail (401/403 gating, disk full,
+    transient network): escalating those would send a recoverable or a correctly
+    refused pull down the slow fallback."""
+    return is_xet_refusal(blob) or is_command_not_found(rc, blob)
+
