+# Path components that are NOT identifying on their own: generic mount
+# roots and generic script/template filenames that repeat across patches
+# (so a compose that mounts *any* patch trips them). A source marker must
+# resolve to a patch-specific component (the patch's own directory name,
+# or its uniquely-named script/template file) instead of one of these.
+_GENERIC_PATH_PARTS = frozenset(
+    {
+        "patches",
+        "local",
+        "vllm",
+        "sglang",
+        "models",
+        "scripts",
+        "services",
+        "install.sh",
+        "install",
+        "apply.sh",
+        "apply.py",
+        "init.sh",
+        "entrypoint.sh",
+        "chat_template.jinja",
+    }
+)
+
+
+def _source_identifier(rel: str) -> str | None:
+    """The patch-specific path component that ties a bind-mount SOURCE to
+    this patch.
+
+    Prefers the **patch directory** — the first meaningful component after
+    a generic ``patches`` segment (skipping ``local/`` grouping dirs). The
+    patch directory name is the one token that appears in the mount's
+    relative SOURCE for *every* wiring style (the whole patch dir mounted
+    *or* a single file under it), and is unique to the patch — unlike a
+    generic ``install.sh`` / ``sitecustomize.py`` (which many patches
+    share) or the ``patches`` parent (in every mounting compose). Falls
+    back to the last non-generic component when there is no ``patches``
+    anchor. Returns ``None`` if nothing specific remains.
+    """
+    parts = [part for part in Path(rel).parts if part not in ("", ".")]
+    for idx, part in enumerate(parts):
+        if part == "patches":
+            for nxt in parts[idx + 1 :]:
+                if nxt not in _GENERIC_PATH_PARTS:
+                    return nxt
+    for part in reversed(parts):
+        if part and part not in _GENERIC_PATH_PARTS:
+            return part
+    return None
+
+
+def _mount_source_markers(patch: dict) -> list[str]:
+    """Patch-specific SOURCE tokens for the bind mounts the patch declares.
+
+    Mirrors :func:`_spec_wiring_markers`' volume side but captures the
+    HOST-side identity of each mount (overlay ``src``, install ``script``,
+    ``sidecar``, chat-template ``jinja``). ``_spec_wiring_present`` uses
+    these to require the mount's SOURCE belongs to this patch — so a
+    compose that binds a DIFFERENT patch at the same container target is
+    not mistaken for this one.
+    """
+    spec = patch.get("delivery_spec") or {}
+    src: list[str] = []
+    for of in spec.get("overlay_files") or []:
+        s = of.get("src") or of.get("source")
+        if s:
+            tok = _source_identifier(s)
+            if tok:
+                src.append(tok)
+    for key in ("script", "sidecar", "jinja"):
+        val = spec.get(key)
+        if val:
+            tok = _source_identifier(val)
+            if tok:
+                src.append(tok)
+    return src
+
+
