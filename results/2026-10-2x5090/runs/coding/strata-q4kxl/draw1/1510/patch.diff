new file mode 100644
index 0000000..8334383
--- /dev/null
+++ b/scripts/tests/test-concurrency-probe-skip.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# Regression guard for the --sweep crash at the first skipped cell.
+#
+# emit_row() ran `python3 - <<'PY'` (program from stdin) AND expected the JSON
+# row piped on stdin — the heredoc stole stdin, the pipe was discarded,
+# json.loads("") raised, and under set -e the whole sweep died at the first
+# skip, never writing the card / results. emit_row now takes the row as ARG $1.
+set -euo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PROBE="$ROOT_DIR/scripts/concurrency-probe.sh"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+
+# Extract the REAL emit_row definition from the script and run it.
+cells_jsonl="$(mktemp /tmp/cprobe-cells-test.XXXXXX)"
+trap 'rm -f "$cells_jsonl"' EXIT
+eval "$(awk '/^  emit_row\(\) \{/,/^  \}/' "$PROBE" | sed 's/^  //')"
+
+# Mirror the three skip callers exactly as the script's matrix loop does.
+ctx=1024; n=1
+emit_row "{\"ctx\":$ctx,\"n\":$n,\"skip\":\"budget\"}"
+ctx=32768; n=8; reason="N*(ctx+gen) > KV_TOKENS"
+emit_row "$(python3 -c 'import json,sys; print(json.dumps({"ctx":int(sys.argv[1]),"n":int(sys.argv[2]),"skip":sys.argv[3]}))' "$ctx" "$n" "${reason:-clipped}")"
+ctx=16384; n=4
+emit_row "$(python3 -c 'import json,sys; print(json.dumps({"ctx":int(sys.argv[1]),"n":int(sys.argv[2]),"skip":"early-stop"}))' "$ctx" "$n")"
+
+[[ -s "$cells_jsonl" ]] || fail "emit_row wrote nothing (the stdin/heredoc bug is back)"
+[[ "$(wc -l < "$cells_jsonl")" == "3" ]] || fail "expected 3 rows, got $(wc -l < "$cells_jsonl")"
+python3 - "$cells_jsonl" <<'PY'
+import json, sys
+rows = [json.loads(l) for l in open(sys.argv[1], encoding="utf-8") if l.strip()]
+skips = {r["skip"] for r in rows}
+assert {"budget", "early-stop"} <= skips, skips
+assert any("KV" in (r["skip"] or "") for r in rows), rows
+assert {r["ctx"] for r in rows} == {1024, 32768, 16384}, rows
+print("  ✓ emit_row parses argv (no stdin/heredoc collision) + writes all skip rows")
+PY
+echo "test-concurrency-probe-skip: ok"
diff --git a/scripts/tests/test-concurrency-probe-vram-scope.sh b/scripts/tests/test-concurrency-probe-vram-scope.sh
new file mode 100644
index 0000000..bfaa5a2
--- /dev/null
+++ b/scripts/tests/test-concurrency-probe-vram-scope.sh
@@ -0,0 +1,62 @@
+#!/usr/bin/env bash
+# Regression guard: VRAM + GPU label must be scoped to the probed container's
+# card(s), not the whole multi-GPU rig (an unrelated service on other GPUs
+# otherwise corrupts the leak gate + the reported vram_peak / GPU name).
+set -euo pipefail
+export CLUB3090_CONFIG_DIR=/nonexistent/club-3090-test-config
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+PROBE="$ROOT_DIR/scripts/concurrency-probe.sh"
+LIB="$ROOT_DIR/scripts/lib/concurrency_probe.py"
+fail() { echo "FAIL: $1" >&2; exit 1; }
+
+SHIM="$(mktemp -d)"; trap 'rm -rf "$SHIM"' EXIT
+cat > "$SHIM/docker" <<'D'
+#!/usr/bin/env bash
+if [ "${1:-}" = "inspect" ]; then
+  echo '[{"HostConfig":{"DeviceRequests":[{"Driver":"nvidia","DeviceIDs":["3"],"Count":0}]},"Config":{"Env":["PATH=/usr/bin"]}}]'
+  exit 0
+fi
+exit 0
+D
+cat > "$SHIM/nvidia-smi" <<'N'
+#!/usr/bin/env bash
+ALL="$*"; args=("$@"); scoped=0; idx=""
+for ((i=0;i<${#args[@]};i++)); do [ "${args[$i]}" = "-i" ] && { scoped=1; idx="${args[$((i+1))]}"; }; done
+if [ "$scoped" = 1 ] && [ "$idx" = "3" ]; then
+  case "$ALL" in *name*) echo "NVIDIA GeForce RTX 3060";; *memory.used*) echo "10381";; *index*) echo "3";; esac
+else
+  case "$ALL" in
+    *name*) printf 'NVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\nNVIDIA GeForce RTX 3090\n';;
+    *memory.used*) printf '12000\n11000\n11000\n11338\n';;
+    *index*) printf '0\n1\n2\n3\n';;
+  esac
+fi
+N
+chmod +x "$SHIM/docker" "$SHIM/nvidia-smi"
+export PATH="$SHIM:$PATH"
+
+# --- Python: container_gpu_ids + vram_used_mb scope to the container's card ----
+PYTHONPATH="$ROOT_DIR/scripts/lib" python3 - "$LIB" <<'PY' || fail "python vram scoping"
+import importlib.util, sys
+spec = importlib.util.spec_from_file_location("cp", sys.argv[1])
+m = importlib.util.module_from_spec(spec); sys.modules["cp"] = m; spec.loader.exec_module(m)
+assert m.container_gpu_ids("vllm-qwen") == "3", m.container_gpu_ids("vllm-qwen")
+assert m.vram_used_mb("vllm-qwen") == 10381, m.vram_used_mb("vllm-qwen")   # one card
+assert m.vram_used_mb() == 45338, m.vram_used_mb()                          # rig-wide fallback
+assert m.container_gpu_ids("") == ""
+print("  ✓ vram_used_mb(container) sums only the container's card (10381), not the rig (45338)")
+PY
+
+# --- Shell: _gpu_fp labels only the container's card, and flags the fallback ---
+eval "$(awk '/^_container_gpus\(\) \{/,/^}/' "$PROBE")"
+eval "$(awk '/^_gpu_fp\(\) \{/,/^}/' "$PROBE")"
+CONTAINER="vllm-qwen"
+fp="$(_gpu_fp)"
+[[ "$fp" == "1× GeForce RTX 3060" ]] || fail "_gpu_fp should label only the container's card, got: $fp"
+CONTAINER=""
+fp2="$(_gpu_fp)"
+command grep -qi "all GPUs\|not container-scoped" <<<"$fp2" \
+  || fail "rig-wide fallback should say so, got: $fp2"
+echo "  ✓ _gpu_fp = container card; rig-wide fallback is flagged"
+echo "test-concurrency-probe-vram-scope: ok"
