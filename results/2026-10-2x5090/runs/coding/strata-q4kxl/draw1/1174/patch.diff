+# The shell's command-not-found exit status, plus the phrases `_hf_download`
+# (and a missing-`hf` wrapper) emit when the CLI itself is absent. A rung-1
+# failure of THIS kind is a *tool* wall, not a transfer failure — and it is
+# fallback-ELIGIBLE, because rung 3 (raw resolve + curl + sha256) needs neither
+# `hf` nor `hf_xet`, only `curl` and the public resolve endpoint. Killing the
+# ladder here is the #804/#812 contract broken exactly where it matters: the
+# fallback exists precisely for "the classic path can't serve this here".
+_CMD_NOT_FOUND_RC = 127
+_CMD_NOT_FOUND_MARKERS = (
+    "command not found",
+    "is on path",        # `_hf_download`: "neither `hf` ... is on PATH"
+    "is not installed",
+)
+
+
+def is_command_not_found(blob: str, rc: Optional[int] = None) -> bool:
+    """True iff a rung-1 `hf download` failed because the `hf` CLI is UNAVAILABLE
+    (not on PATH / command not found) rather than a transfer or policy error.
+
+    Distinct from `is_xet_refusal` (a *content* wall — a file over 50 GB): this
+    is a *tool* wall. Both are hard, both make retrying rung 1 futile, and both
+    are fallback-eligible, so `fetch()` escalates on either. `rc == 127` (the
+    shell's command-not-found exit) is the strongest signal; the marker phrases
+    cover a wrapper that swallowed the exit code. Generic 404-style "not found"
+    from the hub is deliberately NOT matched — that is a network/gating answer,
+    not a missing binary, and belongs to the existing non-escalation mapping."""
+    if rc == _CMD_NOT_FOUND_RC:
+        return True
+    low = (blob or "").lower()
+    return any(m in low for m in _CMD_NOT_FOUND_MARKERS)
+
+
