+# ── which container serves $URL + what the engine actually loads (#1537) ───────
+# Two concurrency cards on #1537 were mislabelled. vLLM said "spec off" with MTP
+# n=4 live: _spec_fp grepped the container's Cmd for --speculative-config, but the
+# Qwen3.8 vLLM build composes that flag INSIDE its entrypoint from SPEC_N, so it
+# never appears in Cmd. SGLang said "spec ?", listed every GPU, and summed VRAM
+# rig-wide: CONTAINER came from a `vllm-(qwen|gemma)` name heuristic that never
+# matched an SGLang container. Both are fixed by reading the ENGINE (its own boot
+# dump / its own endpoint) and resolving the container by the PORT it publishes,
+# not by its name or its Cmd.
+def container_for_url(url):
+    """Name of the running container that publishes $URL's host port, or "".
+
+    Matched off `docker ps` by host port, so any engine (SGLang, llama.cpp) is
+    found as readily as a vLLM one — the name heuristic this replaces only ever saw
+    vllm-*. Empty when $URL has no port, docker is unavailable, or no running
+    container publishes it.
+    """
+    if not url:
+        return ""
+    try:
+        parsed = urllib.parse.urlparse(url)
+        port = parsed.port or (443 if parsed.scheme == "https" else 80)
+    except Exception:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+            timeout=10,
+        )
+    except Exception:
+        return ""
+    for line in (out.stdout or "").splitlines():
+        if "\t" not in line:
+            continue
+        name, ports = line.split("\t", 1)
+        name = name.strip()
+        if not name:
+            continue
+        # A published binding reads "0.0.0.0:8020->8000/tcp" (also ":::8020->…");
+        # $URL dials the HOST side — the number before "->", not the container port.
+        if str(port) in re.findall(r":(\d+)->", ports):
+            return name
+    return ""
+
+
+def parse_vllm_spec_label(text):
+    """Speculative-decoding label from vLLM's boot dump, or None when absent.
+
+    Read from the HEAD of `docker logs`: vLLM logs `Initializing a V1 LLM engine …
+    with config: … speculative_config=…` exactly once at startup, so a tail can
+    miss it entirely — which is how MTP n=4 read "spec off" on #1537.
+    `SpeculativeConfig(method='mtp', …, num_spec_tokens=4)` -> "MTP n=4";
+    `speculative_config=None` -> "spec off".
+    """
+    if not text:
+        return None
+    for line in text.splitlines():
+        if "Initializing a V1 LLM engine" not in line:
+            continue
+        if "speculative_config" not in line:
+            continue
+        m = re.search(r"speculative_config\s*=\s*SpeculativeConfig\(([^)]*)\)", line) \
+            or re.search(r"speculative_config\s*=\s*(\{[^}]*\})", line)
+        if m:
+            body = m.group(1)
+            mm = (re.search(r"['\"]?method['\"]?\s*[=:]\s*['\"]([A-Za-z0-9_.\-]+)['\"]", body)
+                  or re.search(r"['\"]?method['\"]?\s*[=:]\s*([A-Za-z0-9_.\-]+)", body))
+            nm = re.search(
+                r"['\"]?num_spec(?:ulative)?_tokens['\"]?\s*[=:]\s*['\"]?(\d+)", body
+            )
+            if mm and mm.group(1).strip().lower() not in ("", "none"):
+                label = mm.group(1).strip().upper()
+                if nm:
+                    label += f" n={nm.group(1)}"
+                return label
+        if re.search(r"speculative_config\s*=\s*None\b", line):
+            return "spec off"
+    return None
+
+
+# vLLM prints its engine-init line within the first few hundred startup lines, so
+# scanning a bounded head window is both faithful to "HEAD, not the tail" and safe
+# against a long-running server whose full `docker logs` is gigabytes.
+_VLLM_BOOT_SCAN_LINES = 5000
+
+
+def _vllm_spec_label(container):
+    """Scan the HEAD of `docker logs` for vLLM's engine-init line, stopping early.
+
+    Reads from the beginning (not `--tail`) — the line is logged once at startup,
+    so a tail misses it — and stops at the first hit or after a bounded head window
+    so a SGLang container (no such line) and a chatty server are not read in full.
+    """
+    if not container:
+        return None
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+            text=True, encoding="utf-8", errors="replace",
+        )
+    except Exception:
+        return None
+    found = None
+    try:
+        for i, line in enumerate(proc.stdout or []):
+            if "Initializing a V1 LLM engine" in line and "speculative_config" in line:
+                found = line
+                break
+            if i >= _VLLM_BOOT_SCAN_LINES:
+                break
+    except Exception:
+        found = None
+    finally:
+        try:
+            if proc.stdout:
+                proc.stdout.close()
+        except Exception:
+            pass
+        if proc.poll() is None:
+            try:
+                proc.kill()
+            except Exception:
+                pass
+        try:
+            proc.wait(timeout=5)
+        except Exception:
+            pass
+    return parse_vllm_spec_label(found) if found else None
+
+
+def parse_sglang_spec_label(info):
+    """Speculative-decoding label from SGLang /get_server_info, or None if not a dict.
+
+    EAGLE run over the target's OWN checkpoint is that model's multi-token-prediction
+    head, so it is reported in the card's language as "MTP n=<speculative_num_steps>",
+    not "EAGLE". A genuine separate draft model keeps its algorithm name.
+    """
+    if not isinstance(info, dict):
+        return None
+    algo = info.get("speculative_algorithm")
+    if algo is None or str(algo).strip() == "" or str(algo).strip().lower() == "none":
+        return "spec off"
+    name = str(algo).strip().upper()
+    steps = info.get("speculative_num_steps")
+    if steps in (None, ""):
+        steps = info.get("speculative_num_draft_tokens")
+    draft = info.get("speculative_draft_model_path")
+    target = info.get("model_path")
+    own = (
+        draft not in (None, "") and target not in (None, "")
+        and str(draft).rstrip("/") == str(target).rstrip("/")
+    )
+    if name in ("MTP", "NEXTN", "NEXT_N") or (name.startswith("EAGLE") and own):
+        name = "MTP"
+    if steps not in (None, ""):
+        return f"{name} n={steps}"
+    return name
+
+
+def _sglang_spec_label(url):
+    """GET $URL/get_server_info and parse SGLang's own spec-decoding report."""
+    if not url:
+        return None
+    try:
+        with urllib.request.urlopen(
+            url.rstrip("/") + "/get_server_info", timeout=5
+        ) as resp:
+            info = json.loads(resp.read().decode("utf-8", "replace"))
+    except Exception:
+        return None
+    return parse_sglang_spec_label(info)
+
+
+def spec_label(container, url):
+    """Speculative-decoding label read from the ENGINE, or "" when neither reads.
+
+    vLLM's boot dump first (it knows what it loaded, even when --speculative-config
+    was composed inside the entrypoint and never reaches Cmd); SGLang's
+    /get_server_info as the fallback — and the only source when the container is
+    unknown or is an SGLang one (whose logs never carry the vLLM line). Empty
+    output means "engine unreadable", which the caller renders as "spec ?".
+    """
+    label = _vllm_spec_label(container)
+    if label:
+        return label
+    label = _sglang_spec_label(url)
+    if label:
+        return label
+    return ""
+
+
