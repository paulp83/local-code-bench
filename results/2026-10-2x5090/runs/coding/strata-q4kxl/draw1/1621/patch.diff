+            ;;
+          "BUDGET unresolvable"*)
+            echo "[quality-test] server budget: unknown (llama.cpp --reasoning-budget unresolvable — ${_sb_facts#BUDGET }, the boot command does not resolve to a number) — thinking cap unchanged"
+            ;;
+          "BUDGET "*)
+            SERVER_THINKING_EFFORT=""
+            _sb_what="server budget ${_sb_facts#BUDGET } reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from ${CONTAINER}'s boot command"
+            _sb_apply "${_sb_facts#BUDGET }" "$_sb_what" \
+              "the --thinking-budget ${THINKING_BUDGET} this run verified; cap from --thinking-budget"
+            ;;
+          *)
+            echo "[quality-test] server budget: unknown (llama.cpp --reasoning-budget unresolvable — could not read ${CONTAINER}'s boot command: ${_sb_facts:-no output}) — thinking cap unchanged" >&2
+            ;;
