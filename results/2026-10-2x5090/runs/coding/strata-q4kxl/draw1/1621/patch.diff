 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+
+# _sb_apply <budget> <description> <thinking-budget-override-message>
+# The decision tree shared by the `[effort-budget] v1` readback (vLLM / SGLang)
+# and the llama.cpp boot-command read below. It never overrides a choice
+# (--thinking-budget — whose own cap wins and is not recorded —, an explicit
+# --thinking-max-tokens / THINKING_MAX_TOKENS, or --pack-budgets); otherwise it
+# raises the DEFAULT thinking cap to budget + headroom when that is larger. The
+# caller sets SERVER_THINKING_EFFORT first (empty for llama.cpp: the boot flag
+# is the same for every effort). SERVER_THINKING_BUDGET is set here.
+_sb_apply() {
+  local _sb_bud="$1" _sb_what="$2" _sb_tbmsg="$3" _sb_headroom _sb_cap
+  SERVER_THINKING_BUDGET="$_sb_bud"
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    echo "[quality-test] ${_sb_what} — ${_sb_tbmsg}"
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+  elif [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$_sb_bud" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${_sb_bud}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+  elif [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+  else
+    _sb_headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+    if ! [[ "$_sb_headroom" =~ ^[1-9][0-9]*$ ]]; then
+      echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${_sb_headroom}'" >&2
+      exit 2
+    fi
+    _sb_cap=$(( _sb_bud + _sb_headroom ))
+    if [[ "$_sb_cap" -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+      THINKING_MAX_TOKENS="$_sb_cap"
+      THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${_sb_headroom}"
+      echo "[quality-test] ${_sb_what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${_sb_bud} + ${_sb_headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+    else
+      echo "[quality-test] ${_sb_what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${_sb_headroom} tokens for the answer"
+    fi
+  fi
+}
