+# The knob that RAISES the slot count on this engine. MAX_NUM_SEQS is vLLM's spelling and an SGLang
+# compose never reads it, so quoting it as the fix sends the reader to reboot the same config.
+_slots_knob() {
+  case "${1:-}" in
+    *max-running-requests*|*max_running_requests*) echo "MAX_RUNNING_REQUESTS" ;;
+    *-np*)                                          echo "-np / NPARALLEL" ;;
+    *)                                              echo "MAX_NUM_SEQS / -np" ;;
+  esac
 }
 
