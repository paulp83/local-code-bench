+# The detectors and the label that names each one's source, in the order they are tried. ONE list on
+# purpose (#1537's follow-up): the --sweep header kept its own copy of this order, dropped the two
+# SGLang paths from it, and printed "slots=4 (undetected)" over a count that was right — a label that
+# contradicts its own number reads as a broken detector, and the fix has to be structural or the two
+# lists drift apart again.
+_SLOTS_SOURCES=(
+  "container max-num-seqs|_served_seqs"
+  "container -np|_served_np"
+  "container max-running-requests|_served_max_running"
+  "server /get_server_info max_running_requests|_sgl_max_running"
+  "server /props total_slots|_props_slots"
+)
+
+# _slots_probe -> "<count>|<source>" for the first detector that answers, "" when none does.
+_slots_probe() {
+  local entry label fn n
+  for entry in "${_SLOTS_SOURCES[@]}"; do
+    label="${entry%%|*}"; fn="${entry##*|}"
+    n="$("$fn" || true)"
+    [[ -n "$n" ]] && { printf '%s|%s' "$n" "$label"; return 0; }
+  done
+  return 0
+}
