diff --git a/scripts/tests/test-p2p-state.sh b/scripts/tests/test-p2p-state.sh
index a34bdc1..38da80c 100755
--- a/scripts/tests/test-p2p-state.sh
+++ b/scripts/tests/test-p2p-state.sh
@@ -129,6 +129,39 @@ assert_contains "$out" "#1462"
 unset _sgl_fail _ev _ok_boot
 echo "  ✓ SGLang custom-AR setup failure classified as a fallback, not an opt-out or unknown (#1462)"
 
+# ⭐ SGLang on a PCIe rig runs the V1 CustomAllreduce (V2 is admitted only on full
+# NVLink, can_use_custom_all_reduce_v2 -> full_nvlink). V1 logs NOTHING on init; its
+# ONLY success signal is "Registering N cuda graph addresses" on rank 0 after CUDA-graph
+# capture. The classifier knew only V2's "All Reduce config:", so every PCIe boot of a
+# live V1 scored "unknown". Real wording: sglang/srt/distributed/device_communicators/
+# custom_all_reduce.py.
+_sgl_v1=$(cat <<'EOF'
+[2026-10-03 09:14:22] server_args={'tp_size': 2, 'disable_custom_all_reduce': False}
+[2026-10-03 09:14:33 TP0] sglang is using nccl==2.30.7
+[2026-10-03 09:15:08 TP0] Registering 4352 cuda graph addresses
+EOF
+)
+_ev="$(printf '%s\n' "$_sgl_v1" | p2p_engine_log_evidence)"
+assert_contains "$_ev" "cuda graph addresses"
+r="$(printf '%s\n' "$_ev" | p2p_classify_engagement)"
+[[ "$r" == "on" ]] || fail "SGLang V1 graph-buffer registration -> on (got $r)"
+r="$(printf '%s\n' "$_sgl_v1" | p2p_classify_engagement)"   # unfiltered stream too
+[[ "$r" == "on" ]] || fail "unfiltered SGLang V1 registration -> on (got $r)"
+# The registration line is a success signal, NOT an operator/veto/failure reading.
+[[ "$r" != "nccl_only_operator" ]] || fail "V1 registration read as an operator opt-out"
+# A request to enable is still not runtime proof: without the registration line it stays unknown.
+r="$(printf '%s\n' '[sglang] BOOT disable_custom_all_reduce=False' | p2p_classify_engagement)"
+[[ "$r" == "unknown" ]] || fail "V1 requested-on without registration proof -> unknown (got $r)"
+# Restart epochs: an operator-disabled restart must not inherit an earlier V1 success,
+# and a setup failure after a clean V1 boot must still be the failure it is.
+_v1_boot="$(printf '%s\n' "[sglang] BOOT disable_custom_all_reduce=False" "Registering 258 cuda graph addresses")"
+r="$(printf '%s\n%s' "$_v1_boot" "[sglang] BOOT disable_custom_all_reduce=True" | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_operator" ]] || fail "operator-disabled restart beats a stale V1 success (got $r)"
+r="$(printf '%s\n%s' "$_ev" "[sglang] BOOT disable_custom_all_reduce=False" "Setup Custom allreduce failed with boom. To silence this warning, specify --disable-custom-all-reduce explicitly." | p2p_classify_engagement)"
+[[ "$r" == "nccl_only_failed" ]] || fail "setup failure after a V1 boot -> nccl_only_failed (got $r)"
+unset _sgl_v1 _ev _v1_boot
+echo "  ✓ SGLang V1 custom all-reduce (PCIe): graph-buffer registration scores as on, epochs preserved"
+
