+# Vendored-template filenames that many chat_template patches share — like the
+# generic script names above, a bare one would match every compose that mounts
+# ANY template, so it never identifies a patch on its own (#1611).
+_GENERIC_TEMPLATE_NAMES = frozenset(
+    {"chat_template.jinja", "chat_template.jinja2", "chat_template.j2"}
+)
+
+# `--chat-template` / `--chat-template-file` launch flags (the two engine styles
+# that select a mounted template by path). Matched EXACTLY (not by substring) so
+# a bare `--chat-template` never satisfies a check meant for `--chat-template-file`
+# and vice-versa (#1611).
+_CHAT_TEMPLATE_FLAGS = ("--chat-template", "--chat-template-file")
+
+
+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify THIS patch's template on its mount line.
+
+    The basename of each vendored `.jinja` (e.g. ``apex-qwen-chat-template.jinja``)
+    plus the name of the directory it is vendored under (e.g.
+    ``qwen38-reasoning-effort-template``), minus the generic shared names
+    (``chat_template.jinja`` / the ``patches`` directory) that appear in every
+    compose that mounts any template. Mirrors :func:`_install_sources` (#1611).
+    """
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    names: set[str] = set()
+    rels = list(patch.get("files") or [])
+    spec_jinja = (patch.get("delivery_spec") or {}).get("jinja")
+    if spec_jinja:
+        rels.append(spec_jinja)
+    for rel in rels:
+        path = Path(rel)
+        if path.name and path.name not in _GENERIC_TEMPLATE_NAMES:
+            names.add(path.name)
+        if path.parent.name and path.parent.name not in _GENERIC_SCRIPT_NAMES and path.parent.name != "patches":
+            names.add(path.parent.name)
+    return sorted(names)
+
+
+def _parse_mount_pairs(body: str) -> list[tuple[str | None, str | None]]:
+    """Parse volume mounts into ``(source, target)`` pairs from compose text.
+
+    Handles BOTH the short ``source:target:mode`` list-item form (what the offline
+    ``extends:`` merge renders) and the docker ``config`` long form
+    (``- {type: bind, source: …, target: …}``), so the source-aware check is
+    independent of whether a docker CLI is available (#1611).
+    """
+    pairs: list[tuple[str | None, str | None]] = []
+    cur_src: str | None = None
+    cur_tgt: str | None = None
+
+    def _flush():
+        nonlocal cur_src, cur_tgt
+        if cur_src is not None or cur_tgt is not None:
+            pairs.append((cur_src, cur_tgt))
+        cur_src = cur_tgt = None
+
+    for raw in body.splitlines():
+        s = raw.strip()
+        m_item = re.match(r"^-\s*(.*)$", s)
+        if m_item:
+            _flush()
+            inner = m_item.group(1).strip()
+            # short form "src:dst[:mode]" (src/dst are paths, no leading key:)
+            if inner.count(":") >= 1 and not re.match(r"^\w[\w. -]*:", inner):
+                parts = inner.split(":")
+                pairs.append((parts[0], parts[1]))
+            continue
+        m_src = re.match(r"^source:\s*(.+)$", s)
+        if m_src:
+            cur_src = m_src.group(1).strip().strip('"\'')
+            continue
+        m_tgt = re.match(r"^target:\s*(.+)$", s)
+        if m_tgt:
+            cur_tgt = m_tgt.group(1).strip().strip('"\'')
+    _flush()
+    return pairs
+
+
+def _chat_template_mounted_at(body: str, mounted_at: str, sources: list[str]) -> bool:
+    """True iff THIS patch's own template file is mounted at its declared target.
+
+    The container target alone is shared by every chat_template override (and a
+    suffix like ``/chat_template.jinja`` matches any model-dir mount), so the
+    vendored template's own directory/filename must be the SOURCE of the very
+    same mount (#1611 — same idea #1610 applied to install scripts).
+    """
+    for src, tgt in _parse_mount_pairs(body):
+        if not tgt or not (tgt == mounted_at or tgt.endswith(mounted_at)):
+            continue
+        if src and any(name in src for name in sources):
+            return True
+    return False
+
+
+def _chat_template_flag_names_path(body: str, mounted_at: str) -> bool:
+    """True iff a ``--chat-template``/``--chat-template-file`` flag names ``mounted_at``.
+
+    Accepts the flag with its value as an adjacent list item
+    (``- --chat-template`` / ``- /path``), in a flow list
+    (``[--chat-template, /path]``) or inline/space-separated
+    (``--chat-template-file /path``, or ``--chat-template=/path``). The flag is
+    matched by exact token, so a bare flag pointing elsewhere — or `--chat-template`
+    read as a prefix of another flag — never counts (#1611).
+    """
+    items: list[str] = []
+    for raw in body.splitlines():
+        s = raw.strip()
+        if s.startswith("- "):
+            s = s[2:]
+        for tok in re.split(r"[,\s]+", s):
+            tok = tok.strip().strip("[]").strip('"\'').strip()
+            if tok:
+                items.append(tok)
+    for i, tok in enumerate(items):
+        flag = tok.split("=", 1)[0]
+        if flag not in _CHAT_TEMPLATE_FLAGS:
+            continue
+        if "=" in tok:
+            value = tok.split("=", 1)[1]
+        elif i + 1 < len(items):
+            value = items[i + 1]
+        else:
+            continue
+        if value and value.endswith(mounted_at):
+            return True
+    return False
+
+
+def _chat_template_wired(patch: dict, body: str) -> bool:
+    """reaches() contract for a ``chat_template`` patch (#1611).
+
+    * Always require the compose to mount THIS patch's template file (the
+      vendored template's own source mounted at the declared target).
+    * When the patch is wired at the launch command too (``wired_at`` declares
+      ``entrypoint`` or ``command`` — the froggeric/gemma ``--chat-template`` and
+      the apex/glm53 ``--chat-template-file`` styles), additionally require that
+      flag to name the mounted path. A ``wired_at: [volumes]`` patch (carnice,
+      and the mount-over-model-dir qwen38 SGLang lane) is mount-only: the
+      launch-command flag is not required there.
+    """
+    spec = patch.get("delivery_spec") or {}
+    mounted_at = spec.get("mounted_at")
+    if not mounted_at:
+        return False
+    sources = _chat_template_sources(patch)
+    if not sources:
+        return False
+    mount_ok = _chat_template_mounted_at(body, mounted_at, sources)
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = set(wired_at or [])
+    if "entrypoint" in wired_at or "command" in wired_at:
+        return mount_ok and _chat_template_flag_names_path(body, mounted_at)
+    return mount_ok
+
+
