+def url_host_port(url):
+    """(host, port) of ``url``'s authority — host brackets stripped, IPv6-safe.
+    Empty port when the URL carries none (the caller treats that as no match)."""
+    rest = (url or "").split("://", 1)[-1]
+    rest = rest.split("/", 1)[0]
+    rest = rest.rsplit("@", 1)[-1]
+    if rest.startswith("["):                       # http://[::1]:8020/...
+        rb = rest.find("]")
+        if rb < 0:
+            return "", ""
+        return rest[1:rb], rest[rb + 1:].lstrip(":")
+    host, sep, port = rest.rpartition(":")
+    if not sep:                                    # no port at all
+        return rest, ""
+    return host, port
+
+
+def _resolve_host_addrs(host):
+    """Addresses the URL host names: loopback for localhost / 0.0.0.0, itself for
+    a literal IP, getaddrinfo for a name. Empty when it does not resolve."""
+    host = (host or "").strip()
+    if not host:
+        return set()
+    if host in ("localhost", "0.0.0.0"):
+        return {"127.0.0.1", "::1"}
+    try:
+        return {str(ipaddress.ip_address(host))}
+    except ValueError:
+        pass
+    try:
+        return {ai[4][0] for ai in socket.getaddrinfo(host, None)}
+    except Exception:
+        return set()
+
+
+def _this_host_addrs():
+    """Addresses THIS machine owns: loopback, every interface address
+    (`hostname -I`), plus what the local hostname resolves to. Mirrors
+    listen-scope.sh's ports_serve_url (#1584)."""
+    addrs = {"127.0.0.1", "::1"}
+    try:
+        out = subprocess.run(["hostname", "-I"], capture_output=True,
+                             text=True, encoding="utf-8", timeout=5)
+        addrs.update(out.stdout.split())
+    except Exception:
+        pass
+    try:
+        addrs.update(ai[4][0] for ai in socket.getaddrinfo(socket.gethostname(), None))
+    except Exception:
+        pass
+    return addrs
+
+
+def _mapping_serves_url(bind, hp, port, url_addrs, own):
+    """Whether one docker publish (host bind ``bind``, host-port spec ``hp``)
+    serves a URL resolving to ``url_addrs`` on THIS host. Wildcard bind reaches
+    this host on loopback or any of its own addresses; a loopback bind only on
+    loopback; a specific bind only on that exact address."""
+    lo_s, sep, hi_s = hp.partition("-")
+    if not sep:
+        hi_s = lo_s
+    if not (lo_s.isdigit() and hi_s.isdigit()):
+        return False
+    if not (int(lo_s) <= int(port) <= int(hi_s)):
+        return False
+    for a in url_addrs:
+        if bind in ("0.0.0.0", "::", ""):
+            if a.startswith("127.") or a == "::1" or a in own:
+                return True
+        elif bind.startswith("127.") or bind == "::1":
+            if a.startswith("127.") or a == "::1":
+                return True
+        elif a == bind:
+            return True
+    return False
+
+
+def _ports_serve_url(ports, port, url_addrs, own):
+    """Whether a `docker ps` Ports string publishes a URL on THIS host."""
+    for mapping in (ports or "").split(","):
+        mapping = mapping.strip()
+        if "->" not in mapping:                   # exposed-only, not published
+            continue
+        left = mapping.split("->", 1)[0].strip()  # 0.0.0.0:8020 · [::]:8020 · 127.0.0.1:6333-6334
+        if left.startswith("["):                  # [::]:8020 · [::ffff:127.0.0.1]:8020
+            rb = left.find("]")
+            if rb < 0:
+                continue
+            bind, hp = left[1:rb], left[rb + 1:].lstrip(":")
+        else:
+            bind, _, hp = left.rpartition(":")
+        if _mapping_serves_url(bind, hp, port, url_addrs, own):
+            return True
+    return False
+
