+    ``patches`` parent (present in every compose that mounts any patch dir)
+    and never a generic filename like ``install.sh`` (present in every compose
+    that runs any install script). Those generic markers are exactly what made
+    the old fallback report an UNWIRED install-script patch as reached.
+    """
+    markers: set[str] = set()
+    for rel in patch.get("files") or []:
+        own = _own_patch_dir_name(rel)
+        if own:
+            markers.add(own)
+            continue
+        target = root / rel
+        name = Path(rel).name
+        if target.is_dir():
+            markers.add(name)
+        elif name not in _GENERIC_PATCH_FILENAMES:
+            # Not under a patches/ tree and a patch-specific filename — usable.
+            markers.add(name)
+        # A generic filename (install.sh, apply.py, …) contributes NO marker.
+    return markers
