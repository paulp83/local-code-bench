+def _own_patch_dir_name(rel: str) -> str | None:
+    """The patch's OWN directory name — the path component immediately after
+    the last ``patches`` segment (e.g. ``…/patches/<own>/…`` -> ``<own>``).
+
+    This is the token that appears on a compose volume line identifying THIS
+    patch's mount source (and is unique per patch, unlike the shared
+    ``patches`` parent or a generic ``install.sh`` basename). Returns None when
+    ``rel`` is not under a ``patches`` tree.
+    """
+    parts = Path(rel).parts
+    if "patches" not in parts:
+        return None
+    idx = len(parts) - 1 - parts[::-1].index("patches")
+    if idx + 1 < len(parts):
+        return parts[idx + 1]
+    return None
+
+
+def _patch_source_names(patch: dict) -> set[str]:
+    """Names that identify THIS patch's mount SOURCE on a compose volume line.
+
+    Derived from every ``files`` entry and every declared source path in
+    ``delivery_spec`` (``script``/``sidecar``/``jinja``/``overlay_files[].src``).
+    Binding these to a mount target is what distinguishes this patch's mount
+    from a DIFFERENT patch mounted at the same in-container path. Returns an
+    empty set when no path lives under a ``patches`` tree (callers then fall
+    back to bare target matching, preserving legacy behaviour).
+    """
+    rels = list(patch.get("files") or [])
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "sidecar", "jinja"):
+        if spec.get(key):
+            rels.append(spec[key])
+    for of in spec.get("overlay_files") or []:
+        if of.get("src"):
+            rels.append(of["src"])
+
+    names: set[str] = set()
+    for rel in rels:
+        own = _own_patch_dir_name(rel)
+        if own:
+            names.add(own)
+    return names
+
