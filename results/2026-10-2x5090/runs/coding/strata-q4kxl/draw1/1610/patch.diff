+    unrelated patch mounted at the same in-container path (the
+    ``/etc/club3090/w4a8`` collision the attribution test must catch). When no
+    patch-specific source name can be derived, degrade to the legacy
+    bare-target substring so nothing that used to resolve regresses.
+    """
+    lines = body.splitlines()
+    for marker in vol_markers:
+        if not src_names:
+            if marker in body:
+                return True
+            continue
+        for line in lines:
+            if marker in line and any(name in line for name in src_names):
+                return True
+    return False
