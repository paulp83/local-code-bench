 # Reads detect_nvlink.sh's machine-readable STATE line for OUR configuration and
@@ -266,6 +281,17 @@ p2p_classify_engagement() {
       case "$text" in *"P2P off"*|*"using PCIe mode"*|*"forcing PCIe mode"*|*NCCL_P2P_DISABLE=1*) echo off; return 0 ;; esac
       echo nccl_only_operator; return 0 ;;
   esac
+  # CustomAllreduce (V1) success — see p2p_engine_log_evidence: the ONLY backend
+  # a PCIe rig gets, silent at init, proven by its post-capture graph-buffer
+  # registration. The count is variable, so this is a shape match, not a
+  # substring: `*` around a [0-9] class keeps every observed wording scoring on
+  # (4352 / 258 / 68 / 18 / 6 …) without inventing a normalized marker for it.
+  # ⚠️ LAST of the success checks, after every veto case above — a boot that
+  # both vetoes and registers is contradictory, and the veto is the stronger
+  # claim (it names a reason the kernel is NOT running).
+  case "$text" in
+    *"Registering "*[0-9]*" cuda graph addresses"*) echo on; return 0 ;;
+  esac
   case "$text" in
     *"All Reduce config:"*|*"custom all-reduce ON"*|*"enabling NVLink mode"*) echo on; return 0 ;;
   esac
