@@ -126,7 +137,11 @@ p2p_engine_log_evidence() {
 # report.sh and bench.sh gather exactly this normalized text: the container's
 # `[nvlink]` boot lines, resolved NCCL_P2P*/NVLINK_MODE env, and the engine's
