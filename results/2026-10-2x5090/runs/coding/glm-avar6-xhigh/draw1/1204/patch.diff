+# because there is nothing else to say, and only a local row declares itself.
+# The merged view (get_registry) applies the same precedence whenever the two
+# layers could meet. Never re-infer provenance from a slug prefix again -- read
+# the field (entry_origin / slug_origin below).
+ORIGIN_CORE = "core"
+ORIGIN_LOCAL = "local"
+ORIGIN_VALUES = (ORIGIN_CORE, ORIGIN_LOCAL)
