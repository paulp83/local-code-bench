+# --- #1305: the extractor must not capture a trailing backslash -------------
+# JSON-escaped spec args write the drafter path inside escaped quotes, so the
+# closing `"` is preceded by a `\`. With `\` missing from the exclusion class
+# the match ran past the dir name and ate the `\`, producing subdir `<dir>\`
+# and a config.json probe for `<dir>\/config.json` -- a path that can never
+# exist, so preflight refused every gemma external-drafter slug unconditionally.
+esc_compose="${TMP_DIR}/esc.yml"
+cat > "$esc_compose" <<'YAML'
+services:
+  vllm:
+    image: vllm/vllm-openai:v0.21.0
+    command:
+      - --model
+      - /root/.cache/huggingface/gemma-4-26b-a4b-awq-4bit
+      - --speculative-config
+      - '{"model":"/root/.cache/huggingface/gemma-4-26b-a4b-it-assistant","num_speculative_tokens":4}'
+YAML
+out="$(expect_missing "$esc_compose" "${TMP_DIR}/empty-models")"
+assert_contains "$out" "gemma-4-26b-a4b-it-assistant/config.json"
+assert_not_contains "$out" "it-assistant\\/config.json"
+assert_not_contains "$out" "it-assistant\\\\"
+mkdir -p "${TMP_DIR}/empty-models/gemma-4-26b-a4b-awq-4bit" "${TMP_DIR}/empty-models/gemma-4-26b-a4b-it-assistant"
+touch "${TMP_DIR}/empty-models/gemma-4-26b-a4b-awq-4bit/config.json" "${TMP_DIR}/empty-models/gemma-4-26b-a4b-it-assistant/config.json"
+out="$(run_deps "$esc_compose" "${TMP_DIR}/empty-models")"
+[[ -z "$out" ]]
