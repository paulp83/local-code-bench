+# --- #1305 guard: the general form of the bug -------------------------------
+# Run the in-container HF-path extractor over EVERY compose in the repo and
+# assert that no captured subdir contains a character that cannot appear in a
+# directory name (backslash, quote, brace). That is the shape of both the
+# trailing-backslash refusal (#1305) and the earlier `${MODEL_SUBDIR`
+# truncation that the extractor's char-class comment describes.
+guard_no_bad_subdirs() {
+  local out
+  out="$(_preflight_guard_bad_subdirs 2>&1)"
+  if [[ -n "$out" ]]; then
+    echo "ASSERTION FAILED: compose HF-subdir guard failed" >&2
+    echo "$out" >&2
+    exit 1
+  fi
+}
+
+# emits a "<compose>: <kind> [<value>]" line per offending capture
+_preflight_guard_bad_subdirs() {
+  local f tok sd c
+  # the extractor + resolver live in the sourced library
+  # shellcheck disable=SC1090
+  source "${ROOT_DIR}/scripts/preflight.sh"
+  local files=()
+  while IFS= read -r f; do
+    files+=("$f")
+  done < <(find "${ROOT_DIR}/models" -name '*.yml' -o -name '*.yaml' 2>/dev/null | sort)
+  for f in "${files[@]}"; do
+    while IFS= read -r tok; do
+      # (a) the RAW capture must stop at a real delimiter. A backslash in it
+      #     means the class ate the backslash of an escaped JSON quote (#1305);
+      #     a quote or comma means it ran past the end of the token.
+      for c in '\' '"' ','; do
+        if [[ "$tok" == *"$c"* ]]; then
+          printf '%s: greedy capture [%s]\n' "$f" "$tok"
+        fi
+      done
+      # (b) the RESOLVED subdir must be a plausible directory name: a brace
+      #     left over means the ${VAR:-default} resolver never ran.
+      sd="$(_preflight_compose_vllm_subdir "$tok")"
+      for c in '\' '"' '{' '}'; do
+        if [[ "$sd" == *"$c"* ]]; then
+          printf '%s: bad subdir [%s]\n' "$f" "$sd"
+        fi
+      done
+    done < <(_preflight_compose_hf_cache_tokens "$f")
+  done
+}
+
+
 run_deps() {
   local compose="$1"
   local model_dir="$2"
@@ -193,4 +242,54 @@ touch "${TMP_DIR}/bl-models/qwen3.6-27b-gguf/anbeeld-dflash-iq4xs/Qwen3.6-27B-DF
