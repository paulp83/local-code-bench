+assert_not_contains "$out" "it-assistant\\\\"
+mkdir -p "${TMP_DIR}/empty-models/gemma-4-12b-qat-w4a16" "${TMP_DIR}/empty-models/gemma-4-12b-it-assistant"
+touch "${TMP_DIR}/empty-models/gemma-4-12b-qat-w4a16/config.json" "${TMP_DIR}/empty-models/gemma-4-12b-it-assistant/config.json"
+out="$(run_deps "$esc_default" "${TMP_DIR}/empty-models")"
