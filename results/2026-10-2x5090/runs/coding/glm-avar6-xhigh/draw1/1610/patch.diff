+def _mount_source_present(patch: dict, body: str) -> bool:
+    """True iff a service-body line mounts one of the patch's declared
+    container-side targets FROM this patch's own source path.
+
+    A mount line is attributed to THIS patch only when the target AND a
+    non-generic source-side basename of the patch appear on the SAME line
+    (a rendered ``docker compose config`` volume entry, or the committed
+    ``- <src>:<dest>[:mode]`` line). Two patches can share an in-container
+    target — ``qwen-w4a8-int8-act`` and ``qwen38-sglang-autoround-w4a8-v0519``
+    both land on ``/etc/club3090/w4a8`` — so the target alone is not
+    attribution. Returns False when the patch declares no mount target.
+    """
+    vol_markers, _ = _spec_wiring_markers(patch)
+    if not vol_markers:
+        return False
+    # A `chat_template` patch's effective-coverage contract is a different
+    # soundness story (CONTRACT-2b-i): it resolves the REAL merged compose
+    # graph, where a child may re-point the template mount at an equivalent
+    # vendored path, and its fixtures pin the mount by TARGET alone. Keep
+    # that class target-matched; every other class must match the source.
+    if patch.get("delivery_mechanism") == "chat_template":
+        return any(target in body for target in vol_markers)
+    sources = _patch_source_markers(patch)
+    lines = body.splitlines()
+    for target in vol_markers:
+        for line in lines:
+            if target not in line:
+                continue
+            # The source side must be THIS patch's, not a sibling patch's.
+            if sources and not any(marker in line for marker in sources):
+                continue
+            return True
+    return False
+
+
+def _spec_is_authoritative(patch: dict) -> bool:
+    """True when the ``delivery_spec`` fully describes every insertion point
+    it claims, so the legacy ``delivery:`` text probe has nothing left to add
+    and must NOT be allowed to override a sound False.
+
+    "Fully describes" = for each point in ``wired_at`` the spec supplies a
+    concrete, patch-specific marker: a mount target for ``volumes`` and a
+    real command (or a patch-specific script/sidecar basename) for
+    ``entrypoint``. A spec that claims a mount but declares no ``mounted_at``
+    (the gemma PR-backport rows) or claims an invoke but offers only a
+    human-readable sentence is UNDER-specified: the legacy fallback still
+    applies, so such a patch keeps reaching its own compose.
+    """
+    spec = patch.get("delivery_spec")
+    if not spec:
+        return False
+    wired_at = spec.get("wired_at")
+    if isinstance(wired_at, str):
+        wired_at = [wired_at]
+    wired_at = set(wired_at or [])
+    vol, inv = _spec_wiring_markers(patch)
+    if "volumes" in wired_at and not vol:
+        return False
+    if "entrypoint" in wired_at and not inv:
+        return False
+    return bool(vol or inv)
+
+
