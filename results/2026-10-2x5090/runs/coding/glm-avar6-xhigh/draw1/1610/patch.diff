+# --------------------------------------------------------------------------
+# Patch-identity markers (soundness r2).
+#
+# Two DIFFERENT patches can be mounted at the SAME in-container target
+# (``qwen-w4a8-int8-act`` and ``qwen38-sglang-autoround-w4a8-v0519`` both
+# land on ``/etc/club3090/w4a8``), and every install-script patch ships an
+# ``install.sh``. So neither "the target path appears in the compose" nor
+# "the artifact basename appears in the compose" says anything about WHICH
+# patch is wired there. Attribution must be pinned to the mount's SOURCE
+# side: the vendored ``patches/<patch-dir>`` path this patch owns.
+#
+# What counts as identity, per path component (walking up from the
+# artifact towards the vendored tree root, stopping at the first generic
+# component so a model dir can never widen the match):
+#
+#   models/qwen3.8-27b/vllm/patches/vllm-effort-budget/install.sh
+#   ^^^^^^ generic repo dir
+#           ^^^^^^^^^^^^^ generic model dir (the walk stops before it)
+#                        ^^^ generic engine dir
+#                            ^^^^^^^ generic tree root
+#                                    ^^^^^^^^^^^^^^^^^^^ the patch dir: IDENTIFYING
+#                                                          ^^^^^^^^^ generic filename
+#
+# A component is GENERIC when it names a *container* for the artifact rather
+# than the artifact's own patch: the vendored-tree roots themselves
+# (``patches`` / ``patch`` / ``local`` / ``genesis``), an engine dir, or a
+# filename every install-script patch ships (``install.sh``, ``apply.py``,
+# ``apply_patch.py``, ...). Generic components are skipped, never reported.
+# --------------------------------------------------------------------------
+PATCH_TREE_ROOT_NAMES = {"patches", "patch", "local", "genesis"}
+
+# Directory basenames that can never identify a patch: they name where the
+# artifact lives (a vendored-tree root, an engine dir, a repo dir), not
+# which patch it belongs to.
+GENERIC_DIR_NAMES = PATCH_TREE_ROOT_NAMES | {
+    "models",
+    "model",
+    "compose",
+    "composes",
+    "scripts",
+    "services",
+    "tools",
+    "lib",
+    "profiles",
+    "vllm",
+    "sglang",
+    "llamacpp",
+    "llama-cpp",
+    "llama_cpp",
+    "_archive",
+}
+
+# Artifact basenames that can never identify a patch, because every
+# install-script / sidecar patch ships one (``install.sh``) or every
+# vendored artifact shares it (``apply.py``). The legacy fallback used the
+# bare filename as a marker, so it matched every compose that runs ANY
+# install script.
+GENERIC_ARTIFACT_NAMES = {
+    "install.sh",
+    "install.py",
+    "install_artifact.py",
+    "apply.py",
+    "apply.sh",
+    "apply_patch.py",
+    "patch.py",
+    "patch.sh",
+    "setup.py",
+    "setup.sh",
+    "sitecustomize.py",
+    "__init__.py",
+    "run.sh",
+    "run.py",
+    # The stock chat-template name: every vendored template patch (and every
+    # model dir) carries one, so it cannot tell two patches apart.
+    "chat_template.jinja",
+    "chat_template.jinja2",
+}
+
+
+def _is_generic_artifact_name(name: str) -> bool:
+    """True for an artifact basename that could belong to ANY patch.
+
+    ``install.sh`` is the one every install-script patch ships, so it can
+    never tell two patches' invoke lines (or mount sources) apart.
+    """
+    return name.strip().lower() in GENERIC_ARTIFACT_NAMES
+
+
+def _is_generic_dir_name(name: str) -> bool:
+    return name.strip().lower() in GENERIC_DIR_NAMES
+
+
+def _path_identity_markers(rel: str) -> list[str]:
+    """The non-generic basenames that identify a patch on ``rel``'s SOURCE side.
+
+    Walks up from the artifact towards the vendored-tree root, collecting
+    every non-generic component and stopping at the first generic one — so
+    a model dir / engine dir can never widen the match to another patch,
+    and a generic artifact filename (``install.sh``) never stands alone as
+    a match. ``models/x/vllm/patches/foo/install.sh`` -> ``["foo"]``;
+    ``models/x/vllm/patches/local/qwen3coder_tool_parser.py`` ->
+    ``["qwen3coder_tool_parser.py"]`` (the ``local/`` drop has no identity).
+    """
+    markers: list[str] = []
+    for part in reversed(Path(rel).parts):
+        if _is_generic_dir_name(part):
+            break  # the vendored tree root / a repo dir: stop, do not widen
+        if part and part not in markers:
+            markers.append(part)
+    return [m for m in markers if not _is_generic_artifact_name(m)]
+
+
+def _patch_source_markers(patch: dict) -> list[str]:
+    """Every non-generic source-side basename this patch owns.
+
+    Unioned over the ``delivery_spec`` artifacts (script / sidecar / overlay
+    ``src`` / vendored ``jinja``) and the ``files:`` entries, so it still
+    works for a patch that only carries the deprecated ``delivery:`` block.
+    """
+    rels: list[str] = []
+    spec = patch.get("delivery_spec") or {}
+    for key in ("script", "sidecar", "jinja"):
+        if spec.get(key):
+            rels.append(spec[key])
+    for of in spec.get("overlay_files") or []:
+        if of.get("src"):
+            rels.append(of["src"])
+    for rel in patch.get("files") or []:
+        rels.append(rel)
+
+    markers: set[str] = set()
+    for rel in rels:
+        markers.update(_path_identity_markers(rel))
+    return sorted(markers)
+
+
