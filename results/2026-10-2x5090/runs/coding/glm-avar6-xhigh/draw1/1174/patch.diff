+# The rung-1 transport is a *tool* (`hf`, legacy `huggingface-cli`). When THAT
+# is absent the pull never reached the hub at all — it is not the too-large
+# wall and not flakiness — and rung 3 does not depend on it, so it is
+# fallback-eligible rather than fatal. `_hf_download` emits this exact verdict
+# when `shutil.which` resolves nothing, and `is_cli_missing` matches it (plus
+# the shapes a half-installed CLI produces: a shim that cannot exec, a shell
+# "command not found", a binary for the wrong architecture).
+_CLI_MISSING_MSG = "neither `hf` nor `huggingface-cli` is on PATH"
+# Matched against a LOWERCASED haystack, like the refusal signature. Deliberately
+# NOT a bare "not found" / "no such file": a hub 404 and an ordinary unreadable
+# file say both, and a false positive here would send a recoverable error down
+# the slow fallback instead of surfacing it.
+_CLI_MISSING_MARKERS = (
+    _CLI_MISSING_MSG.lower(),        # _hf_download's own verdict
+    "command not found",             # POSIX shell
+    "not recognized as an internal or external command",      # cmd.exe
+    "exec format error",             # a binary for the wrong architecture
+    "cannot execute",                # _hf_download's own exec-failure verdict
+    "hf: not found",                 # the tool named as the missing command
+    "huggingface-cli: not found",
+)
+# ENOENT naming the TOOL itself — a shim whose interpreter is gone
+# ("/usr/bin/env: 'python3': No such file or directory"). Trusted ONLY when the
+# quoted argument is one of these names, never a repo or cache path.
+_CLI_MISSING_TOOL_NAMES = ("env", "python", "python3", "hf",
+                           "huggingface-cli")
+
+# 127 is the shell's "command not found" exit status — the rc a missing (or
+# non-executable) CLI comes back with.
+_CLI_ABSENT_RC = 127
