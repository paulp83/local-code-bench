+def is_cli_missing(blob: str) -> bool:
+    """True iff `blob` says the download TOOL itself is absent — not that a
+    transfer failed.
+
+    Rung 1's transport is the `hf` CLI. When that binary is not on PATH the
+    attempt dies with rc=127 (or with a shim that cannot exec) BEFORE any hub
+    policy or network error can be reported, so the refusal signature cannot
+    match and there is nothing to retry. That is still fallback-eligible: rung
+    3 is plain resolve + curl + the sha256 gate and has no dependency on `hf`.
+    Killing the ladder here is what used to leave the operator with a starting
+    announcement and a bare exit 1."""
+    raw = blob or ""
+    low = raw.lower()
+    if not low:
+        return False
+    if any(m in low for m in _CLI_MISSING_MARKERS):
+        return True
+    # The remaining shapes all name the tool inside quotes — a shim whose
+    # interpreter is gone ("/usr/bin/env: 'python3': No such file or
+    # directory") or a binary that vanished ("/opt/bin/hf: does not exist").
+    # Requiring BOTH an absence phrase and a quoted tool name is what keeps an
+    # ordinary unreadable repo file, and a hub "404 not found", out of here.
+    if not any(s in low for s in ("no such file", "does not exist",
+                                  "not found", "missing", "enoent")):
+        return False
+    # Quote styles vary by locale; normalise before scanning for the argument.
+    text = (raw.replace("\u2018", "'").replace("\u2019", "'")
+               .replace("\u201c", '"').replace("\u201d", '"'))
+    for quoted in re.findall(r"'([^']+)'", text):
+        if quoted.strip().rsplit("/", 1)[-1].strip() in _CLI_MISSING_TOOL_NAMES:
+            return True
+    return False
+
+
+def fallback_eligible(blob: str, rc: Optional[int] = None) -> bool:
+    """Should a FAILED rung-1 attempt be allowed to escalate to rungs 2/3?
+
+    YES for exactly two classes, and only those:
+      * `is_xet_refusal` — huggingface_hub's hard client-side wall (retrying
+        rung 1 cannot succeed);
+      * `is_cli_missing` / rc=127 — the tool rung 1 needs is absent, so rung 1
+        never ran at all and rung 3 can serve the pull without it.
+    Anything else keeps its pre-existing mapping (gated 401, transient network
+    error, disk) and is NOT pushed down the slow fallback: a false positive
+    here turns a recoverable error into a multi-hour curl run."""
+    if is_xet_refusal(blob):
+        return True
+    if is_cli_missing(blob):
+        return True
+    return rc is not None and rc == _CLI_ABSENT_RC
+
+
+def rung1_failure_class(blob: str, rc: int = 0) -> str:
+    """Which fallback-eligible class a failed rung 1 belongs to — `"refusal"`
+    (the too-large wall) or `"cli-missing"` (the transport tool is absent) —
+    so `escalate` announces the RIGHT reason instead of asserting a 50 GB wall
+    over a missing binary. `"other"` is the non-eligible residue (the ladder
+    does not engage for it)."""
+    if is_xet_refusal(blob):
+        return "refusal"
+    if is_cli_missing(blob) or rc == _CLI_ABSENT_RC:
+        return "cli-missing"
+    return "other"
+
