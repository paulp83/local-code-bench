diff --git a/scripts/tests/test-concurrency-probe.sh b/scripts/tests/test-concurrency-probe.sh
index ba69a32..49fbab4 100755
--- a/scripts/tests/test-concurrency-probe.sh
+++ b/scripts/tests/test-concurrency-probe.sh
@@ -264,3 +264,111 @@ rm -rf "$GPU_STUB"
 echo "  ✓ VRAM + GPU label scoped to the container's GPUs (ids, UUIDs, NVIDIA_VISIBLE_DEVICES; rig-wide fallback)"
 
 echo "test-concurrency-probe: ok"
+
+# #1537 (1): the container the card names must be the one serving $URL, not a vLLM
+# name guess. The reporter's rig: an sgl/ slug on :8020 publishing GPUs 2,3, with an
+# unrelated vllm- container beside it. Stub `docker ps` (ahead of the estate-safe
+# shim) and ask the library for the container behind the port.
+C_URL_STUB="$(mktemp -d)"
+cat > "$C_URL_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
+  ps)
+    printf 'sglang-qwen38-27b-mtp-dual\t0.0.0.0:8020->30000/tcp, [::]:8020->30000/tcp\n'
+    printf 'vllm-qwen38-27b-dual-fast\t0.0.0.0:8113->8000/tcp\n'
+    printf 'open-webui\t0.0.0.0:8080->8080/tcp\n'
+    ;;
+  *) exit 0 ;;
+esac
+DOCK
+chmod +x "$C_URL_STUB/docker"
+got="$(PATH="$C_URL_STUB:$PATH" URL=http://localhost:8020 python3 "$LIB" --container-for-url)"
+[[ "$got" == "sglang-qwen38-27b-mtp-dual" ]] \
+  || fail "--container-for-url (the card's container field) should name the container publishing :8020, got '$got'"
+got="$(PATH="$C_URL_STUB:$PATH" URL=http://127.0.0.1:19099 python3 "$LIB" --container-for-url)"
+[[ -z "$got" ]] || fail "--container-for-url should print nothing when no container publishes the port, got '$got'"
+rm -rf "$C_URL_STUB"
+echo "  ✓ CONTAINER resolves from the port the URL publishes (any engine, not a vllm- name guess)"
+
+# #1537 (2): the drafter fingerprint must come from the ENGINE, not from Config.Cmd.
+#   vLLM: the Qwen3.8 composes build --speculative-config inside their entrypoint from
+#         SPEC_N, so the flag never appears in Cmd and a running MTP n=4 read "spec off".
+#   SGLang: the old vllm-(qwen|gemma) heuristic never found the container at all, so the
+#         fingerprint read "spec ?". /get_server_info answers it.
+#   A comma-joined DeviceIDs entry ("2,3", what Compose makes of device_ids:
+#         ["${ESTATE_GPUS}"]) read as ONE selector that matched no GPU, so the scope
+#         fell back to rig-wide.
+SPEC_STUB="$(mktemp -d)"
+cat > "$SPEC_STUB/docker" <<'DOCK'
+#!/usr/bin/env bash
+case "$1" in
