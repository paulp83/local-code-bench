+def _expand_gpu_selectors(selectors):
+    """One DeviceIDs entry can be "2,3": Compose renders
+    `device_ids: ['${ESTATE_GPUS:-0,1}']` as a SINGLE comma-joined string, and
+    visible_gpu_selectors read it as one selector — which then matches no row of
+    nvidia-smi, so a container pinned to two GPUs fell back to rig-wide. Treat it as
+    GPUs 2 and 3, the same as ["2", "3"] (#1537)."""
+    if selectors is None:
+        return None
+    out = []
+    for s in selectors:
+        s = str(s).strip()
+        if "," in s:
+            out.extend(p.strip() for p in s.split(",") if p.strip())
+        else:
+            out.append(s)
+    return out
+
+
+# ── which container, and what it is decoding with (#1537) ─────────────────────
+# Two cards on @xtj7's rig were mislabelled because the probe guessed the container
+# from a NAME PREFIX (`vllm-(qwen|gemma)`) and the drafter from `Config.Cmd`:
+#   • an SGLang container was never found, so the GPU scope and the VRAM read
+#     rig-wide — the card listed every GPU on the host and said "spec ?" while the
+#     engine was drafting;
+#   • a vLLM Qwen3.8 compose builds --speculative-config inside its entrypoint from
+#     SPEC_N, so the flag never appears in Config.Cmd and the card said "spec off".
+# The container that serves $URL is a fact of its port mapping, and the drafter is a
+# fact of the engine. Read both from the engine, not from a name or a cmd line.
+def _url_port(url):
+    """Port of $URL (8020 for 'http://localhost:8020/…'), or None."""
+    s = str(url or "").strip()
+    if not s:
+        return None
+    if "://" not in s:
+        s = "http://" + s
+    try:
+        return urlsplit(s).port
+    except ValueError:
+        return None
+
+
+def _published_ports(line):
+    """The HOST ports a `docker ps` Ports cell publishes, as a set of ints.
+
+    Cells look like `0.0.0.0:8020->30000/tcp, [::]:8020->30000/tcp` — the port is
+    what follows the LAST `:` before `->`, so a naive `:8020->` match both misses
+    `0.0.0.0:8020` (the preceding `0` is a digit) and lets `:18020` match `:8020`.
+    Split on the separators docker uses (space, comma, and the `|` a
+    `{{.Names}}|{{.Ports}}` caller adds) and read each mapping on its own.
+    """
+    out = set()
+    for tok in re.split(r"[\s|,]+", line.strip()):
+        if "->" not in tok:
+            continue
+        host = tok.split("->", 1)[0]
+        m = re.search(r":(\d+)(?:-(\d+))?$", host)
+        if not m:
+            continue
+        out.add(int(m.group(1)))
+        if m.group(2):
+            out.add(int(m.group(2)))
+    return out
+
+
+def _row_name(line):
+    """The {{.Names}} field of one `docker ps` row, for the formats a caller may have
+    asked for (tab-, space- or pipe-separated): the first field that is not a port
+    mapping or an address cell."""
+    for tok in re.split(r"[\s|]+", line.strip()):
+        tok = tok.strip().strip(",")
+        if not tok or "->" in tok:
+            continue
+        if re.fullmatch(r"(?:\d{1,3}\.){3}\d{1,3}", tok) or (":" in tok and any(c.isdigit() for c in tok)):
+            continue
+        return tok
+    return ""
+
+
+def container_for_url(url):
+    """Name of the running container that publishes $URL's port ('' when none does).
+
+    From `docker ps` — any engine publishes through the same Ports column — so the
+    answer is engine-agnostic, unlike a name-prefix guess that only ever matched a
+    vLLM slug. Empty means nothing publishes that port.
+    """
+    port = _url_port(url)
+    if not port:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"],
+            capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=10,
+        )
+    except Exception:
+        return ""
+    for line in (out.stdout or "").splitlines():
+        if port not in _published_ports(line):
+            continue
+        name = _row_name(line)
+        if name:
+            return name
+    return ""
+
+
+def _log_head(container, max_bytes=2 << 20):
+    """The container's log from the START, capped at max_bytes.
+
+    `docker logs` has no head flag, so read from the front and kill the stream. vLLM
+    states its speculative config ONCE, in the boot dump: a `--tail` read of a
+    long-running engine cannot see it, which is what made the old cmd grep the only
+    witness — and that witness is blind on these composes.
+    """
+    if not container:
+        return ""
+    try:
+        proc = subprocess.Popen(
+            ["docker", "logs", container],
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+        )
+    except Exception:
+        return ""
+    chunks, total = [], 0
+    try:
+        while total < max_bytes:
+            chunk = proc.stdout.read(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            total += len(chunk)
+    except Exception:
+        pass
+    finally:
+        try:
+            proc.stdout.close()
+        except Exception:
+            pass
+        if proc.poll() is None:
+            proc.kill()
+        try:
+            proc.wait()
+        except Exception:
+            pass
+    return b"".join(chunks).decode("utf-8", "replace")
+
+
+def _balanced_tail(text, start):
+    """The Python literal/repr that begins at text[start], up to its top-level ','."""
+    out, depth, quote, i, end = [], 0, None, start, len(text)
+    while i < end:
+        ch = text[i]
+        if quote:
+            out.append(ch)
+            if ch == "\\" and i + 1 < end:
+                out.append(text[i + 1])
+                i += 2
+                continue
+            if ch == quote:
+                quote = None
+            i += 1
+            continue
+        if ch in "\"'":
+            quote = ch
+        elif ch in "([{":
+            depth += 1
+        elif ch in ")]}":
+            if depth == 0:
+                break
+            depth -= 1
+        elif depth == 0 and ch in ",\n":
+            break
+        out.append(ch)
+        i += 1
+    return "".join(out).strip()
+
+
+_SPEC_ENGINE_LINE = re.compile(r"Initializing (?:a V1 |an )?LLM engine")
+# Both spellings: the Config repr (`method='mtp', num_spec_tokens=4`) and the dict
+# the CLI actually passes (`{"method":"mtp","num_speculative_tokens":4}`) — a quoted
+# key sits between the name and its separator, so the quote is optional on both sides.
+_SPEC_METHOD_RE = re.compile(r"\bmethod['\"]?\s*[:=]\s*['\"]?([A-Za-z][A-Za-z0-9_.+-]*)['\"]?")
+_SPEC_N_RE = re.compile(r"\bnum_spec(?:ulative)?_tokens['\"]?\s*[:=]\s*['\"]?(\d+)")
+
+
+def _spec_method_label(method):
+    """How the card spells a drafter: 'mtp' → 'MTP', 'dflash2' → 'DFlash2'."""
+    m = str(method or "").strip().strip("'\"").lower()
+    if not m:
+        return ""
+    if m.startswith("dflash"):
+        return "DFlash" + m[len("dflash"):]
+    if m in ("mtp", "nextn", "eagle_mtp", "mtp_v2"):
+        return "MTP"
+    if m in ("ngram", "prompt_lookup", "prompt_lookup_num"):
+        return "ngram"
+    return m.upper()
+
+
+def _spec_label(method, n):
+    name = _spec_method_label(method)
+    if not name:
+        return ""
+    s = str(n).strip() if n is not None else ""
+    return f"{name} n={int(s)}" if s.isdigit() and int(s) > 0 else name
+
+
+def _spec_label_from_vllm(container):
+    """The vLLM boot dump's spec label ('' when the log does not carry one)."""
+    if not container:
+        return ""
+    lbl = ""
+    for line in _log_head(container).splitlines():
+        if "speculative_config=" not in line or not _SPEC_ENGINE_LINE.search(line):
+            continue
+        i = line.index("speculative_config=") + len("speculative_config=")
+        cur = _spec_label_from_config(_balanced_tail(line, i))
+        # A container that has restarted logs the boot dump once per boot; the LAST
+        # one in the window is the config now serving.
+        if cur:
+            lbl = cur
+    return lbl
+
+
+def _spec_label_from_config(val):
+    """The label for one `speculative_config=…` value, repr or dict."""
+    v = str(val or "").strip()
+    if v in ("None", "none", "null", "False"):
+        return "spec off"
+    if not v:
+        return ""
+    method, n = _SPEC_METHOD_RE.search(v), _SPEC_N_RE.search(v)
+    return _spec_label(method.group(1) if method else "", n.group(1) if n else None)
+
+
+def _http_json(url, timeout=5):
+    body = None
+    try:
+        req = urllib.request.Request(str(url), headers={"Accept": "application/json"})
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            body = resp.read(1 << 20).decode("utf-8", "replace")
+    except Exception:
+        body = None
+    if not body:
+        # curl fallback: an endpoint urllib cannot reach is still reachable by the
+        # tool every other script in this repo reaches one with.
+        try:
+            out = subprocess.run(
+                ["curl", "-s", "-m", str(timeout), str(url)],
+                capture_output=True, text=True, encoding="utf-8", errors="replace",
+                timeout=timeout + 5,
+            )
+            body = (out.stdout or "").strip() or None
+        except Exception:
+            body = None
+    if not body:
+        return None
+    try:
+        return json.loads(body)
+    except ValueError:
+        return None
+
+
+def _http_base(url, path=""):
+    """$URL normalised for a GET: schemeless input gets http://, the trailing '/' goes."""
+    s = str(url or "").strip().rstrip("/")
+    if not s:
+        return ""
+    if "://" not in s:
+        s = "http://" + s
+    return s + path
+
+
+def _spec_label_from_sglang(url):
+    """The /get_server_info spec label ('' when the endpoint does not answer)."""
+    base = _http_base(url, "/get_server_info")
+    if not base:
+        return ""
+    info = _http_json(base)
+    if not isinstance(info, dict):
+        return ""
+    alg = str(info.get("speculative_algorithm") or "").strip().strip("'\"").lower()
+    if not alg:
+        return ""
+    n = info.get("speculative_num_steps")
+    if not str(n if n is not None else "").isdigit():
+        n = info.get("speculative_num_draft_tokens")
+    if alg in ("eagle", "nextn"):
+        # EAGLE over the TARGET'S OWN checkpoint is the in-checkpoint MTP head — the
+        # sgl/qwen38-27b-* mtp composes pass --speculative-draft-model-path $M — so
+        # the card must not read a drafter that does not exist.
+        draft = str(info.get("speculative_draft_model_path") or "").strip().rstrip("/").lower()
+        target = str(info.get("model_path") or "").strip().rstrip("/").lower()
+        if not draft or (target and draft == target):
+            alg = "mtp"
+    return _spec_label(alg, n)
+
+
+def spec_label(container=None, url=None):
+    """The speculative-decoding label the card shows ('' when neither source reads).
+
+    vLLM (container $CONTAINER): the `Initializing a V1 LLM engine … with config: …
+    speculative_config=…` line at the HEAD of the log — `SpeculativeConfig(method=
+    'mtp', …, num_spec_tokens=4)` → 'MTP n=4', `speculative_config=None` → 'spec off'.
+    SGLang: GET $URL/get_server_info (speculative_algorithm, speculative_num_steps).
+    """
+    lbl = _spec_label_from_vllm(container)
+    if lbl:
+        return lbl
+    return _spec_label_from_sglang(url)
+
+
 def _smi_rows():
