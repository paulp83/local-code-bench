+class TestEngineProfile:
+    """The FOURTH local write target: the evidence-only ENGINE profile.
+
+    catalog.sh derives one for an engine the catalog does not know (a user's own
+    build) and used to write it ITSELF, in its own derivation, before handing the
+    spec to this executor — so `--dry-run` created a file the user never
+    approved and no collision check ever applied to it. It now rides the spec as
+    `local_engine_profile` and goes through the SAME gated path."""
+
+    @staticmethod
+    def _spec_with_profile(**overrides):
+        spec = _spec()
+        # The engine profile's file stem IS the engine id, so the registry entry
+        # must claim the SAME engine for the two to be consistent.
+        spec["registry_entry"]["kwargs"]["engine"] = "their-own-engine"
+        spec["local_engine_profile"] = {
+            "path": "scripts/lib/profiles-local/engines.d/their-own-engine.yml",
+            "content": (
+                "schema_version: 1\n"
+                "id: their-own-engine\n"
+                "display_name: their own engine\n"
+                "type: llama.cpp\n"
+                "stability: experimental\n"
+                "min_sm: 7.5\n"
+            ),
+            "type": "llama.cpp",
+        }
+        spec.update(overrides)
+        return spec
+
+    def test_dry_run_lists_the_profile_and_writes_nothing(self, root):
+        res = _run_cli(root, self._spec_with_profile(), "--layer", "local", "--dry-run")
+        assert res.returncode == 0, res.stdout + res.stderr
+        assert (
+            "scripts/lib/profiles-local/engines.d/their-own-engine.yml "
+            "(new local ENGINE profile)" in res.stdout
+        ), res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_write_lands_in_engines_d_with_the_right_id(self, root):
+        import yaml
+
+        res = _run_cli(root, self._spec_with_profile(), "--layer", "local")
+        assert res.returncode == 0, res.stdout + res.stderr
+        rel = "scripts/lib/profiles-local/engines.d/their-own-engine.yml"
+        data = yaml.safe_load((root / rel).read_text(encoding="utf-8"))
+        assert data["id"] == "their-own-engine"
+        assert data["type"] == "llama.cpp"
+        # The other three artifacts are still there, and the profile is not a
+        # substitute for any of them.
+        for rel in LOCAL_ARTIFACTS:
+            assert (root / rel).exists(), rel
+
+    def test_absent_profile_is_not_a_write_and_says_so(self, root):
+        res = _run_cli(root, _spec(), "--layer", "local", "--dry-run")
+        assert res.returncode == 0, res.stdout + res.stderr
+        assert "engines.d/" not in res.stdout
+        assert "already known to the catalog" in res.stdout
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_refuses_an_engine_id_mismatch(self, root):
+        spec = self._spec_with_profile()
+        spec["local_engine_profile"]["path"] = (
+            "scripts/lib/profiles-local/engines.d/another-engine.yml"
+        )
+        res = _run_cli(root, spec, "--layer", "local")
+        assert res.returncode == promote.EXIT_COLLISION
+        assert "must agree" in res.stderr
+        assert not (root / "scripts/lib/profiles-local/engines.d").exists()
+
+    def test_refuses_a_profile_outside_engines_d(self, root):
+        spec = self._spec_with_profile()
+        spec["local_engine_profile"]["path"] = (
