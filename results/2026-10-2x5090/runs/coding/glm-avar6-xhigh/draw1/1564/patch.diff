+def _check_local_engine_profile(spec: dict) -> dict:
+    """Validate + normalize the OPTIONAL fourth local write target: the
+    evidence-only ENGINE profile ``catalog.sh`` derives for an engine the
+    catalog does not know (a user's own build).
+
+    ⚠️ WHY IT IS IN THE SPEC AND NOT WRITTEN BY catalog.sh ITSELF.  catalog.sh
+    used to write ``engines.d/<engine>.yml`` in its own derivation, BEFORE this
+    executor saw the spec — so ``register --dry-run`` created a file the user
+    had not approved, the plan never mentioned it, and no collision check ever
+    applied to it. It now rides the spec so it goes through the SAME gated path
+    as the model profile, the compose and the registry merge: printed in the
+    plan, refused on a collision, skipped entirely under --dry-run.
+
+    Returns the profile as a dict of {path, content, engine}, or {} when the
+    spec does not carry one. Raises Refusal on a bad shape — nothing written.
+    """
+    ep = spec.get(_ENGINE_PROFILE_KEY)
+    if ep is None:
+        return {}
+    if not isinstance(ep, dict):
+        raise Refusal(f"spec.{_ENGINE_PROFILE_KEY} must be a JSON object")
+    path = ep.get("path")
+    content = ep.get("content")
+    if not isinstance(path, str) or not path:
+        raise Refusal(f"spec.{_ENGINE_PROFILE_KEY}.path is required")
+    if not isinstance(content, str) or not content.strip():
+        raise Refusal(
+            f"spec.{_ENGINE_PROFILE_KEY}.content is required (the engine YAML text)"
+        )
+    if not path.endswith(".yml"):
+        raise Refusal(f"spec.{_ENGINE_PROFILE_KEY}.path must name a .yml file: {path!r}")
+    # Same containment rule as spec.compose.path: a local write never leaves the
+    # gitignored layer, and an engine profile has exactly one home.
+    _refuse_if_path_escapes(path, _LOCAL_ENGINES_REL, f"spec.{_ENGINE_PROFILE_KEY}.path")
+    parent = Path(path).parent.as_posix()
+    if parent != _LOCAL_ENGINES_REL:
+        raise Refusal(
+            f"spec.{_ENGINE_PROFILE_KEY}.path must be {_LOCAL_ENGINES_REL}/<engine>.yml "
+            f"(got {path!r})"
+        )
+    # engines.d/<engine>.yml IS the engine id — so the file the spec names and
+    # the engine the registry entry claims must be the SAME one, or the layer
+    # ships a profile nothing references (and a reference with no profile).
+    engine = Path(path).stem
+    claimed = spec["registry_entry"]["kwargs"].get("engine")
+    if claimed != engine:
+        raise Refusal(
+            f"spec.{_ENGINE_PROFILE_KEY}.path names engine {engine!r} but the registry "
+            f"entry claims engine {claimed!r} — they must agree"
+        )
+    # The engine profile is loaded by compat.load_profiles for EVERY caller
+    # (launchers included), so a YAML typo here is not one broken row — it is a
+    # catalog that does not load at all. That failure used to surface only after
+    # the write, i.e. a layer left written and broken. Refuse BEFORE writing.
+    try:
+        import yaml  # noqa: E402  (the post-write gate needs it too)
+    except ImportError:
+        # Nothing here can pre-parse the text. Refusing would break every
+        # registration on a PyYAML-less rig for a check the post-write gate
+        # already performs; leave the parse unproven rather than block the write.
+        pass
+    else:
+        try:
+            parsed = yaml.safe_load(content)
+        except Exception as exc:
+            raise Refusal(f"{_ENGINE_PROFILE_KEY} is not valid YAML: {exc}")
+        if not isinstance(parsed, dict) or parsed.get("id") != engine:
+            raise Refusal(
+                f"{_ENGINE_PROFILE_KEY} must parse to a mapping whose id is "
+                f"{engine!r} — the file stem, the YAML id and the engine the "
+                f"registry entry claims are all the same string"
+            )
+    return {"path": path, "content": content, "engine": engine}
+
