 def _per_dev(text, pat, agg=False):
+    """Map device -> MiB for every match of a buffer-size line.
+
+    `pat` is one regex, or a tuple of them, each with two capture groups:
+    (device, MiB). The aggregation rule is the whole bug class here:
+
+      agg=False -- LAST match wins. Right for a buffer the engine re-logs while
+        it re-sizes the SAME allocation (the moe-cache pool above; the target's
+        compute re-reserve below).
+
+      agg=True  -- sum every match. Right for buffers that exist SEPARATELY and
+        all hold VRAM at once: the KV caches, the recurrent state, and the
+        weights -- a drafter pinned to a GPU loads a second model there.
+    """
+    if isinstance(pat, str):
+        pat = (pat,)
     out = {}
-    for m in re.finditer(pat, text):
-        dev, val = m.group(1), float(m.group(2))
-        out[dev] = out.get(dev, 0.0) + val if agg else val
+    for p in pat:
+        for m in re.finditer(p, text):
+            dev, val = m.group(1), float(m.group(2))
+            out[dev] = out.get(dev, 0.0) + val if agg else val
     return out
 
 
