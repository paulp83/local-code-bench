+    # model, so last-wins here put the DRAFTER's weights on the card and dropped
+    # the target's entirely. Both allocations are live at once -- they sum.
+    model = _per_dev(
+        text,
+        r"load_tensors:\s+(CUDA\d+) model buffer size\s*=\s*([\d.]+) MiB",
+        agg=True,
