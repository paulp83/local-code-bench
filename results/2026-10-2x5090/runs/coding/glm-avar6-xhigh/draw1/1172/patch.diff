+            # "RS buffer size", "RS.cell buffer size", "RS state buffer size".
+            r"llama_memory_recurrent:\s+(CUDA\d+)(?:[ \t]+\S+){0,2}"
+            r"[ \t]+buffer size[ \t]*=[ \t]*([\d.]+) MiB",
+        ),
+        agg=True,
+    )
 
     # LAST report per (device, pool) -- never sum every match, see module docstring
