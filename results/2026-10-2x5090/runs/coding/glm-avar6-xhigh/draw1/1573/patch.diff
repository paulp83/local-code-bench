+# ---- vLLM's boot log ---------------------------------------------------------
+# The container argv is not the whole story: an image can start vLLM through its
+# OWN launcher — a `qwen38-serve`-style script baked into the image that appends
+# `--reasoning-parser qwen3` before exec'ing `vllm serve`. `docker inspect` then
+# shows no `--reasoning-parser` token anywhere in Entrypoint+Cmd, and the
+# launcher's own name gives no clue, so an argv-only read would refuse a server
+# that DID boot with a parser (bucko's official image) — a refusal, which by this
+# file's contract cannot be overridden. vLLM prints the resolved truth at boot:
+#   ... [api_utils.py:286] non-default args: {'model_tag': ..., 'reasoning_parser': 'qwen3', ...}
+# Only NON-default args are logged, so the key's presence WITH a value is
+# positive evidence; a parser-less boot logs no such key and stays a refusal.
+# The dump is printed at boot, so read a bounded HEAD of the log — `docker logs`
+# has no `--head` and a long-lived engine's log can be hundreds of MB. The LAST
+# dump that carries the key wins, matching the "last occurrence wins" rule the
+# llama.cpp facts already use: a container RESTART re-runs the same entrypoint
+# and env, so the last mention of the key is the boot that is serving now — and
+# a config change instead recreates the container, which starts a fresh log.
+_THINKING_BUDGET_LOG_BYTES=8388608   # 8 MiB, as resolved_config._LOG_PREFIX_BYTES
+
+_THINKING_BUDGET_VLLM_LOG_PY="$(cat <<'PY'
+import ast, re, sys
+
+# The startup-dump lines worth reading: `non-default args:` is vLLM's ServerArgs
+# dump, `server_args=` is SGLang's. Reading both costs nothing and keeps a
+# wrapper image that re-logs its args under either spelling from being missed.
+_MARKERS = ("non-default args", "server_args")
+
+
+def dict_after(text, marker):
+    """The Python-literal dict that starts after `marker` on the same line, or
+    None. Balanced-brace scan (quote-aware) + ast.literal_eval — never eval.
+    The same parser resolved_config.dict_after uses for the same dumps
+    (shared with run_context.py, #1396)."""
+    i = text.find(marker)
+    if i < 0:
+        return None
+    start = text.find("{", i + len(marker))
+    if start < 0 or "\n" in text[i:start]:
+        return None
+    depth, quote, esc = 0, "", False
+    for j in range(start, len(text)):
+        ch = text[j]
+        if quote:
+            if esc:
+                esc = False
+            elif ch == "\\":
+                esc = True
+            elif ch == quote:
+                quote = ""
+            continue
+        if ch in '\'"':
+            quote = ch
+        elif ch == "{":
+            depth += 1
+        elif ch == "}":
+            depth -= 1
+            if depth == 0:
+                try:
+                    value = ast.literal_eval(text[start:j + 1])
+                except (ValueError, SyntaxError):
+                    return None
+                return value if isinstance(value, dict) else None
+        elif ch == "\n":
+            return None
+    return None
+
+
+# Line-scoped on purpose: the dump is one (long) line, and a truncated dict must
+# not swallow the rest of the log into a failed parse.
+value = ""
+for ln in sys.stdin.buffer.read().decode("utf-8", "replace").splitlines():
+    if not any(m in ln for m in _MARKERS):
+        continue
+    parsed = dict_after(ln, "non-default args:")
+    if isinstance(parsed, dict):
+        # The dump IS the truth for this line, so read ONLY its top-level key:
+        # an explicit None / empty means the server booted with the default (no
+        # parser), and a key nested inside another value (a speculative_config,
+        # say) is not the server's parser — neither may invent evidence.
+        if parsed.get("reasoning_parser"):
+            value = str(parsed["reasoning_parser"])
+        continue
+    # The dict did not parse (a different dump shape, or a truncated line). Fall
+    # back to the key itself — still on a dump line, so an error message that
+    # merely quotes the key elsewhere in the log cannot match.
+    m = re.search(
+        r"['\"]?reasoning_parser['\"]?\s*[:=]\s*(\"[^\"]*\"|'[^']*'|[^\s,)\]}]+)", ln)
+    if m:
+        value = m.group(1).strip("'\" ,")
+
+if value:
+    print("PARSER %s" % value)
+PY
+)"
+
+# stdout: `PARSER <value>` when the boot log positively shows the parser the
+# server booted with; NOTHING when it shows none or cannot be read, so the caller
+# falls through to the argv-only verdict it would have printed anyway.
+# THINKING_BUDGET_BOOT_LOG=<file> stands in for `docker logs` — the same file
+# shim every other boot-log reader here takes, so a guard test needs neither
+# docker nor a serving container.
+_thinking_budget_vllm_boot_parser() {
+  local c="$1" blob=""
+  if [[ -n "${THINKING_BUDGET_BOOT_LOG:-}" ]]; then
+    if [[ -r "${THINKING_BUDGET_BOOT_LOG}" ]]; then
+      blob="$(head -c "$_THINKING_BUDGET_LOG_BYTES" "${THINKING_BUDGET_BOOT_LOG}" 2>/dev/null || true)"
+    fi
+  elif command -v docker >/dev/null 2>&1; then
+    blob="$(docker logs "$c" 2>&1 | head -c "$_THINKING_BUDGET_LOG_BYTES" || true)"
+  fi
+  [[ -n "$blob" ]] || return 0
+  python3 -c "$_THINKING_BUDGET_VLLM_LOG_PY" <<<"$blob" 2>/dev/null
+  return 0
+}
+
 # SGLang's own readback: /server_info (v0.5.20) dumps the resolved ServerArgs;
 # /get_server_info is the deprecated alias. Walks the whole document so a
 # regrouping of the args (v0.5.20 moved them under sub-groups) cannot hide the
@@ -331,6 +457,20 @@ thinking_budget_verify() {
       facts="$(docker inspect "$c" 2>/dev/null | _thinking_budget_container_facts vllm)"
       case "$facts" in
         "PARSER none")
+          # argv silent is NOT parser absent. An image that starts vLLM through
+          # its own launcher adds --reasoning-parser inside that script, so the
+          # argv shows none while the server has one — and this branch is a
+          # REFUSAL (no THINKING_BUDGET_UNVERIFIED bypass), so an argv-only read
+          # would wrongly block a run the budget would have bounded. The boot
+          # log is the resolved truth: positive evidence there verifies, and
+          # anything else keeps the argv-only refusal.
+          local boot_parser
+          boot_parser="$(_thinking_budget_vllm_boot_parser "$c")"
+          if [[ "$boot_parser" == "PARSER "* && -n "${boot_parser#PARSER }" ]]; then
+            local bp="${boot_parser#PARSER }"
+            THINKING_BUDGET_EVIDENCE="container ${c} boots vLLM with --reasoning-parser ${bp} — its argv shows none because the image starts vLLM through its own launcher; the boot log reports reasoning_parser=${bp} in non-default args"
+            return 0
+          fi
           THINKING_BUDGET_EVIDENCE="container ${c} was booted WITHOUT --reasoning-parser — vLLM v0.29.0 rejects thinking_token_budget per request (VLLMValidationError), so every scenario would fail"
           return 1 ;;
