+def _docker_logs_tail(container, max_lines=2500):
+    """The last ``max_lines`` lines of the container's log — the old --detect-kv window."""
+    if not container:
+        return ""
+    try:
+        out = subprocess.run(
+            ["docker", "logs", "--tail", str(max_lines), container],
+            capture_output=True,
+            text=True,
+            timeout=20,
+            encoding="utf-8",
+            errors="replace",
+        )
+        return (out.stdout or "") + (out.stderr or "")
+    except Exception:
+        return ""
