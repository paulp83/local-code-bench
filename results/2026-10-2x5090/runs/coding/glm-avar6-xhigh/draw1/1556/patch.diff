+def detect_kv_tokens(container, url=None):
+    """The KV pool in tokens for the engine that is serving, or None.
+
+    ⚠️ The allocation lines are printed ONCE, at boot, so the log is read from its HEAD —
+    not from a --tail window. A container that has been serving for a while has long
+    scrolled the boot block past the last 2,500 lines, which is why BOTH engines printed
+    "KV ?" on #1537. The head is the window spec_label_from_vllm_log already reads for the
+    same reason.
+
+    A tail read stays as the fallback for the one shape the head cannot cover: a boot
+    verbose enough to push the allocation lines past the head window on a container still
+    young enough that a tail read reaches them.
+
+    When the log says nothing and a URL is given, SGLang's /get_server_info (or
+    /server_info) carries the same pool as `max_total_num_tokens`.
+    """
+    if container:
+        tok = parse_kv_tokens_text(_docker_logs_head(container))
+        if tok:
+            return tok
+        tok = parse_kv_tokens_text(_docker_logs_tail(container))
+        if tok:
+            return tok
+    if url:
+        tok = sglang_kv_tokens_from_info(_sglang_info(url))
+        if tok:
+            return tok
+    return None
 
 
