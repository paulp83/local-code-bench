 # budget + THINKING_BUDGET_HEADROOM when that is larger. The budget is also
 # stamped on the Quality: line and recorded by benchlocal (--server-thinking-budget,
 # when the installed benchlocal-cli has it).
+#   A llama.cpp server never prints that line: its budget is a BOOT flag
+#   (`--reasoning-budget N` — one value for every effort, llama.cpp has no
+#   per-request one), so when the boot log carries no readback line the budget is
+#   read from the container's BOOT COMMAND instead (`docker inspect`, resolving
+#   the composes' `--reasoning-budget "${REASONING_BUDGET:-N}"` the way the shell
+#   would — _server_budget_readback_llamacpp below). -1 / no flag = unrestricted
+#   = "off", which is why the flag being present proves nothing: only its VALUE
+#   does (the same rule thinking-budget.sh verifies --thinking-budget with).
 #   Not read on --resume (benchlocal restores the original run's own record) or on
 #   a --no-thinking leg (no reasoning, nothing to bound). Never overrides a choice:
-#   --thinking-budget N (sent per request — the request's budget wins on the
-#   server, so the server's is not the one in effect), an explicit
-#   --thinking-max-tokens / THINKING_MAX_TOKENS, or --pack-budgets.
+#   --thinking-budget N (sent per request on vLLM/SGLang — the request's budget
+#   wins on the server, so the server's is not the one in effect; on llama.cpp
+#   that N IS the boot flag and was verified against it above, so its own cap
+#   stands), an explicit --thinking-max-tokens / THINKING_MAX_TOKENS, or
+#   --pack-budgets.
 # Engine-neutral by design: the readback line is the same on every engine, and
 # effort_budget.py owns its parsing (the LAST line wins: `docker logs` spans restarts).
 SERVER_THINKING_BUDGET=""          # N | off | empty = unknown / not in effect
 SERVER_THINKING_EFFORT=""          # the effort that budget was read for
 THINKING_MAX_TOKENS_FROM_SERVER="" # "server-budget+H" when the cap was raised from it
+SERVER_BUDGET_SOURCE=""            # boot-log | boot-command: which readback produced it
+
+# The cap a budget that IS in effect sizes — the shared half of the two readbacks
+# below, so the engines cannot drift apart: one precedence, one message shape, one
+# THINKING_BUDGET_HEADROOM validation. $1 is the sentence about WHERE the budget
+# came from; the budget itself must already be in SERVER_THINKING_BUDGET. The
+# caller has already ruled out the choices this never overrides.
+_server_budget_cap() {
+  local _sb_what="$1"
+  if [[ -n "$THINKING_BUDGET" ]]; then
+    if [[ "$SERVER_BUDGET_SOURCE" == "boot-command" ]]; then
+      if [[ "$SERVER_THINKING_BUDGET" == "$THINKING_BUDGET" ]]; then
+        # llama.cpp has no per-request budget field: --thinking-budget N is the
+        # boot flag, and the readback resolved the same N the verification checked.
+        echo "[quality-test] ${_sb_what} — the --thinking-budget ${THINKING_BUDGET} this run verified; cap from --thinking-budget"
+      else
+        # Only THINKING_BUDGET_UNVERIFIED=1 can get a mismatch here — say which
+        # budget is really in effect instead of calling the run verified.
+        echo "[quality-test] ${_sb_what} — --thinking-budget ${THINKING_BUDGET} was never verified against the boot value ${SERVER_THINKING_BUDGET} (THINKING_BUDGET_UNVERIFIED=1); cap from --thinking-budget"
+      fi
+    else
+      echo "[quality-test] ${_sb_what} — --thinking-budget ${THINKING_BUDGET} is sent per request and wins over it; cap from --thinking-budget"
+    fi
+    SERVER_THINKING_BUDGET=""; SERVER_THINKING_EFFORT=""
+    return 0
+  fi
+  if [[ "$THINKING_MAX_TOKENS_EXPLICIT" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — your thinking cap ${THINKING_MAX_TOKENS} is kept"
+    if [[ "$THINKING_MAX_TOKENS" -le "$SERVER_THINKING_BUDGET" ]]; then
+      echo "[quality-test] WARN: thinking cap ${THINKING_MAX_TOKENS} is not above the server budget ${SERVER_THINKING_BUDGET}: an answer after the server's forced close has no room (token_limit, not a wrong answer)" >&2
+    fi
+    return 0
+  fi
+  if [[ "$PACK_BUDGETS" == "1" ]]; then
+    echo "[quality-test] ${_sb_what} — --pack-budgets keeps benchlocal's own caps (not raised)"
+    return 0
+  fi
+  local _sb_headroom="${THINKING_BUDGET_HEADROOM:-4096}"
+  if ! [[ "$_sb_headroom" =~ ^[1-9][0-9]*$ ]]; then
+    echo "✗ THINKING_BUDGET_HEADROOM must be a positive integer (answer tokens after the reasoning budget), got '${_sb_headroom}'" >&2
+    exit 2
+  fi
+  local _sb_cap=$(( SERVER_THINKING_BUDGET + _sb_headroom ))
+  if [[ "$_sb_cap" -gt "$DEFAULT_THINKING_MAX_TOKENS" ]]; then
+    THINKING_MAX_TOKENS="$_sb_cap"
+    THINKING_MAX_TOKENS_FROM_SERVER="server-budget+${_sb_headroom}"
+    echo "[quality-test] ${_sb_what} — thinking cap raised to ${THINKING_MAX_TOKENS} (= ${SERVER_THINKING_BUDGET} + ${_sb_headroom} answer headroom; the default ${DEFAULT_THINKING_MAX_TOKENS} would cut the answer off)"
+  else
+    echo "[quality-test] ${_sb_what} — the default thinking cap ${DEFAULT_THINKING_MAX_TOKENS} already leaves ≥ ${_sb_headroom} tokens for the answer"
+  fi
+}
+
+# The budget a llama.cpp SERVER was booted with, when its boot log carries no
+# `[effort-budget]` line. Nothing else will say it: llama.cpp takes the budget as
+# a boot flag, so `docker inspect` is the only evidence — read the boot command,
+# resolve `${REASONING_BUDGET:-N}` the way the shell would (the same facts reader
+# thinking-budget.sh's llamacpp verification uses, so --thinking-budget and this
+# readback can never disagree), and report -1 / absent as "off".
+_server_budget_readback_llamacpp() {
+  # shellcheck source=lib/thinking-budget.sh
+  source "${ROOT_DIR}/scripts/lib/thinking-budget.sh"
+  local _lb_kind _lb_facts _lb_budget _lb_no
+  # Which family is serving is engine-kind.sh's decision (#1282), through the same
+  # helper --thinking-budget's verification uses — so that verification and this
+  # readback can never disagree about what the server is.
+  _lb_kind="$(thinking_budget_engine_kind)"
+  _lb_facts="$(thinking_budget_container_facts llamacpp "$CONTAINER")"
+  _lb_budget="${_lb_facts#BUDGET }"
+
+  # No `--reasoning-budget` anywhere in the boot command: either the container is
+  # not a llama.cpp server (there is no such flag to read — a vLLM/SGLang server
+  # with no readback line stays the "unknown" it always was), or it IS one that was
+  # started without the flag, which is llama-server's unrestricted default.
+  if [[ "$_lb_facts" == "BUDGET none" ]]; then
+    if [[ "$_lb_kind" == "llamacpp" ]]; then
+      SERVER_THINKING_BUDGET="off"
+      echo "[quality-test] server budget: off (${CONTAINER} boots llama.cpp with --reasoning-budget -1 or none: unrestricted) — thinking cap unchanged"
+    else
+      echo "[quality-test] server budget: unknown (no [effort-budget] v1 line in ${CONTAINER}'s boot log) — thinking cap unchanged"
+    fi
+    return 0
+  fi
+  # From here the boot command DOES carry --reasoning-budget — a flag only
+  # llama-server has, so its presence is the evidence, name and image aside.
+  case "$_lb_budget" in
+    -1)
+      # The flag is present and REASONING_BUDGET was never set at boot: unbounded,
+      # nothing to raise the cap for.
+      SERVER_THINKING_BUDGET="off"
+      echo "[quality-test] server budget: off (${CONTAINER} boots llama.cpp with --reasoning-budget -1 or none: unrestricted) — thinking cap unchanged" ;;
+    unresolvable*)
+      # The boot command resolves to something llama-server would not accept as a
+      # token count. Say so and keep the default cap: a guessed budget measures the
+      # guess, and the client cap is exactly what would hide it.
+      echo "[quality-test] server budget: unknown (llama.cpp --reasoning-budget ${_lb_budget}) — thinking cap unchanged" ;;
+    [0-9]*)
+      SERVER_BUDGET_SOURCE="boot-command"
+      SERVER_THINKING_BUDGET="$_lb_budget"
+      # One value for every effort — llama.cpp has no per-request budget, so the
+      # Quality: stamp carries no effort tag.
+      SERVER_THINKING_EFFORT=""
+      _server_budget_cap "server budget ${SERVER_THINKING_BUDGET} reasoning tokens (llama.cpp --reasoning-budget, the same for every effort), read from ${CONTAINER}'s boot command" ;;
+    *)
+      # Nothing came back (the container could not be inspected), or the reader
+      # said something this wrapper does not know. Unresolvable is the honest word.
+      # Built as its own assignment: an apostrophe right after a nested ${...} in a
+      # :- word would end the parse of the enclosing quotes.
+      _lb_no="${_lb_facts:-no readback from the boot command of ${CONTAINER}}"
+      echo "[quality-test] server budget: unknown (llama.cpp --reasoning-budget unresolvable: ${_lb_no}) — thinking cap unchanged" ;;
+  esac
+  return 0
+}
