-up_variant() {
-  local v="$1"
+# --- Launch gate: refuse BEFORE the teardown ---------------------------------
+#
+# The order used to be "bring the running slug down, then ask whether the new one
+# may launch": down_running() ran first and every refusing check lived in
+# up_variant() AFTER it. A launch that was going to be refused therefore took the
+# running server with it and left the rig serving nothing. Hit twice on the
+# reference rig in one day — an experimental slug launched without --force
+# (status_gate) and a worktree whose model files weren't on the host (no
+# MODEL_DIR — preflight_compose_deps) — and a mistyped slug (unknown variant)
+# did the same.
+#
+# gate_launch <variant> runs every check that can REFUSE a launch and does NOT
+# need the running slug gone, and exits 1 on the first refusal with the rig still
+# serving. The teardown-DEPENDENT checks stay in up_variant(): the free-VRAM
+# gates must see the memory down_running() just freed, and the offload resolvers
+# must size residency against post-teardown free VRAM — sizing against a
+# slug that is still up would under-grant (its VRAM is not actually free).
+SWITCH_GATE_PASSED=""
+gate_launch() {
+  local v="$1" eng dir file
   if [[ -z "${VARIANTS[$v]:-}" ]]; then
     echo "ERROR: unknown variant '${v}'." >&2
     echo "Run: bash scripts/switch.sh --list" >&2
