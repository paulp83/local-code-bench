diff --git a/scripts/tests/test-catalog-amend.sh b/scripts/tests/test-catalog-amend.sh
new file mode 100644
index 0000000..74875b2
--- /dev/null
+++ b/scripts/tests/test-catalog-amend.sh
@@ -0,0 +1,223 @@
+#!/usr/bin/env bash
+# Guard: catalog.sh rename + update — amending a LOCAL entry that already exists
+# (#1202 P7).
+#
+# promote.py writes a NEW entry and demote.py removes one; between them the layer
+# was create-and-delete ONLY, so changing one field meant demoting and
+# re-promoting. That mattered beyond ergonomics: #1204 keeps a local slug that
+# collides with a newly-shipped curated one and marks it "so the user can rename
+# it" — and no rename existed, so the remedy the listing advertised could not be
+# reached. This guard proves the remedy is real, and that it stays inside the
+# local layer.
+#
+# Everything happens in a THROWAWAY root (mktemp -d). The real profiles-local/
+# layer is never read or written — a test that amends into the developer's own
+# checkout would leave a renamed slug behind on failure.
+set -uo pipefail
+export PYTHONUTF8="${PYTHONUTF8:-1}"
+# Bytecode writes would race the "the curated catalog did not change" checksums
+# below (a __pycache__ entry appearing mid-test reads as a catalog change), so
+# switch them off for every python this guard runs.
+export PYTHONDONTWRITEBYTECODE=1
+cd "$(dirname "${BASH_SOURCE[0]}")/../.."
+ROOT="$PWD"
+rc=0
+TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
+mkdir -p "$TMP/scripts" "$TMP/tools"
+cp -r scripts/lib "$TMP/scripts/"
+cp -r tools/tui-core "$TMP/tools/"
+
+ok()  { printf '  ok   %s\n' "$1"; }
+bad() { printf '  FAIL %s\n' "$1"; rc=1; }
+REFUSE() {  # REFUSE <what> <cmd...> — must exit non-zero and change nothing
+  local what="$1"; shift
+  local before after
+  before="$(cat "$REG" 2>/dev/null)"
+  if "$@" >/dev/null 2>&1; then
+    bad "$what was accepted (exit 0)"
+  else
+    after="$(cat "$REG" 2>/dev/null)"
+    if [[ "$before" == "$after" ]]; then
+      ok "$what refused, registry untouched"
+    else
+      bad "$what refused but the registry changed"
+    fi
+  fi
+}
+
+# ── fixture: a registered local model, via the same front door users use ─────
+cat > "$TMP/config.json" <<'JSON'
+{"hidden_size": 64, "num_hidden_layers": 2, "num_attention_heads": 4, "num_key_value_heads": 2}
+JSON
+W="$TMP/config.json"
+C="$TMP/byo.yml"
+cat > "$C" <<'YML'
+services:
+  mine:
+    image: ghcr.io/someone/their-own-engine:v1
+    ports:
+      - "${PORT:-8199}:8199"
+    command: >
+      /app/llama-server -m /models/m.gguf -a amend-probe -c 65536 -ctk q8_0 -ts 1,1
+YML
+
+REG="$TMP/scripts/lib/profiles-local/registry.local.json"
+SLUG="their-engine/amend-probe"
+
+if ! bash scripts/catalog.sh register --compose "$C" --engine their-engine \
+      --engine-type llama.cpp --weights "$W" --root "$TMP" -y >/dev/null 2>&1; then
+  echo "  FAIL the register fixture itself failed — the checks below prove nothing"
+  exit 1
+fi
+
+# ── 1. rename: re-keys the registry, moves no file ───────────────────────────
+NEW="their-engine/amend-renamed"
+COMPOSE_BEFORE="$(find "$TMP/scripts/lib/profiles-local/composes" -type f | sort | xargs -r md5sum | md5sum)"
+if bash scripts/catalog.sh rename --slug "$SLUG" --to "$NEW" --root "$TMP" >/dev/null 2>&1; then
+  ok "rename exits 0"
+else
+  bad "rename failed"
+fi
+if python3 - "$REG" "$SLUG" "$NEW" <<'PY'
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+sys.exit(0 if sys.argv[2] not in raw and sys.argv[3] in raw else 1)
+PY
+then ok "the entry is re-keyed: $SLUG gone, $NEW present"
+else bad "rename did not re-key the entry"; fi
+[[ "$COMPOSE_BEFORE" == "$(find "$TMP/scripts/lib/profiles-local/composes" -type f | sort | xargs -r md5sum | md5sum)" ]] \
+  && ok "rename moved no file" || bad "rename touched the compose tree"
+
+# ── 2. the layer still loads, origin: local kept, engine == slug namespace ───
+python3 - "$TMP" "$NEW" <<'PY' && ok "layer loads via load_local_registry, origin=local, engine=namespace" \
+  || { bad "the amended layer does not load / lost its provenance"; }
+import json, sys
+from pathlib import Path
+root = Path(sys.argv[1]); sys.path.insert(0, str(root))
+from scripts.lib.profiles.compose_registry import load_local_registry
+raw = json.load(open(root / "scripts/lib/profiles-local/registry.local.json", encoding="utf-8"))
+loc = load_local_registry(root)
+assert sys.argv[2] in loc, "renamed slug absent from the loaded layer"
+for slug, entry in loc.items():
+    assert entry["origin"] == "local", f"{slug}: origin={entry.get('origin')!r}"
+    assert entry["engine"] == slug.split("/", 1)[0], f"{slug}: engine != slug namespace"
+for slug, kwargs in raw.items():
+    assert "origin" not in kwargs, f"{slug}: the raw file self-declares origin"
+sys.exit(0)
+PY
+
+# ── 3. update: fields amended in place ───────────────────────────────────────
+if bash scripts/catalog.sh update --slug "$NEW" --set workload=fast-chat \
+      --set max_ctx=32768 --root "$TMP" >/dev/null 2>&1; then
+  ok "update exits 0"
+else
+  bad "update failed"
+fi
+python3 - "$REG" "$NEW" <<'PY' && ok "update --set applied (workload, max_ctx)" \
+  || bad "update did not apply the --set values"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+e = raw[sys.argv[2]]
+sys.exit(0 if e["workload"] == "fast-chat" and e["max_ctx"] == 32768 else 1)
+PY
+
+# ── 4. --dry-run exits 0 and writes nothing ──────────────────────────────────
+before="$(cat "$REG")"
+if bash scripts/catalog.sh rename --slug "$NEW" --to their-engine/again --root "$TMP" --dry-run >/dev/null 2>&1; then
+  ok "rename --dry-run exits 0"
+else
+  bad "rename --dry-run failed"
+fi
+if bash scripts/catalog.sh update --slug "$NEW" --set workload=long-ctx-single --root "$TMP" --dry-run >/dev/null 2>&1; then
+  ok "update --dry-run exits 0"
+else
+  bad "update --dry-run failed"
+fi
+[[ "$before" == "$(cat "$REG")" ]] && ok "--dry-run left the registry byte-identical" \
+  || bad "--dry-run wrote something"
+
+# ── 5. the curated catalog is unreachable, in both directions ────────────────
+CORE="$(python3 -c "
+import sys; sys.path.insert(0,'.')
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY
+print(next(iter(COMPOSE_REGISTRY)))")"
+before="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+REFUSE "renaming a CURATED slug" bash scripts/catalog.sh rename --slug "$CORE" --to their-engine/x --root "$TMP"
+REFUSE "renaming ONTO a curated slug" bash scripts/catalog.sh rename --slug "$NEW" --to "$CORE" --root "$TMP"
+REFUSE "--set origin=…" bash scripts/catalog.sh update --slug "$NEW" --set origin=core --root "$TMP"
+REFUSE "--set engine=…" bash scripts/catalog.sh update --slug "$NEW" --set engine=vllm --root "$TMP"
+REFUSE "an unknown registry field" bash scripts/catalog.sh update --slug "$NEW" --set bogus_kwd=1 --root "$TMP"
+REFUSE "an unknown engine namespace" bash scripts/catalog.sh rename --slug "$NEW" --to no-such-engine/x --root "$TMP"
+after="$(find scripts/lib/profiles -type f | sort | xargs -r md5sum | md5sum)"
+[[ "$before" == "$after" ]] && ok "no file under scripts/lib/profiles/ changed" \
+  || bad "the curated catalog changed"
+
+# ── 6. THE REMEDY: a shadowed local slug is renamable ────────────────────────
+# Hand-write the row register refuses to write (it refuses any slug that exists
+# in the merged catalog), exactly the state a later `git pull` can put a user in.
+SHADOW_TMP="$(mktemp -d)"; trap 'rm -rf "$SHADOW_TMP"' EXIT
+mkdir -p "$SHADOW_TMP/scripts/lib/profiles-local"
+python3 - "$SHADOW_TMP/scripts/lib/profiles-local/registry.local.json" <<'PY'
+import inspect, json, sys
+from pathlib import Path
+sys.path.insert(0, ".")
+from scripts.lib.profiles.compose_registry import COMPOSE_REGISTRY, _entry
+core = next(iter(COMPOSE_REGISTRY))
+tmpl = dict(COMPOSE_REGISTRY[core])
+required = [n for n, p in inspect.signature(_entry).parameters.items()
+            if p.default is inspect._empty and p.kind is p.KEYWORD_ONLY]
+kw = {n: (tmpl[n] if n in tmpl else "composes/x/base.yml") for n in required}
+kw["model"] = "shadow-probe"
+kw["status"] = "incubating"
+kw.pop("origin", None)
+# A second row in the SAME layer proves an amend touches only what it must —
+# and the loader refuses two local rows sharing a model id, so give it its own.
+kept = dict(kw, model="kept-probe")
+Path(sys.argv[1]).write_text(json.dumps({core: kw, "their-engine/kept": kept}, indent=2))
+PY
+if bash scripts/catalog.sh rename --slug "$CORE" --to their-engine/unshadowed --root "$SHADOW_TMP" >/dev/null 2>&1; then
+  ok "a shadowed local slug renames in place"
+else
+  bad "a shadowed local slug could not be renamed — the remedy is still unreachable"
+fi
+python3 - "$SHADOW_TMP/scripts/lib/profiles-local/registry.local.json" "$CORE" <<'PY' \
+  && ok "the un-shadowed slug is reachable again, its sibling untouched" \
+  || bad "the rename lost the row or disturbed a sibling"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+assert "their-engine/unshadowed" in raw, "renamed row missing"
+assert sys.argv[2] not in raw, "the shadowed key is still there"
+sys.exit(0)
+PY
+
+# ── 7. the engine→namespace invariant is maintained on a legacy row ──────────
+python3 - "$SHADOW_TMP/scripts/lib/profiles-local/registry.local.json" "$CORE" <<'PY' \
+  && ok "an amend repairs rows whose engine disagrees with their slug namespace" \
+  || bad "the engine→slug-namespace invariant was not maintained"
+import json, sys
+from pathlib import Path
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+# Re-introduce the legacy shape: engine = the engine PROFILE id, not the namespace.
+raw["their-engine/kept"]["engine"] = "llama-cpp-local"
+Path(sys.argv[1]).write_text(json.dumps(raw, indent=2))
+sys.exit(0)
+PY
+if bash scripts/catalog.sh update --slug their-engine/kept --set workload=fast-chat \
+      --root "$SHADOW_TMP" >/dev/null 2>&1; then
+  ok "update exits 0 on a legacy-shaped layer"
+else
+  bad "update refused a legacy-shaped layer"
+fi
+python3 - "$SHADOW_TMP/scripts/lib/profiles-local/registry.local.json" <<'PY' \
+  && ok "every entry's engine equals its slug's namespace after the amend" \
+  || bad "some entry's engine still disagrees with its slug namespace"
+import json, sys
+raw = json.load(open(sys.argv[1], encoding="utf-8"))
+for slug, kwargs in raw.items():
+    assert kwargs["engine"] == slug.split("/", 1)[0], f"{slug}: engine != namespace"
+sys.exit(0)
+PY
+
+[[ "$rc" == "0" ]] && echo "PASS: catalog.sh renames and updates local entries, and cannot reach core" \
+                   || echo "FAIL: catalog.sh amend regression"
+exit "$rc"
