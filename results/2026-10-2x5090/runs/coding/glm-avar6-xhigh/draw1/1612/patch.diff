+            # Adjacent list item: skip blank lines the comment stripper may have left.
+            step = 0
+            j = idx + 1
+            while j < len(lines) and step <= 1:
+                if not lines[j].strip():
+                    j += 1
+                    continue
+                if mounted_at in lines[j]:
+                    return True
+                step += 1
+                j += 1
+    return False
+
