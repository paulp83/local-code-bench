+def _flag_token_present(token: str, text: str) -> bool:
+    """Whole-token presence of a chat-template flag in ``text``.
+
+    A substring test is wrong in both directions: ``--chat-template`` is a prefix of
+    ``--chat-template-file`` and of ``--chat-template-kwargs``, so a vLLM-style
+    ``--chat-template`` probe would "see" a llama.cpp `--chat-template-file` arg (and
+    `--chat-template-kwargs`), and a llama.cpp probe must not be satisfied by the vLLM
+    flag. Delimit the token on both sides instead."""
+    return (
+        re.search(rf"(?<![A-Za-z0-9_./-]){re.escape(token)}(?![A-Za-z0-9_-])", text) is not None
+    )
+
+
+def _flag_names_mount(mounted_at: str, body: str) -> bool:
+    """True iff a chat-template flag in ``body`` names ``mounted_at``.
+
+    The rendered merged service writes the flag and its argument either on the SAME line
+    (a block scalar / flow list: ``--chat-template-file /etc/…jinja``) or as ADJACENT list
+    items (``- --chat-template`` then ``- /etc/…jinja``) — which is exactly what the
+    original code comment intended by "require BOTH tokens in the merged body (rendered as
+    adjacent list items, so the joined string never appears)". Matching them as neighbours,
+    not as one joined substring, is what stops a bare flag from satisfying the invoke check.
+
+    A flag that names another file is NOT this patch's invoke: the engine renders THAT
+    template, not the mounted one."""
+    if not mounted_at:
+        return False
+    lines = body.splitlines()
+    for idx, line in enumerate(lines):
+        for flag in _CHAT_TEMPLATE_FLAGS:
+            if not _flag_token_present(flag, line):
+                continue
+            if mounted_at in line:
