+def _chat_template_invoke_ok(patch: dict, body: str) -> bool:
+    """The invoke half of a ``chat_template`` patch's wiring: a chat-template flag present
+    in the body must name THIS patch's mounted file — never the bare flag alone.
+
+    Two styles need different evidence:
