+def _chat_template_sources(patch: dict) -> list[str]:
+    """Host-side names that identify a chat_template patch on its mount SOURCE line: the
+    vendored template's own filename and directory, minus the names every template shares.
+
+    Same source-aware pairing #1610 gave install_script patches (#1662). A ``chat_template``
+    ``mounted_at`` may legitimately be a SUFFIX (``/chat_template.jinja`` — qwen38 mounts it over
+    each weights variant's own ``chat_template.jinja``, so the target differs per variant), and
+    ``chat_template.jinja`` is also the SOURCE basename of every vendored template. So the target
+    alone matches any compose that mounts any template over any model dir; the patch's own
+    directory (``qwen38-reasoning-effort-template/``, ``glm53-minja-numeric-index/``) or filename
+    (``apex-qwen-chat-template.jinja``) on the SAME line is what pins it."""
+    if patch.get("delivery_mechanism") != "chat_template":
+        return []
+    rel = (patch.get("delivery_spec") or {}).get("jinja") or ""
+    if not rel:
+        # No `jinja` in the spec: fall back to the patch's own .jinja artifact.
+        for f in patch.get("files") or []:
+            if Path(f).suffix in CHAT_TEMPLATE_ARTIFACT_SUFFIXES:
+                rel = f
+                break
+    if not rel:
+        return []
+    parts = [part for part in Path(rel).as_posix().split("/") if part and part != "."]
+    if not parts:
+        return []
+    file_name = parts[-1]
+    parent_name = parts[-2] if len(parts) > 1 else ""
+    specific = [n for n in (file_name, parent_name) if n and n not in _GENERIC_TEMPLATE_NAMES]
+    if specific:
+        return specific
+    # Degenerate spec (only a generic basename to name): fall back to it rather than to nothing,
+    # so the volume half still requires the declared mount target.
+    return [file_name] if file_name else []
+
+
+def _mounted_target_is_generic(vol_markers: list[str]) -> bool:
+    """True when a mount target's own basename cannot identify the patch.
+
+    ``/chat_template.jinja`` (qwen38's declared SUFFIX) is the basename every
+    mount-over-the-model-dir override shares, so it matches any compose that mounts any
+    template over any model dir. A target with its own distinctive basename
+    (``/etc/club3090/gemma-canonical-template.jinja``, ``/etc/apex-qwen-chat-template.jinja``)
+    identifies the patch by itself and needs no source pairing."""
+    return any(Path(m).name in _GENERIC_TEMPLATE_NAMES for m in vol_markers)
+
+
+def _mount_segments(line: str) -> list[str]:
+    """Split a candidate volume line into its ``:``-separated segments.
+
+    ``${VAR:-default}`` expansions are masked first — their ``:-`` is not a mount separator,
+    and a bare ``split(":")`` would otherwise cut a host path in half."""
+    s = line.strip()
+    s = re.sub(r"^\s*-\s+", "", s)
+    return re.sub(r"\$\{[^}]*\}", "\x00", s).split(":")
+
+
+def _mount_target_on_line(line: str, target: str) -> bool:
+    """True iff ``target`` is the CONTAINER side of a bind mount on ``line``.
+
+    The same string also appears as the argument of a ``--chat-template`` flag (a
+    ``command:``/``entrypoint:`` list item — that is the invoke half, not a mount), as the
+    HOST side of a mount (every vendored template is ``chat_template.jinja``, and the Compose
+    long syntax writes ``source:`` on its own line), and in a ``ports:`` mapping. Requiring the
+    two-sided ``<host-src>:<container-dest>[:mode]`` shape — with the target on the
+    container side — keeps those apart."""
+    segments = _mount_segments(line)
+    if len(segments) < 2:
+        return False  # a one-sided list item (a flag argument), not a mount
+    if segments[0].strip() in {"source", "src"}:
+        return False  # the long-syntax HOST side of a mount
+    return any(target in seg for seg in segments[1:])
+
+
+def _nearby_source(idx: int, lines: list[str], sources: list[str]) -> bool:
+    """True iff a source token sits on a neighbouring line of ``lines[idx]``.
+
+    A real ``docker compose config`` render writes a bind mount in LONG syntax —
+    ``source:`` and ``target:`` on neighbouring lines — so the same-line pairing the
+    short-syntax offline merge allows must also accept an adjacent line."""
+    for direction in (1, -1):
+        step = 0
+        j = idx + direction
+        while 0 <= j < len(lines) and step < 2:
+            if not lines[j].strip():
+                j += direction
+                continue
+            if any(src in lines[j] for src in sources):
+                return True
+            step += 1
+            j += direction
+    return False
+
+
+def _chat_template_volume_ok(patch: dict, vol_markers: list[str], body: str) -> bool:
+    """The volume half of a ``chat_template`` patch's wiring: a mount line that puts THIS
+    patch's vendored template on the host side of THIS patch's container target.
+
+    ``mounted_at`` may legitimately be a SUFFIX (``/chat_template.jinja``), and that same
+    basename is the SOURCE of every vendored template — so the target alone matches every
+    compose that mounts any template over any model dir (#1662: qwen38 reached 109 composes,
+    62 load-bearing, including four Gemma slugs and two Qwen3.6/Tess slugs it never mounted).
+    When the target is that generic name the vendored template's own directory or filename
+    must be on the same mount; a target with its own distinctive basename stands alone."""
+    if not vol_markers:
+        return False
+    if not any(m in body for m in vol_markers):
+        return False
+    lines = body.splitlines()
+    # A target with its own distinctive basename identifies the patch on its own; a generic
+    # one (/chat_template.jinja) also needs the vendored template's own name on the mount.
+    sources = _chat_template_sources(patch) if _mounted_target_is_generic(vol_markers) else []
+    for idx, line in enumerate(lines):
+        if not any(_mount_target_on_line(line, m) for m in vol_markers):
+            continue
+        if not sources or any(src in line for src in sources):
+            return True
+        if _nearby_source(idx, lines, sources):
+            return True
+    return False
+
