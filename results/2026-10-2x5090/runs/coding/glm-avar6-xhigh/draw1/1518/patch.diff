diff --git a/scripts/switch.sh b/scripts/switch.sh
index b9da2b1..26d3f63 100755
--- a/scripts/switch.sh
+++ b/scripts/switch.sh
@@ -1022,12 +1022,37 @@ down_running() {
     [[ -n "${managed[$c]:-}" ]] || continue   # not ours — leave it alone
     brought_down=1
     echo "[switch] bringing down: ${c}"
-    # derive the compose dir/file from the container's labels — stop fallback
+    # Derive the compose dir/files from the container's labels — stop fallback.
+    # `com.docker.compose.project.config_files` is a COMMA-JOINED list since
+    # #1498 (slug_label): the slug's compose plus the label override in
+    # <data dir>/compose-labels/<container>.yml. Passing that whole string to a
+    # single -f fails ("compose file "...,..." is invalid") and quietly falls
+    # back to `docker stop`, so `down --remove-orphans` never ran and exited
+    # containers piled up. Split like litellm-log.sh / resolved_config.py do.
     local lbl_dir lbl_file
     lbl_dir=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' "$c" 2>/dev/null || true)
     lbl_file=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project.config_files"}}' "$c" 2>/dev/null || true)
     if [[ -n "$lbl_dir" && -n "$lbl_file" ]]; then
-      (cd "$lbl_dir" && ${COMPOSE_BIN} -f "$lbl_file" down --remove-orphans) || docker stop "$c" >/dev/null
+      local -a cfg_args=() _cfg_files
+      local _cfg_path
+      IFS=',' read -ra _cfg_files <<< "$lbl_file"
+      for _cfg_path in "${_cfg_files[@]}"; do
+        # tolerate whitespace padding around the comma-joined entries
+        _cfg_path="${_cfg_path#"${_cfg_path%%[![:space:]]*}"}"
+        _cfg_path="${_cfg_path%"${_cfg_path##*[![:space:]]}"}"
+        # The label override can be gone by teardown time (e.g. the data dir
+        # moved). It only adds labels, so `down` still works without it — but a
+        # missing entry must not be handed to compose as a bogus -f path.
+        if [[ -n "$_cfg_path" && -e "$_cfg_path" ]]; then
+          cfg_args+=(-f "$_cfg_path")
+        fi
+      done
+      if [[ "${#cfg_args[@]}" -gt 0 ]]; then
+        (cd "$lbl_dir" && ${COMPOSE_BIN} "${cfg_args[@]}" down --remove-orphans) || docker stop "$c" >/dev/null
+      else
+        # every listed compose file is gone: compose would only error out
+        docker stop "$c" >/dev/null
+      fi
     else
       docker stop "$c" >/dev/null
     fi
